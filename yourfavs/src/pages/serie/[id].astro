                                            class={`border rounded-xl overflow-hidden transition-all duration-300 hover:shadow-md ${season.season_number === 0 ? 'border-purple-200 bg-gradient-to-r from-purple-50 to-pink-50' : 'border-blue-200 bg-gradient-to-r from-blue-50 to-indigo-50'}`}>
