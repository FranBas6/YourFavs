---
import Layout from "../../layouts/Layout.astro";
import CardMovie from "../../components/Cards/CardMovie.astro";
import {getNowPlayingMoviesInSpain} from "../../services/API/Movies/tmdbMovies";
import {getGenreName} from "../../utils/constants/genres";
import Pagination from "../../components/Pagination.astro";
import '../../styles/pages/catalogo/shared.css';
import '../../styles/pages/catalogo/cartelera.css';

// Obtener el parámetro de página desde la URL
const urlParams = new URL(Astro.request.url).searchParams;
const page = Number(urlParams.get('page') || 1);

// Cargar las películas y series para la página actual
const onAirMovies = await getNowPlayingMoviesInSpain({page: page.toString()});

// Total de páginas
const totalPages = 3;
---
<Layout title="Cartelera">
    <section class="px-1 sm:py-8">
        <!-- Hero Section con mejor jerarquía visual -->
        <div class="relative container mx-auto px-4 text-center">
            <div class="inline-flex items-center gap-2 bg-coral-red/10 text-coral-red px-4 py-2 rounded-full text-sm font-medium mb-6">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                Actualizado diariamente
            </div>

            <h1 class="text-coral-red font-bold text-4xl md:text-5xl lg:text-6xl text-center mb-2"> 
                <span>🎬 </span><span>CARTELERA</span>
                <br class="sm:hidden">
                <span class="relative block text-base sm:text-lg font-medium text-gray-600 mt-2">EN ESPAÑA</span>
            </h1>

            <p class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto mb-8 leading-relaxed">
                Descubre las películas que están actualmente en los cines de España.
                <span class="text-coral-red font-medium">¡No te pierdas los últimos estrenos!</span>
            </p>

            <!-- Indicador de resultados -->
            <div class="inline-flex items-center gap-2 bg-white/80 backdrop-blur-sm border border-gray-200 px-4 py-2 rounded-full text-sm text-gray-600">
                <svg class="w-4 h-4 text-coral-red" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                        d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
                        clip-rule="evenodd"/>
                </svg>
                {onAirMovies.length} películas disponibles en esta página
            </div>
        </div>

        <div class="container mx-auto px-4 py-8">
            <!-- Información de paginación superior mejorada y más responsive -->
            <div class="bg-gradient-to-r from-white to-gray-50 rounded-2xl p-4 md:p-6 mb-8 shadow-sm border border-gray-100">
                <div class="flex flex-col gap-6 md:gap-4 md:flex-row md:items-center md:justify-between">

                    <!-- Info de página -->
                    <div class="flex items-center gap-3">
                        <div class="flex items-center justify-center w-10 h-10 bg-coral-red/10 rounded-xl shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-coral-red" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                        </div>
                        <div class="text-sm">
                            <div class="font-semibold text-gray-900">
                                Página <span class="text-coral-red">{page}</span> de <span
                                    class="text-coral-red">{totalPages}</span>
                            </div>
                            <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2 text-sm text-gray-500">
                                <span>Mostrando contenido de la cartelera</span>
                            </div>
                        </div>
                    </div>

                    <!-- Stats adicionales -->
                    <div class="flex flex-wrap justify-start md:justify-end items-center gap-x-4 gap-y-2 text-sm">
                        <div class="flex items-center gap-2 text-gray-600">
                            <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                            <span>Actualizado hoy</span>
                        </div>

                        <div class="flex items-center gap-2 text-gray-600">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                            </svg>
                            <span>Cartelera</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Grid de películas con mejor spacing y loading states -->
            <section class="mb-12">
                <div class="flex items-center gap-3 mb-6">
                    <div class="flex items-center gap-2">
                        <div class="w-1 h-8 bg-coral-red rounded-full"></div>
                        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">
                            Películas en Cartelera
                        </h2>
                    </div>
                    <div class="hidden sm:block flex-1 h-px bg-gradient-to-r from-gray-200 to-transparent"></div>
                </div>

                {onAirMovies.length > 0 ? (
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
                            {onAirMovies.map((item) => (
                                    <div class="movie-card group">
                                        <CardMovie
                                                id={item.id.toString()}
                                                img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                title={item.title}
                                                vote_average={item.vote_average}
                                                overview={item.overview}
                                                release_date={item.release_date}
                                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                        />
                                    </div>
                            ))}
                        </div>
                ) : (
                        <div class="text-center py-12">
                            <div class="w-24 h-24 mx-auto mb-4 bg-gray-100 rounded-full flex items-center justify-center">
                                <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2h4a1 1 0 110 2h-1v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6H3a1 1 0 110-2h4zM9 6v10a1 1 0 002 0V6h2v10a1 1 0 002 0V6h-6z"/>
                                </svg>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900 mb-2">No hay películas disponibles</h3>
                            <p class="text-gray-600">Intenta con otra página o vuelve más tarde.</p>
                        </div>
                )}
            </section>

                <Pagination page={page} totalPages={totalPages} buildUrl={(p) => `?page=${p}`} />
        </div>
    </section>
</Layout>
