---
import Layout from "../../layouts/Layout.astro";
import PersonalNav from "../../components/personal/PersonalNav.astro";
import EmptyState from "../../components/EmptyState.astro";
import { fetchAllActivityEvents, type ActivityEvent } from "../../services/BD/shared/activityFeed";
import { fetchMovieDetails } from "../../services/API/Movies/tmdbMovies";
import { fetchSerieDetails } from "../../services/API/Series/tmdbSeries";
import { processBatch } from "../../utils/processBatch";
import { posterUrl } from "../../services/API/shared/tmdbClient";
import StatRow from "../../components/StatRow.astro";
import ActivityHeatmap from "../../components/personal/ActivityHeatmap.astro";
import { Icon } from "astro-icon/components";
import { appDateParts, APP_TZ } from "../../utils/appTime";
import "../../styles/pages/personal/actividad.css";

const url = new URL(Astro.request.url);
const page = Math.max(1, Number(url.searchParams.get('page')) || 1);
const DAYS_PER_PAGE = 30;
const DAY_MS = 24 * 3600 * 1000;

const now = Date.now();
const windowEnd = now - (page - 1) * DAYS_PER_PAGE * DAY_MS;
const windowStart = now - page * DAYS_PER_PAGE * DAY_MS;

const allEvents = await fetchAllActivityEvents();
const windowEvents = allEvents
    .filter(e => e.timestamp >= windowStart && e.timestamp < windowEnd)
    .sort((a, b) => b.timestamp - a.timestamp);

const hasOlder = allEvents.some(e => e.timestamp < windowStart);

const uniqueItems = new Map<string, { id: string; type: 'movie' | 'serie' }>();
for (const ev of windowEvents) {
    if (ev.type === 'person') continue; // personas: nombre/foto ya vienen en el evento (sin TMDB)
    const key = `${ev.type}:${ev.id}`;
    if (!uniqueItems.has(key)) uniqueItems.set(key, { id: ev.id, type: ev.type as 'movie' | 'serie' });
}

interface Detail { key: string; title: string; poster: string | null; seasons?: Record<number, number> }
const fetchers = Array.from(uniqueItems.values());
const details: Detail[] = await processBatch(
    fetchers,
    async (item: { id: string; type: 'movie' | 'serie' }): Promise<Detail> => {
        try {
            if (item.type === 'movie') {
                const d = await fetchMovieDetails(item.id);
                return { key: `movie:${item.id}`, title: d?.title || 'Sin título', poster: d?.poster_path || null };
            }
            const d = await fetchSerieDetails(item.id);
            // Total de episodios por temporada (para la regla por volumen de los binges)
            const seasons: Record<number, number> = {};
            for (const s of d?.seasons ?? []) {
                if (s.season_number > 0 && s.episode_count > 0) seasons[s.season_number] = s.episode_count;
            }
            return { key: `serie:${item.id}`, title: d?.name || 'Sin título', poster: d?.poster_path || null, seasons };
        } catch {
            return { key: `${item.type}:${item.id}`, title: 'Sin título', poster: null };
        }
    },
    10
);
const detailsMap = new Map<string, Detail>(details.map(d => [d.key, d]));

// El cubo de día se calcula en hora de Madrid (appDateParts), NO con
// setHours sobre la hora del servidor (que corre en UTC y pegaría en el
// mismo día eventos de noches distintas — p.ej. un maratón que cruza
// medianoche). Así la página agrupa igual que activityFeed.ts y un evento
// de las 23:44 y otro de las 00:51 caen en días (Ayer/Hoy) distintos.
const todayKey = appDateParts(now).key;
const yesterdayKey = appDateParts(now - DAY_MS).key;

function dayLabel(key: string, ts: number): string {
    if (key === todayKey) return 'Hoy';
    if (key === yesterdayKey) return 'Ayer';
    return new Date(ts).toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', timeZone: APP_TZ });
}

// Clave = día-calendario de Madrid; el orden de inserción (eventos ya
// ordenados desc por ts) deja los grupos de más reciente a más antiguo.
const groups = new Map<string, { label: string; events: ActivityEvent[] }>();
for (const ev of windowEvents) {
    // Una sesión se archiva en el día en que EMPEZÓ: un maratón de 23:30 a 01:10 pertenece
    // a esa noche, no a la madrugada siguiente.
    const anchor = ev.startTs ?? ev.timestamp;
    const key = appDateParts(anchor).key;
    let g = groups.get(key);
    if (!g) { g = { label: dayLabel(key, anchor), events: [] }; groups.set(key, g); }
    g.events.push(ev);
}
// Ordenar por clave (YYYY-MM-DD, lexicográfico = cronológico) en vez de confiar en el orden
// de inserción: anclar al inicio puede crear el grupo de ayer antes que el de hoy.
const groupEntries = Array.from(groups.entries())
    .sort((a, b) => (a[0] < b[0] ? 1 : a[0] > b[0] ? -1 : 0))
    .map(([, g]) => [g.label, g.events] as [string, ActivityEvent[]]);

// Medianoche local del servidor — la usa el heatmap/racha de abajo (se conserva
// su cálculo previo; el agrupado del feed ya no depende de esto).
const todayStart = new Date();
todayStart.setHours(0, 0, 0, 0);

const windowLabel = page === 1
    ? `Últimos ${DAYS_PER_PAGE} días`
    : `Entre hace ${(page - 1) * DAYS_PER_PAGE} y ${page * DAYS_PER_PAGE} días`;

// Categoría de acción por colección (rediseño "timeline con momentum")
type Cat = 'visto' | 'fav' | 'like' | 'ep' | 'pend' | 'pronto' | 'seguir' | 'rewatch' | 'rating' | 'person'
    | 'remove' | 'unfollow' | 'abandon' | 'resume' | 'reorder';
const CAT_BY_COLLECTION: Record<string, Cat> = {
    MoviesVistas: 'visto',     SeriesVistas: 'visto',
    MovieFavs: 'fav',          SeriesFavs: 'fav',
    LikedMovies: 'like',       LikedSeries: 'like',
    WatchedEpisodes: 'ep',
    MoviesPendientes: 'pend',  SeriesPendiente: 'pend',
    MoviesVerPronto: 'pronto', SeriesVerPronto: 'pronto',
    SeriesSiguiendo: 'seguir',
    Rewatch: 'rewatch',
    Ratings: 'rating',
    FollowPerson: 'person',
    FavPerson: 'person',
    // §5 · acciones intencionales (bitácora append-only)
    ActRemove: 'remove',
    ActUnfollow: 'unfollow',
    ActAbandon: 'abandon',
    ActResume: 'resume',
    ActReorder: 'reorder',
};
const catOf = (ev: ActivityEvent): Cat => CAT_BY_COLLECTION[ev.collection] ?? 'visto';
const CAT_ICON: Record<Cat, string> = {
    visto: 'eye', fav: 'star', like: 'heart', ep: 'play',
    pend: 'bookmark', pronto: 'clock', seguir: 'tv', rewatch: 'repeat', rating: 'medal', person: 'user-plus',
    remove: 'circle-minus', unfollow: 'user-minus', abandon: 'pause', resume: 'rotate-ccw', reorder: 'arrow-up-down',
};

// Badges-resumen de cada día (conteo por categoría, en orden de aparición)
function daySummary(events: ActivityEvent[]): [Cat, number][] {
    const counts = new Map<Cat, number>();
    for (const ev of events) {
        const c = catOf(ev);
        counts.set(c, (counts.get(c) ?? 0) + 1);
    }
    return Array.from(counts.entries());
}

// Chips de la fila-binge: episodios agrupados por temporada (ya vienen ordenados).
// Se conserva el `ts` de cada episodio para poder desplegar su hora exacta.
type EpRef = { episode: number; ts?: number };
function seasonGroups(eps: { season: number; episode: number; ts?: number }[]): [number, EpRef[]][] {
    const bySeason = new Map<number, EpRef[]>();
    for (const e of eps) {
        if (!bySeason.has(e.season)) bySeason.set(e.season, []);
        bySeason.get(e.season)!.push({ episode: e.episode, ts: e.ts });
    }
    return Array.from(bySeason.entries());
}

/**
 * Hora del evento. En una sesión que duró algo, un RANGO ("00:47–00:53"): la app agrupaba
 * por día y sellaba con la hora del último episodio, así que el "cuándo" quedaba borroso.
 * Umbral bajo para no pintar rangos absurdos en marcados en bloque (mismo instante).
 */
const RANGE_MIN_MS = 2 * 60 * 1000;
const fmtHm = (ts: number) => new Date(ts).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: APP_TZ });
function timeText(ev: ActivityEvent): string {
    const end = fmtHm(ev.timestamp);
    if (ev.startTs == null || ev.timestamp - ev.startTs < RANGE_MIN_MS) return end;
    const start = fmtHm(ev.startTs);
    return start === end ? end : `${start}–${end}`;
}

// Regla por volumen de los binges (§6 del handoff): el render depende de CUÁNTO
// se marcó ese día — texto / chips de episodio / chips de temporada / resumen+barra.
type BingeView =
    | { mode: 'single'; verb: string }
    | { mode: 'episodes'; groups: [number, EpRef[]][]; verb: string; times: { label: string; ts: number }[] }
    | { mode: 'season'; season: number; verb: string }
    | { mode: 'summary'; verb: string; meta: string; pct: number | null; breakdown: { label: string; done: boolean }[] };

function bingeView(ev: ActivityEvent, detail?: Detail): BingeView {
    const eps = ev.episodes ?? [];
    const n = eps.length;
    if (n === 1) return { mode: 'single', verb: `T${eps[0].season} · E${eps[0].episode} visto` };

    const groups = seasonGroups(eps);
    const totals = detail?.seasons ?? {};
    const isComplete = (s: number, marked: EpRef[]) => (totals[s] ?? 0) > 0 && marked.length >= totals[s];
    const completeCount = groups.filter(([s, list]) => isComplete(s, list)).length;
    const allComplete = completeCount === groups.length;

    // 1 temporada completa → chip de temporada
    if (allComplete && groups.length === 1) {
        const s = groups[0][0];
        return { mode: 'season', season: s, verb: `Temporada ${s} completa · ${n} episodios` };
    }
    // pocos episodios de una temporada → chips de episodio + horas desplegables
    if (groups.length === 1 && n <= 6) {
        const stamped = eps
            .filter((e): e is { season: number; episode: number; ts: number } => typeof e.ts === 'number')
            .map(e => ({ label: `T${e.season} E${e.episode}`, ts: e.ts }))
            .sort((a, b) => a.ts - b.ts);
        // Marcados en bloque comparten instante → listar N horas idénticas sería ruido.
        const times = new Set(stamped.map(t => t.ts)).size > 1 ? stamped : [];
        return { mode: 'episodes', groups, verb: `${n} episodios vistos`, times };
    }
    // resto (serie entera / ≥2 temporadas completas / muchos sueltos) → resumen + desglose
    const seriesSeasonNums = Object.keys(totals).map(Number);
    const seriesTotalEps = seriesSeasonNums.reduce((acc, s) => acc + totals[s], 0);
    const wholeSeries = allComplete && seriesSeasonNums.length > 0 && seriesSeasonNums.length === groups.length;
    const verb = wholeSeries
        ? 'Serie completa marcada como vista'
        : allComplete
            ? `${groups.length} temporadas completas`
            : `${n} episodios vistos`;
    const meta = `${groups.length} ${groups.length === 1 ? 'temporada' : 'temporadas'} · ${n} episodios`;
    const pct = seriesTotalEps > 0 ? Math.min(100, Math.round((n / seriesTotalEps) * 100)) : null;
    const breakdown = groups.map(([s, list]) => {
        const done = isComplete(s, list);
        const label = done
            ? `T${s} ✓`
            : totals[s] ? `T${s} · ${list.length}/${totals[s]}` : `T${s} · ${list.length}`;
        return { label, done };
    });
    return { mode: 'summary', verb, meta, pct, breakdown };
}

// Heatmap de racha — SIEMPRE actual (de allEvents, independiente de la ventana)
const HEAT_WEEKS = 16;
const dayCounts = new Map<number, number>();
for (const ev of allEvents) {
    const d = new Date(ev.timestamp);
    d.setHours(0, 0, 0, 0);
    dayCounts.set(d.getTime(), (dayCounts.get(d.getTime()) ?? 0) + 1);
}

// Racha: días consecutivos con ≥1 evento hasta hoy (si hoy aún no hay, desde ayer)
let streak = 0;
{
    const cursor = new Date(todayStart);
    if (!dayCounts.has(cursor.getTime())) cursor.setDate(cursor.getDate() - 1);
    while (dayCounts.has(cursor.getTime())) {
        streak++;
        cursor.setDate(cursor.getDate() - 1);
    }
}

// Celdas: 16 semanas completas L-D acabando en la actual (columna = semana)
function heatLevel(n: number): string {
    if (n >= 6) return 'l4';
    if (n >= 4) return 'l3';
    if (n >= 2) return 'l2';
    if (n >= 1) return 'l1';
    return '';
}
const heatStart = new Date(todayStart);
heatStart.setDate(heatStart.getDate() - ((heatStart.getDay() + 6) % 7) - (HEAT_WEEKS - 1) * 7);
const heatCells: { level: string; off: boolean }[] = [];
{
    const cursor = new Date(heatStart);
    for (let i = 0; i < HEAT_WEEKS * 7; i++) {
        const ts = cursor.getTime();
        heatCells.push({ level: heatLevel(dayCounts.get(ts) ?? 0), off: ts > todayStart.getTime() });
        cursor.setDate(cursor.getDate() + 1);
    }
}

// Chips de filtro (Todo + las 5 categorías con tile propio)
const FILTERS: [Cat, string][] = [
    ['visto', 'Vistas'], ['fav', 'Favoritos'], ['like', 'Me gusta'],
    ['ep', 'Episodios'], ['rating', 'Valoraciones'], ['rewatch', 'Re-visionado'], ['pend', 'Pendientes'],
    ['person', 'Personas'], ['remove', 'Quitados'], ['abandon', 'Abandonadas'],
];

// KPIs del periodo (episodios = nº real de episodios, no de eventos)
const kpis = { visto: 0, fav: 0, like: 0, ep: 0, pend: 0, rewatch: 0, rating: 0, person: 0 };
for (const ev of windowEvents) {
    const c = catOf(ev);
    if (c === 'ep') kpis.ep += ev.episodes?.length ?? 1;
    else if (c in kpis) kpis[c as 'visto' | 'fav' | 'like' | 'pend' | 'rewatch' | 'rating' | 'person']++;
}

// Tiles KPI (se renderizan dos veces: banda desktop y colapsable móvil)
const KPI_TILES: { cat: Cat; icon: string; n: number; label: string }[] = [
    { cat: 'visto',   icon: 'eye',       n: kpis.visto,   label: 'Vistas' },
    { cat: 'fav',     icon: 'star',      n: kpis.fav,     label: 'Favoritos' },
    { cat: 'like',    icon: 'heart',     n: kpis.like,    label: 'Me gusta' },
    { cat: 'ep',      icon: 'play',      n: kpis.ep,      label: 'Episodios' },
    { cat: 'rating',  icon: 'medal',     n: kpis.rating,  label: 'Valoraciones' },
    { cat: 'rewatch', icon: 'repeat',    n: kpis.rewatch, label: 'Re-visionados' },
    { cat: 'pend',    icon: 'bookmark',  n: kpis.pend,    label: 'Pendientes' },
    { cat: 'person',  icon: 'user-plus', n: kpis.person,  label: 'Personas' },
];
// Cifras del periodo en la fila única del sistema v2 (los ceros se agrupan en una línea).
const KPI_ITEMS = KPI_TILES.map((t) => ({ value: t.n, label: t.label, icon: t.icon, tone: t.cat }));
---
<Layout title="Actividad">
    <section class="px-1 sm:py-8">
        <header class="act-head flex items-end justify-between gap-4 flex-wrap">
            <div>
                <h1>Actividad</h1>
                <p>Tu historial en pantalla, día a día</p>
            </div>
            <span class="act-live">
                {page === 1 && <span class="pulse"></span>}
                {page === 1 ? `EN VIVO · ${windowLabel.toUpperCase()}` : windowLabel.toUpperCase()}
            </span>
        </header>

        <div class="mb-6">
            <PersonalNav currentPage="/mislistas/actividad" />
        </div>

        <div class="act-grid">
            <aside class="act-rail">
                <ActivityHeatmap cells={heatCells} weeks={HEAT_WEEKS} streak={streak} />
                <div class="act-filters">
                    <button class="chip active" data-filter="all">Todo</button>
                    {FILTERS.map(([c, l]) => (
                        <button class="chip" data-filter={c}>
                            <span class="dot" style={`background: var(--a-${c});`}></span>{l}
                        </button>
                    ))}
                </div>
            </aside>

            <div class="act-main">
                <details class="act-collapse">
                    <summary>
                        <Icon name="lucide:play" /> Ver mi resumen del periodo
                        <span class="chev"><Icon name="lucide:chevron-down" /></span>
                    </summary>
                    <div class="panel">
                        <StatRow class="act-summary" items={KPI_ITEMS} />
                        <ActivityHeatmap cells={heatCells} weeks={HEAT_WEEKS} streak={streak} />
                    </div>
                </details>

                <div class="act-filters is-mobile">
                    <button class="chip active" data-filter="all">Todo</button>
                    {FILTERS.map(([c, l]) => (
                        <button class="chip" data-filter={c}>
                            <span class="dot" style={`background: var(--a-${c});`}></span>{l}
                        </button>
                    ))}
                </div>

                <StatRow class="act-summary is-desktop" items={KPI_ITEMS} />

        {windowEvents.length === 0 && (
            <EmptyState
                size="lg"
                title="Sin actividad en este periodo"
                description={page === 1 ? 'Añade algo a tus colecciones para empezar tu historial.' : 'Retrocede más en el tiempo o vuelve al principio.'}
            >
                {page === 1
                    ? <a slot="cta" href="/catalogo/tendencias" class="inline-flex items-center gap-2 px-4 py-2 bg-[#E63946] text-white rounded-lg hover:bg-[#C7283A] text-sm font-medium transition-colors">Explorar tendencias</a>
                    : <a slot="cta" href="/mislistas/actividad" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-900 text-white rounded-lg hover:bg-gray-800 text-sm font-medium transition-colors">Volver al inicio</a>
                }
            </EmptyState>
        )}

        <div class="act-timeline">
            {groupEntries.map(([label, events]) => (
                <div class="tl-day">
                    <div class="tl-day-head">
                        <span class="d">{label}</span>
                        <span class="c">({events.length})</span>
                        <span class="sum">
                            {daySummary(events).map(([c, n]) => (
                                <span class="b" style={`background: var(--a-${c}-bg); color: var(--a-${c});`}>
                                    <Icon name={`lucide:${CAT_ICON[c]}`} /> {n}
                                </span>
                            ))}
                        </span>
                    </div>
                    {events.map(ev => {
                        const d = detailsMap.get(`${ev.type}:${ev.id}`);
                        const title = d?.title || 'Título desconocido';
                        const poster = d?.poster;
                        const href = ev.type === 'movie' ? `/movie/${ev.id}` : `/serie/${ev.id}`;
                        const time = timeText(ev);
                        const cat = catOf(ev);
                        const isBinge = ev.collection === 'WatchedEpisodes' && (ev.episodes?.length ?? 0) > 0;
                        const binge = isBinge ? bingeView(ev, d) : null;
                        return binge ? (
                            binge.mode === 'single' ? (
                                <a href={href} class="ev" data-cat="ep" data-ts={ev.timestamp} data-ts-start={ev.startTs ?? ev.timestamp}>
                                    <span class="act-ico" style={`background: var(--a-ep-bg); color: var(--a-ep);`}><Icon name="lucide:play" /></span>
                                    {poster ? (
                                        <img src={posterUrl(poster, 'w92')} alt={title} class="poster" loading="lazy"/>
                                    ) : (
                                        <span class="poster"></span>
                                    )}
                                    <span class="meta">
                                        <span class="t">{title}</span>
                                        <span class="sub">
                                            <span class="verb" style="color: var(--a-ep);">{binge.verb}</span>
                                            <span class="sep"></span>
                                            <span>Serie</span>
                                        </span>
                                    </span>
                                    <span class="time">{time}</span>
                                    <Icon name="lucide:chevron-right" class="chev" />
                                </a>
                            ) : binge.mode === 'episodes' ? (
                                <a href={href} class="ev binge" data-cat="ep" data-ts={ev.timestamp} data-ts-start={ev.startTs ?? ev.timestamp}>
                                    <span class="act-ico" style={`background: var(--a-ep-bg); color: var(--a-ep);`}><Icon name="lucide:play" /></span>
                                    {poster ? (
                                        <img src={posterUrl(poster, 'w92')} alt={title} class="poster" loading="lazy"/>
                                    ) : (
                                        <span class="poster"></span>
                                    )}
                                    <span class="body">
                                        <span class="t">{title}</span>
                                        <span class="sub">
                                            <span class="verb" style="color: var(--a-ep);">{binge.verb}</span>
                                        </span>
                                        <span class="ep-chips">
                                            {binge.groups.map(([season, eps]) => (
                                                <>
                                                    <span class="ep-chip season">T{season}</span>
                                                    {eps.map(e => <span class="ep-chip">E{e.episode}</span>)}
                                                </>
                                            ))}
                                        </span>
                                        {binge.times.length > 1 && (
                                            <>
                                                <button class="ev-disclose" type="button">Ver horas <Icon name="lucide:chevron-down" /></button>
                                                <span class="ev-times">
                                                    {binge.times.map(t => (
                                                        <span class="ev-time-row"><b>{t.label}</b><i data-ts={t.ts}>{fmtHm(t.ts)}</i></span>
                                                    ))}
                                                </span>
                                            </>
                                        )}
                                    </span>
                                    <span class="time">{time}</span>
                                </a>
                            ) : binge.mode === 'season' ? (
                                <a href={href} class="ev binge" data-cat="ep" data-ts={ev.timestamp} data-ts-start={ev.startTs ?? ev.timestamp}>
                                    <span class="act-ico" style={`background: var(--a-ep-bg); color: var(--a-ep);`}><Icon name="lucide:play" /></span>
                                    {poster ? (
                                        <img src={posterUrl(poster, 'w92')} alt={title} class="poster" loading="lazy"/>
                                    ) : (
                                        <span class="poster"></span>
                                    )}
                                    <span class="body">
                                        <span class="t">{title}</span>
                                        <span class="sub">
                                            <span class="verb" style="color: var(--a-ep);">{binge.verb}</span>
                                        </span>
                                        <span class="ep-chips">
                                            <span class="ep-chip season done">T{binge.season} ✓</span>
                                        </span>
                                    </span>
                                    <span class="time">{time}</span>
                                </a>
                            ) : (
                                <a href={href} class="ev binge" data-cat="ep" data-ts={ev.timestamp} data-ts-start={ev.startTs ?? ev.timestamp}>
                                    <span class="act-ico" style={`background: var(--a-ep-bg); color: var(--a-ep);`}><Icon name="lucide:play" /></span>
                                    {poster ? (
                                        <img src={posterUrl(poster, 'w92')} alt={title} class="poster" loading="lazy"/>
                                    ) : (
                                        <span class="poster"></span>
                                    )}
                                    <span class="body">
                                        <span class="t">{title}</span>
                                        <span class="sub">
                                            <span class="verb" style="color: var(--a-ep);">{binge.verb}</span>
                                        </span>
                                        <span class="ev-roll">
                                            <span class="roll-meta">{binge.meta}</span>
                                            {binge.pct !== null && (
                                                <>
                                                    <span class="roll-bar"><i style={`width: ${binge.pct}%;`}></i></span>
                                                    <span class="roll-pct">{binge.pct}%</span>
                                                </>
                                            )}
                                        </span>
                                        <button class="ev-disclose" type="button">Ver desglose <Icon name="lucide:chevron-down" /></button>
                                        <span class="ev-grid">
                                            {binge.breakdown.map(ch => (
                                                <span class:list={["ep-chip", "season", { done: ch.done }]}>{ch.label}</span>
                                            ))}
                                        </span>
                                    </span>
                                    <span class="time">{time}</span>
                                </a>
                            )
                        ) : ev.type === 'person' ? (
                            <a href={`/actor/${ev.id}`} class="ev" data-cat={cat} data-ts={ev.timestamp}>
                                <span class="act-ico" style={`background: var(--a-${cat}-bg); color: var(--a-${cat});`}><Icon name={`lucide:${CAT_ICON[cat]}`} /></span>
                                {ev.profile_path ? (
                                    <img src={posterUrl(ev.profile_path, 'w92')} alt={ev.name} class="poster avatar" loading="lazy"/>
                                ) : (
                                    <span class="poster avatar"></span>
                                )}
                                <span class="meta">
                                    <span class="t">{ev.name}</span>
                                    <span class="sub">
                                        <span class="verb" style={`color: var(--a-${cat});`}>{ev.action}</span>
                                        <span class="sep"></span>
                                        <span>Persona</span>
                                    </span>
                                </span>
                                <span class="time">{time}</span>
                                <Icon name="lucide:chevron-right" class="chev" />
                            </a>
                        ) : (
                            <a href={href} class="ev" data-cat={cat} data-ts={ev.timestamp}>
                                <span class="act-ico" style={`background: var(--a-${cat}-bg); color: var(--a-${cat});`}><Icon name={`lucide:${CAT_ICON[cat]}`} /></span>
                                {poster ? (
                                    <img src={posterUrl(poster, 'w92')} alt={title} class="poster" loading="lazy"/>
                                ) : (
                                    <span class="poster"></span>
                                )}
                                <span class="meta">
                                    <span class="t">{title}</span>
                                    <span class="sub">
                                        <span class="verb" style={`color: var(--a-${cat});`}>{ev.action}</span>
                                        <span class="sep"></span>
                                        <span>{ev.type === 'serie' ? 'Serie' : 'Película'}</span>
                                    </span>
                                    {ev.note && <span class="ev-note" title={ev.note}>“{ev.note}”</span>}
                                </span>
                                <span class="time">{time}</span>
                                <Icon name="lucide:chevron-right" class="chev" />
                            </a>
                        );
                    })}
                </div>
            ))}
        </div>

                <div class="act-more">
                    {page > 1 && (
                        <a href={page === 2 ? '/mislistas/actividad' : `/mislistas/actividad?page=${page - 1}`}>
                            <Icon name="lucide:chevron-left" />
                            Más reciente
                        </a>
                    )}
                    {hasOlder && (
                        <a href={`/mislistas/actividad?page=${page + 1}`}>
                            Más antiguo
                            <Icon name="lucide:chevron-right" />
                        </a>
                    )}
                </div>
            </div>
        </div>
    </section>

    <script is:inline>
        // Filtros por acción: oculta filas que no coinciden y días que quedan vacíos.
        // Soporta varios bloques .act-filters (rail desktop + móvil) con estado sincronizado.
        (function () {
            // Zona horaria del NAVEGADOR: el servidor renderiza en UTC, así que la
            // hora y la etiqueta de día (Hoy/Ayer/fecha) se recalculan aquí con la
            // zona del visitante. El valor del servidor queda como fallback sin-JS.
            const dayKey = (d) => d.toLocaleDateString('en-CA'); // YYYY-MM-DD, zona local
            const todayKey = dayKey(new Date());
            const yKey = (() => { const y = new Date(); y.setDate(y.getDate() - 1); return dayKey(y); })();
            const fmtTime = (ts) => new Date(ts).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
            const fmtDay = (d) => {
                const k = dayKey(d);
                if (k === todayKey) return 'Hoy';
                if (k === yKey) return 'Ayer';
                return d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });
            };
            // Una sesión de episodios se pinta como RANGO ("00:47–00:53"): data-ts es el
            // último episodio y data-ts-start el primero. Umbral igual al del servidor.
            const RANGE_MIN_MS = 2 * 60 * 1000;
            document.querySelectorAll('.act-timeline .ev[data-ts]').forEach((ev) => {
                const ts = Number(ev.dataset.ts);
                if (!ts) return;
                const t = ev.querySelector('.time');
                if (!t) return;
                const start = Number(ev.dataset.tsStart || 0);
                const end = fmtTime(ts);
                if (start && ts - start >= RANGE_MIN_MS) {
                    const from = fmtTime(start);
                    t.textContent = from === end ? end : from + '–' + end;
                } else {
                    t.textContent = end;
                }
            });
            // Hora de cada episodio dentro del desplegable "Ver horas".
            document.querySelectorAll('.act-timeline .ev-times i[data-ts]').forEach((el) => {
                const ts = Number(el.dataset.ts);
                if (ts) el.textContent = fmtTime(ts);
            });
            document.querySelectorAll('.act-timeline .tl-day').forEach((day) => {
                // ts representativo del grupo = el INICIO más temprano de sus filas: una
                // sesión que cruza medianoche se archiva en la noche en que empezó, y el
                // servidor ya la agrupó así.
                let minTs = Infinity;
                day.querySelectorAll('.ev[data-ts]').forEach((ev) => {
                    const ts = Number(ev.dataset.tsStart || ev.dataset.ts);
                    if (ts && ts < minTs) minTs = ts;
                });
                const label = day.querySelector('.tl-day-head .d');
                if (minTs !== Infinity && label) label.textContent = fmtDay(new Date(minTs));
            });

            const groups = document.querySelectorAll('.act-filters');
            if (!groups.length) return;
            groups.forEach((group) => {
                group.addEventListener('click', (e) => {
                    const chip = e.target.closest('.chip');
                    if (!chip) return;
                    const filter = chip.dataset.filter;
                    document.querySelectorAll('.act-filters .chip').forEach((c) => {
                        c.classList.toggle('active', c.dataset.filter === filter);
                    });
                    document.querySelectorAll('.act-timeline .tl-day').forEach((day) => {
                        let visible = 0;
                        day.querySelectorAll('.ev').forEach((ev) => {
                            const show = filter === 'all' || ev.dataset.cat === filter;
                            ev.style.display = show ? '' : 'none';
                            if (show) visible++;
                        });
                        day.style.display = visible ? '' : 'none';
                    });
                });
            });

            // "Ver desglose" de los binges-resumen: el botón vive dentro del <a>
            // de la fila, así que hay que frenar la navegación.
            document.querySelectorAll('.ev-disclose').forEach((btn) => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    btn.closest('.ev').classList.toggle('open');
                });
            });
        })();
    </script>
</Layout>
