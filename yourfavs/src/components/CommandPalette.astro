---
/**
 * Command palette ⌘K — búsqueda instantánea multi (películas/series/personas).
 *
 * Overlay global montado en Layout (fuera del Header para no pelear con el
 * stacking del panel móvil). Se abre con ⌘K / Ctrl+K o con el evento
 * `yf:open-palette` (lo dispara la lupa del header). Una llamada con debounce
 * a /api/search/multi por tecleo; navegación ↑↓ + Enter; Esc cierra.
 */
import '../styles/components/command-palette.css';
// 4.3 · el toggle "Lo mío" solo aparece con sesión (necesita la biblioteca del uid).
const isLogged = !!Astro.locals.user;
---
<div class="cmdk-overlay" id="cmdk" role="dialog" aria-modal="true" aria-label="Buscar en YourFavs" data-logged={isLogged ? '1' : '0'} hidden>
    <div class="cmdk-panel">
        <div class="cmdk-input-row">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input
                id="cmdk-input"
                class="cmdk-input"
                type="text"
                placeholder="Buscar películas, series, personas..."
                autocomplete="off"
                spellcheck="false"
                aria-label="Buscar"
            />
            <button class="cmdk-go" id="cmdk-go" type="button" hidden>Buscar</button>
            <span class="cmdk-kbd">ESC</span>
        </div>

        <div class="cmdk-scope" role="tablist" aria-label="Ámbito de búsqueda">
            <button class="cmdk-scope-btn is-active" type="button" data-scope="all" role="tab" aria-selected="true">Todo</button>
            {isLogged && (
                <button class="cmdk-scope-btn" type="button" data-scope="mine" role="tab" aria-selected="false">Lo mío</button>
            )}
            <button class="cmdk-scope-btn" type="button" data-scope="cast" role="tab" aria-selected="false">Por reparto</button>
        </div>

        <!-- Barra "Por reparto": chips de actores + toggle Y/O + contador (solo en ese modo) -->
        <div class="cmdk-cast" id="cmdk-cast" hidden>
            <div class="cmdk-chips" id="cmdk-chips" aria-label="Actores elegidos"></div>
            <div class="cmdk-cast-controls">
                <div class="cmdk-seg" role="group" aria-label="Tipo de coincidencia">
                    <button type="button" class="cmdk-seg-btn is-on" data-castmode="and" aria-pressed="true">Todos juntos</button>
                    <button type="button" class="cmdk-seg-btn" data-castmode="or" aria-pressed="false">Cualquiera</button>
                </div>
                <span class="cmdk-cast-count" id="cmdk-cast-count" aria-live="polite"></span>
            </div>
        </div>

        <div class="cmdk-results" id="cmdk-results" role="listbox" aria-label="Resultados">
            <!-- El JS pinta aquí recientes + acciones al abrir (renderEmpty) -->
        </div>

        <div class="cmdk-footer">
            <span class="cmdk-hint-keys"><span class="cmdk-kbd">↵</span> ver todos</span>
            <span class="cmdk-hint-keys"><span class="cmdk-kbd">↑↓</span>+<span class="cmdk-kbd">↵</span> abrir</span>
            <a class="cmdk-see-all" id="cmdk-see-all" href="/catalogo/busqueda" hidden>Ver todos los resultados</a>
        </div>
    </div>
</div>

<script is:inline>
(function () {
    var overlay = document.getElementById('cmdk');
    if (!overlay) return;
    var input = document.getElementById('cmdk-input');
    var results = document.getElementById('cmdk-results');
    var seeAll = document.getElementById('cmdk-see-all');
    var goBtn = document.getElementById('cmdk-go');

    var items = [];          // items planos renderizados (en orden visual)
    var selected = -1;       // índice resaltado en `items`
    var navKeyboard = false; // ¿el resaltado vino de ↑↓? Solo entonces Enter abre el item
    var debounceTimer = null;
    var controller = null;   // AbortController del fetch en vuelo
    var lastFocus = null;    // foco previo, para restaurarlo al cerrar
    var mode = 'all';        // 'all' = TMDB (multi) · 'mine' = mi biblioteca (4.3) · 'cast' = por reparto

    // ---- "Por reparto": chips de actores + intersección de sus repartos ----
    var castBar = document.getElementById('cmdk-cast');
    var chipsWrap = document.getElementById('cmdk-chips');
    var castCountEl = document.getElementById('cmdk-cast-count');
    var castChips = [];      // [{id, name, image}]
    var castMode = 'and';    // 'and' = todos juntos · 'or' = cualquiera
    var castCtrl = null;     // AbortController de la intersección (/api/search/cast)

    var GROUP_LABELS = { movie: 'PELÍCULAS', tv: 'SERIES', person: 'PERSONAS' };
    var GROUP_ORDER = ['movie', 'tv', 'person'];

    // ---- estado vacío: recientes (localStorage) + acciones rápidas ----
    var LS_RECENT = 'yf_cmdk_recent';
    var RECENT_MAX = 5;
    var ICON_CLOCK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>';
    var ACTIONS = [
        { label: 'Ir a mis favoritos', href: '/mislistas/favoritos',
          icon: '<svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z"/></svg>' },
        { label: 'Abrir calendario', href: '/mislistas/calendario',
          icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>' },
        { label: 'Tendencias de hoy', href: '/catalogo/tendencias',
          icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"/><path d="M14 7h7v7"/></svg>' },
        { label: '¿Qué veo? — ruleta', href: '/mislistas/pendientes?roulette=1', action: 'roulette',
          icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="15.5" cy="8.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none"/><circle cx="8.5" cy="15.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="15.5" cy="15.5" r="1.3" fill="currentColor" stroke="none"/></svg>' },
    ];

    function getRecents() {
        try { return JSON.parse(localStorage.getItem(LS_RECENT) || '[]'); } catch { return []; }
    }

    function saveRecent(it) {
        try {
            var entry = { title: it.title, subtitle: it.subtitle || '', href: it.href, media_type: it.media_type };
            var list = getRecents().filter(function (r) { return r.href !== entry.href; });
            list.unshift(entry);
            localStorage.setItem(LS_RECENT, JSON.stringify(list.slice(0, RECENT_MAX)));
        } catch {}
    }
    var EMPTY_ICONS = {
        movie: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M11 4v16"/></svg>',
        tv: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M8 3l4 3 4-3"/></svg>',
        person: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>'
    };

    function escapeHtml(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ---- apertura / cierre ----
    function open() {
        if (overlay.classList.contains('is-open')) return;
        lastFocus = document.activeElement;
        overlay.hidden = false;
        overlay.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        input.focus();
        input.select();
        if (input.value.trim().length < 2) { if (mode === 'cast') renderCastState(); else renderEmpty(); }
    }

    function close() {
        overlay.classList.remove('is-open');
        overlay.hidden = true;
        document.body.style.overflow = '';
        if (controller) controller.abort();
        if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    // ⌘K / Ctrl+K global (el preventDefault evita el atajo nativo del navegador)
    document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
            e.preventDefault();
            if (overlay.classList.contains('is-open')) close(); else open();
        }
    });

    // Trigger externo (lupa del header)
    document.addEventListener('yf:open-palette', open);

    // ---- toggle Todo | Lo mío (4.3, solo con sesión) ----
    var scopeBtns = overlay.querySelectorAll('.cmdk-scope-btn');
    function setMode(m) {
        if (mode === m) return;
        mode = m;
        scopeBtns.forEach(function (b) {
            var on = b.getAttribute('data-scope') === m;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        castBar.hidden = (m !== 'cast');

        if (m === 'cast') {
            input.value = '';
            input.placeholder = 'Añade un actor por su nombre…';
            updateSeeAll('');       // en "Por reparto" no hay "ver todos"
            renderChips();
            renderCastState();      // intersección actual (o pista si no hay actores)
            input.focus();
            return;
        }

        input.placeholder = m === 'mine'
            ? 'Buscar en tu biblioteca (título o etiqueta)...'
            : 'Buscar películas, series, personas...';
        var q = input.value.trim();
        if (q.length >= (m === 'mine' ? 1 : 2)) runSearch(q); else { renderEmpty(); updateSeeAll(''); }
        input.focus();
    }
    scopeBtns.forEach(function (b) {
        b.addEventListener('click', function () { setMode(b.getAttribute('data-scope')); });
    });

    // Click en el backdrop cierra (el panel hace stopPropagation implícito por target)
    overlay.addEventListener('mousedown', function (e) {
        if (e.target === overlay) close();
    });

    // ---- búsqueda ----
    input.addEventListener('input', function () {
        var q = input.value.trim();
        if (debounceTimer) clearTimeout(debounceTimer);

        // Tecleo nuevo invalida cualquier selección (p. ej. por hover casual):
        // Enter inmediato debe ir a "todos los resultados", no a un item viejo.
        if (selected >= 0) {
            var sel = results.querySelector('.cmdk-item[aria-selected="true"]');
            if (sel) sel.setAttribute('aria-selected', 'false');
            selected = -1;
        }
        navKeyboard = false;

        // En "Por reparto" el input añade actores: <2 letras → intersección actual;
        // si no, autocompletar de personas para elegir a quién añadir.
        if (mode === 'cast') {
            if (q.length < 2) { renderCastState(); return; }
            debounceTimer = setTimeout(function () { runCastAutocomplete(q); }, 250);
            return;
        }

        var minLen = mode === 'mine' ? 1 : 2;
        if (q.length < minLen) {
            renderEmpty();
            updateSeeAll('');
            return;
        }

        debounceTimer = setTimeout(function () { runSearch(q); }, 250);
    });

    function runSearch(q) {
        if (controller) controller.abort();
        controller = new AbortController();

        var endpoint = mode === 'mine'
            ? '/api/search/personal?q=' + encodeURIComponent(q)
            : '/api/search/multi?q=' + encodeURIComponent(q);

        fetch(endpoint, { signal: controller.signal })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                // Descarta respuestas tardías de otra query
                if (input.value.trim() !== data.query) return;
                render(data.items || []);
                updateSeeAll(q);
            })
            .catch(function (err) {
                if (err && err.name === 'AbortError') return;
                renderHint('No se pudo buscar. Inténtalo de nuevo.');
            });
    }

    // ---- render ----
    function renderHint(text) {
        items = [];
        selected = -1;
        results.innerHTML = '<p class="cmdk-hint">' + escapeHtml(text) + '</p>';
    }

    // Input vacío: recientes + acciones, en el MISMO items[] que la búsqueda
    // → ↑↓/Enter/hover funcionan sin código de navegación nuevo.
    function renderEmpty() {
        items = [];
        selected = -1;
        var html = '';

        var recents = getRecents();
        if (recents.length) {
            html += '<div class="cmdk-group-label">BÚSQUEDAS RECIENTES</div>';
            recents.forEach(function (it) {
                var idx = items.length;
                items.push(it);
                html += '<a class="cmdk-item" role="option" aria-selected="false" data-idx="' + idx + '" href="' + escapeHtml(it.href) + '">';
                html += '<span class="cmdk-recent-icon" aria-hidden="true">' + ICON_CLOCK + '</span>';
                html += '<span class="cmdk-item-body"><span class="cmdk-item-title">' + escapeHtml(it.title) + '</span>';
                if (it.subtitle) html += '<span class="cmdk-item-meta">' + escapeHtml(it.subtitle) + '</span>';
                html += '</span></a>';
            });
        }

        html += '<div class="cmdk-group-label">ACCIONES RÁPIDAS</div>';
        ACTIONS.forEach(function (it) {
            var idx = items.length;
            items.push(it);
            html += '<a class="cmdk-item" role="option" aria-selected="false" data-idx="' + idx + '" href="' + escapeHtml(it.href) + '"' + (it.action ? ' data-action="' + it.action + '"' : '') + '>';
            html += '<span class="cmdk-action-icon" aria-hidden="true">' + it.icon + '</span>';
            html += '<span class="cmdk-item-body"><span class="cmdk-item-title">' + escapeHtml(it.label) + '</span></span>';
            html += '</a>';
        });

        results.innerHTML = html;
    }

    // Abrir un item (Enter o click): la ruleta se abre en la propia página si
    // su modal existe; si no, navega a pendientes con auto-open (?roulette=1).
    function openItem(it) {
        if (it.castAdd) { addPerson(it.castAdd); return; }   // sugerencia "Por reparto"
        if (it.action === 'roulette' && document.getElementById('wtw')) {
            close();
            document.dispatchEvent(new CustomEvent('yf:open-roulette'));
            return;
        }
        if (it.media_type) saveRecent(it);
        location.href = it.href;
    }

    function render(list) {
        items = [];
        selected = -1;

        if (!list.length) {
            renderHint('Sin resultados para «' + input.value.trim() + '»');
            return;
        }

        var html = '';
        GROUP_ORDER.forEach(function (type) {
            var group = list.filter(function (it) { return it.media_type === type; });
            if (!group.length) return;
            html += '<div class="cmdk-group-label">' + GROUP_LABELS[type] + '</div>';
            group.forEach(function (it) {
                var idx = items.length;
                items.push(it);
                html += '<a class="cmdk-item" role="option" aria-selected="false" data-idx="' + idx + '" href="' + escapeHtml(it.href) + '">';
                html += it.image
                    ? '<img class="cmdk-thumb" src="' + escapeHtml(it.image) + '" alt="" loading="lazy" onerror="this.style.visibility=\'hidden\'"/>'
                    : '<span class="cmdk-thumb is-empty" aria-hidden="true">' + EMPTY_ICONS[type] + '</span>';
                html += '<span class="cmdk-item-body">';
                html += '<span class="cmdk-item-title">' + escapeHtml(it.title) + '</span>';
                html += '<span class="cmdk-item-meta">' + escapeHtml(it.subtitle) + '</span>';
                html += '</span>';
                if (it.rating != null) html += '<span class="cmdk-item-rating">★ ' + it.rating.toLocaleString('es-ES', { maximumFractionDigits: 1 }) + '</span>';
                html += '</a>';
            });
        });

        results.innerHTML = html;
        // Sin preselección: Enter "a pelo" lleva a todos los resultados;
        // solo ↑↓ (intención explícita) hace que Enter abra un item.
    }

    // ==== "Por reparto": chips + intersección ==============================

    function chipInitials(name) {
        return String(name).replace(/[#\d]/g, '').trim().split(/\s+/)
            .map(function (w) { return w.charAt(0); }).slice(0, 2).join('').toUpperCase();
    }

    function renderChips() {
        var html = '';
        castChips.forEach(function (c) {
            var av = c.image
                ? '<img class="cmdk-chip-av" src="' + escapeHtml(c.image) + '" alt=""/>'
                : '<span class="cmdk-chip-av">' + escapeHtml(chipInitials(c.name)) + '</span>';
            html += '<span class="cmdk-chip">' + av +
                '<span class="cmdk-chip-name">' + escapeHtml(c.name) + '</span>' +
                '<button type="button" class="cmdk-chip-x" data-id="' + escapeHtml(c.id) + '" aria-label="Quitar a ' + escapeHtml(c.name) + '">' +
                '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button></span>';
        });
        chipsWrap.innerHTML = html;
    }

    function addPerson(c) {
        if (castChips.some(function (x) { return x.id === c.id; })) return;  // sin duplicados
        if (castChips.length >= 5) return;                                  // tope
        castChips.push(c);
        input.value = '';
        renderChips();
        renderCastState();
        input.focus();
    }

    function removePerson(id) {
        castChips = castChips.filter(function (c) { return c.id !== id; });
        renderChips();
        renderCastState();
        input.focus();
    }

    // Autocompletar de personas (reusa /api/search/multi, filtra media_type person).
    function runCastAutocomplete(q) {
        if (controller) controller.abort();
        controller = new AbortController();
        fetch('/api/search/multi?q=' + encodeURIComponent(q), { signal: controller.signal })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (mode !== 'cast' || input.value.trim() !== data.query) return;
                var persons = (data.items || []).filter(function (it) {
                    return it.media_type === 'person' && !castChips.some(function (c) { return c.id === String(it.id); });
                });
                renderCastSuggestions(persons);
            })
            .catch(function (err) { if (!err || err.name !== 'AbortError') renderHint('No se pudo buscar. Inténtalo de nuevo.'); });
    }

    function renderCastSuggestions(persons) {
        items = [];
        selected = -1;
        if (!persons.length) {
            renderHint('Sin actores para «' + input.value.trim() + '»');
            return;
        }
        var html = '<div class="cmdk-group-label">AÑADIR ACTOR</div>';
        persons.slice(0, 8).forEach(function (it) {
            var idx = items.length;
            items.push({ castAdd: { id: String(it.id), name: it.title, image: it.image || null } });
            var av = it.image
                ? '<img class="cmdk-thumb cmdk-thumb-round" src="' + escapeHtml(it.image) + '" alt="" loading="lazy" onerror="this.style.visibility=\'hidden\'"/>'
                : '<span class="cmdk-thumb cmdk-thumb-round is-empty" aria-hidden="true">' + EMPTY_ICONS.person + '</span>';
            html += '<div class="cmdk-item" role="option" aria-selected="false" data-idx="' + idx + '">' + av +
                '<span class="cmdk-item-body"><span class="cmdk-item-title">' + escapeHtml(it.title) + '</span>' +
                '<span class="cmdk-item-meta">' + escapeHtml(it.subtitle || 'Interpretación') + '</span></span>' +
                '<span class="cmdk-add" aria-hidden="true">+</span></div>';
        });
        results.innerHTML = html;
        // Preselección: Enter añade el primero (autocompletar típico).
        if (items.length) select(0, true);
    }

    // Input vacío en modo reparto: sin actores → pista; con actores → intersección.
    function renderCastState() {
        if (!castChips.length) {
            items = [];
            selected = -1;
            castCountEl.textContent = '';
            castCountEl.classList.remove('has');
            results.innerHTML = '<p class="cmdk-hint">Añade 2 o más actores para ver los títulos donde coinciden.</p>';
            return;
        }
        fetchIntersection();
    }

    function fetchIntersection() {
        if (castCtrl) castCtrl.abort();
        castCtrl = new AbortController();
        var ids = castChips.map(function (c) { return c.id; }).join(',');
        results.innerHTML = '<p class="cmdk-hint">Buscando…</p>';
        fetch('/api/search/cast?ids=' + encodeURIComponent(ids) + '&mode=' + castMode, { signal: castCtrl.signal })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (mode !== 'cast') return;
                renderCastResults(data.items || [], data.count || 0);
            })
            .catch(function (err) { if (!err || err.name !== 'AbortError') renderHint('No se pudo buscar. Inténtalo de nuevo.'); });
    }

    function renderCastResults(list, count) {
        items = [];
        selected = -1;
        castCountEl.textContent = count ? ('● ' + count + (count === 1 ? ' título' : ' títulos')) : '';
        castCountEl.classList.toggle('has', !!count);

        if (!list.length) {
            // "Todos juntos" sin resultados con 2+ actores → sugerir "Cualquiera" (no error).
            if (castMode === 'and' && castChips.length >= 2) {
                results.innerHTML = '<p class="cmdk-hint">Ningún título donde salgan todos. ' +
                    '<button type="button" class="cmdk-inline-link" id="cmdk-try-or">Probar «Cualquiera»</button></p>';
                var tryOr = document.getElementById('cmdk-try-or');
                if (tryOr) tryOr.addEventListener('click', function () { setCastMode('or'); });
            } else {
                renderHint('Sin títulos para estos actores.');
            }
            return;
        }

        var html = '<div class="cmdk-group-label">' + (castMode === 'and' ? 'COINCIDEN' : 'CUALQUIERA DE ELLOS') + '</div>';
        list.forEach(function (it) {
            var idx = items.length;
            var href = it.media_type === 'movie' ? '/movie/' + it.id : '/serie/' + it.id;
            var sub = (it.year ? it.year + ' · ' : '') + (it.media_type === 'movie' ? 'Película' : 'Serie');
            items.push({ title: it.title, subtitle: sub, href: href, media_type: it.media_type, image: it.image });
            html += '<a class="cmdk-item" role="option" aria-selected="false" data-idx="' + idx + '" href="' + escapeHtml(href) + '">';
            html += it.image
                ? '<img class="cmdk-thumb" src="' + escapeHtml(it.image) + '" alt="" loading="lazy" onerror="this.style.visibility=\'hidden\'"/>'
                : '<span class="cmdk-thumb is-empty" aria-hidden="true">' + EMPTY_ICONS[it.media_type] + '</span>';
            html += '<span class="cmdk-item-body"><span class="cmdk-item-title">' + escapeHtml(it.title) + '</span>' +
                '<span class="cmdk-item-meta">' + escapeHtml(sub) + '</span></span>';
            if (it.rating != null) html += '<span class="cmdk-item-rating">★ ' + it.rating.toLocaleString('es-ES', { maximumFractionDigits: 1 }) + '</span>';
            html += '</a>';
        });
        results.innerHTML = html;
    }

    function setCastMode(m) {
        if (castMode === m) return;
        castMode = m;
        castSegBtns.forEach(function (b) {
            var on = b.getAttribute('data-castmode') === m;
            b.classList.toggle('is-on', on);
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        renderCastState();
        input.focus();
    }

    var castSegBtns = overlay.querySelectorAll('.cmdk-seg-btn');
    castSegBtns.forEach(function (b) {
        b.addEventListener('click', function () { setCastMode(b.getAttribute('data-castmode')); });
    });
    chipsWrap.addEventListener('click', function (e) {
        var btn = e.target.closest('.cmdk-chip-x');
        if (btn) removePerson(btn.getAttribute('data-id'));
    });

    function updateSeeAll(q) {
        // "Lo mío" y "Por reparto" no tienen página de "ver todos".
        if (!q || mode === 'mine' || mode === 'cast') {
            seeAll.hidden = true;
            if (goBtn) goBtn.hidden = true;
            return;
        }
        var href = '/catalogo/busqueda?query=' + encodeURIComponent(q);
        seeAll.hidden = false;
        seeAll.href = href;
        seeAll.textContent = 'Ver todos los resultados de «' + q + '»';
        if (goBtn) { goBtn.hidden = false; goBtn.dataset.href = href; }
    }

    // Botón "Buscar": misma acción que Enter directo (búsqueda completa en /catalogo/busqueda).
    if (goBtn) goBtn.addEventListener('click', function () {
        if (goBtn.dataset.href) location.href = goBtn.dataset.href;
    });

    // ---- navegación por teclado ----
    function select(idx, byKeyboard) {
        var nodes = results.querySelectorAll('.cmdk-item');
        if (!nodes.length) return;
        if (selected >= 0 && nodes[selected]) nodes[selected].setAttribute('aria-selected', 'false');
        selected = (idx + nodes.length) % nodes.length;
        navKeyboard = !!byKeyboard; // hover → false (solo resalta); ↑↓ → true (Enter abre)
        nodes[selected].setAttribute('aria-selected', 'true');
        if (byKeyboard) nodes[selected].scrollIntoView({ block: 'nearest' });
    }

    input.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown') { e.preventDefault(); select(selected + 1, true); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); select(selected - 1, true); }
        else if (e.key === 'Enter') {
            e.preventDefault();
            if (selected >= 0 && navKeyboard && items[selected]) {
                // Selección explícita con ↑↓ → abre ese item (ficha o acción)
                openItem(items[selected]);
            } else if (!seeAll.hidden) {
                // Enter directo (o tras solo hover) → búsqueda completa, no una ficha al azar
                location.href = seeAll.href;
            }
        }
    });

    // Esc cierra desde cualquier punto del overlay; Tab queda atrapado input ↔ "ver todos"
    overlay.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { e.preventDefault(); close(); }
        else if (e.key === 'Tab') {
            e.preventDefault();
            if (document.activeElement === input && !seeAll.hidden) seeAll.focus();
            else input.focus();
        }
    });

    // Hover sincroniza la selección (evita dos "activos" a la vez)
    results.addEventListener('mousemove', function (e) {
        var item = e.target.closest('.cmdk-item');
        if (item) {
            var idx = parseInt(item.getAttribute('data-idx'), 10);
            if (idx !== selected || navKeyboard) select(idx, false); // hover: solo resalta, Enter NO abre
        }
    });

    // Click: guarda el reciente antes de navegar; la ruleta se intercepta
    // (si el modal vive en esta página) en vez de navegar a pendientes.
    results.addEventListener('click', function (e) {
        var node = e.target.closest('.cmdk-item');
        if (!node) return;
        var it = items[parseInt(node.getAttribute('data-idx'), 10)];
        if (!it) return;
        if (it.castAdd) { e.preventDefault(); addPerson(it.castAdd); return; }   // añadir actor
        if (it.action === 'roulette' && document.getElementById('wtw')) {
            e.preventDefault();
            close();
            document.dispatchEvent(new CustomEvent('yf:open-roulette'));
            return;
        }
        if (it.media_type) saveRecent(it);
        // navegación: el <a> sigue su curso
    });
})();
</script>
