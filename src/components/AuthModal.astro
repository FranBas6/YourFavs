---
/**
 * Modal de login / registro — Fase B.2.
 *
 * Montado en Layout (global). Se abre con cualquier disparador `[data-auth-open]`
 * y se cierra con Esc / backdrop / ✕. Login y registro comparten tarjeta y
 * alternan con un toggle. Google + email/contraseña + "¿olvidaste?".
 *
 * Las acciones (../utils/authActions) son `fetch` a /api/auth/*: el login lo hace el
 * servidor con Supabase y deja la sesión en cookies httpOnly. Google va por redirección
 * (no popup): al volver, /auth/callback trae `?auth=ok|new|error` y aquí se completa lo
 * mismo que antes tras el popup (acción pendiente del invitado u onboarding).
 *
 * Confirmación de email (F0 de docs/PLAN_SOCIAL.md): si el registro queda pendiente de confirmar,
 * o alguien intenta entrar sin haber confirmado, la tarjeta pasa a la vista «Revisa tu correo»
 * (`#auth-pending`) con botón de reenviar. Al volver de un enlace caducado, `?auth=link`.
 *
 * Invitaciones (F2 social, handoff D14): si el navegador trae la cookie `yf_ref` (visitó un perfil
 * público), el registro enseña «Te invita Ana · @ana» y que la seguirá al crear la cuenta. Con
 * `SIGNUP_MODE=invite` y sin invitación, el modal abre en «Entrar» y cambia «¿No tienes cuenta?
 * Regístrate» por la explicación, ANTES de que lo intente. `?auth=invite` = Google rechazado.
 */
import { signupMode } from '../lib/social/signupMode';
const mode = signupMode();
---
<div class="auth-overlay" id="auth-modal" role="dialog" aria-modal="true" aria-labelledby="auth-title" data-signup-mode={mode} hidden>
    <div class="auth-card" role="document">
        <button type="button" class="auth-close" data-auth-close aria-label="Cerrar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>

        <h2 class="auth-title" id="auth-title">Entra en YourFavs</h2>
        <p class="auth-sub" id="auth-sub">Guarda tus pelis y series, sigue actores y más.</p>

        <!-- «Te invita…»: solo en «Crear cuenta» y si se llegó por el enlace de un perfil activo. -->
        <div class="auth-inv" id="auth-inv" hidden>
            <span class="auth-inv-av" id="auth-inv-av" aria-hidden="true"><img id="auth-inv-img" alt="" hidden /><span id="auth-inv-ini"></span></span>
            <div>
                <div class="auth-inv-t">Te invita <span id="auth-inv-name"></span> · @<span id="auth-inv-handle"></span></div>
                <div class="auth-inv-s" id="auth-inv-s"></div>
            </div>
        </div>

        <button type="button" class="auth-google" data-auth-google>
            <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.56c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.56-2.76c-.98.66-2.23 1.06-3.72 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/>
            </svg>
            Continuar con Google
        </button>

        <div class="auth-divider"><span>o</span></div>

        <form class="auth-form" id="auth-form" novalidate>
            <label class="auth-field">
                <span>Email</span>
                <input type="email" name="email" id="auth-email" required autocomplete="email" placeholder="tu@email.com"/>
            </label>
            <label class="auth-field">
                <span>Contraseña</span>
                <div class="auth-pass-wrap">
                    <input type="password" name="password" id="auth-password" required autocomplete="current-password" minlength="6" placeholder="Mínimo 6 caracteres"/>
                    <button type="button" class="auth-pass-toggle" id="auth-pass-toggle" aria-label="Mostrar contraseña" aria-pressed="false">
                        <svg class="eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>
            </label>

            <p class="auth-msg" id="auth-msg" role="alert" hidden></p>

            <button type="submit" class="auth-submit" id="auth-submit">Entrar</button>
        </form>

        <button type="button" class="auth-forgot" data-auth-forgot>¿Olvidaste la contraseña?</button>

        <p class="auth-toggle">
            <span data-mode="login">¿No tienes cuenta? <button type="button" class="auth-link" data-auth-switch="register">Regístrate</button></span>
            <span data-mode="register" hidden>¿Ya tienes cuenta? <button type="button" class="auth-link" data-auth-switch="login">Entra</button></span>
        </p>

        <!-- Modo invitación sin invitación: sustituye a «¿No tienes cuenta? Regístrate». -->
        <div class="auth-gate" id="auth-gate" role="note" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2M13 17v2M13 11v2"/></svg>
            <div>
                <b>Ahora mismo, cuentas nuevas solo por invitación</b>
                Durante una temporada solo se registra quien llega desde el enlace de alguien que ya está dentro. Pide a un amigo el enlace de su perfil. Si ya tienes cuenta, entra con normalidad.
            </div>
        </div>

        <!-- «Revisa tu correo»: sustituye a Google + formulario mientras falta confirmar el email. -->
        <div class="auth-pending" id="auth-pending" hidden>
            <span class="auth-pending-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            </span>
            <p class="auth-pending-text">
                Te hemos enviado un enlace a <strong id="auth-pending-email"></strong>. Ábrelo para
                activar tu cuenta: vale desde el móvil o desde cualquier navegador.
            </p>
            <p class="auth-pending-hint">
                Si en un par de minutos no ha llegado, mira en spam. Si ese email ya tenía cuenta, no
                te llegará nada: entra con tu contraseña o recupérala.
            </p>
            <p class="auth-msg" id="auth-pending-msg" role="status" hidden></p>
            <button type="button" class="auth-submit" id="auth-resend">Reenviar el enlace</button>
            <button type="button" class="auth-forgot" data-auth-pending-back>Volver a entrar</button>
        </div>
    </div>
</div>

<style>
    .auth-overlay {
        position: fixed;
        inset: 0;
        z-index: 10001;
        background: rgba(15, 23, 42, .55);
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
        display: none;
        align-items: flex-start;
        justify-content: center;
        padding: 8vh 16px 16px;
    }
    .auth-overlay.is-open { display: flex; }

    .auth-card {
        position: relative;
        width: 420px;
        max-width: 100%;
        background: var(--bg-elev);
        border: 1px solid var(--border);
        border-radius: var(--r-xl, 16px);
        box-shadow: 0 30px 80px rgba(0, 0, 0, .5);
        padding: 28px 28px 22px;
        animation: auth-pop .14s ease-out;
    }
    @keyframes auth-pop {
        from { opacity: 0; transform: translateY(-8px) scale(.98); }
        to   { opacity: 1; transform: none; }
    }

    .auth-close {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 32px;
        height: 32px;
        border-radius: var(--r-full, 999px);
        border: 1px solid var(--border);
        background: var(--bg-tint);
        color: var(--text-3);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }
    .auth-close:hover { color: var(--text); border-color: var(--border-strong); }
    .auth-close svg { width: 15px; height: 15px; }

    .auth-title { margin: 0 0 6px; font-size: 22px; font-weight: 700; color: var(--text); }
    .auth-sub { margin: 0 0 22px; font-size: 13.5px; color: var(--text-3); }

    .auth-google {
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 11px 16px;
        border-radius: var(--r-full, 999px);
        border: 1px solid var(--border-strong, var(--border));
        background: var(--bg-elev);
        color: var(--text);
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s ease, border-color .15s ease;
    }
    .auth-google:hover { background: var(--bg-tint); }

    .auth-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 18px 0;
        color: var(--text-4);
        font-size: 12px;
    }
    .auth-divider::before, .auth-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border);
    }

    /* `hidden` tiene que ganar a los `display` de aquí (Google, «o», formulario, «¿Olvidaste…?»): sin esto,
       «Revisa tu correo» salía DEBAJO del formulario en vez de sustituirlo y «¿Olvidaste la contraseña?»
       seguía en «Crear cuenta». */
    #auth-modal [hidden] { display: none !important; }
    .auth-form { display: flex; flex-direction: column; gap: 13px; }
    .auth-field { display: flex; flex-direction: column; gap: 5px; }
    .auth-field span { font-size: 12px; font-weight: 600; color: var(--text-2); }
    .auth-field input {
        width: 100%;
        padding: 10px 12px;
        border-radius: 9px;
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--text);
        font-size: 14px;
        font-family: inherit;
    }
    .auth-field input:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-soft);
    }

    .auth-pass-wrap { position: relative; }
    .auth-pass-wrap input { padding-right: 42px; } /* hueco para el ojo */
    .auth-pass-toggle {
        position: absolute;
        top: 50%;
        right: 8px;
        transform: translateY(-50%);
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: none;
        color: var(--text-4);
        cursor: pointer;
        border-radius: 6px;
    }
    .auth-pass-toggle:hover { color: var(--text-2); }
    .auth-pass-toggle svg { width: 17px; height: 17px; }
    .auth-pass-toggle .eye-off { display: none; }
    .auth-pass-toggle[aria-pressed="true"] .eye { display: none; }
    .auth-pass-toggle[aria-pressed="true"] .eye-off { display: block; }

    .auth-msg {
        margin: 0;
        font-size: 12.5px;
        padding: 9px 11px;
        border-radius: 8px;
        background: var(--stamp-red);
        color: var(--stamp-red-ink);
    }
    .auth-msg.is-ok { background: var(--ok-soft); color: var(--ok-ink); }

    .auth-submit {
        margin-top: 3px;
        width: 100%;
        padding: 11px 16px;
        border-radius: var(--r-full, 999px);
        border: none;
        /* --accent-dark en reposo: blanco sobre --accent da 4,2:1 y no pasa AA (handoff social §7.7). */
        background: var(--accent-dark);
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s ease;
    }
    .auth-submit:hover { background: var(--accent); }
    .auth-submit:disabled, .auth-google:disabled { opacity: .6; cursor: progress; }

    .auth-forgot {
        display: block;
        margin: 14px auto 0;
        background: none;
        border: none;
        color: var(--text-3);
        font-size: 12.5px;
        cursor: pointer;
        text-decoration: underline;
    }
    .auth-forgot:hover { color: var(--accent); }

    .auth-toggle {
        margin: 16px 0 0;
        text-align: center;
        font-size: 13px;
        color: var(--text-3);
        border-top: 1px solid var(--border);
        padding-top: 16px;
    }
    .auth-link {
        background: none;
        border: none;
        color: var(--accent-dark);
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        padding: 0;
    }
    .auth-link:hover { text-decoration: underline; }
    :global([data-theme="dark"]) .auth-link { color: var(--stamp-red-ink); }

    /* Invitación (handoff social D14). */
    .auth-inv {
        display: flex; align-items: center; gap: 12px; padding: 12px 14px; margin-bottom: 18px;
        border-radius: var(--r-md); background: var(--stamp-green); color: var(--stamp-green-ink);
    }
    .auth-inv[hidden] { display: none; }
    .auth-inv-av {
        position: relative;
        width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0; overflow: hidden;
        display: grid; place-items: center; background: var(--sb, var(--bg-elev)); color: var(--si, var(--text));
        font: 600 12px var(--font);
    }
    .auth-inv-av img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .auth-inv-t { font: 600 13px var(--font); }
    .auth-inv-s { font-size: 12px; line-height: 1.45; opacity: .95; }
    .auth-gate {
        display: flex; gap: 12px; padding: 14px; margin-top: 16px; border-radius: var(--r-md);
        background: var(--stamp-amber); color: var(--stamp-amber-ink); font-size: 12.5px; line-height: 1.5;
    }
    .auth-gate[hidden] { display: none; }
    .auth-gate b { display: block; font-weight: 600; font-size: 13px; margin-bottom: 2px; }
    .auth-gate svg { width: 18px; height: 18px; margin-top: 1px; flex-shrink: 0; }

    /* Vista «Revisa tu correo» (confirmación de email pendiente). */
    .auth-pending { display: flex; flex-direction: column; gap: 12px; }
    .auth-pending[hidden] { display: none; }
    .auth-pending-ico {
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--r-full, 999px);
        background: var(--accent-soft);
        color: var(--accent);
    }
    .auth-pending-ico svg { width: 22px; height: 22px; }
    .auth-pending-text { margin: 0; font-size: 14px; line-height: 1.5; color: var(--text-2); }
    .auth-pending-text strong { color: var(--text); word-break: break-all; }
    .auth-pending-hint { margin: 0; font-size: 12.5px; color: var(--text-3); }

    @media (max-width: 480px) {
        .auth-overlay { padding: 5vh 12px 12px; }
        .auth-card { padding: 24px 20px 18px; }
    }
</style>

<script>
    import type * as AuthActions from '../utils/authActions';
    import { SOCIAL_PHASE } from '../utils/constants/social';

    const overlay = document.getElementById('auth-modal') as HTMLElement | null;
    if (overlay) {
        const card = overlay.querySelector('.auth-card') as HTMLElement;
        const form = document.getElementById('auth-form') as HTMLFormElement;
        const emailInput = document.getElementById('auth-email') as HTMLInputElement;
        const passInput = document.getElementById('auth-password') as HTMLInputElement;
        const submitBtn = document.getElementById('auth-submit') as HTMLButtonElement;
        const googleBtn = overlay.querySelector('[data-auth-google]') as HTMLButtonElement;
        const msgEl = document.getElementById('auth-msg') as HTMLElement;
        const titleEl = document.getElementById('auth-title') as HTMLElement;
        const subEl = document.getElementById('auth-sub') as HTMLElement;
        const pendingEl = document.getElementById('auth-pending') as HTMLElement;
        const pendingEmailEl = document.getElementById('auth-pending-email') as HTMLElement;
        const pendingMsgEl = document.getElementById('auth-pending-msg') as HTMLElement;
        const resendBtn = document.getElementById('auth-resend') as HTMLButtonElement;
        // Lo que se esconde mientras se espera la confirmación (y vuelve con setMode).
        const standardEls = [
            googleBtn,
            overlay.querySelector('.auth-divider') as HTMLElement,
            form,
            overlay.querySelector('[data-auth-forgot]') as HTMLElement,
            overlay.querySelector('.auth-toggle') as HTMLElement,
        ];
        let pendingEmail = '';
        let resendTimer: number | undefined;

        // ---- Invitaciones (F2 social) ----
        // Quién invita sale de la cookie `yf_ref` que dejó el perfil público visitado. Se pregunta
        // al cargar (si hay cookie y no hay sesión) para tenerlo listo antes de abrir el modal.
        const invEl = document.getElementById('auth-inv') as HTMLElement;
        const gateEl = document.getElementById('auth-gate') as HTMLElement;
        const inviteMode = overlay.dataset.signupMode === 'invite';
        type Inviter = { name: string; firstName: string; handle: string; avatar: string | null; initials: string; color: string };
        let inviter: Inviter | null = null;
        const hasSessionCookie = document.cookie.split('; ').some((c) => c.startsWith('has_session='));
        const refHandle = document.cookie.split('; ').find((c) => c.startsWith('yf_ref='))?.slice(7) ?? '';
        if (refHandle && !hasSessionCookie) {
            fetch(`/api/social/invite?h=${encodeURIComponent(decodeURIComponent(refHandle))}`, { headers: { Accept: 'application/json' } })
                .then((r) => (r.ok ? r.json() : null))
                .then((d) => { if (d?.inviter) { inviter = d.inviter; paintInviter(); } })
                .catch(() => {});
        }
        const inviteOnly = () => inviteMode && !inviter;

        function paintInviter() {
            if (!inviter) return;
            (document.getElementById('auth-inv-name') as HTMLElement).textContent = inviter.name;
            (document.getElementById('auth-inv-handle') as HTMLElement).textContent = inviter.handle;
            (document.getElementById('auth-inv-s') as HTMLElement).textContent =
                `Al crear la cuenta seguirás a ${inviter.firstName}.` + (SOCIAL_PHASE.friends ? ' Si queréis ser amigos, se lo pides tú.' : '');
            const av = document.getElementById('auth-inv-av') as HTMLElement;
            av.style.setProperty('--sb', `var(--stamp-${inviter.color})`);
            av.style.setProperty('--si', `var(--stamp-${inviter.color}-ink)`);
            const img = document.getElementById('auth-inv-img') as HTMLImageElement;
            const ini = document.getElementById('auth-inv-ini') as HTMLElement;
            if (inviter.avatar) { img.src = inviter.avatar; img.hidden = false; ini.hidden = true; }
            else { ini.textContent = inviter.initials; }
            paintInviteExtras();
        }

        // Bloques de invitación según la vista: «Te invita…» en registro; la explicación del modo
        // invitación en lugar de «¿No tienes cuenta? Regístrate».
        function paintInviteExtras() {
            const pending = !pendingEl.hidden;
            invEl.hidden = !(mode === 'register' && inviter && !pending);
            const gate = inviteOnly();
            gateEl.hidden = !(gate && mode === 'login' && !pending);
            (overlay!.querySelector('[data-mode="login"]') as HTMLElement).hidden = mode !== 'login' || gate;
        }

        let mode: 'login' | 'register' = 'login';
        let lastFocus: HTMLElement | null = null;
        let actions: typeof AuthActions | null = null;

        // Carga las acciones de auth bajo demanda (una sola vez).
        async function getActions(): Promise<typeof AuthActions> {
            if (!actions) actions = await import('../utils/authActions');
            return actions;
        }

        function showMsg(text: string, ok = false) {
            msgEl.textContent = text;
            msgEl.classList.toggle('is-ok', ok);
            msgEl.hidden = false;
        }
        function clearMsg() { msgEl.hidden = true; msgEl.textContent = ''; }

        function setLoading(on: boolean) {
            submitBtn.disabled = on;
            googleBtn.disabled = on;
            submitBtn.textContent = on ? 'Un momento…' : (mode === 'login' ? 'Entrar' : 'Crear cuenta');
        }

        function setMode(next: 'login' | 'register') {
            // Modo invitación sin invitación: no hay registro, se queda en «Entrar» con la explicación.
            if (next === 'register' && inviteOnly()) next = 'login';
            mode = next;
            clearMsg();
            pendingEl.hidden = true;
            standardEls.forEach((el) => { if (el) el.hidden = false; });
            const isLogin = next === 'login';
            titleEl.textContent = isLogin ? 'Entra en YourFavs' : 'Crea tu cuenta';
            subEl.textContent = isLogin
                ? 'Guarda tus pelis y series, sigue actores y más.'
                : 'Es gratis y guardas tus listas en un minuto.';
            submitBtn.textContent = isLogin ? 'Entrar' : 'Crear cuenta';
            passInput.setAttribute('autocomplete', isLogin ? 'current-password' : 'new-password');
            (overlay!.querySelector('[data-mode="login"]') as HTMLElement).hidden = !isLogin;
            (overlay!.querySelector('[data-mode="register"]') as HTMLElement).hidden = isLogin;
            (overlay!.querySelector('[data-auth-forgot]') as HTMLElement).hidden = !isLogin;
            paintInviteExtras();
        }

        // «Revisa tu correo». `note` sustituye al subtítulo (p. ej. al intentar entrar sin confirmar).
        function showPending(email: string, note?: string) {
            pendingEmail = email;
            standardEls.forEach((el) => { if (el) el.hidden = true; });
            pendingEl.hidden = false;
            paintInviteExtras();
            pendingEmailEl.textContent = email;
            pendingMsgEl.hidden = true;
            titleEl.textContent = 'Revisa tu correo';
            subEl.textContent = note || 'Un paso más y tu cuenta está lista.';
            setLoading(false);
            resendBtn.focus();
        }

        // Cuenta atrás tras reenviar: evita pulsar diez veces y chocar con el límite de envíos.
        function cooldownResend(seconds: number) {
            window.clearInterval(resendTimer);
            let left = seconds;
            resendBtn.disabled = true;
            resendBtn.textContent = `Reenviar el enlace (${left})`;
            resendTimer = window.setInterval(() => {
                left -= 1;
                if (left <= 0) {
                    window.clearInterval(resendTimer);
                    resendBtn.disabled = false;
                    resendBtn.textContent = 'Reenviar el enlace';
                } else {
                    resendBtn.textContent = `Reenviar el enlace (${left})`;
                }
            }, 1000);
        }

        function open(gating = false) {
            if (overlay!.classList.contains('is-open')) return;
            lastFocus = document.activeElement as HTMLElement;
            overlay!.hidden = false;
            overlay!.classList.add('is-open');
            document.body.style.overflow = 'hidden';
            setMode('login');
            if (gating) {
                // Abierto desde una acción de guardar de un invitado (gating).
                titleEl.textContent = 'Inicia sesión para guardar';
                subEl.textContent = 'Entra o crea tu cuenta y guardamos esto en tus listas al instante.';
            }
            clearMsg();
            emailInput.focus();
        }
        function close() {
            overlay!.classList.remove('is-open');
            overlay!.hidden = true;
            document.body.style.overflow = '';
            form.reset();
            // Si cierra sin loguearse, descarta la intención pendiente (no la
            // queremos disparar en un login posterior no relacionado).
            try { sessionStorage.removeItem('yf_pending_action'); } catch { /* noop */ }
            if (lastFocus && lastFocus.focus) lastFocus.focus();
        }

        // Tras login: si había una acción de guardar pendiente (gating), la
        // completamos reenviando el form; si no, recarga normal.
        function completeOrReload() {
            let pending: string | null = null;
            try { pending = sessionStorage.getItem('yf_pending_action'); } catch { /* noop */ }
            if (pending) {
                try { sessionStorage.removeItem('yf_pending_action'); } catch { /* noop */ }
                try {
                    const { action, fields } = JSON.parse(pending) as { action: string; fields: Record<string, string> };
                    const f = document.createElement('form');
                    f.method = 'POST';
                    f.action = action;
                    for (const [k, v] of Object.entries(fields)) {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = k;
                        input.value = v;
                        f.appendChild(input);
                    }
                    document.body.appendChild(f);
                    f.submit();
                    return;
                } catch { /* cae a reload */ }
            }
            location.reload();
        }

        // Tras autenticarse: el replay del gating SIEMPRE manda (si había una
        // acción pendiente, se completa). Si no la hay y es una cuenta NUEVA,
        // arranca el onboarding de gustos (Fase F · Acceso A). Resto → reload.
        function afterAuth(res: { isNewUser?: boolean }) {
            let pending: string | null = null;
            try { pending = sessionStorage.getItem('yf_pending_action'); } catch { /* noop */ }
            if (res.isNewUser && !pending) { location.href = '/gustos?welcome=1'; return; }
            completeOrReload();
        }

        // ---- disparadores globales ----
        document.addEventListener('click', (e) => {
            const t = e.target as HTMLElement;
            const opener = t.closest('[data-auth-open]');
            if (opener) {
                e.preventDefault();
                open();
                // `data-auth-open="register"` abre directamente en «Crear cuenta» (perfil público). Con
                // invitación, también cualquier otro disparador salvo «login» explícito (handoff D14).
                const want = opener.getAttribute('data-auth-open');
                if (want === 'register' || (inviter && want !== 'login')) setMode('register');
            }
            else if (t.closest('[data-auth-logout]')) {
                e.preventDefault();
                getActions().then((a) => a.logout()).then(() => location.reload());
            }
        });

        // ---- GATING: invitado que intenta guardar (cualquier form POST) ----
        // En esta app todos los POST son acciones de guardar → si no hay sesión,
        // interceptamos, guardamos la intención y abrimos el modal. Tras login se
        // reenvía el form (completeOrReload). Capture para adelantarnos a otros handlers.
        document.addEventListener('submit', (e) => {
            const formEl = e.target;
            if (!(formEl instanceof HTMLFormElement)) return;
            if ((formEl.method || '').toLowerCase() !== 'post') return;
            if (formEl.closest('#auth-modal')) return; // el form del propio modal, no
            const loggedIn = document.cookie.split('; ').some((c) => c.startsWith('has_session='));
            if (loggedIn) return; // con sesión → submit normal (y deja correr el optimista)
            e.preventDefault();
            // Captura + stopImmediatePropagation: corta también el listener optimista
            // del propio form (optimistic-actions.js), que si no haría su fetch POST.
            e.stopImmediatePropagation();
            const fields: Record<string, string> = {};
            new FormData(formEl).forEach((v, k) => { if (typeof v === 'string') fields[k] = v; });
            try {
                sessionStorage.setItem('yf_pending_action', JSON.stringify({ action: formEl.action, fields }));
            } catch { /* noop */ }
            open(true);
        }, true);

        // Acciones que no son form (fetch) piden login disparando este evento (p.ej. 401).
        document.addEventListener('yf:require-auth', () => open(true));

        // ---- cierre ----
        overlay.addEventListener('mousedown', (e) => { if (e.target === overlay) close(); });
        overlay.querySelector('[data-auth-close]')!.addEventListener('click', close);

        // ---- focus-trap + Esc ----
        overlay.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') { e.preventDefault(); close(); return; }
            if (e.key !== 'Tab') return;
            const focusables = card.querySelectorAll<HTMLElement>(
                'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
            );
            const list = Array.from(focusables).filter((el) => !el.hasAttribute('disabled') && el.offsetParent !== null);
            if (!list.length) return;
            const first = list[0], last = list[list.length - 1];
            if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
            else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        });

        // ---- toggle login/registro ----
        overlay.querySelectorAll('[data-auth-switch]').forEach((btn) => {
            btn.addEventListener('click', () => setMode(btn.getAttribute('data-auth-switch') as 'login' | 'register'));
        });

        // ---- ver/ocultar contraseña ----
        const passToggle = document.getElementById('auth-pass-toggle') as HTMLButtonElement;
        passToggle.addEventListener('click', () => {
            const show = passInput.type === 'password';
            passInput.type = show ? 'text' : 'password';
            passToggle.setAttribute('aria-pressed', String(show));
            passToggle.setAttribute('aria-label', show ? 'Ocultar contraseña' : 'Mostrar contraseña');
            passInput.focus();
        });

        // ---- Google ----
        googleBtn.addEventListener('click', async () => {
            clearMsg();
            setLoading(true);
            const a = await getActions();
            const res = await a.loginGoogle();
            if (res.ok) afterAuth(res);
            else { showMsg(res.error); setLoading(false); }
        });

        // ---- email/contraseña (login o registro) ----
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            clearMsg();
            const email = emailInput.value.trim();
            const password = passInput.value;
            if (!email || !password) { showMsg('Rellena email y contraseña.'); return; }
            if (mode === 'register' && password.length < 6) { showMsg('La contraseña debe tener al menos 6 caracteres.'); return; }

            setLoading(true);
            const a = await getActions();
            const res = mode === 'login' ? await a.loginEmail(email, password) : await a.registerEmail(email, password);
            if (res.ok && res.pendingConfirmation) { showPending(email); return; }
            if (res.ok) { afterAuth(res); return; }
            if (res.code === 'invite_only') { setMode('login'); setLoading(false); showMsg(res.error); return; }
            if (res.code === 'email_not_confirmed') {
                showPending(email, 'Aún no has confirmado tu email. Usa el enlace que te enviamos o pide otro.');
                return;
            }
            showMsg(res.error);
            setLoading(false);
        });

        // ---- confirmación pendiente: reenviar / volver ----
        resendBtn.addEventListener('click', async () => {
            if (!pendingEmail) return;
            resendBtn.disabled = true;
            const a = await getActions();
            const res = await a.resendConfirmation(pendingEmail);
            pendingMsgEl.textContent = res.ok ? 'Enlace reenviado. Mira tu bandeja de entrada.' : res.error;
            pendingMsgEl.classList.toggle('is-ok', res.ok);
            pendingMsgEl.hidden = false;
            cooldownResend(res.ok ? 30 : 60);
        });
        overlay.querySelector('[data-auth-pending-back]')!.addEventListener('click', () => {
            setMode('login');
            emailInput.value = pendingEmail;
            passInput.focus();
        });

        // ---- reset de contraseña ----
        overlay.querySelector('[data-auth-forgot]')!.addEventListener('click', async () => {
            const email = emailInput.value.trim();
            if (!email) { showMsg('Escribe tu email arriba y vuelve a pulsar.'); emailInput.focus(); return; }
            const a = await getActions();
            const res = await a.resetPassword(email);
            if (res.ok) showMsg('Te enviamos un email para restablecer la contraseña.', true);
            else showMsg(res.error);
        });

        // ---- vuelta de Google: /auth/callback redirige aquí con ?auth=ok|new|error ----
        // (La "sesión continua" ya no necesita nada en cliente: el middleware refresca la
        // sesión de Supabase en cada request.)
        const authReturn = new URLSearchParams(location.search).get('auth');
        if (authReturn) {
            const clean = new URL(location.href);
            clean.searchParams.delete('auth');
            history.replaceState(history.state, '', clean.pathname + clean.search + clean.hash);
            if (authReturn === 'error') {
                open();
                showMsg('No se pudo entrar con Google. Inténtalo de nuevo.');
            } else if (authReturn === 'invite') {
                // Cuenta nueva de Google sin invitación en modo invitación: el servidor no la creó.
                open();
                showMsg('Ahora mismo, las cuentas nuevas son solo por invitación. Si ya tienes cuenta, entra con normalidad.');
            } else if (authReturn === 'link') {
                // Enlace del email caducado o ya usado. Si era de confirmar, al intentar entrar
                // el login responde «sin confirmar» y el modal ofrece reenviarlo.
                open();
                showMsg('Ese enlace ha caducado o ya se usó. Entra con tu email y contraseña; si aún no habías confirmado, te ofreceremos otro.');
            } else {
                // La página ya llega con sesión: solo falta lo que el popup hacía después.
                let pending: string | null = null;
                try { pending = sessionStorage.getItem('yf_pending_action'); } catch { /* noop */ }
                if (pending) completeOrReload();
                else if (authReturn === 'new') location.href = '/gustos?welcome=1';
            }
        }
    }
</script>
