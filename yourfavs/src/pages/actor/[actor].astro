---
import Layout from "../../layouts/Layout.astro";
import {
    getMoviesAndSeriesByActorId,
    getActorDetailsById, fetchActorImages, fetchTaggedImages,
    getActorCrewCredits
} from "../../services/API/Actors/InfoActor";
import type { CrewCredit } from "../../services/API/Actors/InfoActor";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import { getGenreName, genresMap } from "../../utils/constants/genres";
import { sortBycriterion } from "../../utils/sorting";
import { calculateAge, getCareerRange } from "../../utils/constants/helpers/actor-helpers";
import { posterUrl } from "../../services/API/shared/tmdbClient";
import EmptyState from "../../components/EmptyState.astro";
import ActorDubbingSection from "../../components/detail/ActorDubbingSection.astro";
import '../../styles/shared/detail-common.css';
import '../../styles/pages/actor/actor.css';
import { handleActorFavAction, getActorsFav } from "../../services/BD/actors/yourfavsActor";
import type { ActorsFavs } from "../../services/BD/actors/yourfavsActor";
import { getFollowedPerson, handlePersonFollowAction } from "../../services/BD/people/yourfavsPeople";
import { invalidateUpcomingPeopleCache } from "../../services/API/People/upcomingReleases";
import FollowPersonButton from "../../components/personal/FollowPersonButton.astro";
import { SOCIAL_PHASE } from "../../utils/constants/social";
import type { ActorImage, TaggedImage } from "../../services/API/Actors/InfoActor";
import { safeFetch } from "../../utils/safeFetch";
import { getLibrarySnapshot } from "../../services/BD/shared/librarySnapshot";

const { actor } = Astro.params;

if (!actor) {
    throw new Error("ID del actor no encontrado en la URL");
}

// POST: gestionar favoritos o seguimiento de la persona
if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        if (String(formData.get('actionType')) === 'follow_person') {
            await handlePersonFollowAction(formData);
            invalidateUpcomingPeopleCache(); // el calendario debe reflejarlo ya
            return Astro.redirect(`/actor/${actor}`);
        }
        const url = await handleActorFavAction(formData);
        return Astro.redirect(url);
    } catch (error) {
        console.error('Error al gestionar el actor:', error);
        return Astro.redirect(`/actor/${actor}`);
    }
}

// Fetch datos en paralelo: detalles + créditos (1 llamada) + crew + imágenes + tagged + favorito
const [actorDetails, credits, crewCredits, profileImages, taggedImages, actorsFavs, followedPerson] = await Promise.all([
    safeFetch(getActorDetailsById({ id: actor }), `actor/${actor}/details`, null as any),
    safeFetch(getMoviesAndSeriesByActorId({ id: actor }), `actor/${actor}/credits`, { movies: [], series: [] } as any),
    safeFetch(getActorCrewCredits({ id: actor }), `actor/${actor}/crew`, [] as CrewCredit[]),
    safeFetch(fetchActorImages(actor), `actor/${actor}/images`, [] as ActorImage[]),
    safeFetch(fetchTaggedImages(actor), `actor/${actor}/tagged`, [] as TaggedImage[]),
    safeFetch(getActorsFav(), `actor/favs`, [] as ActorsFavs[]),
    safeFetch(getFollowedPerson(actor), `actor/${actor}/followed`, null),
]);
const isFollowingPerson = !!followedPerson;

// Próximos estrenos de ESTA persona: derivados de los créditos ya cargados
// (cast movies/series + crew), sin fetch extra. Dedup por título.
const todayStr = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/Madrid' });
const upcomingSeen = new Set<string>();
const personUpcoming = [
    ...(credits.movies || []).map((c: any) => ({ id: String(c.id), media_type: 'movie' as const, title: c.title, poster_path: c.poster_path || null, date: c.release_date || '', kind: 'Película' })),
    ...(credits.series || []).map((c: any) => ({ id: String(c.id), media_type: 'tv' as const, title: c.name, poster_path: c.poster_path || null, date: c.first_air_date || '', kind: 'Serie' })),
    ...crewCredits.map((c) => ({ id: String(c.id), media_type: c.media_type, title: c.title, poster_path: c.poster_path, date: c.year ? `${c.year}-01-01` : '', kind: c.media_type === 'movie' ? 'Película' : 'Serie' })),
]
    .filter((c) => c.title && c.date && c.date > todayStr)
    .filter((c) => {
        const key = `${c.media_type}_${c.id}`;
        if (upcomingSeen.has(key)) return false;
        upcomingSeen.add(key);
        return true;
    })
    .sort((a, b) => a.date.localeCompare(b.date))
    .slice(0, 6);

// Agrupar crew por job (Director, Producer, etc.)
const JOB_ORDER = ['Director', 'Creator', 'Writer', 'Screenplay', 'Executive Producer', 'Producer'];
const JOB_LABELS: Record<string, string> = {
    Director: 'Director', Creator: 'Creador', Writer: 'Guionista',
    Screenplay: 'Guion', 'Executive Producer': 'Productor ejecutivo', Producer: 'Productor',
};
const crewByJob = new Map<string, CrewCredit[]>();
for (const c of crewCredits) {
    if (!crewByJob.has(c.job)) crewByJob.set(c.job, []);
    crewByJob.get(c.job)!.push(c);
}
const crewSections = JOB_ORDER
    .filter(job => crewByJob.has(job) && crewByJob.get(job)!.length > 0)
    .map(job => ({ job, label: JOB_LABELS[job] || job, credits: crewByJob.get(job)! }));

const actorInfo = actorDetails || {
    id: null, nombre: actor, biografia: null, lugarNacimiento: null,
    fechaNacimiento: null, fechaFallecimiento: null, imagen: null,
    popularidad: null, conocidoPor: "Actuación", genero: null,
    alias: [], homepage: null,
    redes: { imdb: null, wikidata: null, wikipedia: null, twitter: null, instagram: null, facebook: null, tiktok: null, youtube: null },
};

const { movies, series } = credits;
const totalProductions = movies.length + series.length;
const age = calculateAge(actorInfo.fechaNacimiento);
const posters: ActorImage[] = profileImages.slice(0, 25);

// Top géneros
const genreCounts: Record<number, number> = movies.flatMap(m => m.genre_ids || [])
    .reduce((acc: Record<number, number>, gId: number) => { acc[gId] = (acc[gId] || 0) + 1; return acc; }, {});
const topGenres = Object.entries(genreCounts)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5)
    .map(([gId]) => genresMap[parseInt(gId)]);

// Favoritos
const favEntry = actorsFavs.find((a) => a.id === actor);
const isInFavorites = !!favEntry;
const currentPosition = favEntry?.position ?? null;
const totalActorsFavorites = actorsFavs.length;

// Ordenación
const sortBy = Astro.url.searchParams.get('sort') || 'popularity';
const moviesSorted = sortBycriterion(movies, sortBy, 'release_date');
const seriesSorted = sortBycriterion(series, sortBy, 'first_air_date');

const hasSocial = actorInfo.redes && Object.values(actorInfo.redes).some(v => v);

// Stats calculadas de la filmografía
const allProductions = [...movies, ...series];
const ratedProductions = allProductions.filter((p: any) => p.vote_average > 0);
const avgRating = ratedProductions.length > 0
    ? ratedProductions.reduce((sum: number, p: any) => sum + p.vote_average, 0) / ratedProductions.length
    : null;

const bestMovie = movies.length > 0
    ? movies.reduce((best: any, m: any) => (m.vote_average > best.vote_average ? m : best))
    : null;

// Rango de años en activo (ver getCareerRange): antes era un Math.min/Math.max crudo sobre
// TODOS los créditos, y salía "1952 - 2028 · 76 años" en una actriz de 41 — se leía como su
// edad. El saneado vive en el helper porque la basura de TMDB es sutil (apariciones como sí
// mismo, metraje de archivo, y el año de la SERIE en vez del episodio).
const career = getCareerRange([...movies, ...series], actorInfo.fechaNacimiento, actorInfo.fechaFallecimiento);

// Tu historia con esta persona (§6 detalles con alma): cruza su filmografía (ya cargada)
// con tu biblioteca vista (snapshot cacheado, cero coste TMDB). "Vista" = Vistas ∪
// Favoritos ∪ Me gusta, igual que en el resto de la app.
let seenWithActor: { id: string; media_type: 'movie' | 'tv'; title: string; poster_path: string | null }[] = [];
if (Astro.locals.user) {
    try {
        const snap = await getLibrarySnapshot();
        const watchedMovieIds = new Set<string>([...snap.movVistos, ...snap.movFavs, ...snap.movLike].map((m: any) => String(m.id)));
        const watchedTvIds = new Set<string>([...snap.tvVistos, ...snap.tvFavs, ...snap.tvLike].map((s: any) => String(s.id)));
        for (const m of movies) if (watchedMovieIds.has(String(m.id))) seenWithActor.push({ id: String(m.id), media_type: 'movie', title: m.title, poster_path: m.poster_path || null });
        for (const s of series) if (watchedTvIds.has(String(s.id))) seenWithActor.push({ id: String(s.id), media_type: 'tv', title: s.name, poster_path: s.poster_path || null });
    } catch { /* sin biblioteca → sin caja */ }
}
const seenWithActorCount = seenWithActor.length;
const actorFirstName = String(actorInfo.nombre || '').split(' ')[0];

// JSON-LD structured data (schema.org Person)
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": actorInfo.nombre,
    "jobTitle": actorInfo.conocidoPor || "Actor",
    ...(actorInfo.imagen && { image: actorInfo.imagen }),
    ...(actorInfo.fechaNacimiento && { birthDate: actorInfo.fechaNacimiento }),
    ...(actorInfo.fechaFallecimiento && { deathDate: actorInfo.fechaFallecimiento }),
    ...(actorInfo.lugarNacimiento && { birthPlace: actorInfo.lugarNacimiento }),
    ...(actorInfo.biografia && { description: String(actorInfo.biografia).slice(0, 500) }),
};
---
<Layout
    title={`${actorInfo.nombre}`}
    description={actorInfo.biografia ? String(actorInfo.biografia).slice(0, 200) : undefined}
    ogImage={actorInfo.imagen || undefined}
    ogType="profile"
>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <section class="px-1 sm:py-8">
        <!-- Header -->
        <header class="mb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-1">{actorInfo.nombre}</h1>
            <p class="text-gray-500 text-base">
                {actorInfo.conocidoPor || 'Actor/Actriz'} · {totalProductions} producciones
            </p>
        </header>

        <!-- Info card -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 mb-6">
            <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5">
                {actorInfo.imagen ? (
                    <img
                        src={posterUrl(actorInfo.imagen, 'w185')}
                        alt={actorInfo.nombre}
                        class="w-28 h-28 rounded-full object-cover border-2 border-gray-200 flex-shrink-0"
                        loading="lazy"
                    />
                ) : (
                    <div class="w-28 h-28 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0 border-2 border-gray-200">
                        <svg class="w-12 h-12 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                )}
                <div class="flex-1 text-center sm:text-left">
                    <!-- Pills de info -->
                    <div class="flex flex-wrap justify-center sm:justify-start gap-1.5 text-xs sm:text-sm mb-3">
                        {age && (
                            <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded-full">
                                {actorInfo.fechaFallecimiento ? `Falleció a los ${age} años` : `${age} años`}
                            </span>
                        )}
                        {actorInfo.lugarNacimiento && (
                            <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded-full">{actorInfo.lugarNacimiento}</span>
                        )}
                        {actorInfo.fechaNacimiento && (
                            <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded-full">
                                {new Date(actorInfo.fechaNacimiento).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
                            </span>
                        )}
                        {actorInfo.fechaFallecimiento && (
                            <span class="px-2 py-0.5 bg-gray-800 text-white rounded-full">
                                † {new Date(actorInfo.fechaFallecimiento).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
                            </span>
                        )}
                        <span class="px-2 py-0.5 bg-red-50 text-red-600 rounded-full">{movies.length} películas</span>
                        <span class="px-2 py-0.5 bg-blue-50 text-blue-600 rounded-full">{series.length} series</span>
                        {actorInfo.popularidad && (
                            <span class="px-2 py-0.5 bg-yellow-50 text-yellow-700 rounded-full">Pop. {actorInfo.popularidad.toFixed(0)}</span>
                        )}
                        {avgRating && (
                            <span class="px-2 py-0.5 bg-orange-50 text-orange-700 rounded-full">Nota media {avgRating.toFixed(1)}</span>
                        )}
                        {career && (
                            <span class="px-2 py-0.5 bg-green-50 text-green-700 rounded-full" title="Rango de años de su filmografía según TMDB">
                                {career.start === career.end ? `En activo en ${career.start}` : `En activo ${career.start} – ${career.end}`}
                            </span>
                        )}
                    </div>

                    <!-- Mejor película -->
                    {bestMovie && (
                        <div class="flex items-center gap-2 mb-3">
                            <span class="text-xs sm:text-sm text-gray-400">Mejor valorada:</span>
                            <a href={`/movie/${bestMovie.id}`} class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-gray-700 bg-gray-50 border border-gray-200 rounded-lg px-2 py-1 hover:bg-gray-100 transition-colors">
                                {bestMovie.poster_path && (
                                    <img src={posterUrl(bestMovie.poster_path, 'w92')} alt="" class="w-5 h-7 rounded object-cover" />
                                )}
                                <span class="truncate max-w-[200px]">{bestMovie.title}</span>
                                <span class="text-yellow-600 font-semibold">{bestMovie.vote_average.toFixed(1)}</span>
                            </a>
                        </div>
                    )}

                    <!-- Top géneros -->
                    {topGenres.length > 0 && (
                        <div class="flex flex-wrap justify-center sm:justify-start gap-1 text-xs sm:text-sm mb-3">
                            {topGenres.map(genre => (
                                <span class="px-2 py-0.5 bg-purple-50 text-purple-600 rounded-full">{genre}</span>
                            ))}
                        </div>
                    )}

                    <!-- Redes sociales -->
                    {hasSocial && (
                        <div class="flex flex-wrap justify-center sm:justify-start gap-2 mb-3">
                            {actorInfo.redes.imdb && (
                                <a href={actorInfo.redes.imdb} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-yellow-50 text-yellow-800 rounded-lg hover:bg-yellow-100 transition-colors">IMDb</a>
                            )}
                            {actorInfo.redes.wikipedia && (
                                <a href={actorInfo.redes.wikipedia} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-gray-100 text-gray-800 rounded-lg hover:bg-gray-200 transition-colors">Wikipedia</a>
                            )}
                            {actorInfo.redes.wikidata && (
                                <a href={actorInfo.redes.wikidata} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-indigo-50 text-indigo-700 rounded-lg hover:bg-indigo-100 transition-colors">Wikidata</a>
                            )}
                            {actorInfo.redes.instagram && (
                                <a href={actorInfo.redes.instagram} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-pink-50 text-pink-700 rounded-lg hover:bg-pink-100 transition-colors">Instagram</a>
                            )}
                            {actorInfo.redes.twitter && (
                                <a href={actorInfo.redes.twitter} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-sky-50 text-sky-700 rounded-lg hover:bg-sky-100 transition-colors">Twitter</a>
                            )}
                            {actorInfo.redes.facebook && (
                                <a href={actorInfo.redes.facebook} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100 transition-colors">Facebook</a>
                            )}
                            {actorInfo.redes.tiktok && (
                                <a href={actorInfo.redes.tiktok} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors">TikTok</a>
                            )}
                            {actorInfo.redes.youtube && (
                                <a href={actorInfo.redes.youtube} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-red-50 text-red-700 rounded-lg hover:bg-red-100 transition-colors">YouTube</a>
                            )}
                            {actorInfo.homepage && (
                                <a href={actorInfo.homepage} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-green-50 text-green-700 rounded-lg hover:bg-green-100 transition-colors">Web</a>
                            )}
                        </div>
                    )}

                    <!-- Alias -->
                    {actorInfo.alias && actorInfo.alias.length > 0 && (
                        <details class="text-xs mb-3">
                            <summary class="cursor-pointer text-gray-400 hover:text-gray-600">
                                También conocido como ({actorInfo.alias.length})
                            </summary>
                            <div class="flex flex-wrap gap-1 mt-1.5">
                                {actorInfo.alias.map((a: string) => (
                                    <span class="px-2 py-0.5 bg-gray-50 text-gray-500 rounded-full">{a}</span>
                                ))}
                            </div>
                        </details>
                    )}

                    <!-- Biografía -->
                    {actorInfo.biografia && (
                        <details class="text-sm">
                            <summary class="cursor-pointer text-gray-500 hover:text-gray-700 font-medium">
                                Biografía
                            </summary>
                            <p class="mt-2 text-gray-600 leading-relaxed whitespace-pre-line">{actorInfo.biografia}</p>
                        </details>
                    )}
                </div>
            </div>
        </div>

        <!-- Favoritos -->
        <div class="bg-white rounded-xl border border-gray-200 p-4 mb-6">
            {!isInFavorites ? (
                <form method="POST" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
                    <input type="hidden" name="actor_id" value={actor} />
                    <input type="hidden" name="action" value="add" />
                    <input
                        type="number"
                        name="custom_position"
                        min="1"
                        placeholder={`Posición (1-${totalActorsFavorites + 1})`}
                        class="px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-gray-400"
                    />
                    <button type="submit"
                        class="px-4 py-2 text-sm font-medium text-white bg-gray-900 rounded-lg hover:bg-gray-800 transition-colors">
                        Añadir a favoritos
                    </button>
                </form>
            ) : (
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
                    <span class="text-sm font-medium text-gray-600">Favorito #{currentPosition}</span>
                    <form method="POST" class="flex items-center gap-2 flex-1 sm:flex-none">
                        <input type="hidden" name="actor_id" value={actor} />
                        <input type="hidden" name="action" value="update" />
                        <input
                            type="number"
                            name="custom_position"
                            min="1"
                            max={totalActorsFavorites}
                            value={currentPosition}
                            required
                            class="w-20 px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-gray-400"
                        />
                        <button type="submit"
                            class="px-4 py-2 text-sm font-medium text-white bg-gray-900 rounded-lg hover:bg-gray-800 transition-colors">
                            Mover
                        </button>
                    </form>
                    <form method="POST" class="sm:ml-auto">
                        <input type="hidden" name="actor_id" value={actor} />
                        <input type="hidden" name="action" value="remove" />
                        <button type="submit"
                            class="w-full sm:w-auto px-3 py-2 text-sm font-medium text-red-600 bg-red-50 border border-red-200 rounded-lg hover:bg-red-100 transition-colors">
                            Quitar de favoritos
                        </button>
                    </form>
                </div>
            )}
        </div>

        <!-- Avisos de estrenos: seguir a la persona (handoff v2 §③) -->
        <div class="bg-white rounded-xl border border-gray-200 p-4 mb-6">
            <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-gray-800">Avisos de estrenos</p>
                    <p class="text-xs text-gray-500">
                        {isFollowingPerson
                            ? 'Sus próximos estrenos aparecen en tu calendario.'
                            : `Activa los avisos y los estrenos de ${actorInfo.nombre} aparecerán en tu calendario.`}
                    </p>
                </div>
                <div class="flex flex-wrap gap-2">
                    <FollowPersonButton personId={actor} name={actorInfo.nombre} profilePath={actorInfo.imagen} isFollowing={isFollowingPerson} />
                    {/* F4 social: recomendar esta persona a un amigo (misma talla que el botón de avisos). */}
                    {SOCIAL_PHASE.recommend && Astro.locals.user && (
                        <button type="button" class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold transition-colors bg-white text-gray-700 border border-gray-300 hover:border-gray-400"
                                data-recommend data-target-type="person" data-target-id={actor} data-title={actorInfo.nombre} data-image={actorInfo.imagen} aria-haspopup="dialog" aria-expanded="false">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                            Recomendar
                        </button>
                    )}
                </div>
            </div>

            {isFollowingPerson && personUpcoming.length > 0 && (
                <div class="mt-4 pt-3 border-t border-gray-100">
                    <p class="font-mono text-[10px] tracking-[.12em] text-gray-400 font-semibold mb-1">TE AVISAREMOS DE · PRÓXIMOS ESTRENOS</p>
                    {personUpcoming.map((u, i) => (
                        <a href={u.media_type === 'movie' ? `/movie/${u.id}` : `/serie/${u.id}`}
                           class={`flex items-center gap-3 py-2.5 px-1 rounded-lg hover:bg-gray-50 transition ${i < personUpcoming.length - 1 ? 'border-b border-gray-100' : ''}`}>
                            {u.poster_path ? (
                                <img src={posterUrl(u.poster_path) || ''} alt="" loading="lazy" class="w-[34px] h-[48px] object-cover rounded flex-shrink-0 bg-gray-200"/>
                            ) : (
                                <div class="w-[34px] h-[48px] rounded flex-shrink-0 bg-gray-200"></div>
                            )}
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-semibold text-gray-800 truncate">{u.title}</p>
                                <p class="font-mono text-[11px] text-gray-500">{u.kind}</p>
                            </div>
                            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 whitespace-nowrap flex-shrink-0">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
                                {new Date(u.date + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
                            </span>
                        </a>
                    ))}
                    <p class="mt-2 text-xs text-gray-500 flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                        Se añaden a tu calendario automáticamente.
                    </p>
                </div>
            )}

            {isFollowingPerson && personUpcoming.length === 0 && (
                <p class="mt-3 text-xs text-gray-500">Ahora mismo no tiene estrenos anunciados — aparecerán aquí y en el calendario cuando los haya.</p>
            )}
        </div>

        <!-- Galería -->
        {posters.length > 0 && (
            <details class="bg-white rounded-xl border border-gray-200 mb-6">
                <summary class="p-4 cursor-pointer text-sm font-semibold text-gray-700 hover:text-gray-900 flex items-center justify-between">
                    <span>Galería ({posters.length} imágenes)</span>
                    <svg class="w-5 h-5 text-gray-400 transition-transform [details[open]>&]:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                    </svg>
                </summary>
                <div class="px-4 pb-4 grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-2">
                    {posters.map((poster, index) => (
                        <a href={`#img-${index}`} class="block rounded-lg overflow-hidden hover:opacity-80 transition-opacity">
                            <img src={poster.file_path} alt={`${actorInfo.nombre} - Imagen ${index + 1}`} loading="lazy" class="w-full aspect-[2/3] object-cover" />
                        </a>
                    ))}
                </div>
            </details>
        )}

        <!-- Lightbox modales (CSS :target) -->
        {posters.map((poster, index) => (
            <div id={`img-${index}`} class="lightbox fixed inset-0 items-center justify-center bg-black/80 p-4" style="z-index: 9999;">
                <a href="#_" class="absolute inset-0" aria-label="Cerrar"></a>
                <img src={poster.file_path} alt={`${actorInfo.nombre} - Imagen ${index + 1}`}
                     class="relative max-h-[90vh] max-w-[90vw] object-contain rounded-lg shadow-2xl" />
                <a href="#_" class="absolute top-4 right-4 text-white/80 hover:text-white text-3xl font-light leading-none z-10" aria-label="Cerrar">&times;</a>
                {index > 0 && (
                    <a href={`#img-${index - 1}`} class="absolute left-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10" aria-label="Anterior">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    </a>
                )}
                {index < posters.length - 1 && (
                    <a href={`#img-${index + 1}`} class="absolute right-14 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10" aria-label="Siguiente">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </a>
                )}
            </div>
        ))}

        <!-- Tagged images (fotos en películas/eventos) -->
        {taggedImages.length > 0 && (
            <details class="bg-white rounded-xl border border-gray-200 mb-6">
                <summary class="p-4 cursor-pointer text-sm font-semibold text-gray-700 hover:text-gray-900 flex items-center justify-between">
                    <span>En películas y eventos ({taggedImages.length})</span>
                    <svg class="w-5 h-5 text-gray-400 transition-transform [details[open]>&]:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                    </svg>
                </summary>
                <div class="px-4 pb-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">
                    {taggedImages.map((img, index) => (
                        <a href={`#tagged-${index}`} class="block rounded-lg overflow-hidden hover:opacity-80 transition-opacity relative group">
                            <img src={img.file_path} alt={img.media?.title || img.media?.name || `Imagen ${index + 1}`} loading="lazy" class="w-full aspect-video object-cover" />
                            {img.media && (img.media.title || img.media.name) && (
                                <span class="absolute bottom-0 left-0 right-0 px-2 py-1 text-[10px] text-white bg-black/60 truncate">
                                    {img.media.title || img.media.name}
                                </span>
                            )}
                        </a>
                    ))}
                </div>
            </details>
        )}

        <!-- Lightbox tagged images -->
        {taggedImages.map((img, index) => (
            <div id={`tagged-${index}`} class="lightbox fixed inset-0 items-center justify-center bg-black/80 p-4" style="z-index: 9999;">
                <a href="#_" class="absolute inset-0" aria-label="Cerrar"></a>
                <img src={img.file_path} alt={img.media?.title || img.media?.name || ''}
                     class="relative max-h-[90vh] max-w-[90vw] object-contain rounded-lg shadow-2xl" />
                <a href="#_" class="absolute top-4 right-4 text-white/80 hover:text-white text-3xl font-light leading-none z-10" aria-label="Cerrar">&times;</a>
                {index > 0 && (
                    <a href={`#tagged-${index - 1}`} class="absolute left-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10" aria-label="Anterior">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    </a>
                )}
                {index < taggedImages.length - 1 && (
                    <a href={`#tagged-${index + 1}`} class="absolute right-14 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10" aria-label="Siguiente">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </a>
                )}
            </div>
        ))}

        <!-- Tu historia con esta persona (§6 detalles con alma) -->
        {seenWithActorCount > 0 && (
            <div class="mb-6 rounded-xl border border-gray-200 bg-gray-50 p-4 sm:p-5">
                <div class="flex items-center gap-2 mb-2">
                    <svg class="w-4 h-4 text-[#E63946] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                    <h2 class="text-sm sm:text-base font-semibold text-gray-800">Tu historia con {actorFirstName}</h2>
                </div>
                <p class="text-sm text-gray-600 mb-3">
                    Has visto <strong class="text-gray-900">{seenWithActorCount}</strong> {seenWithActorCount === 1 ? 'título' : 'títulos'} con {actorFirstName}.
                </p>
                <div class="flex gap-2 overflow-x-auto pb-1">
                    {seenWithActor.slice(0, 12).map((t) => (
                        <a href={t.media_type === 'movie' ? `/movie/${t.id}` : `/serie/${t.id}`} class="flex-shrink-0" title={t.title}>
                            {t.poster_path ? (
                                <img src={posterUrl(t.poster_path, 'w92')} alt={t.title} class="w-12 h-[72px] rounded-md object-cover border border-gray-200" loading="lazy"/>
                            ) : (
                                <span class="w-12 h-[72px] rounded-md bg-gray-100 border border-gray-200 flex items-center justify-center text-gray-300 text-[9px]">Sin póster</span>
                            )}
                        </a>
                    ))}
                </div>
            </div>
        )}

        <!-- Navegación rápida -->
        <div class="flex flex-wrap gap-2 mb-4">
            {movies.length > 0 && (
                <a href="#peliculas" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-red-600 bg-red-50 border border-red-200 rounded-lg hover:bg-red-100 transition-colors">
                    <span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span>
                    Películas ({movies.length})
                </a>
            )}
            {series.length > 0 && (
                <a href="#series" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-blue-600 bg-blue-50 border border-blue-200 rounded-lg hover:bg-blue-100 transition-colors">
                    <span class="w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
                    Series ({series.length})
                </a>
            )}
        </div>

        <!-- Ordenación -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
            <h2 class="text-lg font-semibold text-gray-800">Filmografía ({totalProductions})</h2>
            <div class="inline-flex gap-1 bg-gray-100 rounded-xl p-1">
                <a href="?sort=quality"
                   class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all ${sortBy === 'quality' ? 'bg-gray-900 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900 hover:bg-white'}`}>
                    Mejor Valoradas
                </a>
                <a href="?sort=popularity"
                   class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all ${sortBy === 'popularity' ? 'bg-gray-900 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900 hover:bg-white'}`}>
                    Más Populares
                </a>
                <a href="?sort=date"
                   class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all ${sortBy === 'date' ? 'bg-gray-900 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900 hover:bg-white'}`}>
                    Más Recientes
                </a>
            </div>
        </div>

        <div class="space-y-10">
            <!-- Películas -->
            <section id="peliculas" class="scroll-mt-20">
                <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-red-500 rounded-full"></span>
                    Películas
                    <span class="text-sm font-normal text-gray-400">({movies.length})</span>
                </h3>

                {movies.length === 0 && (
                    <EmptyState size="sm" title="No se encontraron películas" />
                )}
                {movies.length > 0 && (
                    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                        {moviesSorted.map((item) => (
                            <CardMovie
                                id={item.id.toString()}
                                img={item.poster_path ? posterUrl(item.poster_path) : "/placeholder.jpg"}
                                title={item.title}
                                vote_average={item.vote_average}
                                overview={item.overview}
                                release_date={item.release_date}
                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                character={item.character}
                            />
                        ))}
                    </div>
                )}
            </section>

            <!-- Series -->
            <section id="series" class="scroll-mt-20">
                <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-blue-500 rounded-full"></span>
                    Series
                    <span class="text-sm font-normal text-gray-400">({series.length})</span>
                </h3>

                {series.length === 0 && (
                    <EmptyState size="sm" title="No se encontraron series" />
                )}
                {series.length > 0 && (
                    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                        {seriesSorted.map((item) => (
                            <CardSerie
                                id={item.id.toString()}
                                img={item.poster_path ? posterUrl(item.poster_path) : "/placeholder.jpg"}
                                name={item.name}
                                vote_average={item.vote_average}
                                overview={item.overview}
                                first_air_date={item.first_air_date}
                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                character={item.character}
                            />
                        ))}
                    </div>
                )}
            </section>

            <!-- C18: Créditos de crew (Director, Productor, Guionista...) -->
            {crewSections.length > 0 && (
                <details class="group bg-purple-50/40 rounded-xl border border-purple-200">
                    <summary class="flex items-center justify-between gap-3 p-4 cursor-pointer">
                        <h3 class="text-lg font-semibold text-gray-800 flex items-center gap-2">
                            <span class="w-1 h-6 bg-purple-500 rounded-full"></span>
                            También como director, productor o guionista
                            <span class="text-sm font-normal text-gray-400">({crewCredits.length})</span>
                        </h3>
                        <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </summary>
                    <div class="px-4 pb-4 space-y-5">
                        {crewSections.map(({ job, label, credits: items }) => (
                            <div>
                                <h4 class="text-sm font-semibold text-purple-700 mb-2 flex items-center gap-1.5">
                                    <span class="w-1 h-4 bg-purple-500 rounded-full"></span>
                                    {label}
                                    <span class="text-xs font-normal text-gray-400">({items.length})</span>
                                </h4>
                                <div class="flex gap-2.5 overflow-x-auto pb-2 snap-x">
                                    {items.map((c) => (
                                        <a href={c.media_type === 'movie' ? `/movie/${c.id}` : `/serie/${c.id}`} class="snap-start flex-shrink-0 w-24 group/prod">
                                            <div class="relative rounded-lg overflow-hidden shadow-sm group-hover/prod:shadow-md transition-shadow">
                                                {c.poster_path ? (
                                                    <img src={posterUrl(c.poster_path, 'w185') || ''} alt={c.title} class="w-full h-36 object-cover" loading="lazy"/>
                                                ) : (
                                                    <div class="w-full h-36 bg-gray-200 flex items-center justify-center text-gray-400 text-3xl">{c.media_type === 'movie' ? '🎬' : '📺'}</div>
                                                )}
                                                {c.vote_average > 0 && (
                                                    <span class="absolute top-1 right-1 text-[10px] font-bold px-1.5 py-0.5 bg-black/60 text-yellow-400 rounded">⭐ {c.vote_average.toFixed(1)}</span>
                                                )}
                                                <span class={`absolute top-1 left-1 text-[10px] font-bold px-1.5 py-0.5 rounded ${c.media_type === 'movie' ? 'bg-red-500' : 'bg-blue-500'} text-white`}>{c.media_type === 'movie' ? 'Peli' : 'Serie'}</span>
                                            </div>
                                            <p class="mt-1 text-xs text-gray-700 line-clamp-2 leading-tight font-medium">{c.title}</p>
                                            {c.year && <p class="text-[10px] text-gray-400">{c.year}</p>}
                                        </a>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </details>
            )}

            <!-- Doblajes (lazy, eldoblaje.com — solo si el actor es doblador) -->
            <ActorDubbingSection tmdbId={actor} name={actorInfo.nombre} />
        </div>
    </section>
</Layout>
