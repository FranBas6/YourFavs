---
import Layout from "../../layouts/Layout.astro"
import CardMovie from "../../components/cards/CardMovie.astro";
import CardSerie from "../../components/cards/CardSerie.astro";
import {getSeriesVerPronto, getWatchedProgressBatch} from "../../services/series/serieLibrary";
import {getMoviesVerPronto} from "../../services/movies/movieLibrary";
import {handleVerProntoAction} from "../../services/library/handleVerProntoAction";
import {fetchMovieDetails} from "../../services/movies/movieCatalog";
import {fetchSerieDetails} from "../../services/series/serieCatalog";
import {getGenreName} from "../../utils/titles/genres";
import {processBatch} from "../../utils/core/processBatch";
import {posterUrl} from "../../services/tmdb/tmdbClient";
import ListsNav from "../../components/library/ListsNav.astro";
import ListTitle from "../../components/library/ListTitle.astro";
import EmptyState from "../../components/ui/EmptyState.astro";
import type {Serie} from "../../types/ApiSerie";
import type {Movie} from "../../types/ApiMovie";
import type {SeriesInterface} from "../../types/DbSerie";
import PlansBlock from "../../components/social/PlansBlock.astro";
import OrderList from "../../components/library/OrderList.astro";
import {myPlans, type MyPlan} from "../../services/social/plans";
import {appDateParts} from "../../utils/core/appTime";
import {SOCIAL_PHASE} from "../../utils/social/social";
import '../../styles/pages/personal/personal.css';
import '../../styles/shared/plans.css';

let clearedType = null;
let errorMessage = "";

if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();
        clearedType = await handleVerProntoAction(formData);
    } catch (error) {
        console.error("Error al procesar acciones:", error);
        errorMessage = error instanceof Error ? error.message : "Error desconocido al procesar la acción";
    }
}

let seriesVerPronto: Serie[] = [];
let peliculasVerPronto: Movie[] = [];
let seriesData: SeriesInterface[] = [];
let moviesData: { id: string }[] = [];

try {
    [seriesData, moviesData] = await Promise.all([
        getSeriesVerPronto(),
        getMoviesVerPronto()
    ]);

    const [seriesResults, moviesResults] = await Promise.all([
        processBatch(seriesData.map((s: SeriesInterface) => s.id), (id: string) => fetchSerieDetails(id), 10),
        processBatch(moviesData.map((p: { id: string }) => p.id), (id: string) => fetchMovieDetails(id), 10)
    ]);

    seriesVerPronto = (seriesResults as (Serie | null)[]).filter((s): s is Serie => s !== null);
    peliculasVerPronto = (moviesResults as (Movie | null)[]).filter((m): m is Movie => m !== null);
} catch (error) {
    console.error("Error al cargar contenido para ver pronto:", error);
    errorMessage = error instanceof Error ? error.message : "Error desconocido al cargar datos";
}

const filter = Astro.url.searchParams.get("filter") || "todos";
const showSeries = filter === "series" || filter === "todos";
const showMovies = filter === "peliculas" || filter === "todos";

// Planes para verla (Mensajes M5b): tus «Voy» desde hace 3 días, leídos de los planes. Un título con
// plan sale solo en «Planes», no en la rejilla. Si fallan, la página sigue sin el bloque.
const todayKey = appDateParts(Date.now()).key;
let plans: MyPlan[] = [];
let hasConvs = false;
const uid = Astro.locals.user?.uid;
if (uid && SOCIAL_PHASE.messages) {
    try {
        const [y, m, d] = todayKey.split('-').map(Number);
        const r = await myPlans(uid, new Date(Date.UTC(y, m - 1, d - 3)).toISOString().slice(0, 10));
        plans = r.plans.filter((p) => p.mediaType === 'tv' ? showSeries : showMovies);
        hasConvs = r.convs;
    } catch (error) {
        console.error("Error al cargar los planes:", error);
    }
}
const planned = new Set(plans.map((p) => `${p.mediaType}:${p.tmdbId}`));
seriesVerPronto = seriesVerPronto.filter((s) => !planned.has(`tv:${s.id}`));
peliculasVerPronto = peliculasVerPronto.filter((m) => !planned.has(`movie:${m.id}`));

const watchedMap = await getWatchedProgressBatch(seriesVerPronto.map((s: any) => String(s.id)));

const showAll = filter === "todos";
const clearedMessage = clearedType || Astro.url.searchParams.get("cleared");
const hasSeries = seriesVerPronto.length > 0;
const hasMovies = peliculasVerPronto.length > 0;
const hasContent = hasSeries || hasMovies;

// Ordenar a mano (2026-11-18): los títulos de cada sección, en el orden en que se pintan.
const yearOf = (d?: string | null) => (d ? String(d).slice(0, 4) : '');
const seriesOrder = seriesVerPronto.map((s) => ({ id: String(s.id), title: s.name, year: yearOf(s.first_air_date), poster: posterUrl(s.poster_path, 'w92') || '/placeholder.jpg' }));
const moviesOrder = peliculasVerPronto.map((m) => ({ id: String(m.id), title: m.title, year: yearOf(m.release_date), poster: posterUrl(m.poster_path, 'w92') || '/placeholder.jpg' }));
---
<Layout title="Lo próximo">
    <ListsNav slot="aside" />
    <section class="px-1 sm:py-8">
        {errorMessage && (
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm mb-6">
                {errorMessage}
            </div>
        )}

        {clearedMessage && (
            <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl text-sm mb-6 flex items-center gap-2">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                {clearedMessage === 'series' ? 'Series borradas' : clearedMessage === 'peliculas' ? 'Películas borradas' : clearedMessage === 'todos' ? 'Todo borrado' : 'Elemento eliminado'}
            </div>
        )}

        <ListTitle title="Lo próximo" subtitle="Lo siguiente que vas a ver, en el orden que tú elijas" />
        {hasContent && (
            <nav class="lh-seg mb-5" aria-label="Tipo de título">
                <a href="?filter=todos" aria-current={showAll ? 'page' : undefined}>Todo</a>
                <a href="?filter=peliculas" aria-current={showMovies && !showAll ? 'page' : undefined}>Películas</a>
                <a href="?filter=series" aria-current={showSeries && !showAll ? 'page' : undefined}>Series</a>
            </nav>
        )}


        <PlansBlock plans={plans} today={todayKey} convs={hasConvs} />

        {/* Botones de borrado masivo */}
        {hasContent && (
            <div class="flex flex-wrap gap-2 mb-6">
                {hasSeries && hasMovies && showAll && (
                    <form method="POST">
                        <button type="submit" name="clear" value="todos"
                            class="btn btn--sm btn--dgr">
                            Borrar todo
                        </button>
                    </form>
                )}
                {hasSeries && (showSeries || showAll) && (
                    <form method="POST">
                        <button type="submit" name="clear" value="series"
                            class="btn btn--sm btn--dgr">
                            Borrar series
                        </button>
                    </form>
                )}
                {hasMovies && (showMovies || showAll) && (
                    <form method="POST">
                        <button type="submit" name="clear" value="peliculas"
                            class="btn btn--sm btn--dgr">
                            Borrar películas
                        </button>
                    </form>
                )}
            </div>
        )}

        {/* QA 8.5 (H36): con «Todo», si no hay series pero sí películas, las películas van primero. */}
        <div class="flex flex-col gap-10">
            {/* Series */}
            {(showSeries || showAll) && (
                <section id="series-section" class="scroll-mt-20 vpo-section" data-vpo-section>
                    <div class="lg-h"><h2>Series</h2><span class="n">{seriesVerPronto.length}</span>
                        {seriesVerPronto.length > 1 && <button type="button" class="btn btn--sm vpo-toggle" data-vpo-toggle aria-expanded="false">Ordenar</button>}
                    </div>

                    {seriesVerPronto.length === 0 && (
                        <EmptyState size="sm" title="No tienes series en Lo próximo">
                            <a slot="cta" href="/catalogo/tendencias" class="btn btn--sm">Explorar tendencias</a>
                        </EmptyState>
                    )}
                    {seriesVerPronto.length > 1 && <OrderList collection="SeriesVerPronto" noun="series" items={seriesOrder} />}
                    {seriesVerPronto.length > 0 && (
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full" data-vpo-grid>
                            {seriesVerPronto.map((item) => (
                                <div class="flex flex-col h-full" data-id={item.id}>
                                    <CardSerie
                                        id={item.id.toString()}
                                        img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                        name={item.name}
                                        vote_average={item.vote_average}
                                        vote_count={item.vote_count}
                                        overview={item.overview}
                                        first_air_date={item.first_air_date}
                                        seasons={item.seasons}
                                        last_episode_to_air={item.last_episode_to_air}
                                        next_episode_to_air={item.next_episode_to_air}
                                        genres={item.genre_ids?.map((gId: number) => ({ id: gId, name: getGenreName(gId) }))}
                                        status={item.status}
                                        watchedEpisodes={watchedMap[String(item.id)]?.watched}
                                    />
                                    <form method="POST" class="mt-1.5">
                                        <input type="hidden" name="deleteId" value={item.id}/>
                                        <input type="hidden" name="deleteType" value="serie"/>
                                        <button type="submit"
                                            class="w-full py-1.5 text-xs font-medium text-red-500 hover:text-white hover:bg-red-500 border border-red-200 rounded-lg transition-all"
                                            aria-label="Eliminar serie">
                                            Eliminar
                                        </button>
                                    </form>
                                </div>
                            ))}
                        </div>
                    )}
                </section>
            )}

            {/* Películas */}
            {(showMovies || showAll) && (
                <section id="movies-section" class:list={["scroll-mt-20 vpo-section", { "order-first": showAll && seriesVerPronto.length === 0 && peliculasVerPronto.length > 0 }]} data-vpo-section>
                    <div class="lg-h"><h2>Películas</h2><span class="n">{peliculasVerPronto.length}</span>
                        {peliculasVerPronto.length > 1 && <button type="button" class="btn btn--sm vpo-toggle" data-vpo-toggle aria-expanded="false">Ordenar</button>}
                    </div>

                    {peliculasVerPronto.length === 0 && (
                        <EmptyState size="sm" title="No tienes películas en Lo próximo">
                            <a slot="cta" href="/catalogo/tendencias" class="btn btn--sm">Explorar tendencias</a>
                        </EmptyState>
                    )}
                    {peliculasVerPronto.length > 1 && <OrderList collection="MoviesVerPronto" noun="películas" items={moviesOrder} />}
                    {peliculasVerPronto.length > 0 && (
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full" data-vpo-grid>
                            {peliculasVerPronto.map((item) => (
                                <div class="flex flex-col h-full" data-id={item.id}>
                                    <CardMovie
                                        id={item.id.toString()}
                                        img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                        title={item.title}
                                        vote_average={item.vote_average}
                                        vote_count={item.vote_count}
                                        overview={item.overview}
                                        release_date={item.release_date}
                                        genres={item.genre_ids?.map((gId: number) => ({ id: gId, name: getGenreName(gId) }))}
                                    />
                                    <form method="POST" class="mt-1.5">
                                        <input type="hidden" name="deleteId" value={item.id}/>
                                        <input type="hidden" name="deleteType" value="pelicula"/>
                                        <button type="submit"
                                            class="w-full py-1.5 text-xs font-medium text-red-500 hover:text-white hover:bg-red-500 border border-red-200 rounded-lg transition-all"
                                            aria-label="Eliminar película">
                                            Eliminar
                                        </button>
                                    </form>
                                </div>
                            ))}
                        </div>
                    )}
                </section>
            )}
        </div>
    </section>
    <script>
        import '../../scripts/library/verProntoOrder';
    </script>
</Layout>
