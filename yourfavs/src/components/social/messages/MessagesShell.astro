---
/**
 * Panel de mensajes (handoff de mensajes §3): en escritorio, 3 columnas bajo PersonalNav —
 * «Amigos» + la lista de conversaciones | lo de la página (slot `main`) | su columna derecha (slot
 * `info`). En móvil la lista solo se ve en la página de Mensajes (`on="list"`).
 *
 * Con `SOCIAL_PHASE.messages` apagado pinta la rejilla de siempre del centro «Amigos» (`.am-grid`),
 * para que todo quede como en F6.
 *
 * La lista la pinta el servidor con `lib/social/chatView.ts` y la refresca cada 30 s
 * `scripts/social/messages/rail.ts` con el mismo marcado.
 */
import { Icon } from 'astro-icon/components';
import { railListHtml } from '../../../lib/social/chatView';
import { SOCIAL_PHASE } from '../../../utils/constants/social';
import type { ConvSummary } from '../../../lib/social/types';
import '../../../styles/pages/social/mensajes.css';

interface Props {
    on: 'home' | 'list' | 'chat';
    convs: ConvSummary[];
    /** La conversación abierta (resaltada en la lista). */
    active?: number | null;
    /** Sin columna derecha (vacíos y errores). */
    noInfo?: boolean;
    /** Página de Mensajes vacía: en móvil se ve el vacío en vez de la lista. */
    empty?: boolean;
}
const { on, convs, active = null, noInfo = false, empty = false } = Astro.props;
const enabled = SOCIAL_PHASE.messages;
---
{enabled ? (
    <div class:list={['ms-shell', { noinfo: noInfo }]} data-ms-shell data-on={on} data-active={active ?? ''} data-empty={empty ? '' : undefined}>
        <aside class="ms-rail" aria-label="Amigos y mensajes">
            <a class="ms-home" href="/mislistas/amigos" aria-current={on === 'home' ? 'page' : undefined}>
                <Icon name="lucide:users" /><span>Amigos</span>
                <span class="rn js-pending-badge" hidden></span>
            </a>
            <div class="ms-sec"><span id="ms-sec-l">Mensajes</span></div>
            <ul class="ms-l" aria-labelledby="ms-sec-l" data-ms-list set:html={railListHtml(convs, { active })}></ul>
        </aside>
        <slot name="main" />
        <slot name="info" />
    </div>
) : (
    <div class="am-grid">
        <slot name="main" />
        <slot name="info" />
    </div>
)}

{enabled && on === 'chat' && (
    // La columna de información recordada (yf:chat-info) antes de pintar, sin salto.
    <script is:inline>
        try { if (localStorage.getItem('yf:chat-info') === '0') document.querySelector('[data-ms-shell]')?.classList.add('noinfo'); } catch (e) {}
    </script>
)}

{enabled && (
    <script>
        import '../../../scripts/social/messages/rail';
    </script>
)}
