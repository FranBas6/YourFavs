            <div class="flex items-center justify-center w-10 h-10 bg-coral-red/10 rounded-xl shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-coral-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
