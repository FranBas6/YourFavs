                                                                <a
                                                                        href={`/actor/${actor.id}`}
                                                                        class="text-gray-800 font-semibold hover:text-blue-600 hover:underline transition duration-300"
                                                                >
                                                                    {actor.name}
                                                                </a>
                                                                {actor.character && (
                                                                        <span class="text-sm text-gray-500 mt-1">{actor.character}</span>
                                                                )}
                                                            </div>
                                                        </div>
                                                    </li>
                                            ))}
                                        </ul>
                                ) : (
                                        <p class="text-gray-500">Información no disponible</p>
                                )}
                            </div>
                        </div>

                        <!-- Equipo -->
                        <div class="bg-white p-6 rounded-lg shadow-md">
                            <h2 class="text-2xl font-bold text-blue-600 mb-4">Equipo de Producción</h2>
                            <div class="text-gray-600">
                                {directors?.length > 0 ? (
                                <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                                    {directors.map((member) => (
                                    <li class="p-3 rounded-lg border border-gray-100 hover:border-blue-200 hover:shadow-sm transition">
                                        <a
                                        href={`/team/${member.name}`}
                                        class="block text-gray-900 font-semibold hover:text-blue-600 transition"
                                        >
                                        {member.name}
                                        </a>
                                        <p class="text-sm text-gray-500">{member.job}</p>
                                    </li>
                                    ))}
                                </ul>
                                ) : (
                                <p class="text-gray-500">Información no disponible</p>
                                )}
                            </div>
                        </div>
                    </div>

