---
import { jobEs } from '../../utils/titles/teamHelpers';

interface CrewMember {
    name: string;
    job: string;
}

interface Props {
    crew: CrewMember[];
    title?: string;
}

const { crew: rawCrew, title = "Equipo" } = Astro.props;
// QA 8.7 (H28): puestos en español (`jobEs`) y por importancia: antes salían en inglés y en el orden de TMDB,
// con la producción ejecutiva delante de la dirección. Los que no están en la lista, al final y en su orden.
const ROLE_ORDER = ['Director', 'Creator', 'Screenplay', 'Writer', 'Teleplay', 'Story', 'Novel', 'Original Music Composer',
    'Director of Photography', 'Editor', 'Visual Effects', 'Producer', 'Executive Producer'];
const rank = (job: string) => { const i = ROLE_ORDER.indexOf(job); return i < 0 ? ROLE_ORDER.length : i; };
const crew = rawCrew
    .map((m, i) => ({ ...m, i }))
    .sort((a, b) => rank(a.job) - rank(b.job) || a.i - b.i)
    .map(({ i: _i, ...m }) => ({ ...m, job: jobEs(m.job) }));
// Rediseño 4.5: 9 a la vista (tres filas); el resto se muestra con «Ver todo el equipo».
const SHOWN = crew.length <= 12 ? crew.length : 9; // plegar 1–3 no compensa
---
{crew.length > 0 && (
    <section>
        <div class="fsec-h"><h2>{title}</h2><span class="n">{crew.length}</span></div>
        <div class="fcrew">
            {crew.map((member, i) => (
                <a href={`/team/${encodeURIComponent(member.name)}`} class:list={[{ 'cg-x': i >= SHOWN }]}>
                    <b>{member.name}</b>
                    <span>{member.job}</span>
                </a>
            ))}
        </div>
        {crew.length - SHOWN > 0 && (
            <details class="cg-more group mt-3">
                <summary class="cg-more-btn">
                    <span class="group-open:hidden">Ver todo el equipo · {crew.length}</span>
                    <span class="hidden group-open:inline">Ver menos</span>
                    <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
            </details>
        )}
    </section>
)}
