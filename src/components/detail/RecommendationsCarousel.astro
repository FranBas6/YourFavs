---
/**
 * Recomendaciones / parecidas de las fichas. Piel v2 (rediseño 4.8): la fila horizontal y la tarjeta
 * del sistema (Row + TitleCard, como la portada) con cabecera sobria y flechas; la sinopsis que antes
 * salía al pasar el ratón está ahora en la vista rápida (▶ del póster).
 */
import Row from '../Row.astro';
import TitleCard from '../Cards/TitleCard.astro';

interface Item {
    id: number | string;
    title?: string;
    name?: string;
    poster_path?: string | null;
    overview?: string;
    vote_average?: number;
    release_date?: string;
    first_air_date?: string;
}

interface Props {
    items: Item[];
    mediaType: 'movie' | 'tv';
    title: string;
    limit?: number;
}

const { items, mediaType, title, limit = 20 } = Astro.props;
const shown = items.slice(0, limit);
const railId = `rail-parecidas-${mediaType}`;
---
{shown.length > 0 && (
    <section>
        <div class="fsec-h">
            <h2>{title}</h2><span class="n">{shown.length}</span>
            <span class="fsec-arr">
                <button type="button" class="btn btn--sm btn--icon btn--ghost" data-rail-prev={railId} aria-label="Anteriores" disabled>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <button type="button" class="btn btn--sm btn--icon btn--ghost" data-rail-next={railId} aria-label="Siguientes">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            </span>
        </div>
        <Row id={railId} label={title}>
            {shown.map((item) => (
                <TitleCard
                    mediaType={mediaType}
                    id={String(item.id)}
                    title={item.title || item.name || ''}
                    img={item.poster_path || '/placeholder.jpg'}
                    vote_average={item.vote_average}
                    overview={item.overview}
                    date={item.release_date || item.first_air_date}
                    context="catalog"
                />
            ))}
        </Row>
    </section>
)}
