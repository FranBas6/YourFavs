                    <span class="bg-blue-600 px-3 py-1 rounded-full text-sm font-medium">
                        {status ? ((statusMap as any)[status] || status) : ''}
                    </span>
                    <!-- Chip de rating circular con tooltip -->
                    {item?.vote_average && (
                        <div class="relative flex items-center justify-center group" tabindex="0">
                            <svg class="w-10 h-10 -rotate-90" viewBox="0 0 36 36" aria-hidden="true">
                                <path class="text-gray-700" stroke="currentColor" stroke-width="3" fill="none" d="M18 2 a 16 16 0 1 1 0 32 a 16 16 0 1 1 0 -32"/>
                                <path class="text-yellow-400" stroke="currentColor" stroke-width="3" fill="none"
                                      stroke-linecap="round"
                                      stroke-dasharray={`${Math.min(100, Math.round((item.vote_average || 0) * 10))}, 100`}
                                      d="M18 2 a 16 16 0 1 1 0 32 a 16 16 0 1 1 0 -32"/>
                            </svg>
                            <span class="absolute text-sm font-semibold">{item.vote_average.toFixed(1)}</span>
                            <!-- Tooltip votos -->
                            {item.vote_count && (
                                <span class="absolute left-12 top-1/2 -translate-y-1/2 bg-gray-900 text-white text-xs rounded px-2 py-1 shadow-lg opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-200 z-10">
                                    {item.vote_count} votos
                                </span>
                            )}
