---
import Header from "../components/Header.astro";
import {ViewTransitions} from "astro:transitions";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";

interface Props {
    title: string;
    description?: string;
}

const {title, description = "Tu plataforma favorita para descubrir películas y series"} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" view-transition>
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="generator" content={Astro.generator}/>
    <meta name="description" content={description}/>
    <meta name="theme-color" content="#3B82F6"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:type" content="website"/>
    <title>{title}</title>
</head>
<body id="top" class="bg-light-gray min-h-screen pb-16 sm:pb-24 md:pb-32 font-poppins">
<Header/>
<main class="max-w-7xl w-full px-3 sm:px-6 lg:px-8 mx-auto pt-4 sm:pt-6 md:pt-8 lg:pt-10">
    <slot/>
    <!-- Botón flotante para volver arriba -->
    <div class="back-to-top-container">
        <a href="#top" title="Subir al inicio" aria-label="Subir al inicio" class="back-to-top">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
            </svg>
        </a>
    </div>
</main>
<footer class="bg-transparent max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 mt-12 text-center text-xs sm:text-sm text-gray-600 py-6">
    <p class="mb-2">&copy; {new Date().getFullYear()} YourFavs. Todos los derechos reservados.</p>
    <div class="flex justify-center gap-4 text-gray-500 text-sm">
        <a href="/about" class="inline-flex items-center gap-2 hover:text-blue-600 transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path>
                <path d="M12 9h.01"></path>
                <path d="M11 12h1v4h1"></path>
            </svg>
            Acerca de
        </a>
    </div>
</footer>
</body>
</html>

<style is:global>
    :root {
        /* Colores existentes */
        --color-primary: #3B82F6;
        --color-secondary: #2563EB;
        --color-background: #F3F4F6;
        --color-text: #1F2937;
        --color-text-light: #6B7280;

        /* Colores adicionales para las tarjetas */
        --color-midnight-blue: #006ea7;
        --color-dark-blue: #112d7d;
        --color-coral-plat: #ffffff;
        --color-coral-white: #d5d5d2;
        --color-pastel-yellow: #FACC15;

        --coral-red: #ff6b7a;
        --coral-red-light: #ff8f9c;
        --coral-red-dark: #e8495a;
        --coral-red-alpha: rgba(255, 107, 122, 0.15);
    }

    .bg-light-gray {
        background-color: #F3F4F6;
    }

    html {
        font-family: 'Poppins', sans-serif;
        scroll-behavior: smooth;
        color-scheme: light;
        font-size: 16px;
    }

    @media (max-width: 640px) {
        html {
            font-size: 14px;
        }
    }

    @media (max-width: 768px) {
        main {
            padding-bottom: 6rem;
        }
    }

    body {
        color: var(--color-text);
        margin: 0;
        padding: 0;
        transition: background-color 0.3s ease;
        width: 100%;
        overflow-x: hidden;
    }

    img {
        max-width: 100%;
        height: auto;
        display: block;
    }

    /* Mejoras para accesibilidad en elementos de enfoque */
    :focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
    }

    /* Mejoras para el scrollbar */
    ::-webkit-scrollbar {
        width: 8px;
    }

    @media (max-width: 640px) {
        ::-webkit-scrollbar {
            width: 4px;
        }
    }

    ::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    ::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 5px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: #a1a1a1;
    }

    /* Animaciones para transiciones de página */
    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    main {
        animation: fadeInUp 0.5s ease-in-out;
    }

    @keyframes pulseSoft {
        0% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.4); }
        70% { box-shadow: 0 0 0 12px rgba(59, 130, 246, 0); }
        100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }
    }

    .back-to-top {
        animation: pulseSoft 2.5s infinite;
    }


    main {
        animation: fadeIn 0.5s ease-in-out;
    }

    .container {
        width: 100%;
        margin-right: auto;
        margin-left: auto;
    }

    /* Grid responsivo básico */
    .grid {
        display: grid;
        gap: 1rem;
    }

    .grid-cols-1 {
        grid-template-columns: repeat(1, minmax(0, 1fr));
    }

    .grid-cols-2 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (min-width: 640px) {
        .sm\:grid-cols-2 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .sm\:grid-cols-3 {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @media (min-width: 768px) {
        .md\:grid-cols-3 {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .md\:grid-cols-4 {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .back-to-top-container {
            bottom: 1rem;
            right: 1rem;
        }

        .back-to-top {
            width: 48px;
            height: 48px;
        }
    }

    @media (min-width: 1024px) {
        .lg\:grid-cols-4 {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .lg\:grid-cols-5 {
            grid-template-columns: repeat(5, minmax(0, 1fr));
        }
    }

    /* Media queries para modo oscuro */
    @media (prefers-color-scheme: dark) {
        :root {
            --color-background: #1F2937;
            --color-text: #F9FAFB;
            --color-text-light: #D1D5DB;
        }

        body {
            background-color: var(--color-background);
            color: var(--color-text);
        }

        ::-webkit-scrollbar-track {
            background: #374151;
        }

        ::-webkit-scrollbar-thumb {
            background: #6B7280;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #9CA3AF;
        }

        .back-to-top {
            background-color: var(--color-primary);
            color: white;
        }

    }

    /* Botón flotante para volver arriba */
    .back-to-top-container {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 50;
    }

    .back-to-top {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        background: var(--coral-red);
        color: white;
        border-radius: 50%;
        box-shadow: var(--shadow-large);
        transition: var(--transition-smooth);
        text-decoration: none;
        opacity: 0.9;
    }

    .back-to-top:hover {
        transform: translateY(-4px) scale(1.1);
        opacity: 1;
        box-shadow: 0 20px 40px -10px rgba(230, 57, 70, 0.4);
    }

    .back-to-top:focus {
        outline: none;
        ring: 3px solid rgba(230, 57, 70, 0.3);
    }

    a, button, input {
        transition: all 0.2s ease-in-out;
    }

    ::view-transition-old(main), ::view-transition-new(main) {
        animation-duration: 0.4s;
    }

</style>