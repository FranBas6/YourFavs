---
import Layout from '../layouts/Layout.astro';
import CardMovie from "../components/Cards/CardMovie.astro";
import CardSerie from "../components/Cards/CardSerie.astro";
import HoverPreview from "../components/HoverPreview.astro";
import type {Movie} from "../types/ApiMovie"
import type {Serie} from "../types/ApiSerie";
import {getLatestMovies, getMostPopularMovies, getTopRatedMovies, getMoviesByCategory} from "../services/API/Movies/tmdbMovies";
import {getLatestSeries, getMostPopularSeries, getTopRatedSeries, getSeriesByCategory} from "../services/API/Series/tmdbSeries";
import {getTrending} from "../services/API/shared/tmdbDiscoverService";
import {getNextEpisodesData} from "../services/API/Series/nextEpisode";
import {getMoviesViendoDetailed} from "../services/API/Movies/viendoMovies";
import NextEpisode from "../components/Sections/NextEpisode.astro";
import RescatarSeries from "../components/Sections/RescatarSeries.astro";
import HookRow from "../components/Sections/HookRow.astro";
import RankingRow from "../components/Sections/RankingRow.astro";
import SocialRow from "../components/Sections/SocialRow.astro";
import { recentActivity, type ActivityItem } from "../services/BD/social/activity";
import { SOCIAL_PHASE } from "../utils/constants/social";
import { readHooksDoc, buildHookRow } from "../services/API/shared/hookRows";
import { getWeeklyRanking } from "../services/API/shared/weeklyRanking";
import { SUPPORTED_COUNTRIES } from "../services/API/shared/tmdbInfoService";
import CatalogRow from "../components/Sections/CatalogRow.astro";
import { getStalledSeries } from "../services/API/Series/stalledSeries";
import { hiddenHomeKeys, HOME_SECTIONS } from "../utils/constants/homeSections";
import RecommendedForYou from "../components/Sections/RecommendedForYou.astro";
import BriefDiario from "../components/Sections/BriefDiario.astro";
import { getForYouRecommendations } from "../services/API/shared/forYouRecommendations";
import { getDailyBrief, type DailyBrief } from "../services/API/shared/dailyBrief";
import WhatToWatch from "../components/personal/WhatToWatch.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { Icon } from 'astro-icon/components';
import {fetchPlatformOfTheDay} from "../utils/constants/platforms";
import {getGenreName} from "../utils/constants/genres";
import {allCategories} from "../utils/constants/categories";
import {posterUrl, backdropUrl} from "../services/API/shared/tmdbClient";
import {safeFetch} from "../utils/safeFetch";
import { fetchCatalogRow } from "../services/API/shared/catalogRows";
import { streamingRowDef } from "../utils/constants/catalogRows";
import '../styles/components/catalog-row.css';
import '../styles/pages/index.css';

const page = Number(Astro.request.url.split('?page=')[1] || 1);
const pageStr = page.toString();

const randomIndex = Math.floor(Math.random() * allCategories.length);
const randomCategorySlug = allCategories[randomIndex].slug;
const randomCategoryName = allCategories[randomIndex].name;

// Cada fetch con su propio catch: si TMDB/Firebase falla en cold start,
// la home renderiza con esa sección vacía en lugar de devolver Web Server Error
const [
    trendingMovies,
    trendingSeries,
    latestMovies,
    latestSeries,
    popularMovies,
    popularSeries,
    topRatedMovies,
    topRatedSeries,
    platformOfDay,
    categoriesMovies,
    categoriesSeries,
    continueWatching,
    viendoMovies,
    forYou,
    stalledSeries,
    hooksDoc,
    streamingRow,
] = await Promise.all([
    safeFetch(getTrending<Movie>('movie', 'week'), 'home/trendingMovies', [] as Movie[]),
    safeFetch(getTrending<Serie>('tv', 'week'), 'home/trendingSeries', [] as Serie[]),
    safeFetch(getLatestMovies({page: pageStr}), 'home/latestMovies', [] as Movie[]),
    safeFetch(getLatestSeries({page: pageStr}), 'home/latestSeries', [] as Serie[]),
    safeFetch(getMostPopularMovies({page: pageStr}), 'home/popularMovies', [] as Movie[]),
    safeFetch(getMostPopularSeries({page: pageStr}), 'home/popularSeries', [] as Serie[]),
    safeFetch(getTopRatedMovies({page: pageStr}), 'home/topRatedMovies', [] as Movie[]),
    safeFetch(getTopRatedSeries({page: pageStr}), 'home/topRatedSeries', [] as Serie[]),
    // Una plataforma por día y solo sus 2 listas (antes: 14 discover por carga para enseñar una al azar).
    safeFetch(fetchPlatformOfTheDay(pageStr, Astro.locals.user?.region || 'ES'), 'home/platforms', null),
    safeFetch(getMoviesByCategory(randomCategorySlug, pageStr), 'home/categoriesMovies', [] as Movie[]),
    safeFetch(getSeriesByCategory(randomCategorySlug, pageStr), 'home/categoriesSeries', [] as Serie[]),
    safeFetch(getNextEpisodesData(), 'home/continueWatching', [] as any[]),
    // Pelis en "Viendo" (Bloque 2) → se fusionan con las series en la franja "Estás viendo".
    safeFetch(getMoviesViendoDetailed(), 'home/viendoMovies', [] as any[]),
    // "Para ti": solo con sesión. Cacheado por uid (L1/L2) y wrapeado en safeFetch:
    // si el cómputo falla/tarda en frío, la home renderiza sin esta sección.
    Astro.locals.user
        ? safeFetch(getForYouRecommendations(12), 'home/forYou', [] as any[])
        : Promise.resolve([] as any[]),
    // "¿Retomamos alguna?" (§1): series a medias e inactivas. Solo con sesión; degrada a [] si falla.
    Astro.locals.user
        ? safeFetch(getStalledSeries(), 'home/stalled', [] as any[])
        : Promise.resolve([] as any[]),
    // "Enganchan desde el primer episodio": UNA lectura del documento global precalculado. También
    // para invitados (son datos públicos de TMDB). El filtrado personal se hace en memoria abajo.
    safeFetch(readHooksDoc(), 'home/hooks', null),
    // «Nuevo en streaming» (D1): la misma fila que en /catalogo, con su caché diaria por región.
    safeFetch(
        fetchCatalogRow({ ...streamingRowDef(Astro.locals.user?.region || 'ES'), media: 'both' }, { filters: {}, providers: '', region: Astro.locals.user?.region || 'ES', cacheable: true }),
        'home/streaming', null,
    ),
]);

// Si TMDB falla la fila sale vacía (y no se pinta) en vez de romper la portada.
const randomPlatform = platformOfDay ?? { name: '', slug: '', logo: '', movies: [], series: [] };

// Brief diario "Hoy en tu cine" (① · solo con sesión). Reutiliza `continueWatching`
// (ya calculado arriba) para no recomputar el "siguiente episodio"; cacheado por
// uid+día. Si no hay señales (usuario nuevo) → cae al hero trending de siempre.
const brief: DailyBrief = Astro.locals.user
    ? await safeFetch(
        getDailyBrief({ platforms: Astro.locals.user.platforms ?? [], nextEpisodes: continueWatching }),
        'home/brief',
        { dateLabel: '', signals: [] } as DailyBrief,
    )
    : { dateLabel: '', signals: [] };

// Película destacada para el hero (la más trending de la semana)
const heroMovie = trendingMovies[0] || null;

// "Enganchan desde el primer episodio": el documento global ya está leído; aquí solo se filtra en
// memoria a las plataformas del perfil y se descarta lo que ya estás viendo (recomendarte empezar algo
// que llevas por la mitad no tiene sentido). Coste: cero llamadas.
// «Lo más popular esta semana»: el bloque nace APAGADO, así que solo se calcula si el usuario lo ha
// encendido — de nada sirve pagar las llamadas de una fila que no se va a pintar. Una vez por semana y por
// combinación de región + plataformas; el resto de cargas es una lectura.
const showRanking = !hiddenHomeKeys(Astro.locals.user?.homeLayout).has('popular-region');
const rankRegion = Astro.locals.user?.region || 'ES';
const rankPlatforms = Astro.locals.user?.platforms ?? [];
const ranking = showRanking
    ? await safeFetch(getWeeklyRanking(rankRegion, rankPlatforms), 'home/ranking', null)
    : null;
const rankRegionLabel = SUPPORTED_COUNTRIES.find((c) => c.code === rankRegion)?.label || rankRegion;

// «Lo que ven tus amigos» (F6 social): también nace apagado, así que solo se consulta si está encendido.
const showSocial = SOCIAL_PHASE.follow && Boolean(Astro.locals.user)
    && !hiddenHomeKeys(Astro.locals.user?.homeLayout).has('social');
const socialItems = showSocial
    ? await safeFetch(recentActivity(Astro.locals.user!.uid), 'home/social', [] as ActivityItem[])
    : [];

const hookRow = buildHookRow(hooksDoc, {
    platforms: Astro.locals.user?.platforms ?? [],
    region: Astro.locals.user?.region || 'ES',
    excludeIds: new Set<number>((continueWatching || []).map((c: any) => Number(c.id)).filter(Boolean)),
});

const randomCategory = {
    slug: randomCategorySlug,
    name: randomCategoryName,
    movies: categoriesMovies,
    series: categoriesSeries,
};

const sections = [
    {
        key: 'tendencias',
        title: "TENDENCIAS DE LA SEMANA",
        movies: trendingMovies,
        series: trendingSeries,
        link: "/catalogo/tendencias",
        priority: 'high',
        color: 'red',
        lucide: 'trending-up'
    },
    {
        key: 'lanzamientos',
        title: "ÚLTIMOS LANZAMIENTOS",
        movies: latestMovies,
        series: latestSeries,
        link: "/catalogo/ultimoslanzamientos",
        priority: 'high',
        color: 'green',
        lucide: 'sparkles'
    },
    {
        key: 'nuevo-streaming',
        title: "NUEVO EN STREAMING",
        subtitle: streamingRow?.def.subtitle,
        why: streamingRow?.def.why,
        movies: streamingRow?.movies ?? [],
        series: streamingRow?.series ?? [],
        link: "/catalogo/fila/nuevo-streaming?type=all",
        priority: 'high',
        color: 'blue',
        lucide: 'tv'
    },
    {
        key: 'populares',
        title: "MÁS POPULARES",
        movies: popularMovies,
        series: popularSeries,
        link: "/catalogo/maspopulares",
        priority: 'high',
        color: 'pink',
        lucide: 'flame'
    },
    {
        key: 'top-pelis',
        title: "TOP PELÍCULAS",
        movies: topRatedMovies,
        series: [],
        link: "/catalogo/topmovies",
        priority: 'medium',
        color: 'amber',
        lucide: 'star'
    },
    {
        key: 'top-series',
        title: "TOP SERIES",
        movies: [],
        series: topRatedSeries,
        link: "/catalogo/topseries",
        priority: 'medium',
        color: 'blue',
        lucide: 'trophy'
    },
    {
        key: 'plataforma',
        title: `PLATAFORMA DESTACADA: ${randomPlatform.name}`,
        movies: randomPlatform.movies as Movie[],
        series: randomPlatform.series as Serie[],
        link: `/catalogo/plataformas?platform=${randomPlatform.slug}&page=1`,
        priority: 'low',
        color: 'slate',
        lucide: 'tv'
    },
    {
        key: 'categoria',
        title: `CATEGORÍA DESTACADA: ${randomCategory.name}`,
        movies: randomCategory.movies as Movie[],
        series: randomCategory.series as Serie[],
        // Sin `type=all`: era un parámetro fijo que reseteaba en silencio el modo elegido en el
        // catálogo. Sin él, la página respeta el que tuvieras.
        link: `/catalogo/categorias?categoria=${randomCategory.slug}&page=1`,
        priority: 'low',
        color: 'purple',
        lucide: 'layers'
    }
];

// §4 home a tu medida: orden + visibilidad de los bloques según el perfil.
const hiddenHome = hiddenHomeKeys(Astro.locals.user?.homeLayout);
const isHidden = (k: string) => hiddenHome.has(k);
const sectionByKey: Record<string, any> = Object.fromEntries(sections.map((s) => [s.key, s]));
const KNOWN_KEYS = HOME_SECTIONS.map((s) => s.key);
const savedOrder = (Astro.locals.user?.homeLayout || []).map((x) => x.key).filter((k) => KNOWN_KEYS.includes(k));
// Orden final: lo guardado primero, luego los bloques que aún no estén en la preferencia; sin ocultos.
const orderedKeys = [...savedOrder, ...KNOWN_KEYS.filter((k) => !savedOrder.includes(k))].filter((k) => !isHidden(k));
---
<Layout title="YourFavs">     
    <main class="main-container">
        <!-- Hero: Brief diario "Hoy en tu cine" (con sesión y señales) + Trending; con
             ambos disponibles, un toggle deja elegir cuál ver (preferencia recordada). -->
        {(brief.signals.length > 0 || heroMovie) ? (
            <div class="home-hero" id="home-hero">
                {brief.signals.length > 0 && heroMovie && (
                    <div class="home-hero-switchrow">
                        <span class="home-hero-switchlabel">Tu portada</span>
                        <div class="home-hero-switch" role="tablist" aria-label="Cambiar portada">
                            <button type="button" class="is-active" data-hero-pick="brief">Hoy en tu cine</button>
                            <button type="button" data-hero-pick="trending">Trending</button>
                        </div>
                    </div>
                )}

                {brief.signals.length > 0 && (
                    <div data-hero="brief">
                        <BriefDiario brief={brief} userName={Astro.locals.user?.name} />
                    </div>
                )}

                {heroMovie && (
                    <div data-hero="trending" hidden={brief.signals.length > 0}>
                        <div class="hero-backdrop" style={`background-image: url(${backdropUrl(heroMovie.backdrop_path, 'w1280')})`}>
                            <div class="hero-backdrop-overlay">
                                <div class="hero-backdrop-content">
                                    <span class="hero-trending-badge"><Icon name="lucide:trending-up" />Trending esta semana</span>
                                    <h1 class="hero-backdrop-title">{heroMovie.title}</h1>
                                    <div class="hero-backdrop-meta">
                                        <span class="hero-backdrop-rating"><Icon name="lucide:star" />{heroMovie.vote_average?.toFixed(1)}</span>
                                        <span class="hero-backdrop-year">{heroMovie.release_date?.split('-')[0]}</span>
                                    </div>
                                    <p class="hero-backdrop-overview">{heroMovie.overview}</p>
                                    <a href={`/movie/${heroMovie.id}`} class="hero-backdrop-cta">
                                        Ver detalles
                                        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                )}
            </div>
        ) : (
            <div class="hero-section">
                <div class="hero-content">
                    <h1 class="hero-title text-coral-red">
                        <span class="hero-icon"><Icon name="lucide:clapperboard" /></span>
                        CATÁLOGO PRINCIPAL
                    </h1>
                    <div class="hero-divider"></div>
                    <p class="hero-description">
                        Descubre miles de películas y series de las mejores plataformas.
                        <strong>Tu entretenimiento favorito</strong> en un solo lugar.
                    </p>
                </div>
            </div>
        )}

        <script is:inline>
            // Toggle de portada (Brief ↔ Trending). Recuerda la elección en localStorage.
            (function () {
                var root = document.getElementById('home-hero');
                if (!root) return;
                var picks = root.querySelectorAll('[data-hero-pick]');
                if (!picks.length) return; // solo hay una portada → sin toggle
                var panels = root.querySelectorAll('[data-hero]');
                function apply(which) {
                    panels.forEach(function (p) { p.hidden = p.getAttribute('data-hero') !== which; });
                    picks.forEach(function (b) { b.classList.toggle('is-active', b.getAttribute('data-hero-pick') === which); });
                    try { localStorage.setItem('yf_home_hero', which); } catch (e) {}
                }
                var saved = null;
                try { saved = localStorage.getItem('yf_home_hero'); } catch (e) {}
                if (saved === 'trending' || saved === 'brief') apply(saved);
                picks.forEach(function (b) {
                    b.addEventListener('click', function () { apply(b.getAttribute('data-hero-pick')); });
                });
            })();
        </script>

        {orderedKeys.includes('engancha') && (
            <script is:inline>
                // Recarga incremental de la fila de pilotos: se dispara DESPUÉS de pintar, en una
                // petición aparte, porque son ~20 llamadas a TMDB y en el SSR retrasarían la portada.
                // El guard de 24 h y el claim viven en el servidor; esto solo evita pedirlo dos veces
                // en la misma sesión.
                (function () {
                    try {
                        if (sessionStorage.getItem('yf_hooks_ping')) return;
                        sessionStorage.setItem('yf_hooks_ping', '1');
                    } catch (e) { /* sin sessionStorage: se pide igual, el servidor lo corta */ }
                    var go = function () {
                        fetch('/api/home/hooks-refresh', { method: 'POST' }).catch(function () {});
                    };
                    if ('requestIdleCallback' in window) requestIdleCallback(go, { timeout: 4000 });
                    else setTimeout(go, 2500);
                })();
            </script>
        )}

        <!-- Bloques configurables de la Home (§4): orden y visibilidad los define el perfil
             (UserProfile.homeLayout). El hero de arriba queda fijo; aquí va todo lo demás
             en el orden elegido, cada bloque envuelto igual en .content-wrapper. -->
        {orderedKeys.map((key) => (
            <Fragment>
                {key === 'estas-viendo' && (continueWatching.length > 0 || viendoMovies.length > 0) && (
                    <div class="content-wrapper">
                        <NextEpisode items={continueWatching} movies={viendoMovies} title="Estás viendo" />
                    </div>
                )}
                {key === 'rescatar' && stalledSeries.length > 0 && (
                    <div class="content-wrapper">
                        <RescatarSeries series={stalledSeries} />
                    </div>
                )}
                {key === 'para-ti' && forYou.length > 0 && (
                    <div class="content-wrapper">
                        <RecommendedForYou items={forYou} />
                    </div>
                )}
                {/* Si el documento global falta, está vacío o el job aún no ha corrido, la fila NO se
                    pinta: ni esqueleto eterno ni "no hay nada". */}
                {key === 'engancha' && hookRow && hookRow.items.length > 0 && (
                    <div class="content-wrapper">
                        <HookRow items={hookRow.items} relaxedPlatforms={hookRow.relaxedPlatforms} updatedAt={hookRow.updatedAt} />
                    </div>
                )}
                {key === 'popular-region' && ranking && ranking.entries.length > 0 && (
                    <div class="content-wrapper">
                        <RankingRow entries={ranking.entries} regionLabel={rankRegionLabel} regionOnly={rankPlatforms.length === 0} />
                    </div>
                )}
                {key === 'social' && showSocial && (
                    <div class="content-wrapper">
                        <SocialRow items={socialItems} />
                    </div>
                )}
                {key === 'que-veo' && (
                    <div class="content-wrapper">
                        <div class="flex justify-end mb-2">
                            <WhatToWatch />
                        </div>
                    </div>
                )}
                {sectionByKey[key] && (sectionByKey[key].movies.length > 0 || sectionByKey[key].series.length > 0) && (
                    <div class="content-wrapper">
                        <CatalogRow section={sectionByKey[key]} />
                    </div>
                )}
            </Fragment>
        ))}
    </main>
</Layout>
