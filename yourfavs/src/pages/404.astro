---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404: Página no encontrada">
    <section class="flex flex-col items-center justify-center text-center py-15 px-4 gap-6">
        <h1 class="text-7xl font-extrabold text-coral-red tracking-tight drop-shadow-lg">404</h1>

        <p class="text-lg sm:text-xl text-gray-700 font-medium max-w-xl">
            ¡Ups! Esta página no existe... pero no te preocupes, sigue descubriendo tus películas y series favoritas.
        </p>

        <div class="w-[320px] sm:w-[400px] rounded-xl overflow-hidden shadow-lg border border-gray-200">
            <img
                    src="https://midu.dev/images/this-is-fine-404.gif"
                    alt="This is fine"
                    loading="lazy"
                    class="w-full h-auto object-contain"
            />
        </div>

        <a
                href="/"
                class="mt-8 inline-block px-6 py-3 rounded-full text-white text-sm sm:text-base font-semibold bg-blue-600 hover:bg-blue-700 transition duration-300 shadow-md"
        >
            Volver al inicio
        </a>
    </section>
</Layout>
