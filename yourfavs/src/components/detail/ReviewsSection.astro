---
import { getCurrentLanguage } from '../../services/BD/shared/userScope';
import { getLanguageDisplayName } from '../../utils/constants/helpers/media-helpers';

interface Review {
    author: string;
    content: string;
    created_at?: string;
    author_details?: { rating?: number };
    /** Idioma ISO-639-1 con el que llegó (lo pone `getReviews`). */
    lang?: string;
}

interface Props {
    reviews: Review[];
    title?: string;
}

const { reviews, title = "Opiniones de la comunidad" } = Astro.props;
// Las reseñas en otro idioma (casi siempre inglés) llevan una etiqueta para que no pillen por sorpresa.
const ownLang = getCurrentLanguage().slice(0, 2);
const langLabel = (lang?: string) => (lang && lang !== ownLang ? `en ${getLanguageDisplayName(lang).toLowerCase()}` : null);
---
{reviews.length > 0 && (
    <details class="bg-white rounded-xl border border-gray-200">
        <summary class="p-5 cursor-pointer text-lg font-semibold text-gray-800 flex items-center justify-between">
            <span>{title} ({reviews.length})</span>
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="px-5 pb-5 space-y-4">
            {reviews.map((review) => (
                <details class="border-b border-gray-100 pb-4 last:border-0 last:pb-0 group">
                    <summary class="cursor-pointer list-none">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="text-sm font-medium text-gray-800">{review.author}</span>
                            {review.author_details?.rating && (
                                <span class="text-xs px-1.5 py-0.5 bg-yellow-50 text-yellow-700 rounded">{review.author_details.rating}/10</span>
                            )}
                            <span class="text-xs text-gray-400">{review.created_at ? new Date(review.created_at).toLocaleDateString('es-ES') : ''}</span>
                            {langLabel(review.lang) && (
                                <span class="text-[11px] px-1.5 py-0.5 rounded border border-gray-200 text-gray-500">{langLabel(review.lang)}</span>
                            )}
                        </div>
                        <p class="text-sm text-gray-600 line-clamp-4 group-open:line-clamp-none leading-relaxed">{review.content}</p>
                        <span class="text-xs text-blue-500 mt-1 inline-block group-open:hidden">Leer más...</span>
                    </summary>
                </details>
            ))}
        </div>
    </details>
)}
