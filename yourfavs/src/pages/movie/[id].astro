---
import Layout from "../../layouts/Layout.astro";
import type { CastMember, Provider, ProductionCompany } from "../../types/Media";
import {
    getLanguageDisplayName, getContentRating,
    formatDate, getRatingStars, formatTrailerUrl, providerLinks
} from "../../utils/constants/helpers/media-helpers";
import {formatCurrency} from "../../utils/constants/helpers/movie-helpers";
import {handleMovieFavAction, getWatchedMovieTiers, type WatchedTier} from "../../services/BD/movies/yourfavsMovie";
import SagaProgress from "../../components/detail/SagaProgress.astro";
import '../../styles/shared/detail-common.css';
import '../../styles/pages/movie/movie.css';
import {
    getMovieById, getMovieCast, getMovieDirectorsAndRoles,
    getMovieTrailer, fetchAllMoviePosters, getMovieCollectionInfo,
    getMovieRecommendationsOrSimilar, getMoviesAdditionalInfo, getMovieVideos
} from "../../services/API/Movies/InfoMovies";
import { getTitleLogo } from "../../services/API/shared/tmdbInfoService";
import { peekTopActors } from "../../utils/topActorsLibrary";
import { posterUrl, backdropUrl, originalUrl, tmdbFetch } from "../../services/API/shared/tmdbClient";
import {initializeApp} from "firebase/app";
import {getFirestore, doc, getDoc} from "firebase/firestore";
import {firebaseConfig} from '../../utils/firebaseConfig';
import { checkMediaExistence } from "../../services/BD/shared/checkExistence";
import { getMediaTags, handleMediaTagsAction } from "../../services/BD/shared/mediaTags";
import { countMoviePasses } from "../../services/BD/lists/watchLog";
import { getNotificationSub, addNotificationSub, removeNotificationSub } from "../../services/BD/notifications/yourfavsNotifications";
import NotificationBell from "../../components/personal/NotificationBell.astro";
import CastGrid from "../../components/detail/CastGrid.astro";
import DubbingSection from "../../components/detail/DubbingSection.astro";
import CrewGrid from "../../components/detail/CrewGrid.astro";
import ProductionCompanies from "../../components/detail/ProductionCompanies.astro";
import ReviewsSection from "../../components/detail/ReviewsSection.astro";
import LightboxGallery from "../../components/detail/LightboxGallery.astro";
import VideoSection from "../../components/detail/VideoSection.astro";
import RecommendationsCarousel from "../../components/detail/RecommendationsCarousel.astro";
import StreamingProviders from "../../components/detail/StreamingProviders.astro";
import StarRating from "../../components/detail/StarRating.astro";
import {safeFetch} from "../../utils/safeFetch";

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

const {id} = Astro.params; // Obtén el parámetro id de la URL

if (!id) {
    throw new Error("ID de la película no encontrado en la URL");
}

if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        const actionType = String(formData.get('actionType') || '');

        if (actionType === 'notification') {
            const action = String(formData.get('action'));
            const tmdbId = String(formData.get('tmdb_id'));
            if (action === 'add') {
                await addNotificationSub('movie', tmdbId);
            } else {
                await removeNotificationSub('movie', tmdbId);
            }
            return Astro.redirect(`/movie/${id}`);
        }

        if (actionType === 'media_tags') {
            const url = await handleMediaTagsAction(formData);
            return Astro.redirect(url);
        }

        const redirectUrl = await handleMovieFavAction(formData);
        return Astro.redirect(redirectUrl);
    } catch (error) {
        console.error('Error al gestionar la película:', error);
        return Astro.redirect(`/movie/${id}`);
    }
}

// Obtener datos de la película
let item = null;
let cast: CastMember[] = []; // Cambio aquí: de string[] a CastMember[]
let directors: { name: string; job: string }[] = [];
let trailerUrl: string | null = null;
let title = "Película no encontrada";

if (id) {
    // Todas las llamadas TMDB en paralelo (antes eran secuenciales)
    [item, cast, directors, trailerUrl] = await Promise.all([
        safeFetch(getMovieById({id}), `movie/${id}/details`, null as any),
        safeFetch(getMovieCast(id), `movie/${id}/cast`, [] as CastMember[]),
        safeFetch(getMovieDirectorsAndRoles(id), `movie/${id}/directors`, [] as { name: string; job: string }[]),
        safeFetch(getMovieTrailer(id), `movie/${id}/trailer`, null),
    ]);
    if (!item) return Astro.redirect('/404');
    title = item?.title || title;
}

// Datos que se enviarán al cliente
const clientData = {
    id: String(item?.id),
    poster_path: item?.poster_path || '',
    title: item?.title || 'Sin nombre',
    vote_average: item?.vote_average ? Number(item.vote_average) : 0,
    overview: item?.overview || 'Sin descripción',
    genres: item?.genres || [], // Asegurar que siempre sea un array
    release_date: item?.release_date || '',
};

// Verificar existencia en las 5 colecciones de películas (lectura paralela)
const EMPTY_MOVIE_EXISTENCE = {
    exists: { MovieFavs: false, MoviesPendientes: false, MoviesVistas: false, MoviesVerPronto: false, LikedMovies: false },
    opinion: '',
    rating: 0,
} as any;
const [{ exists: movieExists, opinion: opinionFromAny, rating: ratingFromAny }, mediaTagsDoc] = await Promise.all([
    safeFetch(checkMediaExistence('movie', clientData.id), `movie/${clientData.id}/existence`, EMPTY_MOVIE_EXISTENCE),
    safeFetch(getMediaTags('movie', clientData.id), `movie/${clientData.id}/tags`, null as any),
]);
const isInFavorites = movieExists.MovieFavs;
const isInPendientes = movieExists.MoviesPendientes;
const isInVistas = movieExists.MoviesVistas;
const isInVerPronto = movieExists.MoviesVerPronto;
const isInLiked = movieExists.LikedMovies;
const userTags: string[] = mediaTagsDoc?.tags || [];

// Diario (L6): "La has visto N veces" = base 1 si consta vista (Vistas/Me gusta/Favs)
// + los "pases" del botón "Vuelto a ver", IGUAL que las series. El visionado original
// se deduce de estar en lista, no necesita entrada en el diario. Solo con sesión.
const moviePasses = Astro.locals.user ? await countMoviePasses(clientData.id) : { passes: 0, last: null };
// "Visto" = en cualquier nivel (Vistas/Me gusta/Favs) o con re-visionados en el diario.
const isWatchedMovie = isInVistas || isInFavorites || isInLiked || moviePasses.passes > 0;
const movieTimes = (isWatchedMovie ? 1 : 0) + moviePasses.passes;
const watchLastPretty = moviePasses.last ? new Date(moviePasses.last + 'T12:00:00').toLocaleDateString('es-ES', { month: 'short', year: 'numeric' }) : '';
const userNotes = mediaTagsDoc?.notes || '';
const inAnyCollection = isInFavorites || isInPendientes || isInVistas || isInVerPronto || isInLiked;

// Verificar suscripción de notificación (solo películas no estrenadas)
const isUnreleased = item?.release_date ? new Date(item.release_date) > new Date() : false;
const notifSub = isUnreleased ? await getNotificationSub('movie', id) : null;
const isNotifSubscribed = !!notifSub;

interface ProviderElement {
    name: string;
    logo: string | null;
    link: string | undefined;
    type: string;
}

const providerElements: ProviderElement[] = item?.providers?.map((provider: Provider) => {
    const link = providerLinks[provider.provider_name];
    const hasLogo = !!provider.logo_path;
    return {
        name: provider.provider_name,
        logo: hasLogo ? posterUrl(provider.logo_path, 'w200') : null,
        link,
        type: provider.type || 'flatrate'
    };
}) || [];

// Agrupar por tipo
const providersByType = providerElements.reduce((acc: Record<string, ProviderElement[]>, p) => {
    const key = p.type || 'flatrate';
    if (!acc[key]) acc[key] = [];
    acc[key].push(p);
    return acc;
}, {} as Record<string, ProviderElement[]>);

import type {PosterImage} from '../../services/API/Movies/InfoMovies';

// Segundo bloque de datos (dependen de item pero no entre sí) — todo en paralelo
const tmdbId = item?.id;

const [
    allPosters,
    collectionInfo,
    moviesRecommendationsData,
    externalIds,
    additionalInfo,
    allVideos,
    reviewsData,
    movieLogo,
] = await Promise.all([
    id ? fetchAllMoviePosters(id).catch(() => []) : Promise.resolve([]),
    item?.belongs_to_collection ? getMovieCollectionInfo(item.belongs_to_collection.id).catch(() => null) : Promise.resolve(null),
    tmdbId ? getMovieRecommendationsOrSimilar(tmdbId) : Promise.resolve({ success: false, recommendations: [], type: 'recommendations' as const }),
    tmdbId ? tmdbFetch<any>(`/movie/${tmdbId}/external_ids`).catch(() => ({})) : Promise.resolve({}),
    tmdbId ? getMoviesAdditionalInfo(tmdbId) : Promise.resolve({ keywords: [], networks: [], content_ratings: [], episode_run_time: [], languages: [], tagline: null, budget: null, revenue: null }),
    id ? getMovieVideos(id) : Promise.resolve([]),
    tmdbId ? tmdbFetch<{ results: any[] }>(`/movie/${tmdbId}/reviews`).catch(() => ({ results: [] })) : Promise.resolve({ results: [] }),
    tmdbId ? getTitleLogo('movie', tmdbId) : Promise.resolve(null),
]);

// Saga con progreso: solo si la película pertenece a colección (evita la
// lectura de Firestore en el resto de fichas). "Vista" = Vistas ∪ Liked ∪ Favs,
// con nivel (✓/♥/★) para indicar en qué lista está cada parte.
let watchedMovieTiers = new Map<number, WatchedTier>();
if (collectionInfo && collectionInfo.parts && collectionInfo.parts.length > 1) {
    watchedMovieTiers = await getWatchedMovieTiers().catch(() => new Map<number, WatchedTier>());
}

const posters: PosterImage[] = allPosters.slice(0, 40);
const moviesRecommendations = moviesRecommendationsData.success ? moviesRecommendationsData.recommendations : [];
const moviesRecommendationType = moviesRecommendationsData.type || 'recommendations';
const imdbId = externalIds.imdb_id;
const movieSocialLinks = {
    facebook: externalIds.facebook_id ? `https://facebook.com/${externalIds.facebook_id}` : null,
    instagram: externalIds.instagram_id ? `https://instagram.com/${externalIds.instagram_id}` : null,
    twitter: externalIds.twitter_id ? `https://twitter.com/${externalIds.twitter_id}` : null,
};
const hasSocialLinks = Object.values(movieSocialLinks).some(v => v);
// Reparto cruzado con tu biblioteca (3.4): solo si la caché de top-actores está
// caliente (no se computa aquí). actor id → nº de títulos tuyos con esa persona.
const _topActors = Astro.locals.user ? peekTopActors() : null;
const seenWithMap = _topActors ? new Map(_topActors.map((a) => [a.id, a.appearances])) : undefined;

const movieKeywords: { id: number; name: string }[] = additionalInfo.keywords || [];
const movieLanguages: { iso_639_1: string; name: string }[] = additionalInfo.languages || [];
const movieStatus = item?.status && item.status !== 'Released' ? item.status : null;

// Reviews de TMDB (top 5 con contenido)
const reviews = (reviewsData.results || [])
    .filter((r: any) => r.content && r.content.length > 50)
    .slice(0, 5);

// Países de producción
const productionCountries = item?.production_countries || [];

// Año en contexto
const releaseYear = item?.release_date ? new Date(item.release_date).getFullYear() : null;
const yearsAgo = releaseYear ? new Date().getFullYear() - releaseYear : null;

// Nota comparativa: percentil respecto a recomendaciones + similares
const allRelated = moviesRecommendations.filter((m: any) => m.vote_average > 0);
const betterThanCount = allRelated.filter((m: any) => item?.vote_average > m.vote_average).length;
const ratingPercentile = allRelated.length >= 5 ? Math.round((betterThanCount / allRelated.length) * 100) : null;
const mainGenre = item?.genres?.[0]?.name || null;

// Categorizar videos
const trailers = allVideos.filter((v: any) => v.type === 'Trailer');
const clips = allVideos.filter((v: any) => v.type === 'Clip');
const behindScenes = allVideos.filter((v: any) => v.type === 'Behind the Scenes' || v.type === 'Bloopers' || v.type === 'Featurette');
const teasers = allVideos.filter((v: any) => v.type === 'Teaser');

// JSON-LD structured data (schema.org Movie)
const jsonLd = item ? {
    "@context": "https://schema.org",
    "@type": "Movie",
    "name": item.title,
    ...(item.poster_path && { image: item.poster_path }),
    ...(item.release_date && { datePublished: item.release_date }),
    ...(item.overview && { description: item.overview }),
    ...(item.genres?.length && { genre: item.genres.map((g: any) => g.name) }),
    ...(directors?.find((d: any) => d.job === 'Director') && {
        director: { "@type": "Person", name: directors.find((d: any) => d.job === 'Director')!.name }
    }),
    ...(item.vote_count > 0 && {
        aggregateRating: {
            "@type": "AggregateRating",
            ratingValue: item.vote_average,
            bestRating: 10,
            ratingCount: item.vote_count,
        }
    }),
} : null;
---
<Layout
    title={`${title}`}
    description={item?.overview || undefined}
    ogImage={item?.poster_path || item?.backdrop_path || undefined}
    ogType="video.movie"
>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <article class="bg-gray-50">
        <!-- Hero inmersivo -->
        <div class="relative w-full min-h-[70vh] bg-cover bg-center bg-no-repeat" style={`background-image: url(${item?.backdrop_path ? originalUrl(item.backdrop_path) : '/assets/background.svg'})`}>
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/70 to-gray-900/40"></div>

            <div class="relative z-10 max-w-6xl mx-auto px-4 pt-8 pb-16 flex flex-col justify-end min-h-[70vh]">
                <nav class="absolute top-6 left-4 right-4" aria-label="Breadcrumb">
                    <ol class="flex items-center space-x-2 text-sm">
                        <li><a href="/" class="text-white/70 hover:text-white transition-colors">Inicio</a></li>
                        <li class="text-white/40">/</li>
                        <li><a href="/catalogo/topmovies" class="text-white/70 hover:text-white transition-colors">Películas</a></li>
                        <li class="text-white/40">/</li>
                        <li class="text-white/90 font-medium truncate max-w-xs">{item?.title}</li>
                    </ol>
                </nav>

                <div class="flex flex-col md:flex-row items-end gap-8">
                    <div class="hidden md:block flex-shrink-0 w-56 rounded-xl overflow-hidden shadow-2xl ring-1 ring-white/10">
                        <img src={posterUrl(item?.poster_path)} alt={item?.title} class="w-full aspect-[2/3] object-cover" />
                    </div>
                    <div class="flex-1 text-white">
                        {movieLogo
                            ? <img src={movieLogo} alt={item?.title} class="mb-3 h-auto max-h-20 md:max-h-28 w-auto max-w-[85%] md:max-w-[440px] object-contain drop-shadow-lg" />
                            : <h1 class="text-4xl md:text-5xl font-bold mb-3 leading-tight">{item?.title}</h1>}
                        {additionalInfo.tagline && (
                            <p class="text-white/60 italic text-lg mb-4">"{additionalInfo.tagline}"</p>
                        )}
                        <div class="flex flex-wrap items-center gap-3 mb-4">
                            <span class="text-yellow-400 text-lg font-bold">{item?.vote_average?.toFixed(1)} {getRatingStars(item?.vote_average)}</span>
                            <span class="text-white/70">{formatDate(item?.release_date)}</span>
                            {item?.runtime && <span class="text-white/70">{Math.floor(item.runtime / 60)}h {item.runtime % 60}min</span>}
                            {item?.hasSpanishTranslation && (
                                <span title="Disponible en español"><svg viewBox="0 0 750 500" class="w-8 h-5 rounded"><rect width="750" height="500" fill="#AA151B"/><rect width="750" height="250" y="125" fill="#F1BF00"/></svg></span>
                            )}
                        </div>
                        {item?.genres && (
                            <div class="flex flex-wrap gap-2 mb-5">
                                {item.genres.map((genre: { id: number; name: string }) => (
                                    <span class="px-3 py-1 bg-white/10 backdrop-blur-sm text-white text-xs rounded-full border border-white/20">{genre.name}</span>
                                ))}
                            </div>
                        )}
                        {item?.overview && (
                            <details class="max-w-2xl group">
                                <summary class="cursor-pointer">
                                    <p class="text-white/80 text-sm md:text-base leading-relaxed line-clamp-3 group-open:line-clamp-none">{item.overview}</p>
                                    <span class="inline-block mt-1 text-xs text-white/50 group-open:hidden">Pulsa para leer más</span>
                                </summary>
                            </details>
                        )}
                    </div>
                </div>
            </div>
        </div>

        <!-- Action bar (debajo del hero, no sticky) -->
        <div class="bg-white border-b border-gray-200 shadow-sm">
            <!-- Desktop: fila horizontal -->
            <div class="hidden md:flex max-w-6xl mx-auto px-4 py-2 items-center gap-2">
                <form method="POST">
                    <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInFavorites ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="favorites"/>
                    <button type="submit" class={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap ${isInFavorites ? 'bg-red-500 text-white' : 'border border-red-200 text-red-600 hover:bg-red-50'}`}>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
                        {isInFavorites ? 'En Favoritos' : 'Favoritos'}
                    </button>
                </form>
                <form method="POST">
                    <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInPendientes ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="pendientes"/>
                    <button type="submit" class={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap ${isInPendientes ? 'bg-amber-500 text-white' : 'border border-amber-200 text-amber-600 hover:bg-amber-50'}`}>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
                        {isInPendientes ? 'Pendiente' : 'Pendiente'}
                    </button>
                </form>
                <form method="POST">
                    <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInVistas ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="vistas"/>
                    <button type="submit" class={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap ${isInVistas ? 'bg-green-500 text-white' : 'border border-green-200 text-green-600 hover:bg-green-50'}`}>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                        {isInVistas ? 'Vista' : 'Vista'}
                    </button>
                </form>
                <form method="POST">
                    <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInVerPronto ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="verPronto"/>
                    <button type="submit" class={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap ${isInVerPronto ? 'bg-purple-500 text-white' : 'border border-purple-200 text-purple-600 hover:bg-purple-50'}`}>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="10"/></svg>
                        {isInVerPronto ? 'En Ver Pronto' : 'Ver Pronto'}
                    </button>
                </form>
                <div class="ml-auto flex items-center gap-2">
                    <button type="button" class="js-saveto px-3 py-1.5 text-xs font-medium rounded-lg border border-gray-200 text-gray-600 hover:border-gray-300 hover:text-gray-900 transition-colors flex items-center gap-1.5 whitespace-nowrap" data-mt="movie" data-id={item?.id} data-title={item?.title} data-poster={item?.poster_path} data-collections-only="1" aria-label="Guardar en una colección">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                        Guardar en colección
                        <svg class="w-3 h-3 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                    </button>
                    {isUnreleased && <NotificationBell mediaType="movie" tmdbId={id} isSubscribed={isNotifSubscribed} />}
                    <form method="POST">
                        <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInLiked ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="liked"/>
                        <button type="submit" class={`p-1.5 rounded-full transition-colors ${isInLiked ? 'text-red-500' : 'text-gray-400 hover:text-red-400'}`}>
                            <svg class="w-5 h-5" viewBox="0 0 20 20" fill={isInLiked ? "currentColor" : "none"} stroke="currentColor" stroke-width={isInLiked ? "0" : "1.5"}><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
                        </button>
                    </form>
                    {imdbId && (
                        <a href={`https://www.imdb.com/title/${imdbId}`} target="_blank" rel="noopener" class="px-2.5 py-1 text-xs font-bold bg-yellow-400 text-gray-900 rounded hover:bg-yellow-300 transition-colors">IMDb</a>
                    )}
                    {(item?.homepage || trailerUrl) && (
                        <a href={item?.homepage || trailerUrl} target="_blank" rel="noopener" class="px-3 py-1.5 text-xs font-medium bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors">Ver ahora</a>
                    )}
                </div>
            </div>
            <!-- Mobile: grid 2x2 + links -->
            <div class="md:hidden max-w-6xl mx-auto px-4 py-3 space-y-2">
                <div class="grid grid-cols-2 gap-2">
                    <form method="POST">
                        <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInFavorites ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="favorites"/>
                        <button type="submit" class={`w-full min-h-[44px] px-3 py-2.5 text-xs font-medium rounded-lg transition-colors flex items-center justify-center gap-1.5 ${isInFavorites ? 'bg-red-500 text-white' : 'border border-red-200 text-red-600'}`}>
                            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
                            {isInFavorites ? 'En Favoritos' : 'Favoritos'}
                        </button>
                    </form>
                    <form method="POST">
                        <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInPendientes ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="pendientes"/>
                        <button type="submit" class={`w-full min-h-[44px] px-3 py-2.5 text-xs font-medium rounded-lg transition-colors flex items-center justify-center gap-1.5 ${isInPendientes ? 'bg-amber-500 text-white' : 'border border-amber-200 text-amber-600'}`}>
                            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
                            {isInPendientes ? 'Pendiente' : 'Pendiente'}
                        </button>
                    </form>
                    <form method="POST">
                        <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInVistas ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="vistas"/>
                        <button type="submit" class={`w-full min-h-[44px] px-3 py-2.5 text-xs font-medium rounded-lg transition-colors flex items-center justify-center gap-1.5 ${isInVistas ? 'bg-green-500 text-white' : 'border border-green-200 text-green-600'}`}>
                            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                            {isInVistas ? 'Vista' : 'Vista'}
                        </button>
                    </form>
                    <form method="POST">
                        <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInVerPronto ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="verPronto"/>
                        <button type="submit" class={`w-full min-h-[44px] px-3 py-2.5 text-xs font-medium rounded-lg transition-colors flex items-center justify-center gap-1.5 ${isInVerPronto ? 'bg-purple-500 text-white' : 'border border-purple-200 text-purple-600'}`}>
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="10"/></svg>
                            {isInVerPronto ? 'Ver Pronto' : 'Ver Pronto'}
                        </button>
                    </form>
                </div>
                <button type="button" class="js-saveto w-full min-h-[44px] px-3 py-2.5 text-xs font-medium rounded-lg border border-gray-200 text-gray-600 flex items-center justify-center gap-1.5" data-mt="movie" data-id={item?.id} data-title={item?.title} data-poster={item?.poster_path} data-collections-only="1" aria-label="Guardar en una colección">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                    Guardar en colección
                </button>
                <div class="flex gap-2">
                    {isUnreleased && <NotificationBell mediaType="movie" tmdbId={id} isSubscribed={isNotifSubscribed} />}
                    <form method="POST" class="flex-1">
                        <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInLiked ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="liked"/>
                        <button type="submit" class={`w-full min-h-[44px] px-3 py-2 text-xs font-medium rounded-lg transition-colors flex items-center justify-center gap-1.5 ${isInLiked ? 'bg-red-50 text-red-500 border border-red-200' : 'border border-gray-200 text-gray-500'}`}>
                            <svg class="w-4 h-4" viewBox="0 0 20 20" fill={isInLiked ? "currentColor" : "none"} stroke="currentColor" stroke-width={isInLiked ? "0" : "1.5"}><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
                            {isInLiked ? 'Me gusta' : 'Me gusta'}
                        </button>
                    </form>
                    {imdbId && (
                        <a href={`https://www.imdb.com/title/${imdbId}`} target="_blank" rel="noopener" class="min-h-[44px] px-4 py-2 text-xs font-bold bg-yellow-400 text-gray-900 rounded-lg hover:bg-yellow-300 transition-colors flex items-center">IMDb</a>
                    )}
                    {(item?.homepage || trailerUrl) && (
                        <a href={item?.homepage || trailerUrl} target="_blank" rel="noopener" class="min-h-[44px] px-4 py-2 text-xs font-medium bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors flex items-center">Ver ahora</a>
                    )}
                </div>
            </div>
            </div>
        </div>

        <!-- Diario (L6): cuántas veces la has visto + marcar re-visionado -->
        {isWatchedMovie && (
            <div class="bg-white border-b border-gray-200">
                <div class="max-w-6xl mx-auto px-4 py-2 flex items-center justify-between gap-3 text-sm text-gray-600">
                    <span class="flex items-center gap-2 min-w-0">
                        <svg class="w-4 h-4 text-[#b91c1c] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 2l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14M7 22l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                        {movieTimes > 0
                            ? <span class="min-w-0"><strong class="text-gray-900 whitespace-nowrap">La has visto {movieTimes} {movieTimes === 1 ? 'vez' : 'veces'}</strong>{watchLastPretty && <span class="text-gray-400 hidden sm:inline"> · última en {watchLastPretty}</span>}</span>
                            : <span class="text-gray-500">La tienes como vista</span>}
                    </span>
                    <button type="button" class="js-rewatch flex-shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-gray-200 text-gray-600 hover:border-[#E63946] hover:text-[#E63946] transition-colors text-xs font-medium" data-mt="movie" data-id={item?.id} aria-label="Marcar visto otra vez">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 2l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14M7 22l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                        Vuelto a ver
                    </button>
                </div>
            </div>
        )}

        <!-- Layout 2 columnas -->
        <div class="max-w-6xl mx-auto px-4 py-8">
            <div class="flex flex-col md:flex-row gap-8">

                <!-- Sidebar izquierda -->
                <div class="md:w-1/3 space-y-4">
                    <!-- Poster mobile -->
                    <div class="md:hidden w-56 mx-auto rounded-xl overflow-hidden shadow-xl">
                        <img src={posterUrl(item?.poster_path)} alt={item?.title} class="w-full aspect-[2/3] object-cover" />
                    </div>

                    <!-- Info -->
                    <div class="bg-white rounded-xl border border-gray-200 p-4">
                        <h3 class="text-base font-semibold text-gray-800 mb-3">Información</h3>
                        <ul class="space-y-2.5 text-sm sm:text-base">
                            <li class="flex justify-between"><span class="text-gray-500">Estreno</span><span class="text-gray-800 font-medium">{formatDate(item?.release_date)}</span></li>
                            <li class="flex justify-between"><span class="text-gray-500">Valoración</span><span class="text-gray-800 font-medium">{item?.vote_average?.toFixed(1)} <span class="text-gray-400 text-xs">({item?.vote_count})</span></span></li>
                            <li class="flex justify-between"><span class="text-gray-500">Popularidad</span><span class="text-gray-800 font-medium">{item?.popularity?.toFixed(0)}</span></li>
                            <li class="flex justify-between"><span class="text-gray-500">Idioma</span><span class="text-gray-800 font-medium">{getLanguageDisplayName(item?.original_language)}</span></li>
                            {item?.original_title && item.original_title !== item.title && (
                                <li class="flex flex-col"><span class="text-gray-500">Título original</span><span class="text-gray-800 font-medium">{item.original_title}</span></li>
                            )}
                            {item?.runtime && (
                                <li class="flex justify-between"><span class="text-gray-500">Duración</span><span class="text-gray-800 font-medium">{Math.floor(item.runtime / 60)}h {item.runtime % 60}min</span></li>
                            )}
                            {additionalInfo.budget && additionalInfo.budget > 0 && (
                                <li class="flex justify-between"><span class="text-gray-500">Presupuesto</span><span class="text-gray-800 font-medium">{formatCurrency(additionalInfo.budget)}</span></li>
                            )}
                            {additionalInfo.revenue && additionalInfo.revenue > 0 && (
                                <li class="flex justify-between"><span class="text-gray-500">Recaudación</span><span class="text-green-600 font-medium">{formatCurrency(additionalInfo.revenue)}</span></li>
                            )}
                            {additionalInfo.budget && additionalInfo.budget > 0 && additionalInfo.revenue && additionalInfo.revenue > 0 && (
                                <li class="flex justify-between"><span class="text-gray-500">Beneficio</span><span class="text-gray-800 font-medium">x{(additionalInfo.revenue / additionalInfo.budget).toFixed(1)}</span></li>
                            )}
                            {movieStatus && (
                                <li class="flex justify-between"><span class="text-gray-500">Estado</span><span class="text-yellow-700 font-medium">{movieStatus}</span></li>
                            )}
                            {productionCountries.length > 0 && (
                                <li class="flex justify-between gap-2"><span class="text-gray-500 flex-shrink-0">País</span><span class="text-gray-800 font-medium text-right">{productionCountries.map((c: any) => c.name).join(', ')}</span></li>
                            )}
                            {yearsAgo && yearsAgo > 0 && (
                                <li class="flex justify-between"><span class="text-gray-500">Antigüedad</span><span class="text-gray-800 font-medium">Hace {yearsAgo} {yearsAgo === 1 ? 'año' : 'años'}</span></li>
                            )}
                            {ratingPercentile !== null && (
                                <li class="flex justify-between gap-2"><span class="text-gray-500 flex-shrink-0">Comparativa</span><span class="text-gray-800 font-medium text-right">Mejor que el {ratingPercentile}%{mainGenre ? ` de ${mainGenre}` : ''}</span></li>
                            )}
                        </ul>
                    </div>

                    <!-- Clasificación -->
                    {additionalInfo.content_ratings && additionalInfo.content_ratings.length > 0 && (() => {
                        const rating = getContentRating(additionalInfo.content_ratings);
                        return rating ? (
                            <div class="bg-white rounded-xl border border-gray-200 p-4">
                                <h3 class="text-base font-semibold text-gray-800 mb-2">Clasificación</h3>
                                <p class="text-sm font-medium text-gray-700">{rating.text}</p>
                            </div>
                        ) : null;
                    })()}

                    <!-- Dónde ver -->
                    <StreamingProviders providersByCountry={item?.providersByCountry || {}} linkByCountry={item?.providerLinksByCountry || {}} />

                    <!-- Nota personal -->
                    {(isInFavorites || isInPendientes || isInVistas || isInVerPronto || isInLiked) && (
                        <StarRating
                            currentRating={ratingFromAny}
                            tmdbRating={Number(item?.vote_average) || 0}
                            itemId={String(item?.id)}
                            mediaType="movie"
                        />
                    )}

                    <!-- Opinión -->
                    {(isInFavorites || isInPendientes || isInVistas || isInVerPronto || isInLiked) && (
                        <div class="bg-white rounded-xl border border-gray-200 p-4">
                            <h3 class="text-base font-semibold text-gray-800 mb-3">Tu opinión</h3>
                            {opinionFromAny ? (
                                <div class="space-y-3">
                                    <blockquote class="p-3 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-700 whitespace-pre-wrap">{opinionFromAny}</blockquote>
                                    <div class="flex items-center gap-2 justify-end">
                                        <details>
                                            <summary class="min-h-[44px] md:min-h-0 px-4 py-2.5 md:px-3 md:py-1.5 text-xs rounded-lg bg-gray-900 hover:bg-gray-800 text-white cursor-pointer inline-flex items-center">Actualizar</summary>
                                            <form method="POST" class="mt-3 space-y-2">
                                                <input type="hidden" name="id" value={item?.id} />
                                                <input type="hidden" name="action" value="save_opinion" />
                                                <textarea name="opinion" rows="3" class="w-full p-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-gray-400">{opinionFromAny}</textarea>
                                                <button type="submit" class="w-full min-h-[44px] md:min-h-0 px-4 py-2.5 md:px-3 md:py-1.5 bg-gray-900 text-white text-xs rounded-lg hover:bg-gray-800">Guardar</button>
                                            </form>
                                        </details>
                                        <form method="POST">
                                            <input type="hidden" name="id" value={item?.id} />
                                            <input type="hidden" name="action" value="delete_opinion" />
                                            <button type="submit" class="min-h-[44px] md:min-h-0 px-4 py-2.5 md:px-3 md:py-1.5 text-xs rounded-lg bg-red-50 text-red-600 border border-red-200 hover:bg-red-100">Eliminar</button>
                                        </form>
                                    </div>
                                </div>
                            ) : (
                                <form method="POST" class="space-y-2">
                                    <input type="hidden" name="id" value={item?.id} />
                                    <input type="hidden" name="action" value="save_opinion" />
                                    <textarea name="opinion" rows="3" class="w-full p-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-gray-400" placeholder="Escribe tu opinión..."></textarea>
                                    <button type="submit" class="w-full min-h-[44px] md:min-h-0 px-4 py-2.5 md:px-3 md:py-1.5 bg-gray-900 text-white text-xs rounded-lg hover:bg-gray-800">Guardar opinión</button>
                                </form>
                            )}
                        </div>
                    )}

                    <!-- Tus tags + notas (C15) -->
                    {inAnyCollection && (
                        <div class="bg-white rounded-xl border border-gray-200 p-4">
                            <h3 class="text-base font-semibold text-gray-800 mb-3 flex items-center gap-2">
                                <span class="w-1 h-5 bg-fuchsia-500 rounded-full"></span>
                                Tus tags y notas
                            </h3>
                            {userTags.length > 0 && (
                                <div class="flex flex-wrap gap-1.5 mb-3">
                                    {userTags.map(t => (
                                        <span class="px-2 py-0.5 text-xs bg-fuchsia-50 text-fuchsia-700 border border-fuchsia-200 rounded-full">#{t}</span>
                                    ))}
                                </div>
                            )}
                            {userNotes && (
                                <blockquote class="p-3 mb-3 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-700 whitespace-pre-wrap">{userNotes}</blockquote>
                            )}
                            <details>
                                <summary class="cursor-pointer text-xs text-fuchsia-600 hover:text-fuchsia-700 font-medium">
                                    {userTags.length > 0 || userNotes ? 'Editar' : 'Añadir tags y notas'}
                                </summary>
                                <form method="POST" class="mt-3 space-y-2">
                                    <input type="hidden" name="actionType" value="media_tags" />
                                    <input type="hidden" name="media_type" value="movie" />
                                    <input type="hidden" name="tmdb_id" value={item?.id} />
                                    <input type="text" name="tags" value={userTags.join(', ')} placeholder="comedia, road trip, 90s..." class="w-full p-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-fuchsia-400" />
                                    <p class="text-[11px] text-gray-400">Separados por comas. Máx 20.</p>
                                    <textarea name="notes" rows="3" placeholder="Notas más libres que la opinión..." class="w-full p-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-fuchsia-400">{userNotes}</textarea>
                                    <button type="submit" class="w-full min-h-[44px] md:min-h-0 px-4 py-2.5 md:px-3 md:py-1.5 bg-fuchsia-600 text-white text-xs rounded-lg hover:bg-fuchsia-700">Guardar</button>
                                </form>
                            </details>
                        </div>
                    )}

                    <!-- Keywords TMDB -->
                    {movieKeywords.length > 0 && (
                        <div class="bg-white rounded-xl border border-gray-200 p-4">
                            <h3 class="text-base font-semibold text-gray-800 mb-2">Keywords</h3>
                            <div class="flex flex-wrap gap-1.5">
                                {movieKeywords.map((kw) => (
                                    <a href={`/catalogo/keyword/${kw.id}?name=${encodeURIComponent(kw.name)}`} class="px-2 py-0.5 text-xs bg-gray-100 text-gray-500 rounded-full hover:bg-[#E63946]/10 hover:text-[#E63946] transition-colors">{kw.name}</a>
                                ))}
                            </div>
                        </div>
                    )}

                    <!-- Social + idiomas -->
                    {(hasSocialLinks || imdbId) && (
                        <div class="flex flex-wrap gap-2">
                            {imdbId && <a href={`https://www.imdb.com/title/${imdbId}`} target="_blank" rel="noopener" class="px-2.5 py-1 text-xs font-medium bg-yellow-50 text-yellow-800 rounded-lg hover:bg-yellow-100">IMDb</a>}
                            {movieSocialLinks.facebook && <a href={movieSocialLinks.facebook} target="_blank" rel="noopener" class="px-2.5 py-1 text-xs font-medium bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100">Facebook</a>}
                            {movieSocialLinks.instagram && <a href={movieSocialLinks.instagram} target="_blank" rel="noopener" class="px-2.5 py-1 text-xs font-medium bg-pink-50 text-pink-700 rounded-lg hover:bg-pink-100">Instagram</a>}
                            {movieSocialLinks.twitter && <a href={movieSocialLinks.twitter} target="_blank" rel="noopener" class="px-2.5 py-1 text-xs font-medium bg-sky-50 text-sky-700 rounded-lg hover:bg-sky-100">Twitter</a>}
                        </div>
                    )}

                    {movieLanguages.length > 0 && (
                        <div class="flex flex-wrap gap-1.5">
                            {movieLanguages.map((lang) => (
                                <span class="px-2 py-0.5 text-xs bg-gray-100 text-gray-600 rounded-full">{getLanguageDisplayName(lang.iso_639_1)}</span>
                            ))}
                        </div>
                    )}
                </div>

                <!-- Columna derecha -->
                <div class="md:w-2/3 space-y-8">

                    <!-- Trailer + Videos extras -->
                    <VideoSection trailerUrl={trailerUrl} clips={clips} behindScenes={behindScenes} teasers={teasers} />

                    <!-- Colección/Saga con progreso (✓ vista / TE FALTA / PRÓX.) -->
                    {collectionInfo && collectionInfo.parts && collectionInfo.parts.length > 1 && (
                        <SagaProgress
                            name={collectionInfo.name}
                            overview={collectionInfo.overview}
                            parts={collectionInfo.parts}
                            watchedTiers={watchedMovieTiers}
                            currentId={item?.id}
                        />
                    )}

                    <!-- Pósters -->
                    <LightboxGallery posters={posters} prefix="poster" />

                    <!-- Reparto (grid cards) -->
                    <CastGrid cast={cast} seenWith={seenWithMap} />

                    <!-- Dobladores en español (lazy, eldoblaje.com) -->
                    <DubbingSection type="movie" tmdbId={id} />

                    <!-- Equipo -->
                    <CrewGrid crew={directors} />

                    <!-- Productoras -->
                    <ProductionCompanies companies={item?.production_companies || []} />

                    <!-- Recomendaciones -->
                    <RecommendationsCarousel
                        items={moviesRecommendations}
                        mediaType="movie"
                        title={moviesRecommendationType === 'recommendations' ? 'Recomendaciones' : 'Películas similares'}
                    />

                    <!-- Reviews de TMDB -->
                    <ReviewsSection reviews={reviews} />
                </div>
            </div>
        </div>

    </article>
</Layout>

<script is:inline src="/js/optimistic-actions.js"></script>
