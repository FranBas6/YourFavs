---
import { posterUrl } from "../../services/API/shared/tmdbClient";

interface Company {
    id: number;
    name: string;
    logo_path?: string | null;
}

interface Props {
    companies: Company[];
    title?: string;
}

const { companies, title = "Productoras" } = Astro.props;
---
{companies && companies.length > 0 && (
    <section>
        <div class="fsec-h"><h2>{title}</h2><span class="n">{companies.length}</span></div>
        <div class="cprod">
            {companies.map((company) => (
                <a href={`/productora/${encodeURIComponent(company.name)}?companyId=${company.id}`} class="cprod-i">
                    {company.logo_path ? (
                        <img src={posterUrl(company.logo_path, 'w200')} alt={company.name} class="dark-logo-chip h-10 object-contain p-1" loading="lazy" />
                    ) : (
                        <div class="cprod-ph" aria-hidden="true">{company.name.slice(0, 1)}</div>
                    )}
                    <span>{company.name}</span>
                </a>
            ))}
        </div>
    </section>
)}
