                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              stroke-width="2"
                                              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    {season.episode_count} {season.season_number === 0 ? 'episodios especiales' : 'episodios'}
                                </span>
                                                        {season.air_date && (
                                                                <span class="flex items-center gap-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4"
                                             fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                                                    {formatDate(season.air_date)}
                                    </span>
                                                        )}
                                                    </div>
                                                    <p class="text-sm text-gray-700 season-overview">
                                                        {season.overview || (season.season_number === 0 ? "Episodios especiales, documentales, detrás de cámaras y contenido adicional." : "No hay descripción disponible para esta temporada.")}
                                                    </p>
                                                </div>
                                            </div>
                                        </summary>

                                        <!-- Lista de episodios para cada temporada -->
                                        <div class="bg-white p-4">
                                            <div class="space-y-3">
                                                {allSeasonEpisodes[season.season_number]?.map((episode) => (
                                                        <details class={`border-b pb-3 last:border-0 group ${season.season_number === 0 ? 'border-purple-200' : 'border-gray-200'}`}>
                                                            <summary class={`cursor-pointer py-2 flex items-center justify-between rounded-lg px-3 transition-colors ${season.season_number === 0 ? 'hover:bg-purple-50' : 'hover:bg-blue-50'}`}>
                                                                <div class="flex items-center gap-3 w-full">
                                        <span class={`font-bold px-2 py-1 rounded text-sm text-center flex-shrink-0 ${season.season_number === 0 ? 'bg-purple-100 text-purple-800 min-w-[40px]' : 'bg-blue-100 text-blue-800 w-8'}`}>
                                            {season.season_number === 0 ? `E${episode.episode_number}` : episode.episode_number}
                                        </span>
                                                                    <div class="flex-grow">
                                                                        <h5 class="font-medium text-gray-800 text-base">{episode.name}</h5>
                                                                        <div class="text-xs text-gray-500 flex items-center gap-2 mt-1">
                                                <span class="flex items-center gap-1">
                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         class="h-3 w-3" fill="none"
                                                         viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round"
                                                              stroke-linejoin="round"
                                                              stroke-width="2"
                                                              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                    </svg>
                                                    {formatDate(episode.air_date)}
                                                </span>
                                                                            {episode.runtime && (
                                                                                    <span class="flex items-center gap-1">
                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                             class="h-3 w-3" fill="none"
                                                             viewBox="0 0 24 24"
                                                             stroke="currentColor">
                                                            <path stroke-linecap="round"
                                                                  stroke-linejoin="round"
                                                                  stroke-width="2"
                                                                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                        </svg>
                                                                                        {formatRuntime(episode.runtime)}
                                                    </span>
                                                                            )}
                                                                            {episode.vote_average > 0 && (
                                                                                    <span class="flex items-center gap-1">
                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                             class="h-3 w-3 text-yellow-500"
                                                             fill="currentColor"
                                                             viewBox="0 0 24 24">
                                                            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                                                        </svg>
                                                                                        {episode.vote_average.toFixed(1)}
                                                    </span>
                                                                            )}
                                                                        </div>
                                                                    </div>
                                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                                         class={`h-4 w-4 opacity-0 group-hover:opacity-100 transition-opacity ${season.season_number === 0 ? 'text-purple-500' : 'text-blue-500'}`}
                                                                         fill="none" viewBox="0 0 24 24"
                                                                         stroke="currentColor">
                                                                        <path stroke-linecap="round"
                                                                              stroke-linejoin="round" stroke-width="2"
                                                                              d="M9 5l7 7-7 7"/>
                                                                    </svg>
                                                                </div>
                                                            </summary>

                                                            <div class={`mt-2 px-3 py-2 rounded-lg ${season.season_number === 0 ? 'bg-purple-50' : 'bg-blue-50'}`}>
                                                                <div class="flex gap-4">
                                                                    {episode.still_path && (
                                                                            <div class="w-1/3 flex-shrink-0">
                                                                                <img
                                                                                        src={`https://image.tmdb.org/t/p/w300${episode.still_path}`}
                                                                                        alt={episode.name}
                                                                                        loading="lazy"
                                                                                        class="rounded-lg shadow-md w-full h-auto object-cover"
                                                                                />
                                                                            </div>
                                                                    )}
                                                                    <div class="flex-grow">
                                                                        <p class="text-sm text-gray-700 mb-2">
                                                                            {episode.overview || (season.season_number === 0 ? "No hay descripción disponible para este episodio especial." : "No hay descripción disponible para este episodio.")}
                                                                        </p>
                                                                        {episode.guest_stars && episode.guest_stars.length > 0 && (
                                                                                <div class="mt-2">
                                                                                    <h6 class={`text-sm font-semibold mb-1 ${season.season_number === 0 ? 'text-purple-700' : 'text-blue-700'}`}>
                                                                                        Estrellas invitadas:</h6>
                                                                                    <ul class="text-xs text-gray-600 list-disc list-inside">
                                                                                        {episode.guest_stars.map(star => (
                                                                                                <li><a
                                                                                                        href={`/actor/${star.id}`}
                                                                                                        class={`text-gray-800 font-semibold hover:underline transition duration-300 ${season.season_number === 0 ? 'hover:text-purple-600' : 'hover:text-blue-600'}`}
                                                                                                >
                                                                                                    {star.name}
                                                                                                </a>
                                                                                                    como {star.character}</li>
                                                                                        ))}
                                                                                    </ul>
                                                                                </div>
                                                                        )}
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </details>
                                                ))}

                                                {(!allSeasonEpisodes[season.season_number] || allSeasonEpisodes[season.season_number].length === 0) && (
                                                        <p class="text-gray-500 italic text-center p-4">
                                                            {season.season_number === 0 ?
                                                                "No hay información de episodios especiales disponible." :
                                                                "No hay información de episodios disponible para esta temporada."
                                                            }
                                                        </p>
                                                )}
                                            </div>
                                        </div>
                                    </details>
                            ))}
                        </div>
                    </div>

                    <!-- Pósters -->
                    <div class="bg-white p-6 rounded-lg shadow-md mb-8">
                        <h2 class="text-2xl font-bold text-blue-600 mb-4">Pósters</h2>

                        {posters && posters.length > 0 ? (
                                <div class="carousel-container relative max-w-full overflow-hidden">
                                    <div class="carousel-track flex gap-4 overflow-x-auto pb-4 scrollbar-hide">
                                        {posters.slice(0, 40).map((poster, index) => (
                                                <>
                                                    <div class="carousel-slide flex-shrink-0 w-48">
                                                        <a href={`#poster-${index}`}>
                                                            <img
                                                                    src={poster.file_path}
                                                                    alt={`Póster ${poster.vote_average.toFixed(1)}/10`}
                                                                    loading="lazy"
                                                                    class="rounded-lg shadow-md w-full h-64 object-cover"
                                                            />
                                                        </a>
                                                    </div>

                                                    {/* Modal de imagen */}
                                                    <div id={`poster-${index}`} class="modal">
                                                        <a href="#" class="modal-close">&times;</a>
                                                        <img src={poster.file_path}
                                                             alt={`Póster ${poster.vote_average.toFixed(1)}/10`}/>
                                                    </div>
                                                </>
                                        ))}
                                    </div>
                                </div>
                        ) : (
                                <p class="text-gray-600 text-center">No se encontraron pósters para esta serie</p>
                        )}
                    </div>

                    <!-- Reparto y Equipo -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        {/* Reparto */}
                        <div class="bg-white p-6 rounded-lg shadow-md">
                            <h2 class="text-2xl font-bold text-blue-600 mb-4">Reparto</h2>
                            <div class="text-gray-600">
                                {cast?.length > 0 ? (
                                        <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                                            {cast.map((actor) => (
                                                    <li class="border-b border-gray-100 pb-3 last:border-0">
                                                        <div class="flex flex-col">
                                                            <a
                                                                    href={`/actor/${actor.id}`}
                                                                    class="text-gray-800 font-semibold hover:text-blue-600 hover:underline transition duration-300"
                                                            >
                                                                {actor.name}
                                                            </a>
                                                            {actor.character && (
                                                                    <span class="text-sm text-gray-500 mt-1">
                                                            {actor.character}
                                                        </span>
                                                            )}
                                                        </div>
                                                    </li>
                                            ))}
                                        </ul>
                                ) : (
                                        <p class="text-gray-500">Información no disponible</p>
                                )}
                            </div>
                        </div>

                        <!-- Equipo -->
                        <div class="bg-white p-6 rounded-lg shadow-md">
                            <h2 class="text-2xl font-bold text-blue-600 mb-4">Equipo</h2>
                            <div class="text-gray-600">
                                {directors?.length > 0 ? (
                                        <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2">
                                            {directors.map((director) => (
                                                    <li class="border-b border-gray-100 py-1 last:border-0">
                                                        <span class="font-medium">{director.job}: </span>
                                                        <span>{director.name}</span>
                                                    </li>
                                            ))}
                                        </ul>
                                ) : (
                                        <p class="text-gray-500">Información no disponible</p>
                                )}
                            </div>
                        </div>
                    </div>

                    <!-- Plataformas y Productoras en dos columnas -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Plataformas -->
                        {providerElements.length > 0 && (
                                <div class="bg-white p-6 rounded-lg shadow-md">
                                    <h2 class="text-2xl font-bold text-blue-600 mb-4">Disponible en</h2>
                                    <div class="grid grid-cols-3 sm:grid-cols-3 gap-4">
                                        {providerElements.map((provider) => (
                                                <div class="flex flex-col items-center">
                                                    {provider.logo ? (
                                                        provider.link ? (
                                                                <a href={provider.link} target="_blank"
                                                                   rel="noopener noreferrer">
                                                                    <img
                                                                            src={provider.logo}
                                                                            alt={provider.name}
                                                                            loading="lazy"
                                                                            class="w-16 h-16 object-contain rounded-md mb-2 hover:scale-105 transition-all"
                                                                    />
                                                                </a>
                                                        ) : (
                                                                <img
                                                                        src={provider.logo}
                                                                        alt={provider.name}
                                                                        loading="lazy"
                                                                        class="w-16 h-16 object-contain rounded-md mb-2 hover:scale-105 transition-all"
                                                                />
                                                        )
                                                    ) : (
                                                            <div class="w-16 h-16 bg-gray-200 rounded-md flex items-center justify-center mb-2">
                                                                <span class="text-xs text-gray-500">Sin logo</span>
                                                            </div>
                                                    )}
                                                    <p class="text-xs text-center text-gray-600">{provider.name}</p>
                                                </div>
                                        ))}
                                    </div>
                                </div>
                        )}

                        <!-- Productoras -->
                        {item?.production_companies && item.production_companies.length > 0 && (
                                <div class="bg-white p-6 rounded-lg shadow-md">
                                    <h2 class="text-2xl font-bold text-blue-600 mb-4">Productoras</h2>
                                    <div class="grid grid-cols-3 sm:grid-cols-3 gap-4">
                                        {item.production_companies.map((company) => (
                                                <div class="flex flex-col items-center">
                                                    {company?.logo_path ? (
                                                            <img
                                                                    src={`https://image.tmdb.org/t/p/w200${company.logo_path}`}
                                                                    alt={company.name}
                                                                    loading="lazy"
                                                                    class="w-16 h-16 object-contain rounded-md mb-2 hover:scale-105 transition-all"
                                                            />
                                                    ) : (
                                                            <div class="w-16 h-16 bg-gray-200 rounded-md flex items-center justify-center mb-2">
                                                                <span class="text-xs text-gray-500">Sin logo</span>
                                                            </div>
                                                    )}
                                                    <p class="text-xs text-center text-gray-500">{company.name}</p>
                                                </div>
                                        ))}
                                    </div>
                                </div>
                        )}
                    </div>
                </div>
            </div>
        </div>
    </article>
</Layout>

<style>
    /* Estilos básicos */
    .transition-all {
        transition: all 0.3s ease-in-out;
    }

    .text-yellow-400 {
        color: #fbbf24;
    }

    /* Efecto hover para imágenes */
    img.hover\:scale-105:hover {
        transform: scale(1.05);
    }

    /* Gradiente para el texto sobre imágenes oscuras */
    .text-shadow {
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
    }

    /* Mejorar legibilidad para estrellas de rating */
    .rating-stars {
        letter-spacing: 1px;
    }

    /* Estilos para la animación del acordeón */
    .transform {
        transition-property: transform;
    }

    .transition-transform {
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 300ms;
    }

    .rotate-180 {
        transform: rotate(180deg);
    }

    /* Añade estos estilos a tu sección de <style> */
    details > summary {
        list-style: none;
    }

    details > summary::-webkit-details-marker {
        display: none;
    }

    details[open] > summary svg {
        transform: rotate(180deg);
    }

    /* Estilos mejorados para el overview de temporadas */
    .season-overview {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: all 0.3s ease-in-out;
    }

    /* Cuando el details está abierto, muestra el texto completo */
    details[open] .season-overview {
        display: block;
        -webkit-line-clamp: unset;
        overflow: visible;
    }

    /* Additional styles for enhanced episode view */
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.85);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .modal:target {
        display: flex;
    }

    .modal img {
        max-width: 90%;
        max-height: 90%;
        border-radius: 0.5rem;
    }

    .modal-close {
        position: absolute;
        top: 2rem;
        right: 2rem;
        color: white;
        font-size: 2rem;
        text-decoration: none;
        font-weight: bold;
    }
</style>