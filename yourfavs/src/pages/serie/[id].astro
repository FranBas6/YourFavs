                                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                                                                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                                                                        </svg>
                                                                        Episodios Especiales
                                                                    </span>
                                                            ) : (
                                                                `Temporada ${season.season_number}`
                                                            )}
                                                        </h3>
                                                        <svg xmlns="http://www.w3.org/2000/svg" 
                                                             class={`h-6 w-6 transition-transform duration-300 ${season.season_number === 0 ? 'text-purple-600' : 'text-blue-600'}`} 
                                                             fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                                        </svg>
                                                    </div>
                                                    
                                                    <!-- Estadísticas mejoradas de la temporada -->
                                                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4 season-stats">
                                                        <div class={`text-center p-3 rounded-lg ${season.season_number === 0 ? 'bg-purple-100' : 'bg-blue-100'}`}>
                                                            <div class={`text-xl font-bold ${season.season_number === 0 ? 'text-purple-800' : 'text-blue-800'}`}>
                                                                {stats.totalEpisodes}
                                                            </div>
                                                            <div class="text-xs text-gray-600">Episodios</div>
                                                        </div>
                                                        
                                                        <div class={`text-center p-3 rounded-lg ${season.season_number === 0 ? 'bg-purple-100' : 'bg-blue-100'}`}>
                                                            <div class={`text-xl font-bold ${season.season_number === 0 ? 'text-purple-800' : 'text-blue-800'}`}>
                                                                {stats.averageRating !== "0.0" ? `⭐${stats.averageRating}` : "N/A"}
                                                            </div>
                                                            <div class="text-xs text-gray-600">Rating</div>
                                                        </div>
                                                        
                                                        <div class={`text-center p-3 rounded-lg ${season.season_number === 0 ? 'bg-purple-100' : 'bg-blue-100'}`}>
                                                            <div class={`text-sm font-bold ${season.season_number === 0 ? 'text-purple-800' : 'text-blue-800'}`}>
                                                                {stats.averageRuntime !== "No disponible" ? stats.averageRuntime : "N/A"}
                                                            </div>
                                                            <div class="text-xs text-gray-600">Duración</div>
                                                        </div>
                                                    </div>

