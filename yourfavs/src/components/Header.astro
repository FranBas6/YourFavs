---
import HeaderButton from "./HeaderButton.astro";
import '../styles/components/header.css';
---
<header class="py-3 px-5 mx-auto w-full lg:py-10 lg:px-16 bg-gradient-to-r from-blue-600 to-blue-500 rounded-b-2xl shadow-lg">
    <div class="title-container">
        <a href="/" class="title-container-sm">
            <h1 class="yourfavs-title-sm">YOURFAVS</h1>
        </a>
    </div>

    <!-- Toggle oculto -->
    <input type="checkbox" id="nav-toggle" class="hidden peer" />

    <!-- Botón hamburguesa (solo visible cuando NO está activo) -->
    <label for="nav-toggle"
           role="button"
           aria-label="Abrir menú de navegación"
           class="md:hidden fixed top-4 right-4 z-[9999] bg-white text-indigo-600 hover:text-white hover:bg-indigo-700 p-3 rounded-full shadow-xl border border-indigo-600 transition-all duration-300 ease-in-out peer-checked:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
    </label>

    <!-- Botón X (solo visible cuando SÍ está activo) -->
    <label for="nav-toggle"
           role="button"
           aria-label="Cerrar menú de navegación"
           class="md:hidden fixed top-4 right-4 z-[9999] text-white bg-red-600 hover:bg-red-700 p-3 rounded-full shadow-xl transition-all duration-300 ease-in-out hidden peer-checked:flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"/>
        </svg>
    </label>

    <!-- Nav con Sticky -->
    <nav aria-label="Navegación principal" class="hidden md:flex md:flex-wrap md:justify-center md:gap-4 sticky-nav w-full bg-transparent text-center rounded-xl"
         id="nav-menu">
        <HeaderButton href="/">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 class="mr-2 icon icon-tabler icons-tabler-outline icon-tabler-library">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M7 3m0 2.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667z"/>
                <path d="M4.012 7.26a2.005 2.005 0 0 0 -1.012 1.737v10c0 1.1 .9 2 2 2h10c.75 0 1.158 -.385 1.5 -1"/>
                <path d="M11 7h5"/>
                <path d="M11 10h6"/>
                <path d="M11 13h3"/>
            </svg>
            Catálogo
        </HeaderButton>
        <HeaderButton href="/catalogo/cartelera">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 class="mr-2 icon icon-tabler icons-tabler-outline icon-tabler-ticket">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M15 5l0 2"/>
                <path d="M15 11l0 2"/>
                <path d="M15 17l0 2"/>
                <path d="M5 5h14a2 2 0 0 1 2 2v3a2 2 0 0 0 0 4v3a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-3a2 2 0 0 0 0 -4v-3a2 2 0 0 1 2 -2"/>
            </svg>
            Cartelera
        </HeaderButton>
        <HeaderButton href="/catalogo/ultimoslanzamientos">
            <svg class="mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round" width="20" height="20" stroke-width="2">
                <path d="M4 13a8 8 0 0 1 7 7a6 6 0 0 0 3 -5a9 9 0 0 0 6 -8a3 3 0 0 0 -3 -3a9 9 0 0 0 -8 6a6 6 0 0 0 -5 3"></path>
                <path d="M7 14a6 6 0 0 0 -3 6a6 6 0 0 0 6 -3"></path>
                <path d="M15 9m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path>
            </svg>
            Últimos Lanzamientos
        </HeaderButton>
        <HeaderButton href="/catalogo/maspopulares">
            <svg class="mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round" width="20" height="20" stroke-width="2">
                <path d="M12 12c2 -2.96 0 -7 -1 -8c0 3.038 -1.773 4.741 -3 6c-1.226 1.26 -2 3.24 -2 5a6 6 0 1 0 12 0c0 -1.532 -1.056 -3.94 -2 -5c-1.786 3 -2.791 3 -4 2z"></path>
            </svg>
            Más Populares
        </HeaderButton>
        <HeaderButton href="/catalogo/topmovies">
            <svg class="mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="20" height="20"
                 stroke-width="2" stroke-linejoin="round" stroke-linecap="round" stroke="currentColor">
                <path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"></path>
                <path d="M8 4l0 16"></path>
                <path d="M16 4l0 16"></path>
                <path d="M4 8l4 0"></path>
                <path d="M4 16l4 0"></path>
                <path d="M4 12l16 0"></path>
                <path d="M16 8l4 0"></path>
                <path d="M16 16l4 0"></path>
            </svg>
            Películas
        </HeaderButton>
        <HeaderButton href="/catalogo/topseries">
            <svg class="mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round" width="20" height="20" stroke-width="2">
                <path d="M3 7m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z"></path>
                <path d="M16 3l-4 4l-4 -4"></path>
            </svg>
            Series
        </HeaderButton>
        <HeaderButton href="/catalogo/plataformas">
            <svg class="mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round" width="20" height="20" stroke-width="2">
                <path d="M2 8a4 4 0 0 1 4 -4h12a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-12a4 4 0 0 1 -4 -4v-8z"></path>
                <path d="M10 9l5 3l-5 3z"></path>
            </svg>
            Plataformas
        </HeaderButton>
        <HeaderButton href="/catalogo/categorias">
            <svg class="mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round" width="20" height="20" stroke-width="2">
                <path d="M4 4h6v6h-6z"></path>
                <path d="M14 4h6v6h-6z"></path>
                <path d="M4 14h6v6h-6z"></path>
                <path d="M17 17m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path>
            </svg>
            Categorías
        </HeaderButton>
        <HeaderButton href="/personal/favoritos">
            <svg class="mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="24" height="24"
                 stroke-width="2" stroke-linejoin="round" stroke-linecap="round" stroke="currentColor">
                <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"></path>
                <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"></path>
            </svg>
            Personal
        </HeaderButton>
        <!-- Buscador con botón -->
        <div class="flex items-center space-x-3">
            <form action="/catalogo/busqueda" method="get" class="flex items-center relative">
                <label for="header-search" class="sr-only">Buscar películas y series</label>
                <input
                        id="header-search"
                        name="query"
                        type="text"
                        placeholder="Buscar películas, series..."
                        class="w-64 xl:w-80 pl-10 pr-12 py-2.5 rounded-full border-0 bg-white/90 backdrop-blur-sm text-gray-800 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white/50 focus:bg-white transition-all duration-300 shadow-lg"
                        autocomplete="off"
                />

                <!-- Ícono de lupa dentro del input -->
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </div>

                <!-- Botón funcional -->
                <button type="submit"
                        aria-label="Buscar"
                        class="absolute right-1 top-1/2 -translate-y-1/2 p-2 rounded-full bg-indigo-600 text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-300 transition duration-200 shadow-md">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd"
                              d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z"
                              clip-rule="evenodd"/>
                    </svg>
                </button>
            </form>
        </div>
    </nav>
</header>
