---
import {formatFirebaseDate} from "../../utils/constants/helpers/media-helpers";
import {posterUrl} from "../../services/API/shared/tmdbClient";

interface Props {
    stats: {
        series: {
            total: number;
            enEmision: number;
            finalizadas: number;
            temporadasTotal: number;
            episodiosTotal: number;
            añoMasAntiguo: number;
            añoMasReciente: number;
            notaPromedio: number;
            latestAdded: { id: string; name: string; poster_path?: string; added_at: any }[];
        };
        watched?: {
            totalEpisodes: number;
            topSerie: { name: string; watched: number } | null;
        };
        movies: {
            total: number;
            añoMasAntiguo: number;
            añoMasReciente: number;
            notaPromedio: number;
            duracionPromedio: number;
            duracionTotal?: number;
            latestAdded: { id: string; title: string; poster_path?: string; added_at: any }[];
        };
        general: {
            totalContent: number;
            topGenres: { name: string; count: number }[];
            topDecades: [string, number][];
            topCountries?: { code: string; count: number }[];
            opinionStats?: { total: number; percentage: number };
            watchtime?: { total: number; days: number; hours: number };
            notaPromedioGeneral: string;
        };
    };
}

const { stats } = Astro.props;
const wt = stats.general.watchtime;
const opinions = stats.general.opinionStats;
---
<details class="mb-6 group">
    <summary class="flex items-center justify-between px-5 py-3 bg-white rounded-xl border border-gray-200 shadow-sm cursor-pointer hover:shadow-md transition-all">
        <div class="flex items-center gap-2.5">
            <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
            <span class="text-sm font-semibold text-gray-700">Estadísticas</span>
            <span class="text-xs text-gray-400">{stats.general.totalContent} títulos</span>
        </div>
        <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
    </summary>

    <div class="mt-3 bg-gray-50 rounded-2xl border border-gray-100 p-4 space-y-4">
        <!-- Resumen rápido -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="bg-white rounded-xl p-4 border border-gray-100 text-center">
                <div class="text-2xl font-bold text-gray-900">{stats.general.totalContent}</div>
                <div class="text-xs text-gray-500 mt-0.5">Títulos</div>
            </div>
            <div class="bg-white rounded-xl p-4 border border-gray-100 text-center">
                <div class="text-2xl font-bold text-yellow-600">{stats.general.notaPromedioGeneral}</div>
                <div class="text-xs text-gray-500 mt-0.5">Nota media</div>
            </div>
            <div class="bg-white rounded-xl p-4 border border-gray-100 text-center">
                <div class="text-2xl font-bold text-blue-600">{stats.series.total}</div>
                <div class="text-xs text-gray-500 mt-0.5">Series</div>
            </div>
            <div class="bg-white rounded-xl p-4 border border-gray-100 text-center">
                <div class="text-2xl font-bold text-red-600">{stats.movies.total}</div>
                <div class="text-xs text-gray-500 mt-0.5">Películas</div>
            </div>
        </div>

        <!-- Watchtime + Opiniones -->
        {(wt || opinions) && (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {wt && wt.total > 0 && (
                    <div class="bg-gradient-to-br from-indigo-50 to-purple-50 rounded-xl p-4 border border-indigo-100">
                        <div class="text-xs text-indigo-500 font-medium mb-1">Tiempo estimado viendo</div>
                        <div class="text-xl font-bold text-indigo-700">
                            {wt.days > 0 ? `${wt.days}d ` : ''}{wt.hours}h
                        </div>
                        <div class="text-xs text-indigo-400 mt-0.5">
                            {stats.series.episodiosTotal} episodios + {stats.movies.total} películas
                        </div>
                    </div>
                )}
                {opinions && (
                    <div class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-xl p-4 border border-amber-100">
                        <div class="text-xs text-amber-500 font-medium mb-1">Opiniones escritas</div>
                        <div class="text-xl font-bold text-amber-700">{opinions.total}</div>
                        <div class="text-xs text-amber-400 mt-0.5">
                            {opinions.percentage}% de tu colección tiene opinión
                        </div>
                    </div>
                )}
            </div>
        )}

        <!-- Series + Movies detalle -->
        <div class="grid lg:grid-cols-2 gap-3">
            <!-- Series -->
            <div class="bg-white rounded-xl p-4 border border-gray-100">
                <h3 class="text-sm font-semibold text-gray-800 mb-3 flex items-center gap-1.5">
                    <span class="w-1 h-4 bg-blue-500 rounded-full"></span>
                    Series
                </h3>
                <div class="grid grid-cols-2 gap-2 text-sm mb-3">
                    <div class="flex justify-between"><span class="text-gray-500">En emisión</span><span class="font-medium text-green-600">{stats.series.enEmision}</span></div>
                    <div class="flex justify-between"><span class="text-gray-500">Finalizadas</span><span class="font-medium text-gray-600">{stats.series.finalizadas}</span></div>
                    <div class="flex justify-between"><span class="text-gray-500">Temporadas</span><span class="font-medium">{stats.series.temporadasTotal}</span></div>
                    <div class="flex justify-between"><span class="text-gray-500">Episodios</span><span class="font-medium">{stats.series.episodiosTotal}</span></div>
                    <div class="flex justify-between"><span class="text-gray-500">Nota media</span><span class="font-medium text-yellow-600">{stats.series.notaPromedio}</span></div>
                    <div class="flex justify-between"><span class="text-gray-500">Años</span><span class="font-medium">{stats.series.añoMasAntiguo}-{stats.series.añoMasReciente}</span></div>
                    {stats.watched && stats.watched.totalEpisodes > 0 && (
                        <div class="flex justify-between"><span class="text-gray-500">Eps. vistos</span><span class="font-medium text-green-600">{stats.watched.totalEpisodes}</span></div>
                    )}
                    {stats.watched?.topSerie && (
                        <div class="flex justify-between col-span-2"><span class="text-gray-500">Más vista</span><span class="font-medium text-green-600 truncate ml-2">{stats.watched.topSerie.name} ({stats.watched.topSerie.watched})</span></div>
                    )}
                </div>
                {stats.series.latestAdded.length > 0 && (
                    <div class="pt-2 border-t border-gray-100">
                        <p class="text-xs text-gray-400 mb-2">Últimas añadidas</p>
                        <div class="flex gap-1.5 overflow-x-auto">
                            {stats.series.latestAdded.map(s => (
                                <a href={`/serie/${s.id}`} class="flex-shrink-0 w-12 h-16 sm:w-20 sm:h-28 rounded-md overflow-hidden hover:ring-2 hover:ring-blue-300 transition-all" title={s.name}>
                                    {s.poster_path
                                        ? <img src={posterUrl(s.poster_path, 'w92')} alt={s.name} class="w-full h-full object-cover"/>
                                        : <div class="w-full h-full bg-gray-200 flex items-center justify-center text-xs text-gray-400">?</div>
                                    }
                                </a>
                            ))}
                        </div>
                    </div>
                )}
            </div>

            <!-- Películas -->
            <div class="bg-white rounded-xl p-4 border border-gray-100">
                <h3 class="text-sm font-semibold text-gray-800 mb-3 flex items-center gap-1.5">
                    <span class="w-1 h-4 bg-red-500 rounded-full"></span>
                    Películas
                </h3>
                <div class="grid grid-cols-2 gap-2 text-sm mb-3">
                    <div class="flex justify-between"><span class="text-gray-500">Total</span><span class="font-medium">{stats.movies.total}</span></div>
                    <div class="flex justify-between"><span class="text-gray-500">Nota media</span><span class="font-medium text-yellow-600">{stats.movies.notaPromedio}</span></div>
                    <div class="flex justify-between"><span class="text-gray-500">Dur. media</span><span class="font-medium">{stats.movies.duracionPromedio}min</span></div>
                    <div class="flex justify-between"><span class="text-gray-500">Años</span><span class="font-medium">{stats.movies.añoMasAntiguo}-{stats.movies.añoMasReciente}</span></div>
                </div>
                {stats.movies.latestAdded.length > 0 && (
                    <div class="pt-2 border-t border-gray-100">
                        <p class="text-xs text-gray-400 mb-2">Últimas añadidas</p>
                        <div class="flex gap-1.5 overflow-x-auto">
                            {stats.movies.latestAdded.map(m => (
                                <a href={`/movie/${m.id}`} class="flex-shrink-0 w-12 h-16 sm:w-20 sm:h-28 rounded-md overflow-hidden hover:ring-2 hover:ring-red-300 transition-all" title={m.title}>
                                    {m.poster_path
                                        ? <img src={posterUrl(m.poster_path, 'w92')} alt={m.title} class="w-full h-full object-cover"/>
                                        : <div class="w-full h-full bg-gray-200 flex items-center justify-center text-xs text-gray-400">?</div>
                                    }
                                </a>
                            ))}
                        </div>
                    </div>
                )}
            </div>
        </div>

        <!-- Géneros + Décadas -->
        <div class="grid sm:grid-cols-2 gap-3">
            {stats.general.topGenres.length > 0 && (
                <div class="bg-white rounded-xl p-4 border border-gray-100">
                    <h3 class="text-sm font-semibold text-gray-800 mb-3">Top géneros</h3>
                    <div class="space-y-2">
                        {stats.general.topGenres.map((g, i) => (
                            <div class="flex items-center justify-between text-sm">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs text-gray-400 w-4">#{i + 1}</span>
                                    <span class="text-gray-700">{g.name}</span>
                                </div>
                                <span class="text-xs font-medium text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full">{g.count}</span>
                            </div>
                        ))}
                    </div>
                </div>
            )}
            <div class="space-y-3">
                {stats.general.topDecades.length > 0 && (
                    <div class="bg-white rounded-xl p-4 border border-gray-100">
                        <h3 class="text-sm font-semibold text-gray-800 mb-3">Top décadas</h3>
                        <div class="space-y-2">
                            {stats.general.topDecades.map(([decade, count], i) => (
                                <div class="flex items-center justify-between text-sm">
                                    <div class="flex items-center gap-2">
                                        <span class="text-xs text-gray-400 w-4">#{i + 1}</span>
                                        <span class="text-gray-700">{decade}</span>
                                    </div>
                                    <span class="text-xs font-medium text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full">{count}</span>
                                </div>
                            ))}
                        </div>
                    </div>
                )}
                {stats.general.topCountries && stats.general.topCountries.length > 0 && (
                    <div class="bg-white rounded-xl p-4 border border-gray-100">
                        <h3 class="text-sm font-semibold text-gray-800 mb-3">Top países</h3>
                        <div class="flex flex-wrap gap-2">
                            {stats.general.topCountries.map(c => (
                                <span class="text-xs px-2.5 py-1 bg-gray-50 text-gray-600 rounded-full border border-gray-100 font-medium">
                                    {c.code} <span class="text-gray-400">({c.count})</span>
                                </span>
                            ))}
                        </div>
                    </div>
                )}
            </div>
        </div>

        <!-- Resumen -->
        <div class="bg-gray-50 rounded-xl p-4 text-center text-sm text-gray-500">
            <span class="font-medium text-gray-700">{stats.general.totalContent}</span> títulos ·
            Nota media <span class="font-medium text-yellow-600">{stats.general.notaPromedioGeneral}</span> ·
            {stats.series.total > 0 && <><span class="text-blue-600">{((stats.series.total / stats.general.totalContent) * 100).toFixed(0)}%</span> series</>}
            {stats.movies.total > 0 && <> · <span class="text-red-600">{((stats.movies.total / stats.general.totalContent) * 100).toFixed(0)}%</span> películas</>}
        </div>
    </div>
</details>
