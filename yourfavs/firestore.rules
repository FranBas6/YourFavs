rules_version = '2';

// Modelo Fase C: datos por usuario en users/{uid}/...
// El acceso server-side va por Admin SDK (bypassa estas reglas); el scoping real
// lo garantiza userScope con el uid de la sesión. Estas reglas protegen el acceso
// DIRECTO desde el cliente (deny-by-default): nadie lee/escribe nada salvo su
// propio users/{uid}. Las colecciones globales antiguas quedan denegadas.
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo accede a su propio árbol users/{uid}/**
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // `homeRows/*` — filas de la portada precalculadas (pilotos, ranking semanal). Son datos
    // PÚBLICOS de TMDB y globales para todo el mundo, no de nadie en concreto, así que viven fuera de
    // `users/{uid}`: calcularlas por usuario costaría cien llamadas a TMDB por visitante.
    //
    // Siguen DENEGADAS al cliente a propósito, por la regla de abajo: se leen y escriben solo desde
    // el servidor con el Admin SDK (`globalDoc()` en `services/BD/shared/userScope.ts`), que se salta
    // estas reglas. Si algún día hiciera falta leerlas desde el navegador, aquí iría un
    // `allow read: if true` — y NUNCA un `allow write`.

    // Todo lo demás (incluidas las colecciones globales antiguas): denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
