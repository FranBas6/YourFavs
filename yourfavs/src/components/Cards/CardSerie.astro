---
import '../../styles/components/cards.css';
import {formatCardDate, getRatingColor, isRecentRelease} from "../../utils/constants/helpers/card-helpers";

interface Props {
    id: string;
    name: string;
    img: string;
    vote_average: number;
    overview: string;
    first_air_date?: string;
    seasons?: {
        air_date: string;
        episode_count: number;
        id: number;
        name: string;
        overview: string;
        poster_path: string;
        season_number: number;
        vote_average?: number;
    }[];
    last_episode_to_air?: { air_date: string; episode_number: number; season_number: number; [key: string]: any };
    next_episode_to_air?: { air_date: string; episode_number: number; season_number: number; [key: string]: any } | null;
    genres?: { id: number; name: string }[];
    status?: string;
    character?: string;
    favoriteNumber?: number;
    watchedEpisodes?: number;
    /** Contexto de seguimiento: activa la cuenta atrás de estreno (≤14 días). */
    followed?: boolean;
    /** Nota personal (1-10) guardada en Firestore; pinta el badge ámbar "★ N". */
    userRating?: number;
}

const { id, name, img, vote_average, overview, first_air_date, seasons, last_episode_to_air, next_episode_to_air, genres, status, character, favoriteNumber, watchedEpisodes, followed, userRating } = Astro.props;

const placeholderImg = "/placeholder.jpg";
const isNew = isRecentRelease(first_air_date);
const isTrending = vote_average >= 8.0;

// "Guardar en…" es una acción de descubrimiento: en catálogo y en recomendaciones
// (sugerencias que aún no tienes). Dentro de "Mis listas" la card ya está guardada → oculto.
const _p = Astro.url.pathname;
const showSaveBtn = !_p.startsWith('/mislistas') || _p.startsWith('/mislistas/recomendaciones');

// Calcular info de temporadas/episodios
const totalSeasons = seasons?.filter((s: any) => s.season_number > 0).length || 0;
const totalEpisodes = seasons?.filter((s: any) => s.season_number > 0).reduce((sum: number, s: any) => sum + (s.episode_count || 0), 0) || 0;
const isMiniSerie = totalSeasons === 1;

// Periodo de emisión
const startYear = first_air_date ? new Date(first_air_date).getFullYear() : null;
const endYear = (status === 'Ended' || status === 'Canceled')
    ? (last_episode_to_air?.air_date ? new Date(last_episode_to_air.air_date).getFullYear() : null)
    : null;
const airPeriod = startYear
    ? (endYear && endYear !== startYear ? `${startYear} - ${endYear}` : endYear === startYear ? `${startYear}` : `${startYear} - Presente`)
    : null;

// Cuenta atrás de estreno (solo en contexto de seguimiento): next_episode_to_air
// ya llega en la prop; si faltan ≤14 días, badge "EN N DÍAS" + overlay PRÓXIMO.
const COUNTDOWN_MAX_DAYS = 14;
let countdownLabel: string | null = null;
let nextEpTag: string | null = null;
if (followed && next_episode_to_air?.air_date) {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const air = new Date(next_episode_to_air.air_date + 'T00:00:00');
    // Math.round absorbe el desfase de ±1h si el rango cruza un cambio DST
    const days = Math.round((air.getTime() - today.getTime()) / 86400000);
    if (days >= 0 && days <= COUNTDOWN_MAX_DAYS) {
        countdownLabel = days === 0 ? '● HOY' : days === 1 ? '● MAÑANA' : `● EN ${days} DÍAS`;
        nextEpTag = `PRÓXIMO · T${next_episode_to_air.season_number}·E${next_episode_to_air.episode_number}`;
    }
}
---
<div class="media-card group">
    <a href={`/serie/${id}`}
       class="flex flex-col rounded-xl overflow-hidden bg-midnight-blue hover:bg-dark-blue transition-all duration-300 h-full border border-white/5 hover:border-white/15 relative">

        <!-- Badges -->
        <div class="absolute top-2 left-2 z-10 flex flex-col gap-1 items-start">
            {countdownLabel ? (
                <span class="top-badge badge-accent font-mono tracking-wide">{countdownLabel}</span>
            ) : (
                isNew && <span class="top-badge bg-teal-500 text-white">NUEVO</span>
            )}
            {isTrending && <span class="top-badge badge-accent">TRENDING</span>}
            {favoriteNumber && (
                <span class="top-badge bg-gradient-to-r from-amber-400 to-orange-500 text-white">
                    #{favoriteNumber}
                </span>
            )}
        </div>

        <!-- Poster -->
        <div class="relative overflow-hidden">
            <img class="w-full aspect-[2/3] object-cover transition-transform duration-500 group-hover:scale-105"
                 src={img || placeholderImg}
                 alt={`Poster de ${name}`}
                 loading="lazy"
                 onerror="this.onerror=null; this.src='/placeholder.jpg'"/>

            <!-- Rating badge (serie: icono TV) -->
            <div class={`rating-badge ${getRatingColor(vote_average)}`}>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                {vote_average ? vote_average.toFixed(1) : "N/A"}
            </div>

            {userRating && <div class="user-rating-badge">★ {userRating}</div>}

            <div class="absolute bottom-0 inset-x-0 h-16 bg-gradient-to-t from-[#0F172A] to-transparent"></div>

            {nextEpTag && (
                <span class="absolute bottom-1.5 left-2.5 z-10 font-mono text-[9.5px] font-bold tracking-wider text-blue-300">{nextEpTag}</span>
            )}

            <!-- Quick-save "Guardar en…" (Fase L4): <span> válido dentro del <a>; el JS para la navegación -->
            {showSaveBtn && (
                <span role="button" tabindex="0"
                      class="card-saveto js-saveto absolute bottom-2 right-2 z-20 w-9 h-9 rounded-full bg-black/60 hover:bg-[#E63946] backdrop-blur text-white inline-flex items-center justify-center opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity cursor-pointer"
                      data-mt="tv" data-id={id} data-title={name} data-poster={img} aria-label="Guardar en tus listas">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                </span>
            )}
        </div>

        <!-- Content -->
        <div class="p-3.5 flex flex-col flex-grow">
            <h2 class="text-sm sm:text-base font-semibold text-white leading-snug mb-1.5 line-clamp-2">{name}</h2>

            {character && (
                <p class="text-xs text-purple-300/70 italic mb-1.5">{character}</p>
            )}

            {genres && genres.length > 0 && (
                <div class="flex flex-wrap gap-1 mb-2">
                    {genres.slice(0, 2).map((genre: any) => (
                        <span class="genre-tag">{genre.name}</span>
                    ))}
                </div>
            )}

            <p class="text-xs text-coral-white leading-relaxed mb-2 flex-grow line-clamp-2 sm:line-clamp-3">{overview}</p>

            <!-- Metadata -->
            <div class="space-y-1 mb-2">
                {airPeriod && (
                    <div class="info-pill">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        {airPeriod}
                    </div>
                )}
                {totalSeasons > 0 && (
                    <div class="info-pill">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                        </svg>
                        {isMiniSerie ? `${totalEpisodes} episodios` : `${totalSeasons} temporadas`}
                    </div>
                )}
                {watchedEpisodes && watchedEpisodes > 0 && totalEpisodes > 0 && (
                    <div class="flex items-center gap-2">
                        <div class="flex-1 bg-white/20 rounded-full h-1">
                            <div class="bg-green-400 h-1 rounded-full" style={`width: ${Math.min(100, Math.round(watchedEpisodes / totalEpisodes * 100))}%`}></div>
                        </div>
                        <span class="text-[10px] text-green-400 font-medium">{watchedEpisodes}/{totalEpisodes}</span>
                    </div>
                )}
            </div>
        </div>
    </a>
</div>
