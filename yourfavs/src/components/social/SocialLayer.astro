---
/**
 * Lo social que necesita cualquier página con sesión (F2+): el diálogo «¿Bloquear a…?», el de
 * «Para pedir amistad, activa tu perfil» (F3, solo si aún no lo tienes activo) y el script que
 * atiende los botones de relación allá donde salgan (`scripts/social/relations.ts`). Desde la F4,
 * también el selector «Recomendar» (`#rk`, `scripts/social/recommend.ts`) y lo que hace quien
 * recibe una recomendación (`scripts/social/recActions.ts`). Desde M1, «Enviar mensaje»
 * (`scripts/social/messages/open.ts`). Desde M4, el selector de tarjetas (`#ck`,
 * `scripts/social/messages/cardPick.ts`): «Compartir un título» y «Enviar a…». Se monta una vez en el Layout, solo con sesión.
 *
 * Diálogo (handoff social F2/F3 §6.5): `<dialog>` nativo, que ya atrapa el foco y se cierra con
 * Esc. Foco inicial en «Cancelar». En móvil se pega abajo. El nombre lo rellena el script.
 */
import { Icon } from 'astro-icon/components';
import { SOCIAL_PHASE } from '../../utils/constants/social';
import { supabaseEnv } from '../../lib/supabase/env';

const user = Astro.locals.user;
// Tiempo real (mensajes M3): el canal es `u:{rt_key}`, un nombre secreto que solo se da a su dueño.
// La clave publishable es pública por diseño (no abre nada con la RLS de la app).
let live = '';
if (SOCIAL_PHASE.messages && user?.rtKey) {
    try {
        const env = supabaseEnv();
        live = JSON.stringify({
            url: `${env.url.replace(/^http/, 'ws').replace(/\/$/, '')}/realtime/v1`,
            key: env.publishableKey,
            topic: `u:${user.rtKey}`,
        }).replace(/</g, '\\u003c');
    } catch { /* sin variables de Supabase: solo sondeo */ }
}
const hasProfile = Boolean(user?.publicHandle && user.publicVisibility && user.publicVisibility !== 'off');
---
{SOCIAL_PHASE.block && (
    <dialog id="so-block-dlg" class="so-dlg" role="alertdialog" aria-labelledby="so-block-t" aria-describedby="so-block-d">
        <span class="so-dlg-st" style="--sb: var(--stamp-red); --si: var(--stamp-red-ink)"><Icon name="lucide:ban" /></span>
        <h3 id="so-block-t">¿Bloquear a <span data-bl-name></span>?</h3>
        <p id="so-block-d">Corta cualquier relación entre vosotros. Puedes deshacerlo más tarde, pero lo que se borra no vuelve solo.</p>
        <div class="so-cons">
            <div><Icon name="lucide:user-minus" /><span>Dejáis de seguiros, <b>en los dos sentidos</b>.</span></div>
            {SOCIAL_PHASE.friends && (
                <div><Icon name="lucide:handshake" /><span>Se borran vuestra amistad y las solicitudes pendientes.</span></div>
            )}
            <div><Icon name="lucide:eye-off" /><span><span data-bl-first></span> <b>no podrá ver tu perfil</b>: le saldrá como no disponible. Tampoco te encontrará al buscar.</span></div>
            <div><Icon name="lucide:mail-x" /><span><b>No le avisamos</b> de nada.</span></div>
        </div>
        <div class="so-dlg-f">
            <button type="button" class="pf-btn" data-bl-cancel>Cancelar</button>
            <button type="button" class="pf-btn dgr" data-bl-confirm><Icon name="lucide:ban" />Bloquear</button>
        </div>
    </dialog>
)}

{SOCIAL_PHASE.friends && !hasProfile && (
    <dialog id="so-noprof-dlg" class="so-dlg" aria-labelledby="so-noprof-t" aria-describedby="so-noprof-d">
        <span class="so-dlg-st" style="--sb: var(--stamp-amber); --si: var(--stamp-amber-ink)"><Icon name="lucide:at-sign" /></span>
        <h3 id="so-noprof-t">Para pedir amistad, activa tu perfil</h3>
        <p id="so-noprof-d"><span data-bl-first></span> tiene que saber quién se lo pide. Solo necesitas elegir tu dirección; lo demás puedes dejarlo para luego.</p>
        <div class="so-dlg-f">
            <button type="button" class="pf-btn ghost" data-np-cancel>Ahora no</button>
            <a class="pf-btn pri" href="/perfil/publico#direccion" data-np-go>Activar mi perfil</a>
        </div>
    </dialog>
)}

{SOCIAL_PHASE.recommend && (
    <>
        <div id="rk-backdrop" class="rk-backdrop" hidden></div>
        <div id="rk" class="rk" role="dialog" aria-modal="true" aria-label="Recomendar" hidden></div>
    </>
)}

{SOCIAL_PHASE.messages && (
    <>
        <div id="ck-bd" class="rk-backdrop" hidden></div>
        <div id="ck" class="rk ck" role="dialog" aria-modal="true" aria-label="Enviar" hidden></div>
    </>
)}

{live && <script type="application/json" id="yf-live" is:inline set:html={live}></script>}

<script>
    import '../../scripts/social/relations';
    import { SOCIAL_PHASE } from '../../utils/constants/social';
    if (SOCIAL_PHASE.recommend) {
        import('../../scripts/social/recommend');
        import('../../scripts/social/recActions');
    }
    if (SOCIAL_PHASE.messages) {
        import('../../scripts/social/messages/open');
        import('../../scripts/social/messages/headerMsgs');
        import('../../scripts/social/live');
        // Tarjetas (M4): «Compartir un título» y «Marcar como spoiler» (＋ del chat) y «Enviar a…»
        // (fichas). El selector se carga al primer clic.
        document.addEventListener('click', (e) => {
            const t = (e.target as Element).closest?.<HTMLElement>('[data-send-to], [data-share-title], [data-spoil-pick]');
            if (!t) return;
            e.preventDefault();
            import('../../scripts/social/messages/cardPick').then((m) => m.openPick(t));
        });
    }
</script>
