{
  "name": "yourfavs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:emu": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 astro dev",
    "emu": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:start --only firestore --import=./.emulator-data --export-on-exit=./.emulator-data",
    "emu:fresh": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:start --only firestore --export-on-exit=./.emulator-data",
    "seed:emu": "node scripts/seed-emulator.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "supabase:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/netlify": "^6.6.4",
    "@astrojs/react": "^4.4.2",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/poppins": "^5.2.5",
    "@iconify-json/lucide": "^1.2.111",
    "@netlify/blobs": "^10.7.4",
    "@supabase/supabase-js": "^2.109.0",
    "@tailwindcss/vite": "^4.1.3",
    "astro": "^5.17.3",
    "astro-icon": "^1.1.5",
    "firebase": "^11.6.0",
    "firebase-admin": "^13.10.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "supabase": "^2.118.0"
  }
}
