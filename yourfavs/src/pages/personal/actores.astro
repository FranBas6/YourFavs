                                stroke-linejoin="round">
                                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                <line x1="8" y1="21" x2="16" y2="21"/>
                                <line x1="12" y1="17" x2="12" y2="21"/>
                                <polygon points="10,8 16,12 10,16"/>
                            </svg>
                            Pronto
                        </span>
                    </a>
                    <a href="/personal/recomendaciones"
                    class="flex-shrink-0 px-4 py-2 rounded-lg transition-all duration-300 font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 hover:scale-105">
                        <span class="flex items-center whitespace-nowrap">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-orange-500" viewBox="0 0 20 20"
                        fill="currentColor">
                        <path
                                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    Recomendadas
                </span>
                    </a>
                    <a href="/personal/actores"
                    class="flex-shrink-0 px-4 py-2 rounded-lg transition-all duration-300 font-medium text-white bg-gradient-to-r from-red-500 to-pink-500 shadow-md transform scale-105">
                        <span class="flex items-center whitespace-nowrap">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" viewBox="0 0 20 20"
                                fill="currentColor">
                                <path fill-rule="evenodd"
                                    d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"
                                    clip-rule="evenodd"/>
                            </svg>
                            Actores
                        </span>
                    </a>
                </div>
            </div>
        </nav>

        <div class="section-header flex items-center gap-4 mb-6">
            <div class="flex-grow h-0.5 bg-gradient-to-r from-red-300 to-red-500"></div>
            <h2 class="text-2xl font-bold text-gray-800 flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 mr-2 text-red-500"
                    viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd"
                        d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"
                        clip-rule="evenodd"/>
                </svg>
                Actores
            </h2>
            <div class="flex-grow h-0.5 bg-gradient-to-r from-red-500 to-red-300"></div>
        </div>

        <!-- Contenedor de actores -->
        <div class="actors-list space-y-4">
            {actors.length === 0 ? (
                <div class="text-center py-12">
                    <p class="text-gray-500 text-lg">No tienes actores favoritos aún.</p>
                    <p class="text-gray-400 text-sm mt-2">Busca actores y añádelos a tu lista.</p>
                </div>
            ) : (
                actors.map((actor, index) => {
                    const actorId = `actor-${actor.id}`;
                    const imageUrl = actor.details.imagen 
                        ? `https://image.tmdb.org/t/p/w185${actor.details.imagen}`
                        : '/placeholder-actor.png';
                    
                    return (
                        <div class="actor-card bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-200">
                            <input type="checkbox" id={actorId} class="actor-toggle hidden" />
                            
                            {/* Header del actor - siempre visible */}
                            <label for={actorId} class="actor-header cursor-pointer flex items-center gap-4 p-4 hover:bg-white/50 transition-colors">
                                <div class="flex-shrink-0">
                                    <img 
                                        src={imageUrl} 
                                        alt={actor.details.nombre}
                                        class="w-16 h-16 rounded-full object-cover border-2 border-red-400 shadow-md"
                                    />
                                </div>
                                
                                <div class="flex-grow">
                                    <h3 class="text-xl font-bold text-gray-800 mb-1">{actor.details.nombre}</h3>
                                    <div class="flex flex-wrap gap-2 items-center text-sm">
                                        {actor.age && (
                                            <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded-full font-medium">
                                                {actor.age} años
                                            </span>
                                        )}
                                        {actor.details.conocidoPor && (
                                            <span class="px-2 py-1 bg-red-100 text-red-700 rounded-full font-medium">
                                                {actor.details.conocidoPor}
                                            </span>
                                        )}
                                        <span class="px-2 py-1 bg-purple-100 text-purple-700 rounded-full font-medium">
                                            🎬 {actor.totalMovies + actor.totalSeries} producciones
                                        </span>
                                        {actor.details.popularidad && (
                                            <span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full font-medium">
                                                ⭐ {actor.details.popularidad.toFixed(1)}
                                            </span>
                                        )}
                                        <span class="ml-auto text-gray-400 text-xs">#{actor.position}</span>
                                    </div>
                                </div>
                                
                                {/* Icono para expandir/contraer */}
                                <div class="flex-shrink-0">
                                    <svg class="chevron-icon w-6 h-6 text-red-500 transition-transform duration-300" 
                                         xmlns="http://www.w3.org/2000/svg" 
                                         fill="none" 
                                         viewBox="0 0 24 24" 
                                         stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </div>
                            </label>
                            
                            {/* Contenido expandible */}
                            <div class="actor-content">
                                <div class="p-4 pt-0 border-t border-gray-200 bg-white/30">
                                    <div class="space-y-6 mt-4">
                                        {/* Películas recientes */}
                                        <div>
                                            <h4 class="font-bold text-gray-700 mb-3 flex items-center gap-2">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-purple-500" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm3 2h6v4H7V5zm8 8v2h1v-2h-1zm-2-2H7v4h6v-4zm2 0h1V9h-1v2zm1-4V5h-1v2h1zM5 5v2H4V5h1zm0 4H4v2h1V9zm-1 4h1v2H4v-2z" clip-rule="evenodd" />
                                                </svg>
                                                Últimas películas
                                            </h4>
                                            {actor.recentMovies.length > 0 ? (
                                                <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-thin scrollbar-thumb-purple-300 scrollbar-track-gray-100">
                                                    {actor.recentMovies.map((movie: any) => {
                                                        const posterUrl = movie.poster_path 
                                                            ? `https://image.tmdb.org/t/p/w185${movie.poster_path}`
                                                            : '/placeholder-movie.png';
                                                        return (
                                                            <a href={`/movie/${movie.id}`} 
                                                               class="movie-card flex-shrink-0 group w-28">
                                                                <div class="relative w-full rounded-lg overflow-hidden shadow-md group-hover:shadow-xl transition-all duration-300 group-hover:scale-105">
                                                                    <img 
                                                                        src={posterUrl} 
                                                                        alt={movie.title}
                                                                        class="w-full h-40 object-cover"
                                                                    />
                                                                    {movie.vote_average > 0 && (
                                                                        <div class="absolute top-1 right-1 bg-black/70 text-yellow-400 text-xs font-bold px-1.5 py-0.5 rounded flex items-center gap-0.5">
                                                                            ⭐ {movie.vote_average.toFixed(1)}
                                                                        </div>
                                                                    )}
                                                                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                                                                </div>
                                                                <div class="mt-2 h-12 overflow-hidden">
                                                                    <p class="text-xs text-gray-700 font-medium line-clamp-2 group-hover:text-purple-600 transition-colors leading-tight">
                                                                        {movie.title}
                                                                    </p>
                                                                </div>
                                                                <p class="text-xs text-gray-400 mt-1">
                                                                    {movie.release_date ? new Date(movie.release_date).getFullYear() : '—'}
                                                                </p>
                                                            </a>
                                                        );
                                                    })}
                                                </div>
                                            ) : (
                                                <p class="text-gray-400 text-sm italic">No hay películas recientes</p>
                                            )}
                                        </div>
                                        
                                        {/* Series recientes */}
                                        <div>
                                            <h4 class="font-bold text-gray-700 mb-3 flex items-center gap-2">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-pink-500" viewBox="0 0 20 20" fill="currentColor">
                                                    <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z" />
                                                </svg>
                                                Últimas series
                                            </h4>
                                            {actor.recentSeries.length > 0 ? (
                                                <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-thin scrollbar-thumb-pink-300 scrollbar-track-gray-100">
                                                    {actor.recentSeries.map((serie: any) => {
                                                        const posterUrl = serie.poster_path 
                                                            ? `https://image.tmdb.org/t/p/w185${serie.poster_path}`
                                                            : '/placeholder-serie.png';
                                                        return (
                                                            <a href={`/serie/${serie.id}`} 
                                                               class="serie-card flex-shrink-0 group w-28">
                                                                <div class="relative w-full rounded-lg overflow-hidden shadow-md group-hover:shadow-xl transition-all duration-300 group-hover:scale-105">
                                                                    <img 
                                                                        src={posterUrl} 
                                                                        alt={serie.name}
                                                                        class="w-full h-40 object-cover"
                                                                    />
                                                                    {serie.vote_average > 0 && (
                                                                        <div class="absolute top-1 right-1 bg-black/70 text-yellow-400 text-xs font-bold px-1.5 py-0.5 rounded flex items-center gap-0.5">
                                                                            ⭐ {serie.vote_average.toFixed(1)}
                                                                        </div>
                                                                    )}
                                                                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                                                                </div>
                                                                <div class="mt-2 h-12 overflow-hidden">
                                                                    <p class="text-xs text-gray-700 font-medium line-clamp-2 group-hover:text-pink-600 transition-colors leading-tight">
                                                                        {serie.name}
                                                                    </p>
                                                                </div>
                                                                <p class="text-xs text-gray-400 mt-1">
                                                                    {serie.first_air_date ? new Date(serie.first_air_date).getFullYear() : '—'}
                                                                </p>
                                                            </a>
                                                        );
                                                    })}
                                                </div>
                                            ) : (
                                                <p class="text-gray-400 text-sm italic">No hay series recientes</p>
                                            )}
                                        </div>
                                    </div>
                                    
                                    {/* Botón para ver perfil completo */}
                                    <div class="mt-4 text-center">
                                        <a href={`/actor/${actor.id}`} 
                                           class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-red-500 to-pink-500 text-white rounded-lg hover:from-red-600 hover:to-pink-600 transition-all shadow-md hover:shadow-lg font-medium">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                                <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
                                                <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
                                            </svg>
                                            Ver perfil completo
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    );
                })
            )}
        </div>
    </div>
</Layout>

<style>
    /* Animaciones */
    .animate-fadeIn {
        animation: fadeIn 0.5s ease-in-out;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Sistema de expansión con checkbox */
    .actor-toggle {
        display: none;
    }

    .actor-content {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s ease-out, opacity 0.3s ease-out;
        opacity: 0;
    }

    .actor-toggle:checked ~ .actor-content {
        max-height: 1000px;
        opacity: 1;
        transition: max-height 0.5s ease-in, opacity 0.4s ease-in;
    }

    /* Rotar el chevron cuando está expandido */
    .actor-toggle:checked ~ .actor-header .chevron-icon {
        transform: rotate(180deg);
    }

    /* Hover effect en las tarjetas */
    .actor-card {
        transition: all 0.3s ease;
    }

    .actor-card:hover {
        transform: translateY(-2px);
    }

    /* Mejora visual de los enlaces */
    .actor-content a {
        transition: all 0.2s ease;
    }

    /* Scrollbar horizontal personalizado */
    .overflow-x-auto {
        scrollbar-width: thin;
        scrollbar-color: #d1d5db #f3f4f6;
    }

    .overflow-x-auto::-webkit-scrollbar {
        height: 6px;
    }

    .overflow-x-auto::-webkit-scrollbar-track {
        background: #f3f4f6;
        border-radius: 10px;
    }

    .overflow-x-auto::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 10px;
    }

    .overflow-x-auto::-webkit-scrollbar-thumb:hover {
        background: #9ca3af;
    }

    /* Efecto hover en tarjetas de películas/series */
    .movie-card, .serie-card {
        transition: transform 0.3s ease;
    }

    /* Line clamp para títulos */
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>