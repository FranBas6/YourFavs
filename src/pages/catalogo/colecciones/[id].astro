---
/**
 * Página de saga /catalogo/colecciones/{id} (rediseño 2026-11-23, C3; handoff
 * docs/Sagas/design_handoff_sagas/ y su README).
 *
 *   Cabecera     fondo de la saga sobre --card, migas, póster, kicker, nombre limpio, descripción (si
 *                hay) y cifras: estrenadas · próximas, nota media y maratón (solo estrenadas), taquilla.
 *   Acciones     rojo «Empezar a ver: {siguiente}» solo con sesión y siguiente; «Seguir saga»;
 *                compartir. («Añadir las que me faltan a Pendientes» llega en el paso siguiente.)
 *   Cuerpo       Tu progreso (barra por película, siguiente, te quedan / la has visto entera; sin sesión,
 *                invitación), La saga en orden (estrenadas numeradas y «Próximamente»), imágenes.
 *   Lateral      Dónde ver la saga (por plataforma), Quién repite y La saga en datos.
 *
 * Datos: `services/titles/sagaDetail.ts` (TMDB, con caché) + lo tuyo (vistas con nivel, notas,
 * pendientes, si la sigues y tus plataformas). Móvil: una columna en el mismo orden.
 */
import Layout from "../../../layouts/Layout.astro";
import Stamp from "../../../components/ui/Stamp.astro";
import SagaBar from "../../../components/title/SagaBar.astro";
import SagaPartRow, { type SagaPartState } from "../../../components/title/SagaPartRow.astro";
import SagaFollowButton from "../../../components/title/SagaFollowButton.astro";
import { getSagaDetail, type SagaProvider } from "../../../services/titles/sagaDetail";
import { getWatchedMovieTiers, type WatchedTier } from "../../../services/movies/movieLibrary";
import { isFollowingCollection } from "../../../services/titles/followedCollections";
import { listRatings } from "../../../services/library/ratings";
import { getLibrarySnapshot } from "../../../services/library/librarySnapshot";
import { runtimeLabel, decimal } from "../../../utils/titles/episodeView";
import { shortDate, titleInitials } from "../../../utils/titles/sagaView";
import '../../../styles/components/saga.css';
import '../../../styles/pages/catalogo/saga.css';

const { id } = Astro.params;
const collectionId = Number(id);
if (!collectionId || Number.isNaN(collectionId)) return Astro.redirect('/catalogo/colecciones');

const saga = await getSagaDetail(collectionId);
if (!saga) return Astro.redirect('/catalogo/colecciones');
const { info, parts } = saga;

// Lo tuyo (sin sesión, todo vacío).
const user = Astro.locals.user;
const [tiers, following, ratings, snap] = await Promise.all([
    user ? getWatchedMovieTiers().catch(() => new Map<number, WatchedTier>()) : Promise.resolve(new Map<number, WatchedTier>()),
    user ? isFollowingCollection(collectionId).catch(() => false) : Promise.resolve(false),
    user ? listRatings().catch(() => []) : Promise.resolve([]),
    user ? getLibrarySnapshot().catch(() => null) : Promise.resolve(null),
]);
const myRating = new Map<number, number>(ratings.filter((r: any) => r.media_type === 'movie').map((r: any) => [Number(r.tmdb_id), Number(r.score)]));
const pendIds = new Set<number>((snap?.movPend ?? []).map((m: any) => Number(m.id)));
const myPlatforms = new Set<number>((user as any)?.platforms ?? []);

// Estado de cada película: la primera estrenada sin ver es «te toca»; el resto sin ver, pendiente o te falta.
const released = parts.filter((p) => p.released);
const upcoming = parts.filter((p) => !p.released);
const next = released.find((p) => !tiers.has(p.id)) ?? null;
const stateOf = (p: (typeof parts)[number]): SagaPartState => {
    if (!p.released) return 'up';
    const t = tiers.get(p.id);
    if (t) return t;
    if (next && p.id === next.id) return 'next';
    return pendIds.has(p.id) ? 'pend' : 'miss';
};
const seen = released.filter((p) => tiers.has(p.id)).length;
const pct = released.length ? Math.round((seen / released.length) * 100) : 0;
const leftMin = released.filter((p) => !tiers.has(p.id)).reduce((a, p) => a + (p.runtime ?? 0), 0);
const favCount = released.filter((p) => tiers.get(p.id) === 'fav').length;
// «Añadir las que me faltan a Pendientes (N)»: estrenadas sin ver que no están ya en Pendientes (las
// próximas no: todavía no se pueden ver). Con 0, el botón no sale; el navegador lo recuenta al
// marcar o desmarcar filas.
const missingCount = released.filter((p) => !tiers.has(p.id) && !pendIds.has(p.id)).length;
const complete = released.length > 0 && seen === released.length;

const summary = upcoming.length
    ? `Has visto ${seen} de ${released.length} estrenada${released.length === 1 ? '' : 's'} · ${upcoming.length} ${upcoming.length === 1 ? 'próxima' : 'próximas'}`
    : `Has visto ${seen} de ${released.length}`;

// Cabecera
const years = saga.firstYear ? (upcoming.length ? `${saga.firstYear}–` : saga.lastYear && saga.lastYear !== saga.firstYear ? `${saga.firstYear}–${saga.lastYear}` : String(saga.firstYear)) : '';
const kicker = ['Saga', `${parts.length} ${parts.length === 1 ? 'película' : 'películas'}`, years].filter(Boolean).join(' · ');
const heroPoster = info.poster_path || parts[0]?.poster_path || null;
const millions = (n: number) => `${String(Math.round(n / 1e6)).replace(/\B(?=(\d{3})+(?!\d))/g, '.')} M$`;
const nextShort = next ? next.title.replace(/^(.{0,40}?):\s+/, '') : '';

// Dónde ver: qué películas («Tren infinito», «Las dos», «Las tres», «Todas»).
const NUM = ['', 'una', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho', 'nueve', 'diez'];
const relIds = new Set(released.map((p) => p.id));
const titleById = new Map(parts.map((p) => [p.id, p.title]));
const which = (pr: SagaProvider) => {
    const ids = pr.parts;
    if (ids.length === parts.length && parts.length > 1) return parts.length <= 3 ? `Las ${NUM[parts.length]}` : 'Todas';
    if (ids.length === 1) return titleById.get(ids[0]) ?? '';
    return `${ids.length} películas`;
};
const coverage = (pr: SagaProvider) => `${pr.parts.filter((x) => relIds.has(x)).length} de ${released.length}`;
const regionName = (() => { try { return new Intl.DisplayNames(['es'], { type: 'region' }).of(saga.region) ?? saga.region; } catch { return saga.region; } })();

// La saga en datos
const lastRel = released[released.length - 1];
const nextUp = upcoming[0] ?? null;
const dataRows: [string, string][] = [];
if (saga.firstDate) dataRows.push(['Primera', shortDate(saga.firstDate)]);
if (lastRel?.release_date && released.length > 1) {
    const es = lastRel.localRelease.cinema ? ` · en ${regionName}, ${shortDate(lastRel.localRelease.cinema)}` : '';
    dataRows.push(['Última estrenada', shortDate(lastRel.release_date) + es]);
}
if (nextUp) dataRows.push(['Próxima', nextUp.release_date ? `${shortDate(nextUp.release_date)}${nextUp.statusLabel ? ` · ${nextUp.statusLabel}` : ''}` : `Sin fecha${nextUp.statusLabel ? ` · ${nextUp.statusLabel}` : ''}`]);
if (saga.marathonMin) dataRows.push(['Maratón', `${runtimeLabel(saga.marathonMin)}${upcoming.length ? ' (estrenadas)' : ''}`]);
if (saga.revenue > 0) dataRows.push(['Taquilla', millions(saga.revenue)]);

const posters = saga.images.posters;
const backdrops = saga.images.backdrops;
// Miniaturas pequeñas en la cuadrícula; el visor abre la imagen en `original`. Fondos y pósters van en
// una sola secuencia (#sg-img-0…) para pasar de una a otra con las flechas.
const thumb = (url: string, size: string) => url.replace(/\/t\/p\/w\d+\//, `/t/p/${size}/`);
const original = (url: string) => thumb(url, 'original');
const gallery = [...backdrops.map((src) => ({ src, kind: 'Fondo' })), ...posters.map((src) => ({ src, kind: 'Póster' }))];
const initialsOf = (name: string) => name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();

const I = {
    film: '<rect x="2" y="2" width="20" height="20" rx="2"/><path d="M7 2v20M17 2v20M2 12h20M2 7h5M2 17h5M17 17h5M17 7h5"/>',
    star: '<path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.2-6.2 3.2L7 14.2 2 9.3l6.9-1z"/>',
    clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
    ticket: '<path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2M13 17v2M13 11v2"/>',
    play: '<path d="m6 3 14 9-14 9z"/>',
    share: '<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/>',
    arr: '<path d="M5 12h14M13 6l6 6-6 6"/>',
    hour: '<path d="M5 22h14M5 2h14M17 22v-4.2a2 2 0 0 0-.6-1.4L12 12l-4.4 4.4a2 2 0 0 0-.6 1.4V22M7 2v4.2a2 2 0 0 0 .6 1.4L12 12l4.4-4.4a2 2 0 0 0 .6-1.4V2"/>',
    chk: '<path d="M20 6 9 17l-5-5"/>',
    users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/>',
    info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>',
    chevL: '<path d="m15 18-6-6 6-6"/>',
    chevR: '<path d="m9 18 6-6-6-6"/>',
};
const svg = (k: keyof typeof I) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${I[k]}</svg>`;
---
<Layout
    title={info.name}
    description={info.overview || `La saga ${info.name}: ${parts.length} películas en orden, dónde verlas y lo que viene.`}
    ogImage={info.backdrop_path || heroPoster || undefined}
>
    <article class="sg-page">
        <header class="sg-hero">
            <div class="bg">{info.backdrop_path && <img src={info.backdrop_path.replace('/w780/', '/w1280/')} alt="" />}</div>
            <p class="crumb"><a href="/catalogo">Descubrir</a> / <a href="/catalogo/colecciones">Sagas</a> / <b>{info.name}</b></p>
            <div class="in">
                <span class="sg-po">
                    <b>{titleInitials(info.name)}</b>
                    {heroPoster && <img src={heroPoster} alt="" />}
                </span>
                <div class="tx">
                    <span class="sg-k">{kicker}</span>
                    <h1>{info.name}</h1>
                    {info.overview && <p class="ds">{info.overview}</p>}
                    <div class="sg-facts">
                        <span><Fragment set:html={svg('film')} />
                            {upcoming.length
                                ? <>{`${released.length} ${released.length === 1 ? 'estrenada' : 'estrenadas'}`}<em>{` · ${upcoming.length} ${upcoming.length === 1 ? 'próxima' : 'próximas'}`}</em></>
                                : <>{`${parts.length} ${parts.length === 1 ? 'película' : 'películas'}`}</>}
                        </span>
                        {saga.avgRating > 0 && <span class="sg-rt"><Fragment set:html={svg('star')} />{decimal(saga.avgRating)} <em>media</em></span>}
                        {saga.marathonMin > 0 && <span><Fragment set:html={svg('clock')} />Maratón {runtimeLabel(saga.marathonMin)}</span>}
                        {saga.revenue > 0 && <span class="box"><Fragment set:html={svg('ticket')} />{millions(saga.revenue)} <em>en taquilla</em></span>}
                    </div>
                </div>
            </div>
            {info.overview && <p class="sg-hdesc">{info.overview}</p>}
        </header>

        <div class="sg-act">
            {user && next && (
                <form method="POST" action={`/movie/${next.id}`} class="wide">
                    <input type="hidden" name="id" value={next.id} />
                    <input type="hidden" name="action" value="add" />
                    <input type="hidden" name="list_type" value="viendo" />
                    <button type="submit" class="btn btn--pri pri">
                        <Fragment set:html={svg('play')} />
                        <span class="lbl-d">Empezar a ver: {nextShort}</span><span class="lbl-m">Empezar a ver la siguiente</span>
                    </button>
                </form>
            )}
            <SagaFollowButton collectionId={collectionId} following={following} name={info.name} />
            {user && released.length > 0 && (
                <button type="button" class="btn wide" data-tone="pend" data-saga-pend-all hidden={missingCount === 0}>
                    <Fragment set:html={svg('clock')} />
                    <span>Añadir las que me faltan a Pendientes (<span data-n>{missingCount}</span>)</span>
                </button>
            )}
            <span class="sp"></span>
            <button type="button" class="btn" data-saga-share data-title={info.name} aria-label="Compartir esta saga" title="Compartir">
                <Fragment set:html={svg('share')} /><span class="lbl-m">Compartir</span>
            </button>
        </div>

        <div class="sg-body">
            <div class="sg-main">
                {user ? (
                    <section class="sg-card sg-pg" aria-labelledby="sg-pg-h">
                        <div class="hd">
                            <Stamp color="amber" icon="layers" size={38} />
                            <div><b id="sg-pg-h">Tu progreso</b><span>{summary}</span></div>
                            {released.length > 0 && <span class="pct">{pct}%</span>}
                        </div>
                        <SagaBar items={parts.map((p) => ({ tier: tiers.get(p.id) ?? null, upcoming: !p.released }))} large />
                        {complete ? (
                            <div class="sg-done">
                                <Fragment set:html={svg('chk')} />
                                <div>La has visto entera<br /><small>{seen} de {released.length}{saga.marathonMin ? ` · ${runtimeLabel(saga.marathonMin)}` : ''}{favCount ? ` · ${favCount === 1 ? 'una favorita' : `${favCount} favoritas`}` : ''}</small></div>
                            </div>
                        ) : next ? (
                            <>
                                <div class="sg-next">
                                    <span class="sg-po"><b>{titleInitials(next.title)}</b>{next.poster_path && <img src={next.poster_path.replace('/w500/', '/w185/')} alt="" />}</span>
                                    <div style="min-width:0">
                                        <span class="sg-k">Siguiente</span>
                                        <b>{next.title}</b>
                                        <small>{[next.release_date?.slice(0, 4), runtimeLabel(next.runtime)].filter(Boolean).join(' · ')}</small>
                                    </div>
                                    <a class="lk" href={`/movie/${next.id}`}><Fragment set:html={svg('arr')} />Ficha</a>
                                </div>
                                {leftMin > 0 && <p class="sg-left" style="margin:0"><Fragment set:html={svg('hour')} />Te quedan <b>{runtimeLabel(leftMin)}</b> para ponerte al día</p>}
                            </>
                        ) : null}
                    </section>
                ) : (
                    <section class="sg-card sg-guest">
                        <Stamp color="amber" icon="layers" size={38} />
                        <div>
                            <b>Lleva la cuenta de esta saga</b>
                            <p>Con una cuenta ves qué te falta y cuánto te queda, y puedes seguirla para enterarte cuando se anuncie la siguiente.</p>
                            <div class="r">
                                <button type="button" class="btn btn--pri" data-auth-open="register">Crear cuenta</button>
                                <button type="button" class="btn" data-auth-open="login">Ya tengo cuenta</button>
                            </div>
                        </div>
                    </section>
                )}

                <section class="sg-sec">
                    <div class="sg-sh"><h2>La saga, en orden</h2><span class="n">por fecha de estreno · {parts.length} {parts.length === 1 ? 'película' : 'películas'}</span></div>
                    <ol class="sg-list">
                        {released.map((p, i) => (
                            <SagaPartRow part={p} position={i + 1} state={stateOf(p)} myRating={myRating.get(p.id) ?? null} guest={!user} inPending={pendIds.has(p.id)} />
                        ))}
                        {upcoming.length > 0 && (
                            <li class="sg-div"><span>Próximamente · {upcoming.length}</span><small>Las que no tienen fecha van al final</small></li>
                        )}
                        {upcoming.map((p) => <SagaPartRow part={p} state="up" guest={!user} />)}
                    </ol>
                </section>

                {(backdrops.length > 0 || posters.length > 0) && (
                    <section class="sg-sec">
                        <div class="sg-sh"><h2>Imágenes de la saga</h2><span class="n">{[posters.length && `${posters.length} ${posters.length === 1 ? 'póster' : 'pósters'}`, backdrops.length && `${backdrops.length} ${backdrops.length === 1 ? 'fondo' : 'fondos'}`].filter(Boolean).join(' · ')}</span></div>
                        {backdrops.length > 0 && (
                            <div class="sg-gal f">
                                {backdrops.map((src, i) => <a href={`#sg-img-${i}`} aria-label={`Fondo ${i + 1} de ${backdrops.length}`}><img src={thumb(src, 'w300')} alt="" loading="lazy" decoding="async" /></a>)}
                            </div>
                        )}
                        {posters.length > 0 && (
                            <div class="sg-gal p">
                                {posters.map((src, i) => <a href={`#sg-img-${backdrops.length + i}`} aria-label={`Póster ${i + 1} de ${posters.length}`}><img src={thumb(src, 'w185')} alt="" loading="lazy" decoding="async" /></a>)}
                            </div>
                        )}
                    </section>
                )}
            </div>

            <aside class="sg-side">
                <section class="sg-card">
                    <h3><Fragment set:html={svg('play')} />Dónde ver la saga<span class="n">{regionName}</span></h3>
                    {saga.providers.subscription.length === 0 && saga.providers.rentBuy.length === 0 ? (
                        <p class="sg-empty">Ahora mismo ninguna está en streaming en {regionName}.</p>
                    ) : (
                        <>
                            {saga.providers.subscription.length > 0 && <span class="sg-pk">Suscripción</span>}
                            {saga.providers.subscription.map((pr) => (
                                <div class="sg-pv">
                                    <span class="lg">{pr.logo ? <img src={pr.logo} alt="" loading="lazy" /> : initialsOf(pr.name)}</span>
                                    <div style="min-width:0"><b>{pr.name}</b><span>{which(pr)}{myPlatforms.has(pr.id) && <> · <span class="sg-mine"><Fragment set:html={svg('chk')} />en las tuyas</span></>}</span></div>
                                    <span class="cov">{coverage(pr)}</span>
                                </div>
                            ))}
                            {saga.providers.rentBuy.length > 0 && <span class="sg-pk">Alquiler y compra</span>}
                            {saga.providers.rentBuy.map((pr) => (
                                <div class="sg-pv">
                                    <span class="lg">{pr.logo ? <img src={pr.logo} alt="" loading="lazy" /> : initialsOf(pr.name)}</span>
                                    <div style="min-width:0"><b>{pr.name}</b><span>{which(pr)}</span></div>
                                    <span class="cov">{coverage(pr)}</span>
                                </div>
                            ))}
                        </>
                    )}
                    <span class="sg-jw">vía JustWatch</span>
                </section>

                {saga.repeats.length > 0 && released.length > 1 && (
                    <section class="sg-card">
                        <h3><Fragment set:html={svg('users')} />Quién repite<span class="n">en 2 o más</span></h3>
                        <div class="sg-ppl">
                            {saga.repeats.map((p) => (
                                <a class="sg-p" href={p.director ? `/team/${encodeURIComponent(p.name)}` : `/actor/${p.id}`}>
                                    <span class="sg-av">{p.profile ? <img src={p.profile} alt="" loading="lazy" /> : initialsOf(p.name)}</span>
                                    <div style="min-width:0"><b>{p.name}</b><span>{p.role}</span></div>
                                    <span class="c">{p.count}<small> de {released.length}</small></span>
                                </a>
                            ))}
                        </div>
                    </section>
                )}

                {dataRows.length > 0 && (
                    <section class="sg-card">
                        <h3><Fragment set:html={svg('info')} />La saga en datos</h3>
                        <dl class="sg-dl">{dataRows.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
                    </section>
                )}
            </aside>
        </div>
    </article>
    {gallery.map((g, i) => (
        <div id={`sg-img-${i}`} class="sg-lb" role="dialog" aria-label={`${g.kind} de ${info.name} (${i + 1} de ${gallery.length})`}>
            <a href="#_" class="x" aria-label="Cerrar" tabindex="-1"></a>
            <img src={original(g.src)} alt={`${g.kind} de ${info.name}`} loading="lazy" decoding="async" />
            <span class="cnt">{i + 1} / {gallery.length}</span>
            <a href="#_" class="c" aria-label="Cerrar">&times;</a>
            {i > 0 && <a href={`#sg-img-${i - 1}`} class="pv" aria-label="Anterior" data-lb-prev><Fragment set:html={svg('chevL')} /></a>}
            {i < gallery.length - 1 && <a href={`#sg-img-${i + 1}`} class="nx" aria-label="Siguiente" data-lb-next><Fragment set:html={svg('chevR')} /></a>}
        </div>
    ))}
    <script>import '../../../scripts/library/sagaPage';</script>
</Layout>
