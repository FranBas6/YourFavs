---
import Layout from "../../layouts/Layout.astro";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import {getMoviesByCategory} from "../../services/API/Movies/tmdbMovies";
import {getSeriesByCategory} from "../../services/API/Series/tmdbSeries";
import {getGenreName} from "../../utils/constants/genres";
import {posterUrl} from "../../services/API/shared/tmdbClient";
import {allCategories} from "../../utils/constants/categories";
import FilterBar from "../../components/FilterBar.astro";
import Pagination from "../../components/Pagination.astro";
import '../../styles/pages/catalogo/shared.css';
import '../../styles/pages/catalogo/card-animations.css';

const url = new URL(Astro.request.url);
const page = Number(url.searchParams.get('page') || 1);
const category = url.searchParams.get('categoria') || 'proximamente';
const type = url.searchParams.get('type') || 'all';

const [latestMovies, latestSeries] = await Promise.all([
    getMoviesByCategory(category, page.toString()),
    getSeriesByCategory(category, page.toString()),
]);

const totalPages = 190;
const activeCategory = allCategories.find(c => c.slug === category);
const categoryLabel = activeCategory?.label || category.replace(/_/g, ' ');
---
<Layout title={`Categoría: ${categoryLabel}`}>
    <section class="px-1 sm:py-8">
        <header class="mb-6">
            <p class="text-sm text-gray-4000 mb-1">Categoría</p>
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900">{categoryLabel}</h1>
        </header>

        <!-- Categorías: desplegable en móvil, pills en desktop -->
        <details class="mb-6 sm:hidden group">
            <summary class="flex items-center justify-between px-4 py-3 bg-white rounded-xl border border-gray-200 shadow-sm cursor-pointer text-sm font-medium text-gray-700">
                Cambiar categoría
                <svg class="w-4 h-4 text-gray-4000 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
            </summary>
            <div class="flex flex-wrap gap-2 mt-2 p-3 bg-white rounded-xl border border-gray-100 shadow-sm">
                {allCategories.map((cat) => (
                    <a href={`?categoria=${cat.slug}&page=1&type=all`}
                       class={`px-3 py-1.5 rounded-full text-sm font-medium transition-all border
                           ${category === cat.slug
                               ? 'bg-red-500 text-white border-red-500'
                               : 'bg-gray-50 text-gray-600 border-gray-200 hover:border-red-300 hover:text-red-600'}`}>
                        {cat.label}
                    </a>
                ))}
            </div>
        </details>
        <div class="hidden sm:flex flex-wrap gap-2 mb-6">
            {allCategories.map((cat) => (
                <a href={`?categoria=${cat.slug}&page=1&type=all`}
                   class={`px-3.5 py-2 rounded-full text-sm font-medium transition-all border
                       ${category === cat.slug
                           ? 'bg-red-500 text-white border-red-500 shadow-sm shadow-red-200'
                           : 'bg-white text-gray-600 border-gray-200 hover:border-red-300 hover:text-red-600 hover:shadow-sm'}`}>
                    {cat.label}
                </a>
            ))}
        </div>

        <FilterBar currentType={type} buildUrl={(t) => `?categoria=${category}&page=1&type=${t}`} />

        <div class="flex items-center justify-between mb-6 text-sm text-gray-500">
            <span>Página <strong class="text-gray-900">{page}</strong> de {totalPages} · <strong class="text-gray-700">{categoryLabel}</strong></span>
            <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 bg-green-400 rounded-full"></span>
                Actualizado hoy
            </div>
        </div>

        <!-- Películas -->
        {(type === 'all' || type === 'movies') && latestMovies.length > 0 && (
            <div class="mb-12" id="peliculas">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-red-500 rounded-full"></span>
                    Películas
                </h2>
                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                    {latestMovies.map((item) => (
                        <div class="card-wrapper group">
                            <CardMovie
                                id={item.id.toString()}
                                img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                title={item.title}
                                vote_average={item.vote_average}
                                overview={item.overview}
                                release_date={item.release_date}
                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                            />
                        </div>
                    ))}
                </div>
            </div>
        )}

        <!-- Series -->
        {(type === 'all' || type === 'series') && latestSeries.length > 0 && (
            <div class="mb-12" id="series">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-blue-500 rounded-full"></span>
                    Series
                </h2>
                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                    {latestSeries.map((item) => (
                        <div class="card-wrapper group">
                            <CardSerie
                                id={item.id.toString()}
                                img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                name={item.name}
                                vote_average={item.vote_average}
                                overview={item.overview}
                                first_air_date={item.first_air_date}
                                seasons={item.seasons}
                                last_episode_to_air={item.last_episode_to_air}
                                next_episode_to_air={item.next_episode_to_air}
                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                            />
                        </div>
                    ))}
                </div>
            </div>
        )}

        {latestMovies.length === 0 && latestSeries.length === 0 && (
            <div class="text-center py-12">
                <h3 class="text-xl font-medium text-gray-700 mb-2">No se encontraron resultados</h3>
                <p class="text-gray-500">Intenta con otra categoría o página</p>
            </div>
        )}

        <Pagination page={page} totalPages={totalPages} buildUrl={(p) => `?categoria=${category}&page=${p}&type=${type}`} />
    </section>
</Layout>
