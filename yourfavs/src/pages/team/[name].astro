---
import Layout from "../../layouts/Layout.astro";
import { getMoviesAndSeriesByMemberName } from "../../services/API/Team/InfoMember";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import {getGenreName} from "../../utils/constants/genres";
import {getMainRole} from "../../utils/constants/helpers/team-helpers";
import '../../styles/pages/team/team.css';

const { name } = Astro.params;
const { searchParams } = Astro.url;
const sortBy = searchParams.get('sort') || 'quality';

if (!name) {
    throw new Error("Nombre del miembro del equipo no encontrado en la URL");
}

const {
    success,
    memberInfo,
    movies,
    series,
    error
} = await getMoviesAndSeriesByMemberName(name, sortBy);

if (!success) {
    throw new Error(error || "Error al obtener información del miembro");
}

const mainRole = memberInfo ? getMainRole(memberInfo.known_for_department, memberInfo.known_for) : "";
const totalWorks = movies.length + series.length;
---
<Layout title={`${name}`}>
    <div class="container mx-auto px-4 py-8">
        <nav class="floating-nav">
            <!-- Botón flecha para móviles -->
            <input type="checkbox" id="nav-toggle2" class="nav-toggle2" />
            <label for="nav-toggle2" class="nav-arrow-btn">
                <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path class="arrow-path" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                <span class="nav-count total-count">{totalWorks}</span>
            </label>
            
            <!-- Menú desplegable horizontal -->
            <div class="nav-menu">
                <a href="#peliculas" class="nav-btn nav-btn-movies">
                    <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                    </svg>
                    <span class="nav-text">Películas</span>
                    <span class="nav-count">{movies.length}</span>
                </a>
                <a href="#series" class="nav-btn nav-btn-series">
                    <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    <span class="nav-text">Series</span>
                    <span class="nav-count">{series.length}</span>
                </a>
            </div>
        </nav>

        <!-- Header del miembro -->
        <div class="bg-gradient-to-r from-blue-900 to-purple-900 rounded-xl p-8 mb-10 text-white shadow-lg">
            <div class="flex flex-col md:flex-row items-center gap-6">
                {memberInfo?.profile_path && (
                <img 
                    src={`https://image.tmdb.org/t/p/w300${memberInfo.profile_path}`} 
                    alt={name}
                    class="w-36 h-36 rounded-full object-cover border-4 border-white/30 shadow-md"
                />
                )}
                <div class="text-center md:text-left">
                <h1 class="text-4xl md:text-5xl font-extrabold bg-clip-text text-transparent bg-gradient-to-r from-yellow-300 to-pink-400 mb-3">
                    {name}
                </h1>
                <p class="text-lg md:text-xl font-medium text-blue-200">{mainRole}</p>
                {memberInfo?.birthday && (
                    <p class="mt-2 text-blue-100 text-sm md:text-base">
                    <span class="font-semibold">Nacimiento:</span> 
                    {new Date(memberInfo.birthday).toLocaleDateString('es-ES', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                    })}
                    {memberInfo.place_of_birth && ` • ${memberInfo.place_of_birth}`}
                    </p>
                )}
                <p class="mt-1 text-blue-100 text-sm md:text-base">
                    <span class="font-semibold">Trabajos encontrados:</span> {totalWorks}
                    ({movies.length} películas, {series.length} series)
                </p>
                </div>
            </div>

                {memberInfo?.biography && (
                    <div class="mt-8 bg-white/10 backdrop-blur-sm p-4 rounded-lg">
                        <h3 class="text-lg font-semibold mb-2">Biografía</h3>

                        <input type="checkbox" id="toggleBio" class="peer hidden" />

                        <p class="text-blue-50 leading-relaxed line-clamp-5 peer-checked:line-clamp-none transition-all">
                        {memberInfo.biography}
                        </p>

                        <label 
                        for="toggleBio" 
                        class="mt-3 inline-block text-sm font-medium text-blue-300 hover:text-blue-200 cursor-pointer"
                        >
                        Mostrar
                        </label>
                    </div>
                )}
            </div>

        <!-- Controles de ordenación -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
            <!-- Título -->
            <h2 class="text-xl sm:text-2xl font-bold text-gray-800 text-center sm:text-left">
                FILMOGRAFÍA ({totalWorks})
            </h2>

            <!-- Botones -->
            <div class="flex flex-wrap justify-center sm:justify-end gap-3">
                <a 
                    href="?sort=quality"
                    class={`px-4 py-2 rounded-full font-medium transition-all ${
                    sortBy === 'quality'
                        ? 'bg-blue-600 text-white shadow-md'
                        : 'bg-gray-200 text-gray-700 hover:bg-gray-300'
                    }`}
                >
                    Mejor Valoradas
                </a>
                <a 
                    href="?sort=popularity"
                    class={`px-4 py-2 rounded-full font-medium transition-all ${
                    sortBy === 'popularity'
                        ? 'bg-blue-600 text-white shadow-md'
                        : 'bg-gray-200 text-gray-700 hover:bg-gray-300'
                    }`}
                >
                    Más Populares
                </a>
                <a 
                    href="?sort=date"
                    class={`px-4 py-2 rounded-full font-medium transition-all ${
                    sortBy === 'date'
                        ? 'bg-blue-600 text-white shadow-md'
                        : 'bg-gray-200 text-gray-700 hover:bg-gray-300'
                    }`}
                >
                    Más Recientes
                </a>
            </div>
        </div>

        <!-- Sección de Películas -->
        <section id="peliculas" class="mb-16 content-section scroll-mt-24">
            <div class="flex items-center gap-3 mb-6">
                <div class="p-3 rounded-full bg-coral-red-alpha text-coral-red">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-gray-800">
                    PELÍCULAS <span class="text-gray-500">({movies.length})</span>
                </h2>
                <div class="flex-grow h-0.5 bg-gradient-to-r from-coral-red/80 to-transparent"></div>
            </div>

            {movies.length === 0 ? (
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                                      d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                            </svg>
                        </div>
                        <h3 class="empty-state-title">No se encontraron películas</h3>
                        <p class="empty-state-description">{name} no tiene películas registradas en nuestra base de
                            datos.</p>
                    </div>
            ) : (
                    <div class="content-grid">
                        {
                            movies.map((item) => (
                                    <div class="card-wrapper">
                                        <CardMovie
                                                id={item.id.toString()}
                                                img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                title={item.title}
                                                vote_average={item.vote_average}
                                                overview={item.overview}
                                                release_date={item.release_date}
                                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                                character={item.character}
                                        />
                                    </div>
                            ))
                        }
                    </div>
            )}
        </section>

        <!-- Sección de Series -->
        <section id="series" class="mb-16 content-section scroll-mt-24">
            <div class="flex items-center gap-3 mb-6">
                <div class="p-3 rounded-full bg-coral-red-alpha text-coral-red">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-gray-800">
                    SERIES <span class="text-gray-500">({series.length})</span>
                </h2>
                <div class="flex-grow h-0.5 bg-gradient-to-r from-coral-red/80 to-transparent"></div>
            </div>

            {series.length === 0 ? (
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                                      d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <h3 class="empty-state-title">No se encontraron series</h3>
                        <p class="empty-state-description">{name} no tiene series registradas en nuestra base de
                            datos.</p>
                    </div>
            ) : (
                    <div class="content-grid">
                        {
                            series.map((item) => (
                                    <div class="card-wrapper">
                                        <CardSerie
                                            id={item.id.toString()}
                                            img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                            name={item.name}
                                            vote_average={item.vote_average}
                                            overview={item.overview}
                                            first_air_date={item.first_air_date}
                                            seasons={item.seasons}
                                            last_episode_to_air={item.last_episode_to_air}
                                            next_episode_to_air={item.next_episode_to_air}
                                            genres={item.genre_ids?.map((id: number) => ({id, name: getGenreName(id)}))}
                                            character={item.character}
                                        />
                                    </div>
                            ))
                        }
                    </div>
            )}
        </section>
    </div>
</Layout>
