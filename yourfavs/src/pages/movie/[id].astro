---
import Layout from "../../layouts/Layout.astro";
import type { CastMember, Provider, ProductionCompany } from "../../types/Media";
import {
    getLanguageDisplayName, getContentRating,
    formatDate, getRatingStars, formatTrailerUrl, providerLinks
} from "../../utils/constants/helpers/media-helpers";
import {formatCurrency} from "../../utils/constants/helpers/movie-helpers";
import {handleMovieFavAction} from "../../services/BD/movies/yourfavsMovie";
import '../../styles/pages/movie/movie.css';
import {
    getMovieById, getMovieCast, getMovieDirectorsAndRoles,
    getMovieTrailer, fetchAllMoviePosters, getMovieCollectionInfo,
    getMovieRecommendationsOrSimilar, getMoviesAdditionalInfo, getMovieVideos
} from "../../services/API/Movies/InfoMovies";
import { posterUrl, backdropUrl, originalUrl, tmdbFetch } from "../../services/API/shared/tmdbClient";
import {initializeApp} from "firebase/app";
import {getFirestore, doc, getDoc} from "firebase/firestore";
import {firebaseConfig} from '../../utils/firebaseConfig';
import { getNotificationSub, addNotificationSub, removeNotificationSub } from "../../services/BD/notifications/yourfavsNotifications";
import NotificationBell from "../../components/personal/NotificationBell.astro";

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

const {id} = Astro.params; // Obtén el parámetro id de la URL

if (!id) {
    throw new Error("ID de la película no encontrado en la URL");
}

if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        const actionType = String(formData.get('actionType') || '');

        if (actionType === 'notification') {
            const action = String(formData.get('action'));
            const tmdbId = String(formData.get('tmdb_id'));
            if (action === 'add') {
                await addNotificationSub('movie', tmdbId);
            } else {
                await removeNotificationSub('movie', tmdbId);
            }
            return Astro.redirect(`/movie/${id}`);
        }

        const redirectUrl = await handleMovieFavAction(formData);
        return Astro.redirect(redirectUrl);
    } catch (error) {
        console.error('Error al gestionar la película:', error);
        return Astro.redirect(`/movie/${id}`);
    }
}

// Obtener datos de la película
let item = null;
let cast: CastMember[] = []; // Cambio aquí: de string[] a CastMember[]
let directors: { name: string; job: string }[] = [];
let trailerUrl: string | null = null;
let title = "Película no encontrada";

if (id) {
    // Todas las llamadas TMDB en paralelo (antes eran secuenciales)
    [item, cast, directors, trailerUrl] = await Promise.all([
        getMovieById({id}),
        getMovieCast(id),
        getMovieDirectorsAndRoles(id),
        getMovieTrailer(id),
    ]);
    if (!item) return Astro.redirect('/404');
    title = item?.title || title;
}

// Datos que se enviarán al cliente
const clientData = {
    id: String(item?.id),
    poster_path: item?.poster_path || '',
    title: item?.title || 'Sin nombre',
    vote_average: item?.vote_average ? Number(item.vote_average) : 0,
    overview: item?.overview || 'Sin descripción',
    genres: item?.genres || [], // Asegurar que siempre sea un array
    release_date: item?.release_date || '',
};

// Verificar existencia en todas las listas incluyendo Ver Pronto
const docRefFavs = doc(db, "MovieFavs", clientData.id);
const docRefPendientes = doc(db, "MoviesPendientes", clientData.id);
const docRefVistas = doc(db, "MoviesVistas", clientData.id);
const docRefVerPronto = doc(db, "MoviesVerPronto", clientData.id);
const docRefLiked = doc(db, "LikedMovies", clientData.id);

const [docSnapFavs, docSnapPendientes, docSnapVistas, docSnapVerPronto, docSnapLiked] = await Promise.all([
    getDoc(docRefFavs),
    getDoc(docRefPendientes),
    getDoc(docRefVistas),
    getDoc(docRefVerPronto),
    getDoc(docRefLiked)
]);

const existingFavs = docSnapFavs.exists();
const existingPendientes = docSnapPendientes.exists();
const existingVistas = docSnapVistas.exists();
const existingVerPronto = docSnapVerPronto.exists();
const existingLiked = docSnapLiked.exists();

// Verificar si la película ya está en cada una de las listas
const isInFavorites = existingFavs;
const isInPendientes = existingPendientes;
const isInVistas = existingVistas;
const isInVerPronto = existingVerPronto;
const isInLiked = existingLiked;

// Verificar suscripción de notificación (solo películas no estrenadas)
const isUnreleased = item?.release_date ? new Date(item.release_date) > new Date() : false;
const notifSub = isUnreleased ? await getNotificationSub('movie', id) : null;
const isNotifSubscribed = !!notifSub;

// Opinión actual desde cualquiera de las colecciones
const opinionFromAny = (
    (existingFavs && docSnapFavs.data()?.opinion) ||
    (existingPendientes && docSnapPendientes.data()?.opinion) ||
    (existingVistas && docSnapVistas.data()?.opinion) ||
    (existingVerPronto && docSnapVerPronto.data()?.opinion) ||
    (existingLiked && docSnapLiked.data()?.opinion) ||
    ''
) as string;

interface ProviderElement {
    name: string;
    logo: string | null;
    link: string | undefined;
    type: string;
}

const providerElements: ProviderElement[] = item?.providers?.map((provider: Provider) => {
    const link = providerLinks[provider.provider_name];
    const hasLogo = !!provider.logo_path;
    return {
        name: provider.provider_name,
        logo: hasLogo ? posterUrl(provider.logo_path, 'w200') : null,
        link,
        type: provider.type || 'flatrate'
    };
}) || [];

// Agrupar por tipo
const providersByType = providerElements.reduce((acc: Record<string, ProviderElement[]>, p) => {
    const key = p.type || 'flatrate';
    if (!acc[key]) acc[key] = [];
    acc[key].push(p);
    return acc;
}, {} as Record<string, ProviderElement[]>);

import type {PosterImage} from '../../services/API/Movies/InfoMovies';

// Segundo bloque de datos (dependen de item pero no entre sí) — todo en paralelo
const tmdbId = item?.id;

const [
    allPosters,
    collectionInfo,
    moviesRecommendationsData,
    externalIds,
    additionalInfo,
    allVideos,
    reviewsData,
] = await Promise.all([
    id ? fetchAllMoviePosters(id).catch(() => []) : Promise.resolve([]),
    item?.belongs_to_collection ? getMovieCollectionInfo(item.belongs_to_collection.id).catch(() => null) : Promise.resolve(null),
    tmdbId ? getMovieRecommendationsOrSimilar(tmdbId) : Promise.resolve({ success: false, recommendations: [], type: 'recommendations' as const }),
    tmdbId ? tmdbFetch<any>(`/movie/${tmdbId}/external_ids`).catch(() => ({})) : Promise.resolve({}),
    tmdbId ? getMoviesAdditionalInfo(tmdbId) : Promise.resolve({ keywords: [], networks: [], content_ratings: [], episode_run_time: [], languages: [], tagline: null, budget: null, revenue: null }),
    id ? getMovieVideos(id) : Promise.resolve([]),
    tmdbId ? tmdbFetch<{ results: any[] }>(`/movie/${tmdbId}/reviews`).catch(() => ({ results: [] })) : Promise.resolve({ results: [] }),
]);

const posters: PosterImage[] = allPosters.slice(0, 40);
const moviesRecommendations = moviesRecommendationsData.success ? moviesRecommendationsData.recommendations : [];
const moviesRecommendationType = moviesRecommendationsData.type || 'recommendations';
const imdbId = externalIds.imdb_id;
const movieSocialLinks = {
    facebook: externalIds.facebook_id ? `https://facebook.com/${externalIds.facebook_id}` : null,
    instagram: externalIds.instagram_id ? `https://instagram.com/${externalIds.instagram_id}` : null,
    twitter: externalIds.twitter_id ? `https://twitter.com/${externalIds.twitter_id}` : null,
};
const hasSocialLinks = Object.values(movieSocialLinks).some(v => v);
const movieKeywords: { id: number; name: string }[] = additionalInfo.keywords || [];
const movieLanguages: { iso_639_1: string; name: string }[] = additionalInfo.languages || [];
const movieStatus = item?.status && item.status !== 'Released' ? item.status : null;

// Reviews de TMDB (top 5 con contenido)
const reviews = (reviewsData.results || [])
    .filter((r: any) => r.content && r.content.length > 50)
    .slice(0, 5);

// Países de producción
const productionCountries = item?.production_countries || [];

// Año en contexto
const releaseYear = item?.release_date ? new Date(item.release_date).getFullYear() : null;
const yearsAgo = releaseYear ? new Date().getFullYear() - releaseYear : null;

// Nota comparativa: percentil respecto a recomendaciones + similares
const allRelated = moviesRecommendations.filter((m: any) => m.vote_average > 0);
const betterThanCount = allRelated.filter((m: any) => item?.vote_average > m.vote_average).length;
const ratingPercentile = allRelated.length >= 5 ? Math.round((betterThanCount / allRelated.length) * 100) : null;
const mainGenre = item?.genres?.[0]?.name || null;

// Categorizar videos
const trailers = allVideos.filter((v: any) => v.type === 'Trailer');
const clips = allVideos.filter((v: any) => v.type === 'Clip');
const behindScenes = allVideos.filter((v: any) => v.type === 'Behind the Scenes' || v.type === 'Bloopers' || v.type === 'Featurette');
const teasers = allVideos.filter((v: any) => v.type === 'Teaser');

// JSON-LD structured data (schema.org Movie)
const jsonLd = item ? {
    "@context": "https://schema.org",
    "@type": "Movie",
    "name": item.title,
    ...(item.poster_path && { image: item.poster_path }),
    ...(item.release_date && { datePublished: item.release_date }),
    ...(item.overview && { description: item.overview }),
    ...(item.genres?.length && { genre: item.genres.map((g: any) => g.name) }),
    ...(directors?.find((d: any) => d.job === 'Director') && {
        director: { "@type": "Person", name: directors.find((d: any) => d.job === 'Director')!.name }
    }),
    ...(item.vote_count > 0 && {
        aggregateRating: {
            "@type": "AggregateRating",
            ratingValue: item.vote_average,
            bestRating: 10,
            ratingCount: item.vote_count,
        }
    }),
} : null;
---
<Layout
    title={`${title}`}
    description={item?.overview || undefined}
    ogImage={item?.poster_path || item?.backdrop_path || undefined}
    ogType="video.movie"
>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <article class="bg-gray-50">
        <!-- Hero inmersivo -->
        <div class="relative w-full min-h-[70vh] bg-cover bg-center bg-no-repeat" style={`background-image: url(${item?.backdrop_path ? originalUrl(item.backdrop_path) : '/assets/background.svg'})`}>
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/70 to-gray-900/40"></div>

            <div class="relative z-10 max-w-6xl mx-auto px-4 pt-8 pb-16 flex flex-col justify-end min-h-[70vh]">
                <nav class="absolute top-6 left-4 right-4" aria-label="Breadcrumb">
                    <ol class="flex items-center space-x-2 text-sm">
                        <li><a href="/" class="text-white/70 hover:text-white transition-colors">Inicio</a></li>
                        <li class="text-white/40">/</li>
                        <li><a href="/catalogo/topmovies" class="text-white/70 hover:text-white transition-colors">Películas</a></li>
                        <li class="text-white/40">/</li>
                        <li class="text-white/90 font-medium truncate max-w-xs">{item?.title}</li>
                    </ol>
                </nav>

                <div class="flex flex-col md:flex-row items-end gap-8">
                    <div class="hidden md:block flex-shrink-0 w-56 rounded-xl overflow-hidden shadow-2xl ring-1 ring-white/10">
                        <img src={posterUrl(item?.poster_path)} alt={item?.title} class="w-full aspect-[2/3] object-cover" />
                    </div>
                    <div class="flex-1 text-white">
                        <h1 class="text-4xl md:text-5xl font-bold mb-3 leading-tight">{item?.title}</h1>
                        {additionalInfo.tagline && (
                            <p class="text-white/60 italic text-lg mb-4">"{additionalInfo.tagline}"</p>
                        )}
                        <div class="flex flex-wrap items-center gap-3 mb-4">
                            <span class="text-yellow-400 text-lg font-bold">{item?.vote_average?.toFixed(1)} {getRatingStars(item?.vote_average)}</span>
                            <span class="text-white/70">{formatDate(item?.release_date)}</span>
                            {item?.runtime && <span class="text-white/70">{Math.floor(item.runtime / 60)}h {item.runtime % 60}min</span>}
                            {item?.hasSpanishTranslation && (
                                <span title="Disponible en español"><svg viewBox="0 0 750 500" class="w-8 h-5 rounded"><rect width="750" height="500" fill="#AA151B"/><rect width="750" height="250" y="125" fill="#F1BF00"/></svg></span>
                            )}
                        </div>
                        {item?.genres && (
                            <div class="flex flex-wrap gap-2 mb-5">
                                {item.genres.map((genre: { id: number; name: string }) => (
                                    <span class="px-3 py-1 bg-white/10 backdrop-blur-sm text-white text-xs rounded-full border border-white/20">{genre.name}</span>
                                ))}
                            </div>
                        )}
                        {item?.overview && (
                            <details class="max-w-2xl group">
                                <summary class="cursor-pointer">
                                    <p class="text-white/80 text-sm md:text-base leading-relaxed line-clamp-3 group-open:line-clamp-none">{item.overview}</p>
                                    <span class="inline-block mt-1 text-xs text-white/50 group-open:hidden">Pulsa para leer más</span>
                                </summary>
                            </details>
                        )}
                    </div>
                </div>
            </div>
        </div>

        <!-- Action bar (debajo del hero, no sticky) -->
        <div class="bg-white border-b border-gray-200 shadow-sm">
            <!-- Desktop: fila horizontal -->
            <div class="hidden md:flex max-w-6xl mx-auto px-4 py-2 items-center gap-2">
                <form method="POST">
                    <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInFavorites ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="favorites"/>
                    <button type="submit" class={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap ${isInFavorites ? 'bg-red-500 text-white' : 'border border-red-200 text-red-600 hover:bg-red-50'}`}>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
                        {isInFavorites ? 'En Favoritos' : 'Favoritos'}
                    </button>
                </form>
                <form method="POST">
                    <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInVerPronto ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="verPronto"/>
                    <button type="submit" class={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap ${isInVerPronto ? 'bg-purple-500 text-white' : 'border border-purple-200 text-purple-600 hover:bg-purple-50'}`}>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="10"/></svg>
                        {isInVerPronto ? 'En Ver Pronto' : 'Ver Pronto'}
                    </button>
                </form>
                <form method="POST">
                    <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInPendientes ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="pendientes"/>
                    <button type="submit" class={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap ${isInPendientes ? 'bg-amber-500 text-white' : 'border border-amber-200 text-amber-600 hover:bg-amber-50'}`}>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
                        {isInPendientes ? 'Pendiente' : 'Pendiente'}
                    </button>
                </form>
                <form method="POST">
                    <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInVistas ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="vistas"/>
                    <button type="submit" class={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap ${isInVistas ? 'bg-green-500 text-white' : 'border border-green-200 text-green-600 hover:bg-green-50'}`}>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                        {isInVistas ? 'Vista' : 'Vista'}
                    </button>
                </form>
                <div class="ml-auto flex items-center gap-2">
                    {isUnreleased && <NotificationBell mediaType="movie" tmdbId={id} isSubscribed={isNotifSubscribed} />}
                    <form method="POST">
                        <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInLiked ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="liked"/>
                        <button type="submit" class={`p-1.5 rounded-full transition-colors ${isInLiked ? 'text-red-500' : 'text-gray-4000 hover:text-red-400'}`}>
                            <svg class="w-5 h-5" viewBox="0 0 20 20" fill={isInLiked ? "currentColor" : "none"} stroke="currentColor" stroke-width={isInLiked ? "0" : "1.5"}><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
                        </button>
                    </form>
                    {imdbId && (
                        <a href={`https://www.imdb.com/title/${imdbId}`} target="_blank" rel="noopener" class="px-2.5 py-1 text-xs font-bold bg-yellow-400 text-gray-900 rounded hover:bg-yellow-300 transition-colors">IMDb</a>
                    )}
                    {(item?.homepage || trailerUrl) && (
                        <a href={item?.homepage || trailerUrl} target="_blank" rel="noopener" class="px-3 py-1.5 text-xs font-medium bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors">Ver ahora</a>
                    )}
                </div>
            </div>
            <!-- Mobile: grid 2x2 + links -->
            <div class="md:hidden max-w-6xl mx-auto px-4 py-3 space-y-2">
                <div class="grid grid-cols-2 gap-2">
                    <form method="POST">
                        <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInFavorites ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="favorites"/>
                        <button type="submit" class={`w-full min-h-[44px] px-3 py-2.5 text-xs font-medium rounded-lg transition-colors flex items-center justify-center gap-1.5 ${isInFavorites ? 'bg-red-500 text-white' : 'border border-red-200 text-red-600'}`}>
                            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
                            {isInFavorites ? 'En Favoritos' : 'Favoritos'}
                        </button>
                    </form>
                    <form method="POST">
                        <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInVerPronto ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="verPronto"/>
                        <button type="submit" class={`w-full min-h-[44px] px-3 py-2.5 text-xs font-medium rounded-lg transition-colors flex items-center justify-center gap-1.5 ${isInVerPronto ? 'bg-purple-500 text-white' : 'border border-purple-200 text-purple-600'}`}>
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="10"/></svg>
                            {isInVerPronto ? 'Ver Pronto' : 'Ver Pronto'}
                        </button>
                    </form>
                    <form method="POST">
                        <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInPendientes ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="pendientes"/>
                        <button type="submit" class={`w-full min-h-[44px] px-3 py-2.5 text-xs font-medium rounded-lg transition-colors flex items-center justify-center gap-1.5 ${isInPendientes ? 'bg-amber-500 text-white' : 'border border-amber-200 text-amber-600'}`}>
                            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
                            {isInPendientes ? 'Pendiente' : 'Pendiente'}
                        </button>
                    </form>
                    <form method="POST">
                        <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInVistas ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="vistas"/>
                        <button type="submit" class={`w-full min-h-[44px] px-3 py-2.5 text-xs font-medium rounded-lg transition-colors flex items-center justify-center gap-1.5 ${isInVistas ? 'bg-green-500 text-white' : 'border border-green-200 text-green-600'}`}>
                            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                            {isInVistas ? 'Vista' : 'Vista'}
                        </button>
                    </form>
                </div>
                <div class="flex gap-2">
                    {isUnreleased && <NotificationBell mediaType="movie" tmdbId={id} isSubscribed={isNotifSubscribed} />}
                    <form method="POST" class="flex-1">
                        <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInLiked ? 'remove' : 'add'}/><input type="hidden" name="list_type" value="liked"/>
                        <button type="submit" class={`w-full min-h-[44px] px-3 py-2 text-xs font-medium rounded-lg transition-colors flex items-center justify-center gap-1.5 ${isInLiked ? 'bg-red-50 text-red-500 border border-red-200' : 'border border-gray-200 text-gray-500'}`}>
                            <svg class="w-4 h-4" viewBox="0 0 20 20" fill={isInLiked ? "currentColor" : "none"} stroke="currentColor" stroke-width={isInLiked ? "0" : "1.5"}><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
                            {isInLiked ? 'Me gusta' : 'Me gusta'}
                        </button>
                    </form>
                    {imdbId && (
                        <a href={`https://www.imdb.com/title/${imdbId}`} target="_blank" rel="noopener" class="min-h-[44px] px-4 py-2 text-xs font-bold bg-yellow-400 text-gray-900 rounded-lg hover:bg-yellow-300 transition-colors flex items-center">IMDb</a>
                    )}
                    {(item?.homepage || trailerUrl) && (
