---
/**
 * Portada sin sesión (rediseño, Fase 7 · 7.1; handoff P2). Bienvenida (qué es, «Crear cuenta» como único
 * rojo, mosaico de pósters de Tendencias), tres razones con piezas de la app hechas con tokens (no
 * capturas: siguen el modo oscuro y no envejecen), el contenido del slot (Tendencias) y la banda de Importar.
 *
 * Con `SIGNUP_MODE=invite` no se promete «Crear cuenta»: el principal es «Entrar» y una línea explica
 * que el registro va por invitación.
 */
import { signupMode } from '../../lib/social/signupMode';
import { posterUrl, backdropUrl } from '../../services/API/shared/tmdbClient';
import '../../styles/pages/welcome.css';

interface Item { id: number | string; title?: string; name?: string; poster_path?: string | null; backdrop_path?: string | null; first_air_date?: string }
interface Props { movies: Item[]; series: Item[] }
const { movies = [], series = [] } = Astro.props;

const open = signupMode() === 'open';
// Mosaico: 8 pósters de Tendencias, alternando películas y series.
const mosaic: Item[] = [];
for (let i = 0; mosaic.length < 8 && i < 20; i++) {
    for (const src of [movies, series]) if (src[i]?.poster_path && mosaic.length < 8) mosaic.push(src[i]);
}
const s1 = series.find((s) => s.backdrop_path && s.poster_path) ?? null;
const s3 = series.find((s) => s !== s1 && s.poster_path) ?? null;
const icon = {
    film: '<rect x="2" y="2" width="20" height="20" rx="2.18"/><path d="M7 2v20M17 2v20M2 12h20M2 7h5M2 17h5M17 17h5M17 7h5"/>',
    play: '<polygon points="6 3 20 12 6 21 6 3"/>',
    tv: '<rect x="2" y="7" width="20" height="15" rx="2"/><path d="m17 2-5 5-5-5"/>',
    clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
    check: '<path d="M20 6 9 17l-5-5"/>',
    eyeoff: '<path d="M9.88 9.88a3 3 0 1 0 4.24 4.24M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68M6.61 6.61A13.53 13.53 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61M2 2l20 20"/>',
    arrow: '<path d="M5 12h14M12 5l7 7-7 7"/>',
};
const svg = (k: keyof typeof icon) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icon[k]}</svg>`;
const STATS: [string, keyof typeof icon, string, string][] = [['visto', 'film', '24', 'películas'], ['ep', 'play', '2.121', 'episodios'], ['seguir', 'tv', '8', 'series'], ['rating', 'clock', '1.489 h', 'de pantalla']];
---
<section class="wel" aria-labelledby="wel-h">
    <div class="wel-tx">
        <span class="wel-k">Tus películas y series, en orden</span>
        <h1 id="wel-h">Lleva todo lo que ves, episodio a episodio</h1>
        <p>Apunta lo que has visto, lo que tienes a medias y lo que quieres ver. YourFavs sabe qué episodio toca, dónde verlo en tu país y qué se estrena este mes.</p>
        <div class="wel-cta">
            {open
                ? <><button type="button" class="btn btn--pri" data-auth-open="register">Crear cuenta</button><button type="button" class="btn" data-auth-open="login">Ya tengo cuenta</button></>
                : <button type="button" class="btn btn--pri" data-auth-open="login">Entrar</button>}
        </div>
        {!open && <p class="wel-note">Por ahora se entra por invitación: abre el enlace del perfil de quien te invite.</p>}
    </div>
    {mosaic.length >= 4 && (
        <div class="wel-mos" aria-hidden="true">
            {mosaic.map((m) => <span><img src={posterUrl(m.poster_path!, 'w342')} alt="" /></span>)}
        </div>
    )}
</section>

<section class="wel-why" aria-label="Qué puedes hacer">
    <article>
        <div class="wel-shot">
            {s1 ? (
                <div class="ws-ev">
                    <div class="f"><img src={backdropUrl(s1.backdrop_path!, 'w780')} alt="" loading="lazy" /><span>T1 · E8</span></div>
                    <div class="b">
                        <img class="po" src={posterUrl(s1.poster_path!, 'w92')} alt="" loading="lazy" />
                        <div class="tt"><b>{s1.name}</b><span>Siguiente episodio</span></div>
                        <div class="pr"><i><b style="width:70%"></b></i><span>7 de 10</span></div>
                        <div class="ac"><span class="mk" set:html={svg('check') + 'Marcar visto'} /><span class="go" set:html={svg('arrow')} /></div>
                    </div>
                </div>
            ) : null}
        </div>
        <div class="wel-why-tx"><h2>Episodio a episodio</h2><p>Marca lo que ves y YourFavs te dice cuál toca, cuándo sale el siguiente y dónde verlo.</p></div>
    </article>
    <article>
        <div class="wel-shot">
            <div class="ws-yr">
                <span class="wel-k">Tu {new Date().getFullYear()}</span>
                <div class="g">
                    {STATS.map(([c, i, v, l]) => (
                        <div style={`--c: var(--a-${c})`}><b><Fragment set:html={svg(i)} />{v}</b><span>{l}</span></div>
                    ))}
                </div>
            </div>
        </div>
        <div class="wel-why-tx"><h2>Tu año en cifras</h2><p>Películas, series, episodios y horas de cada año, mes a mes, y desde siempre.</p></div>
    </article>
    <article>
        <div class="wel-shot">
            <div class="ws-msg">
                <div class="m">
                    <span class="av">L</span>
                    <div>
                        <div class="n">Lucía <span>te recomienda</span></div>
                        {s3 && <div class="tc"><img src={posterUrl(s3.poster_path!, 'w92')} alt="" loading="lazy" /><div><b>{s3.name}</b><em>Serie{s3.first_air_date ? ` · ${s3.first_air_date.slice(0, 4)}` : ''}</em></div></div>}
                    </div>
                </div>
                <div class="m">
                    <span class="av av--b">P</span>
                    <div><div class="n">Pepe</div><div class="sp"><Fragment set:html={svg('eyeoff')} />Spoiler de T2·E10 · Mostrar</div></div>
                </div>
            </div>
        </div>
        <div class="wel-why-tx"><h2>Con tus amigos, sin spoilers</h2><p>Recomienda, habla de lo que veis y oculta lo que aún no han visto.</p></div>
    </article>
</section>

<slot />

<section class="wel-band">
    <div><b>Empieza con tu biblioteca</b><p>Importa desde IMDb, Letterboxd o TMDB y revisa lo dudoso antes de guardar.</p></div>
    {open
        ? <button type="button" class="btn btn--pri" data-auth-open="register">Crear cuenta</button>
        : <button type="button" class="btn" data-auth-open="login">Entrar</button>}
</section>
