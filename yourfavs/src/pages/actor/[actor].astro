---
import Layout from "../../layouts/Layout.astro";
import {
    getSeriesByActorId,
    getMoviesByActorId,
    getActorDetailsById,
    fetchActorImages
} from "../../services/API/Actors/InfoActor";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";

const {actor} = Astro.params;

if (!actor) {
    throw new Error("ID de la película no encontrado en la URL");
}

const series = await getSeriesByActorId({id: actor});
const movies = await getMoviesByActorId({id: actor});

// Obtener detalles del actor
const actorDetails = await getActorDetailsById({id: actor});

// Si no se pueden obtener los detalles, usar un placeholder
const actorInfo = actorDetails || {
    id: null,
    nombre: actor,
    biografia: "Información biográfica del actor no disponible.",
    lugarNacimiento: null,
    fechaNacimiento: null,
    imagen: "/placeholder-actor.jpg", // Asegúrate de tener una imagen predeterminada
    popularidad: null,
    conocidoPor: "Actuación",
    redes: {
        imdb: null,
        twitter: null,
        instagram: null,
        facebook: null,
        tiktok: null,
        youtube: null,
    }
};

// Definir los géneros comunes
const genresMap: Record<number, string> = {
    // Géneros de películas y series
    28: "Acción",
    12: "Aventura",
    16: "Animación",
    35: "Comedia",
    80: "Crimen",
    99: "Documental",
    18: "Drama",
    10751: "Familia",
    14: "Fantasía",
    36: "Historia",
    27: "Terror",
    10402: "Música",
    9648: "Misterio",
    10749: "Romance",
    878: "Ciencia ficción",
    10770: "Película de TV",
    53: "Thriller",
    10752: "Bélica",
    37: "Western",
    // Géneros exclusivos de series
    10759: "Acción y Aventura",
    10762: "Infantil",
    10763: "Noticias",
    10764: "Reality",
    10765: "Sci-Fi y Fantasía",
    10766: "Soap",
    10767: "Talk",
    10768: "Guerra y Política"
};

// Función para obtener el nombre del género según su ID
function getGenreName(id: number): string {
    return genresMap[id] || "Otro";
}

// Calcular estadísticas del actor
const totalMovies = movies.length;
const totalSeries = series.length;
const totalProductions = totalMovies + totalSeries;
const movieGenres: Record<number, number> = movies.flatMap(m => m.genre_ids || [])
    .reduce((acc: Record<number, number>, genreId: number) => {
        acc[genreId] = (acc[genreId] || 0) + 1;
        return acc;
    }, {});

// Encontrar los géneros más frecuentes
const topGenres = Object.entries(movieGenres)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 3)
    .map(([genreId, _count]) => genresMap[parseInt(genreId)]);

import type {ActorImage} from "../../services/API/Actors/InfoActor";

let posters: ActorImage[] = [];

if (actor) {
    try {
        // Obtener 15 retratos del actor
        const profileImages = await fetchActorImages(actor);
        const portraits = profileImages.slice(0, 25);

        // Unir ambos
        posters = [...portraits];
    } catch (error) {
        console.error('Error al obtener imágenes del actor:', error);
    }
}
---
<Layout title={`${actorInfo.nombre}`}>
    <div class="actor-profile-bg"></div>
    <section class="container mx-auto px-4 py-8 relative">
        <!-- Perfil del Actor -->
        <div class="actor-profile mb-7">
            <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
                <div class="profile-image-container">
                    {actorInfo.imagen ? (
                            <img
                                    src={`https://image.tmdb.org/t/p/w500${actorInfo.imagen}`}
                                    alt={`Foto de ${actorInfo.nombre}`}
                                    class="profile-image"
                            />
                    ) : (
                            <div class="profile-image-placeholder">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24" viewBox="0 0 20 20"
                                     fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"
                                          clip-rule="evenodd"/>
                                </svg>
                            </div>
                    )}

                    {actorInfo.popularidad && (
                            <div class="popularity-badge">
                                <div class="popularity-inner">
                                    <span class="popularity-value">{actorInfo.popularidad.toFixed(1)}</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20"
                                         fill="currentColor">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.8-2.034c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                    </svg>
                                </div>
                            </div>
                    )}
                </div>

                <div class="flex-1">
                    <h1 class="text-coral-red font-extrabold text-4xl md:text-5xl lg:text-6xl mb-4">
                        {actorInfo.nombre}
                    </h1>
                    <div class="w-24 h-1 bg-coral-red rounded-full mb-6"></div>

                    <div class="actor-stats flex flex-wrap gap-4 mb-4">
                        <a href="#peliculas" class="stat-box" style="text-decoration: none;">
                            <span class="stat-value">{totalProductions}</span>
                            <span class="stat-label">Producciones</span>
                        </a>
                        <a href="#peliculas" class="stat-box" style="text-decoration: none;">
                            <span class="stat-value">{totalMovies}</span>
                            <span class="stat-label">Películas</span>
                        </a>
                        <a href="#series" class="stat-box" style="text-decoration: none;">
                            <span class="stat-value">{totalSeries}</span>
                            <span class="stat-label">Series</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="mt-8">
                {actorInfo.biografia && (
                        <div class="actor-bio mb-6">
                            <h2 class="section-subtitle">Biografía</h2>
                            <input type="checkbox" id="read-more-toggle" class="bio-toggle hidden"/>
                            <p class="text-gray-600 dark:text-gray-300 bio-text">
                                {actorInfo.biografia || "Información biográfica no disponible."}
                            </p>
                            <label for="read-more-toggle" class="read-more-btn"></label>
                        </div>
                )}

                <!-- Redes Sociales del Actor -->
                {actorInfo.redes && typeof actorInfo.redes === 'object' && Object.values(actorInfo.redes).some(red => red !== null) && (
                        <div class="actor-social-links mb-8">
                            <h2 class="section-subtitle mb-4">Redes Sociales</h2>
                            <div class="flex flex-wrap gap-3">
                                {actorInfo.redes?.imdb && (
                                        <a
                                                href={actorInfo.redes?.imdb}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="social-link imdb"
                                                aria-label={`Ver perfil de ${actorInfo.nombre} en IMDb`}
                                        >
                                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M22.395 0H1.605C.72 0 0 .72 0 1.605v20.79C0 23.28.72 24 1.605 24h20.79C23.28 24 24 23.28 24 22.395V1.605C24 .72 23.28 0 22.395 0zM8.25 18.75H5.625V5.25H8.25v13.5zm7.125-9.375c-.563 0-1.125.375-1.125 1.125v8.25h-2.625V9.375c0-1.688 1.313-3 3-3s3 1.313 3 3v9.375H15V10.5c0-.75-.563-1.125-1.125-1.125z"/>
                                            </svg>
                                            <span>IMDb</span>
                                        </a>
                                )}

                                {actorInfo.redes?.instagram && (
                                        <a
                                                href={actorInfo.redes?.instagram}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="social-link instagram"
                                                aria-label={`Ver perfil de ${actorInfo.nombre} en Instagram`}
                                        >
                                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                            </svg>
                                            <span>Instagram</span>
                                        </a>
                                )}

                                {actorInfo.redes?.twitter && (
                                        <a
                                                href={actorInfo.redes?.twitter}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="social-link twitter"
                                                aria-label={`Ver perfil de ${actorInfo.nombre} en Twitter`}
                                        >
                                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                                            </svg>
                                            <span>Twitter</span>
                                        </a>
                                )}

                                {actorInfo.redes?.facebook && (
                                        <a
                                                href={actorInfo.redes?.facebook}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="social-link facebook"
                                                aria-label={`Ver perfil de ${actorInfo.nombre} en Facebook`}
                                        >
                                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                            </svg>
                                            <span>Facebook</span>
                                        </a>
                                )}

                                {actorInfo.redes?.tiktok && (
                                        <a
                                                href={actorInfo.redes?.tiktok}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="social-link tiktok"
                                                aria-label={`Ver perfil de ${actorInfo.nombre} en TikTok`}
                                        >
                                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                                            </svg>
                                            <span>TikTok</span>
                                        </a>
                                )}

                                {actorInfo.redes?.youtube && (
                                        <a
                                                href={actorInfo.redes?.youtube}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="social-link youtube"
                                                aria-label={`Ver canal de ${actorInfo.nombre} en YouTube`}
                                        >
                                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                                            </svg>
                                            <span>YouTube</span>
                                        </a>
                                )}
                            </div>
                        </div>
                )}

                <div class="actor-metadata grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
                    {actorInfo.fechaNacimiento && (
                            <div class="metadata-item">
                                <div class="metadata-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                                         viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                </div>
                                <div>
                                    <span class="metadata-label">Fecha de nacimiento</span>
                                    <span class="metadata-value">{actorInfo.fechaNacimiento}</span>
                                </div>
                            </div>
                    )}
                    {actorInfo.lugarNacimiento && (
                            <div class="metadata-item">
                                <div class="metadata-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                                         viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    </svg>
                                </div>
                                <div>
                                    <span class="metadata-label">Lugar de nacimiento</span>
                                    <span class="metadata-value">{actorInfo.lugarNacimiento}</span>
                                </div>
                            </div>
                    )}
                    {actorInfo.conocidoPor && (
                            <div class="metadata-item">
                                <div class="metadata-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                                         viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                                    </svg>
                                </div>
                                <div>
                                    <span class="metadata-label">Conocido por</span>
                                    <span class="metadata-value">{actorInfo.conocidoPor}</span>
                                </div>
                            </div>
                    )}
                    {topGenres.length > 0 && (
                            <div class="metadata-item col-span-1 md:col-span-2">
                                <div class="metadata-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                                         viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                                    </svg>
                                </div>
                                <div class="w-full">
                                    <span class="metadata-label block mb-2">Géneros más frecuentes</span>
                                    <div class="flex flex-wrap gap-2">
                                        {topGenres.map(genre => (
                                                <span class="genre-badge">{genre}</span>
                                        ))}
                                    </div>
                                </div>
                            </div>
                    )}
                </div>
            </div>
        </div>

        <!-- Pósters -->
        <div class="bg-gradient-to-br from-gray-100/80 to-white/50 dark:from-gray-800 dark:to-gray-900 p-6 rounded-2xl shadow-xl mb-8 border border-gray-200 dark:border-gray-700">
            <h2 class="text-2xl font-bold text-coral-red mb-4">Pósters</h2>

            {posters && posters.length > 0 ? (
                    <div class="carousel-container relative max-w-full overflow-hidden">
                        <div class="carousel-track flex gap-4 overflow-x-auto pb-4 scrollbar-hide">
                            {posters.slice(0, 25).map((poster, index) => (
                                    <div class="carousel-slide flex-shrink-0 w-48">
                                        <a href={`#poster-${index}`}>
                                            <img
                                                    src={poster.file_path}
                                                    alt={`Póster ${poster.vote_average.toFixed(1)}/10`}
                                                    loading="lazy"
                                                    class="rounded-lg shadow-md w-full h-64 object-cover"/>
                                        </a>

                                        {/* Modal de imagen */}
                                        <div id={`poster-${index}`} class="modal">
                                            <a href="#" class="modal-close">&times;</a>
                                            <img
                                                    src={poster.file_path}
                                                    alt={`Póster ${poster.vote_average.toFixed(1)}/10`}
                                            />
                                        </div>
                                    </div>
                            ))}
                        </div>
                    </div>
            ) : (
                    <div class="text-center py-6">
                        <p class="text-gray-600 dark:text-gray-300">No se encontraron pósters para este actor</p>
                    </div>
            )}
        </div>

        <!-- Sección de Películas -->
        <section id="peliculas" class="mb-16 content-section scroll-mt-24">
            <div class="section-header-container">
                <h2 class="section-title">
                    <span class="section-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                        </svg>
                    </span>
                    PELÍCULAS
                    <span class="section-count">({movies.length})</span>
                </h2>
                <div class="section-header-line"></div>
            </div>

            {movies.length === 0 ? (
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                                      d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                            </svg>
                        </div>
                        <h3 class="empty-state-title">No se encontraron películas</h3>
                        <p class="empty-state-description">Este actor no tiene películas registradas en nuestra base de
                            datos.</p>
                    </div>
            ) : (
                    <div class="content-grid">
                        {
                            movies.map((item) => (
                                    <div class="card-wrapper">
                                        <CardMovie
                                                id={item.id.toString()}
                                                img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                title={item.title}
                                                vote_average={item.vote_average}
                                                overview={item.overview}
                                                release_date={item.release_date}
                                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                                character={item.character}
                                        />
                                    </div>
                            ))
                        }
                    </div>
            )}
        </section>

        <!-- Sección de Series -->
        <section id="series" class="mb-16 content-section scroll-mt-24">
            <div class="section-header-container">
                <h2 class="section-title">
                    <span class="section-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </span>
                    SERIES
                    <span class="section-count">({series.length})</span>
                </h2>
                <div class="section-header-line"></div>
            </div>

            {series.length === 0 ? (
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                                      d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <h3 class="empty-state-title">No se encontraron series</h3>
                        <p class="empty-state-description">Este actor no tiene series registradas en nuestra base de
                            datos.</p>
                    </div>
            ) : (
                    <div class="content-grid">
                        {
                            series.map((item) => (
                                    <div class="card-wrapper">
                                        <CardSerie
                                                id={item.id.toString()}
                                                img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                name={item.name}
                                                vote_average={item.vote_average}
                                                overview={item.overview}
                                                first_air_date={item.first_air_date}
                                                seasons={item.seasons}
                                                last_episode_to_air={item.last_episode_to_air}
                                                next_episode_to_air={item.next_episode_to_air}
                                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                                character={item.character}
                                        />
                                    </div>
                            ))
                        }
                    </div>
            )}
        </section>

    </section>
</Layout>

<style is:global>
    /* Variables y colores base */
    :root {
