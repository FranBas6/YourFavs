---
import Layout from "../../../layouts/Layout.astro";
import CardMovie from "../../../components/Cards/CardMovie.astro";
import { getMovieCollectionInfo } from "../../../services/API/Movies/InfoMovies";
import { getGenreName } from "../../../utils/constants/genres";
import EmptyState from "../../../components/EmptyState.astro";
import '../../../styles/pages/catalogo/shared.css';

const { id } = Astro.params;
const collectionId = Number(id);
if (!collectionId || Number.isNaN(collectionId)) return Astro.redirect('/catalogo/colecciones');

const collection = await getMovieCollectionInfo(collectionId);
if (!collection) return Astro.redirect('/catalogo/colecciones');

// Ordenar películas cronológicamente (las sin fecha van al final)
const partsSorted = [...collection.parts].sort((a, b) => {
    if (!a.release_date) return 1;
    if (!b.release_date) return -1;
    return new Date(a.release_date).getTime() - new Date(b.release_date).getTime();
});

const validYears = partsSorted.map(p => p.release_date ? new Date(p.release_date).getFullYear() : null).filter(Boolean) as number[];
const firstYear = validYears[0];
const lastYear = validYears[validYears.length - 1];

const avgRating = partsSorted.length > 0
    ? Number((partsSorted.reduce((a, p) => a + (p.vote_average || 0), 0) / partsSorted.length).toFixed(1))
    : 0;
---
<Layout
    title={collection.name}
    description={collection.overview || `Todas las películas de la saga ${collection.name}`}
    ogImage={collection.backdrop_path || collection.poster_path || undefined}
>
    <section class="px-1 sm:py-8">
        <!-- Hero -->
        <div class="relative rounded-2xl overflow-hidden mb-8 shadow-lg">
            <div class="aspect-[21/9] md:aspect-[21/7] bg-gray-900 relative">
                {collection.backdrop_path ? (
                    <img src={collection.backdrop_path} alt={collection.name} class="w-full h-full object-cover"/>
                ) : collection.poster_path ? (
                    <img src={collection.poster_path} alt={collection.name} class="w-full h-full object-cover object-top blur-sm scale-110"/>
                ) : null}
                <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/20"></div>
                <div class="absolute inset-0 p-6 md:p-10 flex flex-col justify-end">
                    <nav class="mb-3">
                        <a href="/catalogo/colecciones" class="text-xs md:text-sm text-white/80 hover:text-white inline-flex items-center gap-1.5">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                            Todas las sagas
                        </a>
                    </nav>
                    <h1 class="text-2xl md:text-5xl font-bold text-white drop-shadow-md mb-2">{collection.name}</h1>
                    <div class="flex flex-wrap items-center gap-2 md:gap-3 text-xs md:text-sm">
                        <span class="bg-red-500 text-white px-2.5 py-1 rounded-full font-semibold">
                            {partsSorted.length} {partsSorted.length === 1 ? 'película' : 'películas'}
                        </span>
                        {firstYear && lastYear && (
                            <span class="bg-white/20 backdrop-blur-sm text-white px-2.5 py-1 rounded-full">
                                {firstYear === lastYear ? firstYear : `${firstYear}–${lastYear}`}
                            </span>
                        )}
                        {avgRating > 0 && (
                            <span class="bg-yellow-500/90 text-white px-2.5 py-1 rounded-full font-medium inline-flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                {avgRating}
                            </span>
                        )}
                    </div>
                </div>
            </div>
        </div>

        <!-- Descripción -->
        {collection.overview && (
            <div class="mb-8 max-w-3xl">
                <p class="text-gray-600 text-sm md:text-base leading-relaxed">{collection.overview}</p>
            </div>
        )}

        <!-- Grid cronológico -->
        <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
            <span class="w-1 h-6 bg-red-500 rounded-full"></span>
            Películas en orden cronológico
        </h2>

        {partsSorted.length === 0 ? (
            <EmptyState
                size="sm"
                title="Esta colección no tiene películas registradas"
            />
        ) : (
            <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
                {partsSorted.map(part => (
                    <div class="card-wrapper group relative">
                        <CardMovie
                            id={part.id.toString()}
                            img={part.poster_path || "/placeholder.jpg"}
                            title={part.title}
                            vote_average={part.vote_average || 0}
                            overview={part.overview || ''}
                            release_date={part.release_date || ''}
                            genres={part.genre_ids?.map(gId => ({ id: gId, name: getGenreName(gId) }))}
                        />
                    </div>
                ))}
            </div>
        )}
    </section>
</Layout>
