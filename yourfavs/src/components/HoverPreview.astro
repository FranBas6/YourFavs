---
import { backdropUrl } from "../services/API/shared/tmdbClient";

interface Props {
    tmdbId: number | string;
    tmdbType: 'movie' | 'tv';
    title: string;
    backdropPath?: string | null;
    href?: string;
    year?: string | number | null;
    rating?: number | null;
}

const { tmdbId, tmdbType, title, backdropPath = null, href = '', year = null, rating = null } = Astro.props;
const backdrop = backdropPath ? backdropUrl(backdropPath) : '';
---
<div
    class="hover-preview-host"
    data-tmdb-id={String(tmdbId)}
    data-tmdb-type={tmdbType}
    data-title={title}
    data-backdrop={backdrop}
    data-href={href}
    data-year={year ? String(year) : ''}
    data-rating={rating ? rating.toFixed(1) : ''}
>
    <slot />
</div>

<style is:global>
    .hover-preview-host {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        position: relative;
    }
    .hover-preview-host > *:not(.hover-preview-overlay) {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
    }

    /* Solo desktop con hover real */
    @media (hover: hover) and (min-width: 1024px) {
        .hover-preview-overlay {
            position: fixed;
            background: #0a0a0a;
            border-radius: 12px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
            overflow: hidden;
            z-index: 9000;
            opacity: 0;
            transform-origin: left top;
            transform: scale(0.85);
            pointer-events: auto;
            cursor: pointer;
        }
        .hover-preview-overlay[data-anchor="right"]        { transform-origin: right top; }
        .hover-preview-overlay[data-anchor="left-bottom"]  { transform-origin: left bottom; }
        .hover-preview-overlay[data-anchor="right-bottom"] { transform-origin: right bottom; }

        .hover-preview-overlay.is-visible                          { animation: hp-grow-in        520ms cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .hover-preview-overlay[data-anchor="right"].is-visible        { animation: hp-grow-in-right  520ms cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .hover-preview-overlay[data-anchor="left-bottom"].is-visible  { animation: hp-grow-in-left-bottom  520ms cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .hover-preview-overlay[data-anchor="right-bottom"].is-visible { animation: hp-grow-in-right-bottom 520ms cubic-bezier(0.16, 1, 0.3, 1) forwards; }

        @keyframes hp-grow-in {
            0%   { opacity: 0;    transform: scale(0.85);  transform-origin: left top; }
            40%  { opacity: 0.85; transform: scale(1.45);  transform-origin: left top; }
            100% { opacity: 1;    transform: scale(2);     transform-origin: left top; }
        }
        @keyframes hp-grow-in-right {
            0%   { opacity: 0;    transform: scale(0.85);  transform-origin: right top; }
            40%  { opacity: 0.85; transform: scale(1.45);  transform-origin: right top; }
            100% { opacity: 1;    transform: scale(2);     transform-origin: right top; }
        }
        @keyframes hp-grow-in-left-bottom {
            0%   { opacity: 0;    transform: scale(0.85);  transform-origin: left bottom; }
            40%  { opacity: 0.85; transform: scale(1.45);  transform-origin: left bottom; }
            100% { opacity: 1;    transform: scale(2);     transform-origin: left bottom; }
        }
        @keyframes hp-grow-in-right-bottom {
            0%   { opacity: 0;    transform: scale(0.85);  transform-origin: right bottom; }
            40%  { opacity: 0.85; transform: scale(1.45);  transform-origin: right bottom; }
            100% { opacity: 1;    transform: scale(2);     transform-origin: right bottom; }
        }
        /* El iframe no recibe ratón: oculta los controles de YouTube y deja que el click navegue */
        .hover-preview-media iframe { pointer-events: none; }
        .hover-preview-media {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            background: #000;
            overflow: hidden;
        }
        .hover-preview-media iframe,
        .hover-preview-media img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            border: 0;
        }
        /* Mask negro inicial mientras carga el iframe (tapa controles de autoplay de YouTube) */
        .hover-preview-media .hp-loading-mask {
            position: absolute;
            inset: 0;
            background: #0a0a0a;
            z-index: 3;
            opacity: 1;
            transition: opacity 500ms ease;
            pointer-events: none;
        }
        .hover-preview-media .hp-loading-mask.is-hidden { opacity: 0; }
        .hover-preview-info {
            padding: 8px 10px;
            color: #fff;
            background: linear-gradient(0deg, rgba(0,0,0,0.92), rgba(0,0,0,0.55));
            font-size: 11px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }
        .hover-preview-info .hp-titlewrap {
            min-width: 0;
            flex: 1;
        }
        .hover-preview-info .hp-title {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-weight: 600;
            font-size: 12px;
            line-height: 1.25;
        }
        .hover-preview-info .hp-meta {
            display: flex;
            gap: 8px;
            margin-top: 2px;
            font-size: 10px;
            color: rgba(255,255,255,0.75);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .hover-preview-info .hp-rating { color: #fcd34d; }
        .hover-preview-mute {
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.3);
            color: #fff;
            border-radius: 9999px;
            width: 24px;
            height: 24px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            flex-shrink: 0;
        }
        .hover-preview-mute:hover { background: rgba(255,255,255,0.3); }

        /* Ocultar badges del card original durante el preview, solo dentro del host */
        .hover-preview-host.is-previewing > :not(.hover-preview-overlay) [data-card-badge] {
            opacity: 0;
            transition: opacity 150ms;
        }
    }

    /* Respetar prefers-reduced-motion: sin scale, solo fade */
    @media (prefers-reduced-motion: reduce) {
        .hover-preview-overlay.is-visible,
        .hover-preview-overlay[data-anchor="right"].is-visible {
            animation: none !important;
            opacity: 1 !important;
            transform: scale(1.4) !important;
            transition: opacity 200ms ease;
        }
    }
</style>
