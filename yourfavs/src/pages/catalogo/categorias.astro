---
import Layout from "../../layouts/Layout.astro";
import CatalogHeader from "../../components/CatalogHeader.astro";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import {getMoviesByCategory} from "../../services/API/Movies/tmdbMovies";
import {getSeriesByCategory} from "../../services/API/Series/tmdbSeries";
import {parseAdvancedFilters, hasActiveFilters, buildDiscoverFilterParams, sortByFor} from "../../services/API/shared/tmdbDiscoverService";
import {tmdbFetchList} from "../../services/API/shared/tmdbClient";
import {MOVIE_GENRE_SLUGS, SERIE_GENRE_SLUGS} from "../../utils/constants/genreSlugs";
import {getGenreName} from "../../utils/constants/genres";
import {posterUrl} from "../../services/API/shared/tmdbClient";
import {allCategories} from "../../utils/constants/categories";
import CatalogModes from "../../components/CatalogModes.astro";
import { catalogUrls, resolveCatalogMode } from "../../utils/catalogUrl";
import AdvancedFilters from "../../components/AdvancedFilters.astro";
import Pagination from "../../components/Pagination.astro";
import EmptyState from "../../components/EmptyState.astro";
import HoverPreview from "../../components/HoverPreview.astro";
import type {Movie} from "../../types/ApiMovie";
import type {Serie} from "../../types/ApiSerie";
import {safeFetch} from "../../utils/safeFetch";
import '../../styles/pages/catalogo/shared.css';
import '../../styles/pages/catalogo/card-animations.css';
import { resolveMineFilter } from "../../utils/platformFilter";

const url = new URL(Astro.request.url);
const urlParams = url.searchParams;
const page = Number(urlParams.get('page') || 1);
const pageStr = page.toString();
const category = urlParams.get('categoria') || 'proximamente';
const type = resolveCatalogMode(urlParams, Astro.locals.catalogMode);

const filters = parseAdvancedFilters(urlParams);
const filtersActive = hasActiveFilters(filters);
// "Solo en mis plataformas" (3.2b).
// Filtro por plataformas: la URL manda (`mine=0|1`); sin parámetro decide el perfil
// («Filtrar siempre por mis plataformas»). Ver utils/platformFilter.ts.
const { mine, mineDefault } = resolveMineFilter(urlParams, Astro.locals.user);
const myProviders = (mine && Astro.locals.user?.platforms?.length) ? Astro.locals.user.platforms.join('|') : '';
const myRegion = Astro.locals.user?.region || 'ES';
const useDiscover = filtersActive || !!filters.sort || !!myProviders;
// Las categorías especiales (Próximamente, En emisión…) usan endpoints propios
// que NO admiten orden → ahí ocultamos el selector y el indicador de orden.
const supportsSort = typeof MOVIE_GENRE_SLUGS[category] === 'number' || typeof SERIE_GENRE_SLUGS[category] === 'number';

// Contexto para el contador en vivo del sheet (2.3b): por tipo visible y solo si el
// slug tiene género numérico (los especiales no filtran vía discover → sin contador).
const _movieG = MOVIE_GENRE_SLUGS[category];
const _serieG = SERIE_GENRE_SLUGS[category];
const countCtx = [
    ...(typeof _movieG === 'number' && (type === 'all' || type === 'movies') ? [{ type: 'movie' as const, base: { with_genres: String(_movieG), 'vote_count.gte': '100' } }] : []),
    ...(typeof _serieG === 'number' && (type === 'all' || type === 'series') ? [{ type: 'tv' as const, base: { with_genres: String(_serieG), 'vote_count.gte': '100' } }] : []),
];

// Cuando hay filtros avanzados, construimos /discover directo combinando
// with_genres del slug + params de filtros. Si el slug es "upcoming"/"on_the_air",
// esos endpoints no aceptan filtros, así que caemos a discover por género (18 Drama
// como fallback si no hay genre numérico).
async function fetchMoviesWithFilters(): Promise<Movie[]> {
    const g = MOVIE_GENRE_SLUGS[category];
    if (typeof g !== 'number') return getMoviesByCategory(category, pageStr);
    const params: Record<string, string> = {
        page: pageStr,
        sort_by: sortByFor(filters.sort, 'movie') || 'popularity.desc',
        'vote_count.gte': '100',
        with_genres: g.toString(),
        ...buildDiscoverFilterParams(filters, 'movie'),
    };
    if (myProviders) { params.with_watch_providers = myProviders; params.watch_region = myRegion; }
    return tmdbFetchList<Movie>('/discover/movie', params);
}

async function fetchSeriesWithFilters(): Promise<Serie[]> {
    const g = SERIE_GENRE_SLUGS[category];
    if (typeof g !== 'number') return getSeriesByCategory(category, pageStr);
    const params: Record<string, string> = {
        page: pageStr,
        sort_by: sortByFor(filters.sort, 'tv') || 'popularity.desc',
        'vote_count.gte': '100',
        with_genres: g.toString(),
        ...buildDiscoverFilterParams(filters, 'tv'),
    };
    if (myProviders) { params.with_watch_providers = myProviders; params.watch_region = myRegion; }
    return tmdbFetchList<Serie>('/discover/tv', params);
}

const [latestMovies, latestSeries] = useDiscover
    ? await Promise.all([
        safeFetch(fetchMoviesWithFilters(), 'categorias/moviesFiltered', [] as Movie[]),
        safeFetch(fetchSeriesWithFilters(), 'categorias/seriesFiltered', [] as Serie[]),
    ])
    : await Promise.all([
        safeFetch(getMoviesByCategory(category, pageStr), 'categorias/movies', [] as Movie[]),
        safeFetch(getSeriesByCategory(category, pageStr), 'categorias/series', [] as Serie[]),
    ]);

const totalPages = 190;
const activeCategory = allCategories.find(c => c.slug === category);
const categoryLabel = activeCategory?.label || category.replace(/_/g, ' ');

const { buildFilterUrl, buildTypeUrl } = catalogUrls(urlParams);

function buildCategoryUrl(slug: string) {
    const p = new URLSearchParams(urlParams);
    p.set('categoria', slug);
    p.set('page', '1');
    return `?${p.toString()}`;
}
---
<Layout title={`Categoría: ${categoryLabel}`}>
    <section class="px-1 sm:py-8">
        <CatalogHeader
            kicker="Categoría"
            title={categoryLabel}
            color="purple"
            icon="layers"
        >
            <CatalogModes slot="nav" current={type} buildUrl={buildTypeUrl} />
        </CatalogHeader>

        <!-- Categorías: desplegable en móvil, pills en desktop -->
        <details class="mb-6 sm:hidden group">
            <summary class="flex items-center justify-between px-4 py-3 bg-white rounded-xl border border-gray-200 shadow-sm cursor-pointer text-sm font-medium text-gray-700">
                Cambiar categoría
                <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
            </summary>
            <div class="flex flex-wrap gap-2 mt-2 p-3 bg-white rounded-xl border border-gray-100 shadow-sm">
                {allCategories.map((cat) => (
                    <a href={buildCategoryUrl(cat.slug)}
                       class={`px-3 py-1.5 rounded-full text-[13px] font-medium transition-all border
                           ${category === cat.slug
                               ? 'bg-[#E63946] text-white border-[#E63946]'
                               : 'bg-gray-50 text-gray-600 border-gray-200 hover:border-gray-400 hover:text-gray-900'}`}>
                        {cat.label}
                    </a>
                ))}
            </div>
        </details>
        <div class="hidden sm:flex flex-wrap gap-1.5 mb-6">
            {allCategories.map((cat) => (
                <a href={buildCategoryUrl(cat.slug)}
                   class={`px-3 py-1.5 rounded-full text-[13px] font-medium transition-all border
                       ${category === cat.slug
                           ? 'bg-[#E63946] text-white border-[#E63946] shadow-sm'
                           : 'bg-white text-gray-600 border-gray-200 hover:border-gray-400 hover:text-gray-900'}`}>
                    {cat.label}
                </a>
            ))}
        </div>

        <AdvancedFilters filters={filters} buildUrl={buildFilterUrl} showRuntime={type === 'movies'} showStatus={type === 'series'}
                         showCert={type === 'movies'} order={supportsSort ? 'Popularidad' : undefined} countCtx={countCtx}
                         mine={mine} mineDefault={mineDefault} myPlatforms={supportsSort ? (Astro.locals.user?.platforms ?? []) : []} region={myRegion}
                         sortOptions={supportsSort ? [{ value: 'popular', label: 'Popularidad' }, { value: 'rating', label: 'Mejor valoradas' }, { value: 'recent', label: 'Más recientes' }] : []} />

        <div class="flex items-center justify-between mb-6 text-sm text-gray-500">
            <span>Página <strong class="text-gray-900">{page}</strong> de {totalPages} · <strong class="text-gray-700">{categoryLabel}</strong></span>
            <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 bg-green-400 rounded-full"></span>
                Actualizado hoy
            </div>
        </div>

        <!-- Películas -->
        {(type === 'all' || type === 'movies') && latestMovies.length > 0 && (
            <div class="mb-12" id="peliculas">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-red-500 rounded-full"></span>
                    Películas
                </h2>
                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                    {latestMovies.map((item) => (
                        <div class="card-wrapper group">
                            <HoverPreview tmdbId={item.id} tmdbType="movie" title={item.title} backdropPath={item.backdrop_path} href={`/movie/${item.id}`} year={item.release_date?.slice(0,4)} rating={item.vote_average}><CardMovie
                                id={item.id.toString()}
                                img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                title={item.title}
                                vote_average={item.vote_average}
                                overview={item.overview}
                                release_date={item.release_date}
                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                            /></HoverPreview>
                        </div>
                    ))}
                </div>
            </div>
        )}

        <!-- Series -->
        {(type === 'all' || type === 'series') && latestSeries.length > 0 && (
            <div class="mb-12" id="series">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-blue-500 rounded-full"></span>
                    Series
                </h2>
                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                    {latestSeries.map((item) => (
                        <div class="card-wrapper group">
                            <HoverPreview tmdbId={item.id} tmdbType="tv" title={item.name} backdropPath={item.backdrop_path} href={`/serie/${item.id}`} year={item.first_air_date?.slice(0,4)} rating={item.vote_average}><CardSerie
                                id={item.id.toString()}
                                img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                name={item.name}
                                vote_average={item.vote_average}
                                overview={item.overview}
                                first_air_date={item.first_air_date}
                                seasons={item.seasons}
                                last_episode_to_air={item.last_episode_to_air}
                                next_episode_to_air={item.next_episode_to_air}
                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                            /></HoverPreview>
                        </div>
                    ))}
                </div>
            </div>
        )}

        {latestMovies.length === 0 && latestSeries.length === 0 && (
            <EmptyState
                variant="filter"
                title="No se encontraron resultados"
                description="Intenta con otra categoría o ajusta los filtros."
            />
        )}

        <Pagination page={page} totalPages={totalPages} buildUrl={(p) => {
            const q = new URLSearchParams(urlParams);
            q.set('page', String(p));
            return `?${q.toString()}`;
        }} />
    </section>
</Layout>
