---
type Variant = 'search' | 'empty' | 'error' | 'filter';

interface Props {
  title: string;
  description?: string;
  variant?: Variant;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { title, description, variant = 'empty', size = 'md' as const, class: className = '' } = Astro.props as Required<Pick<Props, 'size'>> & Props;

const sizeMap: Record<NonNullable<Props['size']>, { wrap: string; circle: string; icon: string; title: string; desc: string }> = {
  sm: { wrap: 'py-8',  circle: 'w-14 h-14', icon: 'w-7 h-7',   title: 'text-base', desc: 'text-sm' },
  md: { wrap: 'py-12', circle: 'w-20 h-20', icon: 'w-10 h-10', title: 'text-xl',   desc: 'text-sm' },
  lg: { wrap: 'py-16', circle: 'w-24 h-24', icon: 'w-12 h-12', title: 'text-2xl',  desc: 'text-base' },
};
const s = sizeMap[size];

const hasCta = Astro.slots.has('cta');
---

<div class={`text-center ${s.wrap} ${className}`} role="status">
  <div class={`${s.circle} mx-auto mb-4 rounded-full flex items-center justify-center`} style="background: var(--accent-soft);">
    <svg
      class={s.icon}
      style="color: var(--accent);"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      aria-hidden="true"
    >
      {variant === 'search' && (
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      )}
      {variant === 'empty' && (
        <path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
      )}
      {variant === 'filter' && (
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
      )}
      {variant === 'error' && (
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      )}
    </svg>
  </div>

  <h3 class={`${s.title} font-bold text-gray-800 mb-2`}>{title}</h3>
  {description && (
    <p class={`${s.desc} text-gray-500 max-w-md mx-auto ${hasCta ? 'mb-6' : ''}`}>{description}</p>
  )}

  {hasCta && (
    <div class="flex flex-wrap items-center justify-center gap-3">
      <slot name="cta" />
    </div>
  )}
</div>
