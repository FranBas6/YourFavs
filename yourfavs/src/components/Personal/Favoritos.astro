---
import CardMovie from "../Cards/CardMovie.astro";
import CardSerie from "../Cards/CardSerie.astro";
import {
    getSerieFav,
} from "../../services/BD/yourfavsSerie";
import {getMovieFav} from "../../services/BD/yourfavsMovie";
import {fetchMovieDetails} from "../../services/API/Movies/tmdbMovies";
import {fetchSerieDetails} from "../../services/API/Series/tmdbSeries";

// 🔹 Obtener IDs desde Firebase
const seriesFavortiasIds = (await getSerieFav()).map(s => s.id);
const peliculasFavoritasIds = (await getMovieFav()).map(p => p.id);

// 🔹 Obtener detalles desde TMDB
const seriesFavoritas = await Promise.all(seriesFavortiasIds.map(id => fetchSerieDetails(id)));
const peliculasFavoritas = await Promise.all(peliculasFavoritasIds.map(id => fetchMovieDetails(id)));

// Obtener parámetros de URL
const filter = Astro.url.searchParams.get("filter") || "todos";
const searchQuery = Astro.url.searchParams.get("search") || "";
const genreFilter = Astro.url.searchParams.get("genre") || "";

const showSeries = filter === "series" || filter === "todos";
const showMovies = filter === "peliculas" || filter === "todos";
const showAll = filter === "todos";

// Definir los géneros comunes
const genresMap: Record<number, string> = {
    // Géneros de películas y series
    28: "Acción",
    12: "Aventura",
    16: "Animación",
    35: "Comedia",
    80: "Crimen",
    99: "Documental",
    18: "Drama",
    10751: "Familia",
    14: "Fantasía",
    36: "Historia",
    27: "Terror",
    10402: "Música",
    9648: "Misterio",
    10749: "Romance",
    878: "Ciencia ficción",
    10770: "Película de TV",
    53: "Thriller",
    10752: "Bélica",
    37: "Western",
    // Géneros exclusivos de series
    10759: "Acción y Aventura",
    10762: "Infantil",
    10763: "Noticias",
    10764: "Reality",
    10765: "Sci-Fi y Fantasía",
    10766: "Soap",
    10767: "Talk",
    10768: "Guerra y Política"
};

// Función para obtener el nombre del género según su ID
function getGenreName(id: number): string {
    return genresMap[id] || "Otro";
}

const minRating = parseFloat(new URLSearchParams(Astro.request.url).get('minRating') || '0');

// Función para filtrar contenido
function filterContent(items: any[], type: 'movie' | 'serie') {
    return items.filter(item => {
        const title = type === 'movie' ? item.title : item.name;
        const overview = item.overview || '';
        const genreList = item.genres || [];
        const rating = item.vote_average || 0;

        const searchMatch =
            !searchQuery ||
            (title?.toLowerCase().includes(searchQuery.toLowerCase()) ||
                overview.toLowerCase().includes(searchQuery.toLowerCase()));

        const genreMatch = !genreFilter || genreList.some((g: {
            id: number;
            name: string
        }) => g.id.toString() === genreFilter);

        const ratingMatch = !minRating || item.vote_average >= minRating;

        return searchMatch && genreMatch && ratingMatch;
    });
}

// Aplicar filtros
const seriesFiltradas = filterContent(seriesFavoritas, 'serie');
const peliculasFiltradas = filterContent(peliculasFavoritas, 'movie');

// Obtener géneros únicos del contenido actual
function getUniqueGenres() {
    const genreMap = new Map<number, string>();

    const processGenres = (items: any[]) => {
        items.forEach(item => {
            const genres = item.genre_ids || item.genres || [];
            genres.forEach((genre: any) => {
                // Si es un objeto con id y name
                if (typeof genre === 'object' && genre?.id && genre?.name) {
                    genreMap.set(genre.id, genre.name);
                }
                // Si es solo un ID numérico
                else if (typeof genre === 'number') {
                    const genreName = getGenreName(genre);
                    genreMap.set(genre, genreName);
                }
                // Si es un string, buscar el ID correspondiente
                else if (typeof genre === 'string') {
                    // Buscar ID por nombre en el mapa inverso
                    const genreId = Object.entries(genresMap)
                        .find(([_, name]) => name === genre)?.[0];
                    if (genreId) {
                        genreMap.set(parseInt(genreId), genre);
                    }
                }
            });
        });
    };

    if (showSeries || showAll) {
        processGenres(seriesFavoritas);
    }

    if (showMovies || showAll) {
        processGenres(peliculasFavoritas);
    }

    return Array.from(genreMap.entries())
        .map(([id, name]) => ({id, name}))
        .sort((a, b) => a.name.localeCompare(b.name));
}

const availableGenres = getUniqueGenres();

// Función para construir URL con parámetros
function buildUrl(params: Record<string, string>) {
    const url = new URL(Astro.url);
    Object.entries(params).forEach(([key, value]) => {
        if (value && value !== 'todos' && value !== '') {
            url.searchParams.set(key, value);
        } else {
            url.searchParams.delete(key);
        }
    });
    return url.pathname + url.search;
}
---
<div class="favorites-container max-w-7xl mx-auto px-4 py-8">
    <!-- Checkbox oculto para controlar el desplegable -->
    <input type="checkbox" id="search-toggle" class="search-toggle hidden"/>

    <!-- Primera barra de navegación -->
    <nav class="z-50 bg-gradient-to-r from-blue-900 to-indigo-900 backdrop-blur-lg shadow-xl rounded-2xl px-6 py-4 mb-4">
        <div class="flex flex-wrap justify-center gap-4">
            <a href={buildUrl({filter: 'todos', search: searchQuery, genre: genreFilter})}
               class={`px-5 py-2 rounded-full text-sm font-semibold tracking-wide transition-all
                 ${showAll ? "bg-white text-blue-900 ring-2 ring-white shadow-lg scale-105" :
                   "bg-blue-700 text-white hover:bg-blue-600 hover:scale-105"}`}>
                Todo el contenido
            </a>
            <a href={buildUrl({filter: 'series', search: searchQuery, genre: genreFilter})}
               class={`px-5 py-2 rounded-full text-sm font-semibold tracking-wide transition-all
                 ${showSeries && !showAll ? "bg-white text-blue-900 ring-2 ring-white shadow-lg scale-105" :
                   "bg-blue-700 text-white hover:bg-blue-600 hover:scale-105"}`}>
                Series
            </a>
            <a href={buildUrl({filter: 'peliculas', search: searchQuery, genre: genreFilter})}
               class={`px-5 py-2 rounded-full text-sm font-semibold tracking-wide transition-all
                 ${showMovies && !showAll ? "bg-white text-blue-900 ring-2 ring-white shadow-lg scale-105" :
                   "bg-blue-700 text-white hover:bg-blue-600 hover:scale-105"}`}>
                Películas
            </a>

            <!-- Botón para mostrar/ocultar búsqueda -->
            <label for="search-toggle"
                   class="search-toggle-btn px-5 py-2 rounded-full text-sm font-semibold tracking-wide transition-all bg-green-600 text-white hover:bg-green-700 hover:scale-105 cursor-pointer flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <span class="toggle-text">Búsqueda</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 chevron transition-transform" fill="none"
                     viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
            </label>
        </div>
    </nav>

    <!-- Panel de búsqueda -->
    <div class="search-panel bg-gradient-to-br from-blue-50 via-white to-indigo-50 rounded-3xl shadow-2xl border border-blue-100 mb-8 overflow-hidden">
        <div class="search-content p-6 sm:p-8 space-y-8">
            <form method="GET" class="space-y-8">
                <input type="hidden" name="filter" value={filter}/>

                <!-- Grupo de filtros en tarjetas -->
                <div class="flex flex-col gap-6 md:flex-row md:gap-8 justify-center">
                    <!-- Búsqueda -->
                    <div class="flex-1 bg-white rounded-2xl shadow-md border border-gray-100 p-5 flex flex-col gap-2 transition-transform hover:scale-105">
                        <label for="search" class="flex items-center gap-2 text-base font-semibold text-blue-800 mb-1">
                            <svg class="h-5 w-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                            </svg>
                            Buscar
                        </label>
                        <input
                                type="text"
                                id="search"
                                name="search"
                                value={searchQuery}
                                placeholder="Título o descripción..."
                                class="w-full px-4 py-3 border border-blue-200 rounded-lg focus:ring-2 focus:ring-blue-400 focus:border-transparent text-gray-900 placeholder-gray-400 bg-blue-50 transition"
                        />
                    </div>

                    <!-- Nota mínima -->
                    <div class="flex-1 bg-white rounded-2xl shadow-md border border-gray-100 p-5 flex flex-col gap-2 transition-transform hover:scale-105">
                        <label for="minRating"
                               class="flex items-center gap-2 text-base font-semibold text-indigo-800 mb-1">
                            <svg class="h-5 w-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3"/>
                                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none"/>
                            </svg>
                            Nota mínima
                        </label>
                        <div class="relative flex items-center gap-4">
                            <input
                                    type="range"
                                    id="minRating"
                                    name="minRating"
                                    min="0"
                                    max="10"
                                    step="0.1"
                                    value={minRating || 0}
                                    class="rating-slider w-full"
                                    oninput="document.getElementById('ratingValue').textContent = this.value"
                            />
                            <span id="ratingValue" class="text-base font-bold text-indigo-700 w-12 text-right">
                        {minRating || 0}
                    </span>
                        </div>
                    </div>

                    <!-- Género -->
                    <div class="flex-1 bg-white rounded-2xl shadow-md border border-gray-100 p-5 flex flex-col gap-2 transition-transform hover:scale-105">
                        <label for="genre" class="flex items-center gap-2 text-base font-semibold text-pink-800 mb-1">
                            <svg class="h-5 w-5 text-pink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M4 6h16M4 12h16M4 18h16"/>
                            </svg>
                            Género
                        </label>
                        <select
                                id="genre"
                                name="genre"
                                class="w-full py-3 px-4 border border-pink-200 rounded-lg focus:ring-2 focus:ring-pink-400 focus:border-transparent bg-pink-50 text-gray-900 transition"
                        >
                            <option value="">Todos</option>
                            {availableGenres.map(genre => (
                                    <option value={genre.id.toString()} selected={genreFilter === genre.id.toString()}>
                                        {genre.name}
                                    </option>
                            ))}
                        </select>
                    </div>
                </div>

                <!-- Botón Buscar -->
                <div class="flex justify-center">
                    <button
                            type="submit"
                            class="w-full md:w-auto px-8 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-xl hover:from-blue-700 hover:to-indigo-700 transition-colors font-semibold flex justify-center items-center gap-2 shadow-lg"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                        Buscar
                    </button>
                </div>

                <!-- Limpiar filtros -->
                {(searchQuery || genreFilter || minRating) && (
                        <div class="flex justify-center">
                            <a
                                    href={buildUrl({filter: filter, search: '', genre: '', minRating: ''})}
                                    class="text-sm text-blue-600 hover:text-blue-800 underline flex items-center gap-1 font-medium"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                                     stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                                Limpiar filtros
                            </a>
                        </div>
                )}

                <!-- Filtros activos -->
                {(searchQuery || genreFilter || minRating) && (
                        <div class="flex flex-wrap gap-2 justify-center text-sm text-gray-800">
                            <span class="font-semibold text-blue-800">Filtros activos:</span>
                            {searchQuery && (
                                    <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full">{`"${searchQuery}"`}</span>
                            )}
                            {genreFilter && (
                                    <span class="bg-pink-100 text-pink-800 px-3 py-1 rounded-full">{getGenreName(parseInt(genreFilter))}</span>
                            )}
                            {minRating && (
                                    <span class="bg-indigo-100 text-indigo-800 px-3 py-1 rounded-full">{`≥ ${minRating}`}</span>
                            )}
                        </div>
                )}
            </form>

            <!-- Resultados -->
            {(searchQuery || genreFilter) && (
                    <div class="p-4 bg-blue-50 rounded-xl border border-blue-200 text-center">
                        <p class="text-sm text-blue-800 font-medium">
                            Mostrando {seriesFiltradas.length + peliculasFiltradas.length} resultados
                        </p>
                    </div>
            )}
        </div>
    </div>

    <!-- Barra de navegación secundaria (Categorías) -->
    <nav class="bg-gradient-to-r from-gray-100 to-gray-200 rounded-xl shadow-md mb-8">
        <div class="container mx-auto px-4 py-2">
            <div class="flex flex-wrap justify-center gap-3 items-center">
                <a href="/personal/favoritos"
                   class="px-4 py-2 rounded-lg transition-all duration-300 font-medium text-gray-700 bg-white shadow-md transform scale-105">
                <span class="flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-yellow-500" viewBox="0 0 20 20"
                         fill="currentColor">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    Favoritos
                </span>
                </a>
                <a href="/personal/pendientes"
                   class="px-4 py-2 rounded-lg transition-all duration-300 font-medium text-gray-700 bg-gray-200 hover:bg-gray-300">
            <span class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-blue-500" viewBox="0 0 20 20"
                     fill="currentColor">
                    <path fill-rule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"
                          clip-rule="evenodd"/>
                </svg>
                Pendientes
            </span>
                </a>

                {/* Mostrar "Siguiendo" solo si NO está en modo de películas */}
                {!showMovies || showAll ? (
                        <a href="/personal/siguiendo"
                           class="px-4 py-2 rounded-lg transition-all duration-300 font-medium text-gray-700 bg-gray-200 hover:bg-gray-300">
                    <span class="flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-purple-500" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" width="24"
                             height="24" stroke-width="2">
                            <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
                            <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"></path>
                        </svg>
                        Siguiendo
                    </span>
                        </a>
                ) : null}

                <a href="/personal/megusta"
                   class="px-4 py-2 rounded-lg transition-all duration-300 font-medium text-gray-700 bg-gray-200 hover:bg-gray-300">
                    <span class="flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-pink-500" viewBox="0 0 20 20"
                             fill="currentColor">
                            <path fill-rule="evenodd"
                                  d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z"
                                  clip-rule="evenodd"/>
                        </svg>
                        Me gustan
                    </span>
                </a>

                <a href="/personal/vistos"
                   class="px-4 py-2 rounded-lg transition-all duration-300 font-medium text-gray-700 bg-gray-200 hover:bg-gray-300">
                <span class="flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-green-500" viewBox="0 0 20 20"
                         fill="currentColor">
                        <path fill-rule="evenodd"
                              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                              clip-rule="evenodd"/>
                    </svg>
                    Vistos
                </span>
                </a>
                <a href="/personal/verpronto"
                   class="px-4 py-2 rounded-lg transition-all duration-300 font-medium text-gray-700 bg-gray-200 hover:bg-gray-300">
                    <span class="flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-indigo-500" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                            <line x1="8" y1="21" x2="16" y2="21"/>
                            <line x1="12" y1="17" x2="12" y2="21"/>
                            <polygon points="10,8 16,12 10,16"/>
                        </svg>
                        Ver pronto
                    </span>
                </a>
                <a href="/personal/recomendaciones"
                   class="px-4 py-2 rounded-lg transition-all duration-300 font-medium text-gray-700 bg-gray-200 hover:bg-gray-300">
            <span class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-orange-500" viewBox="0 0 20 20"
                     fill="currentColor">
                    <path
                            d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                Recomendadas
            </span>
                </a>
            </div>
        </div>
    </nav>

    <!-- Contenedor principal de contenido -->
    <div class="content-sections">
        {/* SECCIÓN DE FAVORITOS */}
        <div class="favorites-section mb-10 animate-fadeIn">
            <div class="section-header flex items-center gap-4 mb-4">
                <div class="flex-grow h-0.5 bg-gradient-to-r from-yellow-300 to-yellow-500"></div>
                <h2 class="text-2xl font-bold text-gray-800 flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 mr-2 text-yellow-500"
                         viewBox="0 0 20 20" fill="currentColor">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    Contenido Favorito
                </h2>
                <div class="flex-grow h-0.5 bg-gradient-to-r from-yellow-500 to-yellow-300"></div>
            </div>

            {/* Series Favoritas */}
            {(showSeries || showAll) && (
                    <section class="mb-8">
                        <h3 class="text-xl font-semibold text-blue-700 mb-4 pl-4 border-l-4 border-blue-500 flex justify-between items-center">
                            <span>Series Favoritas</span>
                            <span class="ml-4 text-base text-blue-500 bg-blue-100 rounded-full px-3 py-1 font-bold">
                                {seriesFiltradas.length}
                                {searchQuery || genreFilter ? ` de ${seriesFavoritas.length}` : ''}
                            </span>
                        </h3>

                        {seriesFiltradas.length === 0 ? (
                                <div class="empty-state bg-blue-50 border border-blue-200 rounded-xl p-6 text-center">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         class="h-12 w-12 mx-auto text-blue-400 mb-3" fill="none"
                                         viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                    <h3 class="text-lg font-semibold text-blue-700 mb-1">
                                        {searchQuery || genreFilter ? 'No se encontraron series' : 'Aún no tienes series favoritas'}
                                    </h3>
                                    <p class="text-blue-600 text-sm">
                                        {searchQuery || genreFilter ?
                                            'Intenta ajustar los filtros o términos de búsqueda.' :
                                            'Explora el catálogo y guarda las series que más te gusten.'
                                        }
                                    </p>
                                </div>
                        ) : (
                                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 w-full">
                                    {seriesFiltradas.map((item) => (
                                            <CardSerie
                                                    id={item.id.toString()}
                                                    img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                    name={item.name}
                                                    vote_average={item.vote_average}
                                                    overview={item.overview}
                                                    first_air_date={item.first_air_date}
                                                    seasons={item.seasons}
                                                    last_episode_to_air={item.last_episode_to_air}
                                                    next_episode_to_air={item.next_episode_to_air}
                                                    genres={item.genre_ids?.map((id: number) => ({
                                                        id,
                                                        name: getGenreName(id)
                                                    }))}
                                                    status={item.status}
                                            />
                                    ))}
                                </div>
                        )}
                    </section>
            )}

            {/* Películas Favoritas */}
            {(showMovies || showAll) && (
                    <section class="mb-8">
                        <h3 class="text-xl font-semibold text-red-700 mb-4 pl-4 border-l-4 border-red-500 flex justify-between items-center">
                            <span>Películas Favoritas</span>
                            <span class="ml-4 text-base text-red-700 bg-red-100 rounded-full px-3 py-1 font-bold">
                                {peliculasFiltradas.length}
                                {searchQuery || genreFilter ? ` de ${peliculasFavoritas.length}` : ''}
                            </span>
                        </h3>

                        {peliculasFiltradas.length === 0 ? (
                                <div class="empty-state bg-red-50 border border-red-200 rounded-xl p-6 text-center">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         class="h-12 w-12 mx-auto text-red-400 mb-3" fill="none"
                                         viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                                    </svg>
                                    <h3 class="text-lg font-semibold text-red-700 mb-1">
                                        {searchQuery || genreFilter ? 'No se encontraron películas' : 'Aún no tienes películas favoritas'}
                                    </h3>
                                    <p class="text-red-600 text-sm">
                                        {searchQuery || genreFilter ?
                                            'Intenta ajustar los filtros o términos de búsqueda.' :
                                            'Explora el catálogo y guarda las películas que más te gusten.'
                                        }
                                    </p>
                                </div>
                        ) : (
                                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 w-full">
                                    {peliculasFiltradas.map((item) => (
                                            <CardMovie
                                                    id={item.id.toString()}
                                                    img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                    title={item.title}
                                                    vote_average={item.vote_average}
                                                    overview={item.overview}
                                                    release_date={item.release_date}
                                                    genres={item.genre_ids?.map((id: number) => ({
                                                        id,
                                                        name: getGenreName(id)
                                                    }))}
                                                    providers={item.providers}
                                            />
                                    ))}
                                </div>
                        )}
                    </section>
            )}
        </div>
    </div>
</div>

