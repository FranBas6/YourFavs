---
import '../styles/components/header.css';
import { Icon } from 'astro-icon/components';
import Stamp from './Stamp.astro';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
    if (href === "/") return currentPath === "/";
    return currentPath.startsWith(href);
}

// Nav principal (desktop): Inicio · Tendencias · Cartelera · Descubrir▾ · Plataformas
const navMain = [
    { href: "/", label: "Inicio", icon: "sparkles" },
    { href: "/catalogo/tendencias", label: "Tendencias", icon: "trending-up" },
    { href: "/catalogo/cartelera", label: "Cartelera", icon: "clapperboard" },
];
const navPlatforms = { href: "/catalogo/plataformas", label: "Plataformas", icon: "layout-grid" };

// Dropdown "Descubrir" (6 items — Categorías y Sagas son cosas distintas)
const discoverItems = [
    { href: "/catalogo/ultimoslanzamientos", color: "green",  icon: "sparkles",  title: "Últimos lanzamientos", desc: "Estrenos en streaming" },
    { href: "/catalogo/maspopulares",        color: "pink",   icon: "flame",     title: "Más populares",        desc: "Lo que todo el mundo ve" },
    { href: "/catalogo/topmovies",           color: "amber",  icon: "star",      title: "Top películas",        desc: "Las mejores de siempre" },
    { href: "/catalogo/topseries",           color: "blue",   icon: "trophy",    title: "Top series",           desc: "Imprescindibles TV" },
    { href: "/catalogo/categorias",          color: "slate",  icon: "layers",    title: "Categorías",           desc: "Por género" },
    { href: "/catalogo/colecciones",         color: "purple", icon: "tag",       title: "Sagas",                desc: "Colecciones y franquicias" },
];
const discoverActive = discoverItems.some((i) => currentPath.startsWith(i.href));
---
<header class="header-main">
    <div class="header-inner">
        <!-- Logo -->
        <a href="/" class="header-logo">
            <span class="header-logo-text">YOURFAVS</span>
        </a>

        <!-- Nav desktop: 5 items (Inicio · Tendencias · Cartelera · Descubrir▾ · Plataformas) -->
        <nav aria-label="Navegación principal" class="header-nav-desktop">
            {navMain.map(item => (
                <a href={item.href}
                   class={`header-nav-link ${isActive(item.href) ? 'is-active' : ''}`}>
                    <Icon name={`lucide:${item.icon}`} class="w-4 h-4" />
                    {item.label}
                </a>
            ))}

            <!-- Descubrir + dropdown -->
            <div class="header-discover" id="discover">
                <button type="button"
                        class={`header-nav-link header-discover-btn ${discoverActive ? 'is-active' : ''}`}
                        id="discover-btn" aria-haspopup="true" aria-expanded="false">
                    <Icon name="lucide:compass" class="w-4 h-4" />
                    Descubrir
                    <svg class="header-discover-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                    </svg>
                </button>
                <div class="header-discover-panel" id="discover-panel">
                    <div class="header-discover-kicker">Explorar el catálogo</div>
                    <div class="header-discover-grid">
                        {discoverItems.map(it => (
                            <a href={it.href} class="header-discover-item">
                                <Stamp color={it.color as any} icon={it.icon} size={32} />
                                <span class="hd-body">
                                    <span class="hd-t">{it.title}</span>
                                    <span class="hd-s">{it.desc}</span>
                                </span>
                            </a>
                        ))}
                    </div>
                </div>
            </div>

            <a href={navPlatforms.href}
               class={`header-nav-link ${isActive(navPlatforms.href) ? 'is-active' : ''}`}>
                <Icon name={`lucide:${navPlatforms.icon}`} class="w-4 h-4" />
                {navPlatforms.label}
            </a>
        </nav>

        <!-- Acciones desktop: búsqueda + theme toggle -->
        <div class="header-actions">
            <form action="/catalogo/busqueda" method="get" class="header-search-form">
                <label for="header-search" class="sr-only">Buscar películas y series</label>
                <svg class="header-search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <input id="header-search" name="query" type="text" placeholder="Buscar..." autocomplete="off" class="header-search-input"/>
                <button type="submit" aria-label="Buscar" class="header-search-btn">
                    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/>
                    </svg>
                </button>
            </form>

            <!-- Calendario desktop: dropdown -->
            <button class="header-calendar-btn" id="calendar-toggle-btn" aria-label="Abrir calendario de estrenos" title="Calendario de estrenos">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
            </button>
            <div class="header-calendar-dropdown" id="calendar-dropdown" style="display:none;">
                <div class="calendar-dropdown-header">
                    <button id="cal-prev" class="cal-nav-btn" aria-label="Mes anterior">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    </button>
                    <span id="cal-month-title" class="cal-month-title"></span>
                    <button id="cal-next" class="cal-nav-btn" aria-label="Mes siguiente">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </button>
                </div>
                <div class="cal-weekdays">
                    <span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span>
                </div>
                <div id="cal-grid" class="cal-grid"></div>
                <div id="cal-day-detail" class="cal-day-detail" style="display:none;" role="dialog" aria-modal="true" aria-label="Detalle del día" tabindex="-1"></div>
                <div id="cal-notifications" class="cal-notifications">
                    <p class="cal-notif-title">Tus notificaciones</p>
                    <div id="cal-notif-list" class="cal-notif-list">
                        <p class="cal-notif-empty">Cargando...</p>
                    </div>
                </div>
            </div>

            <button class="theme-toggle" aria-label="Cambiar tema">
                <svg class="theme-icon-sun" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
                <svg class="theme-icon-moon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                </svg>
            </button>

            <!-- Usuario → área personal (no hay login: Personal vive aquí) -->
            <a href="/personal/favoritos" class={`header-icon-btn ${currentPath.startsWith('/personal') ? 'is-active' : ''}`} aria-label="Mi área personal" title="Personal">
                <Icon name="lucide:user" class="w-5 h-5" />
            </a>
        </div>

        <!-- Usuario (móvil) -->
        <a href="/personal/favoritos" class="header-mobile-user" aria-label="Mi área personal" title="Personal">
            <Icon name="lucide:user" class="w-6 h-6" />
        </a>

        <!-- Hamburger mobile -->
        <button class="header-hamburger" id="menu-open-btn" aria-label="Abrir menú de navegación">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        </button>
    </div>
</header>

<!-- Mobile slide-in panel -->
<div class="mobile-overlay" id="mobile-overlay" aria-hidden="true"></div>
<aside class="mobile-panel" id="mobile-panel" aria-label="Menú de navegación">
    <div class="mobile-panel-header">
        <span class="header-logo-text" style="font-size: 1.2rem;">YOURFAVS</span>
        <button class="mobile-close-btn" id="menu-close-btn" aria-label="Cerrar menú">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>

    <!-- Búsqueda mobile -->
    <form action="/catalogo/busqueda" method="get" class="mobile-search-form">
        <label for="mobile-search" class="sr-only">Buscar películas y series</label>
        <svg class="mobile-search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input id="mobile-search" name="query" type="text" placeholder="Buscar películas, series..." autocomplete="off" class="mobile-search-input"/>
    </form>

    <!-- NAVEGAR -->
    <p class="mobile-section-label">Navegar</p>
    <nav class="mobile-nav" aria-label="Navegación principal">
        {navMain.map(item => (
            <a href={item.href} class={`mobile-nav-link ${isActive(item.href) ? 'is-active' : ''}`}>
                <Icon name={`lucide:${item.icon}`} class="w-5 h-5" />
                {item.label}
            </a>
        ))}
        <a href={navPlatforms.href} class={`mobile-nav-link ${isActive(navPlatforms.href) ? 'is-active' : ''}`}>
            <Icon name={`lucide:${navPlatforms.icon}`} class="w-5 h-5" />
            {navPlatforms.label}
        </a>
        <a href="/personal/calendario" class={`mobile-nav-link ${isActive('/personal/calendario') ? 'is-active' : ''}`}>
            <Icon name="lucide:calendar" class="w-5 h-5" />
            Calendario
        </a>
        <a href="/personal/favoritos" class={`mobile-nav-link ${currentPath.startsWith('/personal') && !currentPath.startsWith('/personal/calendario') ? 'is-active' : ''}`}>
            <Icon name="lucide:user" class="w-5 h-5" />
            Personal
        </a>
    </nav>

    <!-- DESCUBRIR -->
    <p class="mobile-section-label">Descubrir</p>
    <nav class="mobile-nav" aria-label="Descubrir">
        {discoverItems.map(it => (
            <a href={it.href} class={`mobile-nav-link ${isActive(it.href) ? 'is-active' : ''}`}>
                <Icon name={`lucide:${it.icon}`} class="w-5 h-5" />
                {it.title}
            </a>
        ))}
    </nav>

    <!-- Theme toggle mobile -->
    <div class="mobile-panel-footer">
        <button class="theme-toggle mobile-theme-toggle" aria-label="Cambiar tema">
            <svg class="theme-icon-sun w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            <svg class="theme-icon-moon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
            </svg>
            <span>Cambiar tema</span>
        </button>
    </div>
</aside>

<script is:inline>
(function () {
    var panel = document.getElementById('mobile-panel');
    var overlay = document.getElementById('mobile-overlay');
    var openBtn = document.getElementById('menu-open-btn');
    var closeBtn = document.getElementById('menu-close-btn');

    function openMenu() {
        panel.classList.add('is-open');
        overlay.classList.add('is-open');
        document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
        panel.classList.remove('is-open');
        overlay.classList.remove('is-open');
        document.body.style.overflow = '';
    }

    if (openBtn) openBtn.addEventListener('click', openMenu);
    if (closeBtn) closeBtn.addEventListener('click', closeMenu);
    if (overlay) overlay.addEventListener('click', closeMenu);

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && panel.classList.contains('is-open')) closeMenu();
    });
})();

// Dropdown "Descubrir" (desktop): SOLO click (sin hover, para no abrirse al
// pasar el ratón). Click en el botón abre/cierra; cierra con click fuera o Esc.
(function () {
    var wrap = document.getElementById('discover');
    var btn = document.getElementById('discover-btn');
    if (!wrap || !btn) return;
    var open = false;
    function setOpen(v) {
        open = v;
        wrap.classList.toggle('is-open', v);
        btn.setAttribute('aria-expanded', v ? 'true' : 'false');
    }
    btn.addEventListener('click', function (e) { e.stopPropagation(); setOpen(!open); });
    document.addEventListener('click', function (e) { if (open && !wrap.contains(e.target)) setOpen(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && open) setOpen(false); });
})();

// Calendar dropdown
(function () {
    var calBtn = document.getElementById('calendar-toggle-btn');
    var calDrop = document.getElementById('calendar-dropdown');
    var calGrid = document.getElementById('cal-grid');
    var calTitle = document.getElementById('cal-month-title');
    var calPrev = document.getElementById('cal-prev');
    var calNext = document.getElementById('cal-next');
    var calDayDetail = document.getElementById('cal-day-detail');
    var calNotifList = document.getElementById('cal-notif-list');
    if (!calBtn || !calDrop) return;

    var months = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
    var now = new Date();
    var curYear = now.getFullYear();
    var curMonth = now.getMonth() + 1;
    var calData = null;
    var isOpen = false;

    function toggle() {
        isOpen = !isOpen;
        calDrop.style.display = isOpen ? 'block' : 'none';
        if (isOpen && !calData) loadMonth(curYear, curMonth);
    }

    calBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        toggle();
    });

    document.addEventListener('click', function (e) {
        if (isOpen && !calDrop.contains(e.target) && e.target !== calBtn) {
            isOpen = false;
            calDrop.style.display = 'none';
        }
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && isOpen) { isOpen = false; calDrop.style.display = 'none'; }
    });

    calPrev.addEventListener('click', function () {
        curMonth--; if (curMonth < 1) { curMonth = 12; curYear--; }
        loadMonth(curYear, curMonth);
    });
    calNext.addEventListener('click', function () {
        curMonth++; if (curMonth > 12) { curMonth = 1; curYear++; }
        loadMonth(curYear, curMonth);
    });

    function loadMonth(y, m) {
        calTitle.textContent = months[m - 1] + ' ' + y;
        calGrid.innerHTML = '<p style="text-align:center;padding:1rem;color:#9CA3AF;font-size:12px;">Cargando...</p>';
        calDayDetail.style.display = 'none';

        var ym = y + '-' + String(m).padStart(2, '0');
        fetch('/api/calendar/' + ym)
            .then(function (r) { return r.json(); })
            .then(function (data) {
                calData = data;
                renderGrid(data);
                renderNotifications(data);
            })
            .catch(function () {
                calGrid.innerHTML = '<p style="text-align:center;padding:1rem;color:#EF4444;font-size:12px;">Error al cargar</p>';
            });
    }

    function renderGrid(data) {
        var daysInMonth = new Date(data.year, data.month, 0).getDate();
        var firstDay = (new Date(data.year, data.month - 1, 1).getDay() + 6) % 7;
        var eventsMap = {};
        (data.days || []).forEach(function (d) { eventsMap[d.date] = d.events; });

        var html = '';
        for (var i = 0; i < firstDay; i++) html += '<div class="cal-cell cal-empty"></div>';

        for (var d = 1; d <= daysInMonth; d++) {
            var dateStr = data.year + '-' + String(data.month).padStart(2, '0') + '-' + String(d).padStart(2, '0');
            var events = eventsMap[dateStr] || [];
            var isToday = dateStr === data.today;
            var cls = 'cal-cell' + (isToday ? ' cal-today' : '') + (events.length ? ' cal-has-events' : '');
            html += '<div class="' + cls + '" data-date="' + dateStr + '">';
            html += '<span class="cal-day-num">' + d + '</span>';
            if (events.length) {
                html += '<div class="cal-dots">';
                var hasMovie = events.some(function (e) { return e.media_type === 'movie'; });
                var hasSerie = events.some(function (e) { return e.event_type === 'episode'; });
                var hasSeason = events.some(function (e) { return e.event_type === 'season_premiere'; });
                if (hasMovie) html += '<span class="cal-dot cal-dot-movie"></span>';
                if (hasSerie) html += '<span class="cal-dot cal-dot-serie"></span>';
                if (hasSeason) html += '<span class="cal-dot cal-dot-season"></span>';
                html += '</div>';
            }
            html += '</div>';
        }
        calGrid.innerHTML = html;

        // Day click handler
        calGrid.querySelectorAll('.cal-has-events').forEach(function (cell) {
            cell.addEventListener('click', function () {
                var date = cell.getAttribute('data-date');
                var events = eventsMap[date] || [];
                showDayDetail(date, events, cell);
            });
        });
    }

    var dayDetailReturnFocus = null;

    function escapeAttr(s) {
        return String(s || '').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function clearSelectedDay() {
        if (!calGrid) return;
        calGrid.querySelectorAll('.cal-selected').forEach(function (c) { c.classList.remove('cal-selected'); });
    }

    function closeDayDetail() {
        calDayDetail.style.display = 'none';
        clearSelectedDay();
        if (dayDetailReturnFocus && typeof dayDetailReturnFocus.focus === 'function') {
            dayDetailReturnFocus.focus();
            dayDetailReturnFocus = null;
        }
    }

    function showDayDetail(date, events, triggerEl) {
        dayDetailReturnFocus = triggerEl || document.activeElement;
        clearSelectedDay();
        if (triggerEl && triggerEl.classList) triggerEl.classList.add('cal-selected');
        var d = new Date(date + 'T12:00:00');
        var dayName = d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'short' });
        var html = '<div class="cal-detail-header"><span>' + dayName + '</span><button id="cal-detail-close" class="cal-detail-close" aria-label="Cerrar detalle del día">&times;</button></div>';
        events.forEach(function (ev) {
            var typeClass = ev.media_type === 'movie' ? 'cal-ev-movie' : (ev.event_type === 'season_premiere' ? 'cal-ev-season' : 'cal-ev-serie');
            var link = ev.media_type === 'movie' ? '/movie/' + ev.tmdb_id : '/serie/' + ev.tmdb_id;
            html += '<a href="' + link + '" class="cal-event ' + typeClass + '">';
            if (ev.poster_path) html += '<img src="' + ev.poster_path + '" alt="' + escapeAttr(ev.title) + '" class="cal-ev-poster"/>';
            html += '<div class="cal-ev-info"><span class="cal-ev-title">' + escapeAttr(ev.title) + '</span><span class="cal-ev-label">' + escapeAttr(ev.label) + '</span></div></a>';
        });
        calDayDetail.innerHTML = html;
        calDayDetail.style.display = 'block';
        var closeBtn = document.getElementById('cal-detail-close');
        closeBtn.addEventListener('click', closeDayDetail);
        closeBtn.focus();
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && calDayDetail && calDayDetail.style.display === 'block') {
            e.stopPropagation();
            closeDayDetail();
        }
    });

    function renderNotifications(data) {
        var subs = [];
        (data.days || []).forEach(function (d) {
            d.events.forEach(function (ev) {
                if (ev.is_subscribed) subs.push({ date: d.date, event: ev });
            });
        });
        if (subs.length === 0) {
            calNotifList.innerHTML = '<p class="cal-notif-empty">No hay notificaciones este mes</p>';
            return;
        }

        // Agrupar por media+tmdb_id+title
        var map = {};
        subs.forEach(function (s) {
            var key = s.event.media_type + ':' + s.event.tmdb_id + ':' + s.event.title;
            if (!map[key]) map[key] = [];
            map[key].push(s);
        });
        var todayStr = new Date().toISOString().slice(0, 10);
        var groups = Object.keys(map).map(function (k) {
            var items = map[k].slice().sort(function (a, b) { return a.date.localeCompare(b.date); });
            var upcoming = items.filter(function (s) { return s.date >= todayStr; });
            var nextDate = upcoming.length ? upcoming[0].date : items[items.length - 1].date;
            return { items: items, firstDate: items[0].date, nextDate: nextDate, hasUpcoming: upcoming.length > 0, head: items[0].event };
        }).sort(function (a, b) { return a.nextDate.localeCompare(b.nextDate); });

        var fmt = function (date) {
            return new Date(date + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'short' });
        };

        var html = '';
        groups.forEach(function (g) {
            var head = g.head;
            var link = head.media_type === 'movie' ? '/movie/' + head.tmdb_id : '/serie/' + head.tmdb_id;
            var poster = head.poster_path
                ? '<img src="' + head.poster_path + '" alt="" class="cal-notif-poster"/>'
                : '<div class="cal-notif-poster-empty">?</div>';

            if (g.items.length === 1) {
                html += '<a href="' + link + '" class="cal-notif-item">';
                html += poster;
                html += '<div class="cal-notif-body">';
                html += '<div class="cal-notif-top"><span class="cal-notif-name">' + escapeAttr(head.title) + '</span><span class="cal-notif-date">' + fmt(g.firstDate) + '</span></div>';
                html += '<span class="cal-notif-label">' + escapeAttr(head.label) + '</span>';
                html += '</div></a>';
                return;
            }

            var startOpen = g.items.length <= 3;
            html += '<details class="cal-notif-group"' + (startOpen ? ' open' : '') + '>';
            html += '<summary class="cal-notif-item cal-notif-summary">';
            html += poster;
            html += '<div class="cal-notif-body">';
            html += '<div class="cal-notif-top"><span class="cal-notif-name">' + escapeAttr(head.title) + '</span><span class="cal-notif-count">' + g.items.length + ' episodios</span></div>';
            html += '<span class="cal-notif-label">' + (g.hasUpcoming ? 'Próximo: ' : 'Último: ') + fmt(g.nextDate) + '</span>';
            html += '</div>';
            html += '<svg class="cal-notif-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>';
            html += '</summary>';
            html += '<ul class="cal-notif-sublist">';
            g.items.forEach(function (s) {
                html += '<li><a href="' + link + '" class="cal-notif-subitem">';
                html += '<span class="cal-notif-sublabel">' + escapeAttr(s.event.label) + '</span>';
                html += '<span class="cal-notif-subdate">' + fmt(s.date) + '</span>';
                html += '</a></li>';
            });
            html += '</ul>';
            html += '</details>';
        });
        calNotifList.innerHTML = html;
    }
})();
</script>
