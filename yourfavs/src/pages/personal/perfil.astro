---
import Layout from "../../layouts/Layout.astro";
import { getUserProfile, setUserProfile, type UserProfile } from "../../services/BD/profile/userProfile";
import { SUPPORTED_COUNTRIES } from "../../services/API/shared/tmdbInfoService";

// Protegida por el middleware (/personal/* sin sesión → redirige). Aquí ya hay user.
const user = Astro.locals.user!;

// Idiomas de contenido soportados (subconjunto razonable de TMDB).
const LANGUAGES = [
    { code: 'es-ES', label: 'Español' },
    { code: 'en-US', label: 'English' },
    { code: 'fr-FR', label: 'Français' },
    { code: 'de-DE', label: 'Deutsch' },
    { code: 'it-IT', label: 'Italiano' },
    { code: 'pt-BR', label: 'Português (BR)' },
    { code: 'ja-JP', label: '日本語' },
];

// POST: guardar preferencias
if (Astro.request.method === 'POST') {
    const fd = await Astro.request.formData();
    const postAction = String(fd.get('action'));
    if (postAction === 'save_avatar') {
        const avatarUrl = String(fd.get('avatar_url') || '').trim();
        await setUserProfile({ avatar_url: avatarUrl || null });
        return Astro.redirect('/personal/perfil?saved=1');
    }
    if (postAction === 'save_profile') {
        const patch: Partial<UserProfile> = {
            display_name: String(fd.get('display_name') || '').trim().slice(0, 60) || undefined,
            region: String(fd.get('region') || '') || undefined,
            language: String(fd.get('language') || '') || undefined,
            theme: (String(fd.get('theme') || '') as UserProfile['theme']) || undefined,
        };
        await setUserProfile(patch);
        return Astro.redirect('/personal/perfil?saved=1');
    }
}

const profile = (await getUserProfile()) ?? {};
const saved = Astro.url.searchParams.get('saved') === '1';

const displayName = profile.display_name || user.name || (user.email ? user.email.split('@')[0] : 'Tú');
const region = profile.region || 'ES';
const language = profile.language || 'es-ES';
const theme = profile.theme || 'system';

// Iniciales para el fallback del avatar
const initials = (() => {
    const base = (profile.display_name || user.name || user.email || '?').trim();
    const parts = base.split(/\s+/);
    if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
    return base.slice(0, 2).toUpperCase();
})();

const icsUrl = `${Astro.url.origin}/api/calendar/subscribe.ics`;
---
<Layout title="Tu perfil — YourFavs">
    <div class="perfil-wrap">
        <h1 class="perfil-title">Tu perfil</h1>

        {saved && <div class="perfil-saved">✓ Cambios guardados</div>}

        <form method="POST" class="perfil-card">
            <input type="hidden" name="action" value="save_profile" />

            <!-- Identidad -->
            <section class="perfil-section">
                <h2 class="perfil-h2">Identidad</h2>
                <div class="perfil-identity">
                    <div class="perfil-avatar">
                        {user.picture
                            ? <img src={user.picture} alt="" referrerpolicy="no-referrer" />
                            : <span>{initials}</span>}
                    </div>
                    <div class="perfil-identity-fields">
                        <label class="perfil-field">
                            <span>Nombre visible</span>
                            <input type="text" name="display_name" value={displayName} maxlength="60" placeholder="Tu nombre" />
                        </label>
                        <label class="perfil-field">
                            <span>Email</span>
                            <input type="email" value={user.email ?? ''} disabled />
                            <small>El email no se puede cambiar.</small>
                        </label>
                        <button type="button" class="perfil-avatar-btn" id="avatar-open">
                            Cambiar avatar
                        </button>
                    </div>
                </div>
            </section>

            <!-- Preferencias -->
            <section class="perfil-section">
                <h2 class="perfil-h2">Preferencias</h2>
                <div class="perfil-grid">
                    <label class="perfil-field">
                        <span>Región de streaming</span>
                        <select name="region">
                            {SUPPORTED_COUNTRIES.map((c) => (
                                <option value={c.code} selected={c.code === region}>{c.label}</option>
                            ))}
                        </select>
                        <small>Plataformas que se muestran por defecto.</small>
                    </label>
                    <label class="perfil-field">
                        <span>Idioma de contenido</span>
                        <select name="language">
                            {LANGUAGES.map((l) => (
                                <option value={l.code} selected={l.code === language}>{l.label}</option>
                            ))}
                        </select>
                        <small>Sinopsis y títulos de TMDB.</small>
                    </label>
                    <label class="perfil-field">
                        <span>Tema</span>
                        <select name="theme" id="perfil-theme">
                            <option value="system" selected={theme === 'system'}>Según el sistema</option>
                            <option value="light" selected={theme === 'light'}>Claro</option>
                            <option value="dark" selected={theme === 'dark'}>Oscuro</option>
                        </select>
                    </label>
                </div>
            </section>

            <div class="perfil-actions">
                <button type="submit" class="perfil-save">Guardar cambios</button>
            </div>
        </form>

        <!-- Calendario ICS -->
        <section class="perfil-card">
            <h2 class="perfil-h2">Suscripción al calendario</h2>
            <p class="perfil-muted">Copia este enlace en tu app de calendario (Google, Apple, Outlook) para ver tus estrenos.</p>
            <div class="perfil-ics">
                <input type="text" id="ics-url" value={icsUrl} readonly />
                <button type="button" id="ics-copy" class="perfil-ics-btn">Copiar</button>
            </div>
        </section>

        <!-- Cuenta -->
        <section class="perfil-card">
            <h2 class="perfil-h2">Cuenta</h2>
            <p class="perfil-muted">Tus listas se conservan al cerrar sesión.</p>
            <div class="perfil-account-actions">
                <button type="button" class="perfil-logout" data-auth-logout>Cerrar sesión</button>
                <button type="button" class="perfil-delete" id="account-delete">Eliminar cuenta</button>
            </div>
        </section>
    </div>

    <!-- Modal de avatar (E.3) -->
    <div class="av-overlay" id="avatar-modal" role="dialog" aria-modal="true" aria-label="Elegir avatar" hidden>
        <div class="av-card">
            <div class="av-head">
                <h3>Elige tu avatar</h3>
                <button type="button" class="av-close" id="avatar-close" aria-label="Cerrar">✕</button>
            </div>
            <p class="av-sub">De tus actores favoritos.</p>
            <div class="av-grid" id="avatar-grid"><p class="av-state">Cargando…</p></div>
            <div class="av-foot">
                <button type="button" class="av-remove" id="avatar-remove">Quitar foto</button>
            </div>
        </div>
    </div>
    <form method="POST" id="avatar-form" hidden>
        <input type="hidden" name="action" value="save_avatar" />
        <input type="hidden" name="avatar_url" id="avatar-url-input" />
    </form>
</Layout>

<style>
    .perfil-wrap { max-width: 720px; margin: 0 auto; }
    .perfil-title { font-size: 26px; font-weight: 800; color: var(--text); margin: 0 0 18px; }
    .perfil-saved {
        background: rgba(16, 185, 129, .14); color: #10b981;
        padding: 10px 14px; border-radius: 10px; font-size: 14px; font-weight: 600; margin-bottom: 16px;
    }
    .perfil-card {
        background: var(--bg-elev); border: 1px solid var(--border);
        border-radius: 14px; padding: 22px; margin-bottom: 18px;
    }
    .perfil-section + .perfil-section { margin-top: 22px; padding-top: 22px; border-top: 1px solid var(--border); }
    .perfil-h2 { font-size: 15px; font-weight: 700; color: var(--text); margin: 0 0 14px; }
    .perfil-muted { font-size: 13px; color: var(--text-3); margin: 0 0 12px; }

    .perfil-identity { display: flex; gap: 18px; align-items: flex-start; flex-wrap: wrap; }
    .perfil-avatar {
        width: 76px; height: 76px; border-radius: 999px; flex-shrink: 0;
        background: #3b82f6; color: #fff; display: flex; align-items: center; justify-content: center;
        font-size: 26px; font-weight: 700; overflow: hidden;
    }
    .perfil-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .perfil-identity-fields { flex: 1; min-width: 240px; display: flex; flex-direction: column; gap: 12px; }

    .perfil-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    @media (max-width: 560px) { .perfil-grid { grid-template-columns: 1fr; } }

    .perfil-field { display: flex; flex-direction: column; gap: 5px; }
    .perfil-field > span { font-size: 12px; font-weight: 600; color: var(--text-2); }
    .perfil-field small { font-size: 11.5px; color: var(--text-4); }
    .perfil-field input, .perfil-field select {
        width: 100%; padding: 10px 12px; border-radius: 9px;
        border: 1px solid var(--border); background: var(--bg); color: var(--text);
        font-size: 14px; font-family: inherit;
    }
    .perfil-field input:focus, .perfil-field select:focus {
        outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft);
    }
    .perfil-field input:disabled { opacity: .6; cursor: not-allowed; }

    .perfil-avatar-btn {
        align-self: flex-start; padding: 7px 13px; border-radius: 8px;
        border: 1px solid var(--border); background: var(--bg-tint); color: var(--text-2);
        font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit;
    }
    .perfil-avatar-btn:hover { border-color: var(--border-strong); color: var(--text); }

    /* Modal de avatar */
    .av-overlay {
        position: fixed; inset: 0; z-index: 10002;
        background: rgba(15, 23, 42, .55); backdrop-filter: blur(3px);
        display: none; align-items: flex-start; justify-content: center; padding: 8vh 16px 16px;
    }
    .av-overlay.is-open { display: flex; }
    .av-card {
        width: 460px; max-width: 100%; background: var(--bg-elev);
        border: 1px solid var(--border); border-radius: 14px; padding: 20px;
        box-shadow: 0 30px 80px rgba(0,0,0,.5); max-height: 80vh; overflow-y: auto;
    }
    .av-head { display: flex; align-items: center; justify-content: space-between; }
    .av-head h3 { margin: 0; font-size: 17px; font-weight: 700; color: var(--text); }
    .av-close {
        width: 30px; height: 30px; border-radius: 999px; border: 1px solid var(--border);
        background: var(--bg-tint); color: var(--text-3); cursor: pointer; font-size: 14px;
    }
    .av-sub { margin: 4px 0 14px; font-size: 13px; color: var(--text-3); }
    .av-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); gap: 10px;
    }
    .av-state { grid-column: 1 / -1; text-align: center; color: var(--text-3); font-size: 13px; padding: 20px 0; }
    .av-pick {
        padding: 0; border: 2px solid transparent; border-radius: 999px; cursor: pointer;
        background: var(--bg-tint); aspect-ratio: 1; overflow: hidden;
    }
    .av-pick:hover { border-color: var(--accent); }
    .av-pick img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .av-foot { margin-top: 16px; display: flex; justify-content: flex-end; border-top: 1px solid var(--border); padding-top: 14px; }
    .av-remove {
        padding: 8px 14px; border-radius: 8px; border: 1px solid var(--border);
        background: none; color: var(--text-3); font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit;
    }
    .av-remove:hover { color: #ef4444; border-color: rgba(239,68,68,.3); }

    .perfil-actions { margin-top: 20px; display: flex; justify-content: flex-end; }
    .perfil-save {
        padding: 11px 22px; border-radius: var(--r-full, 999px); border: none;
        background: var(--accent); color: #fff; font-size: 14px; font-weight: 600; cursor: pointer; font-family: inherit;
    }
    .perfil-save:hover { background: var(--accent-dark, var(--accent)); }

    .perfil-ics { display: flex; gap: 8px; }
    .perfil-ics input {
        flex: 1; padding: 10px 12px; border-radius: 9px; border: 1px solid var(--border);
        background: var(--bg); color: var(--text-3); font-size: 13px; font-family: var(--font-mono, monospace);
    }
    .perfil-ics-btn, .perfil-logout, .perfil-delete {
        padding: 10px 16px; border-radius: 9px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit;
        border: 1px solid var(--border); background: var(--bg-tint); color: var(--text-2); white-space: nowrap;
    }
    .perfil-ics-btn:hover { border-color: var(--border-strong); color: var(--text); }
    .perfil-account-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .perfil-delete { color: #ef4444; border-color: rgba(239,68,68,.3); cursor: pointer; }
    .perfil-delete:hover { background: rgba(239,68,68,.1); }
    .perfil-delete:disabled { opacity: .55; cursor: progress; }
</style>

<script>
    // Tema: aplica al instante (data-theme + localStorage) al cambiar el select,
    // además de guardarse en el perfil al enviar el form (sync entre dispositivos).
    const themeSel = document.getElementById('perfil-theme') as HTMLSelectElement | null;
    themeSel?.addEventListener('change', () => {
        const v = themeSel.value;
        const effective = v === 'system' ? 'light' : v; // 'system' → claro por defecto (igual que el Layout)
        document.documentElement.setAttribute('data-theme', effective);
        try { localStorage.setItem('theme', effective); } catch { /* noop */ }
    });

    // Copiar enlace ICS
    const icsBtn = document.getElementById('ics-copy');
    const icsInput = document.getElementById('ics-url') as HTMLInputElement | null;
    icsBtn?.addEventListener('click', async () => {
        if (!icsInput) return;
        try {
            await navigator.clipboard.writeText(icsInput.value);
            icsBtn.textContent = '¡Copiado!';
        } catch {
            icsInput.select();
            document.execCommand('copy');
            icsBtn.textContent = '¡Copiado!';
        }
        setTimeout(() => { icsBtn.textContent = 'Copiar'; }, 1800);
    });

    // Modal de avatar (E.3)
    const avOpen = document.getElementById('avatar-open');
    const avModal = document.getElementById('avatar-modal');
    const avClose = document.getElementById('avatar-close');
    const avGrid = document.getElementById('avatar-grid');
    const avRemove = document.getElementById('avatar-remove');
    const avForm = document.getElementById('avatar-form') as HTMLFormElement | null;
    const avInput = document.getElementById('avatar-url-input') as HTMLInputElement | null;
    let avLoaded = false;

    function avCloseModal() {
        avModal?.classList.remove('is-open');
        if (avModal) avModal.hidden = true;
        document.body.style.overflow = '';
    }
    async function avLoad() {
        if (!avGrid) return;
        try {
            const res = await fetch('/api/profile/avatar-options');
            const data = await res.json();
            const opts: string[] = data.options || [];
            avLoaded = true;
            avGrid.innerHTML = opts.length
                ? opts.map((u) => `<button type="button" class="av-pick" data-url="${u}"><img src="${u}" alt="" loading="lazy" /></button>`).join('')
                : '<p class="av-state">Añade actores a tus favoritos para elegir un avatar.</p>';
        } catch {
            avGrid.innerHTML = '<p class="av-state">No se pudieron cargar las imágenes.</p>';
        }
    }
    function avPick(url: string) {
        if (!avForm || !avInput) return;
        avInput.value = url;
        avForm.submit(); // submit() nativo → POST limpio (no pasa por el interceptor)
    }
    avOpen?.addEventListener('click', () => {
        if (!avModal) return;
        avModal.hidden = false;
        avModal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        if (!avLoaded) avLoad();
    });
    avClose?.addEventListener('click', avCloseModal);
    avModal?.addEventListener('mousedown', (e) => { if (e.target === avModal) avCloseModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && avModal?.classList.contains('is-open')) avCloseModal(); });
    avGrid?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.av-pick') as HTMLElement | null;
        if (btn) avPick(btn.getAttribute('data-url') || '');
    });
    avRemove?.addEventListener('click', () => avPick('')); // '' → quita avatar (vuelve a Google/iniciales)

    // Eliminar cuenta (E.5)
    const delBtn = document.getElementById('account-delete') as HTMLButtonElement | null;
    delBtn?.addEventListener('click', async () => {
        const ok = confirm('¿Eliminar tu cuenta? Se borrarán TODAS tus listas y tu perfil. Esta acción NO se puede deshacer.');
        if (!ok) return;
        delBtn.disabled = true;
        delBtn.textContent = 'Eliminando…';
        try {
            const res = await fetch('/api/auth/delete-account', { method: 'POST' });
            if (!res.ok) throw new Error();
            try {
                const { clientAuth } = await import('../../utils/firebaseAuthClient');
                const { signOut } = await import('firebase/auth');
                await signOut(clientAuth);
            } catch { /* la cuenta ya no existe; da igual */ }
            location.href = '/';
        } catch {
            delBtn.disabled = false;
            delBtn.textContent = 'Eliminar cuenta';
            alert('No se pudo eliminar la cuenta. Inténtalo de nuevo.');
        }
    });
</script>
