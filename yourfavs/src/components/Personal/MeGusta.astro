---
import CardSerie from "../Cards/CardSerie.astro";
import CardMovie from "../Cards/CardMovie.astro";
import {
    getLikedSeries,
} from "../../services/BD/yourfavsSerie";
import {
    getLikedMovies,
} from "../../services/BD/yourfavsMovie";
import {fetchSerieDetails} from "../../services/API/Series/tmdbSeries";
import {fetchMovieDetails} from "../../services/API/Movies/tmdbMovies";

// 🔹 Obtener IDs desde Firebase
const seriesMeGustanIds = (await getLikedSeries()).map(s => s.id);
const moviesMeGustanIds = (await getLikedMovies()).map(m => m.id);

// 🔹 Obtener detalles desde TMDB
const likedSeries = await Promise.all(seriesMeGustanIds.map(id => fetchSerieDetails(id)));
const likedMovies = await Promise.all(moviesMeGustanIds.map(id => fetchMovieDetails(id)));

const filter = Astro.url.searchParams.get("filter") || "todos";
const searchQuery = Astro.url.searchParams.get("search") || "";
const genreFilter = Astro.url.searchParams.get("genre") || "";

const showSeries = filter === "series" || filter === "todos";
const showMovies = filter === "peliculas" || filter === "todos";
const showAll = filter === "todos";

// Definir los géneros comunes
const genresMap: Record<number, string> = {
    // Géneros de películas y series
    28: "Acción",
    12: "Aventura",
    16: "Animación",
    35: "Comedia",
    80: "Crimen",
    99: "Documental",
    18: "Drama",
    10751: "Familia",
    14: "Fantasía",
    36: "Historia",
    27: "Terror",
    10402: "Música",
    9648: "Misterio",
    10749: "Romance",
    878: "Ciencia ficción",
    10770: "Película de TV",
    53: "Thriller",
    10752: "Bélica",
    37: "Western",
    // Géneros exclusivos de series
    10759: "Acción y Aventura",
    10762: "Infantil",
    10763: "Noticias",
    10764: "Reality",
    10765: "Sci-Fi y Fantasía",
    10766: "Soap",
    10767: "Talk",
    10768: "Guerra y Política"
};

// Función para obtener el nombre del género según su ID
function getGenreName(id: number): string {
    return genresMap[id] || "Otro";
}

// Paginación - obtener parámetros
const seriesPage = parseInt(Astro.url.searchParams.get("seriesPage") || "1");
const moviesPage = parseInt(Astro.url.searchParams.get("moviesPage") || "1");

const ITEMS_PER_PAGE = 20;

// Calcular elementos a mostrar
const seriesItemsToShow = seriesPage * ITEMS_PER_PAGE;
const moviesItemsToShow = moviesPage * ITEMS_PER_PAGE;

const seriesPaginadas = likedSeries.slice(0, seriesItemsToShow);
const peliculasPaginadas = likedMovies.slice(0, moviesItemsToShow);

const hasMoreSeries = likedSeries.length > seriesItemsToShow;
const hasMoreMovies = likedMovies.length > moviesItemsToShow;

// Función para construir URL con parámetros
function buildUrl(params: Record<string, string>) {
    const url = new URL(Astro.url);
    Object.entries(params).forEach(([key, value]) => {
        if (value && value !== 'todos' && value !== '' && value !== '1') {
            url.searchParams.set(key, value);
        } else {
            url.searchParams.delete(key);
        }
    });
    return url.pathname + url.search;
}

// 🔹 Función para calcular estadísticas
function calculateStats() {
    const currentYear = new Date().getFullYear();

    // Estadísticas de series
    const seriesStats = {
        total: likedSeries.length,
        enEmision: likedSeries.filter(s => s.status === 'Returning Series').length,
        finalizadas: likedSeries.filter(s => s.status === 'Ended').length,
        temporadasTotal: likedSeries.reduce((acc, s) => acc + (s.number_of_seasons || 0), 0),
        episodiosTotal: likedSeries.reduce((acc, s) => acc + (s.number_of_episodes || 0), 0),
        añoMasAntiguo: Math.min(...likedSeries.map(s => new Date(s.first_air_date || currentYear).getFullYear()).filter(year => !isNaN(year))),
        añoMasReciente: Math.max(...likedSeries.map(s => new Date(s.first_air_date || 0).getFullYear()).filter(year => !isNaN(year))),
        notaPromedio: Number((likedSeries.reduce((acc, s) => acc + (s.vote_average || 0), 0) / Math.max(likedSeries.length, 1)).toFixed(1))
    };

    // Estadísticas de películas
    const moviesStats = {
        total: likedMovies.length,
        añoMasAntiguo: Math.min(...likedMovies.map(p => new Date(p.release_date || currentYear).getFullYear()).filter(year => !isNaN(year))),
        añoMasReciente: Math.max(...likedMovies.map(p => new Date(p.release_date || 0).getFullYear()).filter(year => !isNaN(year))),
        notaPromedio: Number((likedMovies.reduce((acc, p) => acc + (p.vote_average || 0), 0) / Math.max(likedMovies.length, 1)).toFixed(1)),
        duracionPromedio: Math.round(likedMovies.reduce((acc, p) => acc + (p.runtime || 0), 0) / Math.max(likedMovies.length, 1))
    };

    // Géneros más populares (combinando series y películas)
    const genreCount = new Map();

    [...likedSeries, ...likedMovies].forEach(item => {
        const genres =
            item.genres ||
            item.genre_ids?.map((id: number) => ({ id, name: getGenreName(id) })) ||
            [];

        genres.forEach((genre: { name: string } | number) => {
            const genreName = typeof genre === 'object' ? genre.name : getGenreName(genre);
            genreCount.set(genreName, (genreCount.get(genreName) || 0) + 1);
        });
    });

    const topGenres = Array.from(genreCount.entries())
        .sort(([,a], [,b]) => b - a)
        .slice(0, 5)
        .map(([name, count]) => ({ name, count }));

    // Décadas más populares
    const decadeCount = new Map();

    [...likedSeries, ...likedMovies].forEach(item => {
        const date = item.release_date || item.first_air_date;
        if (date) {
            const year = new Date(date).getFullYear();
            const decade = Math.floor(year / 10) * 10;
            decadeCount.set(`${decade}s`, (decadeCount.get(`${decade}s`) || 0) + 1);
        }
    });

    const topDecades = Array.from(decadeCount.entries())
        .sort(([,a], [,b]) => b - a)
        .slice(0, 3);

    return {
        series: seriesStats,
        movies: moviesStats,
        general: {
            totalContent: likedSeries.length + likedMovies.length,
            topGenres,
            topDecades,
            notaPromedioGeneral: (((seriesStats.notaPromedio * likedSeries.length) + (moviesStats.notaPromedio * likedMovies.length)) / Math.max(likedSeries.length + likedMovies.length, 1)).toFixed(1)
        }
    };
}

const stats = calculateStats();
