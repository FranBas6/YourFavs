---
import Layout from '../layouts/Layout.astro';
---
{/* Sin canonical y fuera de buscadores (QA 1.4, H75). */}
<Layout title="404: Página no encontrada" robots="noindex" canonical={false}>
    <section class="flex flex-col items-center justify-center text-center py-16 px-4 min-h-[60vh]">
        <!-- Kicker mono -->
        <p class="mb-3" style="font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent-ink);">
            Error 404 · Escena cortada
        </p>

        <!-- Número 404 con gradiente -->
        <div class="relative mb-6">
            <h1 class="text-[10rem] sm:text-[12rem] font-bold leading-none tracking-tighter"
                style="background: linear-gradient(135deg, #3b82f6, #8b5cf6, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                404
            </h1>
            <div class="absolute inset-0 blur-3xl opacity-20"
                 style="background: linear-gradient(135deg, #3b82f6, #8b5cf6, #ec4899);"></div>
        </div>

        <h2 class="text-2xl sm:text-3xl font-bold text-gray-800 mb-3">
            Esta página no existe
        </h2>

        <p class="text-gray-500 text-lg max-w-md mb-8 leading-relaxed">
            Parece que esta ruta no lleva a ninguna película ni serie, pero hay mucho más por descubrir.
        </p>

        {/* La claqueta de la marca (QA 1.4, H80): antes un gif enlazado de midu.dev, con derechos y bloqueado por Chrome. */}
        <div class="nf-ic" aria-hidden="true"><img src="/favicon.svg" alt="" width="120" height="120" /></div>

        <div class="flex flex-col sm:flex-row gap-3">
            <a href="/"
               class="px-6 py-3 rounded-full text-white font-semibold bg-[#E63946] hover:bg-[#C7283A] transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5">
                Volver al inicio
            </a>
            <a href="/catalogo/tendencias"
               class="px-6 py-3 rounded-full font-semibold border border-gray-200 text-gray-700 hover:border-gray-400 hover:text-gray-900 transition-all">
                Ver tendencias
            </a>
        </div>
    </section>
</Layout>

<style>
    .nf-ic { width: 168px; height: 168px; margin-bottom: 40px; border-radius: 40px; display: grid; place-items: center;
        background: #0B1220; box-shadow: var(--sh-lg); transform: rotate(-4deg); }
    .nf-ic img { width: 120px; height: 120px; }
</style>
