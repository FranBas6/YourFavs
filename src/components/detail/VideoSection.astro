---
import { formatTrailerUrl } from "../../utils/constants/helpers/media-helpers";

interface Video {
    name: string;
    key: string;
}

interface Props {
    trailerUrl?: string | null;
    clips?: Video[];
    behindScenes?: Video[];
    teasers?: Video[];
}

const { trailerUrl, clips = [], behindScenes = [], teasers = [] } = Astro.props;
const extrasTotal = clips.length + behindScenes.length + teasers.length;
// Rediseño 4.5: «Más vídeos» agrupado por tipo (hasta 4 de cada), con su rótulo.
const groups = [
    { label: 'Clips', items: clips.slice(0, 4) },
    { label: 'Teasers', items: teasers.slice(0, 4) },
    { label: 'Detrás de las cámaras', items: behindScenes.slice(0, 4) },
].filter((g) => g.items.length > 0);
---
{trailerUrl && (
    <section>
        <div class="fsec-h"><h2>Tráiler y vídeos</h2>{groups.length > 0 && <span class="n">{1 + groups.reduce((n, g) => n + g.items.length, 0)}</span>}</div>
        <div class="aspect-video rounded-xl overflow-hidden fvid">
            <iframe src={formatTrailerUrl(trailerUrl)} class="w-full h-full" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
        </div>
    </section>
)}

{extrasTotal > 0 && (
    <details class="cdet fvid-more">
        <summary>Más vídeos<span class="n">{groups.map((g) => `${g.label} ${g.items.length}`).join(' · ')}</span><svg class="cdet-car" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
        <div class="cdet-b space-y-5">
            {groups.map((g) => (
                <div>
                    <h3 class="vs-type">{g.label}</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {g.items.map((video) => (
                            <div>
                                <p class="text-xs text-gray-500 mb-1 truncate">{video.name}</p>
                                <div class="aspect-video rounded-lg overflow-hidden">
                                    <iframe src={formatTrailerUrl(video.key)} class="w-full h-full" allowfullscreen loading="lazy"></iframe>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </details>
)}
