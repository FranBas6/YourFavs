---
import Layout from "../../layouts/Layout.astro"
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import {getSerieFav} from "../../services/BD/series/yourfavsSerie";
import {getMovieFav} from "../../services/BD/movies/yourfavsMovie";
import {getGenreName} from "../../utils/constants/genres";
import {buildUrl} from "../../utils/buildUrl";
import {fetchPersonalPageData} from "../../utils/personalPageHelper";
import StatsPanel from "../../components/personal/StatsPanel.astro";
import PersonalNav from "../../components/personal/PersonalNav.astro";
import PersonalFilter from "../../components/personal/PersonalFilter.astro";
import PersonalResultsBar from "../../components/personal/PersonalResultsBar.astro";
import EmptyState from "../../components/EmptyState.astro";
import HoverPreview from "../../components/HoverPreview.astro";
import '../../styles/pages/personal/personal.css';

const data = await fetchPersonalPageData(
    { getSeries: getSerieFav, getMovies: getMovieFav },
    Astro.url
);

const {
    filter, searchQuery, genreFilter, platformFilter,
    showSeries, showMovies, showAll,
    seriesPage, moviesPage, pageUrl, itemsPerPage,
    seriesItems: seriesFavoritas,
    filteredSeries, filteredMovies,
    seriesPaginadas, peliculasPaginadas,
    hasMoreSeries, hasMoreMovies,
    seriesItemsToShow, moviesItemsToShow,
    availableGenres, availableTags, tagsFilter, stats, watchedMap, errorMessage,
} = data;
---
<Layout title="Favoritos">
    <section class="px-1 sm:py-8">
        {errorMessage && (
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm mb-6">
                {errorMessage}
            </div>
        )}

        <header class="mb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Favoritos</h1>
            <p class="text-gray-500 text-base">Tu colección de películas y series favoritas</p>
        </header>

        <div class="flex items-start gap-3 mb-6">
            <div class="flex-1 min-w-0">
                <PersonalNav currentPage="/personal/favoritos" />
            </div>
            <PersonalFilter pageUrl={pageUrl} filter={filter} searchQuery={searchQuery} genreFilter={genreFilter} platformFilter={platformFilter} availableGenres={availableGenres} tagsFilter={tagsFilter} availableTags={availableTags} />
        </div>
        <StatsPanel stats={stats} />

        <PersonalResultsBar
            shown={seriesPaginadas.length + peliculasPaginadas.length}
            total={filteredSeries.length + filteredMovies.length}
            movies={filteredMovies.length}
            series={filteredSeries.length}
        />

        <div class="space-y-10">
            {/* Series */}
            {(showSeries || showAll) && (
                <section id="series-section" class="scroll-mt-20">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-xl font-semibold text-gray-800 flex items-center gap-2">
                            <span class="w-1 h-6 bg-blue-500 rounded-full"></span>
                            Series
                            <span class="text-sm font-normal text-gray-4000">({filteredSeries.length})</span>
                        </h2>
                    </div>

                    {seriesPaginadas.length === 0 && (
                        <EmptyState size="sm" title="Aún no tienes series en esta colección">
                            <a slot="cta" href="/catalogo/tendencias" class="inline-flex items-center gap-2 px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors text-sm font-medium">Explorar tendencias</a>
                        </EmptyState>
                    )}
                    {seriesPaginadas.length > 0 && (
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                            {seriesPaginadas.map((item) => {
                                const realPos = seriesFavoritas.findIndex((s: any) => s.id === item.id) + 1;
                                return (
                                <HoverPreview tmdbId={item.id} tmdbType="tv" title={item.name} backdropPath={item.backdrop_path} href={`/serie/${item.id}`} year={item.first_air_date?.slice(0,4)} rating={item.vote_average}><CardSerie
                                    id={item.id.toString()}
                                    img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                    name={item.name}
                                    vote_average={item.vote_average}
                                    overview={item.overview}
                                    first_air_date={item.first_air_date}
                                    seasons={item.seasons}
                                    last_episode_to_air={item.last_episode_to_air}
                                    next_episode_to_air={item.next_episode_to_air}
                                    genres={item.genre_ids?.map((gId: number) => ({ id: gId, name: getGenreName(gId) }))}
                                    status={item.status}
                                    favoriteNumber={realPos}
                                    watchedEpisodes={watchedMap[String(item.id)]?.watched}
                                /></HoverPreview>);
                            })}
                        </div>
                    )}
                    {hasMoreSeries && (
                        <div class="flex justify-center mt-6">
                            <a href={buildUrl(pageUrl, {
                                    filter: filter, search: searchQuery, genre: genreFilter, platforms: platformFilter,
                                    seriesPage: Math.ceil(filteredSeries.length / itemsPerPage).toString(),
                                    moviesPage: moviesPage.toString()
                                }) + '#series-section'}
                               class="flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 shadow-sm hover:shadow-md transition-all">
                                Mostrar {filteredSeries.length - seriesItemsToShow} series más
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                                </svg>
                            </a>
                        </div>
                    )}
                </section>
            )}

            {/* Películas */}
            {(showMovies || showAll) && (
                <section id="movies-section" class="scroll-mt-20">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-xl font-semibold text-gray-800 flex items-center gap-2">
                            <span class="w-1 h-6 bg-red-500 rounded-full"></span>
                            Películas
                            <span class="text-sm font-normal text-gray-4000">({filteredMovies.length})</span>
                        </h2>
                    </div>

                    {peliculasPaginadas.length === 0 && (
                        <EmptyState size="sm" title="Aún no tienes películas en esta colección">
                            <a slot="cta" href="/catalogo/tendencias" class="inline-flex items-center gap-2 px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors text-sm font-medium">Explorar tendencias</a>
                        </EmptyState>
                    )}
                    {peliculasPaginadas.length > 0 && (
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                            {peliculasPaginadas.map((item) => (
                                <HoverPreview tmdbId={item.id} tmdbType="movie" title={item.title} backdropPath={item.backdrop_path} href={`/movie/${item.id}`} year={item.release_date?.slice(0,4)} rating={item.vote_average}><CardMovie
                                    id={item.id.toString()}
                                    img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                    title={item.title}
                                    vote_average={item.vote_average}
                                    overview={item.overview}
                                    release_date={item.release_date}
                                    genres={item.genre_ids?.map((gId: number) => ({ id: gId, name: getGenreName(gId) }))}
                                /></HoverPreview>
                            ))}
                        </div>
                    )}
                    {hasMoreMovies && (
                        <div class="flex justify-center mt-6">
                            <a href={buildUrl(pageUrl, {
                                    filter: filter, search: searchQuery, genre: genreFilter, platforms: platformFilter,
                                    seriesPage: seriesPage.toString(),
                                    moviesPage: Math.ceil(filteredMovies.length / itemsPerPage).toString()
                                }) + '#movies-section'}
                               class="flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-medium text-white bg-red-600 hover:bg-red-700 shadow-sm hover:shadow-md transition-all">
                                Mostrar {filteredMovies.length - moviesItemsToShow} películas más
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                                </svg>
                            </a>
                        </div>
                    )}
                </section>
            )}
        </div>
    </section>
</Layout>
