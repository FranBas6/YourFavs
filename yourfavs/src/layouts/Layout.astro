---
import Header from "../components/Header.astro";
import CommandPalette from "../components/CommandPalette.astro";
import AuthModal from "../components/AuthModal.astro";
import SaveToPopover from "../components/SaveToPopover.astro";
import Coach from "../components/Coach.astro";
import MobileTabBar from "../components/MobileTabBar.astro";
import MobileNavSheets from "../components/MobileNavSheets.astro";
import SocialLayer from "../components/social/SocialLayer.astro";
import "../styles/tokens.css";
import "../styles/layout.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/components/social-ui.css";   // botones, filas y avisos sociales (F2+)
import "../styles/components/recommend.css";   // recomendar a un amigo (F4)
import "../styles/components/messages-row.css"; // filas de conversación (mensajes M1+, también en la cabecera)
import "../styles/dark-mode.css";   // <- el ÚLTIMO: las reglas [data-theme="dark"] ganan en cascada

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    ogType?: string;
    /**
     * `<meta name="robots">`. Ausente = no se pinta (lo de siempre). El perfil público manda
     * `noindex, nofollow` salvo que su dueño active «Que aparezca en buscadores».
     */
    robots?: string;
    /** URL canónica absoluta para `og:url` (el perfil público usa la de producción). */
    ogUrl?: string;
}

const {
    title,
    description = "Tu plataforma favorita para descubrir películas y series",
    ogImage = "/og-image.png",
    ogType = "website",
    robots,
    ogUrl,
} = Astro.props;

// Pista post-guardado (Fase F · Acceso C): elegible si hay sesión y el usuario
// NO ha completado el onboarding (undefined o 'skipped' → se le puede invitar;
// 'done' → no molestar). El JS decide cuándo mostrarla (tras guardar, 1 vez).
const tasteHintEligible = !!Astro.locals.user && Astro.locals.user.onboarding !== 'done';

// Tab bar móvil: oculta en flujos a pantalla completa (onboarding/auth).
const _tbPath = Astro.url.pathname;
// También dentro de una conversación de mensajes: va a pantalla completa (handoff de mensajes §9).
const hideTabbar = ['/gustos', '/login', '/registro'].some(p => _tbPath === p || _tbPath.startsWith(p + '/'))
    || /^\/mislistas\/amigos\/mensajes\/\d+\/?$/.test(_tbPath);
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <!-- El favicon de la pestaña NO se toca: es el logo de siempre. Lo único corregido es el
         `type`, que decía `image/svg+xml` apuntando a un PNG. Los iconos de la app instalada
         (apple-touch-icon y manifest) son otra cosa y van aparte, aquí debajo. -->
    <link rel="icon" type="image/png" href="/logo_yourfavs.png"/>
    <meta name="generator" content={Astro.generator}/>
    <meta name="description" content={description}/>
    <meta name="theme-color" content="#3B82F6"/>
    <link rel="canonical" href={Astro.url.href}/>
    <!-- App instalable. El `apple-touch-icon` de aquí abajo ya se enlazaba, pero el archivo
         NO existía: era un 404, y por eso iOS ponía una captura de la página en la pantalla
         de inicio en vez del logo. Lo genera `scripts/build-pwa-icons.mjs`. -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <link rel="manifest" href="/manifest.webmanifest"/>
    <meta name="apple-mobile-web-app-capable" content="yes"/>
    <meta name="mobile-web-app-capable" content="yes"/>
    <!-- `default` y no `black-translucent` a propósito: el translúcido mete el contenido bajo
         la barra de estado, y el layout no tiene padding superior de safe-area (el tabbar sí
         lo tiene abajo). Con `default`, la cabecera azul empieza donde debe. -->
    <meta name="apple-mobile-web-app-status-bar-style" content="default"/>
    <meta name="apple-mobile-web-app-title" content="YourFavs"/>
    <meta property="og:image" content={ogImage}/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={ogImage}/>
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F3F4F6"/>
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0B1220"/>
    <script is:inline>
        (function () {
            try {
                // Dos claves, a propósito:
                //   themeChoice = lo que ELIGIÓ el usuario ('light'|'dark'|'system')
                //   theme       = lo que se APLICA ('light'|'dark')
                // Antes solo existía `theme`, así que quien viene de una versión anterior
                // no tiene `themeChoice`: se usa su `theme` como elección. Sin nada previo,
                // claro — el default de siempre, que NO sigue al SO salvo que se pida.
                var choice = localStorage.getItem('themeChoice') || localStorage.getItem('theme') || 'light';
                var theme = choice === 'system'
                    ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                    : choice;
                document.documentElement.setAttribute('data-theme', theme);
            } catch {}
        })();
    </script>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:type" content={ogType}/>
    {ogUrl && <meta property="og:url" content={ogUrl}/>}
    {robots && <meta name="robots" content={robots}/>}
    <title>{title}</title>
</head>
<body id="top" class="bg-light-gray min-h-screen pb-16 sm:pb-24 md:pb-32 font-poppins" data-taste-hint={tasteHintEligible ? 'eligible' : ''}>
<a href="#content" class="skip-link">Saltar al contenido</a>
<Header/>
<CommandPalette/>
<AuthModal/>
<SaveToPopover/>
<Coach/>
{Astro.locals.user && <SocialLayer/>}

<main id="content" class="max-w-7xl w-full px-3 sm:px-6 lg:px-8 mx-auto pt-4 sm:pt-6 md:pt-8 lg:pt-10">
    <slot/>

    <!-- Botón flotante para volver arriba -->
    <div class="back-to-top-container">
        <a href="#top" title="Subir al inicio" aria-label="Subir al inicio" class="back-to-top">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
            </svg>
        </a>
    </div>
</main>
<footer class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 mt-16 py-8 border-t border-gray-200">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-gray-500">
        <p>&copy; {new Date().getFullYear()} YourFavs</p>
        <div class="flex items-center gap-6">
            <a href="/about" class="hover:text-blue-600 transition">Acerca de</a>
            <span class="text-gray-300">·</span>
            <a href="https://www.themoviedb.org/" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-blue-600 transition">
                Datos de TMDB
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
            </a>
        </div>
    </div>
</footer>
<script is:inline>
    (function () {
        // Back-to-top
        var el = document.querySelector('.back-to-top-container');
        if (el) {
            var reveal = function () {
                var scrolled = window.scrollY || document.documentElement.scrollTop;
                if (scrolled > 400) el.classList.add('is-visible'); else el.classList.remove('is-visible');
            };
            reveal();
            window.addEventListener('scroll', reveal, { passive: true });
        }

        // Tema: ÚNICO punto que aplica y persiste. Lo usan el toggle del header, el
        // segmentado del menú de escritorio, el de la hoja móvil y Ajustes → Apariencia,
        // para que "según el sistema" signifique lo mismo en los cuatro sitios (antes cada
        // uno escribía localStorage a su manera y 'system' acababa aplicando claro).
        function resolveTheme(choice) {
            return choice === 'system'
                ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                : choice;
        }
        window.yfApplyTheme = function (choice) {
            var theme = resolveTheme(choice);
            document.documentElement.setAttribute('data-theme', theme);
            try {
                localStorage.setItem('themeChoice', choice);
                localStorage.setItem('theme', theme);
            } catch {}
            // Avisa a los otros controles para que marquen la misma opción sin recargar.
            document.dispatchEvent(new CustomEvent('yf:theme', { detail: { choice: choice, theme: theme } }));
        };

        // Con "según el sistema" elegido, seguir al SO en vivo (sin recargar).
        try {
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
                var c = null;
                try { c = localStorage.getItem('themeChoice'); } catch {}
                if (c === 'system') window.yfApplyTheme('system');
            });
        } catch {}

        // Toggle binario del header (invitados): claro ⇄ oscuro.
        document.querySelectorAll('.theme-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                window.yfApplyTheme(next);
            });
        });
    })();
</script>
<div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>
{!hideTabbar && <MobileTabBar />}
{!hideTabbar && <MobileNavSheets />}
<script is:inline src="/js/hover-preview.js" defer></script>
<script is:inline src="/js/scroll-restore.js"></script>
{import.meta.env.PROD && (
    <script is:inline>
        // Service worker (ver public/sw.js). Solo en producción a propósito: en `astro dev`
        // una caché de assets pelea con el HMR de Vite y acabas depurando fantasmas.
        // Va en `load` para no competir por red con el primer render.
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js').catch(function () { /* sin SW se vive igual */ });
            });
        }
    </script>
)}
</body>
</html>
