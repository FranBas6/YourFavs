                                                             viewBox="0 0 24 24"
                                                             stroke="currentColor">
                                                            <path stroke-linecap="round"
                                                                  stroke-linejoin="round"
                                                                  stroke-width="2"
                                                                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                        </svg>
                                                                                        {formatRuntime(episode.runtime)}
                                                    </span>
                                                                            )}
                                                                            {episode.vote_average > 0 && (
                                                                                    <span class="flex items-center gap-1">
                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                             class="h-3 w-3 text-yellow-500"
                                                             fill="currentColor"
                                                             viewBox="0 0 24 24">
                                                            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                                                        </svg>
                                                                                        {episode.vote_average.toFixed(1)}
                                                    </span>
                                                                            )}
                                                                        </div>
                                                                    </div>
                                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                                         class={`h-4 w-4 opacity-0 group-hover:opacity-100 transition-opacity ${season.season_number === 0 ? 'text-purple-500' : 'text-blue-500'}`}
                                                                         fill="none" viewBox="0 0 24 24"
                                                                         stroke="currentColor">
                                                                        <path stroke-linecap="round"
                                                                              stroke-linejoin="round" stroke-width="2"
                                                                              d="M9 5l7 7-7 7"/>
                                                                    </svg>
                                                                </div>
                                                            </summary>

                                                            <div class={`mt-2 px-3 py-2 rounded-lg ${season.season_number === 0 ? 'bg-purple-50' : 'bg-blue-50'}`}>
