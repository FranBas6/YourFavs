---
/**
 * Productora — rediseño, Fase 6 · 6.4: mismo esquema que actor y equipo. Cabecera con el logo, nombre,
 * «Productora · Estados Unidos · Burbank», Recomendar y «Conocido por»; dos columnas: «Acerca de» plegable
 * y la filmografía en lista; al lado, Datos (antes, tres tarjetas con emojis y barras naranjas: los
 * mismos datos — géneros, década más activa, nota media, mejor película y serie — en lista sobria).
 */
import Layout from "../../layouts/Layout.astro";
import { getMoviesAndSeriesByCompanyName } from "../../services/API/Productora/InfoProductora";
import { getGenreName } from "../../utils/constants/genres";
import { posterUrl } from "../../services/API/shared/tmdbClient";
import { SOCIAL_PHASE } from "../../utils/constants/social";
import { seenKeySet } from "../../utils/seenKeys";
import FilmographyList, { type FilmRow } from "../../components/person/FilmographyList.astro";
import '../../styles/shared/detail-common.css';
import '../../styles/pages/actor/actor.css';

const { name } = Astro.params;
const { searchParams } = Astro.url;
const companyIdParam = searchParams.get('companyId');

if (!name) {
    throw new Error("Nombre de la productora no encontrado en la URL");
}

// Orden de la lista (los enlaces viejos ?sort=quality|popularity|date siguen valiendo).
const OLD_SORT: Record<string, string> = { quality: 'nota', popularity: 'peso', date: 'fecha' };
const rawSort = searchParams.get('sort') || 'peso';
const filmSort = OLD_SORT[rawSort] || rawSort;

const { success, companyInfo, movies, series, error } = await getMoviesAndSeriesByCompanyName(
    name,
    'quality',
    undefined,
    companyIdParam ? parseInt(companyIdParam, 10) : undefined
);

if (!success) {
    throw new Error(error || "Error al obtener información de la productora");
}

const displayName = companyInfo?.name || name;
// F4 social: la productora se recomienda por su id de TMDB (la ruta va por nombre).
const companyId = Number(companyInfo?.id ?? companyIdParam) || null;
const seen = await seenKeySet(!!Astro.locals.user);
const countryName = (() => {
    const cc = companyInfo?.origin_country;
    if (!cc) return '';
    try { return new Intl.DisplayNames(['es'], { type: 'region' }).of(cc) || cc; } catch { return cc; }
})();

const toRow = (p: any, mt: 'movie' | 'tv'): FilmRow => {
    const date = (mt === 'movie' ? p.release_date : p.first_air_date) || '';
    return {
        key: `${mt}_${p.id}`, id: String(p.id), mt, title: (mt === 'movie' ? p.title : p.name) || '',
        poster: p.poster_path ? String(p.poster_path).replace('/w500/', '/w154/') : null,
        year: date.slice(0, 4), date,
        roles: (p.genre_ids || []).slice(0, 2).map((g: number) => getGenreName(g)).filter(Boolean),
        kinds: [],
        vote: Number(p.vote_average) || 0, votes: Number(p.vote_count) || 0, pop: Number(p.popularity) || 0,
        seen: seen.has(`${mt}_${p.id}`),
    };
};
const filmRows = [...movies.map((m) => toRow(m, 'movie')), ...series.map((s) => toRow(s, 'tv'))];
const knownFor = [...filmRows].filter((r) => r.poster).sort((a, b) => (b.votes + 5 * b.pop) - (a.votes + 5 * a.pop)).slice(0, 4);

// Datos (C22): géneros más producidos, década más activa, nota media y mejores.
const genreHistogram: Record<number, number> = {};
for (const p of [...movies, ...series] as any[]) for (const g of p.genre_ids || []) genreHistogram[g] = (genreHistogram[g] || 0) + 1;
const topGenres = Object.entries(genreHistogram).sort(([, a], [, b]) => b - a).slice(0, 5)
    .map(([id, count]) => ({ name: getGenreName(Number(id)), count })).filter((g) => g.name);
const decadeHistogram: Record<string, number> = {};
for (const r of filmRows) {
    const y = Number(r.year);
    if (!y || y < 1900) continue;
    const dec = `${Math.floor(y / 10) * 10}s`;
    decadeHistogram[dec] = (decadeHistogram[dec] || 0) + 1;
}
const topDecade = Object.entries(decadeHistogram).sort(([, a], [, b]) => b - a)[0] || null;
const years = filmRows.map((r) => Number(r.year)).filter((y) => y >= 1900 && y <= new Date().getFullYear() + 1);
const active = years.length ? { start: Math.min(...years), end: Math.max(...years) } : null;
const rated = filmRows.filter((r) => r.vote > 0);
const avgRating = rated.length ? rated.reduce((s, r) => s + r.vote, 0) / rated.length : null;
// «Mejor»: con al menos 100 votos (si no, una con 3 votos y un 8,9 gana a todo); si ninguna llega, cualquiera.
const bestOf = (mt: 'movie' | 'tv') => {
    const pool = filmRows.filter((r) => r.mt === mt && r.vote > 0);
    const solid = pool.filter((r) => r.votes >= 100);
    return (solid.length ? solid : pool).reduce<FilmRow | null>((b, r) => (!b || r.vote > b.vote ? r : b), null);
};
const bestMovie = bestOf('movie');
const bestSerie = bestOf('tv');
const logo = companyInfo?.logo_path ? posterUrl(companyInfo.logo_path, 'w300') : null;
const keepQuery = companyIdParam ? `companyId=${companyIdParam}` : '';
---
<Layout title={displayName} description={companyInfo?.description ? String(companyInfo.description).slice(0, 200) : undefined}>
    <section class="px-1 sm:py-8">
        <header class="ahd">
            <div class="ahd-ph ahd-ph--logo dark-logo-chip">
                {logo
                    ? <img src={logo} alt={displayName} />
                    : <span aria-hidden="true">{String(displayName).split(' ').map((w: string) => w[0]).slice(0, 2).join('')}</span>}
            </div>
            <div class="ahd-tx">
                <h1>{displayName}</h1>
                <p class="ahd-m">
                    Productora
                    {countryName && <> · {countryName}</>}
                    {companyInfo?.headquarters && <> · {companyInfo.headquarters}</>}
                </p>
                {SOCIAL_PHASE.recommend && Astro.locals.user && companyId && (
                    <div class="ahd-acts">
                        <button type="button" class="btn btn--ghost" data-recommend data-target-type="company" data-target-id={companyId} data-title={displayName} data-image={companyInfo?.logo_path ?? ''} aria-haspopup="dialog" aria-expanded="false">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                            Recomendar
                        </button>
                    </div>
                )}
            </div>
            {knownFor.length > 0 && (
                <div class="ahd-kn">
                    <p class="ahd-k">Conocida por</p>
                    <div class="ahd-kng">
                        {knownFor.map((k) => (
                            <a href={k.mt === 'movie' ? `/movie/${k.id}` : `/serie/${k.id}`} class="ahd-kc" title={k.title}>
                                <img src={k.poster!.replace('/w154/', '/w185/')} alt="" loading="lazy" />
                                <b>{k.title}</b>
                                {k.year && <span>{k.year}</span>}
                            </a>
                        ))}
                    </div>
                </div>
            )}
        </header>

        <div class="acols">
            <div class="acols-main">
                {companyInfo?.description && (
                    <section>
                        <div class="fsec-h"><h2>Acerca de la productora</h2></div>
                        <details class="abio">
                            <summary><p>{companyInfo.description}</p><span class="abio-more">Leer más</span></summary>
                        </details>
                    </section>
                )}
                <FilmographyList rows={filmRows} sort={filmSort} keepQuery={keepQuery} title="Producciones" />
            </div>

            <aside class="acols-side">
                <div class="fcard">
                    <h3 class="fcard-h"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>Datos</h3>
                    <dl class="fdl">
                        {companyInfo?.headquarters && (<><dt>Sede</dt><dd>{companyInfo.headquarters}</dd></>)}
                        {countryName && (<><dt>País</dt><dd>{countryName}</dd></>)}
                        {companyInfo?.parent_company && (<><dt>Parte de</dt><dd>{companyInfo.parent_company.name}</dd></>)}
                        <dt>Producciones</dt><dd>{movies.length} {movies.length === 1 ? 'película' : 'películas'} · {series.length} {series.length === 1 ? 'serie' : 'series'}</dd>
                        {avgRating !== null && (<><dt>Nota media</dt><dd>{avgRating.toFixed(1).replace('.', ',')} <small>· {rated.length} con votos</small></dd></>)}
                        {active && (<><dt>En activo</dt><dd>{active.start === active.end ? active.start : `${active.start}–${active.end}`}</dd></>)}
                        {topDecade && (<><dt>Década más activa</dt><dd>{topDecade[0]} <small>· {topDecade[1]} producciones</small></dd></>)}
                        {bestMovie && (<><dt>Mejor película</dt><dd><a href={`/movie/${bestMovie.id}`}>{bestMovie.title}</a> <small>· ★ {bestMovie.vote.toFixed(1).replace('.', ',')}</small></dd></>)}
                        {bestSerie && (<><dt>Mejor serie</dt><dd><a href={`/serie/${bestSerie.id}`}>{bestSerie.title}</a> <small>· ★ {bestSerie.vote.toFixed(1).replace('.', ',')}</small></dd></>)}
                        {topGenres.length > 0 && (<><dt>Géneros</dt><dd>{topGenres.map((g) => `${g.name} ${g.count}`).join(' · ')}</dd></>)}
                    </dl>
                    {companyInfo?.homepage && (
                        <div class="clinks">
                            <a href={companyInfo.homepage} target="_blank" rel="noopener noreferrer" class="btn btn--sm">Web</a>
                        </div>
                    )}
                </div>
            </aside>
        </div>
    </section>
</Layout>
