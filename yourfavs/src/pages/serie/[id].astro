                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}

                        <!-- Eslogan/Tagline -->
                        {additionalInfo.tagline && (
                            <div class="bg-gradient-to-r from-blue-50 to-purple-50 p-4 rounded-lg shadow-md border-l-4 border-blue-500">
                                <h3 class="text-lg font-bold text-blue-600 mb-2">Eslogan</h3>
                                <p class="text-gray-700 italic text-lg">"{additionalInfo.tagline}"</p>
                            </div>
                        )}
                    </div>
                </div>

                <!-- Columna Derecha: Detalles -->
                <div class="md:w-2/3">
                    <!-- Trailer -->
                    {trailerUrl && (
                            <div class="bg-white p-6 rounded-lg shadow-md mb-8">
                                <h2 class="text-2xl font-bold text-blue-600 mb-4 flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
