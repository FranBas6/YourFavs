                                            {behindScenes.slice(0, 4).map((video: any) => (
                                                <div class="bg-gray-50 rounded-lg overflow-hidden">
                                                    <div class="aspect-video">
                                                        <iframe
                                                            class="w-full h-full"
                                                            src={`https://www.youtube.com/embed/${video.key}`}
                                                            frameborder="0"
                                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                                            allowfullscreen
                                                        ></iframe>
                                                    </div>
                                                    <div class="p-3">
                                                        <p class="text-sm font-medium text-gray-800">{video.name}</p>
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                {/* Teasers */}
                                {teasers.length > 0 && (
                                    <div>
                                        <h3 class="text-lg font-semibold text-gray-700 mb-3">Avances</h3>
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
