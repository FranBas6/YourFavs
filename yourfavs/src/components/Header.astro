---
import '../styles/components/header.css';
import { Icon } from 'astro-icon/components';
import Stamp from './Stamp.astro';
import { SUPPORTED_COUNTRIES } from '../services/API/shared/tmdbInfoService';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
    if (href === "/") return currentPath === "/";
    return currentPath.startsWith(href);
}

// Nav principal (desktop): Inicio · Tendencias · Cartelera · Descubrir▾ · Plataformas
const navMain = [
    { href: "/", label: "Inicio", icon: "sparkles" },
    { href: "/catalogo/tendencias", label: "Tendencias", icon: "trending-up" },
    { href: "/catalogo/cartelera", label: "Cartelera", icon: "clapperboard" },
];
const navPlatforms = { href: "/catalogo/plataformas", label: "Plataformas", icon: "layout-grid" };

// Dropdown "Descubrir" (6 items — Categorías y Sagas son cosas distintas)
const discoverItems = [
    { href: "/catalogo/ultimoslanzamientos", color: "green",  icon: "sparkles",  title: "Últimos lanzamientos", desc: "Estrenos en streaming" },
    { href: "/catalogo/maspopulares",        color: "pink",   icon: "flame",     title: "Más populares",        desc: "Lo que todo el mundo ve" },
    { href: "/catalogo/topmovies",           color: "amber",  icon: "star",      title: "Top películas",        desc: "Las mejores de siempre" },
    { href: "/catalogo/topseries",           color: "blue",   icon: "trophy",    title: "Top series",           desc: "Imprescindibles TV" },
    { href: "/catalogo/categorias",          color: "slate",  icon: "layers",    title: "Categorías",           desc: "Por género" },
    { href: "/catalogo/colecciones",         color: "purple", icon: "tag",       title: "Sagas",                desc: "Colecciones y franquicias" },
];
const discoverActive = discoverItems.some((i) => currentPath.startsWith(i.href));

// Sesión (la rellena el middleware). Header en dos estados: invitado → "Entrar";
// con sesión → avatar + menú de cuenta.
const user = Astro.locals.user;
const displayName = user ? (user.name || user.email?.split('@')[0] || 'Tú') : '';
function computeInitials(u: { name: string | null; email: string | null }): string {
    const name = u.name?.trim();
    if (name) {
        const parts = name.split(/\s+/);
        return ((parts[0]?.[0] || '') + (parts[1]?.[0] || '')).toUpperCase();
    }
    return (u.email || '').slice(0, 2).toUpperCase() || '??';
}
const avatarInitials = user ? computeInitials(user) : '';
const currentRegion = user?.region ?? 'ES';

// Dropdown "Mis listas" (solo con sesión). Replica el patrón de "Descubrir".
const myListsItems = [
    { href: "/mislistas/favoritos",  color: "red",    icon: "heart",    title: "Favoritos",  desc: "Tus imprescindibles" },
    { href: "/mislistas/megusta",    color: "amber",  icon: "star",     title: "Me gusta",   desc: "Lo que te gustó" },
    { href: "/mislistas/vistos",     color: "green",  icon: "eye",      title: "Vistos",     desc: "Ya las viste" },
    { href: "/mislistas/pendientes", color: "blue",   icon: "bookmark", title: "Pendientes", desc: "Para ver pronto" },
    { href: "/mislistas/verpronto",  color: "purple", icon: "clock",    title: "Ver pronto", desc: "En tu radar" },
    { href: "/mislistas/siguiendo",  color: "pink",   icon: "tv",       title: "Siguiendo",  desc: "Series al día" },
    { href: "/mislistas/actores",    color: "slate",  icon: "user",     title: "Actores",    desc: "Quienes sigues" },
    { href: "/mislistas/radar",      color: "red",    icon: "radar",    title: "Radar",      desc: "No te pierdas lo tuyo" },
    { href: "/mislistas/colecciones", color: "purple", icon: "library", title: "Mis colecciones", desc: "Listas personalizadas" },
    { href: "/mislistas/actividad",  color: "green",  icon: "activity", title: "Actividad",  desc: "Tu historial" },
];
const myListsActive = myListsItems.some((i) => currentPath.startsWith(i.href));
---
<header class="header-main">
    <div class="header-inner">
        <!-- Logo -->
        <a href="/" class="header-logo">
            <span class="header-logo-text">YOURFAVS</span>
        </a>

        <!-- Nav desktop: 5 items (Inicio · Tendencias · Cartelera · Descubrir▾ · Plataformas) -->
        <nav aria-label="Navegación principal" class="header-nav-desktop">
            {navMain.map(item => (
                <a href={item.href}
                   class={`header-nav-link ${isActive(item.href) ? 'is-active' : ''}`}>
                    <Icon name={`lucide:${item.icon}`} class="w-4 h-4" />
                    {item.label}
                </a>
            ))}

            <!-- Descubrir + dropdown -->
            <div class="header-discover" id="discover">
                <button type="button"
                        class={`header-nav-link header-discover-btn ${discoverActive ? 'is-active' : ''}`}
                        id="discover-btn" aria-haspopup="true" aria-expanded="false">
                    <Icon name="lucide:compass" class="w-4 h-4" />
                    Descubrir
                    <svg class="header-discover-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                    </svg>
                </button>
                <div class="header-discover-panel" id="discover-panel">
                    <div class="header-discover-kicker">Explorar el catálogo</div>
                    <div class="header-discover-grid">
                        {discoverItems.map(it => (
                            <a href={it.href} class="header-discover-item">
                                <Stamp color={it.color as any} icon={it.icon} size={32} />
                                <span class="hd-body">
                                    <span class="hd-t">{it.title}</span>
                                    <span class="hd-s">{it.desc}</span>
                                </span>
                            </a>
                        ))}
                    </div>
                </div>
            </div>

            <!-- Mis listas + dropdown (solo con sesión) -->
            {user && (
                <div class="header-discover" id="mislistas">
                    <button type="button"
                            class={`header-nav-link header-discover-btn ${myListsActive ? 'is-active' : ''}`}
                            id="mislistas-btn" aria-haspopup="true" aria-expanded="false">
                        <Icon name="lucide:bookmark" class="w-4 h-4" />
                        Mis listas
                        <span class="header-radar-badge js-radar-badge" hidden aria-label="novedades en el radar"></span>
                        <svg class="header-discover-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div class="header-discover-panel" id="mislistas-panel">
                        <div class="header-discover-kicker">Tus colecciones</div>
                        <div class="header-discover-grid">
                            {myListsItems.map(it => (
                                <a href={it.href} class="header-discover-item">
                                    <Stamp color={it.color as any} icon={it.icon} size={32} />
                                    <span class="hd-body">
                                        <span class="hd-t">{it.title}</span>
                                        <span class="hd-s">{it.desc}</span>
                                    </span>
                                </a>
                            ))}
                        </div>
                        <a href="/mislistas/year" class="header-mylists-foot">
                            <Icon name="lucide:bar-chart-3" class="w-4 h-4" />
                            Tu año en cine
                        </a>
                    </div>
                </div>
            )}

            <a href={navPlatforms.href}
               class={`header-nav-link ${isActive(navPlatforms.href) ? 'is-active' : ''}`}>
                <Icon name={`lucide:${navPlatforms.icon}`} class="w-4 h-4" />
                {navPlatforms.label}
            </a>
        </nav>

        <!-- Acciones desktop: búsqueda + theme toggle -->
        <div class="header-actions">
            <form action="/catalogo/busqueda" method="get" class="header-search-form">
                <label for="header-search" class="sr-only">Buscar películas y series</label>
                <svg class="header-search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <input id="header-search" name="query" type="text" placeholder="Buscar..." autocomplete="off" class="header-search-input"/>
                <kbd class="header-search-kbd" aria-hidden="true" hidden>⌘K</kbd>
                <button type="submit" aria-label="Buscar" class="header-search-btn">
                    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/>
                    </svg>
                </button>
            </form>

            <!-- Calendario desktop: dropdown -->
            <button class="header-calendar-btn" id="calendar-toggle-btn" aria-label="Abrir calendario de estrenos" title="Calendario de estrenos">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
            </button>
            <div class="header-calendar-dropdown" id="calendar-dropdown" style="display:none;">
                <div class="calendar-dropdown-header">
                    <button id="cal-prev" class="cal-nav-btn" aria-label="Mes anterior">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    </button>
                    <span id="cal-month-title" class="cal-month-title"></span>
                    <button id="cal-next" class="cal-nav-btn" aria-label="Mes siguiente">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </button>
                </div>
                <div class="cal-weekdays">
                    <span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span>
                </div>
                <div id="cal-grid" class="cal-grid"></div>
                <div id="cal-day-detail" class="cal-day-detail" style="display:none;" role="dialog" aria-modal="true" aria-label="Detalle del día" tabindex="-1"></div>
                <div id="cal-notifications" class="cal-notifications">
                    <p class="cal-notif-title">Tus notificaciones</p>
                    <div id="cal-notif-list" class="cal-notif-list">
                        <p class="cal-notif-empty">Cargando...</p>
                    </div>
                </div>
            </div>

            <!-- Campana (Bloque 4): buzón de notificaciones (solo con sesión) -->
            {user && (
                <div class="header-notif" id="notif">
                    <button class="header-notif-btn" id="notif-toggle-btn" aria-label="Notificaciones" title="Notificaciones" aria-haspopup="true" aria-expanded="false">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 16v-5a6 6 0 0 0-12 0v5l-2 3h16z"/><path d="M10 21a2 2 0 0 0 4 0"/>
                        </svg>
                        <span class="header-notif-badge js-notif-badge" hidden aria-label="notificaciones sin leer"></span>
                    </button>
                    <div class="header-notif-dropdown" id="notif-dropdown" style="display:none;" role="dialog" aria-label="Notificaciones">
                        <div class="notif-head">
                            <span class="notif-title">Notificaciones</span>
                            <button type="button" class="notif-markall" id="notif-markall">Marcar leídas</button>
                        </div>
                        <div class="notif-list" id="notif-list">
                            <p class="notif-empty">Cargando…</p>
                        </div>
                        <a href="/mislistas/notificaciones" class="notif-footer">Ver todas</a>
                    </div>
                </div>
            )}

            {!user && (
                <button class="theme-toggle" aria-label="Cambiar tema">
                    <svg class="theme-icon-sun" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                    <svg class="theme-icon-moon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                    </svg>
                </button>
            )}

            <!-- Usuario: sin sesión → "Entrar"; con sesión → avatar + menú de cuenta (Tema vive ahí) -->
            {user ? (
                <div class="header-account" id="account">
                    <button type="button" class="header-avatar-btn" id="account-btn" aria-haspopup="true" aria-expanded="false" aria-label="Tu cuenta" title={displayName}>
                        {user.picture
                            ? <img src={user.picture} alt="" referrerpolicy="no-referrer" />
                            : <span class="header-avatar-initials">{avatarInitials}</span>}
                    </button>
                    <div class="account-menu" id="account-menu" role="menu" aria-label="Menú de cuenta">
                        <div class="account-menu-head">
                            <span class="account-menu-avatar">
                                {user.picture
                                    ? <img src={user.picture} alt="" referrerpolicy="no-referrer" />
                                    : avatarInitials}
                            </span>
                            <span class="account-menu-id">
                                <span class="account-menu-name">{displayName}</span>
                                <span class="account-menu-email">{user.email}</span>
                            </span>
                        </div>
                        <a href="/perfil" class="account-menu-item account-menu-item-2l" role="menuitem">
                            <Icon name="lucide:settings" />
                            <span class="ami-body">
                                <span class="ami-title">Configuración del perfil</span>
                                <span class="ami-sub">Nombre, avatar, región</span>
                            </span>
                        </a>
                        <a href="/mislistas/actividad" class="account-menu-item" role="menuitem">
                            <Icon name="lucide:activity" /> Tu actividad
                        </a>
                        <a href="/mislistas/year" class="account-menu-item" role="menuitem">
                            <Icon name="lucide:bar-chart-3" /> Tu año en cine
                        </a>
                        <div class="account-menu-sep"></div>
                        <div class="account-menu-row">
                            <span class="amr-label"><Icon name="lucide:globe" /> Región</span>
                            <select class="amr-region" id="acc-region" aria-label="Región de streaming">
                                {SUPPORTED_COUNTRIES.map((c) => (
                                    <option value={c.code} selected={c.code === currentRegion}>{c.code}</option>
                                ))}
                            </select>
                        </div>
                        <div class="account-menu-row">
                            <span class="amr-label"><Icon name="lucide:sun" /> Tema</span>
                            <span class="amr-theme" role="group" aria-label="Tema">
                                <button type="button" data-theme-set="light">Claro</button>
                                <button type="button" data-theme-set="dark">Oscuro</button>
                            </span>
                        </div>
                        <div class="account-menu-sep"></div>
                        <button type="button" class="account-menu-item is-danger" data-auth-logout role="menuitem">
                            <Icon name="lucide:log-out" /> Cerrar sesión
                        </button>
                    </div>
                </div>
            ) : (
                <button type="button" class="header-entrar-btn" data-auth-open>
                    <Icon name="lucide:user" class="w-4 h-4" /> Entrar
                </button>
            )}
        </div>

        <!-- Móvil: la navegación vive en el tab bar inferior (MobileTabBar) + hojas
             (MobileNavSheets). El header móvil queda mínimo: logo + calendario. -->
    </div>
</header>

<script is:inline>
// Búsqueda desktop → command palette (⌘K). Mejora progresiva: sin JS el form
// sigue haciendo GET a /catalogo/busqueda. El form móvil NO se toca.
(function () {
    var form = document.querySelector('.header-search-form');
    var input = document.getElementById('header-search');
    if (!form || !input) return;

    // Con JS activo el input ya no es escribible: lo vestimos de trigger
    // (readonly + cursor pointer + hint ⌘K) para no dar falsa affordance.
    form.classList.add('is-palette-trigger');
    input.readOnly = true;
    input.setAttribute('aria-label', 'Abrir búsqueda rápida');
    var kbd = form.querySelector('.header-search-kbd');
    if (kbd) {
        var isMac = /Mac|iPhone|iPad/.test(navigator.platform || '');
        kbd.textContent = isMac ? '⌘K' : 'Ctrl K';
        kbd.hidden = false;
    }

    function openPalette(e) {
        e.preventDefault();
        input.blur();
        document.dispatchEvent(new CustomEvent('yf:open-palette'));
    }
    input.addEventListener('focus', openPalette);
    input.addEventListener('click', openPalette);
    form.addEventListener('submit', openPalette);
})();

// Dropdown "Descubrir" (desktop): SOLO click (sin hover, para no abrirse al
// pasar el ratón). Click en el botón abre/cierra; cierra con click fuera o Esc.
(function () {
    var wrap = document.getElementById('discover');
    var btn = document.getElementById('discover-btn');
    if (!wrap || !btn) return;
    var open = false;
    function setOpen(v) {
        open = v;
        wrap.classList.toggle('is-open', v);
        btn.setAttribute('aria-expanded', v ? 'true' : 'false');
    }
    btn.addEventListener('click', function (e) { e.stopPropagation(); setOpen(!open); });
    document.addEventListener('click', function (e) { if (open && !wrap.contains(e.target)) setOpen(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && open) setOpen(false); });
})();

// Dropdown "Mis listas" (desktop): mismo patrón que "Descubrir".
(function () {
    var wrap = document.getElementById('mislistas');
    var btn = document.getElementById('mislistas-btn');
    if (!wrap || !btn) return;
    var open = false;
    function setOpen(v) {
        open = v;
        wrap.classList.toggle('is-open', v);
        btn.setAttribute('aria-expanded', v ? 'true' : 'false');
    }
    btn.addEventListener('click', function (e) { e.stopPropagation(); setOpen(!open); });
    document.addEventListener('click', function (e) { if (open && !wrap.contains(e.target)) setOpen(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && open) setOpen(false); });
})();

// Menú de cuenta (desktop): click abre/cierra; cierra con click fuera o Esc.
// Mismo patrón que "Descubrir".
(function () {
    var wrap = document.getElementById('account');
    var btn = document.getElementById('account-btn');
    if (!wrap || !btn) return;
    var open = false;
    function setOpen(v) {
        open = v;
        wrap.classList.toggle('is-open', v);
        btn.setAttribute('aria-expanded', v ? 'true' : 'false');
    }
    btn.addEventListener('click', function (e) { e.stopPropagation(); setOpen(!open); });
    document.addEventListener('click', function (e) { if (open && !wrap.contains(e.target)) setOpen(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && open) setOpen(false); });

    // Región inline: guarda y recarga (para que los proveedores SSR usen la nueva región).
    var accRegion = document.getElementById('acc-region');
    if (accRegion) accRegion.addEventListener('change', function () {
        fetch('/api/profile/preferences', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ region: accRegion.value }),
        }).then(function () { location.reload(); }).catch(function () {});
    });

    // Tema segmentado: aplica al instante (data-theme + localStorage) y guarda en el perfil.
    var themeBtns = wrap.querySelectorAll('[data-theme-set]');
    function syncThemeSeg() {
        var cur = document.documentElement.getAttribute('data-theme') || 'light';
        themeBtns.forEach(function (b) { b.classList.toggle('is-active', b.getAttribute('data-theme-set') === cur); });
    }
    themeBtns.forEach(function (b) {
        b.addEventListener('click', function () {
            var v = b.getAttribute('data-theme-set');
            document.documentElement.setAttribute('data-theme', v);
            try { localStorage.setItem('theme', v); } catch (e) {}
            syncThemeSeg();
            fetch('/api/profile/preferences', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ theme: v }),
            }).catch(function () {});
        });
    });
    syncThemeSeg();
})();

// Calendar dropdown
(function () {
    var calBtn = document.getElementById('calendar-toggle-btn');
    var calDrop = document.getElementById('calendar-dropdown');
    var calGrid = document.getElementById('cal-grid');
    var calTitle = document.getElementById('cal-month-title');
    var calPrev = document.getElementById('cal-prev');
    var calNext = document.getElementById('cal-next');
    var calDayDetail = document.getElementById('cal-day-detail');
    var calNotifList = document.getElementById('cal-notif-list');
    if (!calBtn || !calDrop) return;

    var months = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
    var now = new Date();
    var curYear = now.getFullYear();
    var curMonth = now.getMonth() + 1;
    var calData = null;
    var isOpen = false;

    function toggle() {
        isOpen = !isOpen;
        calDrop.style.display = isOpen ? 'block' : 'none';
        if (isOpen && !calData) loadMonth(curYear, curMonth);
    }

    calBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        // Móvil (<1024px): el dropdown es un popover de ratón → mejor la página
        // completa (responsive, con vista lista + ICS). Desktop conserva el dropdown.
        if (window.matchMedia('(max-width: 1023px)').matches) {
            window.location.href = '/mislistas/calendario';
            return;
        }
        toggle();
    });

    document.addEventListener('click', function (e) {
        if (isOpen && !calDrop.contains(e.target) && e.target !== calBtn) {
            isOpen = false;
            calDrop.style.display = 'none';
        }
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && isOpen) { isOpen = false; calDrop.style.display = 'none'; }
    });

    calPrev.addEventListener('click', function () {
        curMonth--; if (curMonth < 1) { curMonth = 12; curYear--; }
        loadMonth(curYear, curMonth);
    });
    calNext.addEventListener('click', function () {
        curMonth++; if (curMonth > 12) { curMonth = 1; curYear++; }
        loadMonth(curYear, curMonth);
    });

    function loadMonth(y, m) {
        calTitle.textContent = months[m - 1] + ' ' + y;
        calGrid.innerHTML = '<p style="text-align:center;padding:1rem;color:#9CA3AF;font-size:12px;">Cargando...</p>';
        calDayDetail.style.display = 'none';

        var ym = y + '-' + String(m).padStart(2, '0');
        fetch('/api/calendar/' + ym)
            .then(function (r) { return r.json(); })
            .then(function (data) {
                calData = data;
                renderGrid(data);
                renderNotifications(data);
            })
            .catch(function () {
                calGrid.innerHTML = '<p style="text-align:center;padding:1rem;color:#EF4444;font-size:12px;">Error al cargar</p>';
            });
    }

    function renderGrid(data) {
        var daysInMonth = new Date(data.year, data.month, 0).getDate();
        var firstDay = (new Date(data.year, data.month - 1, 1).getDay() + 6) % 7;
        var eventsMap = {};
        (data.days || []).forEach(function (d) { eventsMap[d.date] = d.events; });

        var html = '';
        for (var i = 0; i < firstDay; i++) html += '<div class="cal-cell cal-empty"></div>';

        for (var d = 1; d <= daysInMonth; d++) {
            var dateStr = data.year + '-' + String(data.month).padStart(2, '0') + '-' + String(d).padStart(2, '0');
            var events = eventsMap[dateStr] || [];
            var isToday = dateStr === data.today;
            var cls = 'cal-cell' + (isToday ? ' cal-today' : '') + (events.length ? ' cal-has-events' : '');
            html += '<div class="' + cls + '" data-date="' + dateStr + '">';
            html += '<span class="cal-day-num">' + d + '</span>';
            if (events.length) {
                html += '<div class="cal-dots">';
                var hasMovie = events.some(function (e) { return e.media_type === 'movie'; });
                var hasSerie = events.some(function (e) { return e.event_type === 'episode'; });
                var hasSeason = events.some(function (e) { return e.event_type === 'season_premiere'; });
                if (hasMovie) html += '<span class="cal-dot cal-dot-movie"></span>';
                if (hasSerie) html += '<span class="cal-dot cal-dot-serie"></span>';
                if (hasSeason) html += '<span class="cal-dot cal-dot-season"></span>';
                html += '</div>';
            }
            html += '</div>';
        }
        calGrid.innerHTML = html;

        // Day click handler
        calGrid.querySelectorAll('.cal-has-events').forEach(function (cell) {
            cell.addEventListener('click', function () {
                var date = cell.getAttribute('data-date');
                var events = eventsMap[date] || [];
                showDayDetail(date, events, cell);
            });
        });
    }

    var dayDetailReturnFocus = null;

    function escapeAttr(s) {
        return String(s || '').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function clearSelectedDay() {
        if (!calGrid) return;
        calGrid.querySelectorAll('.cal-selected').forEach(function (c) { c.classList.remove('cal-selected'); });
    }

    function closeDayDetail() {
        calDayDetail.style.display = 'none';
        clearSelectedDay();
        if (dayDetailReturnFocus && typeof dayDetailReturnFocus.focus === 'function') {
            dayDetailReturnFocus.focus();
            dayDetailReturnFocus = null;
        }
    }

    function showDayDetail(date, events, triggerEl) {
        dayDetailReturnFocus = triggerEl || document.activeElement;
        clearSelectedDay();
        if (triggerEl && triggerEl.classList) triggerEl.classList.add('cal-selected');
        var d = new Date(date + 'T12:00:00');
        var dayName = d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'short' });
        var html = '<div class="cal-detail-header"><span>' + dayName + '</span><button id="cal-detail-close" class="cal-detail-close" aria-label="Cerrar detalle del día">&times;</button></div>';
        events.forEach(function (ev) {
            var typeClass = ev.media_type === 'movie' ? 'cal-ev-movie' : (ev.event_type === 'season_premiere' ? 'cal-ev-season' : 'cal-ev-serie');
            var link = ev.media_type === 'movie' ? '/movie/' + ev.tmdb_id : '/serie/' + ev.tmdb_id;
            html += '<a href="' + link + '" class="cal-event ' + typeClass + '">';
            if (ev.poster_path) html += '<img src="' + ev.poster_path + '" alt="' + escapeAttr(ev.title) + '" class="cal-ev-poster"/>';
            html += '<div class="cal-ev-info"><span class="cal-ev-title">' + escapeAttr(ev.title) + '</span><span class="cal-ev-label">' + escapeAttr(ev.label) + '</span></div></a>';
        });
        calDayDetail.innerHTML = html;
        calDayDetail.style.display = 'block';
        var closeBtn = document.getElementById('cal-detail-close');
        closeBtn.addEventListener('click', closeDayDetail);
        closeBtn.focus();
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && calDayDetail && calDayDetail.style.display === 'block') {
            e.stopPropagation();
            closeDayDetail();
        }
    });

    function renderNotifications(data) {
        var subs = [];
        (data.days || []).forEach(function (d) {
            d.events.forEach(function (ev) {
                if (ev.is_subscribed) subs.push({ date: d.date, event: ev });
            });
        });
        if (subs.length === 0) {
            calNotifList.innerHTML = '<p class="cal-notif-empty">No hay notificaciones este mes</p>';
            return;
        }

        // Agrupar por media+tmdb_id+title
        var map = {};
        subs.forEach(function (s) {
            var key = s.event.media_type + ':' + s.event.tmdb_id + ':' + s.event.title;
            if (!map[key]) map[key] = [];
            map[key].push(s);
        });
        var todayStr = new Date().toISOString().slice(0, 10);
        var groups = Object.keys(map).map(function (k) {
            var items = map[k].slice().sort(function (a, b) { return a.date.localeCompare(b.date); });
            var upcoming = items.filter(function (s) { return s.date >= todayStr; });
            var nextDate = upcoming.length ? upcoming[0].date : items[items.length - 1].date;
            return { items: items, firstDate: items[0].date, nextDate: nextDate, hasUpcoming: upcoming.length > 0, head: items[0].event };
        }).sort(function (a, b) { return a.nextDate.localeCompare(b.nextDate); });

        var fmt = function (date) {
            return new Date(date + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'short' });
        };

        var html = '';
        groups.forEach(function (g) {
            var head = g.head;
            var link = head.media_type === 'movie' ? '/movie/' + head.tmdb_id : '/serie/' + head.tmdb_id;
            var poster = head.poster_path
                ? '<img src="' + head.poster_path + '" alt="" class="cal-notif-poster"/>'
                : '<div class="cal-notif-poster-empty">?</div>';

            if (g.items.length === 1) {
                html += '<a href="' + link + '" class="cal-notif-item">';
                html += poster;
                html += '<div class="cal-notif-body">';
                html += '<div class="cal-notif-top"><span class="cal-notif-name">' + escapeAttr(head.title) + '</span><span class="cal-notif-date">' + fmt(g.firstDate) + '</span></div>';
                html += '<span class="cal-notif-label">' + escapeAttr(head.label) + '</span>';
                html += '</div></a>';
                return;
            }

            var startOpen = g.items.length <= 3;
            html += '<details class="cal-notif-group"' + (startOpen ? ' open' : '') + '>';
            html += '<summary class="cal-notif-item cal-notif-summary">';
            html += poster;
            html += '<div class="cal-notif-body">';
            html += '<div class="cal-notif-top"><span class="cal-notif-name">' + escapeAttr(head.title) + '</span><span class="cal-notif-count">' + g.items.length + ' episodios</span></div>';
            html += '<span class="cal-notif-label">' + (g.hasUpcoming ? 'Próximo: ' : 'Último: ') + fmt(g.nextDate) + '</span>';
            html += '</div>';
            html += '<svg class="cal-notif-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>';
            html += '</summary>';
            html += '<ul class="cal-notif-sublist">';
            g.items.forEach(function (s) {
                html += '<li><a href="' + link + '" class="cal-notif-subitem">';
                html += '<span class="cal-notif-sublabel">' + escapeAttr(s.event.label) + '</span>';
                html += '<span class="cal-notif-subdate">' + fmt(s.date) + '</span>';
                html += '</a></li>';
            });
            html += '</ul>';
            html += '</details>';
        });
        calNotifList.innerHTML = html;
    }
})();

// ── Campana (Bloque 4): desplegable de notificaciones + badge de no leídas ──
(function () {
    var badges = document.querySelectorAll('.js-notif-badge');
    function setBadge(n) {
        var txt = n > 9 ? '9+' : String(n);
        badges.forEach(function (b) { if (n > 0) { b.textContent = txt; b.hidden = false; } else { b.hidden = true; } });
    }
    // Badge independiente del desplegable → se rellena también en móvil (donde la
    // campana del header está oculta pero el badge de la hoja de cuenta existe).
    fetch('/api/notifications/count', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) { if (d) setBadge(d.count | 0); })
        .catch(function () {});

    var btn = document.getElementById('notif-toggle-btn');
    var drop = document.getElementById('notif-dropdown');
    var list = document.getElementById('notif-list');
    var markAllBtn = document.getElementById('notif-markall');
    if (!btn || !drop || !list) return;

    var isOpen = false, loaded = false;
    var IMG = 'https://image.tmdb.org/t/p/w92';
    var ICON = {
        new_episode: '<rect x="3" y="6" width="18" height="13" rx="2"/><path d="M8 3l4 3 4-3"/>',
        on_platform: '<path d="M4 8l2 12h12l2-12z"/><path d="M4 8l3-4 5 3 5-3 3 4"/>',
        person_release: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M11 4v16"/>',
        anniversary: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/>',
        platform_change: '<path d="M4 8l2 12h12l2-12z"/><path d="M4 8l3-4 5 3 5-3 3 4"/>',
        streak: '<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>'
    };
    var COLOR = { new_episode: '#3b82f6', on_platform: '#2f7d52', person_release: '#c4392f', anniversary: '#6d4aa0', platform_change: '#2f7d52', streak: '#d97706' };

    function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
    function svg(type) { return '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + (ICON[type] || ICON.new_episode) + '</svg>'; }
    function bucket(ts) { var d = 86400000, n = Date.now(); if (n - ts < d) return 'Hoy'; if (n - ts < 7 * d) return 'Esta semana'; return 'Antes'; }

    function render(items) {
        if (!items.length) { list.innerHTML = '<p class="notif-empty">No hay notificaciones.</p>'; return; }
        var html = '', lastBucket = '';
        items.forEach(function (it) {
            var b = bucket(it.created_at);
            if (b !== lastBucket) { html += '<p class="notif-group">' + b + '</p>'; lastBucket = b; }
            var color = COLOR[it.type] || '#3b82f6';
            html += '<a href="' + esc(it.href) + '" class="notif-item' + (it.read ? '' : ' is-unread') + '" data-id="' + esc(it.id) + '">';
            html += '<span class="notif-ico" style="color:' + color + ';background:' + color + '1a;">' + svg(it.type) + '</span>';
            html += it.poster_path ? '<img class="notif-poster" src="' + IMG + it.poster_path + '" alt="" loading="lazy"/>' : '<span class="notif-poster"></span>';
            html += '<span class="notif-body"><span class="notif-sub">' + esc(it.subtitle) + '</span><span class="notif-name">' + esc(it.title) + '</span></span>';
            html += it.read ? '' : '<span class="notif-dot"></span>';
            html += '</a>';
        });
        list.innerHTML = html;
    }

    function load() {
        fetch('/api/notifications', { headers: { Accept: 'application/json' } })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) {
                if (!d || !d.ok) { list.innerHTML = '<p class="notif-empty">No se pudieron cargar.</p>'; return; }
                render(d.items || []);
                setBadge(d.unread | 0);
            })
            .catch(function () { list.innerHTML = '<p class="notif-empty">No se pudieron cargar.</p>'; });
    }

    function setOpen(v) {
        isOpen = v;
        btn.setAttribute('aria-expanded', v ? 'true' : 'false');
        drop.style.display = v ? 'block' : 'none';
        if (v && !loaded) { loaded = true; load(); }
    }

    btn.addEventListener('click', function (e) {
        e.stopPropagation();
        // Móvil (<1024px): el desplegable no cabe → navegar a la página (como el calendario).
        if (window.innerWidth < 1024) { window.location.href = '/mislistas/notificaciones'; return; }
        setOpen(!isOpen);
    });
    document.addEventListener('click', function (e) {
        if (isOpen && !drop.contains(e.target) && !btn.contains(e.target)) setOpen(false);
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && isOpen) setOpen(false); });

    // Al abrir una notificación: marcar leída (keepalive para que persista pese a navegar).
    list.addEventListener('click', function (e) {
        var item = e.target.closest('.notif-item');
        if (!item || !item.classList.contains('is-unread')) return;
        item.classList.remove('is-unread');
        var dot = item.querySelector('.notif-dot'); if (dot) dot.remove();
        fetch('/api/notifications', { method: 'POST', keepalive: true, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ op: 'read', id: item.getAttribute('data-id') }) }).catch(function () {});
    });

    if (markAllBtn) markAllBtn.addEventListener('click', function () {
        fetch('/api/notifications', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ op: 'read_all' }) })
            .then(function () {
                list.querySelectorAll('.notif-item.is-unread').forEach(function (el) { el.classList.remove('is-unread'); var d = el.querySelector('.notif-dot'); if (d) d.remove(); });
                setBadge(0);
            }).catch(function () {});
    });
})();
</script>

<script is:inline>
    // Badge del Radar (② · "El salto"): nº de novedades SIN VER. Se ve estés donde
    // estés y se apaga al visitar el Radar (la página fija `yf_radar_ack = count`).
    // Vuelve a salir solo si el conteo sube. (/api/radar/count, día-cacheado.)
    (function () {
        var badges = document.querySelectorAll('.js-radar-badge');
        if (!badges.length) return;
        fetch('/api/radar/count', { headers: { Accept: 'application/json' } })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) {
                if (!d) return;
                var count = d.count | 0;
                var seen = parseInt(localStorage.getItem('yf_radar_ack') || '0', 10) || 0;
                if (count > seen && count > 0) {
                    var txt = count > 9 ? '9+' : String(count);
                    badges.forEach(function (b) { b.textContent = txt; b.hidden = false; });
                }
            })
            .catch(function () {});
    })();
</script>

