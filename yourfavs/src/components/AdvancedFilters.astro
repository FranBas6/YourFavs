---
import type { AdvancedFilters } from "../services/API/shared/tmdbDiscoverService";

interface Props {
    filters: AdvancedFilters;
    /** Construye la URL aplicando un cambio parcial (o null para eliminar una key). */
    buildUrl: (changes: Record<string, string | null>) => string;
    showRuntime?: boolean;
    showStatus?: boolean;
    hideCoreFilters?: boolean;
    /** Muestra el filtro de certificación por edad (solo tiene sentido en movies). */
    showCert?: boolean;
    /** Opciones de orden curadas para esta página. Si vacío, no se muestra el grupo. */
    sortOptions?: { value: string; label: string }[];
    /** Etiqueta del orden por defecto de la página (mono), p.ej. "Popularidad". */
    order?: string;
    /** Contexto discover base por tipo (2.3b) — alimenta el contador "Aplicar (N)" del sheet.
     *  Vacío/omitido → el botón muestra solo "Aplicar" (páginas sin discover filtrable). */
    countCtx?: { type: 'movie' | 'tv'; base: Record<string, string> }[];
    /** Filtro "Solo en mis plataformas" (3.2): estado actual + plataformas del perfil + región.
     *  Si `myPlatforms` está vacío, el chip no se muestra. */
    mine?: boolean;
    myPlatforms?: number[];
    region?: string;
}

const { filters, buildUrl, showRuntime = true, showStatus = false, hideCoreFilters = false, showCert = false, sortOptions = [], order, countCtx = [], mine = false, myPlatforms = [], region = 'ES' } = Astro.props;
const showMine = myPlatforms.length > 0;

const RUNTIMES = [
    { value: 'short', label: '< 90 min' },
    { value: 'medium', label: '90–150 min' },
    { value: 'long', label: '> 150 min' },
];
const LANGUAGES = [
    { value: 'es', label: 'Español' }, { value: 'en', label: 'Inglés' },
    { value: 'ja', label: 'Japonés' }, { value: 'ko', label: 'Coreano' },
    { value: 'fr', label: 'Francés' }, { value: 'it', label: 'Italiano' },
    { value: 'de', label: 'Alemán' }, { value: 'pt', label: 'Portugués' },
    { value: 'zh', label: 'Chino' },
];
const STATUSES = [
    { value: '0', label: 'En emisión' }, { value: '3', label: 'Finalizada' }, { value: '4', label: 'Cancelada' },
];
// Certificación por edad (España). label visible → valor TMDB (certification.lte).
const CERTS = [
    { value: 'APTA', label: 'TP' }, { value: '7', label: '+7' }, { value: '12', label: '+12' },
    { value: '16', label: '+16' }, { value: '18', label: '+18' },
];

const labelOf = (arr: { value: string; label: string }[], v?: string) => arr.find((x) => x.value === v)?.label || v;

const yearRangeActive = !!(filters.yearFrom || filters.yearTo);
const activeCount = [
    yearRangeActive || filters.year || filters.decade,
    filters.rating, filters.runtime, filters.language, filters.status, (showCert && filters.cert),
    (showMine && mine),
].filter(Boolean).length;
// Orden actual (sort seleccionado o el por defecto de la página).
const currentOrderLabel = sortOptions.find((o) => o.value === filters.sort)?.label || order;
const hasActive = activeCount > 0;
const ratingVal = filters.rating ? Number(filters.rating) : 0;

// Chips de filtro activo (cada uno con × para quitarlo)
type Chip = { label: string; remove: Record<string, string | null> };
const activeChips: Chip[] = [];
if (yearRangeActive) activeChips.push({ label: `${filters.yearFrom || '…'} – ${filters.yearTo || '…'}`, remove: { yearFrom: null, yearTo: null } });
else if (filters.year) activeChips.push({ label: filters.year, remove: { year: null } });
else if (filters.decade) activeChips.push({ label: `${filters.decade}s`, remove: { decade: null } });
if (filters.rating) activeChips.push({ label: `★ ${filters.rating}`, remove: { rating: null } });
if (filters.runtime) activeChips.push({ label: String(labelOf(RUNTIMES, filters.runtime)), remove: { runtime: null } });
if (filters.language) activeChips.push({ label: String(labelOf(LANGUAGES, filters.language)), remove: { language: null } });
if (filters.status) activeChips.push({ label: String(labelOf(STATUSES, filters.status)), remove: { status: null } });
if (showCert && filters.cert) activeChips.push({ label: String(labelOf(CERTS, filters.cert)), remove: { cert: null } });
if (showMine && mine) activeChips.push({ label: 'Mis plataformas', remove: { mine: null } });

const clearAll = { decade: null, year: null, yearFrom: null, yearTo: null, rating: null, runtime: null, language: null, status: null, cert: null, mine: null };
const chipClass = (active: boolean) => `yf-chip${active ? ' is-active' : ''}`;
---
<div class="yf-adv-wrap" data-adv data-count-ctx={countCtx.length ? JSON.stringify(countCtx) : undefined}
     data-my-platforms={showMine ? myPlatforms.join(',') : undefined} data-region={region}>
    <div class="yf-adv-backdrop" data-adv-backdrop hidden></div>
    <details class="yf-adv" open={hasActive}>
        <summary class="yf-adv-trigger">
            <span class="yf-adv-trigger-left">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 4h18M6 8h12M10 12h4M12 16h0"/>
                </svg>
                Filtros avanzados
                {hasActive && <span class="yf-adv-count">{activeCount}</span>}
            </span>
            <span class="yf-adv-trigger-right">
                {currentOrderLabel && <span class="yf-adv-order">Orden: <strong>{currentOrderLabel}</strong> ↓</span>}
                <svg class="yf-adv-chev w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
            </span>
        </summary>

        <div class="yf-adv-panel">
            <div class="yf-adv-handle" aria-hidden="true"></div>
            <div class="yf-adv-head">
                <h3>Filtros avanzados</h3>
                {hasActive && <a href={buildUrl(clearAll)} class="yf-adv-clear" data-adv-clear>✕ Borrar todo</a>}
            </div>

            <slot name="before" />

            {showMine && (
                <div class="yf-filter-group">
                    <p class="yf-group-label">Dónde ver</p>
                    <div class="yf-chips">
                        <a href={buildUrl({ mine: mine ? null : '1' })} class={chipClass(mine)} data-fkey="mine" data-fval="1">Solo en mis plataformas</a>
                    </div>
                </div>
            )}

            {sortOptions.length > 0 && (
                <div class="yf-filter-group">
                    <p class="yf-group-label">Ordenar por</p>
                    <div class="yf-chips">
                        {sortOptions.map((o) => (
                            <a href={buildUrl({ sort: filters.sort === o.value ? null : o.value })} class={chipClass(filters.sort === o.value)} data-fkey="sort" data-fval={o.value}>{o.label}</a>
                        ))}
                    </div>
                </div>
            )}

            {!hideCoreFilters && (
                <Fragment>
                    <div class="yf-filter-group">
                        <p class="yf-group-label">Años</p>
                        <div class="yf-range">
                            <input type="number" class="yf-range-input" data-year-from inputmode="numeric"
                                   placeholder="Desde" min="1900" max="2100" value={filters.yearFrom || ''} aria-label="Año desde" />
                            <span class="yf-range-sep">—</span>
                            <input type="number" class="yf-range-input" data-year-to inputmode="numeric"
                                   placeholder="Hasta" min="1900" max="2100" value={filters.yearTo || ''} aria-label="Año hasta" />
                        </div>
                    </div>

                    <div class="yf-filter-group">
                        <p class="yf-group-label">Nota mínima {ratingVal > 0 && <span class="yf-group-val">★ {filters.rating}</span>}</p>
                        <div class="yf-rating-slider">
                            <input type="range" data-rating min="0" max="9" step="0.5" value={ratingVal} aria-label="Nota mínima" />
                            <output data-rating-out class="yf-rating-out">{ratingVal > 0 ? `★ ${ratingVal}` : 'Cualquiera'}</output>
                        </div>
                    </div>

                    {showRuntime && (
                        <div class="yf-filter-group">
                            <p class="yf-group-label">Duración</p>
                            <div class="yf-chips">
                                {RUNTIMES.map((r) => (
                                    <a href={buildUrl({ runtime: filters.runtime === r.value ? null : r.value })} class={chipClass(filters.runtime === r.value)} data-fkey="runtime" data-fval={r.value}>{r.label}</a>
                                ))}
                            </div>
                        </div>
                    )}

                    {showCert && (
                        <div class="yf-filter-group">
                            <p class="yf-group-label">Edad (certificación · España)</p>
                            <div class="yf-chips">
                                {CERTS.map((c) => (
                                    <a href={buildUrl({ cert: filters.cert === c.value ? null : c.value })} class={chipClass(filters.cert === c.value)} data-fkey="cert" data-fval={c.value}>{c.label}</a>
                                ))}
                            </div>
                        </div>
                    )}

                    <div class="yf-filter-group">
                        <p class="yf-group-label">Idioma original</p>
                        <div class="yf-chips">
                            {LANGUAGES.map((l) => (
                                <a href={buildUrl({ language: filters.language === l.value ? null : l.value })} class={chipClass(filters.language === l.value)} data-fkey="language" data-fval={l.value}>{l.label}</a>
                            ))}
                        </div>
                    </div>

                    {showStatus && (
                        <div class="yf-filter-group">
                            <p class="yf-group-label">Estado de la serie</p>
                            <div class="yf-chips">
                                {STATUSES.map((s) => (
                                    <a href={buildUrl({ status: filters.status === s.value ? null : s.value })} class={chipClass(filters.status === s.value)} data-fkey="status" data-fval={s.value}>{s.label}</a>
                                ))}
                            </div>
                        </div>
                    )}
                </Fragment>
            )}

            <slot name="after" />
        </div>
    </details>

    {hasActive && (
        <div class="yf-adv-activechips">
            {activeChips.map((c) => (
                <a href={buildUrl(c.remove)} class="yf-activechip" title={`Quitar ${c.label}`}>
                    {c.label}
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </a>
            ))}
            <a href={buildUrl(clearAll)} class="yf-activechip-clear">Borrar todo</a>
        </div>
    )}

    <!-- Barra "Aplicar" — solo visible en modo hoja (móvil). En 2.3b mostrará el nº de resultados. -->
    <div class="yf-adv-applybar">
        <button type="button" class="yf-adv-apply-btn" data-adv-apply>Aplicar</button>
    </div>
</div>

<script is:inline>
    var mqSheet = window.matchMedia('(max-width: 1023px)');
    document.querySelectorAll('[data-adv]').forEach(function (root) {
        var details = root.querySelector('.yf-adv');
        var panel = root.querySelector('.yf-adv-panel');
        var backdrop = root.querySelector('[data-adv-backdrop]');
        var slider = root.querySelector('[data-rating]');
        var out = root.querySelector('[data-rating-out]');
        var from = root.querySelector('[data-year-from]');
        var to = root.querySelector('[data-year-to]');
        var applyBtn = root.querySelector('[data-adv-apply]');
        var countCtx = []; try { countCtx = JSON.parse(root.getAttribute('data-count-ctx') || '[]'); } catch (e) {}
        var countTimer = null, countAbort = null;
        var FILTER_KEYS = ['decade','year','yearFrom','yearTo','rating','runtime','language','status','cert','sort','mine'];
        var pending = {};

        // Contador en vivo (2.3b): pregunta a /api/discover/count cuántos resultados daría
        // la selección pendiente y lo pinta en el botón. Decorativo: si falla, "Aplicar" a secas.
        function updateCount() {
            if (!applyBtn || !countCtx.length) return;
            if (countTimer) clearTimeout(countTimer);
            countTimer = setTimeout(function () {
                if (countAbort) countAbort.abort();
                countAbort = new AbortController();
                var f = {};
                ['year','yearFrom','yearTo','decade','rating','runtime','language','status','cert'].forEach(function (k) { if (pending[k] != null) f[k] = pending[k]; });
                // "Solo en mis plataformas" no es un filtro discover normal: si está activo,
                // inyectamos with_watch_providers en cada query del contador.
                var qs = countCtx;
                var providers = (root.getAttribute('data-my-platforms') || '').split(',').filter(Boolean).join('|');
                if (pending.mine === '1' && providers) {
                    var rg = root.getAttribute('data-region') || 'ES';
                    qs = countCtx.map(function (q) { return { type: q.type, base: Object.assign({}, q.base, { with_watch_providers: providers, watch_region: rg }) }; });
                }
                fetch('/api/discover/count', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ queries: qs, filters: f }), signal: countAbort.signal,
                })
                    .then(function (r) { return r.json(); })
                    .then(function (res) {
                        if (res && typeof res.count === 'number') {
                            var n = res.count.toLocaleString('es-ES');
                            applyBtn.textContent = 'Aplicar (' + n + (res.count === 1 ? ' resultado)' : ' resultados)');
                        }
                    })
                    .catch(function (e) { if (e.name !== 'AbortError') applyBtn.textContent = 'Aplicar'; });
            }, 320);
        }

        function inSheet() { return root.classList.contains('is-sheet'); }

        // Navega aplicando cambios parciales (instant-apply en desktop / al "Aplicar" en hoja).
        function apply(changes) {
            var url = new URL(location.href);
            Object.keys(changes).forEach(function (k) {
                var v = changes[k];
                if (v === null || v === '') url.searchParams.delete(k);
                else url.searchParams.set(k, String(v));
            });
            url.searchParams.set('page', '1');
            location.href = url.pathname + '?' + url.searchParams.toString();
        }

        // ---- modo hoja (móvil): acumula en `pending`, aplica una sola vez ----
        function initPending() {
            pending = {};
            var p = new URL(location.href).searchParams;
            FILTER_KEYS.forEach(function (k) { var v = p.get(k); if (v) pending[k] = v; });
        }
        function refreshChips() {
            root.querySelectorAll('.yf-chip[data-fkey]').forEach(function (chip) {
                chip.classList.toggle('is-active', pending[chip.getAttribute('data-fkey')] === chip.getAttribute('data-fval'));
            });
            if (slider) {
                var rv = pending.rating ? Number(pending.rating) : 0;
                slider.value = rv;
                if (out) out.textContent = rv > 0 ? '★ ' + rv : 'Cualquiera';
            }
            if (from) from.value = pending.yearFrom || '';
            if (to) to.value = pending.yearTo || '';
        }
        function openSheet() {
            initPending();
            root.classList.add('is-sheet');
            if (backdrop) backdrop.hidden = false;
            document.body.style.overflow = 'hidden';
            refreshChips();
            updateCount();
        }
        function closeSheet() {
            root.classList.remove('is-sheet');
            if (backdrop) backdrop.hidden = true;
            document.body.style.overflow = '';
            if (details && details.open) details.open = false;
        }
        function applyPending() {
            var changes = {};
            FILTER_KEYS.forEach(function (k) { changes[k] = pending[k] != null ? pending[k] : null; });
            if (pending.yearFrom || pending.yearTo) { changes.decade = null; changes.year = null; }
            apply(changes);
        }

        // El <details> es el toggle; en móvil su apertura = hoja inferior.
        if (details) {
            details.addEventListener('toggle', function () {
                if (!mqSheet.matches) return;          // desktop: panel inline normal
                if (details.open) openSheet(); else closeSheet();
            });
            // En móvil no auto-abrir como hoja al cargar (taparía resultados).
            if (mqSheet.matches && details.open) details.open = false;
        }
        if (backdrop) backdrop.addEventListener('click', closeSheet);
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && inSheet()) closeSheet(); });

        // Arrastrar hacia abajo desde el asa/cabecera para cerrar (gesto nativo de hoja).
        (function () {
            if (!panel) return;
            var startY = 0, dy = 0, dragging = false;
            panel.addEventListener('touchstart', function (e) {
                if (!inSheet() || e.touches.length !== 1) return;
                if (!e.target.closest('.yf-adv-handle, .yf-adv-head')) return;
                dragging = true; dy = 0; startY = e.touches[0].clientY;
                panel.style.transition = 'none';
            }, { passive: true });
            panel.addEventListener('touchmove', function (e) {
                if (!dragging) return;
                dy = Math.max(0, e.touches[0].clientY - startY);
                panel.style.transform = 'translateY(' + dy + 'px)';
                if (dy > 0) e.preventDefault();
            }, { passive: false });
            function end() {
                if (!dragging) return; dragging = false;
                if (dy > 110) { panel.style.transition = ''; panel.style.transform = ''; closeSheet(); }
                else { panel.style.transition = 'transform .2s ease'; panel.style.transform = '';
                       setTimeout(function () { panel.style.transition = ''; }, 220); }
            }
            panel.addEventListener('touchend', end, { passive: true });
            panel.addEventListener('touchcancel', end, { passive: true });
        })();

        // Chips: en hoja togglean `pending`; en desktop son enlaces normales.
        root.querySelectorAll('.yf-chip[data-fkey]').forEach(function (chip) {
            chip.addEventListener('click', function (e) {
                if (!inSheet()) return;                // desktop: deja navegar el <a>
                e.preventDefault();
                var k = chip.getAttribute('data-fkey'), v = chip.getAttribute('data-fval');
                if (pending[k] === v) delete pending[k]; else pending[k] = v;
                refreshChips();
                updateCount();
            });
        });

        // Slider de nota: tooltip en vivo siempre; aplica al soltar SOLO fuera de la hoja.
        if (slider) {
            slider.addEventListener('input', function () {
                var v = Number(slider.value);
                if (out) out.textContent = v > 0 ? '★ ' + v : 'Cualquiera';
                if (inSheet()) { if (v > 0) pending.rating = String(v); else delete pending.rating; updateCount(); }
            });
            slider.addEventListener('change', function () {
                if (inSheet()) return;                 // en hoja, espera a "Aplicar"
                var v = Number(slider.value);
                apply({ rating: v > 0 ? String(v) : null });
            });
        }

        // Rango de años: en hoja actualiza pending; fuera, aplica al confirmar (Enter/blur).
        function applyRange() {
            apply({ yearFrom: from && from.value ? from.value : null, yearTo: to && to.value ? to.value : null, decade: null, year: null });
        }
        function pendRange() {
            if (from && from.value) pending.yearFrom = from.value; else delete pending.yearFrom;
            if (to && to.value) pending.yearTo = to.value; else delete pending.yearTo;
            updateCount();
        }
        [from, to].forEach(function (el) {
            if (!el) return;
            el.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); inSheet() ? pendRange() : applyRange(); } });
            el.addEventListener('change', function () { inSheet() ? pendRange() : applyRange(); });
        });

        // "Aplicar" (solo hoja): una sola recarga con todo lo acumulado.
        if (applyBtn) applyBtn.addEventListener('click', applyPending);

        // "Borrar todo" dentro de la hoja: limpia pending; fuera, deja navegar el <a>.
        var clearLink = root.querySelector('[data-adv-clear]');
        if (clearLink) clearLink.addEventListener('click', function (e) {
            if (!inSheet()) return;
            e.preventDefault();
            pending = {};
            refreshChips();
            updateCount();
        });
    });
</script>

<style>
    .yf-adv-wrap { margin-bottom: 24px; }

    /* Trigger ("Filtros avanzados") */
    .yf-adv { border: 0; }
    .yf-adv-trigger {
        display: flex; align-items: center; justify-content: space-between;
        gap: 12px; cursor: pointer; list-style: none;
        padding: 10px 14px;
        background: var(--bg-elev);
        border: 1px solid var(--border);
        border-radius: var(--r-md);
        box-shadow: var(--sh-sm);
        font-size: 14px; font-weight: 500; color: var(--text-2);
        transition: border-color .15s ease;
    }
    .yf-adv-trigger::-webkit-details-marker { display: none; }
    .yf-adv-trigger:hover { border-color: var(--border-strong); }
    .yf-adv-trigger-left, .yf-adv-trigger-right { display: inline-flex; align-items: center; gap: 8px; }
    .yf-adv-count {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 20px; height: 20px; padding: 0 6px;
        border-radius: var(--r-full);
        background: var(--accent); color: #fff;
        font-family: var(--font-mono); font-size: 11px; font-weight: 700;
    }
    .yf-adv-order {
        font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em;
        text-transform: uppercase; color: var(--text-3);
    }
    .yf-adv-order strong { color: var(--text-2); }
    .yf-adv-chev { color: var(--text-3); transition: transform .2s ease; }
    .yf-adv[open] .yf-adv-chev { transform: rotate(180deg); }

    /* Panel */
    .yf-adv-panel {
        margin-top: 8px;
        background: var(--bg-elev);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        box-shadow: var(--sh-md);
        padding: 18px;
        display: flex; flex-direction: column; gap: 18px;
    }
    .yf-adv-head { display: flex; align-items: center; justify-content: space-between; }
    .yf-adv-head h3 { margin: 0; font-size: 15px; font-weight: 700; color: var(--text); }
    .yf-adv-clear { font-size: 12.5px; font-weight: 500; color: var(--text-3); text-decoration: none; }
    .yf-adv-clear:hover { color: var(--accent); }

    .yf-filter-group { display: flex; flex-direction: column; gap: 8px; }
    .yf-group-label {
        margin: 0; font-family: var(--font-mono); font-size: 10.5px;
        letter-spacing: .12em; text-transform: uppercase; color: var(--text-3);
    }
    .yf-group-val { color: var(--accent); margin-left: 6px; }

    /* Chips */
    .yf-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .yf-chip {
        display: inline-flex; align-items: center;
        padding: 6px 12px; border-radius: var(--r-full);
        font-size: 13px; font-weight: 500; text-decoration: none;
        background: var(--bg-tint); color: var(--text-2);
        border: 1px solid var(--border);
        transition: all .15s ease;
    }
    .yf-chip:hover { border-color: var(--border-strong); color: var(--text); }
    .yf-chip.is-active {
        background: var(--accent); color: #fff; border-color: var(--accent);
    }

    /* Rango de años */
    .yf-range { display: flex; align-items: center; gap: 10px; }
    .yf-range-input {
        width: 90px; padding: 7px 10px;
        font-family: var(--font-mono); font-size: 13px;
        border: 1px solid var(--border); border-radius: var(--r-sm);
        background: #fff; color: var(--text);
    }
    .yf-range-input:focus { outline: none; border-color: var(--primary); }
    .yf-range-sep { color: var(--text-3); }

    /* Slider de nota */
    .yf-rating-slider { display: flex; align-items: center; gap: 12px; }
    .yf-rating-slider input[type="range"] {
        -webkit-appearance: none; appearance: none;
        flex: 1; height: 6px; border-radius: 999px; outline: none;
        background: linear-gradient(90deg, #9CA3AF 0%, var(--rating-low) 45%, var(--rating-med) 72%, var(--rating-high) 100%);
