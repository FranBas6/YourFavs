---
/**
 * ActivityStat — tile KPI de la banda de resumen de /mislistas/actividad.
 * Tinta y fondo del icono salen de los tokens --a-{cat} / --a-{cat}-bg
 * (invertidos automáticamente en dark-mode.css).
 */
import { Icon } from 'astro-icon/components';

interface Props {
    cat: 'visto' | 'fav' | 'like' | 'ep' | 'pend' | 'pronto' | 'seguir' | 'rewatch' | 'rating' | 'person';
    icon: string;   // nombre Lucide, ej. 'eye'
    n: number;
    label: string;
}

const { cat, icon, n, label } = Astro.props;
---
<div class="stat-tile" style={`--tile-ink: var(--a-${cat}); --tile-bg: var(--a-${cat}-bg);`}>
    <div class="ico"><Icon name={`lucide:${icon}`} /></div>
    <div class="n">{n}</div>
    <div class="l">{label}</div>
</div>
