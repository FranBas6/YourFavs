---
import Layout from "../../layouts/Layout.astro";
import CatalogHeader from "../../components/CatalogHeader.astro";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import {getTrending, getTrendingPeople, parseAdvancedFilters, hasActiveFilters, applyClientFilters} from "../../services/API/shared/tmdbDiscoverService";
import {getGenreName} from "../../utils/constants/genres";
import {posterUrl} from "../../services/API/shared/tmdbClient";
import FilterBar from "../../components/FilterBar.astro";
import AdvancedFilters from "../../components/AdvancedFilters.astro";
import CardActor from "../../components/Cards/CardActor.astro";
import EmptyState from "../../components/EmptyState.astro";
import HoverPreview from "../../components/HoverPreview.astro";
import type {Movie} from "../../types/ApiMovie";
import type {Serie} from "../../types/ApiSerie";
import {safeFetch} from "../../utils/safeFetch";
import '../../styles/pages/catalogo/shared.css';
import '../../styles/pages/catalogo/card-animations.css';

const urlParams = new URL(Astro.request.url).searchParams;
const type = urlParams.get('type') || 'all';
const timeWindow = urlParams.get('time') === 'day' ? 'day' : 'week';

const filters = parseAdvancedFilters(urlParams);
const filtersActive = hasActiveFilters(filters);

const [rawMovies, rawSeries, trendingPeople] = await Promise.all([
    safeFetch(getTrending<Movie>('movie', timeWindow), 'tendencias/movies', [] as Movie[]),
    safeFetch(getTrending<Serie>('tv', timeWindow), 'tendencias/series', [] as Serie[]),
    safeFetch(getTrendingPeople(timeWindow), 'tendencias/people', []),
]);

// Los endpoints /trending no soportan params de discover, así que filtramos en memoria.
// El filtro de duración (runtime) no aplica — no viene en la respuesta de trending.
const trendingMovies = filtersActive ? applyClientFilters(rawMovies, filters, 'movie') : rawMovies;
const trendingSeries = filtersActive ? applyClientFilters(rawSeries, filters, 'tv') : rawSeries;

const visibleCount =
    ((type === 'all' || type === 'movies') ? trendingMovies.length : 0) +
    ((type === 'all' || type === 'series') ? trendingSeries.length : 0) +
    ((type === 'all' || type === 'people') ? trendingPeople.length : 0);

function buildFilterUrl(changes: Record<string, string | null>) {
    const p = new URLSearchParams(urlParams);
    for (const [k, v] of Object.entries(changes)) {
        if (v === null || v === '') p.delete(k);
        else p.set(k, v);
    }
    return `?${p.toString()}`;
}
---
<Layout title="Tendencias">
    <div class="px-1 sm:py-8">
        <CatalogHeader
            title="Tendencias"
            subtitle={`Lo más trending ${timeWindow === 'day' ? 'de hoy' : 'de la semana'} en películas y series`}
            color="red"
            icon="trending-up"
        />

        <FilterBar currentType={type} buildUrl={(t) => buildFilterUrl({ type: t })} showPeople />

        <AdvancedFilters filters={filters} buildUrl={buildFilterUrl} showRuntime={false} hideCoreFilters={type === 'people'}>
            <div slot="before">
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Período</p>
                <div class="flex flex-wrap gap-2">
                    <a href={buildFilterUrl({ time: 'week' })}
                       class={`inline-flex items-center px-3 py-1.5 rounded-full text-sm font-medium transition-all border ${timeWindow === 'week' ? 'bg-red-500 text-white border-red-500' : 'bg-white text-gray-600 border-gray-200 hover:border-red-300 hover:text-red-600'}`}>
                        Esta semana
                    </a>
                    <a href={buildFilterUrl({ time: 'day' })}
                       class={`inline-flex items-center px-3 py-1.5 rounded-full text-sm font-medium transition-all border ${timeWindow === 'day' ? 'bg-red-500 text-white border-red-500' : 'bg-white text-gray-600 border-gray-200 hover:border-red-300 hover:text-red-600'}`}>
                        Hoy
                    </a>
                </div>
            </div>
        </AdvancedFilters>

        <div class="flex items-center justify-between mb-6 text-sm text-gray-500">
            <span><strong class="text-gray-900">{trendingMovies.length + trendingSeries.length}</strong> títulos en tendencia</span>
            <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 bg-green-400 rounded-full"></span>
                En tiempo real
            </div>
        </div>

        {(type === 'all' || type === 'movies') && trendingMovies.length > 0 && (
            <div class="mb-12" id="peliculas">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-red-500 rounded-full"></span>
                    Películas Trending
                </h2>

                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
                    {trendingMovies.map((item) => (
                        <div class="card-wrapper group">
                            <HoverPreview tmdbId={item.id} tmdbType="movie" title={item.title} backdropPath={item.backdrop_path} href={`/movie/${item.id}`} year={item.release_date?.slice(0,4)} rating={item.vote_average}>
                                <CardMovie
                                    id={item.id.toString()}
                                    img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                    title={item.title}
                                    vote_average={item.vote_average}
                                    overview={item.overview}
                                    release_date={item.release_date}
                                    genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                />
                            </HoverPreview>
                        </div>
                    ))}
                </div>
            </div>
        )}

        {(type === 'all' || type === 'series') && trendingSeries.length > 0 && (
            <div class="mb-12" id="series">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-blue-500 rounded-full"></span>
                    Series Trending
                </h2>
                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
                    {trendingSeries.map((item) => (
                        <div class="card-wrapper group">
                            <HoverPreview tmdbId={item.id} tmdbType="tv" title={item.name} backdropPath={item.backdrop_path} href={`/serie/${item.id}`} year={item.first_air_date?.slice(0,4)} rating={item.vote_average}>
                                <CardSerie
                                    id={item.id.toString()}
                                    img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                    name={item.name}
                                    vote_average={item.vote_average}
                                    overview={item.overview}
                                    first_air_date={item.first_air_date}
                                    seasons={item.seasons}
                                    last_episode_to_air={item.last_episode_to_air}
                                    next_episode_to_air={item.next_episode_to_air}
                                    genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                />
                            </HoverPreview>
                        </div>
                    ))}
                </div>
            </div>
        )}

        {visibleCount === 0 && (
            <EmptyState
                variant={filtersActive ? 'filter' : 'empty'}
                title={filtersActive ? 'Sin resultados con esos filtros' : 'Sin tendencias disponibles'}
                description={filtersActive ? 'Prueba a relajar la nota mínima, la década o el idioma.' : 'Vuelve más tarde o explora otra sección.'}
            >
                {filtersActive && (
                    <a slot="cta" href={`/catalogo/tendencias${type !== 'all' ? `?type=${type}` : ''}`} class="inline-flex items-center gap-2 px-5 py-2.5 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800 transition-all">Limpiar filtros</a>
                )}
            </EmptyState>
        )}

        {(type === 'all' || type === 'people') && trendingPeople.length > 0 && (
            <div class="mb-12" id="personas">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-purple-500 rounded-full"></span>
                    Personas en tendencia
                </h2>
                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
                    {trendingPeople.slice(0, 20).map((person) => (
                        <div class="card-wrapper group">
                            <CardActor
                                id={person.id.toString()}
                                nombre={person.name}
                                imagen={person.profile_path ? `https://image.tmdb.org/t/p/w500${person.profile_path}` : "/placeholder-actor.jpg"}
                                popularidad={person.popularity}
                            />
                        </div>
                    ))}
                </div>
            </div>
        )}
    </div>
</Layout>
