---
import {buildUrl} from "../../utils/buildUrl";

interface Props {
    pageUrl: URL;
    filter: string;
    searchQuery?: string;
    genreFilter?: string;
    platformFilter?: string;
    availableGenres?: string[];
    tagsFilter?: string;
    availableTags?: string[];
}

const { pageUrl, filter, searchQuery = '', genreFilter = '', platformFilter = '', availableGenres = [], tagsFilter = '', availableTags = [] } = Astro.props;

const PLATFORM_OPTIONS = [
    { id: 8, label: 'Netflix' },
    { id: 119, label: 'Amazon' },
    { id: 337, label: 'Disney+' },
    { id: 1899, label: 'HBO' },
    { id: 350, label: 'Apple TV+' },
    { id: 2241, label: 'Movistar+' },
    { id: 63, label: 'Filmin' },
];

const typeFilters = [
    { key: 'todos', label: 'Todo', icon: 'M4 6h16M4 10h16M4 14h16M4 18h16' },
    { key: 'series', label: 'Series', icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
    { key: 'peliculas', label: 'Películas', icon: 'M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z' },
];

// Soporte multi-género: "Acción,Drama" → ["Acción", "Drama"]
const activeGenres = genreFilter ? genreFilter.split(',').filter(Boolean) : [];
const toggleGenre = (genre: string) => {
    if (activeGenres.includes(genre)) {
        return activeGenres.filter(g => g !== genre).join(',');
    }
    return [...activeGenres, genre].join(',');
};

// Soporte multi-plataforma: "8,337" → ["8", "337"]
const activePlatforms = platformFilter ? platformFilter.split(',').filter(Boolean) : [];
const togglePlatform = (id: string) => {
    if (activePlatforms.includes(id)) {
        return activePlatforms.filter(p => p !== id).join(',');
    }
    return [...activePlatforms, id].join(',');
};

// Soporte multi-tags: "comedia,90s" → ["comedia", "90s"]
const activeTags = tagsFilter ? tagsFilter.split(',').filter(Boolean) : [];
const toggleTag = (tag: string) => {
    if (activeTags.includes(tag)) {
        return activeTags.filter(t => t !== tag).join(',');
    }
    return [...activeTags, tag].join(',');
};

const hasActiveFilters = searchQuery || activeGenres.length > 0 || activePlatforms.length > 0 || activeTags.length > 0 || filter !== 'todos';
const activeCount = (searchQuery ? 1 : 0) + activeGenres.length + activePlatforms.length + activeTags.length + (filter !== 'todos' ? 1 : 0);
---
<details class="group relative" data-personal-filter>
    <summary class="flex items-center gap-2 px-3.5 py-2 bg-white rounded-xl border border-gray-200 shadow-sm cursor-pointer hover:shadow-md transition-all text-sm font-medium text-gray-600 whitespace-nowrap">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
        </svg>
        Filtros
        {activeCount > 0 && (
            <span class="text-xs px-1.5 py-0.5 bg-red-500 text-white rounded-full font-medium leading-none">{activeCount}</span>
        )}
    </summary>

    <div class="absolute right-0 top-full mt-2 z-50 w-80 sm:w-96 bg-white rounded-xl border border-gray-200 p-4 space-y-4 shadow-lg">
        <!-- Tipo -->
        <div class="flex flex-wrap gap-1.5 justify-center">
            {typeFilters.map(f => (
                <a href={buildUrl(pageUrl, { filter: f.key, search: searchQuery, genre: genreFilter, platforms: platformFilter, tags: tagsFilter })}
                   class={`flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-sm font-medium transition-all duration-200
                       ${filter === f.key
                           ? 'bg-red-500 text-white shadow-sm shadow-red-200'
                           : 'text-gray-500 hover:text-gray-900 hover:bg-gray-100'}`}>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d={f.icon}/>
                    </svg>
                    {f.label}
                </a>
            ))}
        </div>

        <!-- Búsqueda -->
        <form method="get" class="relative">
            <input type="hidden" name="filter" value={filter}/>
            {genreFilter && <input type="hidden" name="genre" value={genreFilter}/>}
            {platformFilter && <input type="hidden" name="platforms" value={platformFilter}/>}
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input
                name="search"
                type="text"
                value={searchQuery}
                placeholder="Buscar por nombre..."
                aria-label="Buscar por nombre"
                class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-200 bg-gray-50 text-sm text-gray-700 placeholder-gray-400 focus:outline-none focus:border-red-300 focus:ring-1 focus:ring-red-200 focus:bg-white transition-all"
                autocomplete="off"
            />
        </form>

        <!-- Géneros (multi-selección) -->
        {availableGenres.length > 0 && (
            <div>
                <p class="text-xs text-gray-400 mb-2">Géneros {activeGenres.length > 0 && `(${activeGenres.length})`}</p>
                <div class="flex flex-wrap gap-1.5">
                    <a href={buildUrl(pageUrl, { filter, search: searchQuery, genre: '', platforms: platformFilter, tags: tagsFilter })}
                       class={`min-h-[44px] md:min-h-0 inline-flex items-center px-3 py-2 md:px-2.5 md:py-1 rounded-full text-xs font-medium transition-all border
                           ${activeGenres.length === 0
                               ? 'bg-gray-800 text-white border-gray-800'
                               : 'bg-white text-gray-500 border-gray-200 hover:border-gray-400 hover:text-gray-700'}`}>
                        Todos
                    </a>
                    {availableGenres.map(genre => (
                        <a href={buildUrl(pageUrl, { filter, search: searchQuery, genre: toggleGenre(genre), platforms: platformFilter, tags: tagsFilter })}
                           class={`min-h-[44px] md:min-h-0 inline-flex items-center px-3 py-2 md:px-2.5 md:py-1 rounded-full text-xs font-medium transition-all border
                               ${activeGenres.includes(genre)
                                   ? 'bg-gray-800 text-white border-gray-800'
                                   : 'bg-white text-gray-500 border-gray-200 hover:border-gray-400 hover:text-gray-700'}`}>
                            {genre}
                        </a>
                    ))}
                </div>
            </div>
        )}

        <!-- Plataformas -->
        <div>
            <p class="text-xs text-gray-400 mb-2">Plataformas {activePlatforms.length > 0 && `(${activePlatforms.length})`}</p>
            <div class="flex flex-wrap gap-1.5">
                {PLATFORM_OPTIONS.map(platform => (
                    <a href={buildUrl(pageUrl, { filter, search: searchQuery, genre: genreFilter, platforms: togglePlatform(String(platform.id)), tags: tagsFilter })}
                       class={`min-h-[44px] md:min-h-0 inline-flex items-center px-3 py-2 md:px-2.5 md:py-1 rounded-full text-xs font-medium transition-all border
                           ${activePlatforms.includes(String(platform.id))
                               ? 'bg-gray-800 text-white border-gray-800'
                               : 'bg-white text-gray-500 border-gray-200 hover:border-gray-400 hover:text-gray-700'}`}>
                        {platform.label}
                    </a>
                ))}
            </div>
        </div>

        <!-- Tags personales -->
        {availableTags.length > 0 && (
            <div>
                <p class="text-xs text-gray-400 mb-2">Tus tags {activeTags.length > 0 && `(${activeTags.length})`}</p>
                <div class="flex flex-wrap gap-1.5">
                    {availableTags.map(tag => (
                        <a href={buildUrl(pageUrl, { filter, search: searchQuery, genre: genreFilter, platforms: platformFilter, tags: toggleTag(tag) })}
                           class={`min-h-[44px] md:min-h-0 inline-flex items-center px-3 py-2 md:px-2.5 md:py-1 rounded-full text-xs font-medium transition-all border
                               ${activeTags.includes(tag)
                                   ? 'bg-fuchsia-600 text-white border-fuchsia-600'
                                   : 'bg-white text-fuchsia-700 border-fuchsia-200 hover:border-fuchsia-400'}`}>
                            #{tag}
                        </a>
                    ))}
                </div>
            </div>
        )}

        <!-- Limpiar filtros -->
        {hasActiveFilters && (
            <div class="flex justify-center pt-1">
                <a href={buildUrl(pageUrl, { filter: 'todos', search: '', genre: '', platforms: '', tags: '' })}
                   class="text-xs text-gray-400 hover:text-red-500 transition-colors">
                    Limpiar filtros
                </a>
            </div>
        )}
    </div>
</details>

<script is:inline>
(function () {
    if (window.__pfFilterInit) return; // una sola vez aunque haya varias instancias
    window.__pfFilterInit = true;

    var KEY = 'pf-reopen';

    document.querySelectorAll('[data-personal-filter]').forEach(function (details) {
        // Reapertura SOLO tras interactuar con un filtro (el click navega y
        // recarga la página): flag efímero que se consume al usarse. Una carga
        // normal o un hard refresh siempre arrancan con el panel cerrado.
        try {
            if (sessionStorage.getItem(KEY)) {
                sessionStorage.removeItem(KEY);
                details.open = true;
            }
        } catch {}

        details.addEventListener('click', function (e) {
            // Click en un chip/enlace del panel → recordar reabrir tras la recarga.
            // "Limpiar filtros" no reabre: dejas de filtrar, el panel ya no interesa.
            var link = e.target.closest('a[href]');
            if (link && details.contains(link) && !/Limpiar filtros/.test(link.textContent)) {
                try { sessionStorage.setItem(KEY, '1'); } catch {}
            }
        });

        // La búsqueda interna también recarga → mismo trato
        var form = details.querySelector('form');
        if (form) form.addEventListener('submit', function () {
            try { sessionStorage.setItem(KEY, '1'); } catch {}
        });
    });

    // Cierre por click fuera y por Esc (el <details> nativo no lo trae)
    document.addEventListener('click', function (e) {
        document.querySelectorAll('[data-personal-filter][open]').forEach(function (details) {
            if (!details.contains(e.target)) details.open = false;
        });
    });

    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        document.querySelectorAll('[data-personal-filter][open]').forEach(function (details) {
            details.open = false;
        });
    });
})();
</script>
