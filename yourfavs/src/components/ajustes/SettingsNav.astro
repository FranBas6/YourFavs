---
/**
 * Navegación del panel de Ajustes. El MISMO componente sirve las dos caras:
 *   variant="nav"   → columna lateral de escritorio (≥1024px)
 *   variant="index" → índice de móvil, con el valor actual de cada sección a la derecha
 *
 * Van los dos en el HTML y los alterna el CSS (mismo patrón que el resumen/heatmap
 * duplicado de `mislistas/actividad.astro`): el viewport no se conoce en SSR, así que no
 * hay forma honesta de redirigir por tamaño de pantalla.
 *
 * Los valores ("8/11", "4 activas", "España") salen TODOS del perfil que ya está en
 * memoria — cero lecturas extra de Firestore.
 */
import { SETTINGS_GROUPS, SETTINGS_SECTIONS } from "../../utils/constants/settingsSections";
import { HOME_SECTIONS } from "../../utils/constants/homeSections";
import { SUPPORTED_COUNTRIES } from "../../services/API/shared/tmdbInfoService";
import type { UserProfile } from "../../services/BD/profile/userProfile";

interface Props {
    variant: 'nav' | 'index';
    /** Clave de la sección activa (solo pinta estado en variant="nav"). */
    active?: string;
    profile: UserProfile;
    user: { email?: string | null; name?: string | null; picture?: string | null };
}

const { variant, active, profile, user } = Astro.props;
const isNav = variant === 'nav';

const displayName = profile.display_name || user.name || (user.email ? user.email.split('@')[0] : 'Tú');

const initial = (() => {
    const base = (profile.display_name || user.name || user.email || '?').trim();
    return base.slice(0, 1).toUpperCase();
})();

// --- Valores por sección ----------------------------------------------------

// Home: cuántos bloques quedan visibles. Una clave sin preferencia guardada cuenta como
// visible (es el mismo criterio que usa `hiddenHomeKeys` al pintar la portada).
const homeTotal = HOME_SECTIONS.length;
const homeHidden = new Set((profile.homeLayout || []).filter((s) => s?.hidden).map((s) => s.key));
const homeVisible = HOME_SECTIONS.filter((s) => !homeHidden.has(s.key)).length;

const platformCount = (profile.platforms ?? []).length;

// Campana: 4 tipos van activados si no hay preferencia; "racha" solo si se marcó.
const np = profile.notifPrefs ?? {};
const notifCount = [
    np.episodes !== false,
    np.releases !== false,
    np.anniversary !== false,
    np.platform !== false,
    np.streak === true,
].filter(Boolean).length;

const regionLabel = SUPPORTED_COUNTRIES.find((c) => c.code === (profile.region || 'ES'))?.label ?? (profile.region || 'ES');

const themeLabel = { light: 'Claro', dark: 'Oscuro', system: 'Según el sistema' }[profile.theme || 'system'];

/** Texto de la derecha. En la navegación va apretado (mono, 10.5px); en el índice, legible. */
function valueFor(key: string): string {
    switch (key) {
        case 'perfil': return isNav ? '' : displayName;
        case 'gustos': return profile.onboarding === 'done' ? 'Configurados' : 'Sin configurar';
        case 'home': return isNav ? `${homeVisible}/${homeTotal}` : `${homeVisible} de ${homeTotal}`;
        case 'plataformas':
            if (platformCount === 0) return isNav ? '0' : 'Ninguna';
            return isNav ? String(platformCount) : `${platformCount} activa${platformCount === 1 ? '' : 's'}`;
        case 'notificaciones': return isNav ? String(notifCount) : `${notifCount} activas`;
        case 'contenido': return regionLabel;
        case 'apariencia': return themeLabel;
        case 'calendario': return isNav ? '' : 'Enlace .ics';
        case 'cuenta': return isNav ? '' : (user.email ?? '');
        default: return '';
    }
}

// SVG en línea, 17px, stroke 1.7 (spec del handoff). Un `d` por icono; los que necesitan
// dos trazos llevan el segundo en `d2`.
const ICONS: Record<string, { d: string; d2?: string }> = {
    user:     { d: 'M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2', d2: 'M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0' },
    heart:    { d: 'M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21.2l8.8-8.8a5.5 5.5 0 0 0 0-7.8z' },
    layout:   { d: 'M3 5h18v5H3zM3 14h8v5H3zM14 14h7v5h-7z' },
    tv:       { d: 'M2 7h20v12H2z', d2: 'm7 3 5 4 5-4' },
    bell:     { d: 'M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9', d2: 'M13.7 21a2 2 0 0 1-3.4 0' },
    globe:    { d: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z', d2: 'M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18' },
    palette:  { d: 'M12 21a9 9 0 1 1 0-18c4.5 0 8 3 8 6.5 0 2.5-2 3.5-4 3.5h-1.5a2 2 0 0 0-1.3 3.5c.4.4.3 1.3-.2 1.5', d2: 'M8.5 10.5h.01M12 8h.01M15.5 10.5h.01' },
    calendar: { d: 'M3 5h18v16H3z', d2: 'M3 10h18M8 3v4M16 3v4' },
    shield:   { d: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z' },
};

const groups = SETTINGS_GROUPS.map((g) => ({
    ...g,
    items: SETTINGS_SECTIONS.filter((s) => s.group === g.key),
}));
---
{isNav ? (
    <aside class="aj-nav-col">
        <div class="aj-me">
            <span class="aj-me-avatar">
                {user.picture
                    ? <img src={user.picture} alt="" referrerpolicy="no-referrer" />
                    : initial}
            </span>
            <span class="aj-me-text">
                <span class="aj-me-name">{displayName}</span>
                <span class="aj-me-mail">{user.email}</span>
            </span>
        </div>

        {groups.map((g) => (
            <div class="aj-group">
                <p class="aj-group-title">{g.label}</p>
                {g.items.map((s) => (
                    <a
                        href={`/perfil/${s.key}`}
                        class:list={["aj-nav-item", { "is-active": s.key === active }]}
                        aria-current={s.key === active ? 'page' : undefined}
                    >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d={ICONS[s.icon].d} />
                            {ICONS[s.icon].d2 && <path d={ICONS[s.icon].d2} />}
                        </svg>
                        <span class="aj-nav-label">{s.label}</span>
                        {valueFor(s.key) && <span class="aj-nav-value">{valueFor(s.key)}</span>}
                    </a>
                ))}
            </div>
        ))}
    </aside>
) : (
    <div class="aj-index">
        {groups.map((g) => (
            <div class="aj-index-list">
                <p class="aj-index-group">{g.label}</p>
                {g.items.map((s) => (
                    <a href={`/perfil/${s.key}`} class="aj-index-row">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d={ICONS[s.icon].d} />
                            {ICONS[s.icon].d2 && <path d={ICONS[s.icon].d2} />}
                        </svg>
                        <span class="aj-index-row-label">{s.label}</span>
                        <span class="aj-index-row-value">{valueFor(s.key)}</span>
                        <svg class="aj-index-row-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m9 18 6-6-6-6" />
                        </svg>
                    </a>
                ))}
            </div>
        ))}
    </div>
)}
