# Copia este fichero como `.env` y rellena los valores. Todas son de servidor: el navegador no
# habla ni con TMDB ni con Supabase directamente.

# --- TMDB (https://www.themoviedb.org/settings/api) ---
# Token de lectura (v4). Autentica todas las llamadas con `Authorization: Bearer` y permite
# «Importar desde tu cuenta de TMDB». Es el recomendado.
TMDB_READ_TOKEN=
# Clave v3. Respaldo si falta el token o TMDB lo rechaza.
TMDB_API_KEY=

# --- Supabase (`npm run db:start` imprime los de local) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Inicio de sesión con Google en el Supabase local (supabase/config.toml) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Opcional ---
# Quién ve /admin/reportes (uids separados por comas). Sin ella, nadie.
ADMIN_UIDS=
