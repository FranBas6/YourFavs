---
import Layout from "../../layouts/Layout.astro";
import { getMoviesAndSeriesByMemberName } from "../../services/API/Team/InfoMember";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import { getGenreName } from "../../utils/constants/genres";
import { getMainRole, calculateAge } from "../../utils/constants/helpers/team-helpers";
import { posterUrl } from "../../services/API/shared/tmdbClient";

const { name } = Astro.params;
const { searchParams } = Astro.url;
const sortBy = searchParams.get('sort') || 'quality';

if (!name) {
    throw new Error("Nombre del miembro del equipo no encontrado en la URL");
}

const {
    success,
    memberInfo,
    socialLinks,
    movies,
    series,
    error
} = await getMoviesAndSeriesByMemberName(name, sortBy);

if (!success) {
    throw new Error(error || "Error al obtener información del miembro");
}

const mainRole = memberInfo ? getMainRole(memberInfo.known_for_department) : "";
const age = memberInfo ? calculateAge(memberInfo.birthday, memberInfo.deathday) : null;
const totalWorks = movies.length + series.length;

const hasSocial = socialLinks && Object.values(socialLinks).some(v => v);
---
<Layout title={`${name}`}>
    <section class="px-1 sm:py-8">
        <!-- Header -->
        <header class="mb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-1">{name}</h1>
            <p class="text-gray-500 text-base">{mainRole} · {totalWorks} producciones</p>
        </header>

        <!-- Info card -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 mb-6">
            <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5">
                {memberInfo?.profile_path && (
                    <img
                        src={posterUrl(memberInfo.profile_path, 'w185')}
                        alt={name}
                        class="w-28 h-28 rounded-full object-cover border-2 border-gray-200 flex-shrink-0"
                        loading="lazy"
                    />
                )}
                <div class="flex-1 text-center sm:text-left">
                    <div class="flex flex-wrap justify-center sm:justify-start gap-1.5 text-xs sm:text-sm mb-3">
                        {age && (
                            <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded-full">
                                {memberInfo?.deathday ? `Falleció a los ${age} años` : `${age} años`}
                            </span>
                        )}
                        {memberInfo?.place_of_birth && (
                            <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded-full">{memberInfo.place_of_birth}</span>
                        )}
                        {memberInfo?.birthday && (
                            <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded-full">
                                {new Date(memberInfo.birthday).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
                            </span>
                        )}
                        <span class="px-2 py-0.5 bg-red-50 text-red-600 rounded-full">{movies.length} películas</span>
                        <span class="px-2 py-0.5 bg-blue-50 text-blue-600 rounded-full">{series.length} series</span>
                        {memberInfo?.popularity && (
                            <span class="px-2 py-0.5 bg-yellow-50 text-yellow-700 rounded-full">Pop. {memberInfo.popularity.toFixed(0)}</span>
                        )}
                    </div>

                    {/* Redes sociales */}
                    {hasSocial && (
                        <div class="flex flex-wrap justify-center sm:justify-start gap-2 mb-3">
                            {socialLinks.imdb && (
                                <a href={socialLinks.imdb} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-yellow-50 text-yellow-800 rounded-lg hover:bg-yellow-100 transition-colors">
                                    IMDb
                                </a>
                            )}
                            {socialLinks.instagram && (
                                <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-pink-50 text-pink-700 rounded-lg hover:bg-pink-100 transition-colors">
                                    Instagram
                                </a>
                            )}
                            {socialLinks.twitter && (
                                <a href={socialLinks.twitter} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-sky-50 text-sky-700 rounded-lg hover:bg-sky-100 transition-colors">
                                    Twitter
                                </a>
                            )}
                            {socialLinks.facebook && (
                                <a href={socialLinks.facebook} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100 transition-colors">
                                    Facebook
                                </a>
                            )}
                            {socialLinks.tiktok && (
                                <a href={socialLinks.tiktok} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors">
                                    TikTok
                                </a>
                            )}
                            {socialLinks.youtube && (
                                <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-red-50 text-red-700 rounded-lg hover:bg-red-100 transition-colors">
                                    YouTube
                                </a>
                            )}
                        </div>
                    )}

                    {/* Biografía */}
                    {memberInfo?.biography && (
                        <details class="text-sm">
                            <summary class="cursor-pointer text-gray-500 hover:text-gray-700 font-medium">
                                Biografía
                            </summary>
                            <p class="mt-2 text-gray-600 leading-relaxed whitespace-pre-line">{memberInfo.biography}</p>
                        </details>
                    )}
                </div>
            </div>
        </div>

        <!-- Navegación rápida -->
        <div class="flex flex-wrap gap-2 mb-4">
            {movies.length > 0 && (
                <a href="#peliculas" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-red-600 bg-red-50 border border-red-200 rounded-lg hover:bg-red-100 transition-colors">
                    <span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span>
                    Películas ({movies.length})
                </a>
            )}
            {series.length > 0 && (
                <a href="#series" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-blue-600 bg-blue-50 border border-blue-200 rounded-lg hover:bg-blue-100 transition-colors">
                    <span class="w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
                    Series ({series.length})
                </a>
            )}
        </div>

        <!-- Ordenación -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
            <h2 class="text-lg font-semibold text-gray-800">Filmografía ({totalWorks})</h2>
            <div class="inline-flex gap-1 bg-gray-100 rounded-xl p-1">
                <a href="?sort=quality"
                   class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all ${sortBy === 'quality' ? 'bg-gray-900 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900 hover:bg-white'}`}>
                    Mejor Valoradas
                </a>
                <a href="?sort=popularity"
                   class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all ${sortBy === 'popularity' ? 'bg-gray-900 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900 hover:bg-white'}`}>
                    Más Populares
                </a>
                <a href="?sort=date"
                   class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all ${sortBy === 'date' ? 'bg-gray-900 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900 hover:bg-white'}`}>
                    Más Recientes
                </a>
            </div>
        </div>

        <div class="space-y-10">
            <!-- Películas -->
            <section id="peliculas" class="scroll-mt-20">
                <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-red-500 rounded-full"></span>
                    Películas
                    <span class="text-sm font-normal text-gray-4000">({movies.length})</span>
                </h3>

                {movies.length === 0 && (
                    <div class="bg-gray-50 border border-gray-100 rounded-xl p-8 text-center">
                        <p class="text-gray-4000">No se encontraron películas</p>
                    </div>
                )}
                {movies.length > 0 && (
                    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                        {movies.map((item) => (
                            <CardMovie
                                id={item.id.toString()}
                                img={item.poster_path || "/placeholder.jpg"}
                                title={item.title}
                                vote_average={item.vote_average}
                                overview={item.overview}
                                release_date={item.release_date}
                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                character={item.role}
                            />
                        ))}
                    </div>
                )}
            </section>

            <!-- Series -->
            <section id="series" class="scroll-mt-20">
                <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-blue-500 rounded-full"></span>
                    Series
                    <span class="text-sm font-normal text-gray-4000">({series.length})</span>
                </h3>

                {series.length === 0 && (
                    <div class="bg-gray-50 border border-gray-100 rounded-xl p-8 text-center">
                        <p class="text-gray-4000">No se encontraron series</p>
                    </div>
                )}
                {series.length > 0 && (
                    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                        {series.map((item) => (
                            <CardSerie
                                id={item.id.toString()}
                                img={item.poster_path || "/placeholder.jpg"}
                                name={item.name}
                                vote_average={item.vote_average}
                                overview={item.overview}
                                first_air_date={item.first_air_date}
                                genres={item.genre_ids?.map((id: number) => ({id, name: getGenreName(id)}))}
                                character={item.role}
                            />
                        ))}
                    </div>
                )}
            </section>
        </div>
    </section>
</Layout>
