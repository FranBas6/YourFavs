---
/**
 * Póster de carril del perfil público (handoff §6.3 / §6.5): póster 2:3 enlazado a la ficha, una
 * línea de título y debajo o una línea de meta («7 temporadas», «Película · 2003») o la nota del
 * dueño. NO es la card completa: sin sinopsis ni pills.
 *
 * Esquinas: `#n` del ranking arriba a la izquierda (mismo badge que `CardSerie`), ⊕ abajo a la
 * derecha para quien no es el dueño, y «Ocultar» arriba a la derecha solo para el dueño.
 */
import { posterUrl } from '../../services/API/shared/tmdbClient';
import SaveToButton from './SaveToButton.astro';
import OwnerRating from './OwnerRating.astro';

interface Props {
    mediaType: 'movie' | 'tv';
    tmdbId: number;
    title: string;
    posterPath: string | null;
    /** Línea bajo el título. Se ignora si hay `rating`. */
    meta?: string | null;
    /** Puesto en el ranking de series favoritas. */
    rank?: number;
    rating?: { score: number; ownerName: string; avatarSrc: string | null };
    /** Visitante (con o sin sesión): enseña el ⊕. */
    canSave?: boolean;
    /** Dueño en una sección automática: enseña «Ocultar». */
    canHide?: boolean;
    size?: 'w185' | 'w342';
}
const { mediaType, tmdbId, title, posterPath, meta, rank, rating, canSave = false, canHide = false, size = 'w185' } = Astro.props;
const href = `/${mediaType === 'movie' ? 'movie' : 'serie'}/${tmdbId}`;
---
<div class="pf-tile group" data-title-key={`${mediaType}:${tmdbId}`}>
    <a class="pf-poster" href={href} aria-label={title}>
        {posterPath
            ? <img src={posterUrl(posterPath, size)} alt="" loading="lazy" decoding="async" />
            : <span class="pf-noimg">{title}</span>}
        {rank != null && <span class="pf-rank bg-gradient-to-r from-amber-400 to-orange-500">#{rank}</span>}
    </a>
    {canSave && <SaveToButton mediaType={mediaType} tmdbId={tmdbId} title={title} posterPath={posterPath} />}
    {canHide && (
        <button type="button" class="pf-hide js-pf-hide" data-mt={mediaType} data-id={String(tmdbId)} data-title={title} data-poster={posterPath ?? ''}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.53 13.53 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><path d="m2 2 20 20"/></svg>
            Ocultar
        </button>
    )}
    <a class="pf-tlink" href={href} tabindex="-1">
        <div class="pf-t" title={title}>{title}</div>
    </a>
    {rating
        ? <OwnerRating score={rating.score} ownerName={rating.ownerName} avatarSrc={rating.avatarSrc} />
        : meta && <div class="pf-m">{meta}</div>}
</div>
