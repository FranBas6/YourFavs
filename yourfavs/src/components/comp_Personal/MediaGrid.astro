---
import CardSerie from '../CardSerie.astro';
import CardMovie from '../CardMovie.astro';

const { items, type } = Astro.props;
---

    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 w-full">
        {items.map((item) => (
            type === 'serie' ? (
                <CardSerie {...item} />
            ) : (
                <CardMovie {...item} />
            )
        ))}
    </div>
