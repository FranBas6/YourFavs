                                    {additionalInfo.networks.map((network: any) => (
                                        <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                                            {network.logo_path && (
                                                <img
                                                    src={`https://image.tmdb.org/t/p/w92${network.logo_path}`}
                                                    alt={network.name}
                                                    class="w-12 h-8 object-contain flex-shrink-0"
                                                    loading="lazy"
                                                />
                                            )}
                                            <div class="min-w-0 flex-1">
                                                <p class="font-medium text-gray-800 truncate">{network.name}</p>
