---
/**
 * «Estás viendo» (portada) / «Continuar viendo» (Siguiendo) — handoff
 * `docs/design_handoff_estas_viendo`.
 *
 * Un carrusel con lo que tienes a medias: primero las películas en «Viendo» y luego una tarjeta por
 * serie con el SIGUIENTE episodio emitido que no has visto. «Marcar visto» / «Terminar» van sin
 * recargar (`scripts/home/nextEpisode.ts`): la tarjeta pasa al siguiente episodio o a «al día».
 *
 * El marcado de las tarjetas sale de `lib/nextEpisodeView.ts`, el mismo que usa el navegador al
 * rehacerlas, así que se ven exactamente igual en los dos sitios.
 */
import SectionHeader from '../SectionHeader.astro';
import type { NextEpisodeItem } from '../../services/API/Series/nextEpisode';
import type { ViendoMovie } from '../../services/API/Movies/viendoMovies';
import { movieCard, serieCard } from '../../lib/nextEpisodeView';
import { icon } from '../../lib/social/ui';
import { getSpoilerPrefs } from '../../services/BD/shared/spoilerPrefs';
import '../../styles/shared/spoil.css';
import '../../styles/components/next-episode.css';

interface Props {
    items: NextEpisodeItem[];
    /** Películas en estado "Viendo" (Bloque 2) — se muestran junto a las series. */
    movies?: ViendoMovie[];
    /** Título de la sección (Home: "Estás viendo"; siguiendo: "Continuar viendo"). */
    title?: string;
    /** «Mi seguimiento →» (en la propia página de Siguiendo sobra). */
    showLink?: boolean;
}

const { items, movies = [], title = 'Continuar viendo', showLink = true } = Astro.props;
const total = items.length + movies.length;
// Las que se ven al cargar (4 en escritorio) con imagen inmediata; el resto, diferida.
const EAGER = 4;

// Modo sin spoilers, como en las fichas: la serie manda sobre el ajuste general, y solo «ocultar
// fotogramas» cuenta (la tarjeta ya no lleva sinopsis). El siguiente episodio nunca está visto.
const user = Astro.locals.user;
const prefs = user && items.length ? await getSpoilerPrefs(items.map((it) => it.id)) : new Map<number, boolean>();
const hideStill = (id: number) => !!user && (prefs.get(id) ?? user.spoilers?.enabled === true) && user.spoilers?.hideStills !== false;
---
{total > 0 && (
    <section class="nv-sec mb-8" data-nep aria-labelledby="nv-title">
        <SectionHeader title={title} icon="play" color="green" cap={`${total} en curso`} headingId="nv-title" />
        <div class="nv-h-r">
            <button type="button" class="nv-arr" data-nv-prev aria-label="Anteriores" disabled set:html={icon('chevron-left')} />
            <button type="button" class="nv-arr" data-nv-next aria-label="Siguientes" set:html={icon('chevron-right')} />
            {showLink && <a href="/mislistas/siguiendo">Mi seguimiento<Fragment set:html={icon('arrow-right')} /></a>}
        </div>
        <div class="nv-row" data-nv-row>
            {movies.map((mv) => <Fragment set:html={movieCard(mv)} />)}
            {items.map((it, i) => <Fragment set:html={serieCard(it, { lazy: movies.length + i >= EAGER, hideStill: hideStill(it.id) })} />)}
        </div>
        <p class="sr-only" aria-live="polite" data-nv-live></p>
    </section>
)}

<script>
    import '../../scripts/home/nextEpisode';
</script>
