                        </p>
                        <div class="mt-4 flex justify-center gap-8 text-sm text-gray-600">
                            <div>
                                <span class="font-semibold text-blue-600">{((stats.series.total / stats.general.totalContent) * 100).toFixed(0)}%</span>
                                <span> Series</span>
                            </div>
                            <div>
                                <span class="font-semibold text-red-600">{((stats.movies.total / stats.general.totalContent) * 100).toFixed(0)}%</span>
                                <span> Películas</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {/* Series Me Gustan (solo se muestra si se filtran series o todos) */}
            {(showSeries || showAll) && (
                <section id="series-section" class="mb-8 scroll-mt-24">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4 flex justify-between items-center bg-blue-50 rounded-lg px-4 py-3 border-l-4 border-blue-500">
                            <span class="flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                                </svg>
                            Series Me Gustan
                            </span>
                            <span class="text-sm text-blue-600 bg-blue-100 rounded-full px-3 py-1 font-bold">
                                {seriesPaginadas.length}
                                {searchQuery || genreFilter ? ` de ${likedSeries.length}` : ` de ${likedSeries.length}`}
                            </span>
                        </h3>

                        {seriesPaginadas.length === 0 ? (
                                <div class="empty-state bg-gradient-to-br from-blue-50 to-indigo-50 border-2 border-dashed border-blue-300 rounded-xl p-8 text-center">
