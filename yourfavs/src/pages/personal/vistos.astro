---
import Layout from "../../layouts/Layout.astro"
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import {
    getSeriesVistas,
} from "../../services/BD/series/yourfavsSerie";
import {getMoviesVistas} from "../../services/BD/movies/yourfavsMovie";
import {fetchMovieDetails} from "../../services/API/Movies/tmdbMovies";
import {fetchSerieDetails} from "../../services/API/Series/tmdbSeries";
import {getGenreName} from "../../utils/constants/genres";
import {processBatch} from "../../utils/processBatch";
import {calculateStats} from "../../utils/calculateStats";
import {buildUrl} from "../../utils/buildUrl";
import StatsPanel from "../../components/personal/StatsPanel.astro";
import PersonalNav from "../../components/personal/PersonalNav.astro";
import PersonalFilter from "../../components/personal/PersonalFilter.astro";
import '../../styles/pages/personal/personal.css';

let seriesVistas: any[] = [];
let peliculasVistas: any[] = [];
let errorMessage = "";

let seriesData: any[] = [];
let moviesData: any[] = [];

const filter = Astro.url.searchParams.get("filter") || "todos";
const searchQuery = Astro.url.searchParams.get("search") || "";
const genreFilter = Astro.url.searchParams.get("genre") || "";
const showSeries = filter === "series" || filter === "todos";
const showMovies = filter === "peliculas" || filter === "todos";
const showAll = filter === "todos";

const seriesPage = parseInt(Astro.url.searchParams.get("seriesPage") || "1");
const moviesPage = parseInt(Astro.url.searchParams.get("moviesPage") || "1");
const ITEMS_PER_PAGE = 20;

try {
    [seriesData, moviesData] = await Promise.all([
        getSeriesVistas(),
        getMoviesVistas()
    ]);

    const [seriesResults, moviesResults] = await Promise.all([
        processBatch(seriesData.map(s => s.id), (id) => fetchSerieDetails(id), 10),
        processBatch(moviesData.map(p => p.id), (id) => fetchMovieDetails(id), 10)
    ]);

    seriesVistas = seriesResults.filter(s => s !== null);
    peliculasVistas = moviesResults.filter(m => m !== null);
} catch (error) {
    console.error("Error al cargar contenido visto:", error);
    errorMessage = error instanceof Error ? error.message : "Error desconocido al cargar datos";
}

const seriesItemsToShow = seriesPage * ITEMS_PER_PAGE;
const moviesItemsToShow = moviesPage * ITEMS_PER_PAGE;

const seriesPaginadas = seriesVistas.slice(0, seriesItemsToShow);
const peliculasPaginadas = peliculasVistas.slice(0, moviesItemsToShow);

const hasMoreSeries = seriesVistas.length > seriesItemsToShow;
const hasMoreMovies = peliculasVistas.length > moviesItemsToShow;

const pageUrl = Astro.url;

const stats = calculateStats({
    seriesData,
    moviesData,
    seriesDetails: seriesVistas,
    moviesDetails: peliculasVistas,
});
---
<Layout title="Vistos">
    {errorMessage && (
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="bg-red-500/10 border border-red-500 text-red-500 px-4 py-3 rounded">
                <strong>Error:</strong> {errorMessage}
            </div>
        </div>
    )}
    <div class="favorites-container max-w-7xl mx-auto px-4 py-6 space-y-6">
        <!-- Checkbox oculto para controlar el desplegable -->
        <input type="checkbox" id="search-toggle" class="search-toggle hidden"/>

        <PersonalFilter pageUrl={pageUrl} filter={filter} searchQuery={searchQuery} genreFilter={genreFilter} />

        <PersonalNav currentPage="/personal/vistos" />

        <!-- Contenedor principal de contenido -->
        <div class="content-sections space-y-12">
            {/* SECCIÓN DE VISTOS */}
            <div class="favorites-section animate-fadeIn">
                <div class="section-header flex items-center gap-4 mb-6">
                    <div class="flex-grow h-0.5 bg-gradient-to-r from-green-300 to-green-500"></div>
                    <h2 class="text-2xl font-bold text-gray-800 flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 mr-2 text-green-500"
                            viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd"
                                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                clip-rule="evenodd"/>
                        </svg>
                        Contenido Visto
                    </h2>
                    <div class="flex-grow h-0.5 bg-gradient-to-r from-green-500 to-green-300 mb-10"></div>
                </div>

                <StatsPanel stats={stats} />

                {/* Series Vistas */}
                {(showSeries || showAll) && (
                    <section id="series-section" class="mb-8 scroll-mt-24">
                            <h3 class="text-lg font-semibold text-gray-800 mb-4 flex justify-between items-center bg-blue-50 rounded-lg px-4 py-3 border-l-4 border-blue-500">
                                <span class="flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                                    </svg>
                                Series Vistas
                                </span>
                                <span class="text-sm text-blue-600 bg-blue-100 rounded-full px-3 py-1 font-bold">
                                    {seriesPaginadas.length}
                                    {searchQuery || genreFilter ? ` de ${seriesData.length}` : ` de ${seriesData.length}`}
                                </span>
                            </h3>

                            {seriesPaginadas.length === 0 ? (
                                    <div class="empty-state bg-gradient-to-br from-blue-50 to-indigo-50 border-2 border-dashed border-blue-300 rounded-xl p-8 text-center">
                                        <div class="max-w-sm mx-auto">
                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                class="h-16 w-16 mx-auto text-blue-400 mb-4" fill="none"
                                                viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                                    d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                                            </svg>
                                            <h3 class="text-xl font-semibold text-blue-800 mb-2">
                                                {searchQuery || genreFilter ? 'No se encontraron series' : '¡Comienza tu colección!'}
                                            </h3>
                                            <p class="text-blue-600">
                                                {searchQuery || genreFilter ?
                                                    'Intenta ajustar los filtros de búsqueda.' :
                                                    'Explora nuestro catálogo y marca tus series vistas.'
                                                }
                                            </p>
                                        </div>
                                    </div>
                            ) : (
                                    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 w-full">
                                        {seriesPaginadas.map((item) => (
                                                <CardSerie
                                                        id={item.id.toString()}
                                                        img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                        name={item.name}
                                                        vote_average={item.vote_average}
                                                        overview={item.overview}
                                                        first_air_date={item.first_air_date}
                                                        seasons={item.seasons}
                                                        last_episode_to_air={item.last_episode_to_air}
                                                        next_episode_to_air={item.next_episode_to_air}
                                                        genres={item.genre_ids?.map((id: number) => ({
                                                            id,
                                                            name: getGenreName(id)
                                                        }))}
                                                        status={item.status}
                                                />
                                        ))}
                                    </div>
                            )}
                            {hasMoreSeries && (
                                <div class="flex justify-center mt-8">
                                    <a 
                                        href={buildUrl(pageUrl, {
                                            filter: filter,
                                            search: searchQuery,
                                            genre: genreFilter,
                                            seriesPage: Math.ceil(seriesData.length / ITEMS_PER_PAGE).toString(),
                                            moviesPage: moviesPage.toString()
                                        }) + '#series-section'}
                                        class="px-8 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-xl hover:from-blue-700 hover:to-indigo-700 transition-all font-semibold flex items-center gap-2 shadow-lg hover:scale-105"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                        </svg>
                                        Mostrar todas las series restantes ({seriesData.length - seriesItemsToShow})
                                    </a>
                                </div>
                            )}
                        </section>
                )}

                {/* Películas Vistas */}
                {(showMovies || showAll) && (
                    <section id="movies-section" class="mb-8 scroll-mt-24">
                            <h3 class="text-lg font-semibold text-gray-800 mb-4 flex justify-between items-center bg-red-50 rounded-lg px-4 py-3 border-l-4 border-red-500">
                                <span class="flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-600" fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                    </svg>
                                    Películas Vistas
                                </span>
                                <span class="text-sm text-red-600 bg-red-100 rounded-full px-3 py-1 font-bold">
                                    {peliculasPaginadas.length}
                                    {searchQuery || genreFilter ? ` de ${moviesData.length}` : ` de ${moviesData.length}`}
                                </span>
                            </h3>

                            {peliculasPaginadas.length === 0 ? (
                                    <div class="empty-state bg-gradient-to-br from-red-50 to-indigo-50 border-2 border-dashed border-red-200 rounded-xl p-8 text-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-red-400 mb-4"
                                            fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                                d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                                        </svg>
                                        <h3 class="text-xl font-semibold text-red-800 mb-2">
                                            {searchQuery || genreFilter ? 'No se encontraron películas' : '¡Comienza tu colección!'}
                                        </h3>
                                        <p class="text-red-600">
                                            {searchQuery || genreFilter ?
                                                'Intenta ajustar los filtros de búsqueda.' :
                                                'Explora nuestro catálogo y marca tus películas vistas.'
                                            }
                                        </p>
                                    </div>
                            ) : (
                                    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                                        {peliculasPaginadas.map((item) => (
                                                <CardMovie
                                                        id={item.id.toString()}
                                                        img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                        title={item.title}
                                                        vote_average={item.vote_average}
                                                        overview={item.overview}
                                                        release_date={item.release_date}
                                                        genres={item.genre_ids?.map((id: number) => ({
                                                            id,
                                                            name: getGenreName(id)
                                                        }))}
                                                />
                                        ))}
                                    </div>
                            )}
                            {hasMoreMovies && (
                                <div class="flex justify-center mt-8">
                                    <a 
                                        href={buildUrl(pageUrl, {
                                            filter: filter,
                                            search: searchQuery,
                                            genre: genreFilter,
                                            seriesPage: seriesPage.toString(),
                                            moviesPage: Math.ceil(moviesData.length / ITEMS_PER_PAGE).toString()
                                        }) + '#movies-section'}
                                        class="px-8 py-3 bg-gradient-to-r from-red-600 to-pink-600 text-white rounded-xl hover:from-red-700 hover:to-pink-700 transition-all font-semibold flex items-center gap-2 shadow-lg hover:scale-105"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                        </svg>
                                        Mostrar todas las películas restantes ({moviesData.length - moviesItemsToShow})
                                    </a>
                                </div>
                            )}
                        </section>
                )}
            </div>
        </div>
    </div>
</Layout>
