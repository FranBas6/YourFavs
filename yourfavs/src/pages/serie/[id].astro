---
import Layout from "../../layouts/Layout.astro";
import {
    getLanguageDisplayName, getContentRating,
    formatDate, getRatingStars, formatTrailerUrl, providerLinks
} from "../../utils/constants/helpers/media-helpers";
import {formatRuntime, getSeasonStats} from "../../utils/constants/helpers/serie-helpers";
import type { GuestStar } from "../../types/Media";
import {handleSerieFavAction, getWatchedProgress, toggleWatchedEpisode, markSeasonWatched, unmarkSeasonWatched, markAllWatched, unmarkAllWatched} from "../../services/BD/series/yourfavsSerie";
import type {WatchedProgress} from "../../services/BD/series/yourfavsSerie";
import '../../styles/pages/serie/serie.css';
import {
    getSeriesById, getSeriesCast, getSeriesDirectorsAndRoles,
    getSeriesTrailer, getSeriesStatus, getEpisodesBySeasonNumber,
    fetchAllSeriesPosters, getSerieRecommendationsOrSimilar, getSeriesAdditionalInfo,
    getSeriesVideos
} from "../../services/API/Series/InfoSeries";
import { posterUrl, originalUrl, tmdbFetch } from "../../services/API/shared/tmdbClient";
import {initializeApp} from "firebase/app";
import {getFirestore, doc, getDoc} from "firebase/firestore";
import {firebaseConfig} from '../../utils/firebaseConfig';
import { getNotificationSub, addNotificationSub, removeNotificationSub } from "../../services/BD/notifications/yourfavsNotifications";
import NotificationBell from "../../components/personal/NotificationBell.astro";

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

const {id} = Astro.params; // Obtén el parámetro id de la URL

if (!id) {
    throw new Error("ID de la serie no encontrado en la URL");
}

if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        const actionType = String(formData.get('actionType') || '');

        // Watched episodes
        if (actionType === 'watched_episode') {
            const season = Number(formData.get('season'));
            const episode = Number(formData.get('episode'));
            await toggleWatchedEpisode(id, season, episode);
            return Astro.redirect(`/serie/${id}`);
        }
        if (actionType === 'watched_all') {
            const allEpisodesStr = String(formData.get('allEpisodes'));
            const action = String(formData.get('action'));
            if (action === 'mark') {
                const episodes = allEpisodesStr.split(';').map(e => {
                    const [s, ep] = e.split('-').map(Number);
                    return { season: s, episode: ep };
                });
                await markAllWatched(id, episodes);
            } else {
                await unmarkAllWatched(id);
            }
            return Astro.redirect(`/serie/${id}`);
        }
        if (actionType === 'watched_season') {
            const season = Number(formData.get('season'));
            const episodeNumbers = String(formData.get('episodes')).split(',').map(Number);
            const action = String(formData.get('action'));
            if (action === 'mark') {
                await markSeasonWatched(id, season, episodeNumbers);
            } else {
                await unmarkSeasonWatched(id, season);
            }
            return Astro.redirect(`/serie/${id}`);
        }

        if (actionType === 'notification') {
            const action = String(formData.get('action'));
            const tmdbId = String(formData.get('tmdb_id'));
            if (action === 'add') {
                await addNotificationSub('tv', tmdbId);
            } else {
                await removeNotificationSub('tv', tmdbId);
            }
            return Astro.redirect(`/serie/${id}`);
        }

        const redirectUrl = await handleSerieFavAction(formData);
        return Astro.redirect(redirectUrl);
    } catch (error) {
        console.error('Error al gestionar la serie:', error);
        return Astro.redirect(`/serie/${id}`);
    }
}

// Todas las llamadas TMDB iniciales en paralelo
let [item, cast, directors, trailerUrl, status] = await Promise.all([
    getSeriesById({id}),
    getSeriesCast(id),
    getSeriesDirectorsAndRoles(id),
    getSeriesTrailer(id),
    getSeriesStatus(id),
]);
let title = item?.name || "Serie no encontrada";

// Cliente data actualizado con la estructura de Props
const clientData = {
    id: String(item?.id || ''),
    name: item?.name || 'Sin nombre',
    img: item?.poster_path || '', // Cambiado a img manteniendo compatibilidad con poster_path
    vote_average: item?.vote_average ? Number(item.vote_average) : 0,
    overview: item?.overview || 'Sin descripción',
    first_air_date: item?.first_air_date || '',
    status: status || '',
    genres: item?.genres || [],
    seasons: item?.seasons || [],
    last_episode_to_air: item?.last_episode_to_air || null,
    next_episode_to_air: item?.next_episode_to_air || null
};

// Obtener episodios de TODAS las temporadas en paralelo (antes era secuencial)
const allSeasonEpisodes: { [key: number]: any[] } = {};
if (item?.seasons) {
    const episodeResults = await Promise.all(
        item.seasons.map((season: any) => getEpisodesBySeasonNumber(id, season.season_number))
    );
    item.seasons.forEach((season: any, i: number) => {
        allSeasonEpisodes[season.season_number] = episodeResults[i] || [];
    });
}

// Separar temporadas regulares y especiales
const regularSeasons = item?.seasons?.filter(season => season.season_number > 0) || [];
const specialSeasons = item?.seasons?.filter(season => season.season_number === 0) || [];

const totalRegularEpisodes = regularSeasons.reduce((total, season) => total + (season.episode_count || 0), 0);
const totalSpecialEpisodes = specialSeasons.reduce((total, season) => total + (season.episode_count || 0), 0);
const totalEpisodes = totalRegularEpisodes + totalSpecialEpisodes; // Total completo para compatibilidad

// Verificar si la serie ya está en las diferentes bases de datos
const docRefFavs = doc(db, 'SeriesFavs', clientData.id);
const docRefPendientes = doc(db, 'SeriesPendiente', clientData.id);
const docRefVistas = doc(db, 'SeriesVistas', clientData.id);
const docRefSiguiendo = doc(db, 'SeriesSiguiendo', clientData.id);
const docRefLiked = doc(db, 'LikedSeries', clientData.id);
const docRefVerPronto = doc(db, 'SeriesVerPronto', clientData.id);

// Obtener los documentos en paralelo para mejor rendimiento
const [docSnapFavs, docSnapPendientes, docSnapVistas, docSnapSiguiendo, docSnapLiked, docSnapVerPronto, watchedProgress] = await Promise.all([
    getDoc(docRefFavs),
    getDoc(docRefPendientes),
    getDoc(docRefVistas),
    getDoc(docRefSiguiendo),
    getDoc(docRefLiked),
    getDoc(docRefVerPronto),
    getWatchedProgress(clientData.id),
]);

// Set de episodios vistos para lookup rápido
const watchedSet = new Set<string>();
if (watchedProgress?.watched_episodes) {
    for (const ep of watchedProgress.watched_episodes) {
        watchedSet.add(`${ep.season}-${ep.episode}`);
    }
}
const totalWatchedEpisodes = watchedSet.size;

// Todos los episodios regulares para "marcar todo"
const allRegularEpisodesFlat: { season: number; episode: number }[] = [];
if (item?.seasons) {
    for (const season of item.seasons) {
        if (season.season_number === 0) continue;
        const eps = allSeasonEpisodes[season.season_number] || [];
        for (const ep of eps) {
            allRegularEpisodesFlat.push({ season: season.season_number, episode: ep.episode_number });
        }
    }
}
const allEpisodesStr = allRegularEpisodesFlat.map(e => `${e.season}-${e.episode}`).join(';');
const isAllWatched = allRegularEpisodesFlat.length > 0 && totalWatchedEpisodes >= allRegularEpisodesFlat.length;

// Comprobar si existen los documentos
const existingInFavs = docSnapFavs.exists();
const existingInPendientes = docSnapPendientes.exists();
const existingInVistas = docSnapVistas.exists();
const existingInSiguiendo = docSnapSiguiendo.exists();
const existingInLiked = docSnapLiked.exists();
const existingInVerPronto = docSnapVerPronto.exists();

// Comprobar si la serie está en cada una de las colecciones
const isInFavorites = existingInFavs;
const isInPendientes = existingInPendientes;
const isInVistas = existingInVistas;
const isInSiguiendo = existingInSiguiendo;
const isInLiked = existingInLiked;

// Verificar suscripción de notificación
const notifSub = await getNotificationSub('tv', id);
const isNotifSubscribed = !!notifSub;
const isInVerPronto = existingInVerPronto;

// Resolver opinión actual si existe en cualquier colección
const opinionFromAny = (
    (existingInFavs && docSnapFavs.data()?.opinion) ||
    (existingInPendientes && docSnapPendientes.data()?.opinion) ||
    (existingInVistas && docSnapVistas.data()?.opinion) ||
    (existingInSiguiendo && docSnapSiguiendo.data()?.opinion) ||
    (existingInLiked && docSnapLiked.data()?.opinion) ||
    (existingInVerPronto && docSnapVerPronto.data()?.opinion) ||
    ''
) as string;

// Calcular años en emisión
const yearsActiveCalc = (() => {
    if (!item?.first_air_date) return "Desconocido";
    const startYear = new Date(item.first_air_date).getFullYear();
    let endYear: string = "presente";
    if (status === "Ended" || status === "Canceled") {
        const lastAirDate = item?.last_episode_to_air?.air_date;
        endYear = lastAirDate ? String(new Date(lastAirDate).getFullYear()) : "desconocido";
    }
    return `${startYear} - ${endYear}`;
})();

const providerElements = item?.providers?.map((provider) => {
    const link = providerLinks[provider.provider_name];
    const hasLogo = !!provider.logo_path;
    return {
        name: provider.provider_name,
        logo: hasLogo ? posterUrl(provider.logo_path, 'w200') : null,
        link,
        type: provider.type || 'flatrate'
    };
}) || [];

// Agrupar por tipo
const providersByType = providerElements.reduce((acc: Record<string, any[]>, p) => {
    const key = p.type || 'flatrate';
    if (!acc[key]) acc[key] = [];
    acc[key].push(p);
    return acc;
}, {} as Record<string, any[]>);

const statusMap = {
    "Returning Series": "Serie en emisión",
    Ended: "Finalizada",
    Canceled: "Cancelada",
    Pilot: "Piloto",
};

const yearsActive = yearsActiveCalc;

// Ordenar temporadas: primero las regulares, luego las especiales
const sortedSeasons = item?.seasons?.sort((a, b) => {
    // Las temporadas especiales (0) van al final
    if (a.season_number === 0 && b.season_number !== 0) return 1;
    if (b.season_number === 0 && a.season_number !== 0) return -1;
    // Para el resto, orden numérico normal
    return a.season_number - b.season_number;
}) || [];

// Variables útiles para usar en el template
const hasSpecialSeasons = specialSeasons.length > 0;
const regularSeasonsCount = regularSeasons.length;
const specialSeasonsCount = specialSeasons.length;

import type {PosterImage} from '../../services/API/Series/InfoSeries';

// Segundo bloque de datos — todo en paralelo
const tmdbId = item?.id;

const [
    allPosters,
    seriesRecommendationsData,
    externalIds,
    additionalInfo,
    allVideos,
    reviewsData,
] = await Promise.all([
    id ? fetchAllSeriesPosters(id).catch(() => []) : Promise.resolve([]),
    tmdbId ? getSerieRecommendationsOrSimilar(tmdbId) : Promise.resolve({ success: false, recommendations: [], type: 'recommendations' as const }),
    tmdbId ? tmdbFetch<any>(`/tv/${tmdbId}/external_ids`).catch(() => ({})) : Promise.resolve({}),
    id ? getSeriesAdditionalInfo(id) : Promise.resolve({ keywords: [], networks: [], content_ratings: [], episode_run_time: [], languages: [], tagline: null }),
    id ? getSeriesVideos(id) : Promise.resolve([]),
    tmdbId ? tmdbFetch<{ results: any[] }>(`/tv/${tmdbId}/reviews`).catch(() => ({ results: [] })) : Promise.resolve({ results: [] }),
]);

const posters: PosterImage[] = allPosters.slice(0, 40);
const seriesRecommendations = seriesRecommendationsData.success ? seriesRecommendationsData.recommendations : [];
const seriesRecommendationType = seriesRecommendationsData.type || 'recommendations';
const imdbId = externalIds.imdb_id;
const serieSocialLinks = {
    facebook: externalIds.facebook_id ? `https://facebook.com/${externalIds.facebook_id}` : null,
    instagram: externalIds.instagram_id ? `https://instagram.com/${externalIds.instagram_id}` : null,
    twitter: externalIds.twitter_id ? `https://twitter.com/${externalIds.twitter_id}` : null,
};
const hasSocialLinks = Object.values(serieSocialLinks).some(v => v);
const serieKeywords: { id: number; name: string }[] = additionalInfo.keywords || [];
const serieNetworks: { id: number; name: string; logo_path: string | null }[] = additionalInfo.networks || [];
const reviews = (reviewsData.results || []).filter((r: any) => r.content && r.content.length > 50).slice(0, 5);
const productionCountries: string[] = item?.origin_country || [];

// Categorizar videos
const trailers = allVideos.filter((v: any) => v.type === 'Trailer');
const clips = allVideos.filter((v: any) => v.type === 'Clip');
const behindScenes = allVideos.filter((v: any) => v.type === 'Behind the Scenes' || v.type === 'Bloopers' || v.type === 'Featurette');
const teasers = allVideos.filter((v: any) => v.type === 'Teaser');
---
<Layout title={`${title}`}>
    <article class="bg-gray-50">
        <!-- Hero inmersivo -->
        <div class="relative w-full min-h-[70vh] bg-cover bg-center bg-no-repeat" style={`background-image: url(${item?.backdrop_path ? originalUrl(item.backdrop_path) : '/assets/background.svg'})`}>
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/70 to-gray-900/40"></div>

            <div class="relative z-10 max-w-6xl mx-auto px-4 pt-8 pb-16 flex flex-col justify-end min-h-[70vh]">
                <nav class="absolute top-6 left-4 right-4" aria-label="Breadcrumb">
                    <ol class="flex items-center space-x-2 text-sm">
                        <li><a href="/" class="text-white/70 hover:text-white transition-colors">Inicio</a></li>
                        <li class="text-white/40">/</li>
                        <li><a href="/catalogo/topseries" class="text-white/70 hover:text-white transition-colors">Series</a></li>
                        <li class="text-white/40">/</li>
                        <li class="text-white/90 font-medium truncate max-w-xs">{item?.name}</li>
                    </ol>
                </nav>

                <div class="flex flex-col md:flex-row items-end gap-8">
                    <div class="hidden md:block flex-shrink-0 w-56 rounded-xl overflow-hidden shadow-2xl ring-1 ring-white/10">
                        <img src={posterUrl(item?.poster_path)} alt={item?.name} class="w-full aspect-[2/3] object-cover" />
                    </div>
                    <div class="flex-1 text-white">
                        <h1 class="text-4xl md:text-5xl font-bold mb-3 leading-tight">{item?.name}</h1>
                        {additionalInfo.tagline && (
                            <p class="text-white/60 italic text-lg mb-4">"{additionalInfo.tagline}"</p>
                        )}
                        <div class="flex flex-wrap items-center gap-3 mb-4">
                            <span class="text-yellow-400 text-lg font-bold">{item?.vote_average?.toFixed(1)} {getRatingStars(item?.vote_average)}</span>
                            <span class={`px-2.5 py-0.5 rounded-full text-xs font-medium ${status === 'Returning Series' ? 'bg-green-500/80' : status === 'Ended' ? 'bg-gray-500/80' : status === 'Canceled' ? 'bg-red-500/80' : 'bg-blue-500/80'}`}>
                                {status ? ((statusMap as any)[status] || status) : ''}
                            </span>
                            <span class="text-white/70">{yearsActive}</span>
                            <span class="text-white/70">{regularSeasonsCount} temporadas</span>
                            <span class="text-white/70">{totalRegularEpisodes} episodios</span>
                            {item?.availableInSpain && (
                                <span title="Disponible en España"><svg viewBox="0 0 750 500" class="w-8 h-5 rounded"><rect width="750" height="500" fill="#AA151B"/><rect width="750" height="250" y="125" fill="#F1BF00"/></svg></span>
                            )}
                        </div>
                        {item?.genres && (
                            <div class="flex flex-wrap gap-2 mb-5">
                                {item.genres.map((genre) => (
                                    <span class="px-3 py-1 bg-white/10 backdrop-blur-sm text-white text-xs rounded-full border border-white/20">{genre.name}</span>
                                ))}
                            </div>
                        )}
                        {item?.overview && (
                            <details class="max-w-2xl group">
                                <summary class="cursor-pointer">
                                    <p class="text-white/80 text-sm md:text-base leading-relaxed line-clamp-3 group-open:line-clamp-none">{item.overview}</p>
                                    <span class="inline-block mt-1 text-xs text-white/50 group-open:hidden">Pulsa para leer más</span>
                                </summary>
                            </details>
                        )}
                    </div>
                </div>
            </div>
        </div>

        <!-- Action bar -->
        <div class="bg-white border-b border-gray-200 shadow-sm">
            <!-- Desktop -->
            <div class="hidden md:flex max-w-6xl mx-auto px-4 py-2 items-center gap-2">
                <form method="POST">
                    <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInFavorites ? 'remove' : 'add'}/><input type="hidden" name="actionType" value="favs"/>
                    <button type="submit" class={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap ${isInFavorites ? 'bg-red-500 text-white' : 'border border-red-200 text-red-600 hover:bg-red-50'}`}>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
                        {isInFavorites ? 'En Favoritos' : 'Favoritos'}
                    </button>
                </form>
                <form method="POST">
                    <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInSiguiendo ? 'remove' : 'add'}/><input type="hidden" name="actionType" value="siguiendo"/>
                    <button type="submit" class={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap ${isInSiguiendo ? 'bg-blue-500 text-white' : 'border border-blue-200 text-blue-600 hover:bg-blue-50'}`}>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        {isInSiguiendo ? 'Siguiendo' : 'Seguir'}
                    </button>
                </form>
                <form method="POST">
                    <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInVerPronto ? 'remove' : 'add'}/><input type="hidden" name="actionType" value="verPronto"/>
                    <button type="submit" class={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap ${isInVerPronto ? 'bg-purple-500 text-white' : 'border border-purple-200 text-purple-600 hover:bg-purple-50'}`}>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="10"/></svg>
                        {isInVerPronto ? 'Ver Pronto' : 'Ver Pronto'}
                    </button>
                </form>
                <form method="POST">
                    <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInPendientes ? 'remove' : 'add'}/><input type="hidden" name="actionType" value="pendientes"/>
                    <button type="submit" class={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap ${isInPendientes ? 'bg-amber-500 text-white' : 'border border-amber-200 text-amber-600 hover:bg-amber-50'}`}>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
                        {isInPendientes ? 'Pendiente' : 'Pendiente'}
                    </button>
                </form>
                <form method="POST">
                    <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInVistas ? 'remove' : 'add'}/><input type="hidden" name="actionType" value="vistas"/>
                    <button type="submit" class={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap ${isInVistas ? 'bg-green-500 text-white' : 'border border-green-200 text-green-600 hover:bg-green-50'}`}>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                        {isInVistas ? 'Vista' : 'Vista'}
                    </button>
                </form>
                <div class="ml-auto flex items-center gap-2">
                    <NotificationBell mediaType="tv" tmdbId={id} isSubscribed={isNotifSubscribed} />
                    <form method="POST">
                        <input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInLiked ? 'remove' : 'add'}/><input type="hidden" name="actionType" value="liked"/>
                        <button type="submit" class={`p-1.5 rounded-full transition-colors ${isInLiked ? 'text-red-500' : 'text-gray-4000 hover:text-red-400'}`}>
                            <svg class="w-5 h-5" viewBox="0 0 20 20" fill={isInLiked ? "currentColor" : "none"} stroke="currentColor" stroke-width={isInLiked ? "0" : "1.5"}><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
                        </button>
                    </form>
                    {imdbId && (
                        <a href={`https://www.imdb.com/title/${imdbId}`} target="_blank" rel="noopener" class="px-2.5 py-1 text-xs font-bold bg-yellow-400 text-gray-900 rounded hover:bg-yellow-300 transition-colors">IMDb</a>
                    )}
                    {(item?.homepage || trailerUrl) && (
                        <a href={item?.homepage || trailerUrl} target="_blank" rel="noopener" class="px-3 py-1.5 text-xs font-medium bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors">Ver ahora</a>
                    )}
                </div>
            </div>
            <!-- Mobile -->
            <div class="md:hidden max-w-6xl mx-auto px-4 py-3 space-y-2">
                <div class="grid grid-cols-2 gap-2">
                    <form method="POST"><input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInFavorites ? 'remove' : 'add'}/><input type="hidden" name="actionType" value="favs"/>
                        <button type="submit" class={`w-full px-3 py-2.5 text-xs font-medium rounded-lg transition-colors flex items-center justify-center gap-1.5 ${isInFavorites ? 'bg-red-500 text-white' : 'border border-red-200 text-red-600'}`}>
                            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
                            {isInFavorites ? 'Favoritos' : 'Favoritos'}
                        </button>
                    </form>
                    <form method="POST"><input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInSiguiendo ? 'remove' : 'add'}/><input type="hidden" name="actionType" value="siguiendo"/>
                        <button type="submit" class={`w-full px-3 py-2.5 text-xs font-medium rounded-lg transition-colors flex items-center justify-center gap-1.5 ${isInSiguiendo ? 'bg-blue-500 text-white' : 'border border-blue-200 text-blue-600'}`}>
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            {isInSiguiendo ? 'Siguiendo' : 'Seguir'}
                        </button>
                    </form>
                    <form method="POST"><input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInPendientes ? 'remove' : 'add'}/><input type="hidden" name="actionType" value="pendientes"/>
                        <button type="submit" class={`w-full px-3 py-2.5 text-xs font-medium rounded-lg transition-colors flex items-center justify-center gap-1.5 ${isInPendientes ? 'bg-amber-500 text-white' : 'border border-amber-200 text-amber-600'}`}>
                            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
                            {isInPendientes ? 'Pendiente' : 'Pendiente'}
                        </button>
                    </form>
                    <form method="POST"><input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInVistas ? 'remove' : 'add'}/><input type="hidden" name="actionType" value="vistas"/>
                        <button type="submit" class={`w-full px-3 py-2.5 text-xs font-medium rounded-lg transition-colors flex items-center justify-center gap-1.5 ${isInVistas ? 'bg-green-500 text-white' : 'border border-green-200 text-green-600'}`}>
                            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                            {isInVistas ? 'Vista' : 'Vista'}
                        </button>
                    </form>
                </div>
                <div class="flex gap-2">
                    <NotificationBell mediaType="tv" tmdbId={id} isSubscribed={isNotifSubscribed} />
                    <form method="POST" class="flex-1"><input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInLiked ? 'remove' : 'add'}/><input type="hidden" name="actionType" value="liked"/>
                        <button type="submit" class={`w-full px-3 py-2 text-xs font-medium rounded-lg transition-colors flex items-center justify-center gap-1.5 ${isInLiked ? 'bg-red-50 text-red-500 border border-red-200' : 'border border-gray-200 text-gray-500'}`}>
                            <svg class="w-4 h-4" viewBox="0 0 20 20" fill={isInLiked ? "currentColor" : "none"} stroke="currentColor" stroke-width={isInLiked ? "0" : "1.5"}><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
                            {isInLiked ? 'Me gusta' : 'Me gusta'}
                        </button>
                    </form>
                    <form method="POST"><input type="hidden" name="id" value={item?.id}/><input type="hidden" name="action" value={isInVerPronto ? 'remove' : 'add'}/><input type="hidden" name="actionType" value="verPronto"/>
                        <button type="submit" class={`px-4 py-2 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 ${isInVerPronto ? 'bg-purple-500 text-white' : 'border border-purple-200 text-purple-600'}`}>Ver Pronto</button>
                    </form>
                    {imdbId && (
                        <a href={`https://www.imdb.com/title/${imdbId}`} target="_blank" rel="noopener" class="px-4 py-2 text-xs font-bold bg-yellow-400 text-gray-900 rounded-lg hover:bg-yellow-300 transition-colors flex items-center">IMDb</a>
                    )}
                </div>
            </div>
        </div>

        <!-- Layout 2 columnas -->
        <div class="max-w-6xl mx-auto px-4 py-8">
            <div class="flex flex-col md:flex-row gap-8">

                <!-- Sidebar izquierda -->
                <div class="md:w-1/3 space-y-4">
                    <div class="md:hidden w-56 mx-auto rounded-xl overflow-hidden shadow-xl">
                        <img src={posterUrl(item?.poster_path)} alt={item?.name} class="w-full aspect-[2/3] object-cover" />
                    </div>

                    <!-- Info -->
                    <div class="bg-white rounded-xl border border-gray-200 p-4">
                        <h3 class="text-base font-semibold text-gray-800 mb-3">Información</h3>
                        <ul class="space-y-2.5 text-sm sm:text-base">
                            <li class="flex justify-between"><span class="text-gray-500">Estado</span><span class={`font-medium ${status === 'Returning Series' ? 'text-green-600' : status === 'Canceled' ? 'text-red-600' : 'text-gray-800'}`}>{status ? ((statusMap as any)[status] || status) : ''}</span></li>
                            <li class="flex justify-between"><span class="text-gray-500">Emisión</span><span class="text-gray-800 font-medium">{yearsActive}</span></li>
                            <li class="flex justify-between"><span class="text-gray-500">Temporadas</span><span class="text-gray-800 font-medium">{regularSeasonsCount}{hasSpecialSeasons ? ` + ${specialSeasonsCount} especiales` : ''}</span></li>
                            <li class="flex justify-between"><span class="text-gray-500">Episodios</span><span class="text-gray-800 font-medium">{totalRegularEpisodes}</span></li>
                            <li class="flex justify-between"><span class="text-gray-500">Valoración</span><span class="text-gray-800 font-medium">{item?.vote_average?.toFixed(1)} <span class="text-gray-4000 text-xs">({item?.vote_count})</span></span></li>
                            <li class="flex justify-between"><span class="text-gray-500">Popularidad</span><span class="text-gray-800 font-medium">{item?.popularity?.toFixed(0)}</span></li>
                            <li class="flex justify-between"><span class="text-gray-500">Idioma</span><span class="text-gray-800 font-medium">{getLanguageDisplayName(item?.original_language)}</span></li>
                            {item?.original_name && item.original_name !== item.name && (
                                <li class="flex flex-col"><span class="text-gray-500">Título original</span><span class="text-gray-800 font-medium">{item.original_name}</span></li>
                            )}
                            {productionCountries.length > 0 && (
                                <li class="flex justify-between gap-2"><span class="text-gray-500 flex-shrink-0">País</span><span class="text-gray-800 font-medium text-right">{productionCountries.join(', ')}</span></li>
                            )}
                        </ul>
                    </div>

                    <!-- Clasificación -->
                    {additionalInfo.content_ratings && additionalInfo.content_ratings.length > 0 && (() => {
                        const rating = getContentRating(additionalInfo.content_ratings);
                        return rating ? (
                            <div class="bg-white rounded-xl border border-gray-200 p-4">
                                <h3 class="text-base font-semibold text-gray-800 mb-2">Clasificación</h3>
                                <p class="text-sm font-medium text-gray-700">{rating.text}</p>
                            </div>
                        ) : null;
                    })()}

                    <!-- Dónde ver -->
                    {providerElements.length > 0 && (
                        <div class="bg-white rounded-xl border border-gray-200 p-4">
                            <h3 class="text-base font-semibold text-gray-800 mb-3">Dónde ver</h3>
                            <div class="space-y-3">
                                {providersByType.flatrate && (
                                    <div>
                                        <p class="text-[10px] font-medium text-gray-4000 uppercase tracking-wide mb-1.5">Suscripción</p>
                                        <div class="space-y-1.5">
                                            {providersByType.flatrate.map((p) => (
                                                <a href={p.link || '#'} target="_blank" rel="noopener" class="flex items-center gap-2 py-1 hover:bg-gray-50 rounded transition-colors">
                                                    {p.logo && <img src={p.logo} alt={p.name} class="w-7 h-7 rounded" />}
                                                    <span class="text-sm sm:text-base text-gray-700">{p.name}</span>
                                                </a>
                                            ))}
                                        </div>
                                    </div>
                                )}
                                {providersByType.rent && (
                                    <div>
                                        <p class="text-[10px] font-medium text-gray-4000 uppercase tracking-wide mb-1.5">Alquiler</p>
                                        <div class="space-y-1.5">
                                            {providersByType.rent.map((p) => (
                                                <a href={p.link || '#'} target="_blank" rel="noopener" class="flex items-center gap-2 py-1 hover:bg-gray-50 rounded transition-colors">
                                                    {p.logo && <img src={p.logo} alt={p.name} class="w-7 h-7 rounded" />}
                                                    <span class="text-sm sm:text-base text-gray-700">{p.name}</span>
                                                </a>
                                            ))}
                                        </div>
                                    </div>
                                )}
                            </div>
                        </div>
                    )}

                    <!-- Opinión -->
                    {(isInFavorites || isInPendientes || isInVistas || isInSiguiendo || isInLiked || isInVerPronto) && (
                        <div class="bg-white rounded-xl border border-gray-200 p-4">
                            <h3 class="text-base font-semibold text-gray-800 mb-3">Tu opinión</h3>
                            {opinionFromAny ? (
                                <div class="space-y-3">
                                    <blockquote class="p-3 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-700 whitespace-pre-wrap">{opinionFromAny}</blockquote>
                                    <div class="flex items-center gap-2 justify-end">
                                        <details>
                                            <summary class="px-3 py-1.5 text-xs rounded-lg bg-gray-900 hover:bg-gray-800 text-white cursor-pointer">Actualizar</summary>
                                            <form method="POST" class="mt-3 space-y-2">
                                                <input type="hidden" name="id" value={item?.id} />
                                                <input type="hidden" name="action" value="save_opinion" />
                                                <input type="hidden" name="actionType" value="opinion" />
                                                <textarea name="opinion" rows="3" class="w-full p-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-gray-400">{opinionFromAny}</textarea>
                                                <button type="submit" class="w-full px-3 py-1.5 bg-gray-900 text-white text-xs rounded-lg hover:bg-gray-800">Guardar</button>
                                            </form>
                                        </details>
                                        <form method="POST">
                                            <input type="hidden" name="id" value={item?.id} />
                                            <input type="hidden" name="action" value="delete_opinion" />
                                            <input type="hidden" name="actionType" value="opinion" />
                                            <button type="submit" class="px-3 py-1.5 text-xs rounded-lg bg-red-50 text-red-600 border border-red-200 hover:bg-red-100">Eliminar</button>
                                        </form>
                                    </div>
                                </div>
                            ) : (
                                <form method="POST" class="space-y-2">
                                    <input type="hidden" name="id" value={item?.id} />
                                    <input type="hidden" name="action" value="save_opinion" />
                                    <input type="hidden" name="actionType" value="opinion" />
                                    <textarea name="opinion" rows="3" class="w-full p-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-gray-400" placeholder="Escribe tu opinión..."></textarea>
                                    <button type="submit" class="w-full px-3 py-1.5 bg-gray-900 text-white text-xs rounded-lg hover:bg-gray-800">Guardar opinión</button>
                                </form>
                            )}
                        </div>
                    )}

                    <!-- Keywords: desplegable en mobile, visible en desktop -->
                    {serieKeywords.length > 0 && (
                        <>
                            <details class="bg-white rounded-xl border border-gray-200 sm:hidden">
                                <summary class="p-4 cursor-pointer flex items-center justify-between">
                                    <h3 class="text-base font-semibold text-gray-800">Tags ({serieKeywords.length})</h3>
                                    <svg class="w-4 h-4 text-gray-4000" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                                </summary>
                                <div class="px-4 pb-4 flex flex-wrap gap-1.5">
                                    {serieKeywords.map((kw) => (
                                        <span class="px-2 py-0.5 text-xs bg-gray-100 text-gray-500 rounded-full">{kw.name}</span>
                                    ))}
                                </div>
                            </details>
                            <div class="hidden sm:block bg-white rounded-xl border border-gray-200 p-4">
                                <h3 class="text-base font-semibold text-gray-800 mb-2">Tags</h3>
                                <div class="flex flex-wrap gap-1.5">
                                    {serieKeywords.map((kw) => (
                                        <span class="px-2 py-0.5 text-xs bg-gray-100 text-gray-500 rounded-full">{kw.name}</span>
                                    ))}
                                </div>
                            </div>
                        </>
                    )}

                    <!-- Social -->
                    {(hasSocialLinks || imdbId) && (
                        <div class="flex flex-wrap gap-2">
                            {imdbId && <a href={`https://www.imdb.com/title/${imdbId}`} target="_blank" rel="noopener" class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-yellow-50 text-yellow-800 rounded-lg hover:bg-yellow-100">IMDb</a>}
                            {serieSocialLinks.facebook && <a href={serieSocialLinks.facebook} target="_blank" rel="noopener" class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100">Facebook</a>}
                            {serieSocialLinks.instagram && <a href={serieSocialLinks.instagram} target="_blank" rel="noopener" class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-pink-50 text-pink-700 rounded-lg hover:bg-pink-100">Instagram</a>}
                            {serieSocialLinks.twitter && <a href={serieSocialLinks.twitter} target="_blank" rel="noopener" class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-sky-50 text-sky-700 rounded-lg hover:bg-sky-100">Twitter</a>}
                        </div>
                    )}

                    <!-- Redes de transmisión -->
                    {serieNetworks.length > 0 && (
                        <div class="bg-white rounded-xl border border-gray-200 p-4">
                            <h3 class="text-base font-semibold text-gray-800 mb-3">Cadenas</h3>
                            <div class="space-y-2">
                                {serieNetworks.map((network) => (
                                    <div class="flex items-center gap-3">
                                        {network.logo_path && <img src={posterUrl(network.logo_path, 'w92')} alt={network.name} class="w-10 h-6 object-contain" loading="lazy" />}
                                        <span class="text-sm text-gray-700">{network.name}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}
                </div>

                <!-- Columna derecha -->
                <div class="md:w-2/3 space-y-8">

                    <!-- Trailer -->
                    {trailerUrl && (
                        <section>
                            <h2 class="text-xl font-semibold text-gray-800 mb-4">Trailer</h2>
                            <div class="aspect-video rounded-xl overflow-hidden shadow-lg">
                                <iframe src={formatTrailerUrl(trailerUrl)} class="w-full h-full" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                            </div>
                        </section>
                    )}

                    <!-- Videos extras -->
                    {(clips.length > 0 || behindScenes.length > 0 || teasers.length > 0) && (
                        <details class="bg-white rounded-xl border border-gray-200">
                            <summary class="p-5 cursor-pointer text-lg font-semibold text-gray-800 flex items-center justify-between">
                                <span>Videos extras ({clips.length + behindScenes.length + teasers.length})</span>
                                <svg class="w-5 h-5 text-gray-4000" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                            </summary>
                            <div class="px-5 pb-5 grid grid-cols-1 md:grid-cols-2 gap-4">
                                {[...clips.slice(0, 4), ...behindScenes.slice(0, 4), ...teasers.slice(0, 4)].map((video) => (
                                    <div>
                                        <p class="text-xs text-gray-500 mb-1 truncate">{video.name}</p>
                                        <div class="aspect-video rounded-lg overflow-hidden">
                                            <iframe src={formatTrailerUrl(video.key)} class="w-full h-full" allowfullscreen></iframe>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </details>
                    )}

                    <!-- Próximo Episodio -->
                    {item?.next_episode_to_air && (
                        <section class="bg-white rounded-xl border-2 border-green-200 p-5">
                            <h2 class="text-lg font-semibold text-green-700 mb-3 flex items-center gap-2">
                                <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
                                Próximo Episodio
                            </h2>
                            <h3 class="text-base font-medium text-gray-800 mb-2">{item.next_episode_to_air.name}</h3>
                            <div class="flex flex-wrap gap-3 text-sm text-gray-600 mb-2">
                                <span>T{item.next_episode_to_air.season_number} E{item.next_episode_to_air.episode_number}</span>
                                <span>{formatDate(item.next_episode_to_air.air_date)}</span>
                            </div>
                            {item.next_episode_to_air.overview && (
                                <details class="text-sm text-gray-600 group">
                                    <summary class="cursor-pointer">
                                        <p class="leading-relaxed line-clamp-3 sm:line-clamp-none group-open:line-clamp-none inline">{item.next_episode_to_air.overview}</p>
                                    </summary>
                                </details>
                            )}
                        </section>
                    )}

                    <!-- Último Episodio -->
                    {item?.last_episode_to_air && (
                        <section class="bg-white rounded-xl border border-gray-200 p-5">
                            <div class="flex items-start gap-4">
                                {item.last_episode_to_air.still_path && (
                                    <img src={posterUrl(item.last_episode_to_air.still_path, 'w300')} alt={item.last_episode_to_air.name} class="w-32 h-20 object-cover rounded-lg flex-shrink-0 hidden sm:block" loading="lazy" />
                                )}
                                <div>
                                    <h2 class="text-lg font-semibold text-gray-800 mb-1">Último Episodio</h2>
                                    <h3 class="text-base font-medium text-gray-700 mb-2">{item.last_episode_to_air.name}</h3>
                                    <div class="flex flex-wrap gap-3 text-sm text-gray-500 mb-2">
                                        <span>T{item.last_episode_to_air.season_number} E{item.last_episode_to_air.episode_number}</span>
                                        <span>{formatDate(item.last_episode_to_air.air_date)}</span>
                                        {item.last_episode_to_air.vote_average > 0 && <span class="text-yellow-600">{item.last_episode_to_air.vote_average.toFixed(1)}</span>}
                                    </div>
                                    {item.last_episode_to_air.overview && (
                                        <details class="text-sm text-gray-600 group">
                                            <summary class="cursor-pointer">
                                                <p class="leading-relaxed line-clamp-2 sm:line-clamp-none group-open:line-clamp-none inline">{item.last_episode_to_air.overview}</p>
                                            </summary>
                                        </details>
                                    )}
                                </div>
                            </div>
                        </section>
                    )}


                    <!-- Temporadas con acordeón -->
                    <div class="bg-white rounded-xl border border-gray-200 p-5">
                        <div class="flex items-center justify-between gap-3 mb-2">
                            <h2 class="text-xl font-semibold text-gray-800">Temporadas y Episodios</h2>
                            {allRegularEpisodesFlat.length > 0 && (
                                <form method="POST" class="flex-shrink-0">
                                    <input type="hidden" name="actionType" value="watched_all" />
                                    <input type="hidden" name="allEpisodes" value={allEpisodesStr} />
                                    <input type="hidden" name="action" value={isAllWatched ? 'unmark' : 'mark'} />
                                    <button type="submit" class={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors ${isAllWatched ? 'bg-green-500 text-white hover:bg-green-600' : 'border border-gray-300 text-gray-500 hover:border-green-400 hover:text-green-600'}`}>
                                        {isAllWatched ? 'Desmarcar todo' : 'Marcar todo'}
                                    </button>
                                </form>
                            )}
                        </div>
                        <div class="flex flex-wrap items-center gap-2 mb-4">
                            <span class="text-sm text-gray-500">{regularSeasonsCount} temporadas • {totalRegularEpisodes} episodios{hasSpecialSeasons ? ` • ${specialSeasonsCount} especiales` : ''}</span>
                            {totalWatchedEpisodes > 0 && (
                                <span class="text-sm font-medium text-green-600">• {totalWatchedEpisodes}/{totalRegularEpisodes} vistos ({Math.round(totalWatchedEpisodes / totalRegularEpisodes * 100)}%)</span>
                            )}
                        </div>
                        {/* Barra de progreso global */}
                        {totalWatchedEpisodes > 0 && (
                            <div class="w-full bg-gray-200 rounded-full h-2 mb-6">
                                <div class="bg-green-500 h-2 rounded-full transition-all" style={`width: ${Math.min(100, Math.round(totalWatchedEpisodes / totalRegularEpisodes * 100))}%`}></div>
                            </div>
                        )}
                        <div class="space-y-4">
                            {sortedSeasons.map((season) => {
                                const seasonEpisodes = allSeasonEpisodes[season.season_number] || [];
                                const stats = getSeasonStats(seasonEpisodes);
                                const seasonWatched = seasonEpisodes.filter((ep) => watchedSet.has(`${season.season_number}-${ep.episode_number}`)).length;
                                const seasonTotal = seasonEpisodes.length;
                                const isSeasonComplete = seasonTotal > 0 && seasonWatched === seasonTotal;
                                return (
                                    <details class={`border rounded-xl overflow-hidden transition-all hover:shadow-md ${season.season_number === 0 ? 'border-purple-200 bg-purple-50/50' : 'border-blue-200 bg-blue-50/50'}`}>
                                        <summary class={`cursor-pointer p-5 ${season.season_number === 0 ? 'hover:bg-purple-100/50' : 'hover:bg-blue-100/50'}`}>
                                            <div class="flex flex-col lg:flex-row gap-5 items-start">
                                                <div class="w-full max-w-[220px] mx-auto lg:mx-0 lg:w-1/4 flex-shrink-0">
                                                    <img
                                                        src={posterUrl(season.poster_path || item?.poster_path, 'w400')}
                                                        alt={season.season_number === 0 ? "Episodios Especiales" : `Temporada ${season.season_number}`}
                                                        loading="lazy"
                                                        class="w-full rounded-lg shadow-lg"
                                                    />
                                                </div>
                                                <div class="lg:w-3/4 w-full">
                                                    <div class="flex items-center justify-between mb-3">
                                                        <h3 class={`text-xl font-bold ${season.season_number === 0 ? 'text-purple-800' : 'text-blue-800'}`}>
                                                            {season.season_number === 0 ? 'Episodios Especiales' : `Temporada ${season.season_number}`}
                                                        </h3>
                                                        <svg class={`w-5 h-5 ${season.season_number === 0 ? 'text-purple-500' : 'text-blue-500'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                                                    </div>
                                                    <div class="grid grid-cols-3 gap-3 mb-3">
                                                        <div class={`text-center p-2.5 rounded-lg ${season.season_number === 0 ? 'bg-purple-100' : 'bg-blue-100'}`}>
                                                            <div class={`text-xl font-bold ${season.season_number === 0 ? 'text-purple-800' : 'text-blue-800'}`}>{stats.totalEpisodes}</div>
                                                            <div class="text-xs text-gray-600">Episodios</div>
                                                        </div>
                                                        <div class={`text-center p-2.5 rounded-lg ${season.season_number === 0 ? 'bg-purple-100' : 'bg-blue-100'}`}>
                                                            <div class={`text-xl font-bold ${season.season_number === 0 ? 'text-purple-800' : 'text-blue-800'}`}>{stats.averageRating !== "0.0" ? `${stats.averageRating}` : "N/A"}</div>
                                                            <div class="text-xs text-gray-600">Rating</div>
                                                        </div>
                                                        <div class={`text-center p-2.5 rounded-lg ${season.season_number === 0 ? 'bg-purple-100' : 'bg-blue-100'}`}>
                                                            <div class={`text-base font-bold ${season.season_number === 0 ? 'text-purple-800' : 'text-blue-800'}`}>{stats.averageRuntime !== "No disponible" ? stats.averageRuntime : "N/A"}</div>
                                                            <div class="text-xs text-gray-600">Duración</div>
                                                        </div>
                                                    </div>
                                                    <!-- Stats extra -->
                                                    <div class="flex flex-wrap gap-2 mb-3 text-xs">
                                                        {stats.totalWatchtime && (
                                                            <span class={`px-2 py-0.5 rounded-full ${season.season_number === 0 ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700'}`}>
                                                                Total: {stats.totalWatchtime}
                                                            </span>
                                                        )}
                                                        {stats.bestEpisode && (
                                                            <span class={`px-2 py-0.5 rounded-full ${season.season_number === 0 ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700'}`}>
                                                                Mejor: E{stats.bestEpisode.episode_number} ({stats.bestEpisode.vote_average.toFixed(1)})
                                                            </span>
                                                        )}
                                                        {stats.dateRange && (
                                                            <span class={`px-2 py-0.5 rounded-full ${season.season_number === 0 ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700'}`}>
                                                                {stats.dateRange}
                                                            </span>
                                                        )}
                                                    </div>

                                                    {/* Progreso de temporada */}
                                                    {seasonTotal > 0 && (
                                                        <div class="flex items-center gap-3 mb-3" data-season-progress={season.season_number} data-season-total={seasonTotal}>
                                                            <div class="flex-1 bg-gray-200 rounded-full h-1.5">
                                                                <div class={`h-1.5 rounded-full transition-all duration-300 ${season.season_number === 0 ? 'bg-purple-500' : 'bg-green-500'}`} data-season-bar={season.season_number} style={`width: ${Math.round(seasonWatched / seasonTotal * 100)}%`}></div>
                                                            </div>
                                                            <span class="text-xs text-gray-500 flex-shrink-0" data-season-count={season.season_number}>{seasonWatched}/{seasonTotal}</span>
                                                        </div>
                                                    )}

                                                    <p class="text-sm text-gray-600 leading-relaxed season-overview">{season.overview || (season.season_number === 0 ? "Episodios especiales y contenido adicional." : "No hay descripción disponible.")}</p>
                                                </div>
                                            </div>
                                        </summary>
                                        <div class="bg-white p-4 space-y-2">
                                            {/* Botón marcar/desmarcar temporada */}
                                            {seasonTotal > 0 && (
                                                <form method="POST" class="mb-3">
                                                    <input type="hidden" name="actionType" value="watched_season" />
                                                    <input type="hidden" name="season" value={season.season_number} />
                                                    <input type="hidden" name="episodes" value={seasonEpisodes.map((ep) => ep.episode_number).join(',')} />
                                                    <input type="hidden" name="action" value={isSeasonComplete ? 'unmark' : 'mark'} />
                                                    <button type="submit" class={`w-full py-2 text-xs font-medium rounded-lg transition-colors ${isSeasonComplete ? 'bg-green-50 text-green-700 border border-green-200 hover:bg-green-100' : 'bg-gray-50 text-gray-600 border border-gray-200 hover:bg-gray-100'}`}>
                                                        {isSeasonComplete ? 'Desmarcar temporada completa' : `Marcar toda la temporada como vista (${seasonTotal} episodios)`}
                                                    </button>
                                                </form>
                                            )}
                                            {seasonEpisodes.map((episode) => {
                                                const isWatched = watchedSet.has(`${season.season_number}-${episode.episode_number}`);
                                                return (
                                                <div>
                                                    <details class={`border-b pb-2 last:border-0 group ${season.season_number === 0 ? 'border-purple-100' : 'border-gray-100'}`}>
                                                        <summary class={`cursor-pointer py-2 px-2 sm:px-3 rounded-lg flex items-center gap-2 sm:gap-3 ${season.season_number === 0 ? 'hover:bg-purple-50' : 'hover:bg-blue-50'} ${isWatched ? 'opacity-60' : ''}`}>
                                                            <span class={`font-bold px-1.5 py-0.5 rounded text-xs flex-shrink-0 ${season.season_number === 0 ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800'}`}>
                                                                {season.season_number === 0 ? `E${episode.episode_number}` : episode.episode_number}
                                                            </span>
                                                            <div class="flex-1 min-w-0">
                                                                <p class="font-medium text-gray-800 text-sm truncate group-open:whitespace-normal group-open:overflow-visible">{episode.name}</p>
                                                                <p class="text-xs text-gray-500 mt-0.5 truncate">
                                                                    {formatDate(episode.air_date)}{episode.runtime ? `  ·  ${formatRuntime(episode.runtime)}` : ''}
                                                                    {episode.vote_average > 0 && <span class="text-yellow-600">  ·  {episode.vote_average.toFixed(1)}</span>}
                                                                </p>
                                                            </div>
                                                            <form method="POST" data-season={season.season_number} class="flex-shrink-0" onclick="event.stopPropagation()">
                                                                <input type="hidden" name="actionType" value="watched_episode" />
                                                                <input type="hidden" name="season" value={season.season_number} />
                                                                <input type="hidden" name="episode" value={episode.episode_number} />
                                                                <button type="submit" class={`flex items-center gap-1 px-2 py-1 text-[11px] font-medium rounded-md transition-all duration-200 whitespace-nowrap ${isWatched ? 'bg-green-500 text-white hover:bg-green-600' : 'border border-gray-300 text-gray-4000 hover:border-green-400 hover:text-green-600'}`}>
                                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                                                    </svg>
                                                                    <span class="hidden sm:inline">{isWatched ? 'Visto' : 'Visto'}</span>
                                                                </button>
                                                            </form>
                                                        </summary>
                                                        <div class={`mt-2 mx-3 p-4 rounded-lg ${season.season_number === 0 ? 'bg-purple-50' : 'bg-blue-50'}`}>
                                                            {/* Imagen */}
                                                            {episode.still_path && (
                                                                <div class="flex justify-center mb-3">
                                                                    <img src={posterUrl(episode.still_path, 'w500')} alt={episode.name} loading="lazy" class="rounded-lg shadow-md w-full max-w-md" />
                                                                </div>
                                                            )}

                                                            {/* Sinopsis */}
                                                            <p class="text-sm text-gray-700 leading-relaxed mb-3">{episode.overview || "No hay descripción disponible."}</p>

                                                            {/* Estrellas invitadas */}
                                                            {episode.guest_stars && episode.guest_stars.length > 0 && (
                                                                <div>
                                                                    <p class={`text-sm font-semibold mb-2 ${season.season_number === 0 ? 'text-purple-700' : 'text-blue-700'}`}>Estrellas invitadas:</p>
                                                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                                                        {episode.guest_stars.map((star: GuestStar) => (
                                                                            <a href={`/actor/${star.id}`} class="flex items-center gap-3 text-sm">
                                                                                {star.profile_path && <img src={posterUrl(star.profile_path, 'w185')} alt={star.name} class="w-11 h-11 rounded-full object-cover flex-shrink-0" loading="lazy" />}
                                                                                <div>
                                                                                    <span class="text-gray-800 font-medium hover:text-blue-600">{star.name}</span>
                                                                                    <span class="block text-xs text-gray-500">{star.character}</span>
                                                                                </div>
                                                                            </a>
                                                                        ))}
                                                                    </div>
                                                                </div>
                                                            )}
                                                        </div>
                                                    </details>
                                                </div>
                                                );
                                            })}
                                            {(!seasonEpisodes || seasonEpisodes.length === 0) && (
                                                <p class="text-gray-500 italic text-center p-4 text-sm">No hay información de episodios disponible.</p>
                                            )}
                                        </div>
                                    </details>
                                );
                            })}
                        </div>
                    </div>

                    <!-- Pósters -->
                    {posters && posters.length > 0 && (
                        <details class="bg-white rounded-xl border border-gray-200">
                            <summary class="p-5 cursor-pointer text-lg font-semibold text-gray-800 flex items-center justify-between">
                                <span>Pósters ({posters.length})</span>
                                <svg class="w-5 h-5 text-gray-4000" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                            </summary>
                            <div class="px-5 pb-5 grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-2">
                                {posters.map((poster, index) => (
                                    <a href={`#poster-${index}`} class="block rounded-lg overflow-hidden hover:opacity-80 transition-opacity">
                                        <img src={poster.file_path} alt={`Póster ${index + 1}`} loading="lazy" class="w-full aspect-[2/3] object-cover" />
                                    </a>
                                ))}
                            </div>
                        </details>
                    )}

                    <!-- Reparto -->
                    {cast.length > 0 && (
                        <section>
                            <h2 class="text-xl font-semibold text-gray-800 mb-4">Reparto Principal</h2>
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                                {cast.map((actor) => (
                                    <a href={`/actor/${actor.id}`} class="flex items-center gap-3 p-4 bg-white rounded-xl border border-gray-200 hover:border-gray-300 transition-colors">
                                        {actor.profile_path ? (
                                            <img src={posterUrl(actor.profile_path, 'w185')} alt={actor.name} class="w-14 h-14 rounded-full object-cover flex-shrink-0" loading="lazy" />
                                        ) : (
                                            <div class="w-14 h-14 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0">
                                                <svg class="w-6 h-6 text-gray-4000" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/></svg>
                                            </div>
                                        )}
                                        <div class="min-w-0">
                                            <p class="text-sm sm:text-base font-medium text-gray-800 truncate">{actor.name}</p>
                                            {actor.character && <p class="text-xs sm:text-sm text-gray-500 truncate">{actor.character}</p>}
                                        </div>
                                    </a>
                                ))}
                            </div>
                        </section>
                    )}

                    <!-- Equipo -->
                    {directors.length > 0 && (
                        <section>
                            <h2 class="text-xl font-semibold text-gray-800 mb-4">Equipo de Producción</h2>
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                                {directors.map((member) => (
                                    <a href={`/team/${encodeURIComponent(member.name)}`} class="p-3 bg-white rounded-xl border border-gray-200 hover:border-gray-300 transition-colors">
                                        <p class="text-sm font-medium text-gray-800">{member.name}</p>
                                        <p class="text-xs text-gray-500">{member.job}</p>
                                    </a>
                                ))}
                            </div>
                        </section>
                    )}

                    <!-- Productoras -->
                    {item?.production_companies && item.production_companies.length > 0 && (
                        <section>
                            <h2 class="text-xl font-semibold text-gray-800 mb-4">Productoras</h2>
                            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                                {item.production_companies.map((company) => (
                                    <a href={`/productora/${encodeURIComponent(company.name)}?companyId=${company.id}`} class="flex flex-col items-center gap-2 p-4 bg-white rounded-xl border border-gray-200 hover:border-gray-300 transition-colors">
                                        {company.logo_path ? (
                                            <img src={posterUrl(company.logo_path, 'w200')} alt={company.name} class="h-10 object-contain" loading="lazy" />
                                        ) : (
                                            <div class="h-10 flex items-center"><span class="text-xs text-gray-4000">{company.name}</span></div>
                                        )}
                                        <span class="text-xs text-gray-600 text-center truncate w-full">{company.name}</span>
                                    </a>
                                ))}
                            </div>
                        </section>
                    )}

                    <!-- Recomendaciones -->
                    {seriesRecommendations.length > 0 && (
                        <section>
                            <h2 class="text-xl font-semibold text-gray-800 mb-4">
                                {seriesRecommendationType === 'recommendations' ? 'Recomendaciones' : 'Series similares'}
                            </h2>
                            <div class="recommendations-carousel">
                                <div class="recommendations-container flex gap-5 overflow-x-auto pb-4">
                                    {seriesRecommendations.slice(0, 20).map((serie, index) => (
                                        <a href={`/serie/${serie.id}`} class="recommendation-card flex-shrink-0 w-40 animate-fade-in-up" style={`animation-delay: ${index * 0.05}s`}>
                                            <div class="relative rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300">
                                                <img src={serie.poster_path || '/placeholder.jpg'} alt={serie.name} loading="lazy" class="w-full aspect-[2/3] object-cover transition-transform duration-300 hover:scale-105" />
                                                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 hover:opacity-100 transition-opacity duration-300 flex items-end p-3">
                                                    <p class="text-white text-xs line-clamp-3 leading-relaxed">{serie.overview}</p>
                                                </div>
                                                {serie.vote_average > 0 && (
                                                    <span class="absolute top-2 right-2 text-xs font-bold px-2 py-0.5 bg-black/70 text-yellow-400 rounded-lg backdrop-blur-sm">{serie.vote_average.toFixed(1)}</span>
                                                )}
                                            </div>
                                            <p class="mt-2 text-sm font-medium text-gray-800 line-clamp-2">{serie.name}</p>
                                            <p class="text-xs text-gray-4000">{serie.first_air_date ? new Date(serie.first_air_date).getFullYear() : ''}</p>
                                        </a>
                                    ))}
                                </div>
                            </div>
                        </section>
                    )}

                    <!-- Reviews TMDB -->
                    {reviews.length > 0 && (
                        <details class="bg-white rounded-xl border border-gray-200">
                            <summary class="p-5 cursor-pointer text-lg font-semibold text-gray-800 flex items-center justify-between">
                                <span>Opiniones de la comunidad ({reviews.length})</span>
                                <svg class="w-5 h-5 text-gray-4000" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                            </summary>
                            <div class="px-5 pb-5 space-y-4">
                                {reviews.map((review) => (
                                    <details class="border-b border-gray-100 pb-4 last:border-0 last:pb-0 group">
                                        <summary class="cursor-pointer list-none">
                                            <div class="flex items-center gap-2 mb-2">
                                                <span class="text-sm font-medium text-gray-800">{review.author}</span>
                                                {review.author_details?.rating && (
                                                    <span class="text-xs px-1.5 py-0.5 bg-yellow-50 text-yellow-700 rounded">{review.author_details.rating}/10</span>
                                                )}
                                                <span class="text-xs text-gray-4000">{review.created_at ? new Date(review.created_at).toLocaleDateString('es-ES') : ''}</span>
                                            </div>
                                            <p class="text-sm text-gray-600 line-clamp-4 group-open:line-clamp-none leading-relaxed">{review.content}</p>
                                            <span class="text-xs text-blue-500 mt-1 inline-block group-open:hidden">Leer más...</span>
                                        </summary>
                                    </details>
                                ))}
                            </div>
                        </details>
                    )}
                </div>
            </div>
        </div>

        <!-- Lightbox pósters -->
        {posters.map((poster, index) => (
            <div id={`poster-${index}`} class="lightbox fixed inset-0 z-50 items-center justify-center bg-black/80 p-4">
                <a href="#_" class="absolute inset-0" aria-label="Cerrar"></a>
                <img src={poster.file_path} alt={`Póster ${index + 1}`} class="relative max-h-[90vh] max-w-[90vw] object-contain rounded-lg shadow-2xl" />
                <a href="#_" class="absolute top-4 right-4 text-white/80 hover:text-white text-3xl font-light leading-none z-10" aria-label="Cerrar">&times;</a>
                {index > 0 && (
                    <a href={`#poster-${index - 1}`} class="absolute left-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10" aria-label="Anterior">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    </a>
                )}
                {index < posters.length - 1 && (
                    <a href={`#poster-${index + 1}`} class="absolute right-14 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10" aria-label="Siguiente">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </a>
                )}
            </div>
        ))}
    </article>
</Layout>

<script is:inline src="/js/optimistic-actions.js"></script>
