---
import Header from "../components/shell/Header.astro";
import { SITE_DESCRIPTION as DEFAULT_DESCRIPTION, SITE_TAGLINE } from "../utils/core/siteCopy";
import CommandPalette from "../components/shell/CommandPalette.astro";
import AuthModal from "../components/shell/AuthModal.astro";
import SaveToPopover from "../components/shell/SaveToPopover.astro";
import QuickView from "../components/shell/QuickView.astro";
import Coach from "../components/shell/Coach.astro";
import MobileTabBar from "../components/shell/MobileTabBar.astro";
import MobileNavSheets from "../components/shell/MobileNavSheets.astro";
import SocialLayer from "../components/social/SocialLayer.astro";
import MiniChat from "../components/social/MiniChat.astro";
import { LEGAL, LEGAL_PAGES } from "../utils/legal/legalInfo";
import "../styles/tokens.css";
import "../styles/layout.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/components/buttons.css";     // botones del sistema v2 (.btn; .pf-btn es su alias)
import "../styles/components/chips.css";       // chips del sistema v2 (filtro, etiqueta, estado)
import "../styles/components/social-ui.css";   // botones, filas y avisos sociales (F2+)
import "../styles/components/recommend.css";   // recomendar a un amigo (F4)
import "../styles/components/messages-row.css"; // filas de conversación (mensajes M1+, también en la cabecera)
import "../styles/dark-mode.css";   // <- las reglas [data-theme="dark"] ganan en cascada
import "../styles/components/strip-palettes.css";   // paleta de la tira (9.4): después del oscuro, para ganarle

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    ogType?: string;
    /**
     * `<meta name="robots">`. Ausente = no se pinta (lo de siempre). El perfil público manda
     * `noindex, nofollow` salvo que su dueño active «Que aparezca en buscadores».
     */
    robots?: string;
    /** URL canónica absoluta para `og:url` (el perfil público usa la de producción). */
    ogUrl?: string;
    /** `false` en las páginas de error: sin `<link rel="canonical">` (QA 1.4, H75). */
    canonical?: boolean;
}

const {
    title,
    description = DEFAULT_DESCRIPTION,
    ogImage,
    ogType = "website",
    robots,
    ogUrl,
    canonical = true,
} = Astro.props;

// Imagen al compartir (QA 1.2, H73/H04): WhatsApp, X, Telegram o Slack necesitan una URL ABSOLUTA. Sin
// imagen propia de la página, la de la marca (public/og-image.png, 1200×630; antes apuntaba a un archivo
// que no existía). Las de TMDB ya llegan absolutas y `new URL` las deja igual.
// Títulos y descripciones (QA 6.3, H03/H47). Cada página pasa su nombre («Cartelera», «El club de la
// lucha») y aquí se le añade « · YourFavs», una sola vez y con el mismo separador en toda la web (antes,
// unas lo llevaban con «—», otras con «|» y la mayoría sin él). La que empieza por «YourFavs» (portada)
// se deja tal cual. La descripción se corta a ~160 caracteres por palabra: la de TMDB puede ser larguísima.
const BRAND = 'YourFavs';
const pageTitle = title.startsWith(BRAND) ? title : `${title.replace(/\s*[—|·-]\s*YourFavs\s*$/, '')} · ${BRAND}`;
const ogTitle = title.startsWith(BRAND) ? title : title.replace(/\s*[—|·-]\s*YourFavs\s*$/, '');
const clean = description.replace(/\s+/g, ' ').trim();
const metaDescription = clean.length <= 160 ? clean : `${clean.slice(0, 157).replace(/\s+\S*$/, '')}…`;

const shareImage = new URL(ogImage || '/og-image.png', Astro.url.origin).href;
const shareUrl = ogUrl || new URL(Astro.url.pathname, Astro.url.origin).href;

// Pista post-guardado (Fase F · Acceso C): elegible si hay sesión y el usuario
// NO ha completado el onboarding (undefined o 'skipped' → se le puede invitar;
// 'done' → no molestar). El JS decide cuándo mostrarla (tras guardar, 1 vez).
const tasteHintEligible = !!Astro.locals.user && Astro.locals.user.onboarding !== 'done';

// Tab bar móvil: oculta en flujos a pantalla completa (onboarding/auth).
const _tbPath = Astro.url.pathname;
// También dentro de una conversación de mensajes: va a pantalla completa (handoff de mensajes §9).
const hideTabbar = ['/gustos', '/login', '/registro'].some(p => _tbPath === p || _tbPath.startsWith(p + '/'))
    || /^\/mislistas\/amigos\/mensajes\/\d+\/?$/.test(_tbPath);
---
<!DOCTYPE html>
<html lang="es" data-strip={Astro.locals.user?.stripPalette || undefined} data-theme-choice={Astro.locals.user?.theme || undefined}>
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    {/* Favicon (rediseño, Fase 8 · 8.1): la claqueta de siempre, redibujada en SVG por Claude Design
         y recortada a su tamaño (antes, `logo_yourfavs.png` a 1024 px con la marca en la mitad del
         lienzo: en la pestaña salía diminuta). Los PNG de 32 y 16 son para navegadores sin SVG; los que
         lo aceptan se quedan con el SVG. Los iconos de la app instalada (apple-touch-icon y manifest)
         van aparte, aquí debajo, y no cambian. */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png"/>
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="generator" content={Astro.generator}/>
    <meta name="description" content={metaDescription}/>
    {/* Google Search Console: verifica que yourfavs.netlify.app es nuestra (público por diseño). */}
    <meta name="google-site-verification" content="kHywNYQfqZRM6KFylpSXCUEIPkn_KjKz_Hqhi9kJBgM"/>
    <meta name="theme-color" content="#2B63D9"/>
    {canonical && <link rel="canonical" href={Astro.url.href}/>}
    {/* App instalable. El `apple-touch-icon` de aquí abajo ya se enlazaba, pero el archivo
         NO existía: era un 404, y por eso iOS ponía una captura de la página en la pantalla
         de inicio en vez del logo. Lo genera `scripts/build-pwa-icons.mjs`. */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <link rel="manifest" href="/manifest.webmanifest"/>
    <meta name="apple-mobile-web-app-capable" content="yes"/>
    <meta name="mobile-web-app-capable" content="yes"/>
    {/* `default` y no `black-translucent` a propósito: el translúcido mete el contenido bajo
         la barra de estado, y el layout no tiene padding superior de safe-area (el tabbar sí
         lo tiene abajo). Con `default`, la cabecera azul empieza donde debe. */}
    <meta name="apple-mobile-web-app-status-bar-style" content="default"/>
    <meta name="apple-mobile-web-app-title" content="YourFavs"/>
    <meta property="og:site_name" content="YourFavs"/>
    <meta property="og:locale" content="es_ES"/>
    <meta property="og:image" content={shareImage}/>
    {!ogImage && <meta property="og:image:width" content="1200"/>}
    {!ogImage && <meta property="og:image:height" content="630"/>}
    {!ogImage && <meta property="og:image:alt" content={`YourFavs · ${SITE_TAGLINE}`}/>}
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={shareImage}/>
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F3F4F6"/>
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0B1220"/>
    <script is:inline>
        (function () {
            try {
                // Dos claves, a propósito:
                //   themeChoice = lo que ELIGIÓ el usuario ('light'|'dark'|'system')
                //   theme       = lo que se APLICA ('light'|'dark')
                // Antes solo existía `theme`, así que quien viene de una versión anterior
                // no tiene `themeChoice`: se usa su `theme` como elección. Sin nada previo,
                // según el sistema (QA 1.5, H43: Ajustes ya lo decía, pero aquí se aplicaba claro).
                // Con sesión y nada en este navegador, lo guardado en tu perfil (`data-theme-choice`); antes
                // un móvil nuevo no sabía que habías elegido oscuro.
                var choice = localStorage.getItem('themeChoice') || localStorage.getItem('theme')
                    || document.documentElement.getAttribute('data-theme-choice') || 'system';
                var theme = choice === 'system'
                    ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                    : choice;
                document.documentElement.setAttribute('data-theme', theme);
            } catch {}
        })();
    </script>
    <meta property="og:title" content={ogTitle}/>
    <meta property="og:description" content={metaDescription}/>
    <meta property="og:type" content={ogType}/>
    <meta property="og:url" content={shareUrl}/>
    {robots && <meta name="robots" content={robots}/>}
    <title>{pageTitle}</title>
</head>
<body id="top" class="bg-light-gray min-h-screen pb-16 sm:pb-24 md:pb-6 font-poppins" data-taste-hint={tasteHintEligible ? 'eligible' : ''}>
<a href="#content" class="skip-link">Saltar al contenido</a>
<Header/>
<CommandPalette/>
<AuthModal/>
<SaveToPopover/>
<QuickView/>
<Coach/>
{Astro.locals.user && <SocialLayer/>}
{Astro.locals.user && <MiniChat/>}

<main id="content" class="max-w-7xl w-full px-3 sm:px-6 lg:px-8 mx-auto pt-4 sm:pt-6 md:pt-8 lg:pt-10">
    {/* Columna lateral opcional (rediseño 5.1: la navegación de Mis listas). Solo si la página la pasa. */}
    {Astro.slots.has('aside') ? (
        <div class="yf-aside-shell">
            <div class="yf-aside"><slot name="aside"/></div>
            <div class="yf-aside-main"><slot/></div>
        </div>
    ) : <slot/>}

    {/* Botón flotante para volver arriba */}
    <div class="back-to-top-container">
        <a href="#top" title="Subir al inicio" aria-label="Subir al inicio" class="back-to-top">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
            </svg>
        </a>
    </div>
</main>
<footer class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 mt-16 py-8 border-t border-gray-200">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-gray-500">
        <p>&copy; {new Date().getFullYear()} YourFavs</p>
        <div class="flex items-center gap-6">
            <a href="/about" class="hover:text-blue-600 transition">Acerca de</a>
            <span class="text-gray-300">·</span>
            <a href="https://www.themoviedb.org/" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-blue-600 transition" aria-label="Datos de TMDB (The Movie Database)">
                Datos de
                <img src="/logos/tmdb.svg" alt="TMDB" width="82" height="11" class="h-[11px] w-auto" loading="lazy" />
            </a>
        </div>
    </div>
    {/* Páginas legales (QA 4.1, H59): antes el pie solo tenía «Acerca de». */}
    <nav class="mt-4 flex flex-wrap justify-center sm:justify-start gap-x-4 text-xs text-gray-500" aria-label="Legal">
        {LEGAL_PAGES.map((p) => <a href={p.href} class="inline-flex items-center min-h-[24px] py-1 hover:text-blue-600 transition">{p.label}</a>)}
        <a href={`mailto:${LEGAL.email}`} class="inline-flex items-center min-h-[24px] py-1 hover:text-blue-600 transition">Contacto</a>
    </nav>
    {/* Atribución que exigen los términos de TMDB (logo menos prominente que el nuestro + este aviso)
         y la fuente de «Dónde ver» (JustWatch). */}
    <p class="mt-4 text-xs text-gray-400 text-center sm:text-left">
        Este producto usa la API de TMDB pero no está avalado ni certificado por TMDB.
        Disponibilidad en plataformas por <a href="https://www.justwatch.com/" target="_blank" rel="noopener" class="underline hover:text-blue-600">JustWatch</a>.
    </p>
</footer>
<script is:inline>
    (function () {
        // Back-to-top
        var el = document.querySelector('.back-to-top-container');
        if (el) {
            var reveal = function () {
                var scrolled = window.scrollY || document.documentElement.scrollTop;
                if (scrolled > 400) el.classList.add('is-visible'); else el.classList.remove('is-visible');
            };
            reveal();
            window.addEventListener('scroll', reveal, { passive: true });
        }

        // Tema: ÚNICO punto que aplica y persiste. Lo usan el toggle del header, el
        // segmentado del menú de escritorio, el de la hoja móvil y Ajustes → Apariencia,
        // para que "según el sistema" signifique lo mismo en los cuatro sitios (antes cada
        // uno escribía localStorage a su manera y 'system' acababa aplicando claro).
        function resolveTheme(choice) {
            return choice === 'system'
                ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                : choice;
        }
        window.yfApplyTheme = function (choice) {
            var theme = resolveTheme(choice);
            document.documentElement.setAttribute('data-theme', theme);
            try {
                localStorage.setItem('themeChoice', choice);
                localStorage.setItem('theme', theme);
            } catch {}
            // Avisa a los otros controles para que marquen la misma opción sin recargar.
            document.dispatchEvent(new CustomEvent('yf:theme', { detail: { choice: choice, theme: theme } }));
        };

        // Con "según el sistema" elegido, seguir al SO en vivo (sin recargar).
        try {
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
                var c = null;
                try { c = localStorage.getItem('themeChoice'); } catch {}
                if (c === 'system') window.yfApplyTheme('system');
            });
        } catch {}

        // Toggle binario del header (invitados): claro ⇄ oscuro.
        document.querySelectorAll('.theme-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                window.yfApplyTheme(next);
            });
        });
    })();
</script>
<div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>
{!hideTabbar && <MobileTabBar />}
{!hideTabbar && <MobileNavSheets />}
<script is:inline src="/js/scroll-restore.js"></script>
{import.meta.env.PROD && (
    <script is:inline>
        // Service worker (ver public/sw.js). Solo en producción a propósito: en `astro dev`
        // una caché de assets pelea con el HMR de Vite y acabas depurando fantasmas.
        // Va en `load` para no competir por red con el primer render.
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js').catch(function () { /* sin SW se vive igual */ });
            });
        }
    </script>
)}
</body>
</html>
