---
/**
 * Coach (§3 "cuidar el uso") — pista contextual, una sola vez por usuario.
 *
 * Se monta una vez en el Layout. Solo con sesión (las features que anuncia son
 * personales). En el cliente busca la primera pista de `COACH_HINTS` que case con
 * la ruta actual y no esté descartada (localStorage `yf_coach_<id>`), y la muestra
 * como banner inferior cerrable — reusando el lenguaje visual de la pista de gustos.
 *
 * Estilos en `<style is:global>` a propósito: el banner se inyecta por JS y el CSS
 * scoped de Astro no alcanza a los nodos creados en runtime.
 */
import { COACH_HINTS } from '../utils/constants/coachHints';
const showCoach = !!Astro.locals.user;
---
{showCoach && (
    <>
        <style is:global>
            #yf-coach {
                position: fixed; left: 50%; bottom: 24px;
                transform: translateX(-50%) translateY(8px); z-index: 10040;
                width: min(460px, 92vw); display: flex; align-items: flex-start; gap: 14px;
                background: var(--bg-elev, #fff); border: 1px solid var(--border, #E5E7EB);
                border-radius: 14px; box-shadow: 0 18px 50px rgba(0,0,0,.35);
                padding: 14px 16px; font-family: var(--font, sans-serif);
                opacity: 0; transition: opacity .25s ease, transform .25s ease;
            }
            #yf-coach.is-show { opacity: 1; transform: translateX(-50%) translateY(0); }
            #yf-coach .coach-chip {
                width: 40px; height: 40px; border-radius: 11px;
                background: var(--stamp-blue, #DBEAFE); color: var(--stamp-blue-ink, #1D4ED8);
                display: flex; align-items: center; justify-content: center;
                flex-shrink: 0; font-size: 18px;
            }
            #yf-coach .coach-body { flex: 1; min-width: 0; }
            #yf-coach .coach-title { font-size: 14px; font-weight: 700; color: var(--text, #111827); }
            #yf-coach .coach-text { font-size: 12.5px; color: var(--text-3, #6B7280); line-height: 1.45; }
            #yf-coach .coach-text a { color: var(--accent, #E63946); font-weight: 600; text-decoration: none; }
            #yf-coach .coach-close {
                width: 28px; height: 28px; flex-shrink: 0; border-radius: 8px; border: none;
                background: var(--bg-tint, #F9FAFB); color: var(--text-3, #6B7280);
                cursor: pointer; font-size: 14px;
            }
            @media (max-width: 768px) {
                #yf-coach { bottom: calc(72px + env(safe-area-inset-bottom, 0px)); }
            }
            @media (prefers-reduced-motion: reduce) {
                #yf-coach { transition: none; }
            }
        </style>
        <script is:inline define:vars={{ hints: COACH_HINTS }}>
            (function () {
                try {
                    // No pisar la pista de gustos: si es elegible, que salga esa primero.
                    if (document.body.getAttribute('data-taste-hint') === 'eligible') return;
                    var path = location.pathname;
                    var hint = null;
                    for (var i = 0; i < hints.length; i++) {
                        var h = hints[i];
                        var match = h.paths.some(function (p) { return path === p || path.indexOf(p) === 0; });
                        if (!match) continue;
                        if (localStorage.getItem('yf_coach_' + h.id)) continue;
                        hint = h; break;
                    }
                    if (!hint) return;

                    // "Primera vez": marcar ya al mostrar → nunca reaparece (aunque no la cierre).
                    try { localStorage.setItem('yf_coach_' + hint.id, '1'); } catch (e) {}

                    var el = document.createElement('div');
                    el.id = 'yf-coach';
                    el.setAttribute('role', 'status');
                    var cta = (hint.ctaLabel && hint.ctaHref)
                        ? ' <a href="' + hint.ctaHref + '">' + hint.ctaLabel + '</a>' : '';
                    el.innerHTML =
                        '<span class="coach-chip">' + (hint.icon || '💡') + '</span>' +
                        '<div class="coach-body">' +
                            '<div class="coach-title">' + hint.title + '</div>' +
                            '<div class="coach-text">' + hint.text + cta + '</div>' +
                        '</div>' +
                        '<button type="button" class="coach-close" aria-label="Cerrar">✕</button>';
                    document.body.appendChild(el);
                    requestAnimationFrame(function () { el.classList.add('is-show'); });

                    var close = function () {
                        el.classList.remove('is-show');
                        setTimeout(function () { el.remove(); }, 250);
                    };
                    el.querySelector('.coach-close').addEventListener('click', close);
                } catch (e) {}
            })();
        </script>
    </>
)}
