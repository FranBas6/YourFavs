---
import Layout from "../../layouts/Layout.astro";
import {
    getSeriesByActorId, getMoviesByActorId,
    getActorDetailsById, fetchActorImages
} from "../../services/API/Actors/InfoActor";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import {genresMap, getGenreName} from "../../utils/constants/genres";
import {sortBycriterion} from "../../utils/sorting";
import '../../styles/pages/actor/actor.css';
import {handleActorFavAction} from "../../services/BD/actors/yourfavsActor";
import type {ActorsFavs} from "../../services/BD/actors/yourfavsActor";
import {initializeApp} from "firebase/app";
import {getFirestore, doc, getDoc, collection, getDocs} from "firebase/firestore";
import {firebaseConfig} from '../../utils/firebaseConfig';

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

const {actor} = Astro.params;

if (!actor) {
    throw new Error("ID del actor no encontrado en la URL");
}

if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        const redirectUrl = await handleActorFavAction(formData);
        return Astro.redirect(redirectUrl);
    } catch (error) {
        console.error('Error al gestionar el actor:', error);
        return Astro.redirect(`/actor/${actor}`);
    }
}

const series = await getSeriesByActorId({id: actor});
const movies = await getMoviesByActorId({id: actor});

// Obtener detalles del actor
const actorDetails = await getActorDetailsById({id: actor});

// Si no se pueden obtener los detalles, usar un placeholder
const actorInfo = actorDetails || {
    id: null,
    nombre: actor,
    biografia: "Información biográfica del actor no disponible.",
    lugarNacimiento: null,
    fechaNacimiento: null,
    fechaFallecimiento: null,
    imagen: "/placeholder-actor.jpg", // Asegúrate de tener una imagen predeterminada
    popularidad: null,
    conocidoPor: "Actuación",
    genero: null,
    alias: [],
    redes: {
        imdb: null,
        twitter: null,
        instagram: null,
        facebook: null,
        tiktok: null,
        youtube: null,
    }
};

// Calcular estadísticas del actor
const totalMovies = movies.length;
const totalSeries = series.length;
const totalProductions = totalMovies + totalSeries;
const movieGenres: Record<number, number> = movies.flatMap(m => m.genre_ids || [])
    .reduce((acc: Record<number, number>, genreId: number) => {
        acc[genreId] = (acc[genreId] || 0) + 1;
        return acc;
    }, {});

// Encontrar los géneros más frecuentes
const topGenres = Object.entries(movieGenres)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 3)
    .map(([genreId, _count]) => genresMap[parseInt(genreId)]);

// Calcular edad actual si tiene fecha de nacimiento
let edadActual: string | null = null;
if (actorInfo.fechaNacimiento) {
    const fechaNacimiento = new Date(actorInfo.fechaNacimiento);
    const hoy = new Date();
    let edad = hoy.getFullYear() - fechaNacimiento.getFullYear();
    const mes = hoy.getMonth() - fechaNacimiento.getMonth();
    if (mes < 0 || (mes === 0 && hoy.getDate() < fechaNacimiento.getDate())) {
        edad--;
    }
    edadActual = `${edad} años`;
}

// Verificar si el actor está en favoritos
const actorDocRef = doc(db, 'ActorsFavs', actor);
const actorDocSnap = await getDoc(actorDocRef);
const isInFavorites = actorDocSnap.exists();
const currentPosition = isInFavorites ? (actorDocSnap.data() as ActorsFavs).position : null;

// Obtener total de actores favoritos para la validación
const actorsFavsRef = collection(db, 'ActorsFavs');
const actorsFavsSnapshot = await getDocs(actorsFavsRef);
const totalActorsFavorites = actorsFavsSnapshot.size;

// Obtener parámetros de ordenación
const url = new URL(Astro.request.url);
const sortBy = url.searchParams.get('sort') || 'popularity';

const moviesSorted = sortBycriterion(movies, sortBy, 'release_date');
const seriesSorted = sortBycriterion(series, sortBy, 'first_air_date');

import type {ActorImage} from "../../services/API/Actors/InfoActor";

let posters: ActorImage[] = [];

if (actor) {
    try {
        // Obtener 15 retratos del actor
        const profileImages = await fetchActorImages(actor);
        const portraits = profileImages.slice(0, 25);

        // Unir ambos
        posters = [...portraits];
    } catch (error) {
        console.error('Error al obtener imágenes del actor:', error);
    }
}
---
<Layout title={`${actorInfo.nombre}`}>
    <!-- Hero Section con gradiente moderno -->
    <div class="hero-section">
        <div class="hero-background"></div>
        <div class="hero-overlay"></div>
        
        <div class="container mx-auto px-4 py-16 relative z-20">
            <div class="hero-content">
                <!-- Imagen de perfil -->
                <div class="profile-card">
                    {actorInfo.imagen ? (
                        <img
                            src={`https://image.tmdb.org/t/p/w500${actorInfo.imagen}`}
                            alt={actorInfo.nombre}
                            class="profile-image"
                        />
                    ) : (
                        <div class="profile-placeholder">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                            </svg>
                        </div>
                    )}
                    
                    {actorInfo.popularidad && (
                        <div class="popularity-badge">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.8-2.034c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                            <span>{actorInfo.popularidad.toFixed(1)}</span>
                        </div>
                    )}
                </div>
                
                <!-- Información principal -->
                <div class="hero-info">
                    <h1 class="actor-name">{actorInfo.nombre}</h1>
                    
                    <div class="actor-meta">
                        {actorInfo.conocidoPor && (
                            <span class="meta-badge">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/>
                                </svg>
                                {actorInfo.conocidoPor}
                            </span>
                        )}
                        
                        {edadActual && (
                            <span class="meta-badge">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                                </svg>
                                {edadActual}
                            </span>
                        )}
                        
                        <span class="meta-badge">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"/>
                            </svg>
                            {totalProductions} producciones
                        </span>
                    </div>
                    
                    <!-- Navegación rápida -->
                    <div class="quick-nav">
                        <a href="#biografia" class="nav-link">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                            </svg>
                            Biografía
                        </a>
                        <a href="#peliculas" class="nav-link">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"/>
                            </svg>
                            {totalMovies} Películas
                        </a>
                        <a href="#series" class="nav-link">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
                            </svg>
                            {totalSeries} Series
                        </a>
                        {posters.length > 0 && (
                            <a href="#galeria" class="nav-link">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
                                </svg>
                                Galería
                            </a>
                        )}
                    </div>
                    
                    <!-- Botones de acción para favoritos -->
                    <div class="action-buttons-container">
                        {!isInFavorites ? (
                            <!-- Botón para añadir a favoritos -->
                            <form method="POST" class="add-favorite-form">
                                <input type="hidden" name="actor_id" value={actor} />
                                <input type="hidden" name="action" value="add" />
                                
                                <div class="position-input-group">
                                    <label for="custom_position" class="position-label">Posición (opcional):</label>
                                    <input 
                                        type="number" 
                                        name="custom_position" 
                                        id="custom_position"
                                        min="1"
                                        placeholder={`1-${totalActorsFavorites + 1}`}
                                        class="position-input"
                                    />
                                </div>
                                
                                <button type="submit" class="action-button add-button">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                                    </svg>
                                    Seguir Actor
                                </button>
                            </form>
                        ) : (
                            <!-- Botones para quitar o cambiar posición -->
                            <div class="favorite-actions">
                                <form method="POST" class="inline-form">
                                    <input type="hidden" name="actor_id" value={actor} />
                                    <input type="hidden" name="action" value="remove" />
                                    <button type="submit" class="action-button remove-button">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                                        </svg>
                                        Dejar de Seguir
                                    </button>
                                </form>
                                
                                <form method="POST" class="update-position-form">
                                    <input type="hidden" name="actor_id" value={actor} />
                                    <input type="hidden" name="action" value="update" />
                                    
                                    <div class="position-update-group">
                                        <label for="update_position" class="position-label">
                                            Posición actual: <strong>{currentPosition}</strong>
                                        </label>
                                        <div class="position-input-container">
                                            <input 
                                                type="number" 
                                                name="custom_position" 
                                                id="update_position"
                                                min="1"
                                                max={totalActorsFavorites}
                                                value={currentPosition}
                                                class="position-input"
                                                required
                                            />
                                            <button type="submit" class="action-button update-button">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                                    <path d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2h-1.528A6 6 0 004 9.528V4z"/>
                                                    <path fill-rule="evenodd" d="M8 10a4 4 0 00-3.446 6.032l-1.261 1.26a1 1 0 101.414 1.415l1.261-1.261A4 4 0 108 10zm-2 4a2 2 0 114 0 2 2 0 01-4 0z" clip-rule="evenodd"/>
                                                </svg>
                                                Actualizar Posición
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        )}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenido principal -->
    <div class="main-content">
        <div class="container mx-auto px-4 py-8">
            
            <!-- Sección de Información Personal -->
            <section id="biografia" class="info-section">
                <div class="section-grid">
                    <!-- Biografía -->
                    <div class="bio-card">
                        <h2 class="section-title">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                            </svg>
                            Biografía
                        </h2>
                        {actorInfo.biografia ? (
                            <>
                                <input type="checkbox" id="bio-toggle" class="bio-toggle hidden" />
                                <p class="bio-text">{actorInfo.biografia}</p>
                                <label for="bio-toggle" class="read-more-btn"></label>
                            </>
                        ) : (
                            <p class="text-gray-800 dark:text-gray-600">No hay información biográfica disponible.</p>
                        )}
                    </div>
                    
                    <!-- Información Personal -->
                    <div class="personal-info-card">
                        <h3 class="info-subtitle">Información Personal</h3>
                        <div class="info-grid">
                            {actorInfo.fechaNacimiento && (
                                <div class="info-item">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                                    </svg>
                                    <div>
                                        <span class="info-label">Nacimiento</span>
                                        <span class="info-value">{actorInfo.fechaNacimiento}</span>
                                    </div>
                                </div>
                            )}
                            
                            {actorInfo.fechaFallecimiento && (
                                <div class="info-item">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                                    </svg>
                                    <div>
                                        <span class="info-label">Fallecimiento</span>
                                        <span class="info-value">{actorInfo.fechaFallecimiento}</span>
                                    </div>
                                </div>
                            )}
                            
                            {actorInfo.lugarNacimiento && (
                                <div class="info-item">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                                    </svg>
                                    <div>
                                        <span class="info-label">Lugar de nacimiento</span>
                                        <span class="info-value">{actorInfo.lugarNacimiento}</span>
                                    </div>
                                </div>
                            )}
                            
                            {topGenres.length > 0 && (
                                <div class="info-item full-width">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
                                    </svg>
                                    <div>
                                        <span class="info-label">Géneros frecuentes</span>
                                        <div class="genre-tags">
                                            {topGenres.map(genre => (
                                                <span class="genre-tag">{genre}</span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            )}
                        </div>
                        
                        <!-- Redes Sociales -->
                        {actorInfo.redes && Object.values(actorInfo.redes).some(red => red !== null) && (
                            <div class="social-section">
                                <h3 class="info-subtitle">Redes Sociales</h3>
                                <div class="social-links">
                                    {actorInfo.redes.imdb && (
                                        <a href={actorInfo.redes.imdb} target="_blank" rel="noopener noreferrer" class="social-link imdb" aria-label="IMDb">
                                            <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M22.395 0H1.605C.72 0 0 .72 0 1.605v20.79C0 23.28.72 24 1.605 24h20.79C23.28 24 24 23.28 24 22.395V1.605C24 .72 23.28 0 22.395 0zM8.25 18.75H5.625V5.25H8.25v13.5zm7.125-9.375c-.563 0-1.125.375-1.125 1.125v8.25h-2.625V9.375c0-1.688 1.313-3 3-3s3 1.313 3 3v9.375H15V10.5c0-.75-.563-1.125-1.125-1.125z"/>
                                            </svg>
                                        </a>
                                    )}
                                    {actorInfo.redes.instagram && (
                                        <a href={actorInfo.redes.instagram} target="_blank" rel="noopener noreferrer" class="social-link instagram" aria-label="Instagram">
                                            <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                            </svg>
                                        </a>
                                    )}
                                    {actorInfo.redes.twitter && (
                                        <a href={actorInfo.redes.twitter} target="_blank" rel="noopener noreferrer" class="social-link twitter" aria-label="Twitter">
                                            <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                                            </svg>
                                        </a>
                                    )}
                                    {actorInfo.redes.facebook && (
                                        <a href={actorInfo.redes.facebook} target="_blank" rel="noopener noreferrer" class="social-link facebook" aria-label="Facebook">
                                            <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                            </svg>
                                        </a>
                                    )}
                                    {actorInfo.redes.tiktok && (
                                        <a href={actorInfo.redes.tiktok} target="_blank" rel="noopener noreferrer" class="social-link tiktok" aria-label="TikTok">
                                            <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                                            </svg>
                                        </a>
                                    )}
                                    {actorInfo.redes.youtube && (
                                        <a href={actorInfo.redes.youtube} target="_blank" rel="noopener noreferrer" class="social-link youtube" aria-label="YouTube">
                                            <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                                            </svg>
                                        </a>
                                    )}
                                </div>
                            </div>
                        )}
                    </div>
                </div>
            </section>

            <!-- Galería de Imágenes -->
            {posters.length > 0 && (
                <section id="galeria" class="gallery-section">
                    <div class="gallery-card">
                        <div class="gallery-header">
                            <h2 class="section-title-main">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
                            </svg>
                            Galería de Imágenes ({posters.length})
                            </h2>
                            <button class="toggle-gallery-btn" onclick="toggleGallery()">
                                <span class="btn-text">Mostrar imágenes</span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon arrow-icon" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="gallery-grid" id="gallery-grid" style="display: none;">
                        {posters.map((poster, index) => (
                            <a href={`#img-${index}`} class="gallery-item">
                                <img src={poster.file_path} alt={`Imagen ${index + 1}`} loading="lazy" />
                                <div class="gallery-overlay">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                        <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                                        <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                                    </svg>
                                </div>
                                <!-- Modal -->
                                <div id={`img-${index}`} class="modal">
                                    <a href="#galeria" class="modal-close">&times;</a>
                                    <img src={poster.file_path} alt={`Imagen ${index + 1}`} />
                                </div>
                            </a>
                        ))}
                    </div>
                </section>
            )}
        </div>
    </div>

    <!-- Controles de ordenación -->
    <div class="sort-controls mt-5">
        <h2 class="filmography-title">
            Filmografía ({totalProductions})
        </h2>
        <div class="sort-buttons">
            <a href="?sort=quality" class={`sort-btn ${sortBy === 'quality' ? 'active' : ''}`}>
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.8-2.034c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                Mejor Valoradas
            </a>
            <a href="?sort=popularity" class={`sort-btn ${sortBy === 'popularity' ? 'active' : ''}`}>
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/>
                </svg>
                Más Populares
            </a>
            <a href="?sort=date" class={`sort-btn ${sortBy === 'date' ? 'active' : ''}`}>
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                </svg>
                Más Recientes
            </a>
        </div>
    </div>

        <!-- Sección de Películas -->
        <section id="peliculas" class="mb-16 content-section scroll-mt-24">
            <div class="section-header-container">
                <h2 class="section-title">
                    <span class="section-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                        </svg>
                    </span>
                    PELÍCULAS
                    <span class="section-count">({movies.length})</span>
                </h2>
                <div class="section-header-line"></div>
            </div>

            {movies.length === 0 ? (
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                                      d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                            </svg>
                        </div>
                        <h3 class="empty-state-title">No se encontraron películas</h3>
                        <p class="empty-state-description">Este actor no tiene películas registradas en nuestra base de
                            datos.</p>
                    </div>
            ) : (
                    <div class="content-grid">
                        {
                            moviesSorted.map((item) => (
                                    <div class="card-wrapper">
                                        <CardMovie
                                                id={item.id.toString()}
                                                img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                title={item.title}
                                                vote_average={item.vote_average}
                                                overview={item.overview}
                                                release_date={item.release_date}
                                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                                character={item.character}
                                        />
                                    </div>
                            ))
                        }
                    </div>
            )}
        </section>

        <!-- Sección de Series -->
        <section id="series" class="mb-16 content-section scroll-mt-24">
            <div class="section-header-container">
                <h2 class="section-title">
                    <span class="section-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </span>
                    SERIES
                    <span class="section-count">({series.length})</span>
                </h2>
                <div class="section-header-line"></div>
            </div>

            {series.length === 0 ? (
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                                      d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <h3 class="empty-state-title">No se encontraron series</h3>
                        <p class="empty-state-description">Este actor no tiene series registradas en nuestra base de
                            datos.</p>
                    </div>
            ) : (
                    <div class="content-grid">
                        {
                            seriesSorted.map((item) => (
                                    <div class="card-wrapper">
                                        <CardSerie
                                                id={item.id.toString()}
                                                img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                name={item.name}
                                                vote_average={item.vote_average}
                                                overview={item.overview}
                                                first_air_date={item.first_air_date}
                                                seasons={item.seasons}
                                                last_episode_to_air={item.last_episode_to_air}
                                                next_episode_to_air={item.next_episode_to_air}
                                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                                character={item.character}
                                        />
                                    </div>
                            ))
                        }
                    </div>
            )}
        </section>

    </section>
</Layout>

<script is:inline>
    function toggleGallery() {
        var grid = document.getElementById('gallery-grid');
        var btn = document.querySelector('.toggle-gallery-btn');
        if (!grid || !btn) return;
        var isHidden = grid.style.display === 'none' || grid.style.display === '';
        grid.style.display = isHidden ? 'grid' : 'none';
        var textEl = btn.querySelector('.btn-text');
        if (textEl) textEl.textContent = isHidden ? 'Ocultar imágenes' : 'Mostrar imágenes';
        btn.classList.toggle('is-open', isHidden);
        btn.setAttribute('aria-expanded', String(isHidden));
    }
    (function(){
        var onReady = function(){
            var grid = document.getElementById('gallery-grid');
            var btn = document.querySelector('.toggle-gallery-btn');
            if (grid) grid.style.display = 'none';
            if (btn) btn.setAttribute('aria-expanded', 'false');
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', onReady); else onReady();
    })();
</script>
