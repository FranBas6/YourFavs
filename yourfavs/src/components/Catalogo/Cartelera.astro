---
import CardMovie from "../Cards/CardMovie.astro";
import {getNowPlayingMoviesInSpain} from "../../services/API/Movies/tmdbMovies";

// Obtener el parámetro de página desde la URL
const urlParams = new URL(Astro.request.url).searchParams;
const page = Number(urlParams.get('page') || 1);

// Cargar las películas y series para la página actual
const onAirMovies = await getNowPlayingMoviesInSpain({page: page.toString()});

// Total de páginas, puedes obtenerlo del API o mantenerlo como un valor estático
const totalPages = 3;

// Definir los géneros comunes
const genresMap: Record<number, string> = {
    28: "Acción",
    12: "Aventura",
    16: "Animación",
    35: "Comedia",
    80: "Crimen",
    99: "Documental",
    18: "Drama",
    10751: "Familia",
    14: "Fantasía",
    36: "Historia",
    27: "Terror",
    10402: "Música",
    9648: "Misterio",
    10749: "Romance",
    878: "Ciencia ficción",
    10770: "Película de TV",
    53: "Thriller",
    10752: "Bélica",
    37: "Western",
    10759: "Acción y Aventura",
    10762: "Infantil",
    10763: "Noticias",
    10764: "Reality",
    10765: "Sci-Fi y Fantasía",
    10766: "Soap",
    10767: "Talk",
    10768: "Guerra y Política"
};

function getGenreName(id: number): string {
    return genresMap[id] || "Otro";
}
---

<section class="min-h-screen ">
    <!-- Hero Section con mejor jerarquía visual -->

    <div class="relative container mx-auto px-4 text-center">
        <div class="inline-flex items-center gap-2 bg-coral-red/10 text-coral-red px-4 py-2 rounded-full text-sm font-medium mb-6">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            Actualizado diariamente
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight">
            <span class="text-coral-red">🎬 Cartelera</span>
            <br class="sm:hidden">
            <span class="relative">
                    en España
                    <div class="absolute -bottom-2 left-0 right-0 h-1 bg-gradient-to-r from-coral-red to-coral-red/60 rounded-full"></div>
                </span>
        </h1>

        <p class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto mb-8 leading-relaxed">
            Descubre las películas que están actualmente en los cines de España.
            <span class="text-coral-red font-medium">¡No te pierdas los últimos estrenos!</span>
        </p>

        <!-- Indicador de resultados -->
        <div class="inline-flex items-center gap-2 bg-white/80 backdrop-blur-sm border border-gray-200 px-4 py-2 rounded-full text-sm text-gray-600">
            <svg class="w-4 h-4 text-coral-red" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
            </svg>
            {onAirMovies.length} películas disponibles en esta página
        </div>
    </div>

    <div class="container mx-auto px-4 py-8">
        <!-- Paginación Mejorada para Móviles -->
        <nav aria-label="Paginación" class="flex items-center justify-center mb-8">
            <!-- En pantallas pequeñas (móviles) - Diseño vertical compacto -->
            <div class="flex flex-col w-full max-w-xs gap-2 p-2 bg-white rounded-lg shadow-md sm:hidden">
                <div class="flex justify-center items-center px-2 py-1">
                    <span class="font-medium text-gray-700 text-sm">Página</span>
                    <span class="mx-2 px-3 py-1 bg-coral-red text-white rounded-md font-bold text-sm">{page}</span>
                    <span class="font-medium text-gray-700 text-sm">de {totalPages}</span>
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <a href={`?page=${Math.max(1, page - 1)}`}
                       class={`px-3 py-2 rounded-lg transition-all duration-300 flex items-center justify-center text-sm ${page === 1 ? 'bg-gray-200 text-gray-500 cursor-not-allowed' : 'bg-blue-500 text-white hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500'}`}
                       aria-disabled={page === 1}>
                        <span class="mr-1">←</span> Anterior
                    </a>

                    <a href={`?page=${Math.min(totalPages, page + 1)}`}
                       class={`px-3 py-2 rounded-lg transition-all duration-300 flex items-center justify-center text-sm ${page === totalPages ? 'bg-gray-200 text-gray-500 cursor-not-allowed' : 'bg-blue-500 text-white hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500'}`}
                       aria-disabled={page === totalPages}>
                        Siguiente <span class="ml-1">→</span>
                    </a>
                </div>
            </div>

            <!-- En pantallas medianas y grandes - Diseño horizontal -->
            <div class="hidden sm:flex items-center space-x-2 bg-white p-2 rounded-lg shadow-md">
                <a href={`?page=${Math.max(1, page - 1)}`}
                   class={`px-4 py-2 rounded-lg transition-all duration-300 flex items-center ${page === 1 ? 'bg-gray-200 text-gray-500 cursor-not-allowed' : 'bg-blue-500 text-white hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500'}`}
                   aria-disabled={page === 1}>
                    <span class="mr-1">←</span> Anterior
                </a>

                <div class="flex items-center px-4">
                    <span class="font-medium text-gray-700">Página</span>
                    <span class="mx-2 px-3 py-1 bg-coral-red text-white rounded-md font-bold">{page}</span>
                    <span class="font-medium text-gray-700">de {totalPages}</span>
                </div>

                <a href={`?page=${Math.min(totalPages, page + 1)}`}
                   class={`px-4 py-2 rounded-lg transition-all duration-300 flex items-center ${page === totalPages ? 'bg-gray-200 text-gray-500 cursor-not-allowed' : 'bg-blue-500 text-white hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500'}`}
                   aria-disabled={page === totalPages}>
                    Siguiente <span class="ml-1">→</span>
                </a>
            </div>
        </nav>

        <!-- Grid de películas con mejor spacing y loading states -->
        <section class="mb-12">
            <div class="flex items-center gap-3 mb-6">
                <div class="flex items-center gap-2">
                    <div class="w-1 h-8 bg-coral-red rounded-full"></div>
                    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">
                        Películas en Cartelera
                    </h2>
                </div>
                <div class="hidden sm:block flex-1 h-px bg-gradient-to-r from-gray-200 to-transparent"></div>
            </div>

            {onAirMovies.length > 0 ? (
                    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 auto-rows-fr">
                        {onAirMovies.map((item, index) => (
                                <div class="movie-card group" style={`animation-delay: ${index * 50}ms`}>
                                    <CardMovie
                                            id={item.id.toString()}
                                            img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                            title={item.title}
                                            vote_average={item.vote_average}
                                            overview={item.overview}
                                            release_date={item.release_date}
                                            genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                    />
                                </div>
                        ))}
                    </div>
            ) : (
                    <div class="text-center py-12">
                        <div class="w-24 h-24 mx-auto mb-4 bg-gray-100 rounded-full flex items-center justify-center">
                            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2h4a1 1 0 110 2h-1v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6H3a1 1 0 110-2h4zM9 6v10a1 1 0 002 0V6h2v10a1 1 0 002 0V6h-6z"/>
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold text-gray-900 mb-2">No hay películas disponibles</h3>
                        <p class="text-gray-600">Intenta con otra página o vuelve más tarde.</p>
                    </div>
            )}
        </section>

        <!-- Y también en la paginación de abajo -->
        <div class="mt-12 flex justify-center">
            <div class="inline-flex rounded-md shadow-sm">

                {page > 2 && (
                        <a href={`?page=1&type=`}
                           class="px-3 py-2 bg-white text-gray-700 hover:bg-gray-50 border border-gray-300 rounded-l-lg">
                            1
                        </a>
                )}

                {page > 3 && (
                        <span class="px-3 py-2 bg-white text-gray-700 border-t border-b border-gray-300">...</span>
                )}

                {page > 1 && (
                        <a href={`?page=${page - 1}`}
                           class="px-3 py-2 bg-white text-gray-700 hover:bg-gray-50 border border-gray-300">
                            {page - 1}
                        </a>
                )}

                <a href={`?page=${page}`}
                   class="px-3 py-2 bg-coral-red text-white border border-coral-red">
                    {page}
                </a>

                {page < totalPages && (
                        <a href={`?page=${page + 1}`}
                           class="px-3 py-2 bg-white text-gray-700 hover:bg-gray-50 border border-gray-300">
                            {page + 1}
                        </a>
                )}

                {page < totalPages - 2 && (
                        <span class="px-3 py-2 bg-white text-gray-700 border-t border-b border-gray-300">...</span>
                )}

                {page < totalPages - 1 && (
                        <a href={`?page=${totalPages}`}
                           class="px-3 py-2 bg-white text-gray-700 hover:bg-gray-50 border border-gray-300 rounded-r-lg">
                            {totalPages}
                        </a>
                )}

            </div>
        </div>
    </div>
</section>

<style is:global>
    .text-coral-red {
        color: #E63946;
    }

    .bg-coral-red {
        background-color: #E63946;
    }

    .bg-coral-red\/10 {
        background-color: rgba(233, 57, 70, 0.1);
    }

    .bg-coral-red\/90 {
        background-color: rgba(233, 57, 70, 0.9);
    }

    /* Animaciones mejoradas para las cards */
    .movie-card {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeInUp 0.6s ease-out forwards;
        height: 100%;
    }

    @keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .movie-card:hover {
        transform: translateY(-8px);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .movie-card:hover::after {
        content: '';
        position: absolute;
        inset: 0;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
        border-radius: inherit;
        z-index: -1;
        opacity: 0;
        animation: shadowGrow 0.3s ease-out forwards;
    }

    @keyframes shadowGrow {
        to {
            opacity: 1;
        }
    }

    /* Asegurar consistencia en las cards */
    .movie-card > * {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .movie-card img {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
        border-radius: 0.75rem 0.75rem 0 0;
    }

    .movie-card h3,
    .movie-card h4 {
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.6em;
    }

    /* Mejor responsive */
    @media (max-width: 640px) {
        .movie-card {
            animation-delay: 0ms !important;
        }
    }

    @keyframes loading {
        0% {
            background-position: 200% 0;
        }
        100% {
            background-position: -200% 0;
        }
    }

    /* Smooth scroll mejorado */
    html {
        scroll-behavior: smooth;
    }

    @media (prefers-reduced-motion: reduce) {
        .movie-card {
            animation: none;
            opacity: 1;
            transform: none;
        }

        html {
            scroll-behavior: auto;
        }
    }
</style>