// Importaciones y configuración Firebase
import Layout from "../../layouts/Layout.astro";
import {
    getSeriesById,
    getSeriesCast,
    getSeriesDirectorsAndRoles,
    getSeriesTrailer,
    getSeriesStatus,
    getEpisodesBySeasonNumber,
    fetchAllSeriesPosters,
    getSerieRecommendationsOrSimilar,
    getSeriesAdditionalInfo
} from "../../services/API/Series/InfoSeries";
import type {SeriesFavs} from "../../services/BD/yourfavsSerie";
import {initializeApp} from "firebase/app";
import {
    getFirestore,
    collection,
    doc,
    getDoc,
    setDoc,
    deleteDoc,
    query,
    getDocs,
    orderBy,
    updateDoc
} from "firebase/firestore";

// Configuración de Firebase
import {firebaseConfig} from '../../utils/firebaseConfig';

// Initialize Firebase
const app = initializeApp(firebaseConfig);
// Initialize Cloud Firestore
const db = getFirestore(app);

const {id} = Astro.params; // Obtén el parámetro id de la URL

if (!id) {
    throw new Error("ID de la serie no encontrado en la URL");
}

// POST actualizado para Firebase con objetos estructurados según Props
if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        const serieId = String(formData.get('id') || formData.get('serie_id'));
        const action = String(formData.get('action'));
        const actionType = String(formData.get('actionType'));

        // Determinar la colección correcta
        let coleccion;
        switch (actionType) {
            case 'pendientes':
                coleccion = 'SeriesPendiente';
                break;
            case 'vistas':
                coleccion = 'SeriesVistas';
                break;
            case 'siguiendo':
                coleccion = 'SeriesSiguiendo';
                break;
            case 'liked':
                coleccion = 'LikedSeries';
                break;
            case 'favs':
                coleccion = 'SeriesFavs';
                break;
            case 'verpronto':
                coleccion = 'SeriesVerPronto';
                break;
            default:
                throw new Error(`Tipo de acción no válido: ${actionType}`);
        }

        // Referencia a la colección
        const coleccionRef = collection(db, coleccion);
        // Referencia al documento específico
        const docRef = doc(db, coleccion, serieId);

        // Verificar si la serie ya existe en la colección
        const docSnap = await getDoc(docRef);
        const serieExiste = docSnap.exists();

        // Add a parameter for custom position
        const customPosition = formData.get('custom_position') ? Number(formData.get('custom_position')) : null;

        // Manejar acciones de agregar y eliminar
        if (action === 'add' && !serieExiste) {
            // Parsear géneros como objetos
            const genres = JSON.parse(String(formData.get('genres') || '[]'));

            // Parsear temporadas como objetos
            const seasons = JSON.parse(String(formData.get('seasons') || '[]'));

            // Parsear último episodio emitido como objeto
            const lastEpisodeToAir = JSON.parse(String(formData.get('last_episode_to_air') || 'null'));

            // Parsear próximo episodio a emitir como objeto
            const nextEpisodeToAir = JSON.parse(String(formData.get('next_episode_to_air') || 'null'));

            // Preparar nueva entrada para la serie con estructura según Props
            const newEntry = {
                id: serieId,
                name: String(formData.get('name') || 'Sin nombre'),
                poster_path: String(formData.get('poster_path') || ''), // Cambiado de poster_path a img
                vote_average: Number(formData.get('vote_average') || 0),
                overview: String(formData.get('overview') || 'Sin descripción'),
                added_at: new Date(),
                // Almacenar como objetos estructurados
                genres: genres,
                first_air_date: String(formData.get('first_air_date') || ''),
                status: String(formData.get('status') || ''),
                seasons: seasons,
                last_episode_to_air: lastEpisodeToAir,
                next_episode_to_air: nextEpisodeToAir,
                position: 0,
            };

            // Manejo especial para favoritos para agregar posición
            if (coleccion === 'SeriesFavs') {
                // Obtener favoritos actuales ordenados por posición
                const favsQuery = query(collection(db, 'SeriesFavs'), orderBy('position'));
                const favsSnapshot = await getDocs(favsQuery);
                const currentFavorites: SeriesFavs[] = [];

                favsSnapshot.forEach((doc) => {
                    currentFavorites.push({id: doc.id, ...doc.data()} as SeriesFavs);
                });

                let newPosition;
                if (customPosition !== null) {
                    // Si se especifica una posición personalizada
                    // Desplazar series existentes para hacer espacio para la nueva
                    const seriesToUpdate = currentFavorites.filter(fav => fav.position >= customPosition);

                    // Actualizar posiciones en orden descendente para evitar conflictos
                    for (const fav of seriesToUpdate.sort((a, b) => b.position - a.position)) {
                        await updateDoc(doc(db, 'SeriesFavs', fav.id), {
                            position: fav.position + 1
                        });
                    }

                    newPosition = customPosition;
                } else {
                    // Si no hay posición personalizada, agregar al final
                    newPosition = currentFavorites.length > 0
                        ? Math.max(...currentFavorites.map(f => f.position || 0)) + 1
                        : 1;
                }

                newEntry.position = newPosition;
            }

            // Insertar nueva serie en Firestore
            await setDoc(docRef, newEntry);

        } else if (action === 'remove' && serieExiste) {
            // Eliminar serie de la colección seleccionada
            await deleteDoc(docRef);

            // Si se elimina de favoritos, reordenar los favoritos restantes
            if (coleccion === 'SeriesFavs') {
                // Obtener favoritos restantes ordenados por posición
                const favsQuery = query(collection(db, 'SeriesFavs'), orderBy('position'));
                const favsSnapshot = await getDocs(favsQuery);
                const remainingFavorites: SeriesFavs[] = [];

                favsSnapshot.forEach((doc) => {
                    remainingFavorites.push({id: doc.id, ...doc.data()} as SeriesFavs);
                });

                // Actualizar posiciones
                for (let i = 0; i < remainingFavorites.length; i++) {
                    await updateDoc(doc(db, 'SeriesFavs', remainingFavorites[i].id), {
                        position: i + 1
                    });
                }
            }
        }

        // Redireccionar de vuelta a la página de la serie
        return Astro.redirect(`/serie/${serieId}`);

    } catch (error) {
        console.error("Error en el procesamiento POST:", error);

        if (error instanceof Error) {
            throw new Error(`Error al procesar la solicitud: ${error.message}`);
        } else {
            throw new Error("Error al procesar la solicitud: error desconocido");
        }
    }

}

// Add a function to calculate episode runtime
function formatRuntime(minutes: number): string {
    if (!minutes) return "Duración no disponible";
    const hours = Math.floor(minutes / 60);
    const remainingMinutes = minutes % 60;
    return hours > 0 ? `${hours} hr ${remainingMinutes} min` : `${minutes} min`;
}

// Función para obtener estadísticas de temporada
function getSeasonStats(seasonNumber: number, seasonEpisodes: any[]) {
    if (!seasonEpisodes || seasonEpisodes.length === 0) {
        return {
            totalEpisodes: 0,
            averageRating: "0.0",
            averageRuntime: "No disponible"
        };
    }

    const totalEpisodes = seasonEpisodes.length;
    
    // Calcular rating promedio
    const ratingsSum = seasonEpisodes.reduce((sum, ep) => sum + (ep.vote_average || 0), 0);
    const averageRating = totalEpisodes > 0 ? (ratingsSum / totalEpisodes).toFixed(1) : "0.0";
    
    // Calcular duración promedio
    const runtimesSum = seasonEpisodes.reduce((sum, ep) => sum + (ep.runtime || 0), 0);
    const episodesWithRuntime = seasonEpisodes.filter(ep => ep.runtime && ep.runtime > 0);
    const averageRuntimeMinutes = episodesWithRuntime.length > 0 ? Math.round(runtimesSum / episodesWithRuntime.length) : 0;
    const averageRuntime = averageRuntimeMinutes > 0 ? formatRuntime(averageRuntimeMinutes) : "No disponible";

    return {
        totalEpisodes,
        averageRating,
        averageRuntime
    };
}

let item = await getSeriesById({id});
let cast = await getSeriesCast(id);
let directors = await getSeriesDirectorsAndRoles(id);
let trailerUrl = await getSeriesTrailer(id);
let status = await getSeriesStatus(id);
let title = item?.name || "Serie no encontrada"; // Valor por defecto

// Cliente data actualizado con la estructura de Props
const clientData = {
    id: String(item?.id || ''),
    name: item?.name || 'Sin nombre',
    img: item?.poster_path || '', // Cambiado a img manteniendo compatibilidad con poster_path
    vote_average: item?.vote_average ? Number(item.vote_average) : 0,
    overview: item?.overview || 'Sin descripción',
    first_air_date: item?.first_air_date || '',
    status: status || '',
    genres: item?.genres || [],
    seasons: item?.seasons || [],
    last_episode_to_air: item?.last_episode_to_air || null,
    next_episode_to_air: item?.next_episode_to_air || null
};

// Obtener episodios de TODAS las temporadas (incluyendo especiales)
const allSeasonEpisodes: { [key: number]: any[] } = {};
if (item?.seasons) {
    for (const season of item.seasons) {
        // Ahora incluimos TODAS las temporadas, incluyendo las especiales (season_number === 0)
        const episodes = await getEpisodesBySeasonNumber(id, season.season_number);
        allSeasonEpisodes[season.season_number] = episodes || [];
    }
}

// Separar temporadas regulares y especiales
const regularSeasons = item?.seasons?.filter(season => season.season_number > 0) || [];
const specialSeasons = item?.seasons?.filter(season => season.season_number === 0) || [];

// Calcular episodios por separado
const calculateRegularEpisodes = () => {
    return regularSeasons.reduce((total, season) => total + (season.episode_count || 0), 0);
};

const calculateSpecialEpisodes = () => {
    return specialSeasons.reduce((total, season) => total + (season.episode_count || 0), 0);
};

const totalRegularEpisodes = calculateRegularEpisodes();
const totalSpecialEpisodes = calculateSpecialEpisodes();
const totalEpisodes = totalRegularEpisodes + totalSpecialEpisodes; // Total completo para compatibilidad

// Verificar si la serie ya está en las diferentes bases de datos
const docRefFavs = doc(db, 'SeriesFavs', clientData.id);
const docRefPendientes = doc(db, 'SeriesPendiente', clientData.id);
const docRefVistas = doc(db, 'SeriesVistas', clientData.id);
const docRefSiguiendo = doc(db, 'SeriesSiguiendo', clientData.id);
const docRefLiked = doc(db, 'LikedSeries', clientData.id);
const docRefVerPronto = doc(db, 'SeriesVerPronto', clientData.id);

// Obtener los documentos en paralelo para mejor rendimiento
const [docSnapFavs, docSnapPendientes, docSnapVistas, docSnapSiguiendo, docSnapLiked, docSnapVerPronto] = await Promise.all([
    getDoc(docRefFavs),
    getDoc(docRefPendientes),
    getDoc(docRefVistas),
    getDoc(docRefSiguiendo),
    getDoc(docRefLiked),
    getDoc(docRefVerPronto)
]);

// Comprobar si existen los documentos
const existingInFavs = docSnapFavs.exists();
const existingInPendientes = docSnapPendientes.exists();
const existingInVistas = docSnapVistas.exists();
const existingInSiguiendo = docSnapSiguiendo.exists();
const existingInLiked = docSnapLiked.exists();
const existingInVerPronto = docSnapVerPronto.exists();

// Comprobar si la serie está en cada una de las colecciones
const isInFavorites = existingInFavs;
const isInPendientes = existingInPendientes;
const isInVistas = existingInVistas;
const isInSiguiendo = existingInSiguiendo;
const isInLiked = existingInLiked;
const isInVerPronto = existingInVerPronto;

// Formatear la fecha para mejor visualización
const formatDate = (dateString: string): string => {
    if (!dateString) return "No disponible";
    const date = new Date(dateString);
    return new Intl.DateTimeFormat('es-ES', {
        day: 'numeric',
        month: 'long',
        year: 'numeric'
    }).format(date);
};

// Calcular años en emisión
const calculateYearsActive = () => {
    if (!item?.first_air_date) return "Desconocido";

    const startYear = new Date(item.first_air_date).getFullYear();
    let endYear: string = "presente";

    if (status === "Ended" || status === "Canceled") {
        const lastAirDate = item?.last_episode_to_air?.air_date;
        endYear = lastAirDate
            ? String(new Date(lastAirDate).getFullYear())
            : "desconocido";
    }

    return `${startYear} - ${endYear}`;
};

