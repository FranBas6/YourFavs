                                                                        </div>
                                                                    </div>
                                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                                         class={`h-4 w-4 opacity-0 group-hover:opacity-100 transition-opacity ${season.season_number === 0 ? 'text-purple-500' : 'text-blue-500'}`}
                                                                         fill="none" viewBox="0 0 24 24"
                                                                         stroke="currentColor">
                                                                        <path stroke-linecap="round"
                                                                              stroke-linejoin="round" stroke-width="2"
                                                                              d="M9 5l7 7-7 7"/>
                                                                    </svg>
                                                                </div>
                                                            </summary>

                                                            <div class={`mt-2 px-3 py-2 rounded-lg ${season.season_number === 0 ? 'bg-purple-50' : 'bg-blue-50'}`}>
                                                                {episode.still_path && (
                                                                        <div class="w-full max-w-md mx-auto mb-3">
                                                                            <img
                                                                                    src={`https://image.tmdb.org/t/p/w500${episode.still_path}`}
                                                                                    alt={episode.name}
                                                                                    loading="lazy"
                                                                                    class="rounded-lg shadow-md w-full h-auto object-cover"
                                                                            />
                                                                        </div>
                                                                )}

                                                                <div class="text-sm text-gray-700 mb-3">
                                                                    {episode.overview || (season.season_number === 0
                                                                        ? "No hay descripción disponible para este episodio especial."
                                                                        : "No hay descripción disponible para este episodio.")}
                                                                </div>

                                                                {episode.guest_stars && episode.guest_stars.length > 0 && (
                                                                        <div class="mt-3">
                                                                            <h6 class={`text-sm font-semibold mb-2 ${season.season_number === 0 ? 'text-purple-700' : 'text-blue-700'}`}>
                                                                                Estrellas invitadas:
                                                                            </h6>
                                                                            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                                                                {episode.guest_stars.map((star: GuestStar) => (
                                                                                        <li class="flex items-center text-xs text-gray-600">
                                                                                            {star.profile_path && (
                                                                                                    <a href={`/actor/${star.id}`}
                                                                                                       class="shrink-0">
                                                                                                        <img
                                                                                                                src={`https://image.tmdb.org/t/p/w45${star.profile_path}`}
                                                                                                                alt={star.name}
                                                                                                                class="w-12 h-12 rounded-full mr-2 object-cover border border-gray-200"
                                                                                                                loading="lazy"
                                                                                                        />
                                                                                                    </a>
                                                                                            )}
                                                                                            <div>
                                                                                                <a
                                                                                                        href={`/actor/${star.id}`}
                                                                                                        class={`text-gray-800 font-semibold hover:underline transition duration-300 ${season.season_number === 0 ? 'hover:text-purple-600' : 'hover:text-blue-600'}`}
                                                                                                >
                                                                                                    {star.name}
                                                                                                </a>
                                                                                                <span class="block text-gray-500">{star.character}</span>
                                                                                            </div>
                                                                                        </li>
                                                                                ))}
                                                                            </ul>
                                                                        </div>
                                                                )}
                                                            </div>
                                                        </details>
                                                ))}

                                                {(!allSeasonEpisodes[season.season_number] || allSeasonEpisodes[season.season_number].length === 0) && (
                                                        <p class="text-gray-500 italic text-center p-4">
                                                            {season.season_number === 0 ?
                                                                "No hay información de episodios especiales disponible." :
                                                                "No hay información de episodios disponible para esta temporada."
                                                            }
                                                        </p>
                                                )}
                                            </div>
                                        </div>
                                    </details>
                                );
                            })}
                        </div>
                    </div>

                    <!-- Pósters -->
                    <div class="bg-white p-6 rounded-lg shadow-md mb-8">
                        <h2 class="text-2xl font-bold text-blue-600 mb-4">Pósters</h2>

                        {posters && posters.length > 0 ? (
                                <div class="carousel-container relative max-w-full overflow-hidden">
                                    <div class="carousel-track flex gap-4 overflow-x-auto pb-4 scrollbar-hide">
                                        {posters.slice(0, 40).map((poster, index) => (
                                                <>
                                                    <div class="carousel-slide flex-shrink-0 w-48">
                                                        <a href={`#poster-${index}`}>
                                                            <img
                                                                    src={poster.file_path}
                                                                    alt={`Póster ${poster.vote_average.toFixed(1)}/10`}
                                                                    loading="lazy"
                                                                    class="rounded-lg shadow-md w-full h-64 object-cover"
                                                            />
                                                        </a>
                                                    </div>

                                                    {/* Modal de imagen */}
                                                    <div id={`poster-${index}`} class="modal">
                                                        <a href="#" class="modal-close">&times;</a>
                                                        <img src={poster.file_path}
                                                             alt={`Póster ${poster.vote_average.toFixed(1)}/10`}/>
                                                    </div>
                                                </>
                                        ))}
                                    </div>
                                </div>
                        ) : (
                                <p class="text-gray-600 text-center">No se encontraron pósters para esta serie</p>
                        )}
                    </div>

                    <!-- Reparto y Equipo -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        {/* Reparto */}
                        <div class="bg-white p-6 rounded-lg shadow-md">
                            <h2 class="text-2xl font-bold text-blue-600 mb-4">Reparto Principal</h2>
                            <div class="text-gray-600">
                                {cast?.length > 0 ? (
                                        <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                                            {cast.map((actor) => (
                                                    <li class="border-b border-gray-100 pb-3 last:border-0">
                                                        <div class="flex gap-4 items-start">
                                                            {actor.profile_path ? (
                                                                    <a href={`/actor/${actor.id}`} class="shrink-0">
                                                                        <img
                                                                                src={`https://image.tmdb.org/t/p/w92${actor.profile_path}`}
                                                                                alt={actor.name}
                                                                                loading="lazy"
                                                                                class="w-16 h-16 rounded-full object-cover border border-gray-300 shadow-sm hover:brightness-110 transition"
                                                                        />
                                                                    </a>
                                                            ) : (
                                                                    <div class="w-16 h-16 rounded-full bg-gray-200 flex items-center justify-center text-gray-400 text-xs border border-gray-300">
                                                                        ?
                                                                    </div>
                                                            )}

                                                            <div class="flex flex-col">
                                                                <a
                                                                        href={`/actor/${actor.id}`}
                                                                        class="text-gray-800 font-semibold hover:text-blue-600 hover:underline transition duration-300"
                                                                >
                                                                    {actor.name}
                                                                </a>
                                                                {actor.character && (
                                                                        <span class="text-sm text-gray-500 mt-1">{actor.character}</span>
                                                                )}
                                                            </div>
                                                        </div>
                                                    </li>
                                            ))}
                                        </ul>
                                ) : (
                                        <p class="text-gray-500">Información no disponible</p>
                                )}
                            </div>
                        </div>

                        <!-- Equipo -->
                        <div class="bg-white p-6 rounded-lg shadow-md">
                            <h2 class="text-2xl font-bold text-blue-600 mb-4">Equipo de Producción</h2>
                            <div class="text-gray-600">
                                {directors?.length > 0 ? (
                                <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                                    {directors.map((member) => (
                                    <li class="p-3 rounded-lg border border-gray-100 hover:border-blue-200 hover:shadow-sm transition">
                                        <a
                                        href={`/team/${member.name}`}
                                        class="block text-gray-900 font-semibold hover:text-blue-600 transition"
                                        >
                                        {member.name}
                                        </a>
                                        <p class="text-sm text-gray-500">{member.job}</p>
                                    </li>
                                    ))}
                                </ul>
                                ) : (
                                <p class="text-gray-500">Información no disponible</p>
                                )}
                            </div>
                        </div>
                    </div>

                    <!-- Plataformas y Productoras en dos columnas -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Plataformas -->
                        {providerElements.length > 0 && (
                                <div class="bg-white p-6 rounded-lg shadow-md">
                                    <h2 class="text-2xl font-bold text-blue-600 mb-4">Disponible en</h2>
                                    <div class="space-y-4">
                                        {providersByType.flatrate && providersByType.flatrate.length > 0 && (
                                            <div>
                                                <h3 class="text-sm font-semibold text-gray-700 mb-2">Incluido con suscripción</h3>
                                                <div class="grid grid-cols-3 sm:grid-cols-3 gap-4">
                                                    {providersByType.flatrate.map((provider) => (
                                                        <div class="flex flex-col items-center">
                                                            {provider.logo ? (
                                                                provider.link ? (
                                                                    <a href={provider.link} target="_blank" rel="noopener noreferrer">
                                                                        <img src={provider.logo} alt={provider.name} loading="lazy" class="w-16 h-16 object-contain rounded-md mb-2 hover:scale-105 transition-all" />
                                                                    </a>
                                                                ) : (
                                                                    <img src={provider.logo} alt={provider.name} loading="lazy" class="w-16 h-16 object-contain rounded-md mb-2 hover:scale-105 transition-all" />
                                                                )
                                                            ) : (
                                                                <div class="w-16 h-16 bg-gray-200 rounded-md flex items-center justify-center mb-2">
                                                                    <span class="text-xs text-gray-500">Sin logo</span>
                                                                </div>
                                                            )}
                                                            <p class="text-xs text-center text-gray-600">{provider.name}</p>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        )}
                                        {providersByType.rent && providersByType.rent.length > 0 && (
                                            <div>
                                                <h3 class="text-sm font-semibold text-gray-700 mb-2">Alquiler</h3>
                                                <div class="grid grid-cols-3 sm:grid-cols-3 gap-4">
                                                    {providersByType.rent.map((provider) => (
                                                        <div class="flex flex-col items-center">
                                                            {provider.logo ? (
                                                                provider.link ? (
                                                                    <a href={provider.link} target="_blank" rel="noopener noreferrer">
                                                                        <img src={provider.logo} alt={provider.name} loading="lazy" class="w-16 h-16 object-contain rounded-md mb-2 hover:scale-105 transition-all" />
                                                                    </a>
                                                                ) : (
                                                                    <img src={provider.logo} alt={provider.name} loading="lazy" class="w-16 h-16 object-contain rounded-md mb-2 hover:scale-105 transition-all" />
                                                                )
                                                            ) : (
                                                                <div class="w-16 h-16 bg-gray-200 rounded-md flex items-center justify-center mb-2">
                                                                    <span class="text-xs text-gray-500">Sin logo</span>
                                                                </div>
                                                            )}
                                                            <p class="text-xs text-center text-gray-600">{provider.name}</p>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        )}
                                        {providersByType.buy && providersByType.buy.length > 0 && (
                                            <div>
                                                <h3 class="text-sm font-semibold text-gray-700 mb-2">Compra</h3>
                                                <div class="grid grid-cols-3 sm:grid-cols-3 gap-4">
                                                    {providersByType.buy.map((provider) => (
                                                        <div class="flex flex-col items-center">
                                                            {provider.logo ? (
                                                                provider.link ? (
                                                                    <a href={provider.link} target="_blank" rel="noopener noreferrer">
                                                                        <img src={provider.logo} alt={provider.name} loading="lazy" class="w-16 h-16 object-contain rounded-md mb-2 hover:scale-105 transition-all" />
                                                                    </a>
                                                                ) : (
                                                                    <img src={provider.logo} alt={provider.name} loading="lazy" class="w-16 h-16 object-contain rounded-md mb-2 hover:scale-105 transition-all" />
                                                                )
                                                            ) : (
                                                                <div class="w-16 h-16 bg-gray-200 rounded-md flex items-center justify-center mb-2">
                                                                    <span class="text-xs text-gray-500">Sin logo</span>
                                                                </div>
                                                            )}
                                                            <p class="text-xs text-center text-gray-600">{provider.name}</p>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        )}
                                    </div>
                                </div>
                        )}

                        <!-- Productoras -->
                        {item?.production_companies && item.production_companies.length > 0 && (
                        <div class="bg-white p-6 rounded-lg shadow-md">
                            <h2 class="text-2xl font-bold text-blue-600 mb-4">Productoras</h2>

                            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
                            {item.production_companies.map((company) => (
                                <a
                                href={`/productora/${company.name}`}
                                class="flex flex-col items-center group"
                                >
                                {company?.logo_path ? (
                                    <img
                                    src={`https://image.tmdb.org/t/p/w200${company.logo_path}`}
                                    alt={company.name}
                                    loading="lazy"
                                    class="w-20 h-20 object-contain rounded-md mb-2 transition-transform duration-200 group-hover:scale-110"
                                    />
                                ) : (
                                    <div class="w-20 h-20 bg-gray-200 rounded-md flex items-center justify-center mb-2 group-hover:bg-gray-300 transition-colors">
                                    <span class="text-xs text-gray-500">Sin logo</span>
                                    </div>
                                )}

                                <p class="text-sm text-center text-gray-600 group-hover:text-blue-600 font-medium transition-colors">
                                    {company.name}
                                </p>
                                </a>
                            ))}
                            </div>
                        </div>
                        )}
                    </div>

                    <!-- SERIES Recomendaciones -->
                    {seriesRecommendations && seriesRecommendations.length > 0 && (
                            <div class="bg-white p-6 rounded-lg shadow-md mb-8">
                                <div class="flex items-center justify-between mb-6">
                                    <h2 class="text-2xl font-bold text-blue-600">
                                        {seriesRecommendationType === 'similar' ? 'Series Similares' : 'Series Recomendadas'}
                                    </h2>
                                </div>

                                    <!-- Carousel de recomendaciones con scroll horizontal -->
                                    <div class="recommendations-carousel relative overflow-hidden">
                                        <!-- Contenedor de series -->
                                        <div class="recommendations-container flex gap-4 overflow-x-auto pb-4 px-2 scroll-smooth">
                                            {seriesRecommendations.map((serie, index) => (
                                                    <div class={`recommendation-card flex-shrink-0 w-48 group animate-fade-in-up`}
                                                         style={`animation-delay: ${(index % 6 + 1) * 0.1}s`}>
                                                        <a href={`/serie/${serie.id}`} class="block">
                                                            <div class="relative overflow-hidden rounded-lg shadow-md hover:shadow-xl transition-all duration-300 group-hover:-translate-y-2">
                                                                <!-- Imagen de la serie -->
                                                                <div class="relative aspect-[2/3] overflow-hidden">
                                                                    <img
                                                                            src={serie.poster_path}
                                                                            alt={serie.name}
                                                                            loading="lazy"
                                                                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                                                                    />

                                                                    <!-- Overlay con gradiente -->
                                                                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

                                                                    <!-- Rating badge -->
                                                                    <div class="absolute top-2 right-2 bg-black/70 text-white text-xs px-2 py-1 rounded-full backdrop-blur-sm">
                                                                        ⭐ {serie.vote_average.toFixed(1)}
                                                                    </div>

                                                                    <!-- Botón de play overlay -->
                                                                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                                                        <div class="bg-white/90 rounded-full p-3 shadow-lg transform scale-0 group-hover:scale-100 transition-transform duration-300">
                                                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                                                 class="h-6 w-6 text-blue-600"
                                                                                 fill="currentColor"
                                                                                 viewBox="0 0 24 24">
                                                                                <path d="M8 5v14l11-7z"/>
                                                                            </svg>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <!-- Información de la película -->
                                                                <div class="p-4 bg-white h-32 flex flex-col justify-between">
                                                                    <div>
                                                                        <h3 class="font-semibold text-gray-800 text-sm line-clamp-2 group-hover:text-blue-600 transition-colors duration-300">
                                                                            {serie.name}
                                                                        </h3>
                                                                    </div>

                                                                    <div class="mt-auto">
                                                                        <div class="flex items-center justify-between">
                                                                            <span class="text-xs text-gray-500">
                                                                                {serie.first_air_date ? new Date(serie.first_air_date).getFullYear() : 'Próximamente'}
                                                                                </span>
                                                                            <div class="flex items-center gap-1">
                                                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                                                     class="h-3 w-3 text-yellow-400"
                                                                                     fill="currentColor"
                                                                                     viewBox="0 0 20 20">
                                                                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                                                                </svg>
                                                                                <span class="text-xs text-gray-600 font-medium">
                                                                                    {serie.vote_average.toFixed(1)}
                                                                                </span>
                                                                            </div>
                                                                        </div>

                                                                        <!-- Sinopsis corta - ahora siempre visible pero con altura fija -->
                                                                        <div class="mt-2 h-9 overflow-hidden">
                                                                            {serie.overview && (
                                                                                    <p class="text-xs text-gray-600 line-clamp-3 opacity-70 group-hover:opacity-100 transition-opacity duration-300">
                                                                                        {serie.overview.slice(0, 100)}...
                                                                                    </p>
                                                                            )}
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </a>
                                                    </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                        )}
                    </div>
                </div>
            </div>
        </div>
    </article>
</Layout>

<script is:inline src="/js/optimistic-actions.js"></script>
