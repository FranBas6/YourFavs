---
import Layout from "../../layouts/Layout.astro"
import CardSerie from "../../components/Cards/CardSerie.astro";
import {getSeriesSiguiendo, getWatchedProgressBatch} from "../../services/BD/series/yourfavsSerie";
import {fetchSerieDetails} from "../../services/API/Series/tmdbSeries";
import {getGenreName} from "../../utils/constants/genres";
import {buildUrl} from "../../utils/buildUrl";
import {posterUrl} from "../../services/API/shared/tmdbClient";
import {processBatch} from "../../utils/processBatch";
import PersonalNav from "../../components/personal/PersonalNav.astro";
import EmptyState from "../../components/EmptyState.astro";
import type {Serie} from "../../types/ApiSerie";
import type {SeriesInterface} from "../../types/DbSerie";
import '../../styles/pages/personal/personal.css';

let seriesSiguiendo: Serie[] = [];
let errorMessage = "";

try {
    const seriesSiguiendoIds = (await getSeriesSiguiendo()).map((s: SeriesInterface) => s.id);

    const rawResults = await processBatch(seriesSiguiendoIds, (id: string) => fetchSerieDetails(id), 10);
    seriesSiguiendo = (rawResults as (Serie | null)[]).filter((s): s is Serie => s !== null);

    seriesSiguiendo.sort((a, b) => {
        const dateA = a.last_episode_to_air?.air_date;
        const dateB = b.last_episode_to_air?.air_date;

        if (!dateA) return 1;
        if (!dateB) return -1;

        return new Date(dateB).getTime() - new Date(dateA).getTime();
    });
} catch (error) {
    console.error("Error al cargar series que sigues:", error);
    errorMessage = error instanceof Error ? error.message : "Error desconocido al cargar datos";
}

const watchedMap = await getWatchedProgressBatch(seriesSiguiendo.map((s: any) => String(s.id)));

const searchQuery = Astro.url.searchParams.get("search") || "";
const seriesPage = parseInt(Astro.url.searchParams.get("seriesPage") || "1");
const ITEMS_PER_PAGE = 20;

// Filtrar por búsqueda
const searchLower = searchQuery.toLowerCase();
let filteredSeries = seriesSiguiendo;

if (searchQuery) {
    filteredSeries = filteredSeries.filter((s: any) => s.name?.toLowerCase().includes(searchLower));
}

const seriesItemsToShow = seriesPage * ITEMS_PER_PAGE;
const seriesPaginadas = filteredSeries.slice(0, seriesItemsToShow);
const hasMoreSeries = filteredSeries.length > seriesItemsToShow;

// C13 — A un paso de terminar: faltan 1-2 episodios y la serie no ha acabado
function totalRegularEpisodes(s: any): number {
    return (s.seasons || []).filter((sn: any) => sn.season_number > 0).reduce((sum: number, sn: any) => sum + (sn.episode_count || 0), 0);
}
const almostDone = seriesSiguiendo
    .map(s => {
        const total = totalRegularEpisodes(s);
        const watched = watchedMap[String(s.id)]?.watched ?? 0;
        const remaining = total - watched;
        return { serie: s, total, watched, remaining };
    })
    .filter(x =>
        x.total > 0 &&
        x.watched > 0 &&
        x.remaining >= 1 &&
        x.remaining <= 2
    )
    .sort((a, b) => a.remaining - b.remaining);

// C26 — A un paso de terminar la temporada activa
// Detecta la temporada en curso (parcialmente vista) y, si quedan 1-2 eps, entra.
// Devuelve null si la serie no aplica o si ya está cubierta por C13.
type SeasonRef = { season_number: number; episode_count: number };
type AlmostDoneSeason = {
    serie: Serie;
    seasonNumber: number;
    watched: number;
    total: number;
    remaining: number;
};

const almostDoneIds = new Set(almostDone.map(x => String(x.serie.id)));

function findAlmostDoneSeason(s: Serie, bySeasons: Record<number, number>): AlmostDoneSeason | null {
    const seasons = ((s.seasons || []) as SeasonRef[])
        .filter(sn => sn.season_number > 0 && sn.episode_count > 0)
        .sort((a, b) => a.season_number - b.season_number);
    const active = seasons.find(sn => {
        const w = bySeasons[sn.season_number] || 0;
        return w > 0 && w < sn.episode_count;
    });
    if (!active) return null;
    const watched = bySeasons[active.season_number] || 0;
    const remaining = active.episode_count - watched;
    if (remaining < 1 || remaining > 2) return null;
    return { serie: s, seasonNumber: active.season_number, watched, total: active.episode_count, remaining };
}

const almostDoneSeason: AlmostDoneSeason[] = seriesSiguiendo
    .filter(s => !almostDoneIds.has(String(s.id))) // C13 gana si ambas aplican
    .map(s => {
        const bySeasons = watchedMap[String(s.id)]?.bySeasons || {};
        return findAlmostDoneSeason(s, bySeasons);
    })
    .filter((x): x is AlmostDoneSeason => x !== null)
    .sort((a, b) => a.remaining - b.remaining);

// C14 — Series abandonadas: en emisión, con progreso, último visto > 6 meses
type Abandoned = { serie: Serie; lastWatchedAt: number; watched: number; lastSeason: number };
const SIX_MONTHS_MS = 6 * 30 * 24 * 60 * 60 * 1000;
const abandonedCutoff = Date.now() - SIX_MONTHS_MS;
const almostDoneSeasonIds = new Set(almostDoneSeason.map(x => String(x.serie.id)));

const abandonadas: Abandoned[] = seriesSiguiendo
    .filter(s => {
        const id = String(s.id);
        if (almostDoneIds.has(id) || almostDoneSeasonIds.has(id)) return false;
        if (s.status === 'Ended' || s.status === 'Canceled') return false;
        const w = watchedMap[id];
        if (!w || !w.lastWatchedAt) return false;
        return w.watched > 0 && w.lastWatchedAt < abandonedCutoff;
    })
    .map(s => {
        const w = watchedMap[String(s.id)]!;
        const seasonsWatched = Object.keys(w.bySeasons || {}).map(Number);
        const lastSeason = seasonsWatched.length > 0 ? Math.max(...seasonsWatched) : 1;
        return { serie: s, lastWatchedAt: w.lastWatchedAt!, watched: w.watched, lastSeason };
    })
    .sort((a, b) => a.lastWatchedAt - b.lastWatchedAt) // más antiguas primero
    .slice(0, 5);

function monthsAgo(timestamp: number): string {
    const months = Math.floor((Date.now() - timestamp) / (30 * 24 * 60 * 60 * 1000));
    if (months < 12) return `hace ${months} meses`;
    const years = Math.floor(months / 12);
    return years === 1 ? 'hace 1 año' : `hace ${years} años`;
}

const pageUrl = Astro.url;
---
<Layout title="Siguiendo">
    <section class="px-1 sm:py-8">
        {errorMessage && (
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm mb-6">
                {errorMessage}
            </div>
        )}

        <header class="mb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Siguiendo</h1>
            <p class="text-gray-500 text-base">Series que estás siguiendo</p>
        </header>

        <div class="mb-6">
            <PersonalNav currentPage="/personal/siguiendo" />
        </div>

        {searchQuery && (
            <div class="mb-4 text-sm text-gray-500">
                Buscando: <span class="font-medium text-gray-700">"{searchQuery}"</span>
                <a href={pageUrl.pathname} class="ml-2 text-blue-500 hover:underline">Limpiar</a>
            </div>
        )}

        <div class="space-y-10">
            {/* C13 + C26 — A un paso de terminar (carrusel horizontal) */}
            {!searchQuery && (almostDone.length + almostDoneSeason.length) > 0 && (
                <section class="scroll-mt-20">
                    <div class="flex items-center justify-between mb-3">
                        <h2 class="text-xl font-semibold text-gray-800 flex items-center gap-2">
                            <span class="w-1 h-6 bg-emerald-500 rounded-full"></span>
                            A un paso de terminar
                            <span class="text-sm font-normal text-gray-400">({almostDone.length + almostDoneSeason.length})</span>
                        </h2>
                    </div>
                    <div class="flex gap-3 overflow-x-auto pb-3 -mx-1 px-1 snap-x snap-mandatory almost-done-scroll">
                        {almostDone.map(({ serie, total, watched, remaining }) => (
                            <a href={`/serie/${serie.id}`} class="snap-start group flex items-center gap-3 bg-white rounded-xl p-3 border border-emerald-200 hover:border-emerald-400 hover:shadow-md transition w-72 flex-shrink-0">
                                {serie.poster_path ? (
                                    <img src={posterUrl(serie.poster_path, 'w154')} alt={serie.name} class="w-12 h-16 object-cover rounded flex-shrink-0" loading="lazy"/>
                                ) : (
                                    <div class="w-12 h-16 bg-gray-100 rounded flex-shrink-0"></div>
                                )}
                                <div class="flex-1 min-w-0">
                                    <div class="text-sm font-semibold text-gray-900 truncate group-hover:text-emerald-700 transition">{serie.name}</div>
                                    <div class="mt-1 flex items-center gap-2">
                                        <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-medium whitespace-nowrap">
                                            Final · {remaining === 1 ? '1 ep' : '2 eps'}
                                        </span>
                                        <span class="text-xs text-gray-500">{watched}/{total}</span>
                                    </div>
                                </div>
                            </a>
                        ))}
                        {almostDoneSeason.map(({ serie, seasonNumber, watched, total, remaining }) => (
                            <a href={`/serie/${serie.id}#season-${seasonNumber}`} class="snap-start group flex items-center gap-3 bg-white rounded-xl p-3 border border-violet-200 hover:border-violet-400 hover:shadow-md transition w-72 flex-shrink-0">
                                {serie.poster_path ? (
                                    <img src={posterUrl(serie.poster_path, 'w154')} alt={serie.name} class="w-12 h-16 object-cover rounded flex-shrink-0" loading="lazy"/>
                                ) : (
                                    <div class="w-12 h-16 bg-gray-100 rounded flex-shrink-0"></div>
                                )}
                                <div class="flex-1 min-w-0">
                                    <div class="text-sm font-semibold text-gray-900 truncate group-hover:text-violet-700 transition">{serie.name}</div>
                                    <div class="mt-1 flex items-center gap-2">
                                        <span class="text-xs px-2 py-0.5 rounded-full bg-violet-50 text-violet-700 font-medium whitespace-nowrap">
                                            T{seasonNumber} · {remaining === 1 ? '1 ep' : '2 eps'}
                                        </span>
                                        <span class="text-xs text-gray-500">{watched}/{total}</span>
                                    </div>
                                </div>
                            </a>
                        ))}
                    </div>
                </section>
            )}

            {/* C14 — Series abandonadas */}
            {!searchQuery && abandonadas.length > 0 && (
                <details class="group bg-amber-50/40 rounded-xl border border-amber-200">
                    <summary class="flex items-center justify-between gap-3 p-4 cursor-pointer">
                        <h2 class="text-xl font-semibold text-gray-800 flex items-center gap-2">
                            <span class="w-1 h-6 bg-amber-500 rounded-full"></span>
                            Series abandonadas
                            <span class="text-sm font-normal text-gray-400">({abandonadas.length})</span>
                        </h2>
                        <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </summary>
                    <div class="px-4 pb-4 grid gap-3 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
                        {abandonadas.map(({ serie, lastWatchedAt, watched, lastSeason }) => (
                            <a href={`/serie/${serie.id}#season-${lastSeason}`} class="group/item flex items-center gap-3 bg-white rounded-xl p-3 border border-amber-200 hover:border-amber-400 hover:shadow-md transition">
                                {serie.poster_path ? (
                                    <img src={posterUrl(serie.poster_path, 'w154')} alt={serie.name} class="w-12 h-16 object-cover rounded flex-shrink-0" loading="lazy"/>
                                ) : (
                                    <div class="w-12 h-16 bg-gray-100 rounded flex-shrink-0"></div>
                                )}
                                <div class="flex-1 min-w-0">
                                    <div class="text-sm font-semibold text-gray-900 truncate group-hover/item:text-amber-700 transition">{serie.name}</div>
                                    <div class="mt-1 flex items-center gap-2 flex-wrap">
                                        <span class="text-xs px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 font-medium whitespace-nowrap">
                                            Retomar T{lastSeason}
                                        </span>
                                        <span class="text-xs text-gray-500">{watched} eps · {monthsAgo(lastWatchedAt)}</span>
                                    </div>
                                </div>
                            </a>
                        ))}
                    </div>
                </details>
            )}

            {/* Series */}
            <section id="series-section" class="scroll-mt-20">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-xl font-semibold text-gray-800 flex items-center gap-2">
                        <span class="w-1 h-6 bg-blue-500 rounded-full"></span>
                        Series
                        <span class="text-sm font-normal text-gray-4000">({filteredSeries.length})</span>
                    </h2>
                </div>

                {seriesPaginadas.length === 0 && (
                    <EmptyState size="sm" title="Aún no tienes series en esta colección">
                        <a slot="cta" href="/catalogo/tendencias" class="inline-flex items-center gap-2 px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors text-sm font-medium">Explorar tendencias</a>
                    </EmptyState>
                )}
                {seriesPaginadas.length > 0 && (
                    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                        {seriesPaginadas.map((item) => (
                            <CardSerie
                                id={item.id.toString()}
                                img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                name={item.name}
                                vote_average={item.vote_average}
                                overview={item.overview}
                                first_air_date={item.first_air_date}
                                seasons={item.seasons}
                                last_episode_to_air={item.last_episode_to_air}
                                next_episode_to_air={item.next_episode_to_air}
                                genres={item.genre_ids?.map((gId: number) => ({ id: gId, name: getGenreName(gId) }))}
                                status={item.status}
                                watchedEpisodes={watchedMap[String(item.id)]?.watched}
                            />
                        ))}
                    </div>
                )}
                {hasMoreSeries && (
                    <div class="flex justify-center mt-6">
                        <a href={buildUrl(pageUrl, {
                                search: searchQuery,
                                seriesPage: Math.ceil(filteredSeries.length / ITEMS_PER_PAGE).toString()
                            }) + '#series-section'}
                           class="flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 shadow-sm hover:shadow-md transition-all">
                            Mostrar {filteredSeries.length - seriesItemsToShow} series más
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </a>
                    </div>
                )}
            </section>
        </div>
    </section>
</Layout>
