---
/**
 * «Para ti» en la portada: recomendaciones con su motivo («Porque viste X»). Sistema v2 (Fase 3):
 * SectionHeader + Row + TitleCard (antes, una fila propia con tarjetas y píldoras PELÍCULA/SERIE).
 */
import { posterUrl } from "../../services/API/shared/tmdbClient";
import type { ForYouItem } from "../../services/API/shared/forYouRecommendations";
import SectionHeader from "../SectionHeader.astro";
import Row from "../Row.astro";
import TitleCard from "../Cards/TitleCard.astro";

interface Props {
    items: ForYouItem[];
}

const { items } = Astro.props;
---
{items.length > 0 && (
    <section class="for-you-section yf-row">
        <SectionHeader title="Para ti" icon="sparkles" color="purple" link="/mislistas/recomendaciones" railId="rail-para-ti" />
        <Row id="rail-para-ti" label="Para ti" moreHref="/mislistas/recomendaciones">
            {items.map((item) => (
                <TitleCard
                    mediaType={item.kind === 'movie' ? 'movie' : 'tv'}
                    id={String(item.id)}
                    title={item.title}
                    img={posterUrl(item.poster_path) || '/placeholder.jpg'}
                    vote_average={item.vote_average}
                    date={item.date}
                    seedTitle={item.seedTitle}
                    context="home"
                />
            ))}
        </Row>
    </section>
)}
