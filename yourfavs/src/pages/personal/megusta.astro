---
import Layout from "../../layouts/Layout.astro"
import CardSerie from "../../components/Cards/CardSerie.astro";
import CardMovie from "../../components/Cards/CardMovie.astro";
import {getLikedSeries} from "../../services/BD/series/yourfavsSerie";
import {getLikedMovies} from "../../services/BD/movies/yourfavsMovie";
import {fetchSerieDetails} from "../../services/API/Series/tmdbSeries";
import {fetchMovieDetails} from "../../services/API/Movies/tmdbMovies";
import {getGenreName} from "../../utils/constants/genres";
import {processBatch} from "../../utils/processBatch";
import {calculateStats} from "../../utils/calculateStats";
import {buildUrl} from "../../utils/buildUrl";
import {posterUrl} from "../../services/API/shared/tmdbClient";
import StatsPanel from "../../components/personal/StatsPanel.astro";
import PersonalNav from "../../components/personal/PersonalNav.astro";
import PersonalFilter from "../../components/personal/PersonalFilter.astro";
import '../../styles/pages/personal/personal.css';
let likedSeries: any[] = [];
let likedMovies: any[] = [];
let errorMessage = "";

let seriesData: any[] = [];
let moviesData: any[] = [];

const filter = Astro.url.searchParams.get("filter") || "todos";
const searchQuery = Astro.url.searchParams.get("search") || "";
const genreFilter = Astro.url.searchParams.get("genre") || "";
const showSeries = filter === "series" || filter === "todos";
const showMovies = filter === "peliculas" || filter === "todos";
const showAll = filter === "todos";

const seriesPage = parseInt(Astro.url.searchParams.get("seriesPage") || "1");
const moviesPage = parseInt(Astro.url.searchParams.get("moviesPage") || "1");
const ITEMS_PER_PAGE = 20;

try {
    [seriesData, moviesData] = await Promise.all([
        getLikedSeries(),
        getLikedMovies()
    ]);

    const [seriesResults, moviesResults] = await Promise.all([
        processBatch(seriesData.map(s => s.id), (id) => fetchSerieDetails(id), 10),
        processBatch(moviesData.map(m => m.id), (id) => fetchMovieDetails(id), 10)
    ]);

    likedSeries = seriesResults.filter(s => s !== null);
    likedMovies = moviesResults.filter(m => m !== null);
} catch (error) {
    console.error("Error al cargar contenido que te gusta:", error);
    errorMessage = error instanceof Error ? error.message : "Error desconocido al cargar datos";
}

// Extraer géneros disponibles de la colección
const genreSet = new Set<string>();
[...likedSeries, ...likedMovies].forEach((item: any) => {
    const genres = item.genres || item.genre_ids?.map((id: number) => ({ name: getGenreName(id) })) || [];
    genres.forEach((g: any) => { if (g.name) genreSet.add(g.name); });
});
const availableGenres = Array.from(genreSet).sort();

// Filtrar por búsqueda y género
const searchLower = searchQuery.toLowerCase();
let filteredSeries = likedSeries;
let filteredMovies = likedMovies;

if (searchQuery) {
    filteredSeries = filteredSeries.filter((s: any) => s.name?.toLowerCase().includes(searchLower));
    filteredMovies = filteredMovies.filter((m: any) => m.title?.toLowerCase().includes(searchLower));
}

if (genreFilter) {
    const matchesGenre = (item: any) => {
        const genres = item.genres || item.genre_ids?.map((id: number) => ({ name: getGenreName(id) })) || [];
        return genres.some((g: any) => g.name === genreFilter);
    };
    filteredSeries = filteredSeries.filter(matchesGenre);
    filteredMovies = filteredMovies.filter(matchesGenre);
}

const seriesItemsToShow = seriesPage * ITEMS_PER_PAGE;
const moviesItemsToShow = moviesPage * ITEMS_PER_PAGE;

const seriesPaginadas = filteredSeries.slice(0, seriesItemsToShow);
const peliculasPaginadas = filteredMovies.slice(0, moviesItemsToShow);

const hasMoreSeries = filteredSeries.length > seriesItemsToShow;
const hasMoreMovies = filteredMovies.length > moviesItemsToShow;

const pageUrl = Astro.url;

const stats = calculateStats({
    seriesData,
    moviesData,
    seriesDetails: likedSeries,
    moviesDetails: likedMovies,
});
---
<Layout title="Me Gusta">
    <section class="px-1 sm:py-8">
        {errorMessage && (
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm mb-6">
                {errorMessage}
            </div>
        )}

        <header class="mb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Me gusta</h1>
            <p class="text-gray-500 text-base">Contenido que te ha gustado</p>
        </header>

        <div class="flex items-start gap-3 mb-6">
            <div class="flex-1 min-w-0">
                <PersonalNav currentPage="/personal/megusta" />
            </div>
            <PersonalFilter pageUrl={pageUrl} filter={filter} searchQuery={searchQuery} genreFilter={genreFilter} availableGenres={availableGenres} />
        </div>
        <StatsPanel stats={stats} />

        <div class="space-y-10">
            {/* Series */}
            {(showSeries || showAll) && (
                <section id="series-section" class="scroll-mt-20">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-xl font-semibold text-gray-800 flex items-center gap-2">
                            <span class="w-1 h-6 bg-blue-500 rounded-full"></span>
                            Series
                            <span class="text-sm font-normal text-gray-400">({filteredSeries.length})</span>
                        </h2>
                    </div>

                    {seriesPaginadas.length === 0 && (
                        <div class="text-center py-10 text-gray-400">
                            <p>Aún no tienes series en esta colección</p>
                        </div>
                    )}
                    {seriesPaginadas.length > 0 && (
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                            {seriesPaginadas.map((item) => (
                                <CardSerie
                                    id={item.id.toString()}
                                    img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                    name={item.name}
                                    vote_average={item.vote_average}
                                    overview={item.overview}
                                    first_air_date={item.first_air_date}
                                    seasons={item.seasons}
                                    last_episode_to_air={item.last_episode_to_air}
                                    next_episode_to_air={item.next_episode_to_air}
                                    genres={item.genre_ids?.map((gId: number) => ({ id: gId, name: getGenreName(gId) }))}
                                    status={item.status}
                                />
                            ))}
                        </div>
                    )}
                    {hasMoreSeries && (
                        <div class="flex justify-center mt-6">
                            <a href={buildUrl(pageUrl, {
                                    filter: filter, search: searchQuery, genre: genreFilter,
                                    seriesPage: Math.ceil(filteredSeries.length / ITEMS_PER_PAGE).toString(),
                                    moviesPage: moviesPage.toString()
                                }) + '#series-section'}
                               class="flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 shadow-sm hover:shadow-md transition-all">
                                Mostrar {filteredSeries.length - seriesItemsToShow} series más
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                                </svg>
                            </a>
                        </div>
                    )}
                </section>
            )}

            {/* Películas */}
            {(showMovies || showAll) && (
                <section id="movies-section" class="scroll-mt-20">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-xl font-semibold text-gray-800 flex items-center gap-2">
                            <span class="w-1 h-6 bg-red-500 rounded-full"></span>
                            Películas
                            <span class="text-sm font-normal text-gray-400">({filteredMovies.length})</span>
                        </h2>
                    </div>

                    {peliculasPaginadas.length === 0 && (
                        <div class="text-center py-10 text-gray-400">
                            <p>Aún no tienes películas en esta colección</p>
                        </div>
                    )}
                    {peliculasPaginadas.length > 0 && (
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                            {peliculasPaginadas.map((item) => (
                                <CardMovie
                                    id={item.id.toString()}
                                    img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                    title={item.title}
                                    vote_average={item.vote_average}
                                    overview={item.overview}
                                    release_date={item.release_date}
                                    genres={item.genre_ids?.map((gId: number) => ({ id: gId, name: getGenreName(gId) }))}
                                />
                            ))}
                        </div>
                    )}
                    {hasMoreMovies && (
                        <div class="flex justify-center mt-6">
                            <a href={buildUrl(pageUrl, {
                                    filter: filter, search: searchQuery, genre: genreFilter,
                                    seriesPage: seriesPage.toString(),
                                    moviesPage: Math.ceil(filteredMovies.length / ITEMS_PER_PAGE).toString()
                                }) + '#movies-section'}
                               class="flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-medium text-white bg-red-600 hover:bg-red-700 shadow-sm hover:shadow-md transition-all">
                                Mostrar {filteredMovies.length - moviesItemsToShow} películas más
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                                </svg>
                            </a>
                        </div>
                    )}
                </section>
            )}
        </div>
    </section>
</Layout>
