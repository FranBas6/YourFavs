---
import { posterUrl } from "../../services/API/shared/tmdbClient";

interface CastMember {
    id: number;
    name: string;
    character?: string;
    profile_path?: string | null;
    /** Solo series (E6): episodios en los que sale. */
    episodes?: number;
}

interface Props {
    cast: CastMember[];
    title?: string;
    /** actor id → nº de títulos tuyos con esa persona (3.4). Solo si la caché está caliente. */
    seenWith?: Map<number, number>;
}

const { cast, title = "Reparto", seenWith } = Astro.props;
// Rediseño 4.5: 12 a la vista; el resto, en la misma rejilla, se muestra con «Ver todo el reparto» (CSS, sin JS).
const SHOWN = cast.length <= 15 ? cast.length : 12; // plegar 1–3 no compensa
---
{cast.length > 0 && (
    <section>
        <div class="fsec-h"><h2>{title}</h2><span class="n">{cast.length > SHOWN ? `${SHOWN} de ${cast.length}` : cast.length}</span></div>
        {/* Piel v2 (4.8): foto cuadrada sin caja, nombre y personaje (README del handoff, `.fper`). */}
        <div class="fcast">
            {cast.map((actor, i) => (
                <a href={`/actor/${actor.id}`} class:list={['fper', { 'cg-x': i >= SHOWN }]}>
                    {actor.profile_path
                        ? <img src={posterUrl(actor.profile_path, 'w185')} alt="" class="fper-av" loading="lazy" />
                        : <span class="fper-av fper-ini" aria-hidden="true">{actor.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}</span>}
                    <b>{actor.name}</b>
                    {actor.character && <span>{actor.character}</span>}
                    {actor.episodes ? <span>{`${actor.episodes} ${actor.episodes === 1 ? 'episodio' : 'episodios'}`}</span> : null}
                    {seenWith && seenWith.get(actor.id) ? (
                        <span class="fper-lib" title={`Has visto ${seenWith.get(actor.id)} ${seenWith.get(actor.id) === 1 ? 'título' : 'títulos'} con ${actor.name}`}>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                            {seenWith.get(actor.id)} en tu biblioteca
                        </span>
                    ) : null}
                </a>
            ))}
        </div>
        {cast.length - SHOWN > 0 && (
            <details class="cg-more group mt-4">
                <summary class="cg-more-btn">
                    <span class="group-open:hidden">Ver todo el reparto · {cast.length}</span>
                    <span class="hidden group-open:inline">Ver menos</span>
                    <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
            </details>
        )}
    </section>
)}
