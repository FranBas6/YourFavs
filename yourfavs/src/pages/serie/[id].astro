---
import Layout from "../../layouts/Layout.astro";
import {
    getLanguageDisplayName, getContentRating,
    formatDate, getRatingStars, formatTrailerUrl, providerLinks
} from "../../utils/constants/helpers/media-helpers";
import {formatRuntime, getSeasonStats} from "../../utils/constants/helpers/serie-helpers";
import type { GuestStar } from "../../types/Media";
import {handleSerieFavAction} from "../../services/BD/series/yourfavsSerie";
import '../../styles/pages/serie/serie.css';
import {
    getSeriesById, getSeriesCast, getSeriesDirectorsAndRoles,
    getSeriesTrailer, getSeriesStatus, getEpisodesBySeasonNumber,
    fetchAllSeriesPosters, getSerieRecommendationsOrSimilar, getSeriesAdditionalInfo,
    getSeriesVideos
} from "../../services/API/Series/InfoSeries";
import {initializeApp} from "firebase/app";
import {getFirestore, doc, getDoc} from "firebase/firestore";
import {firebaseConfig} from '../../utils/firebaseConfig';

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

const {id} = Astro.params; // Obtén el parámetro id de la URL

if (!id) {
    throw new Error("ID de la serie no encontrado en la URL");
}

if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        const redirectUrl = await handleSerieFavAction(formData);
        return Astro.redirect(redirectUrl);
    } catch (error) {
        console.error('Error al gestionar la serie:', error);
        return Astro.redirect(`/serie/${id}`);
    }
}

// Todas las llamadas TMDB iniciales en paralelo
let [item, cast, directors, trailerUrl, status] = await Promise.all([
    getSeriesById({id}),
    getSeriesCast(id),
    getSeriesDirectorsAndRoles(id),
    getSeriesTrailer(id),
    getSeriesStatus(id),
]);
let title = item?.name || "Serie no encontrada";

// Cliente data actualizado con la estructura de Props
const clientData = {
    id: String(item?.id || ''),
    name: item?.name || 'Sin nombre',
    img: item?.poster_path || '', // Cambiado a img manteniendo compatibilidad con poster_path
    vote_average: item?.vote_average ? Number(item.vote_average) : 0,
    overview: item?.overview || 'Sin descripción',
    first_air_date: item?.first_air_date || '',
    status: status || '',
    genres: item?.genres || [],
    seasons: item?.seasons || [],
    last_episode_to_air: item?.last_episode_to_air || null,
    next_episode_to_air: item?.next_episode_to_air || null
};

// Obtener episodios de TODAS las temporadas en paralelo (antes era secuencial)
const allSeasonEpisodes: { [key: number]: any[] } = {};
if (item?.seasons) {
    const episodeResults = await Promise.all(
        item.seasons.map((season: any) => getEpisodesBySeasonNumber(id, season.season_number))
    );
    item.seasons.forEach((season: any, i: number) => {
        allSeasonEpisodes[season.season_number] = episodeResults[i] || [];
    });
}

// Separar temporadas regulares y especiales
const regularSeasons = item?.seasons?.filter(season => season.season_number > 0) || [];
const specialSeasons = item?.seasons?.filter(season => season.season_number === 0) || [];

const totalRegularEpisodes = regularSeasons.reduce((total, season) => total + (season.episode_count || 0), 0);
const totalSpecialEpisodes = specialSeasons.reduce((total, season) => total + (season.episode_count || 0), 0);
const totalEpisodes = totalRegularEpisodes + totalSpecialEpisodes; // Total completo para compatibilidad

// Verificar si la serie ya está en las diferentes bases de datos
const docRefFavs = doc(db, 'SeriesFavs', clientData.id);
const docRefPendientes = doc(db, 'SeriesPendiente', clientData.id);
const docRefVistas = doc(db, 'SeriesVistas', clientData.id);
const docRefSiguiendo = doc(db, 'SeriesSiguiendo', clientData.id);
const docRefLiked = doc(db, 'LikedSeries', clientData.id);
const docRefVerPronto = doc(db, 'SeriesVerPronto', clientData.id);

// Obtener los documentos en paralelo para mejor rendimiento
const [docSnapFavs, docSnapPendientes, docSnapVistas, docSnapSiguiendo, docSnapLiked, docSnapVerPronto] = await Promise.all([
    getDoc(docRefFavs),
    getDoc(docRefPendientes),
    getDoc(docRefVistas),
    getDoc(docRefSiguiendo),
    getDoc(docRefLiked),
    getDoc(docRefVerPronto)
]);

// Comprobar si existen los documentos
const existingInFavs = docSnapFavs.exists();
const existingInPendientes = docSnapPendientes.exists();
const existingInVistas = docSnapVistas.exists();
const existingInSiguiendo = docSnapSiguiendo.exists();
const existingInLiked = docSnapLiked.exists();
const existingInVerPronto = docSnapVerPronto.exists();

// Comprobar si la serie está en cada una de las colecciones
const isInFavorites = existingInFavs;
const isInPendientes = existingInPendientes;
const isInVistas = existingInVistas;
const isInSiguiendo = existingInSiguiendo;
const isInLiked = existingInLiked;
const isInVerPronto = existingInVerPronto;

// Resolver opinión actual si existe en cualquier colección
const opinionFromAny = (
    (existingInFavs && docSnapFavs.data()?.opinion) ||
    (existingInPendientes && docSnapPendientes.data()?.opinion) ||
    (existingInVistas && docSnapVistas.data()?.opinion) ||
    (existingInSiguiendo && docSnapSiguiendo.data()?.opinion) ||
    (existingInLiked && docSnapLiked.data()?.opinion) ||
    (existingInVerPronto && docSnapVerPronto.data()?.opinion) ||
    ''
) as string;

// Calcular años en emisión
const yearsActiveCalc = (() => {
    if (!item?.first_air_date) return "Desconocido";
    const startYear = new Date(item.first_air_date).getFullYear();
    let endYear: string = "presente";
    if (status === "Ended" || status === "Canceled") {
        const lastAirDate = item?.last_episode_to_air?.air_date;
        endYear = lastAirDate ? String(new Date(lastAirDate).getFullYear()) : "desconocido";
    }
    return `${startYear} - ${endYear}`;
})();

const providerElements = item?.providers?.map((provider) => {
    const link = providerLinks[provider.provider_name];
    const hasLogo = !!provider.logo_path;
    return {
        name: provider.provider_name,
        logo: hasLogo ? `https://image.tmdb.org/t/p/w200${provider.logo_path}` : null,
        link,
        type: provider.type || 'flatrate'
    };
}) || [];

// Agrupar por tipo
const providersByType = providerElements.reduce((acc: Record<string, any[]>, p) => {
    const key = p.type || 'flatrate';
    if (!acc[key]) acc[key] = [];
    acc[key].push(p);
    return acc;
}, {} as Record<string, any[]>);

const statusMap = {
    "Returning Series": "Serie en emisión",
    Ended: "Finalizada",
    Canceled: "Cancelada",
    Pilot: "Piloto",
};

const yearsActive = yearsActiveCalc;

// Ordenar temporadas: primero las regulares, luego las especiales
const sortedSeasons = item?.seasons?.sort((a, b) => {
    // Las temporadas especiales (0) van al final
    if (a.season_number === 0 && b.season_number !== 0) return 1;
    if (b.season_number === 0 && a.season_number !== 0) return -1;
    // Para el resto, orden numérico normal
    return a.season_number - b.season_number;
}) || [];

// Variables útiles para usar en el template
const hasSpecialSeasons = specialSeasons.length > 0;
const regularSeasonsCount = regularSeasons.length;
const specialSeasonsCount = specialSeasons.length;

import type {PosterImage} from '../../services/API/Series/InfoSeries';

// Segundo bloque de datos — todo en paralelo
const apiKey = import.meta.env.TMDB_API_KEY;
const tmdbId = item?.id;

const [
    allPosters,
    seriesRecommendationsData,
    externalIds,
    additionalInfo,
    allVideos,
] = await Promise.all([
    id ? fetchAllSeriesPosters(id).catch(() => []) : Promise.resolve([]),
    tmdbId ? getSerieRecommendationsOrSimilar(tmdbId) : Promise.resolve({ success: false, recommendations: [], type: 'recommendations' as const }),
    tmdbId ? fetch(`https://api.themoviedb.org/3/tv/${tmdbId}/external_ids?api_key=${apiKey}`).then(r => r.json()).catch(() => ({})) : Promise.resolve({}),
    id ? getSeriesAdditionalInfo(id) : Promise.resolve({ keywords: [], networks: [], content_ratings: [], episode_run_time: [], languages: [], tagline: null }),
    id ? getSeriesVideos(id) : Promise.resolve([]),
]);

const posters: PosterImage[] = allPosters.slice(0, 40);
const seriesRecommendations = seriesRecommendationsData.success ? seriesRecommendationsData.recommendations : [];
const seriesRecommendationType = seriesRecommendationsData.type || 'recommendations';
const imdbId = externalIds.imdb_id;

// Categorizar videos
const trailers = allVideos.filter((v: any) => v.type === 'Trailer');
const clips = allVideos.filter((v: any) => v.type === 'Clip');
const behindScenes = allVideos.filter((v: any) => v.type === 'Behind the Scenes' || v.type === 'Bloopers' || v.type === 'Featurette');
const teasers = allVideos.filter((v: any) => v.type === 'Teaser');
---
<Layout title={`${title}`}>
    <article class="bg-gray-50">
        <!-- Hero Mejorado -->
        <div class="relative w-full h-auto bg-cover bg-center bg-no-repeat" style={`background-image: url(${item?.backdrop_path ? `https://image.tmdb.org/t/p/original${item.backdrop_path}` : '/assets/background.svg'})`}>
            <!-- Overlay adaptativo -->
            <div class="absolute inset-0" style={`background: ${item?.backdrop_path ? 'linear-gradient(180deg, rgba(0,0,0,0.7) 100%, rgba(30,30,30,0.5) 100%)' : 'linear-gradient(180deg, #1e293b 0%, #334155 100%)'}`}></div>
            
            <!-- Breadcrumbs - Posicionado arriba a la izquierda -->
            <nav class="relative z-10 pt-6 px-4 max-w-7xl mx-auto hero-breadcrumbs" aria-label="Breadcrumb">
                <ol class="flex items-center space-x-2 text-sm">
                    <li>
                        <a href="/" class="text-white/80 hover:text-white transition-colors flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                            </svg>
                            Inicio
                        </a>
                    </li>
                    <li class="text-white/60">/</li>
                    <li>
                        <a href="/catalogo/topseries" class="text-white/80 hover:text-white transition-colors">Series</a>
                    </li>
                    <li class="text-white/60">/</li>
                    <li class="text-white font-medium truncate max-w-xs" title={item?.name}>
                        {item?.name}
                    </li>
                </ol>
            </nav>

            <div class="relative flex flex-col items-center justify-center px-4 py-12 text-center max-w-4xl mx-auto">

                <!-- Título -->
                <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 drop-shadow-lg flex items-center gap-3 justify-center flex-wrap">
                    <span>{item?.name}</span>
                </h1>

                <!-- Favoritos -->
                {isInFavorites && existingInFavs && (
                    <div class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium mt-2 mb-2">
                        Favorito #{docSnapFavs.data().position}
                    </div>
                )}

                <!-- Info básica + Rating circular + Ver tráiler -->
                <div class="flex flex-wrap items-center justify-center gap-4 text-white mb-4">
                    <span class="bg-blue-600 px-3 py-1 rounded-full text-sm font-medium">
                        {status ? ((statusMap as any)[status] || status) : ''}
                    </span>
                    <!-- Chip de rating circular con tooltip -->
                    {item?.vote_average && (
                        <div class="relative flex items-center justify-center group" tabindex="0">
                            <svg class="w-10 h-10 -rotate-90" viewBox="0 0 36 36" aria-hidden="true">
                                <path class="text-gray-700" stroke="currentColor" stroke-width="3" fill="none" d="M18 2 a 16 16 0 1 1 0 32 a 16 16 0 1 1 0 -32"/>
                                <path class="text-yellow-400" stroke="currentColor" stroke-width="3" fill="none"
                                      stroke-linecap="round"
                                      stroke-dasharray={`${Math.min(100, Math.round((item.vote_average || 0) * 10))}, 100`}
                                      d="M18 2 a 16 16 0 1 1 0 32 a 16 16 0 1 1 0 -32"/>
                            </svg>
                            <span class="absolute text-sm font-semibold">{item.vote_average.toFixed(1)}</span>
                            <!-- Tooltip votos -->
                            {item.vote_count && (
                                <span class="absolute left-12 top-1/2 -translate-y-1/2 bg-gray-900 text-white text-xs rounded px-2 py-1 shadow-lg opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-200 z-10">
                                    {item.vote_count} votos
                                </span>
                            )}
                        </div>
                    )}
                    <span>{yearsActive}</span>
                    {item?.availableInSpain && (
                        <span class="inline-flex items-center justify-center shadow-lg" title="Disponible en España">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 750 500" class="w-10 h-7 rounded">
                                <rect width="750" height="500" fill="#AA151B"/>
                                <rect width="750" height="250" y="125" fill="#F1BF00"/>
                            </svg>
                        </span>
                    )}
                </div>

                <!-- Géneros -->
                {item?.genres && (
                    <div class="flex flex-wrap justify-center gap-2 mb-6">
                        {item.genres.map((genre) => (
                            <span class="bg-gray-800 bg-opacity-80 px-3 py-1 rounded-full text-xs text-white">
                                {genre.name}
                            </span>
                        ))}
                    </div>
                )}

                <!-- 🚀 Sinopsis integrada con truncado sin JS -->
                <div class="bg-black bg-opacity-50 rounded-xl p-4 mb-6 max-w-2xl">
                    <h2 class="text-lg font-semibold text-white mb-2">Sinopsis</h2>
                    <input type="checkbox" id="toggle-sinopsis" class="peer hidden" />
                    <p class="text-gray-200 text-sm md:text-base leading-relaxed max-h-24 overflow-hidden peer-checked:max-h-[1000px] transition-all">
                        {item?.overview || "No hay sinopsis disponible."}
                    </p>
                    {item?.overview && item.overview.length > 250 && (
                        <label for="toggle-sinopsis" class="mt-2 inline-block cursor-pointer text-blue-400 hover:text-blue-300 font-medium text-sm peer-checked:before:content-['Mostrar_menos'] before:content-['Mostrar_más']"></label>
                    )}
                </div>

                <!-- Botón de Me gusta -->
                <form method="POST" class="mt-2">
                    <input type="hidden" name="id" value={item?.id}/>
                    <input type="hidden" name="action" value={isInLiked ? 'remove' : 'add'}/>
                    <input type="hidden" name="actionType" value="liked"/>
                    <button type="submit" class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white rounded-full shadow-md transition-all flex items-center gap-2 mx-auto" aria-live="polite">
                        {isInLiked ? (
                            <>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
                                </svg>
                                Ya me gusta
                            </>
                        ) : (
                            <>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor">
                                    <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
                                </svg>
                                Me gusta
                            </>
                        )}
                    </button>
                </form>
            </div>
        </div>

        <div class="max-w-6xl mx-auto px-4 py-8">
            <div class="flex flex-col md:flex-row gap-8">
                <!-- Columna Izquierda: Poster y Acciones -->
                <div class="md:w-1/3 flex flex-col items-center">
                    <div class="w-64 h-auto rounded-xl overflow-hidden shadow-2xl mb-8 group">
                        <img
                                class="w-full h-auto transform group-hover:scale-105 transition-all duration-500 filter group-hover:brightness-110"
                                src={`https://image.tmdb.org/t/p/w500${item?.poster_path}`}
                                alt={item?.name}
                        />
                    </div>

                    <!-- Panel de Acciones con Grid Mejorado -->
                    <div class="w-full max-w-sm space-y-4">

                        <!-- Sección Principal: Favoritos y Ver Pronto -->
                        <div class="bg-gradient-to-br from-blue-50 to-purple-50 p-4 rounded-xl shadow-lg border border-blue-100">
                            <h3 class="text-sm font-semibold text-gray-700 mb-3 text-center uppercase tracking-wide">
                                Principales</h3>
                            <div class="grid grid-cols-1 gap-3">

                                <!-- Formulario para Favoritos -->
                                <form method="POST" class="w-full">
                                    <input type="hidden" name="id" value={item?.id}/>
                                    <input type="hidden" name="action" value={isInFavorites ? 'remove' : 'add'}/>
                                    <input type="hidden" name="actionType" value="favs"/>

                                    {!isInFavorites && (
                                            <div class="mb-3">
                                                <label for="custom-position"
                                                       class="block text-xs font-medium text-gray-600 mb-1">
                                                    Posición en favoritos (opcional)
                                                </label>
                                                <input
                                                        type="number"
                                                        id="custom-position"
                                                        name="custom_position"
                                                        min="1"
                                                        class="w-full px-3 py-2 text-sm border text-gray-600 border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition-all"
                                                        placeholder="Ej: 1 para el inicio"
                                                />
                                            </div>
                                    )}

                                    <button
                                            type="submit"
                                            class={`w-full px-4 py-3 text-sm font-medium rounded-lg shadow-md transition-all duration-300 flex items-center justify-center gap-2 transform hover:scale-[1.02] active:scale-[0.98] ${
                                                isInFavorites
                                                    ? 'bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white shadow-red-200'
                                                    : 'bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white shadow-blue-200'
                                            }`}
                                            aria-live="polite"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20"
                                             fill="currentColor">
                                            <path fill-rule="evenodd"
                                                  d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z"
                                                  clip-rule="evenodd"/>
                                        </svg>
                                        {isInFavorites ? 'Quitar de Favoritos' : 'Añadir a Favoritos'}
                                    </button>
                                </form>

                                {isInFavorites && (
                                    <form method="POST" class="w-full mt-2">
                                        <input type="hidden" name="id" value={item?.id}/>
                                        <input type="hidden" name="action" value="update"/>
                                        <input type="hidden" name="actionType" value="favs"/>
                                        <div class="mb-3">
                                            <label for="update-position" class="block text-xs font-medium text-gray-600 mb-1">
                                                Actualizar posición en favoritos
                                            </label>
                                            <div class="flex gap-2">
                                                <input
                                                        type="number"
                                                        id="update-position"
                                                        name="custom_position"
                                                        min="1"
                                                        class="w-full px-3 py-2 text-sm border text-gray-600 border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition-all"
                                                        placeholder="Nuevo número"
                                                />
                                                <button
                                                        type="submit"
                                                        class="px-4 py-2 text-sm font-medium rounded-lg bg-blue-600 hover:bg-blue-700 text-white shadow-md transition-colors"
                                                >
                                                    Actualizar
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                )}

                                <!-- Formulario para Ver Pronto -->
                                <form method="POST" class="w-full">
                                    <input type="hidden" name="id" value={item?.id}/>
                                    <input type="hidden" name="action" value={isInVerPronto ? 'remove' : 'add'}/>
                                    <input type="hidden" name="actionType" value="verpronto"/>

                                    <button
                                            type="submit"
                                            class={`w-full px-4 py-3 text-sm font-medium rounded-lg shadow-md transition-all duration-300 flex items-center justify-center gap-2 transform hover:scale-[1.02] active:scale-[0.98] ${
                                                isInVerPronto
                                                    ? 'bg-gradient-to-r from-orange-500 to-red-500 hover:from-orange-600 hover:to-red-600 text-white shadow-orange-200'
                                                    : 'bg-gradient-to-r from-purple-500 to-pink-500 hover:from-purple-600 hover:to-pink-600 text-white shadow-purple-200'
                                            }`}
                                            aria-live="polite"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                             stroke-linejoin="round">
                                            {isInVerPronto ? (
                                                    <>
                                                        <path d="M18 6 6 18"/>
                                                        <path d="m6 6 12 12"/>
                                                    </>
                                            ) : (
                                                    <>
                                                        <path d="M12 2v4"/>
                                                        <path d="m16.2 7.8 2.9-2.9"/>
                                                        <path d="M18 12h4"/>
                                                        <path d="m16.2 16.2 2.9 2.9"/>
                                                        <path d="M12 18v4"/>
                                                        <path d="m4.9 19.1 2.9-2.9"/>
                                                        <path d="M2 12h4"/>
                                                        <path d="m4.9 4.9 2.9 2.9"/>
                                                    </>
                                            )}
                                        </svg>
                                        {isInVerPronto ? 'Quitar de Ver Pronto' : 'Ver Pronto'}
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Sección Estados: Pendientes, Siguiendo, Vistas -->
                        <div class="bg-gradient-to-br from-green-50 to-blue-50 p-4 rounded-xl shadow-lg border border-green-100">
                            <h3 class="text-sm font-semibold text-gray-700 mb-3 text-center uppercase tracking-wide">
                                Estado de Visualización</h3>
                            <div class="grid grid-cols-1 gap-3">

                                <!-- Formulario para Series Pendientes -->
                                <form method="POST" class="w-full">
                                    <input type="hidden" name="id" value={item?.id}/>
                                    <input type="hidden" name="action" value={isInPendientes ? 'remove' : 'add'}/>
                                    <input type="hidden" name="actionType" value="pendientes"/>

                                    <button
                                            type="submit"
                                            class={`w-full px-4 py-2.5 text-sm font-medium rounded-lg shadow-md transition-all duration-300 flex items-center justify-center gap-2 transform hover:scale-[1.02] active:scale-[0.98] ${
                                                isInPendientes
                                                    ? 'bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white shadow-orange-200'
                                                    : 'bg-gradient-to-r from-yellow-400 to-yellow-500 hover:from-yellow-500 hover:to-yellow-600 text-white shadow-yellow-200'
                                            }`}
                                            aria-live="polite"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20"
                                             fill="currentColor">
                                            <path fill-rule="evenodd"
                                                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"
                                                  clip-rule="evenodd"/>
                                        </svg>
                                        {isInPendientes ? 'Quitar de Pendientes' : 'Marcar Pendiente'}
                                    </button>
                                </form>

                                <!-- Formulario para Series Siguiendo -->
                                <form method="POST" class="w-full">
                                    <input type="hidden" name="id" value={item?.id}/>
                                    <input type="hidden" name="action" value={isInSiguiendo ? 'remove' : 'add'}/>
                                    <input type="hidden" name="actionType" value="siguiendo"/>

                                    <button
                                            type="submit"
                                            class={`w-full px-4 py-2.5 text-sm font-medium rounded-lg shadow-md transition-all duration-300 flex items-center justify-center gap-2 transform hover:scale-[1.02] active:scale-[0.98] ${
                                                isInSiguiendo
                                                    ? 'bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white shadow-purple-200'
                                                    : 'bg-gradient-to-r from-indigo-500 to-indigo-600 hover:from-indigo-600 hover:to-indigo-700 text-white shadow-indigo-200'
                                            }`}
                                            aria-live="polite"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-linecap="round"
                                             stroke-linejoin="round" width="24" height="24" stroke-width="2">
                                            {isInSiguiendo ? (
                                                    <>
                                                        <path d="M10.585 10.587a2 2 0 0 0 2.829 2.828"></path>
                                                        <path d="M16.681 16.673a8.717 8.717 0 0 1 -4.681 1.327c-3.6 0 -6.6 -2 -9 -6c1.272 -2.12 2.712 -3.678 4.32 -4.674m2.86 -1.146a9.055 9.055 0 0 1 1.82 -.18c3.6 0 6.6 2 9 6c-.666 1.11 -1.379 2.067 -2.138 2.87"></path>
                                                        <path d="M3 3l18 18"></path>
                                                    </>
                                            ) : (
                                                    <>
                                                        <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
                                                        <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"></path>
                                                    </>
                                            )}
                                        </svg>
                                        {isInSiguiendo ? 'Dejar de Seguir' : 'Marcar Siguiendo'}
                                    </button>
                                </form>

                                <!-- Formulario para Series Vistas -->
                                <form method="POST" class="w-full">
                                    <input type="hidden" name="id" value={item?.id}/>
                                    <input type="hidden" name="action" value={isInVistas ? 'remove' : 'add'}/>
                                    <input type="hidden" name="actionType" value="vistas"/>

                                    <button
                                            type="submit"
                                            class={`w-full px-4 py-2.5 text-sm font-medium rounded-lg shadow-md transition-all duration-300 flex items-center justify-center gap-2 transform hover:scale-[1.02] active:scale-[0.98] ${
                                                isInVistas
                                                    ? 'bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white shadow-red-200'
                                                    : 'bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white shadow-green-200'
                                            }`}
                                            aria-live="polite"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20"
                                             fill="currentColor">
                                            {isInVistas ? (
                                                    <path fill-rule="evenodd"
                                                          d="M10 18a8 8 0 100-16 8 8 0 000 16zm-4.707-5.293a1 1 0 001.414 0L10 9.414l3.293 3.293a1 1 0 001.414-1.414l-4-4a1 1 0 00-1.414 0l-4 4a1 1 0 000 1.414z"
                                                          clip-rule="evenodd"/>
                                            ) : (
                                                    <path fill-rule="evenodd"
                                                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                                          clip-rule="evenodd"/>
                                            )}
                                        </svg>
                                        {isInVistas ? 'Quitar de Vistas' : 'Marcar como Vista'}
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Contenedor para ambos botones -->
                        <div class="w-full mt-6 space-y-4">

                            <!-- Botón Ver Ahora Original -->
                            {(item?.homepage || trailerUrl) && (
                                    <a
                                            href={item?.homepage || trailerUrl}
                                            class="group relative w-full px-6 py-4 bg-gradient-to-r from-pink-500 via-purple-500 to-indigo-600 text-white font-semibold text-lg rounded-xl shadow-lg hover:shadow-2xl focus:outline-none focus:ring-4 focus:ring-purple-300 transition-all duration-300 flex items-center justify-center gap-3 overflow-hidden transform hover:scale-105 active:scale-95"
                                            target="_blank"
                                            rel="noopener"
                                    >
                                        <!-- Efecto de brillo animado -->
                                        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-in-out"></div>

                                        <!-- Icono de play con animación -->
                                        <div class="relative z-10 flex items-center justify-center w-8 h-8 bg-white/20 rounded-full group-hover:bg-white/30 transition-all duration-300">
                                            <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    class="h-5 w-5 transform group-hover:scale-110 transition-transform duration-300"
                                                    fill="currentColor"
                                                    viewBox="0 0 24 24"
                                            >
                                                <path d="M8 5v14l11-7z"/>
                                            </svg>
                                        </div>

                                        <!-- Texto con efecto -->
                                        <span class="relative z-10 group-hover:tracking-wider transition-all duration-300">
                Ver ahora
            </span>

                                        <!-- Icono de enlace externo -->
                                        <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-4 w-4 relative z-10 opacity-75 group-hover:opacity-100 transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                                stroke-width="2"
                                        >
                                            <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                            />
                                        </svg>

                                        <!-- Partículas decorativas -->
                                        <div class="absolute top-1 left-4 w-1 h-1 bg-white/40 rounded-full animate-pulse"></div>
                                        <div
                                                class="absolute bottom-2 right-6 w-1 h-1 bg-white/40 rounded-full animate-pulse"
                                                style="animation-delay: 0.5s;"
                                        ></div>
                                        <div
                                                class="absolute top-3 right-12 w-0.5 h-0.5 bg-white/30 rounded-full animate-pulse"
                                                style="animation-delay: 1s;"
                                        ></div>
                                    </a>
                            )}

                            <!-- Nuevo Botón para IMDB Reviews -->
                            {imdbId && (
                                    <a
                                            href={`https://www.imdb.com/title/${imdbId}/reviews`}
                                            class="group relative w-full px-6 py-4 bg-gradient-to-r from-yellow-500 via-orange-500 to-red-600 text-white font-semibold text-lg rounded-xl shadow-lg hover:shadow-2xl focus:outline-none focus:ring-4 focus:ring-yellow-300 transition-all duration-300 flex items-center justify-center gap-3 overflow-hidden transform hover:scale-105 active:scale-95"
                                            target="_blank"
                                            rel="noopener"
                                    >
                                        <!-- Efecto de brillo animado -->
                                        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-in-out"></div>

                                        <!-- Icono de IMDB/críticas -->
                                        <div class="relative z-10 flex items-center justify-center w-8 h-8 bg-white/20 rounded-full group-hover:bg-white/30 transition-all duration-300">
                                            <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    class="h-5 w-5 transform group-hover:scale-110 transition-transform duration-300"
                                                    fill="currentColor"
                                                    viewBox="0 0 24 24"
                                            >
                                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                                            </svg>
                                        </div>

                                        <!-- Texto con efecto -->
                                        <span class="relative z-10 group-hover:tracking-wider transition-all duration-300">
                                            Ver críticas en IMDB
                                        </span>

                                        <!-- Icono de enlace externo -->
                                        <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-4 w-4 relative z-10 opacity-75 group-hover:opacity-100 transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                                stroke-width="2"
                                        >
                                            <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                            />
                                        </svg>

                                        <!-- Partículas decorativas -->
                                        <div class="absolute top-1 left-4 w-1 h-1 bg-white/40 rounded-full animate-pulse"></div>
                                        <div
                                                class="absolute bottom-2 right-6 w-1 h-1 bg-white/40 rounded-full animate-pulse"
                                                style="animation-delay: 0.5s;"
                                        ></div>
                                        <div
                                                class="absolute top-3 right-12 w-0.5 h-0.5 bg-white/30 rounded-full animate-pulse"
                                                style="animation-delay: 1s;"
                                        ></div>
                                    </a>
                            )}

                            <!-- Textos descriptivos -->
                            <div class="flex justify-between text-center text-xs text-gray-500 opacity-75">
                                {(item?.homepage || trailerUrl) && (
                                        <p class="flex-1">
                                            {item?.homepage ? 'Sitio oficial' : 'Ver tráiler'}
                                        </p>
                                )}
                                {imdbId && (
                                        <p class="flex-1">Reseñas y críticas</p>
                                )}
                            </div>
                        </div>
                    </div>

                    <!-- Info Cards -->
                    <div class="mt-8 w-full space-y-4">
                        <div class="bg-white p-4 rounded-lg shadow-md">
                            <h3 class="text-lg font-bold text-blue-600 mb-3 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                Información
                            </h3>
                            <ul class="space-y-2">
                                <li class="flex justify-between items-center py-1 border-b border-gray-100 last:border-0">
                                    <span class="text-gray-600 flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        Estado:
                                    </span>
                                    <span class="font-medium text-gray-800">{status ? ((statusMap as any)[status] || status) : 'No disponible'}</span>
                                </li>
                                <li class="flex justify-between items-center py-1 border-b border-gray-100 last:border-0">
                                    <span class="text-gray-600 flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                        Estreno:
                                    </span>
                                    <span class="font-medium text-gray-800">{formatDate(item?.first_air_date)}</span>
                                </li>
                                <li class="flex justify-between items-center py-1 border-b border-gray-100 last:border-0">
                                    <span class="text-gray-600 flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                        </svg>
                                        Finalización:
                                    </span>
                                    <span class="font-medium text-gray-800">
                                        {item?.last_episode_to_air ? formatDate(item.last_episode_to_air.air_date) : "No disponible"}
                                    </span>
                                </li>
                                <li class="flex justify-between items-center py-1 border-b border-gray-100 last:border-0">
                                    <span class="text-gray-600 flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-yellow-500" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                                        </svg>
                                        Valoración:
                                    </span>
                                    <span class="font-medium text-gray-800">{item?.vote_average?.toFixed(1)}
                                        <span class="text-sm text-gray-500 ml-1">({item?.vote_count} votos)</span></span>
                                </li>
                                <li class="flex justify-between items-center py-1 border-b border-gray-100 last:border-0">
                                    <span class="text-gray-600 flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                                        </svg>
                                        Popularidad:
                                    </span>
                                    <span class="font-medium text-gray-800">{item?.popularity?.toFixed(1)}</span>
                                </li>
                                <li class="flex justify-between items-center py-1 border-b border-gray-100 last:border-0">
                                    <span class="text-gray-600 flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
                                        </svg>
                                        Temporadas:
                                    </span>
                                    <span class="font-medium text-gray-800">
                                        {regularSeasonsCount}
                                        {hasSpecialSeasons &&
                                                <span class="text-blue-600 text-sm ml-1">(+ {specialSeasonsCount}
                                                    Especiales)</span>
                                        }
                                    </span>
                                </li>
                                <li class="flex justify-between items-center py-1 border-b border-gray-100 last:border-0">
                                    <span class="text-gray-600 flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                        </svg>
                                        Episodios:
                                    </span>
                                    <span class="font-medium text-gray-800">
                                        {totalRegularEpisodes}
                                        {hasSpecialSeasons &&
                                                <span class="text-blue-600 text-sm ml-1">
                                                    (+ {totalSpecialEpisodes} especiales)
                                                </span>
                                        }
                                    </span>
                                </li>
                                {additionalInfo.episode_run_time && additionalInfo.episode_run_time.length > 0 && (
                                    <li class="flex justify-between items-center py-1 border-b border-gray-100 last:border-0">
                                        <span class="text-gray-600 flex items-center gap-2">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                            Duración promedio:
                                        </span>
                                        <span class="font-medium text-gray-800">
                                            {additionalInfo.episode_run_time[0]} min
                                        </span>
                                    </li>
                                )}
                                <li class="flex justify-between items-center py-1 border-b border-gray-100 last:border-0">
                                    <span class="text-gray-600 flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                                        </svg>
                                        Idioma original:
                                    </span>
                                    <span class="font-medium text-gray-800">{getLanguageDisplayName(item?.original_language || '')}</span>
                                </li>
                                <li class="flex justify-between items-center py-1 border-b border-gray-100 last:border-0">
                                    <span class="text-gray-600 flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        País:
                                    </span>
                                    <span class="font-medium text-gray-800">{item?.origin_country?.join(", ") || "No disponible"}</span>
                                </li>
                            </ul>
                        </div>

                        <!-- Clasificación por Edades -->
                        {additionalInfo.content_ratings && additionalInfo.content_ratings.length > 0 && (() => {
                            const rating = getContentRating(additionalInfo.content_ratings);
                            return rating ? (
                                <div class="bg-gradient-to-r from-orange-50 to-red-50 p-4 rounded-lg shadow-md border-l-4 border-orange-500">
                                    <h3 class="text-lg font-bold text-orange-700 mb-2 flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                        </svg>
                                        Clasificación
                                    </h3>
                                    <p class="text-gray-800 font-semibold text-lg">{rating.text}</p>
                                </div>
                            ) : null;
                        })()}

                        <!-- Idiomas Disponibles -->
                        {additionalInfo.languages && additionalInfo.languages.length > 0 && (
                            <div class="bg-white p-4 rounded-lg shadow-md">
                                <h3 class="text-lg font-bold text-blue-600 mb-3 flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                                    </svg>
                                    Idiomas Disponibles
                                </h3>
                                <div class="flex flex-wrap gap-2">
                                    {additionalInfo.languages.map((lang: any) => (
                                        <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm font-medium">
                                            {getLanguageDisplayName(lang.iso_639_1 || lang)}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        )}

    

                        <!-- Opinión personal -->
                        {(isInFavorites || isInPendientes || isInVistas || isInSiguiendo || isInLiked || isInVerPronto) && (
                            <div class="bg-white p-4 rounded-lg shadow-md">
                                <h3 class="text-lg font-bold text-blue-600 mb-3">Tu opinión</h3>
                                {opinionFromAny ? (
                                    <div class="space-y-3">
                                        <blockquote class="relative p-4 bg-blue-50 border border-blue-200 rounded-lg text-gray-800">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-400 absolute -top-2 -left-2 bg-white rounded-full" viewBox="0 0 20 20" fill="currentColor">
                                                <path d="M7.667 10.667H4.333A2.333 2.333 0 012 8.333V5a2.333 2.333 0 012.333-2.333H6a2.333 2.333 0 012.333 2.333v.667A2.333 2.333 0 016 8.333H4.333v2.334h3.334zM15.667 10.667h-3.334A2.333 2.333 0 0110 8.333V5a2.333 2.333 0 012.333-2.333H14a2.333 2.333 0 012.333 2.333v.667A2.333 2.333 0 0114 8.333h-1.667v2.334h3.334z" />
                                            </svg>
                                            <p class="whitespace-pre-wrap">{opinionFromAny}</p>
                                        </blockquote>
                                        <div class="flex items-center gap-2 justify-end">
                                            <details>
                                                <summary class="px-3 py-1.5 text-sm rounded-md bg-blue-600 hover:bg-blue-700 text-white cursor-pointer">Actualizar opinión</summary>
                                                <div class="mt-3">
                                                    <form method="POST" class="space-y-3">
                                                        <input type="hidden" name="id" value={item?.id} />
                                                        <input type="hidden" name="action" value="save_opinion" />
                                                        <textarea name="opinion" rows="4" class="w-full p-3 border border-gray-300 rounded-lg text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-400">{opinionFromAny}</textarea>
                                                        <div class="flex items-center justify-between">
                                                            <p class="text-xs text-gray-500">Se actualizará en todas tus listas</p>
                                                            <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg shadow">Guardar</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </details>
                                            <form method="POST">
                                                <input type="hidden" name="id" value={item?.id} />
                                                <input type="hidden" name="action" value="delete_opinion" />
                                                <button type="submit" class="px-3 py-1.5 text-sm rounded-md bg-red-600 hover:bg-red-700 text-white">Eliminar opinión</button>
                                            </form>
                                        </div>
                                    </div>
                                ) : (
                                    <form method="POST" class="space-y-3">
                                        <input type="hidden" name="id" value={item?.id} />
                                        <input type="hidden" name="action" value="save_opinion" />
