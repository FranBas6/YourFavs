---
import Layout from '../layouts/Layout.astro';
import CardMovie from "../components/Cards/CardMovie.astro";
import CardSerie from "../components/Cards/CardSerie.astro";
import HoverPreview from "../components/HoverPreview.astro";
import type {Movie} from "../types/ApiMovie"
import type {Serie} from "../types/ApiSerie";
import {getLatestMovies, getMostPopularMovies, getTopRatedMovies, getMoviesByCategory} from "../services/API/Movies/tmdbMovies";
import {getLatestSeries, getMostPopularSeries, getTopRatedSeries, getSeriesByCategory} from "../services/API/Series/tmdbSeries";
import {getTrending} from "../services/API/shared/tmdbDiscoverService";
import ContinueWatchingShell from "../components/Sections/ContinueWatchingShell.astro";
import RecommendedForYouShell from "../components/Sections/RecommendedForYouShell.astro";
import {fetchAllPlatforms} from "../utils/constants/platforms";
import {getGenreName} from "../utils/constants/genres";
import {allCategories} from "../utils/constants/categories";
import {posterUrl, backdropUrl} from "../services/API/shared/tmdbClient";
import {safeFetch} from "../utils/safeFetch";
import '../styles/pages/index.css';

const page = Number(Astro.request.url.split('?page=')[1] || 1);
const pageStr = page.toString();

const randomIndex = Math.floor(Math.random() * allCategories.length);
const randomCategorySlug = allCategories[randomIndex].slug;
const randomCategoryName = allCategories[randomIndex].name;

// Cada fetch con su propio catch: si TMDB/Firebase falla en cold start,
// la home renderiza con esa sección vacía en lugar de devolver Web Server Error
const [
    trendingMovies,
    trendingSeries,
    latestMovies,
    latestSeries,
    popularMovies,
    popularSeries,
    topRatedMovies,
    topRatedSeries,
    platforms,
    categoriesMovies,
    categoriesSeries,
] = await Promise.all([
    safeFetch(getTrending<Movie>('movie', 'week'), 'home/trendingMovies', [] as Movie[]),
    safeFetch(getTrending<Serie>('tv', 'week'), 'home/trendingSeries', [] as Serie[]),
    safeFetch(getLatestMovies({page: pageStr}), 'home/latestMovies', [] as Movie[]),
    safeFetch(getLatestSeries({page: pageStr}), 'home/latestSeries', [] as Serie[]),
    safeFetch(getMostPopularMovies({page: pageStr}), 'home/popularMovies', [] as Movie[]),
    safeFetch(getMostPopularSeries({page: pageStr}), 'home/popularSeries', [] as Serie[]),
    safeFetch(getTopRatedMovies({page: pageStr}), 'home/topRatedMovies', [] as Movie[]),
    safeFetch(getTopRatedSeries({page: pageStr}), 'home/topRatedSeries', [] as Serie[]),
    safeFetch(fetchAllPlatforms(pageStr), 'home/platforms', []),
    safeFetch(getMoviesByCategory(randomCategorySlug, pageStr), 'home/categoriesMovies', [] as Movie[]),
    safeFetch(getSeriesByCategory(randomCategorySlug, pageStr), 'home/categoriesSeries', [] as Serie[]),
]);
// continueWatching y forYou se cargan vía /api/home-deferred.json client-side
// para que el SSR no espere a TMDB+Firebase en cold start (antes ~19s, ahora ~3-5s)

const randomPlatform = platforms[Math.floor(Math.random() * platforms.length)];

// Película destacada para el hero (la más trending de la semana)
const heroMovie = trendingMovies[0] || null;

const randomCategory = {
    slug: randomCategorySlug,
    name: randomCategoryName,
    movies: categoriesMovies,
    series: categoriesSeries,
};

const sections = [
    {
        title: "TENDENCIAS DE LA SEMANA",
        movies: trendingMovies,
        series: trendingSeries,
        link: "/catalogo/tendencias",
        priority: 'high',
        icon: '📈'
    },
    {
        title: "ÚLTIMOS LANZAMIENTOS",
        movies: latestMovies,
        series: latestSeries,
        link: "/catalogo/ultimoslanzamientos",
        priority: 'high',
        icon: '🆕'
    },
    {
        title: "MÁS POPULARES",
        movies: popularMovies,
        series: popularSeries,
        link: "/catalogo/maspopulares",
        priority: 'high',
        icon: '🔥'
    },
    {
        title: "TOP PELÍCULAS",
        movies: topRatedMovies,
        series: [],
        link: "/catalogo/topmovies",
        priority: 'medium',
        icon: '⭐'
    },
    {
        title: "TOP SERIES",
        movies: [],
        series: topRatedSeries,
        link: "/catalogo/topseries",
        priority: 'medium',
        icon: '🏆'
    },
    {
        title: `PLATAFORMA DESTACADA: ${randomPlatform.name}`,
        movies: randomPlatform.movies as Movie[],
        series: randomPlatform.series as Serie[],
        link: `/catalogo/plataformas?platform=${randomPlatform.slug}&page=1`,
        priority: 'low',
        icon: '📺'
    },
    {
        title: `CATEGORÍA DESTACADA: ${randomCategory.name}`,
        movies: randomCategory.movies as Movie[],
        series: randomCategory.series as Serie[],
        link: `/catalogo/categorias?categoria=${randomCategory.slug}&page=1&type=all`,
        priority: 'low',
        icon: '🎬'
    }
];
---
<Layout title="YourFavs">     
    <main class="main-container">
        <!-- Hero con película trending destacada -->
        {heroMovie ? (
            <div class="hero-backdrop" style={`background-image: url(${backdropUrl(heroMovie.backdrop_path, 'w1280')})`}>
                <div class="hero-backdrop-overlay">
                    <div class="hero-backdrop-content">
                        <span class="hero-trending-badge">📈 Trending esta semana</span>
                        <h1 class="hero-backdrop-title">{heroMovie.title}</h1>
                        <div class="hero-backdrop-meta">
                            <span class="hero-backdrop-rating">⭐ {heroMovie.vote_average?.toFixed(1)}</span>
                            <span class="hero-backdrop-year">{heroMovie.release_date?.split('-')[0]}</span>
                        </div>
                        <p class="hero-backdrop-overview">{heroMovie.overview}</p>
                        <a href={`/movie/${heroMovie.id}`} class="hero-backdrop-cta">
                            Ver detalles
                            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        ) : (
            <div class="hero-section">
                <div class="hero-content">
                    <h1 class="hero-title text-coral-red">
                        <span class="hero-icon">🎬</span>
                        CATÁLOGO PRINCIPAL
                    </h1>
                    <div class="hero-divider"></div>
                    <p class="hero-description">
                        Descubre miles de películas y series de las mejores plataformas.
                        <strong>Tu entretenimiento favorito</strong> en un solo lugar.
                    </p>
                </div>
            </div>
        )}

        <!-- Continuar viendo + Para ti: shells con skeleton, hidratan via /api/home-deferred.json -->
        <div class="content-wrapper">
            <ContinueWatchingShell />
        </div>

        <div class="content-wrapper">
            <RecommendedForYouShell />
        </div>

        <!-- Contenido principal -->
        <div class="content-wrapper">
            {sections
                .filter((section) => section.movies.length > 0 || section.series.length > 0)
                .map((section) => (
                        <article class={`section-card ${section.priority === 'high' ? 'featured-section' : ''}`}>
                            <header class="section-header">
                                <div class="section-title-wrapper">
                                    <span class="section-icon" aria-hidden="true">{section.icon}</span>
                                    <h2 class="section-title">{section.title}</h2>
                                    {section.priority === 'high' && (
                                            <span class="priority-badge">Destacado</span>
                                    )}
                                </div>
                                <a href={section.link} class="view-more-btn">
                                    <span>Ver más</span>
                                    <svg class="arrow-icon" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd"
                                            d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                            clip-rule="evenodd"/>
                                    </svg>
                                </a>
                            </header>

                            <div class="section-content">
                                {section.movies.length > 0 && (
                                        <div class="content-category">
                                            <h3 class="category-title">
                                                <svg class="category-icon" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor">
                                                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                                    <line x1="8" y1="21" x2="16" y2="21"/>
                                                    <line x1="12" y1="17" x2="12" y2="21"/>
                                                </svg>
                                                <span>Películas</span>
                                                <span class="item-count">({section.movies.length})</span>
                                            </h3>
                                            <div class="cards-grid">
                                                {section.movies.slice(0, 10).map((item) => (
                                                        <div class="card-container">
                                                            <HoverPreview tmdbId={item.id} tmdbType="movie" title={item.title} backdropPath={item.backdrop_path} href={`/movie/${item.id}`} year={item.release_date?.slice(0,4)} rating={item.vote_average}><CardMovie
                                                                    id={item.id.toString()}
                                                                    img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                                                    title={item.title}
                                                                    vote_average={item.vote_average}
                                                                    overview={item.overview}
                                                                    release_date={item.release_date}
                                                                    genres={item.genre_ids?.map(id => ({
                                                                        id,
                                                                        name: getGenreName(id)
                                                                    }))}
                                                            /></HoverPreview>
                                                        </div>
                                                ))}
                                            </div>
                                        </div>
                                )}

                                {section.series.length > 0 && (
                                        <div class="content-category">
                                            <h3 class="category-title">
                                                <svg class="category-icon" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor">
                                                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                                    <line x1="8" y1="21" x2="16" y2="21"/>
                                                    <line x1="12" y1="17" x2="12" y2="21"/>
                                                    <circle cx="17" cy="8" r="1"/>
                                                    <circle cx="17" cy="16" r="1"/>
                                                </svg>
                                                <span>Series</span>
                                                <span class="item-count">({section.series.length})</span>
                                            </h3>
                                            <div class="cards-grid">
                                                {section.series.slice(0, 10).map((item) => (
                                                        <div class="card-container">
                                                            <HoverPreview tmdbId={item.id} tmdbType="tv" title={item.name} backdropPath={item.backdrop_path} href={`/serie/${item.id}`} year={item.first_air_date?.slice(0,4)} rating={item.vote_average}><CardSerie
                                                                    id={item.id.toString()}
                                                                    img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                                                    name={item.name}
                                                                    vote_average={item.vote_average}
                                                                    overview={item.overview}
                                                                    first_air_date={item.first_air_date}
                                                                    seasons={item.seasons}
                                                                    last_episode_to_air={item.last_episode_to_air}
                                                                    next_episode_to_air={item.next_episode_to_air}
                                                                    genres={item.genre_ids?.map(id => ({
                                                                        id,
                                                                        name: getGenreName(id)
                                                                    }))}
                                                            /></HoverPreview>
                                                        </div>
                                                ))}
                                            </div>
                                        </div>
                                )}
                            </div>
                        </article>
                ))}
        </div>
    </main>
</Layout>

<script>
    // Hidrata "Continuar viendo" y "Para ti" via fetch al endpoint diferido.
    // Si el JSON tarda mucho o falla, las secciones se ocultan; el resto del SSR
    // (hero + tendencias + populares + ...) ya está visible para el usuario.
    (async () => {
        const continueSection = document.querySelector('[data-deferred-section="continue-watching"]') as HTMLElement | null;
        const forYouSection = document.querySelector('[data-deferred-section="for-you"]') as HTMLElement | null;
        const continueList = document.querySelector('[data-deferred-list="continue-watching"]');
        const forYouList = document.querySelector('[data-deferred-list="for-you"]');
        if (!continueSection || !forYouSection || !continueList || !forYouList) return;

        const hide = (el: HTMLElement | null) => { if (el) el.style.display = 'none'; };
        const removeLoader = (key: string) => {
            const el = document.querySelector(`[data-deferred-loading="${key}"]`);
            if (el) el.remove();
        };
        const poster = (path: string | null) => path ? `https://image.tmdb.org/t/p/w500${path}` : '/placeholder.jpg';
        const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c] as string));

        try {
            const res = await fetch('/api/home-deferred.json', { credentials: 'same-origin' });
            if (!res.ok) throw new Error(`status ${res.status}`);
            const { continueWatching, forYou } = await res.json();

            removeLoader('continue-watching');
            removeLoader('for-you');

            if (!Array.isArray(continueWatching) || continueWatching.length === 0) {
                hide(continueSection);
            } else {
                continueList.innerHTML = continueWatching.map((it: any) => `
                    <a href="/serie/${it.id}#season-${it.next_season}" class="continue-watching-card flex-shrink-0 w-36 sm:w-40 snap-start group" aria-label="Continuar ${esc(it.name)}, Temporada ${it.next_season} Episodio ${it.next_episode}: ${esc(it.next_episode_name)}">
                        <div class="relative rounded-xl overflow-hidden shadow-md group-hover:shadow-xl transition-shadow duration-300 aspect-[2/3] bg-gray-200">
                            <img src="${esc(poster(it.poster_path))}" alt="${esc(it.name)}" loading="lazy" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
                            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/95 via-black/75 to-transparent p-2.5 pt-8">
                                <p class="text-[10px] font-bold text-blue-300 tracking-wider">T${it.next_season} · E${it.next_episode}</p>
                                <p class="text-xs text-white font-medium line-clamp-2 mt-0.5 leading-snug">${esc(it.next_episode_name)}</p>
                            </div>
                        </div>
                        <p class="mt-2 text-sm font-semibold text-gray-800 line-clamp-1">${esc(it.name)}</p>
                    </a>
                `).join('');
            }

            if (!Array.isArray(forYou) || forYou.length === 0) {
                hide(forYouSection);
            } else {
                forYouList.innerHTML = forYou.map((it: any) => {
                    const href = it.kind === 'movie' ? `/movie/${it.id}` : `/serie/${it.id}`;
                    const badge = it.kind === 'movie' ? 'Película' : 'Serie';
                    const badgeColor = it.kind === 'movie' ? 'bg-red-500' : 'bg-blue-500';
                    const ratingHtml = it.vote_average > 0
                        ? `<span class="absolute top-2 right-2 text-[10px] font-bold px-2 py-0.5 rounded-full bg-black/70 text-yellow-300">★ ${Number(it.vote_average).toFixed(1)}</span>`
                        : '';
                    const yearHtml = it.date ? `<p class="text-xs text-gray-500">${esc(String(it.date).slice(0, 4))}</p>` : '';
                    return `
                        <a href="${href}" class="for-you-card flex-shrink-0 w-36 sm:w-40 snap-start group" aria-label="${badge}: ${esc(it.title)}">
                            <div class="relative rounded-xl overflow-hidden shadow-md group-hover:shadow-xl transition-shadow duration-300 aspect-[2/3] bg-gray-200">
                                <img src="${esc(poster(it.poster_path))}" alt="${esc(it.title)}" loading="lazy" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
                                <span class="absolute top-2 left-2 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${badgeColor} text-white">${badge}</span>
                                ${ratingHtml}
                            </div>
                            <p class="mt-2 text-sm font-semibold text-gray-800 line-clamp-1">${esc(it.title)}</p>
                            ${yearHtml}
                        </a>
                    `;
                }).join('');
            }
        } catch (err) {
            console.warn('[home-deferred] fetch falló, ocultando secciones:', err);
            hide(continueSection);
            hide(forYouSection);
        }
    })();
</script>
