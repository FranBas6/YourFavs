---
import Header from "../components/Header.astro";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";

interface Props {
    title: string;
    description?: string;
}

const {title, description = "Tu plataforma favorita para descubrir películas y series"} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" view-transition>
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link rel="icon" type="image/svg+xml" href="/logo_yourfavs.png"/>
    <meta name="generator" content={Astro.generator}/>
    <meta name="description" content={description}/>
    <meta name="theme-color" content="#3B82F6"/>
    <link rel="canonical" href={Astro.url.href}/>
    <link rel="manifest" href="/site.webmanifest"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <meta property="og:image" content="/og-image.png"/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F3F4F6"/>
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0B1220"/>
    <script is:inline>
        (function () {
            try {
                var saved = localStorage.getItem('theme');
                var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                var theme = saved || (systemDark ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
            } catch {}
        })();
    </script>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:type" content="website"/>
    <title>{title}</title>
</head>
<body id="top" class="bg-light-gray min-h-screen pb-16 sm:pb-24 md:pb-32 font-poppins">
<a href="#content" class="skip-link">Saltar al contenido</a>
<Header/>
<main id="content" class="max-w-7xl w-full px-3 sm:px-6 lg:px-8 mx-auto pt-4 sm:pt-6 md:pt-8 lg:pt-10">
    <slot/>
    
    <!-- Botón flotante para YourChat -->
    <div class="chat-button-container">
        <a href="/chat/yourchat" title="Abrir YourChat" aria-label="Abrir YourChat" class="chat-button">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 9h8"></path>
                <path d="M8 13h6"></path>
                <path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z"></path>
            </svg>
        </a>
    </div>
    
    <!-- Botón flotante para volver arriba -->
    <div class="back-to-top-container">
        <a href="#top" title="Subir al inicio" aria-label="Subir al inicio" class="back-to-top">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
            </svg>
        </a>
    </div>
</main>
<footer class="bg-transparent max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 mt-12 text-center text-xs sm:text-sm text-gray-600 py-6">
    <p class="mb-2">&copy; {new Date().getFullYear()} YourFavs. Todos los derechos reservados.</p>
    <div class="flex justify-center gap-4 text-gray-500 text-sm">
        <a href="/about" class="inline-flex items-center gap-2 hover:text-blue-600 transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path>
                <path d="M12 9h.01"></path>
                <path d="M11 12h1v4h1"></path>
            </svg>
            Acerca de
        </a>
    </div>
</footer>
<script is:inline>
    (function () {
        // Mostrar/ocultar botón volver arriba
        var onReady = function () {
            var el = document.querySelector('.back-to-top-container');
            if (!el) return;
            var reveal = function () {
                var scrolled = window.scrollY || document.documentElement.scrollTop;
                if (scrolled > 400) el.classList.add('is-visible'); else el.classList.remove('is-visible');
            };
            reveal();
            window.addEventListener('scroll', reveal, { passive: true });
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', onReady); else onReady();

        // Toggle de tema si existe un botón en el Header
        var bindThemeToggle = function () {
            var btn = document.querySelector('.theme-toggle');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var html = document.documentElement;
                var next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-theme', next);
                try { localStorage.setItem('theme', next); } catch {}
            });
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindThemeToggle); else bindThemeToggle();
    })();
    </script>
</body>
</html>

<style is:global>
    :root {
        /* Colores existentes */
        --color-primary: #3B82F6;
        --color-secondary: #2563EB;
        --color-background: #F3F4F6;
        --color-text: #1F2937;
        --color-text-light: #6B7280;

        /* Colores adicionales para las tarjetas */
        --color-midnight-blue: #006ea7;
        --color-dark-blue: #112d7d;
        --color-coral-plat: #ffffff;
        --color-coral-white: #d5d5d2;
        --color-pastel-yellow: #FACC15;

        --coral-red: #ff6b7a;
        --coral-red-light: #ff8f9c;
        --coral-red-dark: #e8495a;
        --coral-red-alpha: rgba(255, 107, 122, 0.15);
    }

    .bg-light-gray {
        background-color: #F3F4F6;
    }

    html {
        font-family: 'Poppins', sans-serif;
        scroll-behavior: smooth;
        color-scheme: light;
        font-size: 16px;
    }

    @media (max-width: 640px) {
        html {
            font-size: 14px;
        }
    }

    @media (max-width: 768px) {
        main {
            padding-bottom: 6rem;
        }
    }

    body {
        color: var(--color-text);
        margin: 0;
        padding: 0;
        transition: background-color 0.3s ease;
        width: 100%;
        overflow-x: hidden;
    }

    img {
        max-width: 100%;
        height: auto;
        display: block;
    }

    /* Mejoras para accesibilidad en elementos de enfoque */
    :focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
    }

    /* Mejoras para el scrollbar */
    ::-webkit-scrollbar {
        width: 8px;
    }

    @media (max-width: 640px) {
        ::-webkit-scrollbar {
            width: 4px;
        }
    }

    ::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    ::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 5px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: #a1a1a1;
    }

    .container {
        width: 100%;
        margin-right: auto;
        margin-left: auto;
    }

    /* Grid responsivo básico */
    .grid {
        display: grid;
        gap: 1rem;
    }

    .grid-cols-1 {
        grid-template-columns: repeat(1, minmax(0, 1fr));
    }

    .grid-cols-2 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (min-width: 640px) {
        .sm\:grid-cols-2 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .sm\:grid-cols-3 {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @media (min-width: 768px) {
        .md\:grid-cols-3 {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .md\:grid-cols-4 {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @media (min-width: 1024px) {
        .lg\:grid-cols-4 {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .lg\:grid-cols-5 {
            grid-template-columns: repeat(5, minmax(0, 1fr));
        }
    }

    /* Botón flotante para volver arriba */
    .back-to-top-container {
        position: fixed;
        bottom: 1rem;
        right: 1rem;
        z-index: 50;
        opacity: 0;
        pointer-events: none;
        transform: translateY(8px);
    }
    .back-to-top-container.is-visible {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }

    .back-to-top {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        background: var(--coral-red);
        color: white;
        border-radius: 50%;
        box-shadow: var(--shadow-large);
        transition: var(--transition-smooth);
        text-decoration: none;
        opacity: 0.9;
    }

    .back-to-top svg {
        width: 20px;
        height: 20px;
    }

    .back-to-top:hover {
        transform: translateY(-4px);
        opacity: 1;
        box-shadow: 0 8px 20px rgba(230, 57, 70, 0.5);
    }

    .back-to-top:focus {
        outline: none;
        ring: 3px solid rgba(230, 57, 70, 0.3);
    }

    @media (min-width: 768px) {
        .back-to-top-container {
            bottom: 1.5rem;
            right: 1.5rem;
        }

        .back-to-top {
            width: 56px;
            height: 56px;
        }

        .back-to-top svg {
            width: 24px;
            height: 24px;
        }
    }

    /* Botón flotante para YourChat */
    .chat-button-container {
        position: fixed;
        bottom: 1rem;
        left: 1rem;
        z-index: 50;
        opacity: 1;
        pointer-events: auto;
    }

    .chat-button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
        color: white;
        border-radius: 50%;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
        transition: all 0.3s ease;
        text-decoration: none;
        opacity: 0.9;
    }

    .chat-button svg {
        width: 20px;
        height: 20px;
    }

    .chat-button:hover {
        transform: translateY(-4px);
        opacity: 1;
        box-shadow: 0 8px 20px rgba(59, 130, 246, 0.5);
    }

    .chat-button:focus {
        outline: none;
        ring: 3px solid rgba(59, 130, 246, 0.3);
    }

    @media (min-width: 768px) {
        .chat-button-container {
            bottom: 1.5rem;
            left: 1.5rem;
        }

        .chat-button {
            width: 56px;
            height: 56px;
        }

        .chat-button svg {
            width: 24px;
            height: 24px;
        }
    }

    .back-to-top:hover {
        transform: translateY(-4px) scale(1.1);
        opacity: 1;
        box-shadow: 0 20px 40px -10px rgba(230, 57, 70, 0.4);
    }

    .back-to-top:focus {
        outline: none;
        ring: 3px solid rgba(230, 57, 70, 0.3);
    }

    a, button, input {
        transition: all 0.2s ease-in-out;
    }

    /* Skip link accesible */
    .skip-link {
        position: absolute;
        left: -999px;
        top: auto;
        width: 1px;
        height: 1px;
        overflow: hidden;
    }
    .skip-link:focus {
        left: 1rem;
        top: 1rem;
        width: auto;
        height: auto;
        padding: .5rem .75rem;
        z-index: 100;
        background: var(--color-primary);
        color: white;
        border-radius: .5rem;
        text-decoration: none;
    }

    /* Respeto a reduce motion */
    @media (prefers-reduced-motion: reduce) {
        * {
            animation: none !important;
            transition: none !important;
            scroll-behavior: auto !important;
        }
    }

</style>