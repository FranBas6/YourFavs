---
const { href } = Astro.props;
---
<a href={href}
   class="flex-row justify-center text-white cursor-pointer hover:bg-coral-yellow focus:ring-4 focus:outline-none focus:ring-[#1dalf2]/50 font-bold text-sm rounded-lg px-4 py-3 text-center inline-flex items-center dark:focus:ring-[#1dalf2]/55 ml-1 mr-2 mb-2 mt-2 hover:shadow-lg transition-all duration-200 ease-in-out hover:scale-110 scale-90 gap-x-2 opacity-95 hover:opacity-100">
    <slot name="before"/>
    <slot/>
    <slot name="after"/>
</a>

<style is:global>
    .hover\:bg-coral-yellow:hover {
        background-color: #efca2c;
    }
</style>
