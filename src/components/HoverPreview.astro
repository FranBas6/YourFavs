---
import { backdropUrl } from "../services/API/shared/tmdbClient";

interface Props {
    tmdbId: number | string;
    tmdbType: 'movie' | 'tv';
    title: string;
    backdropPath?: string | null;
    href?: string;
    year?: string | number | null;
    rating?: number | null;
}

const { tmdbId, tmdbType, title, backdropPath = null, href = '', year = null, rating = null } = Astro.props;
const backdrop = backdropPath ? backdropUrl(backdropPath) : '';
---
<div
    class="hover-preview-host"
    data-tmdb-id={String(tmdbId)}
    data-tmdb-type={tmdbType}
    data-title={title}
    data-backdrop={backdrop}
    data-href={href}
    data-year={year ? String(year) : ''}
    data-rating={rating ? rating.toFixed(1) : ''}
>
    <slot />
</div>

<style is:global>
    .hover-preview-host {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        position: relative;
    }
    .hover-preview-host > *:not(.hover-preview-overlay) {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
    }

    /* Estilos comunes desktop + mobile (size se ajusta abajo en media queries) */
    .hover-preview-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            z-index: 8999;
            opacity: 0;
            pointer-events: auto;
            cursor: pointer;
            transition: opacity 280ms ease;
        }
        .hover-preview-backdrop.is-visible { opacity: 1; }

        .hover-preview-overlay {
            position: fixed;
            top: 50%;
            left: 50%;
            width: 70vw;
            max-width: 900px;
            background: #0a0a0a;
            border-radius: 14px;
            box-shadow: 0 35px 80px -10px rgba(0, 0, 0, 0.75);
            overflow: hidden;
            z-index: 9000;
            opacity: 0;
            transform: translate(-50%, -50%) scale(0.7);
            transform-origin: center center;
            pointer-events: auto;
            cursor: pointer;
        }
        .hover-preview-overlay.is-visible {
            animation: hp-center-in 380ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        @keyframes hp-center-in {
            0%   { opacity: 0; transform: translate(-50%, -50%) scale(0.7); }
            60%  { opacity: 1; }
            100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
        }
        .hover-preview-media {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            background: #000;
            overflow: hidden;
        }
        .hover-preview-media iframe,
        .hover-preview-media img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            border: 0;
        }
        /* Mask negro inicial mientras carga el iframe (tapa controles de autoplay de YouTube) */
        .hover-preview-media .hp-loading-mask {
            position: absolute;
            inset: 0;
            background: #0a0a0a;
            z-index: 3;
            opacity: 1;
            transition: opacity 500ms ease;
            pointer-events: none;
        }
        .hover-preview-media .hp-loading-mask.is-hidden { opacity: 0; }
        .hover-preview-info {
            padding: 8px 10px;
            color: #fff;
            background: linear-gradient(0deg, rgba(0,0,0,0.92), rgba(0,0,0,0.55));
            font-size: 11px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }
        .hover-preview-info .hp-titlewrap {
            min-width: 0;
            flex: 1;
        }
        .hover-preview-info .hp-title {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-weight: 600;
            font-size: 12px;
            line-height: 1.25;
        }
        .hover-preview-info .hp-meta {
            display: flex;
            gap: 8px;
            margin-top: 2px;
            font-size: 10px;
            color: rgba(255,255,255,0.75);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .hover-preview-info .hp-rating { color: #fcd34d; }
        .hover-preview-mute {
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.3);
            color: #fff;
            border-radius: 9999px;
            width: 24px;
            height: 24px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            flex-shrink: 0;
        }
        .hover-preview-mute:hover { background: rgba(255,255,255,0.3); }

        .hover-preview-close {
            position: absolute;
            top: 12px;
            right: 12px;
            z-index: 4;
            width: 32px;
            height: 32px;
            border-radius: 9999px;
            background: rgba(0, 0, 0, 0.65);
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background 150ms ease;
        }
        .hover-preview-close:hover { background: rgba(0, 0, 0, 0.9); }

        .hover-preview-cta {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: #E63946;
            color: #fff;
            border: 0;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: background 150ms ease;
            flex-shrink: 0;
        }
        .hover-preview-cta:hover { background: #dc2626; }

    /* Ocultar badges del card original durante el preview, solo dentro del host */
    .hover-preview-host.is-previewing > :not(.hover-preview-overlay) [data-card-badge] {
        opacity: 0;
        transition: opacity 150ms;
    }

    /* Mobile: preview más grande proporcionalmente (90vw vs 70vw desktop) */
    @media (max-width: 1023px) {
        .hover-preview-overlay {
            width: 90vw;
            max-width: 90vw;
            border-radius: 12px;
        }
        .hover-preview-cta {
            padding: 8px 14px;
            font-size: 13px;
        }
        .hover-preview-close {
            width: 36px;
            height: 36px;
        }
    }

    /* Respetar prefers-reduced-motion: sin scale, solo fade */
    @media (prefers-reduced-motion: reduce) {
        .hover-preview-overlay.is-visible {
            animation: none !important;
            opacity: 1 !important;
            transform: translate(-50%, -50%) scale(1) !important;
            transition: opacity 200ms ease;
        }
    }
</style>
