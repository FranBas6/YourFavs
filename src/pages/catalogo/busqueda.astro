---
import Layout from "../../layouts/Layout.astro";
import CatalogHeader from "../../components/CatalogHeader.astro";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import CardActor from "../../components/Cards/CardActor.astro";
import {getMoviesByTitle} from "../../services/API/Movies/tmdbMovies";
import {getSeriesByTitle} from "../../services/API/Series/tmdbSeries";
import {getActorsByName} from "../../services/API/Actors/tmdbActor";
import {getGenreName} from "../../utils/constants/genres";
import {posterUrl} from "../../services/API/shared/tmdbClient";
import {loadAllPages} from "../../utils/loadAllPages";
import {safeFetch} from "../../utils/safeFetch";
import EmptyState from "../../components/EmptyState.astro";
import HoverPreview from "../../components/HoverPreview.astro";
import { withMode } from "../../utils/catalogUrl";
import '../../styles/pages/catalogo/shared.css';

const queryParams = new URLSearchParams(Astro.request.url.split('?')[1]);
const title = (queryParams.get('query') || '').trim();
// Sin término no se busca nada (antes se pedían las tres búsquedas vacías y salía «Sin resultados para ""»):
// se enseña el buscador.
const hasQuery = title.length > 0;

const [allMovies, allSeries, allActors] = !hasQuery ? [[], [], []] as any[][] : await Promise.all([
    safeFetch(
        loadAllPages(({title, page}) => getMoviesByTitle({title, page}), title, "title", 2),
        'busqueda/movies', [] as any[]
    ),
    safeFetch(
        loadAllPages(({title, page}) => getSeriesByTitle({title, page}), title, "title", 2),
        'busqueda/series', [] as any[]
    ),
    safeFetch(
        loadAllPages(({name, page}) => getActorsByName({name, page}), title, "name", 2),
        'busqueda/actors', [] as any[]
    ),
]);

// Rediseño 3.5: 2 páginas de TMDB por tipo (antes 5: ~15 llamadas y 160 resultados de golpe, 37.000 px
// en móvil). Se enseñan PAGE por sección y «Mostrar más» destapa los siguientes.
const limitedMovies = allMovies.slice(0, 40);
const limitedSeries = allSeries.slice(0, 40);
const limitedActors = allActors.slice(0, 20);
const PAGE = 10;
const totalResults = limitedMovies.length + limitedSeries.length + limitedActors.length;
---
<Layout title={hasQuery ? `Búsqueda: ${title}` : 'Buscar'}>
    <section class="px-1 sm:py-8">
        <CatalogHeader
            kicker={hasQuery ? 'Resultados para' : 'Buscar'}
            title={hasQuery ? `"${title}"` : 'Películas, series y personas'}
            color="slate"
            icon="search"
        />

        {totalResults > 0 && (
            <div class="-mt-4 mb-6 flex flex-wrap items-center gap-2">
                <span class="text-sm text-gray-500">{totalResults} resultados</span>
                <span class="text-gray-300">·</span>
                {limitedMovies.length > 0 && (
                    <span class="text-xs px-2.5 py-1 bg-red-50 text-red-600 rounded-full font-medium">{limitedMovies.length} películas</span>
                )}
                {limitedSeries.length > 0 && (
                    <span class="text-xs px-2.5 py-1 bg-blue-50 text-blue-600 rounded-full font-medium">{limitedSeries.length} series</span>
                )}
                {limitedActors.length > 0 && (
                    <span class="text-xs px-2.5 py-1 bg-purple-50 text-purple-600 rounded-full font-medium">{limitedActors.length} actores</span>
                )}
            </div>
        )}

        <!-- Navegación por secciones -->
        {totalResults > 0 && (
            <div class="flex justify-center sticky top-4 z-40 mb-8">
                <div class="inline-flex gap-1 bg-gray-100 rounded-xl p-1">
                    {limitedMovies.length > 0 && (
                        <a href="#peliculas" class="search-section-btn flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-sm font-medium text-gray-500 hover:bg-white hover:text-red-600 hover:shadow-sm transition-all" data-section="peliculas">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4"/>
                            </svg>
                            Películas
                        </a>
                    )}
                    {limitedSeries.length > 0 && (
                        <a href="#series" class="search-section-btn flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-sm font-medium text-gray-500 hover:bg-white hover:text-blue-600 hover:shadow-sm transition-all" data-section="series">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                            Series
                        </a>
                    )}
                    {limitedActors.length > 0 && (
                        <a href="#actores" class="search-section-btn flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-sm font-medium text-gray-500 hover:bg-white hover:text-purple-600 hover:shadow-sm transition-all" data-section="actores">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            Actores
                        </a>
                    )}
                </div>
            </div>
        )}

        {!hasQuery ? (
            <form action="/catalogo/busqueda" method="get" role="search" class="srch-empty">
                <label for="srch-empty-q" class="sr-only">Buscar películas, series y personas</label>
                <input id="srch-empty-q" name="query" type="search" autocomplete="off" autofocus required
                       placeholder="Título, serie o persona…" class="srch-empty-input" />
                <button type="submit" class="pf-btn pri">Buscar</button>
                <p class="srch-empty-hint">También puedes buscar desde cualquier página con <kbd>⌘K</kbd> (o <kbd>Ctrl K</kbd>).</p>
            </form>
        ) : totalResults === 0 ? (
            <EmptyState
                variant="search"
                size="lg"
                title={`Sin resultados para "${title}"`}
                description="Prueba con otro término o revisa la ortografía."
            >
                <a slot="cta" href="/" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800 transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    Volver al inicio
                </a>
                <a slot="cta" href={withMode("/catalogo/tendencias", Astro.locals.catalogMode)} class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#E63946] text-white rounded-lg text-sm font-medium hover:bg-[#C7283A] transition-all">
                    Explorar tendencias
                </a>
            </EmptyState>
        ) : (
            <div class="space-y-12">
                {/* Películas */}
                {limitedMovies.length > 0 && (
                    <section id="peliculas" class="scroll-mt-20">
                        <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                            <span class="w-1 h-6 bg-red-500 rounded-full"></span>
                            Películas
                            <span class="text-sm font-normal text-gray-400 ml-1">({limitedMovies.length})</span>
                        </h2>
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                            {limitedMovies.map((item, i) => (
                                <div class="card-wrapper group" hidden={i >= PAGE} data-srch-item>
                                    <HoverPreview tmdbId={item.id} tmdbType="movie" title={item.title} backdropPath={item.backdrop_path} href={`/movie/${item.id}`} year={item.release_date?.slice(0,4)} rating={item.vote_average}>
                                        <CardMovie
                                            id={item.id.toString()}
                                            img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                            title={item.title}
                                            vote_average={item.vote_average}
                                            overview={item.overview}
                                            release_date={item.release_date}
                                            genres={item.genre_ids?.map((id: number) => ({id, name: getGenreName(id)}))}
                                        />
                                    </HoverPreview>
                                </div>
                            ))}
                        </div>
                        {limitedMovies.length > PAGE && (
                            <div class="srch-more-wrap">
                                <button type="button" class="btn" data-srch-more>Mostrar más <span class="srch-more-n">· quedan {limitedMovies.length - PAGE}</span></button>
                            </div>
                        )}
                    </section>
                )}

                {/* Series */}
                {limitedSeries.length > 0 && (
                    <section id="series" class="scroll-mt-20">
                        <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                            <span class="w-1 h-6 bg-blue-500 rounded-full"></span>
                            Series
                            <span class="text-sm font-normal text-gray-400 ml-1">({limitedSeries.length})</span>
                        </h2>
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                            {limitedSeries.map((item, i) => (
                                <div class="card-wrapper group" hidden={i >= PAGE} data-srch-item>
                                    <HoverPreview tmdbId={item.id} tmdbType="tv" title={item.name} backdropPath={item.backdrop_path} href={`/serie/${item.id}`} year={item.first_air_date?.slice(0,4)} rating={item.vote_average}>
                                        <CardSerie
                                            id={item.id.toString()}
                                            img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                            name={item.name}
                                            vote_average={item.vote_average}
                                            overview={item.overview}
                                            first_air_date={item.first_air_date}
                                            genres={item.genre_ids?.map((id: number) => ({id, name: getGenreName(id)}))}
                                            last_episode_to_air={item.last_episode_to_air}
                                            next_episode_to_air={item.next_episode_to_air}
                                        />
                                    </HoverPreview>
                                </div>
                            ))}
                        </div>
                        {limitedSeries.length > PAGE && (
                            <div class="srch-more-wrap">
                                <button type="button" class="btn" data-srch-more>Mostrar más <span class="srch-more-n">· quedan {limitedSeries.length - PAGE}</span></button>
                            </div>
                        )}
                    </section>
                )}

                {/* Actores */}
                {limitedActors.length > 0 && (
                    <section id="actores" class="scroll-mt-20">
                        <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                            <span class="w-1 h-6 bg-purple-500 rounded-full"></span>
                            Actores
                            <span class="text-sm font-normal text-gray-400 ml-1">({limitedActors.length})</span>
                        </h2>
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                            {limitedActors.map((item, i) => (
                                <div class="card-wrapper group" hidden={i >= PAGE} data-srch-item>
                                    <CardActor
                                        id={item.id.toString()}
                                        imagen={posterUrl(item.imagen) || "/placeholder-actor.jpg"}
                                        nombre={item.nombre}
                                        popularidad={item.popularidad}
                                        lugarNacimiento={item.lugarNacimiento || undefined}
                                        fechaNacimiento={item.fechaNacimiento || undefined}
                                    />
                                </div>
                            ))}
                        </div>
                        {limitedActors.length > PAGE && (
                            <div class="srch-more-wrap">
                                <button type="button" class="btn" data-srch-more>Mostrar más <span class="srch-more-n">· quedan {limitedActors.length - PAGE}</span></button>
                            </div>
                        )}
                    </section>
                )}
            </div>
        )}
    </section>
</Layout>

<script is:inline>
(function () {
    var colors = { peliculas: 'bg-red-500 text-white shadow-sm', series: 'bg-blue-500 text-white shadow-sm', actores: 'bg-purple-500 text-white shadow-sm' };
    var sections = document.querySelectorAll('section[id]');
    var btns = document.querySelectorAll('.search-section-btn');
    if (!sections.length || !btns.length) return;

    var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
            if (entry.isIntersecting) {
                btns.forEach(function (btn) {
                    var s = btn.getAttribute('data-section');
                    var active = colors[s] || '';
                    if (btn.getAttribute('data-section') === entry.target.id) {
                        active.split(' ').forEach(function (c) { btn.classList.add(c); });
                        btn.classList.remove('text-gray-500');
                    } else {
                        (colors[s] || '').split(' ').forEach(function (c) { btn.classList.remove(c); });
                        btn.classList.add('text-gray-500');
                    }
                });
            }
        });
    }, { rootMargin: '-20% 0px -60% 0px' });

    sections.forEach(function (s) { observer.observe(s); });
})();
</script>

<style>
    /* Búsqueda sin término (paso 1.4 del rediseño): el buscador, solo con tokens. */
    .srch-empty { display: flex; flex-wrap: wrap; gap: var(--s-2); max-width: 640px; margin: var(--s-4) 0 var(--s-8); }
    .srch-empty-input {
        flex: 1 1 260px; min-width: 0; height: 44px; padding: 0 var(--s-4);
        border: 1px solid var(--border-strong); border-radius: var(--r-md);
        background: var(--bg-elev); color: var(--text); font: inherit; font-size: 15px;
    }
    .srch-empty-input::placeholder { color: var(--text-4); }
    .srch-empty-input:focus { outline: 2px solid var(--primary); outline-offset: 2px; border-color: transparent; }
    .srch-empty-hint { flex-basis: 100%; margin: 0; font-size: 12px; color: var(--text-3); }
    .srch-empty-hint kbd { font-family: var(--font-mono); font-size: 11px; padding: 1px 5px; border: 1px solid var(--border-strong); border-radius: var(--r-sm); background: var(--bg-tint); }
    /* El display de las tarjetas le gana al [hidden] de Tailwind: aquí manda «Mostrar más». */
    [data-srch-item][hidden] { display: none !important; }
    .srch-more-wrap { display: flex; justify-content: center; margin-top: var(--s-6); }
    .srch-more-n { font: 500 var(--fs-micro) var(--font-mono); color: var(--text-3); }
</style>

<script>
    // Rediseño 3.5: «Mostrar más» destapa los siguientes resultados de su sección, de 10 en 10.
    const STEP = 10;
    document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest?.<HTMLButtonElement>('[data-srch-more]');
        if (!btn) return;
        const sec = btn.closest('section');
        const hidden = sec ? [...sec.querySelectorAll<HTMLElement>('[data-srch-item][hidden]')] : [];
        hidden.slice(0, STEP).forEach((el) => { el.hidden = false; });
        const left = hidden.length - STEP;
        if (left <= 0) btn.parentElement?.remove();
        else { const n = btn.querySelector('.srch-more-n'); if (n) n.textContent = `· quedan ${left}`; }
    });
</script>
