---
import Layout from "../../layouts/Layout.astro";
import ChatInterface from "../../components/Chat/ChatInterface";
---

<Layout title="YourChat - Chat con IA">
    <main class="container mx-auto px-2 md:px-4 py-4 md:py-8">
        <div class="text-center mb-4 md:mb-8">
            <h1 class="text-2xl md:text-4xl font-bold bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">
                YourChat
            </h1>
            <p class="text-gray-400 mt-2 text-sm md:text-base">
                Chatea con nuestra IA para descubrir películas y series
            </p>
        </div>
        
        <ChatInterface client:load />
        
        <div class="mt-4 md:mt-8 text-center text-xs md:text-sm text-gray-500">
            <p>💡 Powered by Google Gemini AI</p>
        </div>
    </main>
</Layout>