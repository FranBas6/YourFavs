---
import HeaderButton from "./HeaderButton.astro";
---

<header class="py-3 px-5 mx-auto w-full lg:py-10 lg:px-16 bg-gradient-to-r from-blue-600 to-blue-500 rounded-b-2xl shadow-lg">
    <div class="title-container">
        <a href="/personal" class="mb-3 text-4xl tracking-tight font-extrabold text-white animated-text title-3d" data-text="YourFavs">
          <h1>
            YourFavs
          </h1>
        </a>
    </div>

    <!-- Checkbox oculto para controlar la visibilidad del menú en móviles -->
    <input type="checkbox" id="nav-toggle" class="hidden">

    <!-- Label que actúa como botón para alternar el menú -->
    <label for="nav-toggle"
           class="cursor-pointer md:hidden flex items-center justify-center mx-auto text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg px-4 py-2 mt-2 mb-3 focus:outline-none focus:ring-2 focus:ring-indigo-300 transition-colors duration-300 shadow-md w-32">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24"
             stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        MENÚ
    </label>

    <!-- Nav con Sticky -->
    <nav class="flex flex-col items-center justify-center w-full rounded-xl bg-transparent text-center md:flex-row sticky-nav hidden md:flex"
         id="nav-menu">
        <HeaderButton href="/ultimoslanzamientos">
            <svg class="mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round" width="20" height="20" stroke-width="2">
                <path d="M4 13a8 8 0 0 1 7 7a6 6 0 0 0 3 -5a9 9 0 0 0 6 -8a3 3 0 0 0 -3 -3a9 9 0 0 0 -8 6a6 6 0 0 0 -5 3"></path>
                <path d="M7 14a6 6 0 0 0 -3 6a6 6 0 0 0 6 -3"></path>
                <path d="M15 9m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path>
            </svg>
            Últimos Lanzamientos
        </HeaderButton>
        <HeaderButton href="/maspopulares">
            <svg class="mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round" width="20" height="20" stroke-width="2">
                <path d="M12 12c2 -2.96 0 -7 -1 -8c0 3.038 -1.773 4.741 -3 6c-1.226 1.26 -2 3.24 -2 5a6 6 0 1 0 12 0c0 -1.532 -1.056 -3.94 -2 -5c-1.786 3 -2.791 3 -4 2z"></path>
            </svg>
            Más Populares
        </HeaderButton>
        <HeaderButton href="/topmovies">
            <svg class="mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="20" height="20"
                 stroke-width="2" stroke-linejoin="round" stroke-linecap="round" stroke="currentColor">
                <path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"></path>
                <path d="M8 4l0 16"></path>
                <path d="M16 4l0 16"></path>
                <path d="M4 8l4 0"></path>
                <path d="M4 16l4 0"></path>
                <path d="M4 12l16 0"></path>
                <path d="M16 8l4 0"></path>
                <path d="M16 16l4 0"></path>
            </svg>
            Películas
        </HeaderButton>
        <HeaderButton href="/topseries">
            <svg class="mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round" width="20" height="20" stroke-width="2">
                <path d="M3 7m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z"></path>
                <path d="M16 3l-4 4l-4 -4"></path>
            </svg>
            Series
        </HeaderButton>
        <HeaderButton href="/plataformas">
            <svg class="mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round" width="24" height="24" stroke-width="2">
                <path d="M2 8a4 4 0 0 1 4 -4h12a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-12a4 4 0 0 1 -4 -4v-8z"></path>
                <path d="M10 9l5 3l-5 3z"></path>
            </svg>
            Plataformas
        </HeaderButton>
        <HeaderButton href="/categorias">
            <svg class="mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round" width="20" height="20" stroke-width="2">
                <path d="M4 4h6v6h-6z"></path>
                <path d="M14 4h6v6h-6z"></path>
                <path d="M4 14h6v6h-6z"></path>
                <path d="M17 17m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path>
            </svg>
            Categorías
        </HeaderButton>
        <HeaderButton href="/personal">
            <svg class="mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="24" height="24"
                 stroke-width="2" stroke-linejoin="round" stroke-linecap="round" stroke="currentColor">
                <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"></path>
                <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"></path>
            </svg>
            Personal
        </HeaderButton>
        <!-- Buscador con botón -->
        <div class="flex items-center space-x-3">
            <form action="/busqueda" method="get" class="flex items-center relative">
                <!-- Input -->
                <input
                        name="query"
                        type="text"
                        placeholder="Buscar películas, series..."
                        class="w-64 xl:w-80 pl-10 pr-12 py-2.5 rounded-full border-0 bg-white/90 backdrop-blur-sm text-gray-800 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white/50 focus:bg-white transition-all duration-300 shadow-lg"
                        autocomplete="off"
                />

                <!-- Ícono de lupa dentro del input -->
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </div>

                <!-- Botón funcional -->
                <button type="submit" class="absolute right-1 top-1/2 -translate-y-1/2 p-2 rounded-full bg-indigo-600 text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-300 transition duration-200 shadow-md">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                    </svg>
                </button>
            </form>
        </div>

        <HeaderButton href="/about">
            <svg class="mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" stroke-width="2">
                <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path>
                <path d="M12 9h.01"></path>
                <path d="M11 12h1v4h1"></path>
            </svg>
            Yourfavs
        </HeaderButton>
    </nav>
</header>

<style is:global>
    .bg-midnight-blue {
        background-color: #006ea7;
    }

    .text-coral-red {
        color: #E63946;
        font-family: "Poppins", sans-serif;
    }

    .bg-ice-blue {
        background-color: #3B82F6;
    }

    .sticky-nav {
        position: sticky;
        top: 0;
        z-index: 1000;
        backdrop-filter: blur(8px);
        box-shadow: none;
        border-radius: 0.75rem;
        margin-top: 0.5rem;
        background: rgba(59, 130, 246, 0.1);
        transition: all 0.3s ease;
    }

    /* Agregamos efecto de sombra solo al hacer scroll */
    .sticky-nav.scrolled {
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        background: rgba(59, 130, 246, 0.85);
    }

    .bg-light-gray {
        background-color: #F3F4F6;
    }

    /* Estilos mejorados para el título YourFavs */
    .title-3d {
        position: relative;
        display: inline-block;
        text-transform: uppercase;
        font-weight: 800;
        letter-spacing: 1px;
        font-size: 3.5rem;
        background: linear-gradient(120deg, #f6d365 0%, #fda085 25%, #f5576c 50%, #4dabf7 75%, #3b82f6 100%);
        background-size: 400% 400%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.2),
        0 0 10px rgba(255, 255, 255, 0.3),
        0 0 20px rgba(59, 130, 246, 0.2);
        animation: float 6s ease-in-out infinite,
        gradientMove 12s ease infinite,
        pulse 3s infinite alternate;
        transform-style: preserve-3d;
        perspective: 500px;
    }

    .title-3d::before {
        content: attr(data-text);
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;
        color: transparent;
        text-shadow: 0 0 15px rgba(59, 130, 246, 0.5),
        0 0 20px rgba(255, 255, 255, 0.3);
        filter: blur(4px);
        transform: translateZ(-5px);
    }

    .title-3d::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 10%;
        width: 80%;
        height: 6px;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.7), transparent);
        border-radius: 50%;
        filter: blur(4px);
        opacity: 0.6;
    }

    @keyframes float {
        0%, 100% {
            transform: translateY(0) rotate(0deg) scale(1);
        }
        25% {
            transform: translateY(-8px) rotate(-1deg) scale(1.02);
        }
        50% {
            transform: translateY(-4px) rotate(1deg) scale(1);
        }
        75% {
            transform: translateY(-6px) rotate(0deg) scale(1.01);
        }
    }


    @keyframes colorChange {
        0% {
            color: #E63946;
        }
        25% {
            color: #FF5733;
        }
        50% {
            color: #FFC300;
        }
        75% {
            color: #DAF7A6;
        }
        100% {
            color: #E63946;
        }
    }

    @keyframes gradientMove {
        0% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
        100% {
            background-position: 0% 50%;
        }
    }

    @keyframes pulse {
        0% {
            filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.6));
        }
        100% {
            filter: drop-shadow(0 0 16px rgba(230, 57, 70, 0.8));
        }
    }

    .animated-text {
        background: linear-gradient(270deg, #FF5733, #E63946, #FF9F1C, #FFBF69);
        background-size: 300% 300%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: gradientMove 8s ease infinite;
    }

    /* Mostrar el menú cuando el checkbox está marcado */
    #nav-toggle:checked ~ #nav-menu {
        display: flex;
        animation: slideDown 0.3s ease-out forwards;
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Contenedor flexible para el título */
    .title-container {
        display: flex;
        justify-content: center;
        width: 100%;
        margin-bottom: 1rem;
    }

    /* Ajustes específicos para móviles */
    @media (max-width: 768px) {
        .title-3d {
            font-size: 2.75rem; /* Ajusta el tamaño en móviles */
            width: 100%;
            text-align: center;
            margin-left: auto;
            margin-right: auto;
        }

        /* Forzar centrado absoluto */
        .title-container {
            padding-left: 0;
            padding-right: 0;
            justify-content: center;
            align-items: center;
        }
    }

    /* Tamaño más pequeño para dispositivos muy pequeños */
    @media (max-width: 375px) {
        .title-3d {
            font-size: 2.25rem;
        }
    }

    /* Ajustes adicionales para el menú en móviles */
    @media (max-width: 768px) {
        #nav-menu {
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem;
            background: rgba(59, 130, 246, 0.95);
            backdrop-filter: blur(8px);
            border-radius: 0.75rem;
            margin-top: 0.5rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
    }
</style>