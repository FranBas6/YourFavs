---
import Layout from "../../layouts/Layout.astro"
import { getActorsFav } from "../../services/BD/actors/yourfavsActor";
import { getActorDetailsById, getMoviesAndSeriesByActorId } from "../../services/API/Actors/InfoActor";
import { calculateAge, processProductions } from "../../utils/constants/helpers/actor-helpers";
import { posterUrl } from "../../services/API/shared/tmdbClient";
import { calculateTopActors } from "../../utils/topActorsLibrary";
import PersonalNav from "../../components/personal/PersonalNav.astro";
import EmptyState from "../../components/EmptyState.astro";
import type { Movie } from "../../types/ApiMovie";
import type { Serie } from "../../types/ApiSerie";

type ActorDetailsData = NonNullable<Awaited<ReturnType<typeof getActorDetailsById>>>;

interface ActorDetail {
    id: string;
    position: number;
    details: ActorDetailsData;
    age: number | null;
    totalMovies: number;
    totalSeries: number;
    releasedMovies: Movie[];
    releasedSeries: Serie[];
    upcomingMovies: Movie[];
    upcomingSeries: Serie[];
}

let actorsWithDetails: ActorDetail[] = [];
let errorMessage = "";
let topLibraryActors: Awaited<ReturnType<typeof calculateTopActors>> = [];

try {
    topLibraryActors = await calculateTopActors(10);
} catch (error) {
    console.error("Error al calcular top actores de la biblioteca:", error);
}

try {
    const actorsFav = await getActorsFav();

    const rawResults = await Promise.all(
        actorsFav.map(async (fav: { id: string; position: number }) => {
            try {
                const [actorDetails, { movies, series }] = await Promise.all([
                    getActorDetailsById({ id: fav.id }),
                    getMoviesAndSeriesByActorId({ id: fav.id }),
                ]);
                if (!actorDetails) return null;

                const { released: releasedMovies, upcoming: upcomingMovies } = processProductions(movies, 'release_date', 9);
                const { released: releasedSeries, upcoming: upcomingSeries } = processProductions(series, 'first_air_date', 9);

                return {
                    id: fav.id,
                    position: fav.position,
                    details: actorDetails,
                    age: calculateAge(actorDetails.fechaNacimiento),
                    totalMovies: movies.length,
                    totalSeries: series.length,
                    releasedMovies,
                    releasedSeries,
                    upcomingMovies,
                    upcomingSeries,
                };
            } catch {
                return null;
            }
        })
    );

    // Filtrar nulos (actores no encontrados en TMDB)
    actorsWithDetails = rawResults.filter((actor: ActorDetail | null): actor is ActorDetail => actor !== null);
} catch (error) {
    console.error("Error al cargar actores favoritos:", error);
    errorMessage = error instanceof Error ? error.message : "Error desconocido";
}
---
<Layout title="Actores Favoritos">
    <section class="px-1 sm:py-8">
        {errorMessage && (
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm mb-6">
                {errorMessage}
            </div>
        )}

        <header class="mb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Actores Favoritos</h1>
            <p class="text-gray-500 text-base">{actorsWithDetails.length} actores en tu colección</p>
        </header>

        <div class="mb-4">
            <PersonalNav currentPage="/personal/actores" />
        </div>

        {topLibraryActors.length > 0 && (
            <section class="mb-8">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-rose-500 rounded-full"></span>
                    Top actores en tu biblioteca
                    <span class="text-sm font-normal text-gray-400">según pelis y series que has añadido</span>
                </h2>
                <div class="flex gap-3 overflow-x-auto pb-3 -mx-1 px-1 snap-x snap-mandatory">
                    {topLibraryActors.map((a, idx) => (
                        <a href={`/actor/${a.id}`} class="snap-start group flex-shrink-0 w-32 sm:w-36">
                            <div class="relative aspect-[2/3] rounded-xl overflow-hidden shadow-md group-hover:shadow-xl transition bg-gray-200">
                                {a.profile_path ? (
                                    <img src={posterUrl(a.profile_path, 'w185') || ''} alt={a.name} loading="lazy" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"/>
                                ) : (
                                    <div class="w-full h-full flex items-center justify-center text-gray-400 text-4xl">👤</div>
                                )}
                                <span class="absolute top-2 left-2 w-7 h-7 flex items-center justify-center text-sm font-bold rounded-full bg-rose-500 text-white shadow-lg">{idx + 1}</span>
                                <span class="absolute bottom-2 right-2 text-[10px] font-bold px-2 py-0.5 rounded-full bg-black/70 text-rose-300">×{a.appearances}</span>
                            </div>
                            <div class="mt-2 text-sm font-semibold text-gray-800 line-clamp-1">{a.name}</div>
                            <div class="text-[11px] text-gray-500">
                                {a.movies > 0 && <span>{a.movies} 🎬</span>}
                                {a.movies > 0 && a.series > 0 && <span class="mx-1">·</span>}
                                {a.series > 0 && <span>{a.series} 📺</span>}
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        )}

        {actorsWithDetails.length === 0 && (
            <EmptyState
                size="md"
                title="No tienes actores favoritos"
                description="Busca actores y añádelos desde su perfil para verlos aquí."
            >
                <a slot="cta" href="/catalogo/tendencias?type=person" class="inline-flex items-center gap-2 px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors text-sm font-medium">Ver actores en tendencia</a>
            </EmptyState>
        )}

        <div class="space-y-3">
            {actorsWithDetails.map((actor) => (
                <details class="group bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow overflow-hidden">
                    <summary class="flex items-center gap-4 p-4 cursor-pointer">
                        <img
                            src={actor.details.imagen ? posterUrl(actor.details.imagen, 'w185') : '/placeholder-actor.png'}
                            alt={actor.details.nombre}
                            class="w-14 h-14 rounded-full object-cover border-2 border-gray-200 flex-shrink-0"
                            loading="lazy"
                        />
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1">
                                <h3 class="text-base font-semibold text-gray-900 truncate">{actor.details.nombre}</h3>
                                <span class="text-xs text-gray-4000 flex-shrink-0">#{actor.position}</span>
                            </div>
                            <div class="flex flex-wrap gap-1.5 text-xs">
                                {actor.age && (
                                    <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded-full">{actor.age} años</span>
                                )}
                                <span class="px-2 py-0.5 bg-purple-50 text-purple-600 rounded-full">{actor.totalMovies + actor.totalSeries} producciones</span>
                                {actor.details.popularidad && (
                                    <span class="px-2 py-0.5 bg-yellow-50 text-yellow-700 rounded-full">⭐ {actor.details.popularidad.toFixed(1)}</span>
                                )}
                            </div>
                        </div>
                        <svg class="w-5 h-5 text-gray-4000 transition-transform group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </summary>

                    <div class="px-4 pb-4 border-t border-gray-100 space-y-5 pt-4">
                        <!-- Foto grande -->
                        <div class="flex justify-center">
                            <img
                                src={actor.details.imagen ? posterUrl(actor.details.imagen) : '/placeholder-actor.png'}
                                alt={actor.details.nombre}
                                class="w-36 h-36 rounded-full object-cover border-4 border-gray-100 shadow-lg"
                                loading="lazy"
                            />
                        </div>

                        <!-- Próximas producciones -->
                        {(actor.upcomingMovies.length > 0 || actor.upcomingSeries.length > 0) && (
                            <div>
                                <h4 class="text-sm font-semibold text-gray-700 mb-2 flex items-center gap-1.5">
                                    <span class="w-1 h-4 bg-green-500 rounded-full"></span>
                                    Próximamente
                                </h4>
                                <div class="flex gap-2.5 overflow-x-auto pb-2">
                                    {[...actor.upcomingMovies, ...actor.upcomingSeries].map((prod: Movie | Serie) => {
                                        const title = 'title' in prod ? prod.title : prod.name;
                                        const isMovie = 'title' in prod;
                                        return (
                                        <a href={isMovie ? `/movie/${prod.id}` : `/serie/${prod.id}`}
                                           class="flex-shrink-0 w-24 group/prod">
                                            <div class="relative rounded-lg overflow-hidden shadow-sm group-hover/prod:shadow-md transition-shadow">
                                                <img src={posterUrl(prod.poster_path, 'w185') || '/placeholder.jpg'}
                                                     alt={title}
                                                     class="w-full h-36 object-cover"/>
                                                <span class="absolute top-1 left-1 text-[10px] font-bold px-1.5 py-0.5 bg-green-500 text-white rounded">Próximo</span>
                                            </div>
                                            <p class="mt-1 text-xs text-gray-600 line-clamp-2 leading-tight">{title}</p>
                                        </a>
                                        );
                                    })}
                                </div>
                            </div>
                        )}

                        <!-- Películas -->
                        {actor.releasedMovies.length > 0 && (
                            <div>
                                <h4 class="text-sm font-semibold text-gray-700 mb-2 flex items-center gap-1.5">
                                    <span class="w-1 h-4 bg-red-500 rounded-full"></span>
                                    Películas ({actor.releasedMovies.length})
                                </h4>
                                <div class="flex gap-2.5 overflow-x-auto pb-2">
                                    {actor.releasedMovies.map((movie) => (
                                        <a href={`/movie/${movie.id}`} class="flex-shrink-0 w-24 group/prod">
                                            <div class="relative rounded-lg overflow-hidden shadow-sm group-hover/prod:shadow-md transition-shadow">
                                                <img src={posterUrl(movie.poster_path, 'w185') || '/placeholder.jpg'}
                                                     alt={movie.title}
                                                     class="w-full h-36 object-cover"/>
                                                {movie.vote_average > 0 && (
                                                    <span class="absolute top-1 right-1 text-[10px] font-bold px-1.5 py-0.5 bg-black/60 text-yellow-400 rounded">⭐ {movie.vote_average.toFixed(1)}</span>
                                                )}
                                            </div>
                                            <p class="mt-1 text-xs text-gray-600 line-clamp-2 leading-tight">{movie.title}</p>
                                            <p class="text-[10px] text-gray-4000">{movie.release_date ? new Date(movie.release_date).getFullYear() : ''}</p>
                                        </a>
                                    ))}
                                </div>
                            </div>
                        )}

                        <!-- Series -->
                        {actor.releasedSeries.length > 0 && (
                            <div>
                                <h4 class="text-sm font-semibold text-gray-700 mb-2 flex items-center gap-1.5">
                                    <span class="w-1 h-4 bg-blue-500 rounded-full"></span>
                                    Series ({actor.releasedSeries.length})
                                </h4>
                                <div class="flex gap-2.5 overflow-x-auto pb-2">
                                    {actor.releasedSeries.map((serie) => (
                                        <a href={`/serie/${serie.id}`} class="flex-shrink-0 w-24 group/prod">
                                            <div class="relative rounded-lg overflow-hidden shadow-sm group-hover/prod:shadow-md transition-shadow">
                                                <img src={posterUrl(serie.poster_path, 'w185') || '/placeholder.jpg'}
                                                     alt={serie.name}
                                                     class="w-full h-36 object-cover"/>
                                                {serie.vote_average > 0 && (
                                                    <span class="absolute top-1 right-1 text-[10px] font-bold px-1.5 py-0.5 bg-black/60 text-yellow-400 rounded">⭐ {serie.vote_average.toFixed(1)}</span>
                                                )}
                                            </div>
                                            <p class="mt-1 text-xs text-gray-600 line-clamp-2 leading-tight">{serie.name}</p>
                                            <p class="text-[10px] text-gray-4000">{serie.first_air_date ? new Date(serie.first_air_date).getFullYear() : ''}</p>
                                        </a>
                                    ))}
                                </div>
                            </div>
                        )}

                        <!-- Ver perfil -->
                        <div class="text-center pt-2">
                            <a href={`/actor/${actor.id}`}
                               class="inline-flex items-center gap-2 px-5 py-2 text-sm font-medium text-white bg-gray-900 rounded-lg hover:bg-gray-800 transition-all">
                                Ver perfil completo
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </details>
            ))}
        </div>
    </section>
</Layout>
