                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             class="h-16 w-16 mx-auto text-blue-400 mb-4" fill="none"
                                             viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                                  d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                                        </svg>
                                        <h3 class="text-xl font-semibold text-blue-800 mb-2">
                                            {searchQuery || genreFilter ? 'No se encontraron series' : '¡Comienza tu colección!'}
                                        </h3>
                                        <p class="text-blue-600">
                                            {searchQuery || genreFilter ?
                                                'Intenta ajustar los filtros de búsqueda.' :
                                                'Explora nuestro catálogo y marca las series que te gustan.'
                                            }
                                        </p>
                                    </div>
                                </div>
                        ) : (
                                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                                    {seriesPaginadas.map((item) => (
                                            <CardSerie
                                                    id={item.id.toString()}
                                                    img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                    name={item.name}
                                                    vote_average={item.vote_average}
                                                    overview={item.overview}
                                                    first_air_date={item.first_air_date}
                                                    seasons={item.seasons}
                                                    last_episode_to_air={item.last_episode_to_air}
                                                    next_episode_to_air={item.next_episode_to_air}
                                                    genres={item.genre_ids?.map((id: number) => ({
                                                        id,
                                                        name: getGenreName(id)
                                                    }))}
                                                    status={item.status}
                                            />
                                    ))}
                                </div>
                        )}
                        {hasMoreSeries && (
                            <div class="flex justify-center mt-8">
                                <a 
                                    href={buildUrl({
                                        filter: filter,
                                        search: searchQuery,
                                        genre: genreFilter,
                                        seriesPage: (seriesPage + 1).toString(),
                                        moviesPage: moviesPage.toString()
                                    }) + '#series-section'}
                                    class="px-8 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-xl hover:from-blue-700 hover:to-indigo-700 transition-all font-semibold flex items-center gap-2 shadow-lg hover:scale-105"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                    </svg>
                                    Mostrar más series ({Math.min(ITEMS_PER_PAGE, likedSeries.length - seriesItemsToShow)} más)
                                </a>
                            </div>
                        )}
                    </section>
            )}

            {/* Películas Favoritas */}
            {(showMovies || showAll) && (
                <section id="movies-section" class="mb-8 scroll-mt-24">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4 flex justify-between items-center bg-red-50 rounded-lg px-4 py-3 border-l-4 border-red-500">
                            <span class="flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-600" fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                </svg>
                                Películas Me Gustan
                            </span>
                            <span class="text-sm text-red-600 bg-red-100 rounded-full px-3 py-1 font-bold">
                                {peliculasPaginadas.length}
                                {searchQuery || genreFilter ? ` de ${likedMovies.length}` : ` de ${likedMovies.length}`}
                            </span>
                        </h3>

                        {peliculasPaginadas.length === 0 ? (
                                <div class="empty-state bg-gradient-to-br from-red-50 to-indigo-50 border-2 border-dashed border-red-200 rounded-xl p-8 text-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-red-400 mb-4"
                                         fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                              d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                                    </svg>
                                    <h3 class="text-xl font-semibold text-red-800 mb-2">
                                        {searchQuery || genreFilter ? 'No se encontraron películas' : '¡Comienza tu colección!'}
                                    </h3>
                                    <p class="text-red-600">
                                        {searchQuery || genreFilter ?
                                            'Intenta ajustar los filtros de búsqueda.' :
                                            'Explora nuestro catálogo y marca las películas que te gustan.'
                                        }
                                    </p>
                                </div>
                        ) : (
                                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                                    {peliculasPaginadas.map((item) => (
                                            <CardMovie
                                                    id={item.id.toString()}
                                                    img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                    title={item.title}
                                                    vote_average={item.vote_average}
                                                    overview={item.overview}
                                                    release_date={item.release_date}
                                                    genres={item.genre_ids?.map((id: number) => ({
                                                        id,
                                                        name: getGenreName(id)
                                                    }))}
                                            />
                                    ))}
                                </div>
                        )}
                        {hasMoreMovies && (
                            <div class="flex justify-center mt-8">
                                <a 
                                    href={buildUrl({
                                        filter: filter,
                                        search: searchQuery,
                                        genre: genreFilter,
                                        seriesPage: seriesPage.toString(),
                                        moviesPage: (moviesPage + 1).toString()
                                    }) + '#movies-section'}
                                    class="px-8 py-3 bg-gradient-to-r from-red-600 to-pink-600 text-white rounded-xl hover:from-red-700 hover:to-pink-700 transition-all font-semibold flex items-center gap-2 shadow-lg hover:scale-105"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                    </svg>
                                    Mostrar más películas ({Math.min(ITEMS_PER_PAGE, likedMovies.length - moviesItemsToShow)} más)
                                </a>
                            </div>
                        )}
                    </section>
            )}
        </div>
    </div>
</div>

<style>
    /* Animaciones */
    .animate-fadeIn {
        animation: fadeIn 0.5s ease-in-out;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Aumentar el tamaño de las tarjetas al pasar el mouse */
    :global(.favorites-container .grid > div) {
        transition: all 0.3s ease;
    }

    :global(.favorites-container .grid > div:hover) {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }

    .section-title {
        @apply text-xl font-semibold mb-4 pl-4 border-l-4;
    }

    /* Transición suave para el chevron */
    .chevron {
        transition: transform 0.3s ease;
    }

    .rating-slider {
        -webkit-appearance: none;
        width: 100%;
        height: 8px;
        background: linear-gradient(90deg, #6366f1 0%, #a5b4fc 100%);
        border-radius: 4px;
        outline: none;
        transition: background 0.3s;
    }

    .rating-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #fff;
        border: 3px solid #6366f1;
        box-shadow: 0 2px 8px rgba(99, 102, 241, 0.2);
        cursor: pointer;
        transition: border 0.2s, box-shadow 0.2s;
    }

    .rating-slider:focus::-webkit-slider-thumb {
        border: 3px solid #a5b4fc;
        box-shadow: 0 0 0 4px #6366f133;
    }

    .rating-slider::-moz-range-thumb {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #fff;
        border: 3px solid #6366f1;
        box-shadow: 0 2px 8px rgba(99, 102, 241, 0.2);
        cursor: pointer;
        transition: border 0.2s, box-shadow 0.2s;
    }

    .rating-slider:focus::-moz-range-thumb {
        border: 3px solid #a5b4fc;
        box-shadow: 0 0 0 4px #6366f133;
    }

    .rating-slider::-ms-thumb {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #fff;
        border: 3px solid #6366f1;
        box-shadow: 0 2px 8px rgba(99, 102, 241, 0.2);
        cursor: pointer;
        transition: border 0.2s, box-shadow 0.2s;
    }

    .rating-slider:focus::-ms-thumb {
        border: 3px solid #a5b4fc;
        box-shadow: 0 0 0 4px #6366f133;
    }

    .rating-slider::-ms-fill-lower {
        background: #6366f1;
    }

    .rating-slider::-ms-fill-upper {
        background: #a5b4fc;
    }

    .rating-slider:focus {
        outline: none;
    }
    /* Scroll horizontal suave para navegación */
    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }

    /* Transiciones más suaves */
    .content-sections > div {
        transition: all 0.3s ease-out;
    }

    /* Grid más consistente */
    .grid {
        gap: 1.25rem;
    }

    @media (min-width: 768px) {
        .grid {
            gap: 1.5rem;
        }
    }

    /* Ocultar el checkbox de estadísticas */
    .stats-toggle {
        display: none;
    }

    /* Panel de estadísticas inicialmente oculto */
    .stats-panel {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition: opacity 0.4s ease, max-height 0.4s ease;
        pointer-events: none;
    }

    /* Mostrar panel cuando el checkbox está marcado */
    .stats-toggle:checked + .stats-button-container + .stats-panel {
        max-height: 3000px;
        opacity: 1;
        pointer-events: all;
        overflow: visible;
    }

    /* Rotar la flecha cuando está abierto */
    .stats-toggle:checked + .stats-button-container .stats-chevron {
        transform: rotate(180deg);
    }

    /* Cambiar color del botón cuando está activo */
    .stats-toggle:checked + .stats-button-container .stats-toggle-btn {
        background: linear-gradient(135deg, #7c3aed, #ec4899);
        transform: scale(1.02);
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.3);
    }

    /* Animación del contenido */
    .stats-content {
        transform: translateY(-10px);
        transition: transform 0.3s ease-out 0.1s;
    }

    .stats-toggle:checked + .stats-button-container + .stats-panel .stats-content {
        transform: translateY(0);
    }

    /* Efectos hover en las tarjetas de estadísticas */
    .stat-card:hover {
        transform: translateY(-2px);
    }

    .stats-toggle-btn:hover {
        transform: scale(1.05);
    }

    .stats-toggle-btn:hover .stats-text {
        letter-spacing: 0.02em;
    }

    /* Transición suave para el chevron de estadísticas */
    .stats-chevron {
        transition: transform 0.3s ease;
    }

    /* Responsivo para móviles */
    @media (max-width: 640px) {
        .stats-panel {
            margin: 1rem;
        }

        .stats-content {
            padding: 1rem !important;
        }

        .detailed-stats,
        .popularity-stats {
            grid-template-columns: 1fr;
        }

        .general-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* Mejoras visuales adicionales */
    .series-stats, .movies-stats, .top-genres, .top-decades {
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .visual-summary {
        backdrop-filter: blur(10px);
        border: 1px solid rgba(147, 51, 234, 0.1);
    }
</style>