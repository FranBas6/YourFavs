---
import Header from "../components/Header.astro";
import CommandPalette from "../components/CommandPalette.astro";
import "../styles/tokens.css";
import "../styles/layout.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/dark-mode.css";   // <- el ÚLTIMO: las reglas [data-theme="dark"] ganan en cascada

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    ogType?: string;
}

const {
    title,
    description = "Tu plataforma favorita para descubrir películas y series",
    ogImage = "/og-image.png",
    ogType = "website",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link rel="icon" type="image/svg+xml" href="/logo_yourfavs.png"/>
    <meta name="generator" content={Astro.generator}/>
    <meta name="description" content={description}/>
    <meta name="theme-color" content="#3B82F6"/>
    <link rel="canonical" href={Astro.url.href}/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <meta property="og:image" content={ogImage}/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={ogImage}/>
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F3F4F6"/>
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0B1220"/>
    <script is:inline>
        (function () {
            try {
                // Default = claro (ignora el modo oscuro del SO). Solo se usa
                // oscuro si el usuario lo eligió explícitamente con el toggle.
                var saved = localStorage.getItem('theme');
                var theme = saved || 'light';
                document.documentElement.setAttribute('data-theme', theme);
            } catch {}
        })();
    </script>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:type" content={ogType}/>
    <title>{title}</title>
</head>
<body id="top" class="bg-light-gray min-h-screen pb-16 sm:pb-24 md:pb-32 font-poppins">
<a href="#content" class="skip-link">Saltar al contenido</a>
<Header/>
<CommandPalette/>
<main id="content" class="max-w-7xl w-full px-3 sm:px-6 lg:px-8 mx-auto pt-4 sm:pt-6 md:pt-8 lg:pt-10">
    <slot/>

    <!-- Botón flotante para volver arriba -->
    <div class="back-to-top-container">
        <a href="#top" title="Subir al inicio" aria-label="Subir al inicio" class="back-to-top">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
            </svg>
        </a>
    </div>
</main>
<footer class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 mt-16 py-8 border-t border-gray-200">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-gray-500">
        <p>&copy; {new Date().getFullYear()} YourFavs</p>
        <div class="flex items-center gap-6">
            <a href="/about" class="hover:text-blue-600 transition">Acerca de</a>
            <span class="text-gray-300">·</span>
            <a href="https://www.themoviedb.org/" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-blue-600 transition">
                Datos de TMDB
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
            </a>
        </div>
    </div>
</footer>
<script is:inline>
    (function () {
        // Back-to-top
        var el = document.querySelector('.back-to-top-container');
        if (el) {
            var reveal = function () {
                var scrolled = window.scrollY || document.documentElement.scrollTop;
                if (scrolled > 400) el.classList.add('is-visible'); else el.classList.remove('is-visible');
            };
            reveal();
            window.addEventListener('scroll', reveal, { passive: true });
        }

        // Theme toggle (múltiples botones: desktop + mobile)
        document.querySelectorAll('.theme-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var html = document.documentElement;
                var next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-theme', next);
                try { localStorage.setItem('theme', next); } catch {}
            });
        });
    })();
</script>
<div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>
<script is:inline src="/js/hover-preview.js" defer></script>
</body>
</html>
