---
/**
 * Bloque de saga de la ficha de película (2026-11-23, C3.5; handoff docs/Sagas/design_handoff_sagas, S4).
 * Tarjeta siempre visible (antes un <details> con una rejilla de pósters):
 *
 *   cabecera   Stamp ámbar, nombre de la saga, «Saga · 8 películas · 2001–2011» y «Seguir saga» (en
 *              móvil, al pie y a todo el ancho)
 *   progreso   barra por película (SagaBar) y «Has visto 1 de 2 estrenadas · 2 próximas · Te quedan …»;
 *              sin sesión, solo las cifras de la saga
 *   lista      compacta: póster, título, «año · duración» o «estado · fecha»; la de la ficha en
 *              --bg-tint con «Estás aquí». Con más de 6, las 2 de antes y las 3 de después de la actual
 *   pie        «Ver la saga completa →» (con cuántas más hay, si no caben)
 *
 * Los datos (duraciones, estado de las próximas) vienen de `getSagaDetail`, que la ficha pide en
 * paralelo con lo demás. Lo tuyo (vistas, Pendientes, si la sigues) se consulta aquí.
 */
import Stamp from "../ui/Stamp.astro";
import SagaBar from "./SagaBar.astro";
import SagaFollowButton from "./SagaFollowButton.astro";
import type { SagaDetail, SagaPart } from "../../services/titles/sagaDetail";
import { getWatchedMovieTiers, type WatchedTier } from "../../services/movies/movieLibrary";
import { isFollowingCollection } from "../../services/titles/followedCollections";
import { getLibrarySnapshot } from "../../services/library/librarySnapshot";
import { runtimeLabel } from "../../utils/titles/episodeView";
import { shortDate, titleInitials } from "../../utils/titles/sagaView";
import '../../styles/components/saga.css';

interface Props {
    saga: SagaDetail;
    /** Película de la ficha: «Estás aquí». */
    currentId?: number;
}
const { saga, currentId } = Astro.props;
const { info, parts } = saga;
const user = Astro.locals.user;

const [tiers, following, snap] = await Promise.all([
    user ? getWatchedMovieTiers().catch(() => new Map<number, WatchedTier>()) : Promise.resolve(new Map<number, WatchedTier>()),
    user ? isFollowingCollection(info.id).catch(() => false) : Promise.resolve(false),
    user ? getLibrarySnapshot().catch(() => null) : Promise.resolve(null),
]);
const pendIds = new Set<number>((snap?.movPend ?? []).map((m: any) => Number(m.id)));

const released = parts.filter((p) => p.released);
const upcoming = parts.filter((p) => !p.released);
const next = released.find((p) => !tiers.has(p.id)) ?? null;
const seen = released.filter((p) => tiers.has(p.id)).length;
const leftMin = released.filter((p) => !tiers.has(p.id)).reduce((a, p) => a + (p.runtime ?? 0), 0);

// Cabecera: «Saga · 8 películas · 2001–2011» (con próximas, «2020–»).
const years = saga.firstYear
    ? (upcoming.length ? `${saga.firstYear}–` : saga.lastYear && saga.lastYear !== saga.firstYear ? `${saga.firstYear}–${saga.lastYear}` : String(saga.firstYear))
    : '';
const kicker = ['Saga', `${parts.length} ${parts.length === 1 ? 'película' : 'películas'}`, years].filter(Boolean).join(' · ');

// Línea de progreso.
const upText = upcoming.length ? `${upcoming.length} ${upcoming.length === 1 ? 'próxima' : 'próximas'}` : '';
const relText = upcoming.length ? `${released.length} estrenada${released.length === 1 ? '' : 's'}` : `${released.length}`;
const lead = user
    ? (released.length ? `Has visto ${seen} de ${relText}` : 'Aún sin estrenos')
    : (released.length ? `${released.length} ${released.length === 1 ? 'estrenada' : 'estrenadas'}` : 'Aún sin estrenos');
const rest = [
    upText,
    user && leftMin > 0 && seen > 0 ? `Te quedan ${runtimeLabel(leftMin)}` : '',
    user && released.length > 0 && seen === released.length ? 'La has visto entera' : '',
    !user && saga.marathonMin ? `Maratón ${runtimeLabel(saga.marathonMin)}` : '',
].filter(Boolean);

// Lista: como mucho 6; con más, la ventana alrededor de la actual (2 antes, 3 después), corrida si
// la actual está cerca de un extremo.
const MAX = 6;
const curIdx = Math.max(0, parts.findIndex((p) => p.id === currentId));
const start = parts.length <= MAX ? 0 : Math.min(Math.max(0, curIdx - 2), parts.length - MAX);
const shown = parts.slice(start, start + MAX);
const hidden = parts.length - shown.length;

type RowState = 'cur' | WatchedTier | 'pend' | 'next' | 'miss' | 'up';
const stateOf = (p: SagaPart): RowState => {
    if (p.id === currentId) return 'cur';
    if (!p.released) return 'up';
    if (!user) return 'up';
    const t = tiers.get(p.id);
    if (t) return t;
    if (next && p.id === next.id) return 'next';
    return pendIds.has(p.id) ? 'pend' : 'miss';
};
const metaOf = (p: SagaPart) => p.released
    ? [p.release_date?.slice(0, 4), runtimeLabel(p.runtime)].filter(Boolean).join(' · ')
    // Próximas: la fecha en tu país si la hay (la misma que Mis listas › Sagas); si no, la mundial.
    : [p.statusLabel, (p.localRelease.cinema || p.localRelease.digital || p.release_date) ? shortDate(p.localRelease.cinema || p.localRelease.digital || p.release_date) : 'Por anunciar'].filter(Boolean).join(' · ');

const I = {
    check: '<path d="M20 6 9 17l-5-5"/>',
    heart: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21.2l8.8-8.8a5.5 5.5 0 0 0 0-7.8z"/>',
    crown: '<path d="m2 4 3 12h14l3-12-6 7-4-7-4 7-6-7zM5 20h14"/>',
    clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
    play: '<path d="m6 3 14 9-14 9z"/>',
    arr: '<path d="M5 12h14M13 6l6 6-6 6"/>',
};
const svg = (k: keyof typeof I) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${I[k]}</svg>`;
const TIER: Record<WatchedTier, [keyof typeof I, string, boolean]> = {
    visto: ['check', 'Vista', false],
    like: ['heart', 'Me gusta', true],
    fav: ['crown', 'Favorita', true],
};
const href = `/catalogo/colecciones/${info.id}`;
---
<section class="sg-fk" aria-labelledby="sg-fk-t">
    <div class="hd">
        <Stamp color="amber" icon="layers" size={38} />
        <div>
            <h2 id="sg-fk-t"><a href={href}>{info.name}</a></h2>
            <span>{kicker}</span>
        </div>
        <div class="fol-d"><SagaFollowButton collectionId={info.id} following={following} name={info.name} small /></div>
    </div>

    <SagaBar items={parts.map((p) => ({ tier: tiers.get(p.id) ?? null, upcoming: !p.released }))} />
    <p class="ln"><b>{lead}</b>{rest.map((t) => <span>{t}</span>)}</p>

    <ol class="sg-ml">
        {shown.map((p) => {
            const st = stateOf(p);
            return (
                <li class:list={['sg-m', { cur: st === 'cur' }]}>
                    <span class:list={['sg-po', { up: !p.released }]}>
                        <b>{titleInitials(p.title)}</b>
                        {p.poster_path && <img src={p.poster_path.replace('/w500/', '/w92/')} alt="" loading="lazy" decoding="async" />}
                    </span>
                    <div style="min-width:0">
                        {st === 'cur'
                            ? <span class="t" aria-current="page">{p.title}</span>
                            : <a class="t" href={`/movie/${p.id}`}>{p.title}</a>}
                        <span class="w">{metaOf(p)}</span>
                    </div>
                    <span class="s">
                        {st === 'cur' && <span class="sg-here">Estás aquí</span>}
                        {(st === 'visto' || st === 'like' || st === 'fav') && (
                            <span class:list={['sg-ind', { f: TIER[st][2] }]} style={`--c:var(--a-${st})`}><Fragment set:html={svg(TIER[st][0])} />{TIER[st][1]}</span>
                        )}
                        {st === 'pend' && <span class="sg-ind" style="--c:var(--a-pend)"><Fragment set:html={svg('clock')} />Pendiente</span>}
                        {st === 'next' && <span class="chip-state" data-tone="blue"><Fragment set:html={svg('play')} />Te toca</span>}
                        {st === 'miss' && <span class="sg-miss">Te falta</span>}
                    </span>
                </li>
            );
        })}
    </ol>

    <div class="sg-go">
        <a class="sg-lk" href={href}>
            {hidden > 0 ? `Ver la saga completa · ${hidden} más` : 'Ver la saga completa'}
            <Fragment set:html={svg('arr')} />
        </a>
        <div class="fol-m"><SagaFollowButton collectionId={info.id} following={following} name={info.name} /></div>
    </div>
</section>
