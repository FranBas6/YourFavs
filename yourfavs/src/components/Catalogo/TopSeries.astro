---
import CardSerie from "../Cards/CardSerie.astro";
import {getTopRatedSeries} from "../../services/API/Series/tmdbSeries";

// Obtener el parámetro de página desde la URL
const page = Number(Astro.request.url.split('?page=')[1] || 1);

// Cargar las películas y series para la página actual
const popularSeries = await getTopRatedSeries({page: page.toString()});

// Total de páginas, puedes obtenerlo del API o mantenerlo como un valor estático
const totalPages = 113; // Suponiendo 10 páginas de resultados disponibles, ajusta según tu API

// Definir los géneros comunes
const genresMap: Record<number, string> = {
    // Géneros de películas y series
    28: "Acción",
    12: "Aventura",
    16: "Animación",
    35: "Comedia",
    80: "Crimen",
    99: "Documental",
    18: "Drama",
    10751: "Familia",
    14: "Fantasía",
    36: "Historia",
    27: "Terror",
    10402: "Música",
    9648: "Misterio",
    10749: "Romance",
    878: "Ciencia ficción",
    10770: "Película de TV",
    53: "Thriller",
    10752: "Bélica",
    37: "Western",
    // Géneros exclusivos de series
    10759: "Acción y Aventura",
    10762: "Infantil",
    10763: "Noticias",
    10764: "Reality",
    10765: "Sci-Fi y Fantasía",
    10766: "Soap",
    10767: "Talk",
    10768: "Guerra y Política"
};

// Función para obtener el nombre del género según su ID
function getGenreName(id: number): string {
    return genresMap[id] || "Otro";
}

// Calcular estadísticas de la página actual
const totalMoviesShown = page * 20; // Asumiendo 20 películas por página
const startIndex = (page - 1) * 20 + 1;
const endIndex = Math.min(page * 20, totalPages * 20);
---
<section class="px-1 sm:py-8">
    <!-- Header mejorado -->
    <header class="text-center mb-8">
        <div class="inline-flex items-center gap-3 mb-6">
            <div class="text-left mb-4">
                <h1 class="text-coral-red font-bold text-3xl md:text-4xl lg:text-5xl leading-tight mb-2">
                    TOP SERIES
                </h1>
                <div class="w-24 h-1 bg-coral-red mx-auto rounded-full mb-4"></div>
            </div>
        </div>

        <p class="text-gray-700 text-base md:text-lg max-w-2xl mx-auto leading-relaxed mb-6">
            Descubre las series mejor valoradas por la crítica y el público mundial.
            <span class="text-coral-red font-medium">Solo lo mejor de las series</span>
        </p>
    </header>

    <!-- Información de paginación superior mejorada -->
    <div class="bg-gradient-to-r from-white to-gray-50 rounded-2xl p-4 md:p-6 mb-8 shadow-sm border border-gray-100">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <!-- Info de página -->
            <div class="flex items-center gap-3">
                <div class="flex items-center justify-center w-10 h-10 bg-coral-red/10 rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-coral-red" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                </div>
                <div>
                    <div class="text-sm font-semibold text-gray-900">
                        Página <span class="text-coral-red">{page}</span> de <span
                            class="text-coral-red">{totalPages}</span>
                    </div>
                    <div class="text-xs text-gray-500">
                        Mostrando {startIndex}-{endIndex} de {totalPages * 20} series
                    </div>
                </div>
            </div>

            <!-- Stats adicionales -->
            <div class="flex items-center gap-4 text-sm">
                <div class="flex items-center gap-2 text-gray-600">
                    <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                    <span>Actualizado hoy</span>
                </div>
                <div class="flex items-center gap-2 text-gray-600">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                    </svg>
                    <span>Mejor valoradas</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Grid mejorado con loading states visuales -->
    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
        {
            popularSeries.map((item) => (
                    <div class="card-wrapper group">
                        <CardSerie
                                id={item.id.toString()}
                                img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                name={item.name}
                                vote_average={item.vote_average}
                                overview={item.overview}
                                first_air_date={item.first_air_date}
                                seasons={item.seasons}
                                last_episode_to_air={item.last_episode_to_air}
                                next_episode_to_air={item.next_episode_to_air}
                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                        />
                    </div>
            ))
        }
    </div>

    <!-- Paginación mejorada -->
    <nav aria-label="Paginación" class="mt-12">
        <!-- Navegación móvil -->
        <div class="flex sm:hidden items-center justify-between bg-white rounded-xl p-4 shadow-sm border border-gray-100">
            <a href={`?page=${Math.max(1, page - 1)}`}
               class={`pagination-btn-mobile ${page === 1 ? 'disabled' : ''}`}
               aria-disabled={page === 1}>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                Anterior
            </a>

            <div class="flex items-center gap-2 px-4">
                <span class="text-sm text-gray-600">Página</span>
                <span class="px-3 py-1 bg-coral-red text-white rounded-lg font-semibold text-sm">{page}</span>
                <span class="text-sm text-gray-600">/{totalPages}</span>
            </div>

            <a href={`?page=${Math.min(totalPages, page + 1)}`}
               class={`pagination-btn-mobile ${page === totalPages ? 'disabled' : ''}`}
               aria-disabled={page === totalPages}>
                Siguiente
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </a>
        </div>

        <!-- Navegación escritorio -->
        <div class="hidden sm:flex justify-center">
            <div class="inline-flex items-center bg-white rounded-xl p-2 shadow-sm border border-gray-100">
                <!-- Botón anterior -->
                <a href={`?page=${Math.max(1, page - 1)}`}
                   class={`pagination-btn ${page === 1 ? 'disabled' : ''}`}
                   aria-disabled={page === 1}>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Anterior
                </a>

                <!-- Primera página -->
                {page > 2 && (
                        <>
                            <a href={`?page=1`} class="pagination-number">1</a>
                            {page > 3 && <span class="px-2 text-gray-400">...</span>}
                        </>
                )}

                <!-- Página anterior -->
                {page > 1 && (
                        <a href={`?page=${page - 1}`} class="pagination-number">{page - 1}</a>
                )}

                <!-- Página actual -->
                <span class="pagination-number active">{page}</span>

                <!-- Página siguiente -->
                {page < totalPages && (
                        <a href={`?page=${page + 1}`} class="pagination-number">{page + 1}</a>
                )}

                <!-- Última página -->
                {page < totalPages - 1 && (
                        <>
                            {page < totalPages - 2 && <span class="px-2 text-gray-400">...</span>}
                            <a href={`?page=${totalPages}`} class="pagination-number">{totalPages}</a>
                        </>
                )}

                <!-- Botón siguiente -->
                <a href={`?page=${Math.min(totalPages, page + 1)}`}
                   class={`pagination-btn ${page === totalPages ? 'disabled' : ''}`}
                   aria-disabled={page === totalPages}>
                    Siguiente
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>
    </nav>
</section>

<style is:global>
    .text-coral-red {
        color: #E63946;
    }

    .bg-coral-red {
        background-color: #E63946;
    }

    #toggleSidebar:checked ~ #sidebar {
        transform: translateX(0);
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .grid > div {
        animation: fadeIn 0.5s ease-in-out;
    }

    /* Estilos para asegurar que todas las cards tengan el mismo tamaño */
    /* Cards mejoradas */
    .card-wrapper {
        display: flex;
        height: 100%;
        transition: all 0.3s ease-in-out;
    }

    .card-wrapper:hover {
        transform: translateY(-4px);
    }

    .card-wrapper > * {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        background-color: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        transition: all 0.3s ease-in-out;
    }

    .card-wrapper:hover > * {
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    .card-wrapper img {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
        transition: transform 0.3s ease-in-out;
    }

    .card-wrapper:hover img {
        transform: scale(1.05);
    }

    /* Paginación mejorada */
    .pagination-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
        color: #374151;
        background-color: #F9FAFB;
        border: 1px solid #E5E7EB;
    }

    .pagination-btn:hover:not(.disabled) {
        background-color: #E63946;
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(230, 57, 70, 0.3);
    }

    .pagination-btn.disabled {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
    }

    .pagination-btn-mobile {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
        color: #374151;
        background-color: #F9FAFB;
        border: 1px solid #E5E7EB;
        min-width: 100px;
        justify-content: center;
    }

    .pagination-btn-mobile:hover:not(.disabled) {
        background-color: #E63946;
        color: white;
        transform: translateY(-1px);
    }

    .pagination-btn-mobile.disabled {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
    }

    .pagination-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
        color: #6B7280;
        background-color: transparent;
    }

    .pagination-number:hover {
        background-color: #F3F4F6;
        color: #374151;
    }

    .pagination-number.active {
        background-color: #E63946;
        color: white;
        box-shadow: 0 2px 8px rgba(230, 57, 70, 0.3);
    }
</style>