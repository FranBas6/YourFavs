---
// Radar — "no te pierdas lo tuyo" (apuesta ② · "El salto").
// Vista que reúne lo que se mueve de lo que te importa. Datos en `getRadar`.
// /mislistas/* está protegido por el middleware → aquí SIEMPRE hay sesión.
import Layout from '../../layouts/Layout.astro';
import PersonalNav from '../../components/personal/PersonalNav.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getRadar } from '../../services/API/shared/radar';
import { posterUrl } from '../../services/API/shared/tmdbClient';
import { safeFetch } from '../../utils/safeFetch';

const radar = await safeFetch(
    getRadar(Astro.locals.user?.platforms ?? []),
    'radar',
    { groups: [], count: 0 },
);
---
<Layout title="Tu radar">
    <section class="px-1 sm:py-8">
        <header class="mb-6 flex items-center gap-3">
            <span class="radar-stamp">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 12l6-4"/>
                </svg>
            </span>
            <div>
                <h1 class="text-3xl md:text-4xl font-bold text-gray-900">Tu radar</h1>
                <p class="text-gray-500 text-base">
                    Lo que se mueve de lo que te importa
                    {radar.count > 0 && <span class="radar-count"> · {radar.count} {radar.count === 1 ? 'novedad' : 'novedades'}</span>}
                </p>
            </div>
        </header>

        <PersonalNav currentPage="/mislistas/radar" />

        {radar.groups.length === 0 ? (
            <EmptyState
                title="Nada nuevo por ahora"
                description="Cuando una serie que sigues estrene episodio, un pendiente llegue a tus plataformas o alguien que sigues tenga un estreno, lo verás aquí."
                variant="empty"
                size="lg"
            >
                <a slot="cta" href="/mislistas/siguiendo" class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-white text-sm font-semibold" style="background: var(--accent);">
                    Ver lo que sigo
                </a>
            </EmptyState>
        ) : (
            <div class="radar-groups">
                {radar.groups.map((group) => (
                    <section class="radar-group">
                        <h2 class="radar-group-title" style={`--g:${group.color}`}>{group.title}</h2>
                        <div class="radar-grid">
                            {group.items.map((item) => (
                                <a class="radar-card" href={item.href} style={`--g:${group.color}`}>
                                    <img
                                        class="radar-poster"
                                        src={item.poster_path ? posterUrl(item.poster_path, 'w185') : '/placeholder.jpg'}
                                        alt={`Póster de ${item.title}`}
                                        loading="lazy"
                                        onerror="this.onerror=null; this.src='/placeholder.jpg'"
                                    />
                                    <span class="radar-text">
                                        <span class="radar-card-title">{item.title}</span>
                                        <span class="radar-card-meta">{item.meta}</span>
                                    </span>
                                    <svg class="radar-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M5 12h14M13 6l6 6-6 6"/>
                                    </svg>
                                </a>
                            ))}
                        </div>
                    </section>
                ))}
            </div>
        )}
    </section>
</Layout>

<!-- Marca el radar como "visto": el badge del header/tab lo lee para apagarse. -->
<script is:inline define:vars={{ count: radar.count }}>
    try { localStorage.setItem('yf_radar_ack', String(count)); } catch (e) {}
</script>

<style>
    .radar-stamp {
        width: 44px; height: 44px;
        border-radius: var(--r-md);
        display: inline-flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        background: var(--accent-soft);
        color: var(--accent);
    }
    .radar-stamp svg { width: 22px; height: 22px; }
    .radar-count { color: var(--accent); font-weight: 600; }

    .radar-groups { display: flex; flex-direction: column; gap: var(--s-6); margin-top: var(--s-5); }
    .radar-group-title {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-weight: 600;
        color: var(--g);
        margin: 0 0 var(--s-3);
    }
    .radar-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--s-3);
    }
    .radar-card {
        display: flex;
        align-items: center;
        gap: var(--s-3);
        background: var(--bg-elev);
        border: 1px solid var(--border);
        border-left: 3px solid var(--g);
        border-radius: var(--r-md);
        padding: 0.6rem 0.85rem;
        text-decoration: none;
        color: inherit;
        transition: box-shadow 0.2s ease, transform 0.2s ease;
    }
    .radar-card:hover { box-shadow: var(--sh-md); transform: translateY(-1px); }
    .radar-poster {
        width: 40px; height: 60px;
        border-radius: var(--r-sm, 6px);
        object-fit: cover;
        flex-shrink: 0;
        background: var(--bg-tint);
    }
    .radar-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .radar-card-title {
        font-size: 0.92rem; font-weight: 600; color: var(--text);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .radar-card-meta {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem; color: var(--text-3);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .radar-arrow { width: 16px; height: 16px; color: var(--text-4); flex-shrink: 0; }

    @media (max-width: 640px) {
        .radar-grid { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
        .radar-card { transition: none; }
        .radar-card:hover { transform: none; }
    }
</style>
