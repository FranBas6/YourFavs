            <div class="absolute inset-0" style={`background: ${item?.backdrop_path ? 'linear-gradient(180deg, rgba(0,0,0,0.7) 100%, rgba(30,30,30,0.5) 100%)' : 'linear-gradient(180deg, #1e293b 0%, #334155 100%)'}`}></div>
            
            <!-- Breadcrumbs - Posicionado arriba a la izquierda -->
            <nav class="relative z-10 pt-6 px-4 max-w-7xl mx-auto hero-breadcrumbs" aria-label="Breadcrumb">
