---
import Layout from "../../layouts/Layout.astro";
import type { CastMember, ProductionCompany } from "../../types/Media";
import {
    getLanguageDisplayName, getContentRating,
    formatDate, formatTrailerUrl, providerLinks
} from "../../utils/constants/helpers/media-helpers";
import {formatCurrency} from "../../utils/constants/helpers/movie-helpers";
import {handleMovieFavAction, getWatchedMovieTiers, type WatchedTier} from "../../services/BD/movies/yourfavsMovie";
import SagaProgress from "../../components/detail/SagaProgress.astro";
import '../../styles/shared/detail-common.css';
import '../../styles/pages/movie/movie.css';
import {
    getMovieBundle, getMovieCollectionInfo, getMovieRecommendationsOrSimilar, type MovieBundle
} from "../../services/API/Movies/InfoMovies";
import { peekTopActors } from "../../utils/topActorsLibrary";
import { posterUrl, backdropUrl, originalUrl } from "../../services/API/shared/tmdbClient";
import { SUPPORTED_COUNTRIES } from "../../services/API/shared/tmdbInfoService";
import { getCurrentRegion } from "../../services/BD/shared/userScope";
import { checkMediaExistence } from "../../services/BD/shared/checkExistence";
import { getMediaTags, handleMediaTagsAction } from "../../services/BD/shared/mediaTags";
import HideFromProfileToggle from "../../components/social/HideFromProfileToggle.astro";
import { SOCIAL_PHASE } from "../../utils/constants/social";
import RecommendedBlock from "../../components/social/RecommendedBlock.astro";
import FriendsSeen from "../../components/detail/FriendsSeen.astro";
import { countMoviePasses } from "../../services/BD/lists/watchLog";
import { getNotificationSub, addNotificationSub, removeNotificationSub } from "../../services/BD/notifications/yourfavsNotifications";
import FichaActions from "../../components/detail/FichaActions.astro";
import FichaSections from "../../components/detail/FichaSections.astro";
import CastGrid from "../../components/detail/CastGrid.astro";
import DubbingSection from "../../components/detail/DubbingSection.astro";
import CrewGrid from "../../components/detail/CrewGrid.astro";
import ProductionCompanies from "../../components/detail/ProductionCompanies.astro";
import ReviewsSection from "../../components/detail/ReviewsSection.astro";
import LightboxGallery from "../../components/detail/LightboxGallery.astro";
import VideoSection from "../../components/detail/VideoSection.astro";
import RecommendationsCarousel from "../../components/detail/RecommendationsCarousel.astro";
import CrossMediaSection from "../../components/detail/CrossMediaSection.astro";
import { getCrossMediaRelated } from "../../services/API/shared/crossMediaRelated";
import StreamingProviders from "../../components/detail/StreamingProviders.astro";
import StarRating from "../../components/detail/StarRating.astro";
import {safeFetch} from "../../utils/safeFetch";

const {id} = Astro.params; // Obtén el parámetro id de la URL

if (!id) {
    throw new Error("ID de la película no encontrado en la URL");
}

if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        const actionType = String(formData.get('actionType') || '');

        if (actionType === 'notification') {
            const action = String(formData.get('action'));
            const tmdbId = String(formData.get('tmdb_id'));
            if (action === 'add') {
                await addNotificationSub('movie', tmdbId);
            } else {
                await removeNotificationSub('movie', tmdbId);
            }
            return Astro.redirect(`/movie/${id}`);
        }

        if (actionType === 'media_tags') {
            const url = await handleMediaTagsAction(formData);
            return Astro.redirect(url);
        }

        const redirectUrl = await handleMovieFavAction(formData);
        return Astro.redirect(redirectUrl);
    } catch (error) {
        console.error('Error al gestionar la película:', error);
        return Astro.redirect(`/movie/${id}`);
    }
}

// Obtener datos de la película
let item = null;
let cast: CastMember[] = []; // Cambio aquí: de string[] a CastMember[]
let directors: { name: string; job: string }[] = [];
let trailerUrl: string | null = null;
let title = "Película no encontrada";
let bundle: MovieBundle | null = null;

if (id) {
    // UNA llamada a TMDB con append_to_response trae detalle, reparto, equipo, vídeos, imágenes,
    // keywords, fechas de estreno, ids externos, traducciones, reseñas y proveedores (C1). Antes
    // eran ~19 llamadas sueltas, varias repetidas.
    bundle = await safeFetch(getMovieBundle(id), `movie/${id}/bundle`, null as MovieBundle | null);
    item = bundle?.item ?? null;
    cast = bundle?.cast ?? [];
    directors = bundle?.directors ?? [];
    trailerUrl = bundle?.trailerUrl ?? null;
    if (!item) return Astro.redirect('/404');
    title = item?.title || title;
}

// Datos que se enviarán al cliente
const clientData = {
    id: String(item?.id),
    poster_path: item?.poster_path || '',
    title: item?.title || 'Sin nombre',
    vote_average: item?.vote_average ? Number(item.vote_average) : 0,
    overview: item?.overview || 'Sin descripción',
    genres: item?.genres || [], // Asegurar que siempre sea un array
    release_date: item?.release_date || '',
};

// Verificar existencia en las 5 colecciones de películas (lectura paralela)
const EMPTY_MOVIE_EXISTENCE = {
    exists: { MovieFavs: false, MoviesPendientes: false, MoviesVistas: false, MoviesVerPronto: false, LikedMovies: false },
    opinion: '',
    rating: 0,
} as any;
const [{ exists: movieExists, opinion: opinionFromAny, rating: ratingFromAny }, mediaTagsDoc] = await Promise.all([
    safeFetch(checkMediaExistence('movie', clientData.id), `movie/${clientData.id}/existence`, EMPTY_MOVIE_EXISTENCE),
    safeFetch(getMediaTags('movie', clientData.id), `movie/${clientData.id}/tags`, null as any),
]);
const isInFavorites = movieExists.MovieFavs;
const isInPendientes = movieExists.MoviesPendientes;
const isInVistas = movieExists.MoviesVistas;
const isInVerPronto = movieExists.MoviesVerPronto;
const isInLiked = movieExists.LikedMovies;
const isInViendo = movieExists.MoviesViendo;
const userTags: string[] = mediaTagsDoc?.tags || [];

// Diario (L6): "La has visto N veces" = base 1 si consta vista (Vistas/Me gusta/Favs)
// + los "pases" del botón "Vuelto a ver", IGUAL que las series. El visionado original
// se deduce de estar en lista, no necesita entrada en el diario. Solo con sesión.
const moviePasses = Astro.locals.user ? await countMoviePasses(clientData.id) : { passes: 0, last: null, first: null };
// "Visto" = en cualquier nivel (Vistas/Me gusta/Favs) o con re-visionados en el diario.
const isWatchedMovie = isInVistas || isInFavorites || isInLiked || moviePasses.passes > 0;
// CTA de visionado (Bloque 2): siempre disponible.
//  - Viendo ahora  → "Terminar" (cierra la sesión; cuenta un pase si ya estaba vista).
//  - Ya vista      → "Volver a ver" (re-visionado: entra en Viendo, aparece en "Estás viendo").
//  - Aún no vista  → "Empezar a ver".
// (Lo pinta FichaActions, rediseño Fase 4.)
// Kicker del hero (4.3): «PELÍCULA · 1999 · DAVID FINCHER» (hasta dos en codirección).
const kickerDirectors: string[] = [...new Set(directors.filter((d) => d.job === 'Director').map((d) => d.name))].slice(0, 2);
const movieTimes = (isWatchedMovie ? 1 : 0) + moviePasses.passes;
const watchLastPretty = moviePasses.last ? new Date(moviePasses.last + 'T12:00:00').toLocaleDateString('es-ES', { month: 'short', year: 'numeric' }) : '';

// Efeméride "tu historia con esta peli" (§6 detalles con alma): fecha del primer
// visionado (de countMoviePasses, sin lecturas extra). Toque cálido "hace un año".
let movieEfemeride = '';
if (isWatchedMovie && moviePasses.first) {
    const started = new Date(moviePasses.first + 'T12:00:00').toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });
    const days = Math.floor((Date.now() - new Date(moviePasses.first + 'T12:00:00').getTime()) / 86400000);
    let rel = '';
    if (days >= 330) { const y = Math.max(1, Math.round(days / 365)); rel = y === 1 ? 'hace un año' : `hace ${y} años`; }
    else if (days >= 55) { rel = `hace ${Math.round(days / 30)} meses`; }
    movieEfemeride = `La viste por primera vez en ${started}` + (rel ? ` · ${rel}` : '');
}
const userNotes = mediaTagsDoc?.notes || '';
const inAnyCollection = isInFavorites || isInPendientes || isInVistas || isInVerPronto || isInLiked;

// Verificar suscripción de notificación (solo películas no estrenadas)
const isUnreleased = item?.release_date ? new Date(item.release_date) > new Date() : false;
const notifSub = isUnreleased ? await getNotificationSub('movie', id) : null;
const isNotifSubscribed = !!notifSub;

import type {PosterImage} from '../../services/API/Movies/InfoMovies';

// Segundo bloque de datos (dependen de item pero no entre sí) — todo en paralelo
const tmdbId = item?.id;

// Ya vienen en el paquete de la ficha (C1): sin llamadas.
const allPosters: PosterImage[] = bundle?.posters ?? [];
const externalIds: any = bundle?.externalIds ?? {};
const additionalInfo: Record<string, any> = bundle?.additionalInfo ?? { keywords: [], networks: [], content_ratings: [], episode_run_time: [], languages: [], tagline: null, budget: null, revenue: null };
const allVideos: any[] = bundle?.videos ?? [];
const reviewsData = bundle?.reviews ?? { results: [] };
const movieLogo = bundle?.logo ?? null;

// La saga se pide una vez y sus ids sirven también para no recomendar la propia saga (C3).
const collectionPromise = item?.belongs_to_collection ? getMovieCollectionInfo(item.belongs_to_collection.id).catch(() => null) : Promise.resolve(null);

const [
    collectionInfo,
    moviesRecommendationsData,
    crossMediaSeries,
] = await Promise.all([
    collectionPromise,
    tmdbId
        ? getMovieRecommendationsOrSimilar(tmdbId, item?.belongs_to_collection ? collectionPromise.then((c) => c?.parts?.map((p) => p.id)) : null)
        : Promise.resolve({ success: false, recommendations: [], type: 'recommendations' as const }),
    // Series de la misma saga. Va aquí dentro, en paralelo con el resto, para no sumar nada al
    // TTFB: es una búsqueda en TMDB y, al primer acierto, sale de caché las 24h siguientes.
    // Las keywords ya llegan en el paquete: así no las vuelve a pedir.
    tmdbId
        ? getCrossMediaRelated({ type: 'movie', id: tmdbId, title: item?.title || '', originalTitle: item?.original_title, keywords: bundle?.keywords })
            .catch(() => [])
        : Promise.resolve([]),
]);

// Saga con progreso: solo si la película pertenece a colección (evita la
// consulta en el resto de fichas). "Vista" = Vistas ∪ Liked ∪ Favs,
// con nivel (✓/♥/★) para indicar en qué lista está cada parte.
let watchedMovieTiers = new Map<number, WatchedTier>();
if (collectionInfo && collectionInfo.parts && collectionInfo.parts.length > 1) {
    watchedMovieTiers = await getWatchedMovieTiers().catch(() => new Map<number, WatchedTier>());
}

const posters: PosterImage[] = allPosters.slice(0, 40);
const moviesRecommendations = moviesRecommendationsData.success ? moviesRecommendationsData.recommendations : [];
const moviesRecommendationType = moviesRecommendationsData.type || 'recommendations';
const imdbId = externalIds.imdb_id;
const movieSocialLinks = {
    facebook: externalIds.facebook_id ? `https://facebook.com/${externalIds.facebook_id}` : null,
    instagram: externalIds.instagram_id ? `https://instagram.com/${externalIds.instagram_id}` : null,
    twitter: externalIds.twitter_id ? `https://twitter.com/${externalIds.twitter_id}` : null,
};
const hasSocialLinks = Object.values(movieSocialLinks).some(v => v);
// Reparto cruzado con tu biblioteca (3.4): solo si la caché de top-actores está
// caliente (no se computa aquí). actor id → nº de títulos tuyos con esa persona.
const _topActors = Astro.locals.user ? peekTopActors() : null;
const seenWithMap = _topActors ? new Map(_topActors.map((a) => [a.id, a.appearances])) : undefined;

const movieKeywords: { id: number; name: string }[] = additionalInfo.keywords || [];
const movieLanguages: { iso_639_1: string; name: string }[] = additionalInfo.languages || [];
// B3: el estado en español (solo se enseña si no está estrenada).
const MOVIE_STATUS_LABEL: Record<string, string> = {
    Rumored: 'Rumoreada', Planned: 'Anunciada', 'In Production': 'En producción',
    'Post Production': 'Posproducción', Canceled: 'Cancelada',
};
const movieStatus = item?.status && item.status !== 'Released' ? (MOVIE_STATUS_LABEL[item.status] ?? item.status) : null;

// B3: estrenos en el país del perfil (ya llegan en el paquete). La fila «Estreno» de arriba es la fecha
// mundial de TMDB; aquí van cines, digital, físico… del país, cada uno con su fecha.
const RELEASE_TYPE_LABEL: Record<number, string> = {
    1: 'Premiere', 2: 'Cines (limitado)', 3: 'Cines', 4: 'Digital', 5: 'Físico', 6: 'Televisión',
};
const regionCode = getCurrentRegion();
const regionLabel = SUPPORTED_COUNTRIES.find((c) => c.code === regionCode)?.label ?? regionCode;
const regionReleases = (bundle?.regionReleases ?? []).map((r) => ({
    label: RELEASE_TYPE_LABEL[r.type],
    date: new Date(r.date + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }),
    note: r.type === 1 ? r.note : null,
}));

// Reviews de TMDB (top 5 con contenido)
const reviews = (reviewsData.results || [])
    .filter((r: any) => r.content && r.content.length > 50)
    .slice(0, 5);

// Países de producción
const productionCountries = item?.production_countries || [];

// Año en contexto
const releaseYear = item?.release_date ? new Date(item.release_date).getFullYear() : null;
const yearsAgo = releaseYear ? new Date().getFullYear() - releaseYear : null;

// Nota comparativa: percentil respecto a recomendaciones + similares
const allRelated = moviesRecommendations.filter((m: any) => m.vote_average > 0);
const betterThanCount = allRelated.filter((m: any) => item?.vote_average > m.vote_average).length;
// Sin votos (p. ej. sin estrenar) no hay nota que comparar: antes salía «Mejor que el 0%».
const ratingPercentile = allRelated.length >= 5 && item?.vote_count > 0 ? Math.round((betterThanCount / allRelated.length) * 100) : null;
const mainGenre = item?.genres?.[0]?.name || null;

// Categorizar videos (el tráiler principal ya va en `trailerUrl`)
const clips = allVideos.filter((v: any) => v.type === 'Clip');
// B4a: también cabeceras y resúmenes («Opening Credits», «Recap»), que antes se descartaban.
const behindScenes = allVideos.filter((v: any) => ['Behind the Scenes', 'Bloopers', 'Featurette', 'Opening Credits', 'Recap'].includes(v.type));
const teasers = allVideos.filter((v: any) => v.type === 'Teaser');

// JSON-LD structured data (schema.org Movie)
const jsonLd = item ? {
    "@context": "https://schema.org",
    "@type": "Movie",
    "name": item.title,
    ...(item.poster_path && { image: item.poster_path }),
    ...(item.release_date && { datePublished: item.release_date }),
    ...(item.overview && { description: item.overview }),
    ...(item.genres?.length && { genre: item.genres.map((g: any) => g.name) }),
    ...(directors?.find((d: any) => d.job === 'Director') && {
        director: { "@type": "Person", name: directors.find((d: any) => d.job === 'Director')!.name }
    }),
    ...(item.vote_count > 0 && {
        aggregateRating: {
            "@type": "AggregateRating",
            ratingValue: item.vote_average,
            bestRating: 10,
            ratingCount: item.vote_count,
        }
    }),
} : null;
---
<Layout
    title={`${title}`}
    description={item?.overview || undefined}
    ogImage={item?.poster_path || item?.backdrop_path || undefined}
    ogType="video.movie"
>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Sin fondo propio: va sobre el gris de la página, como la ficha de episodio y el resto de la web
         (antes `bg-gray-50` hacía un «doble fondo», un panel más claro con franjas a los lados). -->
    <article>
        <!-- Hero inmersivo (piel v2, 4.8c): fondo oscuro de la casa con la imagen al 55 %, póster con borde,
             línea de datos, géneros como chips y sinopsis ancha. En móvil, el póster va pequeño encima del título. -->
        <div class="fh">
            <div class="fh-bg" style={`background-image: url(${item?.backdrop_path ? originalUrl(item.backdrop_path) : '/assets/background.svg'})`}></div>
            <div class="fh-in">
                <nav class="fh-crumb" aria-label="Breadcrumb">
                    <ol>
                        <li><a href="/">Inicio</a></li>
                        <li aria-hidden="true">/</li>
                        <li><a href="/catalogo/topmovies">Películas</a></li>
                        <li aria-hidden="true">/</li>
                        <li><b>{item?.title}</b></li>
                    </ol>
                </nav>
                <div class="fh-row">
                    <div class="fh-poster">
                        <img src={posterUrl(item?.poster_path)} alt={item?.title} />
                    </div>
                    <div class="fh-tx">
                        <p class="ficha-kicker">
                            Película{item?.release_date && <> · {item.release_date.slice(0, 4)}</>}
                            {kickerDirectors.length > 0 && <> · {kickerDirectors.map((n, i) => (<>{i > 0 && (i === kickerDirectors.length - 1 ? ' y ' : ', ')}<a href={`/team/${encodeURIComponent(n)}`}>{n}</a></>))}</>}
                        </p>
                        {movieLogo
                            ? <h1 class="fh-logo"><img src={movieLogo} alt={item?.title} /></h1>
                            : <h1 class="fh-title">{item?.title}</h1>}
                        {additionalInfo.tagline && <p class="fh-tag">“{additionalInfo.tagline}”</p>}
                        <div class="fh-facts">
                            {item?.vote_average > 0 && <span class="fh-rt"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{item.vote_average.toFixed(1).replace('.', ',')}</span>}
                            {item?.vote_count > 0 && <span class="fh-vt">{Number(item.vote_count).toLocaleString('es-ES')} votos</span>}
                            <span>{formatDate(item?.release_date)}</span>
                            {item?.runtime > 0 && <span>{Math.floor(item.runtime / 60)} h {item.runtime % 60} min</span>}
                            {(() => { const r = additionalInfo.content_ratings?.length ? getContentRating(additionalInfo.content_ratings) : null; return r ? <span class="fh-age" title={r.text}>{r.rating}</span> : null; })()}
                            <span class="fh-lang" title="Idioma original">{(item?.original_language || '').toUpperCase()} · {getLanguageDisplayName(item?.original_language).toLowerCase()}</span>
                            {item?.hasSpanishTranslation && <span title="Disponible en español"><svg viewBox="0 0 750 500" class="fh-flag" aria-hidden="true"><rect width="750" height="500" fill="#AA151B"/><rect width="750" height="250" y="125" fill="#F1BF00"/></svg></span>}
                        </div>
                        {item?.genres && item.genres.length > 0 && (
                            <div class="fh-gs">
                                {item.genres.map((genre: { id: number; name: string }) => <span>{genre.name}</span>)}
                            </div>
                        )}
                        {item?.overview && (
                            <details class="fh-syn group">
                                <summary>
                                    <p class="line-clamp-3 group-open:line-clamp-none">{item.overview}</p>
                                    <span class="fh-more group-open:hidden">Pulsa para leer más</span>
                                </summary>
                            </details>
                        )}
                    </div>
                </div>
            </div>
        </div>

        <!-- Barra de acciones (rediseño, Fase 4 · 4.1): principal según el estado, Nivel, Pendiente,
             Ver pronto y, debajo, «La has visto N veces». Mismos formularios que antes. -->
        <FichaActions
            mediaType="movie"
            id={item?.id}
            title={item?.title || ''}
            poster={item?.poster_path}
            state={{ vistas: isInVistas, liked: isInLiked, fav: isInFavorites, pend: isInPendientes, pronto: isInVerPronto, viendo: isInViendo }}
            watched={isWatchedMovie}
            times={movieTimes}
            lastPretty={watchLastPretty}
            efemeride={movieEfemeride}
            unreleased={isUnreleased}
            releaseLabel={isUnreleased ? formatDate(item?.release_date) : ''}
            notif={isNotifSubscribed}
            imdbId={imdbId}
            providersByCountry={item?.providersByCountry || {}}
            linkByCountry={item?.providerLinksByCountry || {}}
            myPlatformIds={((Astro.locals.user as any)?.platforms ?? []).map(Number).filter(Number.isFinite)}
            homepage={item?.homepage}
            trailerUrl={trailerUrl}
        />
        <FichaSections items={[
            { id: 'sec-detalles', label: 'Detalles', mo: 1 },
            { id: 'sec-donde', label: 'Dónde ver', mo: 2 },
            { id: 'sec-videos', label: 'Vídeos', mo: 3 },
            { id: 'sec-reparto', label: 'Reparto', mo: 4 },
            { id: 'sec-imagenes', label: 'Imágenes', mo: 5 },
            { id: 'sec-resenas', label: 'Reseñas', mo: 6 },
            { id: 'sec-parecidas', label: 'Parecidas', mo: 7 },
        ]} />

        <!-- Layout 2 columnas -->
        <div class="max-w-6xl mx-auto px-4 py-8">
            <div class="ficha-cols flex flex-col md:flex-row gap-8">

                <!-- Sidebar izquierda -->
                <div class="md:w-1/3 space-y-4">

                    <!-- Información (piel v2, 4.8): lista de dos columnas, clasificación como sello, enlaces como botones -->
                    <div id="sec-detalles" data-fs class="mo-1 fcard">
                        <h3 class="fcard-h"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>Información</h3>
                        <dl class="fdl">
                            {item?.original_title && item.original_title !== item.title && (<><dt>Título original</dt><dd>{item.original_title}</dd></>)}
                            <dt>Estreno</dt><dd>{formatDate(item?.release_date)}</dd>
                            {regionReleases.length > 0 && (
                                <>
                                    <dt>En {regionLabel}</dt>
                                    <dd class="fdl-list">
                                        {regionReleases.map((r) => (
                                            <span>{r.date} <small>· {r.label}</small>{r.note && <small class="fdl-note">{r.note}</small>}</span>
                                        ))}
                                    </dd>
                                </>
                            )}
                            {movieStatus && (<><dt>Estado</dt><dd>{movieStatus}</dd></>)}
                            <dt>Valoración</dt><dd>{item?.vote_average?.toFixed(1)} <small>· {Number(item?.vote_count || 0).toLocaleString('es-ES')} votos · popularidad {item?.popularity?.toFixed(0)}</small></dd>
                            {item?.runtime > 0 && (<><dt>Duración</dt><dd>{Math.floor(item.runtime / 60)} h {item.runtime % 60} min</dd></>)}
                            <dt>Idioma</dt><dd>{getLanguageDisplayName(item?.original_language)}</dd>
                            {(movieLanguages.length > 1 || (movieLanguages.length === 1 && movieLanguages[0].iso_639_1 !== item?.original_language)) && (<><dt>Idiomas</dt><dd>{movieLanguages.map((lang) => getLanguageDisplayName(lang.iso_639_1)).join(', ')}</dd></>)}
                            {additionalInfo.budget && additionalInfo.budget > 0 && (<><dt>Presupuesto</dt><dd>{formatCurrency(additionalInfo.budget)}</dd></>)}
                            {additionalInfo.revenue && additionalInfo.revenue > 0 && (
                                <><dt>Recaudación</dt><dd>{formatCurrency(additionalInfo.revenue)}{additionalInfo.budget && additionalInfo.budget > 0 && <> <small>·</small> <b class="fdl-ok">beneficio ×{(additionalInfo.revenue / additionalInfo.budget).toFixed(1).replace('.', ',')}</b></>}</dd></>
                            )}
                            {productionCountries.length > 0 && (<><dt>País</dt><dd>{productionCountries.map((c: any) => c.name).join(', ')}</dd></>)}
                            {yearsAgo && yearsAgo > 0 && (<><dt>Antigüedad</dt><dd>Hace {yearsAgo} {yearsAgo === 1 ? 'año' : 'años'}</dd></>)}
                            {ratingPercentile !== null && (<><dt>Comparativa</dt><dd>Mejor que el {ratingPercentile} %{mainGenre ? ` de ${mainGenre}` : ''}</dd></>)}
                        </dl>
                        {/* Clasificación por edades, como sello */}
                        {(() => {
                            const rating = additionalInfo.content_ratings?.length ? getContentRating(additionalInfo.content_ratings) : null;
                            return rating ? <div class="cage-r"><b>{rating.rating}</b><span>{rating.text}</span></div> : null;
                        })()}
                        {(hasSocialLinks || imdbId) && (
                            <div class="clinks">
                                {imdbId && <a href={`https://www.imdb.com/title/${imdbId}`} target="_blank" rel="noopener" class="btn btn--sm">IMDb<svg class="clinks-ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></a>}
                                {movieSocialLinks.facebook && <a href={movieSocialLinks.facebook} target="_blank" rel="noopener" class="btn btn--sm">Facebook</a>}
                                {movieSocialLinks.instagram && <a href={movieSocialLinks.instagram} target="_blank" rel="noopener" class="btn btn--sm">Instagram</a>}
                                {movieSocialLinks.twitter && <a href={movieSocialLinks.twitter} target="_blank" rel="noopener" class="btn btn--sm">X (Twitter)</a>}
                            </div>
                        )}
                    </div>

                    <!-- Dónde ver -->
                    <div id="sec-donde" data-fs class="mo-2">
                    <StreamingProviders
                        providersByCountry={item?.providersByCountry || {}}
                        linkByCountry={item?.providerLinksByCountry || {}}
                        myPlatformIds={((Astro.locals.user as any)?.platforms ?? []).map(Number).filter(Number.isFinite)}
                    />
                    </div>

                    <!-- Amigos que la han visto (F5 social) -->
                    <div class="mo mo-7">
                    <FriendsSeen mediaType="movie" tmdbId={item?.id} />
                    </div>

                    <!-- Nota personal -->
                    <div class="mo mo-8">
                    {!(isInFavorites || isInPendientes || isInVistas || isInVerPronto || isInLiked) && <RecommendedBlock mediaType="movie" tmdbId={item?.id} alone />}
                    {(isInFavorites || isInPendientes || isInVistas || isInVerPronto || isInLiked) && (
                        <StarRating
                            currentRating={ratingFromAny}
                            tmdbRating={Number(item?.vote_average) || 0}
                            itemId={String(item?.id)}
                            mediaType="movie"
                        ><RecommendedBlock mediaType="movie" tmdbId={item?.id} /></StarRating>
                    )}
                    </div>

                    <!-- Opinión -->
                    <div class="mo mo-9">
                    {(isInFavorites || isInPendientes || isInVistas || isInVerPronto || isInLiked) && (
                        <div class="fcard">
                            <h3 class="fcard-h"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>Tu opinión</h3>
                            {opinionFromAny ? (
                                <div class="space-y-3">
                                    <blockquote class="fquote">{opinionFromAny}</blockquote>
                                    <div class="crow crow--end">
                                        <details>
                                            <summary class="btn btn--sm fsum">Editar</summary>
                                            <form method="POST" class="fform">
                                                <input type="hidden" name="id" value={item?.id} />
                                                <input type="hidden" name="action" value="save_opinion" />
                                                <textarea name="opinion" rows="4" class="cop" aria-label="Tu opinión">{opinionFromAny}</textarea>
                                                <button type="submit" class="btn btn--sm">Guardar opinión</button>
                                            </form>
                                        </details>
                                        <form method="POST">
                                            <input type="hidden" name="id" value={item?.id} />
                                            <input type="hidden" name="action" value="delete_opinion" />
                                            <button type="submit" class="btn btn--sm btn--ghost btn--dgr">Eliminar</button>
                                        </form>
                                    </div>
                                </div>
                            ) : (
                                <form method="POST" class="fform">
                                    <input type="hidden" name="id" value={item?.id} />
                                    <input type="hidden" name="action" value="save_opinion" />
                                    <textarea name="opinion" rows="3" class="cop" aria-label="Tu opinión" placeholder="Escribe tu opinión…"></textarea>
                                    <div class="crow crow--end"><button type="submit" class="btn btn--sm">Guardar opinión</button></div>
                                </form>
                            )}
                        </div>
                    )}
                    </div>

                    <!-- Tus tags + notas (C15) -->
                    <div class="mo mo-10">
                    {inAnyCollection && (
                        <div class="fcard">
                            <h3 class="fcard-h"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/></svg>Tus etiquetas y notas</h3>
                            {userTags.length > 0 && (
                                <div class="fchips">
                                    {userTags.map(t => (
                                        <span class="chip-tag">#{t}</span>
                                    ))}
                                </div>
                            )}
                            {userNotes && (
                                <blockquote class="fquote">{userNotes}</blockquote>
                            )}
                            <details class="fedit">
                                <summary class="btn btn--sm btn--ghost fsum">
                                    {userTags.length > 0 || userNotes ? 'Editar' : 'Añadir etiquetas y notas'}
                                </summary>
                                <form method="POST" class="fform">
                                    <input type="hidden" name="actionType" value="media_tags" />
                                    <input type="hidden" name="media_type" value="movie" />
                                    <input type="hidden" name="tmdb_id" value={item?.id} />
                                    <input type="text" name="tags" value={userTags.join(', ')} placeholder="comedia, road trip, 90s..." class="cop cop--line" aria-label="Etiquetas" />
                                    <p class="fhelp">Separadas por comas. Máximo 20.</p>
                                    <textarea name="notes" rows="3" placeholder="Notas más libres que la opinión..." class="cop" aria-label="Notas">{userNotes}</textarea>
                                    <div class="crow crow--end"><button type="submit" class="btn btn--sm">Guardar</button></div>
                                </form>
                            </details>
                            <HideFromProfileToggle mediaType="movie" tmdbId={item?.id} title={item?.title || ''} posterPath={item?.poster_path ?? null} />
                        </div>
                    )}
                    </div>

                    <!-- Palabras clave de TMDB (aparte de tus etiquetas) -->
                    <div class="mo mo-14">
                    {movieKeywords.length > 0 && (
                        <>
                            {/* Móvil: plegadas (4.7), como en la serie */}
                            <details class="fcard fcard-fold sm:hidden">
                                <summary>
                                    <h3 class="fcard-h"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/></svg>Palabras clave · TMDB ({movieKeywords.length})</h3>
                                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                                </summary>
                                <div class="fchips">
                                    {movieKeywords.map((kw) => (
                                        <a href={`/catalogo/keyword/${kw.id}?name=${encodeURIComponent(kw.name)}`} class="chip-tag">{kw.name}</a>
                                    ))}
                                </div>
                            </details>
                            <div class="hidden sm:block fcard">
                                <h3 class="fcard-h"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/></svg>Palabras clave · TMDB</h3>
                                <div class="fchips">
                                    {movieKeywords.map((kw) => (
                                        <a href={`/catalogo/keyword/${kw.id}?name=${encodeURIComponent(kw.name)}`} class="chip-tag">{kw.name}</a>
                                    ))}
                                </div>
                            </div>
                        </>
                    )}
                    </div>

                </div>

                <!-- Columna derecha -->
                <div class="md:w-2/3 space-y-8">

                    <!-- Orden de la columna (rediseño 4.5), el mismo que la barra de secciones: vídeos y saga,
                         reparto y equipo, imágenes, productoras, reseñas y, al final, «También en TV» y parecidas. -->

                    <!-- Tráiler + más vídeos -->
                    <div id="sec-videos" data-fs class="mo-3"><VideoSection trailerUrl={trailerUrl} clips={clips} behindScenes={behindScenes} teasers={teasers} /></div>

                    <!-- Colección/Saga con progreso (✓ vista / TE FALTA / PRÓX.), justo tras los vídeos (Fran) -->
                    <div class="mo mo-4">
                    {collectionInfo && collectionInfo.parts && collectionInfo.parts.length > 1 && (
                        <SagaProgress
                            name={collectionInfo.name}
                            overview={collectionInfo.overview}
                            parts={collectionInfo.parts}
                            watchedTiers={watchedMovieTiers}
                            currentId={item?.id}
                        />
                    )}
                    </div>

                    <!-- Reparto (12 + el resto plegado), equipo y dobladores en español (lazy, eldoblaje.com) -->
                    <div id="sec-reparto" data-fs class="mo-5 space-y-8">
                        <CastGrid cast={cast} seenWith={seenWithMap} />
                        <CrewGrid crew={directors} />
                        <DubbingSection type="movie" tmdbId={id} />
                    </div>

                    <!-- Pósters y fondos -->
                    <div id="sec-imagenes" data-fs class="mo-11 space-y-8">
                        <LightboxGallery posters={posters} prefix="poster" />
                        <LightboxGallery posters={bundle?.backdrops ?? []} prefix="backdrop" title="Fondos" variant="backdrop" />
                    </div>

                    <!-- Productoras -->
                    <div class="mo mo-12">
                    <ProductionCompanies companies={item?.production_companies || []} />
                    </div>

                    <!-- Reviews de TMDB -->
                    <div id="sec-resenas" data-fs class="mo-13"><ReviewsSection reviews={reviews} /></div>

                    <!-- La saga al otro lado: series de esta misma película -->
                    <div class="mo mo-15">
                    <CrossMediaSection items={crossMediaSeries} mediaType="tv" />
                    </div>

                    <!-- Recomendaciones -->
                    <div id="sec-parecidas" data-fs class="mo-16"><RecommendationsCarousel
                        items={moviesRecommendations}
                        mediaType="movie"
                        title={moviesRecommendationType === 'recommendations' ? 'Recomendaciones' : 'Películas similares'}
                    /></div>
                </div>
            </div>
        </div>

    </article>
</Layout>

<script is:inline src="/js/optimistic-actions.js"></script>
