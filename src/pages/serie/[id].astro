---
import Layout from "../../layouts/Layout.astro";
import {
    getLanguageDisplayName, getContentRating,
    formatDate, getRatingStars, formatTrailerUrl, providerLinks
} from "../../utils/constants/helpers/media-helpers";
import {formatRuntime, getSeasonStats} from "../../utils/constants/helpers/serie-helpers";
import type { GuestStar } from "../../types/Media";
import {handleSerieFavAction, getSerieFav, getWatchedProgress, toggleWatchedEpisode, markSeasonWatched, unmarkSeasonWatched, markAllWatched, unmarkAllWatched} from "../../services/BD/series/yourfavsSerie";
import { countSeriesPasses } from "../../services/BD/lists/watchLog";
import type {WatchedProgress} from "../../services/BD/series/yourfavsSerie";
import '../../styles/shared/detail-common.css';
import '../../styles/pages/serie/serie.css';
import '../../styles/shared/spoil.css'; // modo sin spoilers, compartido con la ficha de episodio (TMDB D4)
import { episodeHref } from '../../utils/episodeView';
import {
    getSeriesBundle, getSerieRecommendationsOrSimilar, type SeriesBundle
} from "../../services/API/Series/InfoSeries";
import { getAllSeasonProviders, buildProviderCoverage } from "../../services/API/Series/seasonProviders";
import { posterUrl, originalUrl } from "../../services/API/shared/tmdbClient";
import { peekTopActors } from "../../utils/topActorsLibrary";
import { checkMediaExistence } from "../../services/BD/shared/checkExistence";
import { getMediaTags, handleMediaTagsAction } from "../../services/BD/shared/mediaTags";
import HideFromProfileToggle from "../../components/social/HideFromProfileToggle.astro";
import { SOCIAL_PHASE } from "../../utils/constants/social";
import RecommendedBlock from "../../components/social/RecommendedBlock.astro";
import FriendsSeen from "../../components/detail/FriendsSeen.astro";
import { getNotificationSub, addNotificationSub, removeNotificationSub } from "../../services/BD/notifications/yourfavsNotifications";
import FichaActions from "../../components/detail/FichaActions.astro";
import FichaSections from "../../components/detail/FichaSections.astro";
import CastGrid from "../../components/detail/CastGrid.astro";
import DubbingSection from "../../components/detail/DubbingSection.astro";
import CrewGrid from "../../components/detail/CrewGrid.astro";
import ProductionCompanies from "../../components/detail/ProductionCompanies.astro";
import ReviewsSection from "../../components/detail/ReviewsSection.astro";
import LightboxGallery from "../../components/detail/LightboxGallery.astro";
import VideoSection from "../../components/detail/VideoSection.astro";
import RecommendationsCarousel from "../../components/detail/RecommendationsCarousel.astro";
import CrossMediaSection from "../../components/detail/CrossMediaSection.astro";
import { getCrossMediaRelated } from "../../services/API/shared/crossMediaRelated";
import StreamingProviders from "../../components/detail/StreamingProviders.astro";
import SeasonHeatmap from "../../components/detail/SeasonHeatmap.astro";
import StarRating from "../../components/detail/StarRating.astro";
import {safeFetch} from "../../utils/safeFetch";
import { getSpoilerPref, setSpoilerPref, clearSpoilerPref } from "../../services/BD/shared/spoilerPrefs";

const {id} = Astro.params; // Obtén el parámetro id de la URL

if (!id) {
    throw new Error("ID de la serie no encontrado en la URL");
}

if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        const actionType = String(formData.get('actionType') || '');

        // Watched episodes
        if (actionType === 'watched_episode') {
            const season = Number(formData.get('season'));
            const episode = Number(formData.get('episode'));
            await toggleWatchedEpisode(id, season, episode);
            return Astro.redirect(`/serie/${id}`);
        }
        if (actionType === 'watched_all') {
            const allEpisodesStr = String(formData.get('allEpisodes'));
            const action = String(formData.get('action'));
            if (action === 'mark') {
                const episodes = allEpisodesStr.split(';').map(e => {
                    const [s, ep] = e.split('-').map(Number);
                    return { season: s, episode: ep };
                });
                await markAllWatched(id, episodes);
            } else {
                await unmarkAllWatched(id);
            }
            return Astro.redirect(`/serie/${id}`);
        }
        if (actionType === 'watched_season') {
            const season = Number(formData.get('season'));
            const episodeNumbers = String(formData.get('episodes')).split(',').map(Number);
            const action = String(formData.get('action'));
            if (action === 'mark') {
                await markSeasonWatched(id, season, episodeNumbers);
            } else {
                await unmarkSeasonWatched(id, season);
            }
            return Astro.redirect(`/serie/${id}`);
        }

        if (actionType === 'notification') {
            const action = String(formData.get('action'));
            const tmdbId = String(formData.get('tmdb_id'));
            if (action === 'add') {
                await addNotificationSub('tv', tmdbId);
            } else {
                await removeNotificationSub('tv', tmdbId);
            }
            return Astro.redirect(`/serie/${id}`);
        }

        if (actionType === 'media_tags') {
            const url = await handleMediaTagsAction(formData);
            return Astro.redirect(url);
        }

        if (actionType === 'spoiler_pref') {
            // Override por serie (§2 · parada 2): la serie manda sobre el global.
            const value = String(formData.get('value'));
            if (value === 'inherit') {
                // Volver a seguir el ajuste global (borra el override, no lo pone en false).
                await clearSpoilerPref(id);
                return Astro.redirect(`/serie/${id}?sp=inherit`);
            }
            const on = value === 'on';
            await setSpoilerPref(id, on);
            // Flag para el toast de confirmación tras la recarga (el blur es SSR → hace falta recargar).
            return Astro.redirect(`/serie/${id}?sp=${on ? 'on' : 'off'}`);
        }

        const redirectUrl = await handleSerieFavAction(formData);
        return Astro.redirect(redirectUrl);
    } catch (error) {
        console.error('Error al gestionar la serie:', error);
        return Astro.redirect(`/serie/${id}`);
    }
}

// La ficha en pocas llamadas a TMDB (C2): detalle, reparto, equipo, vídeos, imágenes, keywords,
// clasificación, ids externos, traducciones, reseñas, proveedores y TODAS las temporadas (episodios,
// pósters y reparto) con append_to_response, en una llamada + bloques de 20 en paralelo. Antes:
// `/tv/{id}` ×5 y cuatro llamadas por temporada.
const bundle = await safeFetch(getSeriesBundle(id), `serie/${id}/bundle`, null as SeriesBundle | null);
let item = bundle?.item ?? null;
let cast = bundle?.cast ?? [];
let directors = bundle?.directors ?? [];
let trailerUrl = bundle?.trailerUrl ?? null;
let status = bundle?.status ?? '';
if (!item) return Astro.redirect('/404');
let title = item?.name || "Serie no encontrada";

// Cliente data actualizado con la estructura de Props
const clientData = {
    id: String(item?.id || ''),
    name: item?.name || 'Sin nombre',
    img: item?.poster_path || '', // Cambiado a img manteniendo compatibilidad con poster_path
    vote_average: item?.vote_average ? Number(item.vote_average) : 0,
    overview: item?.overview || 'Sin descripción',
    first_air_date: item?.first_air_date || '',
    status: status || '',
    genres: item?.genres || [],
    seasons: item?.seasons || [],
    last_episode_to_air: item?.last_episode_to_air || null,
    next_episode_to_air: item?.next_episode_to_air || null
};

// Episodios de TODAS las temporadas: ya vienen en el paquete de la ficha (C2).
const allSeasonEpisodes: { [key: number]: any[] } = {};
if (item?.seasons) {
    item.seasons.forEach((season: any) => {
        allSeasonEpisodes[season.season_number] = bundle?.seasonEpisodes[season.season_number] || [];
    });
}

// Separar temporadas regulares y especiales
const regularSeasons = item?.seasons?.filter(season => season.season_number > 0) || [];
const specialSeasons = item?.seasons?.filter(season => season.season_number === 0) || [];

const totalRegularEpisodes = regularSeasons.reduce((total, season) => total + (season.episode_count || 0), 0);
const totalSpecialEpisodes = specialSeasons.reduce((total, season) => total + (season.episode_count || 0), 0);
const totalEpisodes = totalRegularEpisodes + totalSpecialEpisodes; // Total completo para compatibilidad

// Verificar existencia en las 6 colecciones (lectura paralela) + watched progress + tags
const EMPTY_SERIE_EXISTENCE = {
    exists: { SeriesFavs: false, SeriesPendientes: false, SeriesVistas: false, SeriesViendo: false, SeriesVerPronto: false, LikedSeries: false },
    opinion: '',
    rating: 0,
} as any;
const [serieExistenceResult, watchedProgress, mediaTagsDoc, spoilerPref] = await Promise.all([
    safeFetch(checkMediaExistence('serie', clientData.id), `serie/${clientData.id}/existence`, EMPTY_SERIE_EXISTENCE),
    safeFetch(getWatchedProgress(clientData.id), `serie/${clientData.id}/watched`, null as any),
    safeFetch(getMediaTags('tv', clientData.id), `serie/${clientData.id}/tags`, null as any),
    safeFetch(getSpoilerPref(clientData.id), `serie/${clientData.id}/spoilerpref`, null as boolean | null),
]);
const { exists: serieExists, opinion: opinionFromAny, rating: ratingFromAny } = serieExistenceResult;
const userTags = mediaTagsDoc?.tags || [];
const userNotes = mediaTagsDoc?.notes || '';

// Set de episodios vistos para lookup rápido
const watchedSet = new Set<string>();
if (watchedProgress?.watched_episodes) {
    for (const ep of watchedProgress.watched_episodes) {
        watchedSet.add(`${ep.season}-${ep.episode}`);
    }
}
const totalWatchedEpisodes = watchedSet.size;

// "Dónde ver" por temporada: el endpoint de título devuelve la UNIÓN de todas las temporadas,
// así que una serie con la T1 en Prime y el resto solo en Apple TV se anunciaba entera en
// Prime. Se abre en la temporada que estás VIENDO (la primera con episodios sin ver), que es
// la que te importa; las demás las pide el chip a /api/serie/[id]/providers. +1 llamada TMDB.
const providerSeasons: number[] = regularSeasons.map((s: any) => s.season_number);
// Si no has empezado la serie, la vista útil es la UNIÓN ("Toda la serie"): aún no hay una
// temporada "tuya". En cuanto hay progreso, se abre en la primera con episodios sin ver.
const hasProgress = watchedSet.size > 0;
const targetSeason: number | null = providerSeasons.length > 1 && hasProgress
    ? (providerSeasons.find((n) => (allSeasonEpisodes[n] || []).some((ep: any) => !watchedSet.has(`${n}-${ep.episode_number}`)))
        ?? providerSeasons[providerSeasons.length - 1])
    : null;
// Todas las temporadas (cacheadas 24 h) para saber HASTA DÓNDE llega cada plataforma: el
// endpoint de título dice "Netflix y Prime" sin contar que Prime se queda en la T3.
const seasonProviderMap = providerSeasons.length > 1
    ? await safeFetch(getAllSeasonProviders(id, providerSeasons), `serie/${id}/providers/all`, {} as any)
    : {};
const providerCoverage = buildProviderCoverage(seasonProviderMap);
const seasonProviderData = targetSeason !== null ? (seasonProviderMap[targetSeason] ?? null) : null;
const myPlatformIds: number[] = ((Astro.locals.user as any)?.platforms ?? []).map(Number).filter(Number.isFinite);

// Modo sin spoilers (§2): solo con sesión. La SERIE manda sobre el global (parada 2): si hay
// override por serie se usa; si no, el maestro del perfil (OFF por defecto). Invitados: sin blur.
const spoilerFree = !!Astro.locals.user
    && (spoilerPref !== null ? spoilerPref : Astro.locals.user.spoilers?.enabled === true);
// Qué se tapa cuando está activo, del desglose global (A3b). El override por serie decide SI se
// tapa, no QUÉ. El heatmap sigue colgando del maestro: una nota no es un fotograma ni una
// sinopsis, pero un 9,8 en el último episodio también cuenta lo que pasa.
const hideStills = spoilerFree && Astro.locals.user?.spoilers?.hideStills !== false;
const hideSynopsis = spoilerFree && Astro.locals.user?.spoilers?.hideSynopsis !== false;

// Todos los episodios regulares para "marcar todo"
const allRegularEpisodesFlat: { season: number; episode: number }[] = [];
if (item?.seasons) {
    for (const season of item.seasons) {
        if (season.season_number === 0) continue;
        const eps = allSeasonEpisodes[season.season_number] || [];
        for (const ep of eps) {
            allRegularEpisodesFlat.push({ season: season.season_number, episode: ep.episode_number });
        }
    }
}
const allEpisodesStr = allRegularEpisodesFlat.map(e => `${e.season}-${e.episode}`).join(';');
const isAllWatched = allRegularEpisodesFlat.length > 0 && totalWatchedEpisodes >= allRegularEpisodesFlat.length;

// Comprobar si la serie está en cada una de las colecciones
const isInFavorites = serieExists.SeriesFavs;
const isInPendientes = serieExists.SeriesPendiente;
const isInVistas = serieExists.SeriesVistas;
const isInSiguiendo = serieExists.SeriesSiguiendo;
const isInLiked = serieExists.LikedSeries;
const isInVerPronto = serieExists.SeriesVerPronto;

// "Vista N veces" de la serie: base 1 si consta vista (completa o en Vistas/Favs/Me
// gusta) + los "pases" del botón "Vuelto a ver". El conteo NO depende de añadir/quitar
// de listas: la base es fija y solo "Vuelto a ver" suma.
const isWatchedSerie = isAllWatched || isInVistas || isInFavorites || isInLiked;
const seriesPasses = Astro.locals.user ? await countSeriesPasses(id) : { passes: 0, last: null };
const serieTimes = (isWatchedSerie ? 1 : 0) + seriesPasses.passes;
const serieLastPretty = seriesPasses.last ? new Date(seriesPasses.last + 'T12:00:00').toLocaleDateString('es-ES', { month: 'short', year: 'numeric' }) : '';

// Efeméride "tu historia con esta serie" (§6 detalles con alma): fechas YA cargadas en
// watchedProgress (cero consultas nuevas). Empezaste = primer episodio visto; si la
// terminaste (completa), el último mes. Toque cálido "hace un año". Las series en
// progreso las cubre el rescate (§1), no aquí.
let serieEfemeride = '';
{
    const ats = (watchedProgress?.watched_episodes || [])
        .map((ep: any) => ep?.watched_at)
        .filter((d: any): d is string => typeof d === 'string' && d.length > 0)
        .sort();
    if (ats.length) {
        const fmt = (iso: string) => new Date(iso).toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });
        const started = fmt(ats[0]);
        const lastMonth = fmt(ats[ats.length - 1]);
        const days = Math.floor((Date.now() - new Date(ats[0]).getTime()) / 86400000);
        let rel = '';
        if (days >= 330) { const y = Math.max(1, Math.round(days / 365)); rel = y === 1 ? 'hace un año' : `hace ${y} años`; }
        else if (days >= 55) { rel = `hace ${Math.round(days / 30)} meses`; }
        const finished = isAllWatched && lastMonth !== started ? lastMonth : '';
        serieEfemeride = `Empezaste esta serie en ${started}`
            + (finished ? ` · la terminaste en ${finished}` : '')
            + (rel ? ` · ${rel}` : '');
    }
}
const inAnyCollection = isInFavorites || isInPendientes || isInVistas || isInSiguiendo || isInLiked || isInVerPronto;

// Progreso para la barra de acciones (Fase 4): episodios regulares YA emitidos y cuántos has visto.
const serieProgress = (() => {
    const today = new Date().toISOString().slice(0, 10);
    let total = 0, watched = 0;
    for (const season of item?.seasons || []) {
        if (season.season_number === 0) continue;
        for (const ep of allSeasonEpisodes[season.season_number] || []) {
            if (!ep.air_date || ep.air_date > today) continue;
            total++;
            if (watchedSet.has(`${season.season_number}-${ep.episode_number}`)) watched++;
        }
    }
    return { watched, total };
})();

// Posición actual en favoritos + total (siempre que la serie esté añadida o quiera añadirse)
let currentFavPosition: number | null = null;
let totalFavorites = 0;
{
    const favs = await getSerieFav();
    totalFavorites = favs.length;
    const mine = favs.find((s) => s.id === id);
    currentFavPosition = mine?.position ?? null;
}

// Verificar suscripción de notificación
const notifSub = await getNotificationSub('tv', id);
const isNotifSubscribed = !!notifSub;

// Calcular años en emisión
const yearsActiveCalc = (() => {
    if (!item?.first_air_date) return "Desconocido";
    const startYear = new Date(item.first_air_date).getFullYear();
    let endYear: string = "presente";
    if (status === "Ended" || status === "Canceled") {
        const lastAirDate = item?.last_episode_to_air?.air_date;
        endYear = lastAirDate ? String(new Date(lastAirDate).getFullYear()) : "desconocido";
    }
    return `${startYear} - ${endYear}`;
})();

const statusMap = {
    "Returning Series": "Serie en emisión",
    Ended: "Finalizada",
    Canceled: "Cancelada",
    Pilot: "Piloto",
};

const yearsActive = yearsActiveCalc;

// B1 (2026-10-29): datos que ya llegan de TMDB y no se enseñaban.
// Tipo de serie: solo se marca lo que NO es ficción normal (Scripted).
const SERIES_TYPE_LABEL: Record<string, string> = {
    Miniseries: 'Miniserie', Documentary: 'Documental', Reality: 'Reality',
    'Talk Show': 'Talk show', News: 'Noticias', Video: 'Vídeo',
};
const seriesTypeLabel: string | null = SERIES_TYPE_LABEL[item?.type as string] ?? null;
// Creadores (enlazan a su página de equipo, como el resto del equipo).
const createdBy: { name: string }[] = (item?.created_by || []).filter((c: any) => c?.name);
// Duración por episodio: la de TMDB si la da; si no (cada vez más frecuente), la media real de
// los episodios regulares ya cargados.
const episodeRuntime: number | null = (() => {
    const declared = Number(item?.episode_run_time?.[0]);
    if (declared > 0) return declared;
    const runtimes = regularSeasons
        .flatMap((s: any) => allSeasonEpisodes[s.season_number] || [])
        .map((ep: any) => Number(ep.runtime))
        .filter((n: number) => n > 0);
    return runtimes.length ? Math.round(runtimes.reduce((a: number, b: number) => a + b, 0) / runtimes.length) : null;
})();
// Fecha del último episodio emitido, solo si la serie ya no sigue (si sigue, manda «Próximo episodio»).
const lastAirDate: string | null = (status === 'Ended' || status === 'Canceled') && item?.last_air_date ? item.last_air_date : null;

// B2a (2026-10-29): marca de episodio según `episode_type` de TMDB («finale», «mid_season»). El último
// episodio de la última temporada de una serie terminada es «FINAL DE SERIE». No es un spoiler: dice
// dónde acaba la temporada, igual que el número de episodios.
const seriesIsOver = status === 'Ended' || status === 'Canceled';
const lastRegularSeasonNumber = Math.max(0, ...regularSeasons.map((s: any) => s.season_number));
function episodeMark(ep: any): { label: string; title: string } | null {
    if (!ep) return null;
    if (ep.episode_type === 'finale') {
        const seasonEps = allSeasonEpisodes[ep.season_number] || [];
        const isLastOfSeries = seriesIsOver && ep.season_number === lastRegularSeasonNumber
            && ep.episode_number === seasonEps[seasonEps.length - 1]?.episode_number;
        return isLastOfSeries
            ? { label: 'FINAL DE SERIE', title: 'Último episodio de la serie' }
            : { label: 'FINAL', title: 'Último episodio de la temporada' };
    }
    if (ep.episode_type === 'mid_season') {
        return { label: 'PARÓN', title: 'Final de mitad de temporada: la temporada para y sigue más adelante' };
    }
    return null;
}
// Dirección y guion de un episodio (vienen en `crew` de cada episodio).
const EPISODE_WRITER_JOBS = ['Writer', 'Teleplay', 'Screenplay'];
// ---- 4.6 · Temporadas fundidas ----
// Banda de color de un episodio por su nota de TMDB (README del handoff D3): ≥ 9 · 8–8,9 · 6,5–7,9 · < 6,5.
function epBand(ep: any): 'high' | 'med' | 'low' | 'poor' | 'none' {
    const v = typeof ep?.vote_average === 'number' && (ep.vote_count ?? 1) > 0 ? ep.vote_average : 0;
    if (!v) return 'none';
    return v >= 9 ? 'high' : v >= 8 ? 'med' : v >= 6.5 ? 'low' : 'poor';
}
// Tope de casillas por fila (los Especiales de algunas series pasan de 300): el resto, «+N».
const STRIP_MAX = 48;
// «hoy», «mañana», «en 3 días» o la fecha (próximo episodio).
function relAirDate(iso?: string | null): string {
    if (!iso) return '';
    const today = new Date(new Date().toISOString().slice(0, 10) + 'T00:00:00Z').getTime();
    const d = Math.round((Date.parse(iso + 'T00:00:00Z') - today) / 86400000);
    if (d === 0) return 'hoy';
    if (d === 1) return 'mañana';
    if (d > 1 && d < 7) return `en ${d} días`;
    return formatDate(iso);
}
// Último y próximo episodio en una línea (antes, dos tarjetas). Fotograma y sinopsis, al desplegar;
// sin spoilers, difuminados si no lo has visto.
const epLines = ([['Próximo', item?.next_episode_to_air], ['Último', item?.last_episode_to_air]] as const)
    .filter(([, ep]) => !!ep)
    .map(([label, ep]: any) => ({
        label, ep, mark: episodeMark(ep),
        when: label === 'Próximo' ? relAirDate(ep.air_date) : formatDate(ep.air_date),
        seen: watchedSet.has(`${ep.season_number}-${ep.episode_number}`),
    }));

function episodeCredits(ep: any): { directors: string[]; writers: string[] } {
    const crew: any[] = ep?.crew || [];
    const names = (jobs: string[]) => [...new Set(crew.filter((c) => jobs.includes(c.job)).map((c) => c.name as string))];
    return { directors: names(['Director']), writers: names(EPISODE_WRITER_JOBS) };
}

// Ordenar temporadas: primero las regulares, luego las especiales
const sortedSeasons = item?.seasons?.sort((a, b) => {
    // Las temporadas especiales (0) van al final
    if (a.season_number === 0 && b.season_number !== 0) return 1;
    if (b.season_number === 0 && a.season_number !== 0) return -1;
    // Para el resto, orden numérico normal
    return a.season_number - b.season_number;
}) || [];

// Variables útiles para usar en el template
const hasSpecialSeasons = specialSeasons.length > 0;
const regularSeasonsCount = regularSeasons.length;
const specialSeasonsCount = specialSeasons.length;

import type {PosterImage} from '../../services/API/Series/InfoSeries';

// Segundo bloque de datos — todo en paralelo
const tmdbId = item?.id;

// Ya vienen en el paquete de la ficha (C2): sin llamadas.
const allPosters: PosterImage[] = bundle?.posters ?? [];
const externalIds: any = bundle?.externalIds ?? {};
const additionalInfo: Record<string, any> = bundle?.additionalInfo ?? { keywords: [], networks: [], content_ratings: [], episode_run_time: [], languages: [], tagline: null };
const allVideos: any[] = bundle?.videos ?? [];
const reviewsData = bundle?.reviews ?? { results: [] };
const serieLogo = bundle?.logo ?? null;

const [
    seriesRecommendationsData,
    crossMediaMovies,
] = await Promise.all([
    tmdbId ? getSerieRecommendationsOrSimilar(tmdbId) : Promise.resolve({ success: false, recommendations: [], type: 'recommendations' as const }),
    // Películas de la misma saga. En paralelo con el resto para no sumar nada al TTFB, y
    // cacheada 24h desde la primera visita (incluido el resultado vacío, que es el habitual).
    // Las keywords ya llegan en el paquete: así no las vuelve a pedir.
    tmdbId
        ? getCrossMediaRelated({ type: 'tv', id: tmdbId, title: item?.name || '', originalTitle: item?.original_name, keywords: bundle?.keywords })
            .catch(() => [])
        : Promise.resolve([]),
]);

const posters: PosterImage[] = allPosters.slice(0, 40);
const seriesRecommendations = seriesRecommendationsData.success ? seriesRecommendationsData.recommendations : [];
const seriesRecommendationType = seriesRecommendationsData.type || 'recommendations';
const imdbId = externalIds.imdb_id;
const serieSocialLinks = {
    facebook: externalIds.facebook_id ? `https://facebook.com/${externalIds.facebook_id}` : null,
    instagram: externalIds.instagram_id ? `https://instagram.com/${externalIds.instagram_id}` : null,
    twitter: externalIds.twitter_id ? `https://twitter.com/${externalIds.twitter_id}` : null,
};
const hasSocialLinks = Object.values(serieSocialLinks).some(v => v);
const serieKeywords: { id: number; name: string }[] = additionalInfo.keywords || [];
const serieLanguages: { iso_639_1: string; name: string }[] = additionalInfo.languages || [];

// Reparto cruzado con tu biblioteca (3.4): solo si la caché de top-actores está caliente.
const _topActors = Astro.locals.user ? peekTopActors() : null;
const seenWithMap = _topActors ? new Map(_topActors.map((a) => [a.id, a.appearances])) : undefined;
const serieNetworks: { id: number; name: string; logo_path: string | null }[] = additionalInfo.networks || [];
// Kicker del hero (4.3): «SERIE · HBO · 2011–2019 · CREADA POR …» (en emisión, «2019–hoy»).
const kickerYears: string = (() => {
    const start = item?.first_air_date ? item.first_air_date.slice(0, 4) : '';
    if (!start) return '';
    const ended = status === 'Ended' || status === 'Canceled';
    const end = ended ? (item?.last_air_date || item?.last_episode_to_air?.air_date || '').slice(0, 4) : '';
    return ended ? (end && end !== start ? `${start}–${end}` : start) : `${start}–hoy`;
})();
const reviews = (reviewsData.results || []).filter((r: any) => r.content && r.content.length > 50).slice(0, 5);
const productionCountries: string[] = item?.origin_country || [];

// Categorizar videos (el tráiler principal ya va en `trailerUrl`)
const clips = allVideos.filter((v: any) => v.type === 'Clip');
// B4a: también cabeceras y resúmenes («Opening Credits», «Recap»), que antes se descartaban.
const behindScenes = allVideos.filter((v: any) => ['Behind the Scenes', 'Bloopers', 'Featurette', 'Opening Credits', 'Recap'].includes(v.type));
const teasers = allVideos.filter((v: any) => v.type === 'Teaser');

// JSON-LD structured data (schema.org TVSeries)
const jsonLd = item ? {
    "@context": "https://schema.org",
    "@type": "TVSeries",
    "name": item.name,
    ...(item.poster_path && { image: item.poster_path }),
    ...(item.first_air_date && { datePublished: item.first_air_date }),
    ...(item.overview && { description: item.overview }),
    ...(item.genres?.length && { genre: item.genres.map((g: any) => g.name) }),
    ...(item.seasons?.length && { numberOfSeasons: item.seasons.filter((s: any) => s.season_number > 0).length }),
    ...(item.vote_count > 0 && {
        aggregateRating: {
            "@type": "AggregateRating",
            ratingValue: item.vote_average,
            bestRating: 10,
            ratingCount: item.vote_count,
        }
    }),
} : null;
---
<Layout
    title={`${title}`}
    description={item?.overview || undefined}
    ogImage={item?.poster_path || item?.backdrop_path || undefined}
    ogType="video.tv_show"
>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Sin fondo propio: va sobre el gris de la página, como la ficha de episodio y el resto de la web
         (antes `bg-gray-50` hacía un «doble fondo», un panel más claro con franjas a los lados). -->
    <article>
        <!-- Hero inmersivo -->
        <div class="relative w-full min-h-[70vh] bg-cover bg-center bg-no-repeat" style={`background-image: url(${item?.backdrop_path ? originalUrl(item.backdrop_path) : '/assets/background.svg'})`}>
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/70 to-gray-900/40"></div>

            <div class="relative z-10 max-w-6xl mx-auto px-4 pt-8 pb-16 flex flex-col justify-end min-h-[70vh]">
                <nav class="absolute top-6 left-4 right-4" aria-label="Breadcrumb">
                    <ol class="flex items-center space-x-2 text-sm">
                        <li><a href="/" class="text-white/70 hover:text-white transition-colors">Inicio</a></li>
                        <li class="text-white/40">/</li>
                        <li><a href="/catalogo/topseries" class="text-white/70 hover:text-white transition-colors">Series</a></li>
                        <li class="text-white/40">/</li>
                        <li class="text-white/90 font-medium truncate max-w-xs">{item?.name}</li>
                    </ol>
                </nav>

                <div class="flex flex-col md:flex-row items-end gap-8">
                    <div class="hidden md:block flex-shrink-0 w-56 rounded-xl overflow-hidden shadow-2xl ring-1 ring-white/10">
                        <img src={posterUrl(item?.poster_path)} alt={item?.name} class="w-full aspect-[2/3] object-cover" />
                    </div>
                    <div class="flex-1 text-white">
                        <p class="ficha-kicker">
                            Serie{serieNetworks[0]?.name && <> · {serieNetworks[0].name}</>}{kickerYears && <> · {kickerYears}</>}
                            {createdBy.length > 0 && <> · Creada por {createdBy.slice(0, 3).map((c, i, arr) => (<>{i > 0 && (i === arr.length - 1 ? ' y ' : ', ')}<a href={`/team/${encodeURIComponent(c.name)}`}>{c.name}</a></>))}</>}
                        </p>
                        {serieLogo
                            ? <h1 class="mb-3"><img src={serieLogo} alt={item?.name} class="h-auto max-h-20 md:max-h-28 w-auto max-w-[85%] md:max-w-[440px] object-contain drop-shadow-lg" /></h1>
                            : <h1 class="text-4xl md:text-5xl font-bold mb-3 leading-tight">{item?.name}</h1>}
                        {additionalInfo.tagline && (
                            <p class="text-white/60 italic text-lg mb-4">"{additionalInfo.tagline}"</p>
                        )}
                        <div class="flex flex-wrap items-center gap-3 mb-4">
                            <span class="text-yellow-400 text-lg font-bold">{item?.vote_average?.toFixed(1)} {getRatingStars(item?.vote_average)}</span>
                            <span class={`px-2.5 py-0.5 rounded-full text-xs font-medium ${status === 'Returning Series' ? 'bg-green-500/80' : status === 'Ended' ? 'bg-gray-500/80' : status === 'Canceled' ? 'bg-red-500/80' : 'bg-blue-500/80'}`}>
                                {status ? ((statusMap as any)[status] || status) : ''}
                            </span>
                            {seriesTypeLabel && (
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-white/20 text-white">{seriesTypeLabel}</span>
                            )}
                            <span class="text-white/70">{yearsActive}</span>
                            <span class="text-white/70">{regularSeasonsCount} temporadas</span>
                            <span class="text-white/70">{totalRegularEpisodes} episodios</span>
                            {item?.availableInSpain && (
                                <span title="Disponible en España"><svg viewBox="0 0 750 500" class="w-8 h-5 rounded"><rect width="750" height="500" fill="#AA151B"/><rect width="750" height="250" y="125" fill="#F1BF00"/></svg></span>
                            )}
                        </div>
                        {item?.genres && (
                            <div class="flex flex-wrap gap-2 mb-5">
                                {item.genres.map((genre) => (
                                    <span class="px-3 py-1 bg-white/10 backdrop-blur-sm text-white text-xs rounded-full border border-white/20">{genre.name}</span>
                                ))}
                            </div>
                        )}
                        {item?.overview && (
                            <details class="max-w-2xl group">
                                <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                                    <p class="text-white/80 text-sm md:text-base leading-relaxed line-clamp-3 group-open:line-clamp-none">{item.overview}</p>
                                    <span class="inline-block mt-1 text-xs text-white/50 group-open:hidden">Pulsa para leer más</span>
                                </summary>
                            </details>
                        )}
                    </div>
                </div>
            </div>
        </div>

        <!-- Barra de acciones (rediseño, Fase 4 · 4.2): Seguir / Siguiendo ▾ / Retomar, Nivel, Pendiente,
             Ver pronto, Nuevas temporadas y, debajo, visionados, progreso y posición en Favoritos. -->
        <FichaActions
            mediaType="tv"
            id={id}
            title={item?.name || ''}
            poster={item?.poster_path}
            state={{ vistas: isInVistas, liked: isInLiked, fav: isInFavorites, pend: isInPendientes, pronto: isInVerPronto, siguiendo: isInSiguiendo, abandonada: !!serieExists.SeriesAbandonadas }}
            watched={isWatchedSerie}
            times={serieTimes}
            lastPretty={serieLastPretty}
            efemeride={serieEfemeride}
            notif={isNotifSubscribed}
            favPos={currentFavPosition}
            favTotal={totalFavorites}
            progress={serieProgress}
            imdbId={imdbId}
            providersByCountry={(item as any)?.providersByCountry || {}}
            linkByCountry={(item as any)?.providerLinksByCountry || {}}
            myPlatformIds={myPlatformIds}
            homepage={item?.homepage}
            trailerUrl={trailerUrl}
        />
        <FichaSections items={[
            { id: 'sec-temporadas', label: 'Temporadas' },
            { id: 'sec-donde', label: 'Dónde ver' },
            { id: 'sec-videos', label: 'Vídeos' },
            { id: 'sec-reparto', label: 'Reparto' },
            { id: 'sec-imagenes', label: 'Imágenes' },
            { id: 'sec-detalles', label: 'Detalles' },
            { id: 'sec-resenas', label: 'Reseñas' },
            { id: 'sec-parecidas', label: 'Parecidas' },
        ]} />

        <!-- Layout 2 columnas -->
        <div class="max-w-6xl mx-auto px-4 py-8">
            <div class="flex flex-col md:flex-row gap-8">

                <!-- Sidebar izquierda -->
                <div class="md:w-1/3 space-y-4">
                    <div class="md:hidden w-56 mx-auto rounded-xl overflow-hidden shadow-xl">
                        <img src={posterUrl(item?.poster_path)} alt={item?.name} class="w-full aspect-[2/3] object-cover" />
                    </div>

                    <!-- Dónde ver -->
                    <div id="sec-donde" data-fs>
                    <StreamingProviders
                        providersByCountry={(item as any)?.providersByCountry || {}}
                        linkByCountry={(item as any)?.providerLinksByCountry || {}}
                        myPlatformIds={myPlatformIds}
                        seasons={providerSeasons}
                        initialSeason={targetSeason}
                        seasonData={seasonProviderData}
                        coverage={providerCoverage}
                        totalSeasons={providerSeasons.length}
                        serieId={id}
                    />
                    </div>

                    <!-- Amigos que la han visto (F5 social) -->
                    <FriendsSeen mediaType="tv" tmdbId={item?.id} />

                    <!-- Nota personal -->
                    {!(isInFavorites || isInPendientes || isInVistas || isInSiguiendo || isInLiked || isInVerPronto) && <RecommendedBlock mediaType="tv" tmdbId={item?.id} alone />}
                    {(isInFavorites || isInPendientes || isInVistas || isInSiguiendo || isInLiked || isInVerPronto) && (
                        <StarRating
                            currentRating={ratingFromAny}
                            tmdbRating={Number(item?.vote_average) || 0}
                            itemId={String(item?.id)}
                            mediaType="serie"
                        ><RecommendedBlock mediaType="tv" tmdbId={item?.id} /></StarRating>
                    )}

                    <!-- Opinión -->
                    {(isInFavorites || isInPendientes || isInVistas || isInSiguiendo || isInLiked || isInVerPronto) && (
                        <div class="bg-white rounded-xl border border-gray-200 p-4">
                            <h3 class="text-base font-semibold text-gray-800 mb-3">Tu opinión</h3>
                            {opinionFromAny ? (
                                <div class="space-y-3">
                                    <blockquote class="p-3 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-700 whitespace-pre-wrap">{opinionFromAny}</blockquote>
                                    <div class="flex items-center gap-2 justify-end">
                                        <details>
                                            <summary class="min-h-[44px] md:min-h-0 px-4 py-2.5 md:px-3 md:py-1.5 text-xs rounded-lg bg-gray-900 hover:bg-gray-800 text-white cursor-pointer inline-flex items-center">Actualizar</summary>
                                            <form method="POST" class="mt-3 space-y-2">
                                                <input type="hidden" name="id" value={item?.id} />
                                                <input type="hidden" name="action" value="save_opinion" />
                                                <input type="hidden" name="actionType" value="opinion" />
                                                <textarea name="opinion" rows="3" class="w-full p-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-gray-400">{opinionFromAny}</textarea>
                                                <button type="submit" class="w-full min-h-[44px] md:min-h-0 px-4 py-2.5 md:px-3 md:py-1.5 bg-gray-900 text-white text-xs rounded-lg hover:bg-gray-800">Guardar</button>
                                            </form>
                                        </details>
                                        <form method="POST">
                                            <input type="hidden" name="id" value={item?.id} />
                                            <input type="hidden" name="action" value="delete_opinion" />
                                            <input type="hidden" name="actionType" value="opinion" />
                                            <button type="submit" class="min-h-[44px] md:min-h-0 px-4 py-2.5 md:px-3 md:py-1.5 text-xs rounded-lg bg-red-50 text-red-600 border border-red-200 hover:bg-red-100">Eliminar</button>
                                        </form>
                                    </div>
                                </div>
                            ) : (
                                <form method="POST" class="space-y-2">
                                    <input type="hidden" name="id" value={item?.id} />
                                    <input type="hidden" name="action" value="save_opinion" />
                                    <input type="hidden" name="actionType" value="opinion" />
                                    <textarea name="opinion" rows="3" class="w-full p-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-gray-400" placeholder="Escribe tu opinión..."></textarea>
                                    <button type="submit" class="w-full min-h-[44px] md:min-h-0 px-4 py-2.5 md:px-3 md:py-1.5 bg-gray-900 text-white text-xs rounded-lg hover:bg-gray-800">Guardar opinión</button>
                                </form>
                            )}
                        </div>
                    )}

                    <!-- Tus tags + notas (C15) -->
                    {inAnyCollection && (
                        <div class="bg-white rounded-xl border border-gray-200 p-4">
                            <h3 class="text-base font-semibold text-gray-800 mb-3 flex items-center gap-2">
                                <span class="w-1 h-5 bg-fuchsia-500 rounded-full"></span>
                                Tus tags y notas
                            </h3>
                            {userTags.length > 0 && (
                                <div class="flex flex-wrap gap-1.5 mb-3">
                                    {userTags.map(t => (
                                        <span class="px-2 py-0.5 text-xs bg-fuchsia-50 text-fuchsia-700 border border-fuchsia-200 rounded-full">#{t}</span>
                                    ))}
                                </div>
                            )}
                            {userNotes && (
                                <blockquote class="p-3 mb-3 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-700 whitespace-pre-wrap">{userNotes}</blockquote>
                            )}
                            <details>
                                <summary class="cursor-pointer text-xs text-fuchsia-600 hover:text-fuchsia-700 font-medium">
                                    {userTags.length > 0 || userNotes ? 'Editar' : 'Añadir tags y notas'}
                                </summary>
                                <form method="POST" class="mt-3 space-y-2">
                                    <input type="hidden" name="actionType" value="media_tags" />
                                    <input type="hidden" name="media_type" value="tv" />
                                    <input type="hidden" name="tmdb_id" value={item?.id} />
                                    <input
                                        type="text"
                                        name="tags"
                                        value={userTags.join(', ')}
                                        placeholder="comedia, true crime, 2026..."
                                        class="w-full p-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-fuchsia-400"
                                    />
                                    <p class="text-[11px] text-gray-400">Separados por comas. Máx 20.</p>
                                    <textarea
                                        name="notes"
                                        rows="3"
                                        placeholder="Notas más libres que la opinión..."
                                        class="w-full p-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-fuchsia-400">{userNotes}</textarea>
                                    <button type="submit" class="w-full min-h-[44px] md:min-h-0 px-4 py-2.5 md:px-3 md:py-1.5 bg-fuchsia-600 text-white text-xs rounded-lg hover:bg-fuchsia-700">Guardar</button>
                                </form>
                            </details>
                            <HideFromProfileToggle mediaType="tv" tmdbId={item?.id} title={item?.name || ''} posterPath={item?.poster_path ?? null} />
                        </div>
                    )}

                    <!-- Información (con clasificación, cadena, enlaces e idiomas; rediseño 4.4) -->
                    <div id="sec-detalles" data-fs class="bg-white rounded-xl border border-gray-200 p-4">
                        <h3 class="text-base font-semibold text-gray-800 mb-3">Información</h3>
                        <ul class="space-y-2.5 text-sm sm:text-base">
                            <li class="flex justify-between"><span class="text-gray-500">Estado</span><span class={`font-medium ${status === 'Returning Series' ? 'text-green-600' : status === 'Canceled' ? 'text-red-600' : 'text-gray-800'}`}>{status ? ((statusMap as any)[status] || status) : ''}</span></li>
                            <li class="flex justify-between"><span class="text-gray-500">Emisión</span><span class="text-gray-800 font-medium">{yearsActive}</span></li>
                            <li class="flex justify-between"><span class="text-gray-500">Temporadas</span><span class="text-gray-800 font-medium">{regularSeasonsCount}{hasSpecialSeasons ? ` + ${specialSeasonsCount} especiales` : ''}</span></li>
                            <li class="flex justify-between"><span class="text-gray-500">Episodios</span><span class="text-gray-800 font-medium">{totalRegularEpisodes}</span></li>
                            {episodeRuntime && (
                                <li class="flex justify-between"><span class="text-gray-500">Duración</span><span class="text-gray-800 font-medium">{formatRuntime(episodeRuntime)} por episodio</span></li>
                            )}
                            {lastAirDate && (
                                <li class="flex justify-between gap-2"><span class="text-gray-500 flex-shrink-0">Última emisión</span><span class="text-gray-800 font-medium text-right">{formatDate(lastAirDate)}</span></li>
                            )}
                            {createdBy.length > 0 && (
                                <li class="flex justify-between gap-2">
                                    <span class="text-gray-500 flex-shrink-0">Creada por</span>
                                    <span class="text-gray-800 font-medium text-right">
                                        {createdBy.map((c, i) => (
                                            <>{i > 0 && ', '}<a href={`/team/${encodeURIComponent(c.name)}`} class="hover:text-blue-600 hover:underline">{c.name}</a></>
                                        ))}
                                    </span>
                                </li>
                            )}
                            {/* Clasificación por edades (antes, tarjeta aparte) */}
                            {(() => {
                                const rating = additionalInfo.content_ratings?.length ? getContentRating(additionalInfo.content_ratings) : null;
                                return rating ? <li class="flex justify-between gap-2"><span class="text-gray-500 flex-shrink-0">Clasificación</span><span class="text-gray-800 font-medium text-right">{rating.text}</span></li> : null;
                            })()}
                            {/* Cadenas (antes, tarjeta aparte) */}
                            {serieNetworks.length > 0 && (
                                <li class="flex justify-between gap-3">
                                    <span class="text-gray-500 flex-shrink-0">{serieNetworks.length === 1 ? 'Cadena' : 'Cadenas'}</span>
                                    <span class="flex flex-col items-end gap-1.5">
                                        {serieNetworks.map((network) => (
                                            <span class="flex items-center gap-2 text-gray-800 font-medium">
                                                {network.logo_path && <img src={posterUrl(network.logo_path, 'w92')} alt="" class="w-10 h-5 object-contain" loading="lazy" />}
                                                {network.name}
                                            </span>
                                        ))}
                                    </span>
                                </li>
                            )}
                            <li class="flex justify-between"><span class="text-gray-500">Valoración</span><span class="text-gray-800 font-medium">{item?.vote_average?.toFixed(1)} <span class="text-gray-400 text-xs">({item?.vote_count})</span></span></li>
                            <li class="flex justify-between"><span class="text-gray-500">Popularidad</span><span class="text-gray-800 font-medium">{item?.popularity?.toFixed(0)}</span></li>
                            <li class="flex justify-between"><span class="text-gray-500">Idioma</span><span class="text-gray-800 font-medium">{getLanguageDisplayName(item?.original_language)}</span></li>
                            {item?.original_name && item.original_name !== item.name && (
                                <li class="flex flex-col"><span class="text-gray-500">Título original</span><span class="text-gray-800 font-medium">{item.original_name}</span></li>
                            )}
                            {productionCountries.length > 0 && (
                                <li class="flex justify-between gap-2"><span class="text-gray-500 flex-shrink-0">País</span><span class="text-gray-800 font-medium text-right">{productionCountries.join(', ')}</span></li>
                            )}
                        </ul>
                        {(hasSocialLinks || imdbId || serieLanguages.length > 0) && (
                            <div class="mt-4 pt-3 border-t border-gray-100 space-y-3">
                        {(hasSocialLinks || imdbId) && (
                            <div class="flex flex-wrap gap-2">
                                {imdbId && <a href={`https://www.imdb.com/title/${imdbId}`} target="_blank" rel="noopener" class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-yellow-50 text-yellow-800 rounded-lg hover:bg-yellow-100">IMDb</a>}
                                {serieSocialLinks.facebook && <a href={serieSocialLinks.facebook} target="_blank" rel="noopener" class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100">Facebook</a>}
                                {serieSocialLinks.instagram && <a href={serieSocialLinks.instagram} target="_blank" rel="noopener" class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-pink-50 text-pink-700 rounded-lg hover:bg-pink-100">Instagram</a>}
                                {serieSocialLinks.twitter && <a href={serieSocialLinks.twitter} target="_blank" rel="noopener" class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-sky-50 text-sky-700 rounded-lg hover:bg-sky-100">Twitter</a>}
                            </div>
                        )}
                        {serieLanguages.length > 0 && (
                            <div class="flex flex-wrap items-center gap-1.5">
                                <span class="text-xs text-gray-500 mr-1">Idiomas</span>
                                {serieLanguages.map((lang) => (
                                    <span class="px-2 py-0.5 text-xs bg-gray-100 text-gray-600 rounded-full">{getLanguageDisplayName(lang.iso_639_1)}</span>
                                ))}
                            </div>
                        )}
                            </div>
                        )}
                    </div>

                    <!-- Palabras clave de TMDB (aparte de tus etiquetas): plegadas en móvil -->
                    {serieKeywords.length > 0 && (
                        <>
                            <details class="bg-white rounded-xl border border-gray-200 sm:hidden">
                                <summary class="p-4 cursor-pointer flex items-center justify-between">
                                    <h3 class="text-base font-semibold text-gray-800">Palabras clave de TMDB ({serieKeywords.length})</h3>
                                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                                </summary>
                                <div class="px-4 pb-4 flex flex-wrap gap-1.5">
                                    {serieKeywords.map((kw) => (
                                        <a href={`/catalogo/keyword/${kw.id}?name=${encodeURIComponent(kw.name)}`} class="px-2 py-0.5 text-xs bg-gray-100 text-gray-500 rounded-full hover:bg-[#E63946]/10 hover:text-[#E63946] transition-colors">{kw.name}</a>
                                    ))}
                                </div>
                            </details>
                            <div class="hidden sm:block bg-white rounded-xl border border-gray-200 p-4">
                                <h3 class="text-base font-semibold text-gray-800 mb-2">Palabras clave de TMDB</h3>
                                <div class="flex flex-wrap gap-1.5">
                                    {serieKeywords.map((kw) => (
                                        <a href={`/catalogo/keyword/${kw.id}?name=${encodeURIComponent(kw.name)}`} class="px-2 py-0.5 text-xs bg-gray-100 text-gray-500 rounded-full hover:bg-[#E63946]/10 hover:text-[#E63946] transition-colors">{kw.name}</a>
                                    ))}
                                </div>
                            </div>
                        </>
                    )}
                </div>

                <!-- Columna derecha -->
                <div class="md:w-2/3 space-y-8">

                    <!-- Temporadas (ancla de la barra de secciones): próximo y último episodio, calidad y acordeón -->
                    <div id="sec-temporadas" data-fs class="space-y-8">
                    <!-- Temporadas con acordeón -->
                    <div class="bg-white rounded-xl border border-gray-200 p-5">
                        <div class="flex items-center justify-between gap-3 mb-2">
                            <h2 class="text-xl font-semibold text-gray-800">Temporadas y Episodios</h2>
                            {allRegularEpisodesFlat.length > 0 && (
                                <form method="POST" class="flex-shrink-0">
                                    <input type="hidden" name="actionType" value="watched_all" />
                                    <input type="hidden" name="allEpisodes" value={allEpisodesStr} />
                                    <input type="hidden" name="action" value={isAllWatched ? 'unmark' : 'mark'} />
                                    <button type="submit" class={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors ${isAllWatched ? 'bg-green-500 text-white hover:bg-green-600' : 'border border-gray-300 text-gray-500 hover:border-green-400 hover:text-green-600'}`}>
                                        {isAllWatched ? 'Desmarcar todo' : 'Marcar todo'}
                                    </button>
                                </form>
                            )}
                        </div>
                        <div class="flex flex-wrap items-center gap-2 mb-4">
                            <span class="text-sm text-gray-500">{regularSeasonsCount} temporadas • {totalRegularEpisodes} episodios{hasSpecialSeasons ? ` • ${specialSeasonsCount} especiales` : ''}</span>
                            <span
                                class="text-sm font-medium text-green-600"
                                data-total-watched={totalWatchedEpisodes}
                                data-total-regular={totalRegularEpisodes}
                                style={totalWatchedEpisodes > 0 ? '' : 'display:none'}
                            >
                                • <span data-total-count>{totalWatchedEpisodes}/{totalRegularEpisodes}</span> vistos (<span data-total-pct>{totalRegularEpisodes > 0 ? Math.round(totalWatchedEpisodes / totalRegularEpisodes * 100) : 0}</span>%)
                            </span>
                            {Astro.locals.user && (
                                <div class="flex-shrink-0 ml-auto flex items-center gap-2 flex-wrap justify-end">
                                    <form method="POST">
                                        <input type="hidden" name="actionType" value="spoiler_pref" />
                                        <input type="hidden" name="value" value={spoilerFree ? 'off' : 'on'} />
                                        <button type="submit"
                                            class={`inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-lg border transition-colors ${spoilerFree ? 'border-[#E63946] text-[#E63946] bg-red-50' : 'border-gray-200 text-gray-500 hover:border-gray-400 hover:text-gray-700'}`}
                                            title={spoilerPref !== null
                                                ? 'Esta serie tiene su propio ajuste y no sigue el de tu perfil'
                                                : 'Difumina el fotograma y la sinopsis de los episodios que no has visto en esta serie'}>
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
                                            {spoilerFree ? 'Sin spoilers: activo' : (spoilerPref === false ? 'Spoilers visibles' : 'Modo sin spoilers')}
                                        </button>
                                    </form>
                                    {/* Tercer estado: hay override, así que esta serie IGNORA el global. Sin esto,
                                        "override en off" y "sigo el global (off)" se ven idénticos.
                                        La pastilla enuncia el hecho y la × lo deshace — mismo patrón que los chips
                                        de filtro activo del catálogo, en vez de un enlace compitiendo con el botón. */}
                                    {spoilerPref !== null && (
                                        <form method="POST">
                                            <input type="hidden" name="actionType" value="spoiler_pref" />
                                            <input type="hidden" name="value" value="inherit" />
                                            <button type="submit"
                                                class="inline-flex items-center gap-1 text-[11px] leading-none px-2 py-[5px] rounded-md bg-gray-50 border border-gray-200 text-gray-500 hover:border-gray-400 hover:text-gray-700 transition-colors"
                                                title="Esta serie tiene su propio ajuste y no sigue el de tu perfil. Quítalo para volver a seguirlo.">
                                                solo en esta serie
                                                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                                            </button>
                                        </form>
                                    )}
                                </div>
                            )}
                        </div>
                        {/* Barra de progreso global */}
                        <div
                            class="w-full bg-gray-200 rounded-full h-2 mb-6"
                            data-total-progress
                            style={totalWatchedEpisodes > 0 ? '' : 'display:none'}
                        >
                            <div
                                class="bg-green-500 h-2 rounded-full transition-all"
                                data-total-bar
                                style={`width: ${totalRegularEpisodes > 0 ? Math.min(100, Math.round(totalWatchedEpisodes / totalRegularEpisodes * 100)) : 0}%`}
                            ></div>
                        </div>
                        {/* 4.6 · Leyenda de la tira, en una línea */}
                        <p class="sr-legend">
                            <span><i class="sr-c is-seen" data-b="high"></i>≥ 9</span>
                            <span><i class="sr-c is-seen" data-b="med"></i>8–8,9</span>
                            <span><i class="sr-c is-seen" data-b="low"></i>6,5–7,9</span>
                            <span><i class="sr-c is-seen" data-b="poor"></i>&lt; 6,5</span>
                            <span><i class="sr-c is-seen" data-b="none"></i>sin nota</span>
                            <span class="sr-legend-k">color pleno = visto · apagado = sin ver</span>
                        </p>
                        {/* 4.6 · Próximo y último episodio, una línea cada uno */}
                        {epLines.length > 0 && (
                            <div class="sr-eps">
                                {epLines.map((l) => (
                                    <details class="sr-el">
                                        <summary>
                                            <span class:list={['sr-el-k', { 'is-next': l.label === 'Próximo' }]}>{l.label}</span>
                                            <span class="sr-el-code">T{l.ep.season_number}·E{l.ep.episode_number}</span>
                                            <a href={episodeHref(id, l.ep.season_number, l.ep.episode_number)} class="sr-el-name" onclick="event.stopPropagation()">{l.ep.name}</a>
                                            {l.mark && <span class="sr-el-mark" title={l.mark.title}>{l.mark.label}</span>}
                                            <span class="sr-el-when">{l.when}</span>
                                            {l.ep.vote_average > 0 && l.label === 'Último' && (!spoilerFree || l.seen) && <span class="sr-el-r">★ {l.ep.vote_average.toFixed(1).replace('.', ',')}</span>}
                                            {(l.ep.overview || l.ep.still_path) && <svg class="sr-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>}
                                        </summary>
                                        {(l.ep.overview || l.ep.still_path) && (
                                            <div class:list={['sr-el-body', { 'yf-spoil': (hideStills || hideSynopsis) && !l.seen }]}>
                                                {(hideStills || hideSynopsis) && !l.seen && (
                                                    <button type="button" class="yf-spoil-btn" aria-label="Mostrar contenido con posibles spoilers">
                                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                                        Mostrar (spoilers)
                                                    </button>
                                                )}
                                                {l.ep.still_path && <img src={posterUrl(l.ep.still_path, 'w300')} alt="" loading="lazy" class:list={['sr-el-still', { 'yf-blur': hideStills && !l.seen }]} />}
                                                {l.ep.overview && <p class:list={{ 'yf-blur': hideSynopsis && !l.seen }}>{l.ep.overview}</p>}
                                            </div>
                                        )}
                                    </details>
                                ))}
                            </div>
                        )}
                        <div class="space-y-4">
                            {sortedSeasons.map((season) => {
                                const seasonEpisodes = allSeasonEpisodes[season.season_number] || [];
                                const stats = getSeasonStats(seasonEpisodes);
                                const seasonWatched = seasonEpisodes.filter((ep) => watchedSet.has(`${season.season_number}-${ep.episode_number}`)).length;
                                const seasonTotal = seasonEpisodes.length;
                                const isSeasonComplete = seasonTotal > 0 && seasonWatched === seasonTotal;
                                return (
                                    <details id={`season-${season.season_number}`} class="sr scroll-mt-20">
                                        {/* 4.6 · Una fila por temporada: póster · nombre · tira de episodios · vistos · nota */}
                                        <summary class="sr-row">
                                            <img class="sr-poster" src={posterUrl(season.poster_path || item?.poster_path, 'w92')} alt="" loading="lazy" />
                                            <span class="sr-t">
                                                <b>{season.season_number === 0 ? 'Especiales' : `Temporada ${season.season_number}`}</b>
                                                <small>{seasonTotal} ep.{season.air_date ? ` · ${season.air_date.slice(0, 4)}` : ''}</small>
                                            </span>
                                            {seasonTotal > 0 && (
                                                <span class="sr-strip" role="img" aria-label={`${season.season_number === 0 ? 'Especiales' : `T${season.season_number}`}: ${seasonTotal} episodios, ${seasonWatched} vistos`}>
                                                    {seasonEpisodes.slice(0, STRIP_MAX).map((ep) => {
                                                        const seen = watchedSet.has(`${season.season_number}-${ep.episode_number}`);
                                                        // Sin spoilers: la nota de un episodio no visto no se enseña (ni por color), como en el mapa.
                                                        const band = spoilerFree && !seen ? 'none' : epBand(ep);
                                                        const tip = `T${season.season_number}·E${ep.episode_number}` + (band !== 'none' ? ` · ★ ${ep.vote_average.toFixed(1)}` : '') + (seen ? ' · visto' : '');
                                                        return <i class:list={['sr-c', { 'is-seen': seen }]} data-b={band} data-ep-cell={`${season.season_number}-${ep.episode_number}`} title={tip}></i>;
                                                    })}
                                                    {seasonTotal > STRIP_MAX && <span class="sr-more" title={`${seasonTotal - STRIP_MAX} episodios más: ábrela para verlos todos`}>+{seasonTotal - STRIP_MAX}</span>}
                                                </span>
                                            )}
                                            {seasonTotal > 0 && <span class="sr-n" data-season-count={season.season_number}>{seasonWatched}/{seasonTotal}</span>}
                                            <span class="sr-r">{stats.averageRating !== '0.0' ? `★ ${stats.averageRating.replace('.', ',')}` : ''}</span>
                                            <svg class="sr-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                                        </summary>
                                        <div class="sr-body space-y-2">
                                            {/* Lo que antes iba en la cabecera grande de la temporada (4.6: nada se pierde) */}
                                            <div class="sr-meta">
                                                <span><b>{stats.totalEpisodes}</b> episodios</span>
                                                {stats.averageRating !== '0.0' && <span>Nota <b>{stats.averageRating}</b></span>}
                                                {stats.averageRuntime !== 'No disponible' && <span><b>{stats.averageRuntime}</b> por episodio</span>}
                                                {stats.totalWatchtime && <span>Total <b>{stats.totalWatchtime}</b></span>}
                                                {stats.bestEpisode && <span>Mejor: <b>E{stats.bestEpisode.episode_number}</b> ({stats.bestEpisode.vote_average.toFixed(1)})</span>}
                                                {stats.dateRange && <span>{stats.dateRange}</span>}
                                            </div>
                                            {seasonTotal > 0 && (
                                                <div class="sr-prog" data-season-progress={season.season_number} data-season-total={seasonTotal}>
                                                    <span class="sr-prog-bar"><i data-season-bar={season.season_number} style={`width: ${Math.round(seasonWatched / seasonTotal * 100)}%`}></i></span>
                                                </div>
                                            )}
                                            <p class="sr-ov season-overview">{season.overview || (season.season_number === 0 ? "Episodios especiales y contenido adicional." : "No hay descripción disponible.")}</p>
                                            {/* Botón marcar/desmarcar temporada */}
                                            {seasonTotal > 0 && (
                                                <form method="POST" class="mb-3">
                                                    <input type="hidden" name="actionType" value="watched_season" />
                                                    <input type="hidden" name="season" value={season.season_number} />
                                                    <input type="hidden" name="episodes" value={seasonEpisodes.map((ep) => ep.episode_number).join(',')} />
                                                    <input type="hidden" name="action" value={isSeasonComplete ? 'unmark' : 'mark'} />
                                                    <button type="submit" class={`w-full py-2 text-xs font-medium rounded-lg transition-colors ${isSeasonComplete ? 'bg-green-50 text-green-700 border border-green-200 hover:bg-green-100' : 'bg-gray-50 text-gray-600 border border-gray-200 hover:bg-gray-100'}`}>
                                                        {isSeasonComplete ? 'Desmarcar temporada completa' : `Marcar toda la temporada como vista (${seasonTotal} episodios)`}
                                                    </button>
                                                </form>
                                            )}
                                            {seasonEpisodes.map((episode) => {
                                                const isWatched = watchedSet.has(`${season.season_number}-${episode.episode_number}`);
                                                const mark = episodeMark(episode);
                                                const credits = episodeCredits(episode);
                                                return (
                                                <div>
                                                    <details class={`border-b pb-2 last:border-0 group ${season.season_number === 0 ? 'border-purple-100' : 'border-gray-100'}`}>
                                                        <summary class={`cursor-pointer py-2 px-2 sm:px-3 rounded-lg flex items-center gap-2 sm:gap-3 ${season.season_number === 0 ? 'hover:bg-purple-50' : 'hover:bg-blue-50'} ${isWatched ? 'opacity-60' : ''}`}>
                                                            <span class={`font-bold px-1.5 py-0.5 rounded text-xs flex-shrink-0 ${season.season_number === 0 ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800'}`}>
                                                                {season.season_number === 0 ? `E${episode.episode_number}` : episode.episode_number}
                                                            </span>
                                                            {mark && (
                                                                <span class="text-[10px] font-bold tracking-wide px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 flex-shrink-0" title={mark.title}>{mark.label}</span>
                                                            )}
                                                            <div class="flex-1 min-w-0">
                                                                {/* TMDB D4: el título lleva a la ficha del episodio; «Visto» sigue marcando sin salir. */}
                                                                <p class="font-medium text-gray-800 text-sm truncate group-open:whitespace-normal group-open:overflow-visible"><a href={episodeHref(id, season.season_number, episode.episode_number)} class="ep-link hover:underline underline-offset-2">{episode.name}</a></p>
                                                                <p class="text-xs text-gray-500 mt-0.5 truncate">
                                                                    {formatDate(episode.air_date)}{episode.runtime ? `  ·  ${formatRuntime(episode.runtime)}` : ''}
                                                                    {episode.vote_average > 0 && <span class="text-yellow-600">  ·  {episode.vote_average.toFixed(1)}</span>}
                                                                </p>
                                                            </div>
                                                            {/* TMDB D4: a la ficha del episodio, al lado de «Visto» y con su misma forma. */}
                                                            <a href={episodeHref(id, season.season_number, episode.episode_number)} class={`flex-shrink-0 flex items-center gap-1 px-2 py-1 text-[11px] font-medium rounded-md border transition-colors whitespace-nowrap ${season.season_number === 0 ? 'border-purple-200 bg-purple-50 text-purple-700 hover:bg-purple-100' : 'border-blue-200 bg-blue-50 text-blue-700 hover:bg-blue-100'}`} aria-label={`Abrir la ficha de «${episode.name}»`} onclick="event.stopPropagation()">
                                                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="2.18"/><path d="M7 2v20M17 2v20M2 12h20M2 7h5M2 17h5M17 17h5M17 7h5"/></svg>
                                                                <span class="hidden sm:inline">Ficha</span>
                                                            </a>
                                                            <form method="POST" data-season={season.season_number} class="flex-shrink-0" onclick="event.stopPropagation()">
                                                                <input type="hidden" name="actionType" value="watched_episode" />
                                                                <input type="hidden" name="season" value={season.season_number} />
                                                                <input type="hidden" name="episode" value={episode.episode_number} />
                                                                <button type="submit" class={`flex items-center gap-1 px-2 py-1 text-[11px] font-medium rounded-md transition-all duration-200 whitespace-nowrap ${isWatched ? 'bg-green-500 text-white hover:bg-green-600' : 'border border-gray-300 text-gray-400 hover:border-green-400 hover:text-green-600'}`}>
                                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                                                    </svg>
                                                                    <span class="hidden sm:inline">{isWatched ? 'Visto' : 'Visto'}</span>
                                                                </button>
                                                            </form>
                                                        </summary>
                                                        <div class={`mt-2 mx-3 p-4 rounded-lg ${season.season_number === 0 ? 'bg-purple-50' : 'bg-blue-50'} ${(hideStills || hideSynopsis) && !isWatched ? 'yf-spoil' : ''}`}>
                                                            {(hideStills || hideSynopsis) && !isWatched && (
                                                                <button type="button" class="yf-spoil-btn" aria-label="Mostrar contenido con posibles spoilers">
                                                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                                                    Mostrar (spoilers)
                                                                </button>
                                                            )}
                                                            {/* Dirección y guion (B2a): no es spoiler, va sin difuminar */}
                                                            {(credits.directors.length > 0 || credits.writers.length > 0) && (
                                                                <p class="text-xs text-gray-600 mb-3">
                                                                    {credits.directors.length > 0 && (
                                                                        <span><span class="font-semibold">Dirección:</span> {credits.directors.map((n, i) => (<>{i > 0 && ', '}<a href={`/team/${encodeURIComponent(n)}`} class="hover:text-blue-600 hover:underline">{n}</a></>))}</span>
                                                                    )}
                                                                    {credits.directors.length > 0 && credits.writers.length > 0 && <span class="text-gray-400">  ·  </span>}
                                                                    {credits.writers.length > 0 && (
                                                                        <span><span class="font-semibold">Guion:</span> {credits.writers.map((n, i) => (<>{i > 0 && ', '}<a href={`/team/${encodeURIComponent(n)}`} class="hover:text-blue-600 hover:underline">{n}</a></>))}</span>
                                                                    )}
                                                                </p>
                                                            )}
                                                            {/* Imagen */}
                                                            {episode.still_path && (
                                                                <div class={`flex justify-center mb-3 ${hideStills && !isWatched ? 'yf-blur' : ''}`}>
                                                                    <img src={posterUrl(episode.still_path, 'w500')} alt={episode.name} loading="lazy" class="rounded-lg shadow-md w-full max-w-md" />
                                                                </div>
                                                            )}

                                                            {/* Sinopsis */}
                                                            <p class={`text-sm text-gray-700 leading-relaxed mb-3 ${hideSynopsis && !isWatched ? 'yf-blur' : ''}`}>{episode.overview || "No hay descripción disponible."}</p>

                                                            {/* Estrellas invitadas — van con la sinopsis: un nombre en el reparto
                                                                de un episodio cuenta tanto como el texto (o más). */}
                                                            {episode.guest_stars && episode.guest_stars.length > 0 && (
                                                                <div class={hideSynopsis && !isWatched ? 'yf-blur' : ''}>
                                                                    <p class={`text-sm font-semibold mb-2 ${season.season_number === 0 ? 'text-purple-700' : 'text-blue-700'}`}>Estrellas invitadas:</p>
                                                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                                                        {episode.guest_stars.map((star: GuestStar) => (
                                                                            <a href={`/actor/${star.id}`} class="flex items-center gap-3 text-sm">
                                                                                {star.profile_path && <img src={posterUrl(star.profile_path, 'w185')} alt={star.name} class="w-11 h-11 rounded-full object-cover flex-shrink-0" loading="lazy" />}
                                                                                <div>
                                                                                    <span class="text-gray-800 font-medium hover:text-blue-600">{star.name}</span>
                                                                                    <span class="block text-xs text-gray-500">{star.character}</span>
                                                                                </div>
                                                                            </a>
                                                                        ))}
                                                                    </div>
                                                                </div>
                                                            )}
                                                            <a href={episodeHref(id, season.season_number, episode.episode_number)} class={`mt-4 flex w-full items-center justify-center gap-1.5 py-2.5 text-xs font-semibold rounded-lg border transition-colors ${season.season_number === 0 ? 'border-purple-200 bg-white text-purple-700 hover:bg-purple-100' : 'border-blue-200 bg-white text-blue-700 hover:bg-blue-100'}`}>
                                                                Abrir la ficha del episodio
                                                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                                            </a>
                                                        </div>
                                                    </details>
                                                </div>
                                                );
                                            })}
                                            {(!seasonEpisodes || seasonEpisodes.length === 0) && (
                                                <p class="text-gray-500 italic text-center p-4 text-sm">No hay información de episodios disponible.</p>
                                            )}
                                        </div>
                                    </details>
                                );
                            })}
                        </div>
                    </div>

                    <!-- Mapa de calidad por episodio, plegado al final (4.6; datos ya cargados, cero fetches) -->
                    <SeasonHeatmap seasons={regularSeasons} episodesBySeason={allSeasonEpisodes} spoilerFree={spoilerFree} watchedSet={watchedSet} />

                    </div>

                    <!-- Orden de la columna (rediseño 4.5), el mismo que la barra de secciones: temporadas, vídeos,
                         reparto y equipo, imágenes, productoras, reseñas y, al final, «También en cine» y parecidas. -->

                    <!-- Tráiler + más vídeos -->
                    <div id="sec-videos" data-fs><VideoSection trailerUrl={trailerUrl} clips={clips} behindScenes={behindScenes} teasers={teasers} /></div>

                    <!-- Reparto (12 + el resto plegado), equipo y dobladores en español (lazy, eldoblaje.com, por temporada) -->
                    <div id="sec-reparto" data-fs class="space-y-8">
                        <CastGrid cast={cast} seenWith={seenWithMap} />
                        <CrewGrid crew={directors} />
                        <DubbingSection type="tv" tmdbId={id} />
                    </div>

                    <!-- Pósters y fondos -->
                    <div id="sec-imagenes" data-fs class="space-y-8">
                        <LightboxGallery posters={posters} prefix="poster" />
                        <LightboxGallery posters={bundle?.backdrops ?? []} prefix="backdrop" title="Fondos" variant="backdrop" />
                    </div>

                    <!-- Productoras -->
                    <ProductionCompanies companies={item?.production_companies || []} />

                    <!-- Reviews TMDB -->
                    <div id="sec-resenas" data-fs><ReviewsSection reviews={reviews} /></div>

                    <!-- La saga al otro lado: películas de esta misma serie, encima de las parecidas -->
                    <CrossMediaSection items={crossMediaMovies} mediaType="movie" />

                    <!-- Recomendaciones -->
                    <div id="sec-parecidas" data-fs><RecommendationsCarousel
                        items={seriesRecommendations}
                        mediaType="tv"
                        title={seriesRecommendationType === 'recommendations' ? 'Recomendaciones' : 'Series similares'}
                    /></div>
                </div>
            </div>
        </div>

    </article>
</Layout>

<script>
    // Modo sin spoilers (§2): «Mostrar» revela el episodio difuminado. El blur es SELECTIVO (A3b):
    // solo lo marcado con `.yf-blur`. CSS y script compartidos con la ficha de episodio (TMDB D4):
    // `styles/shared/spoil.css` y `scripts/shared/spoil.ts`.
    import '../../scripts/shared/spoil';
</script>
<script is:inline>
    // Confirmación al cambiar el modo sin spoilers de esta serie (flag `sp` en la URL tras el POST).
    (function () {
        try {
            var params = new URLSearchParams(location.search);
            var sp = params.get('sp');
            if (!sp) return;
            params.delete('sp');
            var qs = params.toString();
            history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
            var msg = sp === 'on' ? 'Modo sin spoilers activado en esta serie'
                    : sp === 'off' ? 'Spoilers visibles de nuevo en esta serie'
                    : sp === 'inherit' ? 'Esta serie vuelve a seguir tu ajuste general' : '';
            if (!msg) return;
            var c = document.getElementById('toast-container');
            if (!c) return;
            var t = document.createElement('div');
            t.className = 'toast toast-success';
            t.textContent = msg;
            c.appendChild(t);
            setTimeout(function () { t.style.animation = 'toastOut 0.3s ease forwards'; setTimeout(function () { t.remove(); }, 300); }, 2500);
        } catch (e) {}
    })();
</script>

<script is:inline src="/js/optimistic-actions.js"></script>
