---
interface CrewMember {
    name: string;
    job: string;
}

interface Props {
    crew: CrewMember[];
    title?: string;
}

const { crew, title = "Equipo" } = Astro.props;
// Rediseño 4.5: 9 a la vista (tres filas); el resto se muestra con «Ver todo el equipo».
const SHOWN = crew.length <= 12 ? crew.length : 9; // plegar 1–3 no compensa
---
{crew.length > 0 && (
    <section>
        <div class="fsec-h"><h2>{title}</h2><span class="n">{crew.length}</span></div>
        <div class="fcrew">
            {crew.map((member, i) => (
                <a href={`/team/${encodeURIComponent(member.name)}`} class:list={[{ 'cg-x': i >= SHOWN }]}>
                    <b>{member.name}</b>
                    <span>{member.job}</span>
                </a>
            ))}
        </div>
        {crew.length - SHOWN > 0 && (
            <details class="cg-more group mt-3">
                <summary class="cg-more-btn">
                    <span class="group-open:hidden">Ver todo el equipo · {crew.length}</span>
                    <span class="hidden group-open:inline">Ver menos</span>
                    <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
            </details>
        )}
    </section>
)}
