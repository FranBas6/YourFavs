---
/**
 * Vídeo de YouTube que no carga nada de YouTube hasta que lo pides (QA 4.4, H60/H65). Antes el tráiler
 * de la ficha se incrustaba desde www.youtube.com al abrirla: ponía sus cookies y llamaba a los
 * identificadores publicitarios de Google (googleads.g.doubleclick.net) sin consentimiento. Ahora se ve
 * la miniatura (i.ytimg.com, sin cookies) con un ▶, y al pulsar se crea el reproductor de
 * youtube-nocookie.com ya en marcha. Así no hace falta banner de cookies y la ficha pesa menos.
 * Ocupa todo su contenedor (el que le da la proporción 16:9).
 */
interface Props {
    id: string;
    title: string;
}
const { id, title } = Astro.props;
---
<button type="button" class="ytf" data-ytf={id} data-ytf-title={title} aria-label={`Reproducir el vídeo: ${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />
    <span class="ytf-play" aria-hidden="true">
        <svg viewBox="0 0 68 48"><path d="M66.5 7.7A8.5 8.5 0 0 0 60.5 1.6C55.2.2 34 .2 34 .2S12.8.2 7.5 1.6A8.5 8.5 0 0 0 1.5 7.7C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6.1c5.3 1.4 26.5 1.4 26.5 1.4s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6.1C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3Z"/><path d="m27 34 18-10-18-10z" fill="#fff"/></svg>
    </span>
</button>

<style is:global>
    .ytf { position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; cursor: pointer; background: #000; overflow: hidden; }
    .ytf img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .92; transition: opacity .2s; }
    .ytf:hover img, .ytf:focus-visible img { opacity: 1; }
    .ytf-play { position: absolute; left: 50%; top: 50%; width: 68px; height: 48px; transform: translate(-50%, -50%); }
    .ytf-play svg { width: 100%; height: 100%; }
    .ytf-play svg path:first-child { fill: #212121; fill-opacity: .8; transition: fill .2s, fill-opacity .2s; }
    .ytf:hover .ytf-play svg path:first-child, .ytf:focus-visible .ytf-play svg path:first-child { fill: #f00; fill-opacity: 1; }
    .ytf:focus-visible { outline: 3px solid var(--primary); outline-offset: -3px; }
    .ytf-frame { display: block; width: 100%; height: 100%; border: 0; }
</style>

<script is:inline>
    (function () {
        if (window.__yfYtf) return; window.__yfYtf = true;
        document.addEventListener('click', function (e) {
            var btn = e.target.closest && e.target.closest('[data-ytf]');
            if (!btn) return;
            var f = document.createElement('iframe');
            f.className = 'ytf-frame';
            f.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(btn.getAttribute('data-ytf')) + '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
            f.title = btn.getAttribute('data-ytf-title') || 'Vídeo';
            f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen';
            f.allowFullscreen = true;
            btn.replaceWith(f);
            f.focus();
        });
    })();
</script>
