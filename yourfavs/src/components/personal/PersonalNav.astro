---
/**
 * Píldoras de las secciones personales (Mis listas). La activa toma el color de su stamp
 * (`--stamp-*` / `-ink`, handoff social §13): antes eran fondos de Tailwind fijos con texto blanco,
 * sin versión oscura propia. Las demás siguen como estaban.
 */
import { Icon } from 'astro-icon/components';
import { SOCIAL_PHASE } from '../../utils/constants/social';

interface Props {
    currentPage: string;
}

const { currentPage } = Astro.props;
// Mensajes (M1): contador neutro junto al rojo de «Amigos»; lo rellena bell.ts por `.js-msg-badge`.
const msgOn = SOCIAL_PHASE.messages;

const links = [
    { href: '/mislistas/favoritos', label: 'Favoritos', icon: 'M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z', stamp: 'amber', hoverColor: 'hover:text-yellow-600 hover:border-yellow-300' },
    { href: '/mislistas/pendientes', label: 'Pendientes', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z', stamp: 'blue', hoverColor: 'hover:text-blue-600 hover:border-blue-300' },
    { href: '/mislistas/siguiendo', label: 'Siguiendo', icon: 'M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z', stamp: 'purple', hoverColor: 'hover:text-purple-600 hover:border-purple-300' },
    { href: '/mislistas/megusta', label: 'Me gusta', icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z', stamp: 'pink', hoverColor: 'hover:text-pink-600 hover:border-pink-300' },
    { href: '/mislistas/vistos', label: 'Vistos', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z', stamp: 'green', hoverColor: 'hover:text-green-600 hover:border-green-300' },
    { href: '/mislistas/verpronto', label: 'Pronto', icon: 'M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664zM21 12a9 9 0 11-18 0 9 9 0 0118 0z', stamp: 'blue', hoverColor: 'hover:text-indigo-600 hover:border-indigo-300' },
    { href: '/mislistas/recomendaciones', label: 'Para ti', icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z', stamp: 'amber', hoverColor: 'hover:text-orange-600 hover:border-orange-300' },
    { href: '/mislistas/colecciones', label: 'Colecciones', icon: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5', stamp: 'purple', hoverColor: 'hover:text-purple-600 hover:border-purple-300' },
    { href: '/mislistas/actividad', label: 'Actividad', icon: 'M13 10V3L4 14h7v7l9-11h-7z', stamp: 'green', hoverColor: 'hover:text-emerald-600 hover:border-emerald-300' },
    // Capa social (F2). El globo cuenta solicitudes de amistad sin responder (F3); lo rellena
    // scripts/notifications/bell.ts por `.js-pending-badge`.
    { href: '/mislistas/amigos', label: 'Amigos', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z', stamp: 'pink', hoverColor: 'hover:text-pink-600 hover:border-pink-300', pendingBadge: true },
    { href: '/mislistas/actores', label: 'Actores', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z', stamp: 'red', hoverColor: 'hover:text-red-600 hover:border-red-300' },
    { href: '/mislistas/year', label: 'Tu año', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z', stamp: 'amber', hoverColor: 'hover:text-amber-600 hover:border-amber-300' },
    // "En números" vivía en Ajustes como tarjeta-enlace, pero es CONTENIDO, no configuración:
    // su sitio es aquí, junto al resto de tus listas (Ajustes · A7).
    { href: '/mislistas/year/siempre', label: 'En números', icon: 'M3 3v18h18M19 9l-5 5-4-4-3 3', stamp: 'blue', hoverColor: 'hover:text-cyan-600 hover:border-cyan-300' },
];

const activeLink = links.find(l => l.href === currentPage);
const activeLabel = activeLink?.label || 'Sección';
---
<!-- Mobile: desplegable flotante -->
<details class="sm:hidden group relative">
    <summary class="flex items-center justify-between px-4 py-2 bg-white rounded-xl border border-gray-200 shadow-sm cursor-pointer text-sm font-medium text-gray-700">
        <span class="flex items-center gap-2">
            {activeLink && (
                <span class="w-2 h-2 rounded-full" style={`background: var(--stamp-${activeLink.stamp}-ink)`}></span>
            )}
            {activeLabel}
        </span>
        <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
    </summary>
    <div class="absolute left-0 top-full mt-2 z-50 w-full flex flex-wrap gap-2 p-3 bg-white rounded-xl border border-gray-200 shadow-lg">
        {links.map((link) => {
            const isActive = currentPage === link.href;
            return (
                <a href={link.href}
                   class={`flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium transition-all border
                       ${isActive
                           ? `pnav-on border-transparent`
                           : `bg-gray-50 text-gray-500 border-gray-200 ${link.hoverColor}`}`}
                   style={isActive ? `--pn-b: var(--stamp-${link.stamp}); --pn-i: var(--stamp-${link.stamp}-ink)` : undefined}
                   aria-current={isActive ? 'page' : undefined}>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d={link.icon}/>
                    </svg>
                    {link.label}
                    {link.pendingBadge && <span class="pnav-badge js-pending-badge" hidden></span>}
                    {link.pendingBadge && msgOn && <span class="mcnt js-msg-badge" hidden><Icon name="lucide:message-circle" /><span class="js-msg-n"></span></span>}
                </a>
            );
        })}
    </div>
</details>

<!-- Desktop: pills horizontales -->
<nav class="hidden sm:block mb-6" aria-label="Secciones personales">
    <div class="flex flex-wrap gap-2">
        {links.map((link) => {
            const isActive = currentPage === link.href;
            return (
                <a href={link.href}
                   class={`flex items-center gap-1.5 px-3.5 py-2 rounded-full text-sm font-medium whitespace-nowrap transition-all duration-200 border
                       ${isActive
                           ? `pnav-on border-transparent`
                           : `bg-white text-gray-500 border-gray-200 ${link.hoverColor} hover:shadow-sm`}`}
                   style={isActive ? `--pn-b: var(--stamp-${link.stamp}); --pn-i: var(--stamp-${link.stamp}-ink)` : undefined}
                   aria-current={isActive ? 'page' : undefined}>
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d={link.icon}/>
                    </svg>
                    {link.label}
                    {link.pendingBadge && <span class="pnav-badge js-pending-badge" hidden></span>}
                    {link.pendingBadge && msgOn && <span class="mcnt js-msg-badge" hidden><Icon name="lucide:message-circle" /><span class="js-msg-n"></span></span>}
                </a>
            );
        })}
    </div>
</nav>

<style>
    .pnav-on { background: var(--pn-b); color: var(--pn-i); font-weight: 600; }
    .pnav-badge {
        min-width: 17px; height: 17px; padding: 0 4px; border-radius: 9999px;
        background: var(--accent-dark); color: #fff;
        font: 700 10px/17px var(--font-mono, monospace); text-align: center;
    }
    .pnav-badge[hidden] { display: none; }
    .mcnt { height: 17px; font-size: 10px; padding: 0 5px; }
</style>
