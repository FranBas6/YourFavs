---
/**
 * Tab bar inferior móvil (<1024px) — Tab bar de 5 (rediseño).
 *
 * 5 destinos: Inicio · Buscar · Explorar · Mis listas · Perfil
 *   - Inicio  → navega a "/"
 *   - Buscar  → command palette (⌘K) vía evento `yf:open-palette`
 *   - Explorar→ abre la hoja del catálogo (`yf:sheet-open` id="explorar"); público
 *   - Mis listas → con sesión abre hoja id="listas" (badge Radar); sin sesión → login
 *   - Perfil  → con sesión abre hoja id="perfil"; sin sesión → login (`data-auth-open`)
 *
 * Las hojas las pinta <MobileNavSheets/>. Re-tocar un tab de hoja la cierra (toggle).
 * Singleton montado en Layout (oculto en flujos a pantalla completa: /gustos, login).
 */
import { Icon } from 'astro-icon/components';

const user = Astro.locals.user;
const path = Astro.url.pathname;
const isActive = (href: string): boolean => href === '/' ? path === '/' : path.startsWith(href);
const catalogActive = isActive('/catalogo');
const listsActive = isActive('/mislistas');
const perfilActive = isActive('/perfil');
---
<nav class="tabbar" aria-label="Navegación inferior">
    <a href="/" class={`tabbar-item ${isActive('/') ? 'is-active' : ''}`} aria-current={isActive('/') ? 'page' : undefined}>
        <Icon name="lucide:home" class="tabbar-icon" />
        <span>Inicio</span>
    </a>

    <button type="button" class="tabbar-item" id="tabbar-search" aria-label="Buscar">
        <Icon name="lucide:search" class="tabbar-icon" />
        <span>Buscar</span>
    </button>

    <button type="button" class={`tabbar-item ${catalogActive ? 'is-active' : ''}`} data-sheet-open="explorar" aria-label="Explorar">
        <Icon name="lucide:compass" class="tabbar-icon" />
        <span>Explorar</span>
    </button>

    {user ? (
        <button type="button" class={`tabbar-item ${listsActive ? 'is-active' : ''}`} data-sheet-open="listas" aria-label="Mis listas">
            <span class="tabbar-iconwrap">
                <Icon name="lucide:bookmark" class="tabbar-icon" />
            </span>
            <span>Mis listas</span>
        </button>
    ) : (
        <button type="button" class="tabbar-item" data-auth-open aria-label="Mis listas">
            <Icon name="lucide:bookmark" class="tabbar-icon" />
            <span>Mis listas</span>
        </button>
    )}

    {user ? (
        <button type="button" class={`tabbar-item ${perfilActive ? 'is-active' : ''}`} data-sheet-open="perfil" aria-label="Perfil">
            <Icon name="lucide:user" class="tabbar-icon" />
            <span>Perfil</span>
        </button>
    ) : (
        <button type="button" class="tabbar-item" data-auth-open aria-label="Entrar">
            <Icon name="lucide:user" class="tabbar-icon" />
            <span>Perfil</span>
        </button>
    )}
</nav>

<script is:inline>
    (function () {
        var s = document.getElementById('tabbar-search');
        if (s) s.addEventListener('click', function () {
            document.dispatchEvent(new CustomEvent('yf:open-palette'));
        });
        // Tabs que abren hoja (toggle lo gestiona el controlador del BottomSheet).
        document.querySelectorAll('.tabbar [data-sheet-open]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.dispatchEvent(new CustomEvent('yf:sheet-open', { detail: { id: btn.getAttribute('data-sheet-open') } }));
            });
        });
    })();
</script>

<style is:global>
    .tabbar { display: none; }

    @media (max-width: 1023px) {
        .tabbar {
            display: flex;
            position: fixed;
            left: 0; right: 0; bottom: 0;
            z-index: 1000; /* sobre el contenido; bajo overlays (panel 9999, popover 1300, toast 10000) */
            background: var(--bg-elev, #fff);
            border-top: 1px solid var(--border, #e5e7eb);
            box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.06);
            /* Respeta el notch/gesture bar de iOS */
            padding-bottom: env(safe-area-inset-bottom, 0px);
        }
        .tabbar-item {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 3px;
            padding: 8px 4px 7px;
            background: none;
            border: none;
            cursor: pointer;
            text-decoration: none;
            font: inherit;
            font-size: 10px;
            font-weight: 500;
            color: var(--text-3, #9ca3af);
            -webkit-tap-highlight-color: transparent;
        }
        .tabbar-icon { width: 22px; height: 22px; }
        .tabbar-iconwrap { position: relative; display: inline-flex; }
        .tabbar-badge {
            position: absolute;
            top: -5px;
            right: -9px;
            min-width: 15px;
            height: 15px;
            padding: 0 4px;
            border-radius: 9999px;
            background: var(--accent, #E63946);
            color: #fff;
            font-size: 9px;
            font-weight: 700;
            line-height: 15px;
            text-align: center;
        }
        .tabbar-badge[hidden] { display: none; }
        .tabbar-item.is-active { color: var(--accent, #E63946); }
        .tabbar-item.is-active span { font-weight: 700; }

        /* Hueco para que la barra no tape el contenido ni el footer. */
        body { padding-bottom: calc(58px + env(safe-area-inset-bottom, 0px)); }

        /* Elevar los flotantes inferiores por encima de la barra. */
        .toast-container { bottom: calc(70px + env(safe-area-inset-bottom, 0px)); }
        #yf-taste-hint { bottom: calc(72px + env(safe-area-inset-bottom, 0px)) !important; }
    }
</style>
