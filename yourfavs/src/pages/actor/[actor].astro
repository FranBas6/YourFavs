    }

    .social-link.facebook {
        background: linear-gradient(135deg, #1877F2 0%, #0d5bb8 100%);
        color: white;
    }

    .social-link.tiktok {
        background: linear-gradient(135deg, #000000 0%, #333333 100%);
        color: white;
    }

    .social-link.youtube {
        background: linear-gradient(135deg, #FF0000 0%, #CC0000 100%);
        color: white;
    }

    /* Gallery Section Styles */
    .gallery-section {
        margin-bottom: 3rem;
    }

    .gallery-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    /* Gallery header card */
    .gallery-card {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(15px);
        border-radius: var(--border-radius);
        padding: 2rem; /* match other cards */
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.3), 0 10px 20px -5px rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
        margin-bottom: 1.5rem;
        color: #1a202c; /* match other cards */
    }

    .section-title-main {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--coral-red);
        margin: 0;
    }

    .section-title-main .icon {
        width: 1.75rem;
        height: 1.75rem;
    }

    .toggle-gallery-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--coral-red);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.875rem;
        cursor: pointer;
        transition: var(--transition-smooth);
    }

    .toggle-gallery-btn:hover {
        background: var(--coral-red-dark);
        transform: translateY(-2px);
        box-shadow: var(--shadow-medium);
    }

    .arrow-icon {
        width: 1rem;
        height: 1rem;
        transition: transform 0.3s ease;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1rem;
    }

    .gallery-item {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: var(--shadow-light);
        transition: var(--transition-smooth);
        text-decoration: none;
    }

    .gallery-item:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-large);
    }

    .gallery-item img {
        width: 100%;
        height: 250px;
        object-fit: cover;
        display: block;
    }

    .gallery-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: var(--transition-smooth);
    }

    .gallery-item:hover .gallery-overlay {
        opacity: 1;
    }

    .gallery-overlay .icon {
        width: 2rem;
        height: 2rem;
        color: white;
    }

    /* Sort Controls Styles */
    .sort-controls {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(15px);
        border-radius: var(--border-radius);
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.3), 0 10px 20px -5px rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .filmography-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--coral-red);
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .sort-buttons {
        display: flex;
        justify-content: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .sort-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(230, 57, 70, 0.1);
        color: var(--coral-red);
        padding: 0.75rem 1.5rem;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.875rem;
        transition: var(--transition-smooth);
        border: 2px solid transparent;
    }

    .sort-btn:hover {
        background: var(--coral-red);
        color: white;
        transform: translateY(-2px);
        box-shadow: var(--shadow-medium);
    }

    .sort-btn.active {
        background: var(--coral-red);
        color: white;
        border-color: var(--coral-red-dark);
    }

    .sort-btn .icon {
        width: 1rem;
        height: 1rem;
    }

    /* Responsive improvements for new components */
    @media (max-width: 768px) {
        .gallery-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }
        
        .gallery-grid {
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        }
        
        .sort-buttons {
            flex-direction: column;
            align-items: center;
        }
        
        .sort-btn {
            width: 100%;
            max-width: 200px;
            justify-content: center;
        }
        
        .bio-card, .personal-info-card {
            padding: 1.5rem;
        }
        
        .section-title {
            font-size: 1.25rem;
        }
        
        .section-title-main {
            font-size: 1.5rem;
        }
    }
    
    @media (max-width: 480px) {
        .gallery-grid {
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 0.5rem;
        }
        
        .gallery-item img {
            height: 180px;
        }
        
        .bio-card, .personal-info-card {
            padding: 1rem;
        }
        
        .info-item {
            padding: 0.75rem;
        }
        
        .social-links {
            justify-content: center;
        }
    }

    /* Scroll suave */
    html {
        scroll-behavior: smooth;
    }

    /* Estilos generales */
    body {
        background-color: #F3F4F6;
        transition: background 0.3s ease;
    }

    .text-coral-red {
        color: var(--coral-red);
    }

    .bg-coral-red {
        background-color: var(--coral-red);
    }

    /* Background con gradiente mejorado */
    .actor-profile-bg {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 500px;
        background: linear-gradient(180deg,
        rgba(230, 57, 70, 0.12) 0%,
        rgba(230, 57, 70, 0.06) 40%,
        rgba(230, 57, 70, 0) 100%);
        z-index: -1;
    }

    /* Perfil del actor mejorado */
    .actor-profile {
        animation: fadeInUp 0.8s ease-out;
        padding: 2.5rem;
        border-radius: var(--border-radius);
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        box-shadow: var(--shadow-large);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    /* Navegación rápida */
    .quick-nav {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .nav-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.25rem;
        background: var(--coral-red-alpha);
        color: var(--coral-red);
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        transition: var(--transition-smooth);
        border: 2px solid transparent;
    }

    .nav-pill:hover {
        background: var(--coral-red);
        color: white;
        transform: translateY(-2px);
        box-shadow: var(--shadow-medium);
    }

    .nav-pill:focus {
        outline: none;
        ring: 2px solid var(--coral-red);
        ring-offset: 2px;
    }

    /* Contenedor de imagen mejorado */
    .profile-image-container {
        position: relative;
        width: 220px;
        height: 330px;
        border-radius: var(--border-radius);
        overflow: hidden;
        box-shadow: var(--shadow-large);
        transition: var(--transition-smooth);
    }

    .profile-image-container:hover {
        transform: scale(1.02);
        box-shadow: 0 25px 35px -5px rgba(0, 0, 0, 0.2);
    }

    .profile-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: var(--transition-smooth);
    }

    .profile-image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f1f3f4 0%, #e8eaed 100%);
        color: #9aa0a6;
    }

    /* Badge de popularidad mejorado */
    .popularity-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #FCD34D 0%, #F59E0B 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--shadow-medium);
        z-index: 2;
        animation: pulse 2s infinite;
    }

    @keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.05);
        }
    }

    .popularity-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #7C2D12;
        font-weight: 700;
    }

    .popularity-value {
        font-size: 1.1rem;
        line-height: 1;
        margin-bottom: 2px;
    }

    /* Estadísticas mejoradas */
    .stat-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1rem 1.5rem;
        background: linear-gradient(135deg, rgba(230, 57, 70, 0.05) 0%, rgba(230, 57, 70, 0.02) 100%);
        border-radius: var(--border-radius);
        min-width: 120px;
        transition: var(--transition-smooth);
        box-shadow: var(--shadow-light);
        border: 1px solid rgba(230, 57, 70, 0.1);
    }

    .stat-box:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-medium);
        background: linear-gradient(135deg, rgba(230, 57, 70, 0.08) 0%, rgba(230, 57, 70, 0.04) 100%);
    }

    .stat-value {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--coral-red);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.875rem;
        color: #6c757d;
        margin-top: 0.5rem;
        font-weight: 500;
    }

    /* Biografía mejorada */
    .section-subtitle {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--coral-red);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .section-subtitle::before {
        content: '';
        width: 4px;
        height: 24px;
        background: var(--coral-red);
        border-radius: 2px;
    }

    .bio-text {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: var(--transition-smooth);
        line-height: 1.7;
        color: #0f172a; /* Slate-900 for strong contrast */
        font-weight: 500;
    }

    .bio-toggle:checked + .bio-text {
        -webkit-line-clamp: unset;
        display: block;
    }

    .read-more-btn {
        display: inline-block;
        color: var(--coral-red);
        font-weight: 600;
        cursor: pointer;
        margin-top: 0.75rem;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        transition: var(--transition-smooth);
        border: 1px solid var(--coral-red-alpha);
        position: relative;
    }

    .read-more-btn::before {
        content: "Leer más";
    }

    .read-more-btn:hover {
        background: var(--coral-red-alpha);
        transform: translateY(-1px);
    }

    .bio-toggle:checked ~ .read-more-btn::before {
        content: "Leer menos";
    }

    /* Metadata mejorada */
    .actor-metadata {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }

    @media (min-width: 768px) {
        .actor-metadata {
            grid-template-columns: 1fr 1fr;
        }
    }

    .metadata-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1.25rem;
        background: rgba(255, 255, 255, 0.7);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-light);
        transition: var(--transition-smooth);
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .metadata-item:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-medium);
        background: rgba(255, 255, 255, 0.9);
    }

    .metadata-icon {
        flex-shrink: 0;
        width: 40px;
        height: 40px;
        background: var(--coral-red-alpha);
        color: var(--coral-red);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .metadata-label {
        display: block;
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 0.25rem;
        font-size: 0.9rem;
    }

    .metadata-value {
        color: #4a5568;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    /* Badges de género mejorados */
    .genre-badge {
        display: inline-block;
        padding: 0.375rem 0.875rem;
        background: linear-gradient(135deg, rgba(230, 57, 70, 0.1) 0%, rgba(230, 57, 70, 0.05) 100%);
        color: var(--coral-red);
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        margin: 0.25rem 0.25rem 0.25rem 0;
        transition: var(--transition-smooth);
        border: 1px solid rgba(230, 57, 70, 0.2);
    }

    .genre-badge:hover {
        background: var(--coral-red);
        color: white;
        transform: translateY(-1px);
    }

    /* Secciones de contenido mejoradas */
    .content-section {
        animation: fadeInUp 0.8s ease-out;
        scroll-margin-top: 6rem;
    }

    .section-header-container {
        display: flex;
        align-items: center;
        margin-bottom: 2rem;
        gap: 1rem;
    }

    .section-title {
        display: flex;
        align-items: center;
        color: var(--coral-red);
        font-weight: 800;
        font-size: 2rem;
        letter-spacing: -0.025em;
        white-space: nowrap;
        gap: 0.75rem;
    }

    .section-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        background: var(--coral-red-alpha);
        border-radius: 12px;
        color: var(--coral-red);
    }

    .section-count {
        font-size: 1.25rem;
        font-weight: 600;
        color: #6c757d;
        margin-left: 0.5rem;
    }

    .section-header-line {
        flex-grow: 1;
        height: 3px;
        background: linear-gradient(90deg, var(--coral-red) 0%, rgba(230, 57, 70, 0.3) 50%, rgba(230, 57, 70, 0) 100%);
        border-radius: 2px;
    }

    /* Cuadrícula de contenido */
    .content-grid {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: repeat(1, minmax(0, 1fr));
    }

    @media (min-width: 480px) {
        .content-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 640px) {
        .content-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @media (min-width: 768px) {
        .content-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @media (min-width: 1024px) {
        .content-grid {
            grid-template-columns: repeat(5, minmax(0, 1fr));
        }
    }

    /* Tarjetas mejoradas */
    .card-wrapper {
        transform: translateY(0);
        transition: var(--transition-smooth);
        height: 100%;
        position: relative;
    }

    .card-wrapper:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: var(--shadow-large);
        z-index: 10;
    }

    .card-wrapper > * {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        border-radius: var(--border-radius);
        overflow: hidden;
        box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.3), 0 8px 15px -5px rgba(0, 0, 0, 0.2);
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        transition: var(--transition-smooth);
    }

    .card-wrapper img {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .card-wrapper:hover img {
        transform: scale(1.05);
    }

    .card-wrapper h3,
    .card-wrapper h4 {
        height: auto;
        min-height: 3em;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        font-weight: 600;
        padding: 1rem 1rem 0.5rem;
        margin: 0;
        font-size: 1rem;
        line-height: 1.4;
    }

    .card-wrapper p {
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        flex-grow: 1;
        line-height: 1.5;
        padding: 0.5rem 1rem 1rem;
        margin: 0;
        font-size: 0.9rem;
        color: #2d3748;
    }

    /* Estado vacío mejorado */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: var(--border-radius);
        border: 2px dashed rgba(230, 57, 70, 0.3);
        margin: 2rem 0;
        box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.2);
    }

    .empty-state-icon {
        display: flex;
        justify-content: center;
        margin-bottom: 1.5rem;
        color: rgba(230, 57, 70, 0.4);
    }

    .empty-state-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--coral-red);
        margin-bottom: 0.75rem;
    }

    .empty-state-description {
        color: #2d3748;
        font-size: 1rem;
        line-height: 1.6;
        max-width: 400px;
        margin: 0 auto;
    }


    /* Animaciones */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Mejoras responsivas */
    @media (max-width: 768px) {
        .actor-profile {
            padding: 1.5rem;
        }

        .profile-image-container {
            width: 180px;
            height: 270px;
        }

        .section-title {
            font-size: 1.5rem;
            white-space: normal; /* Cambiar de nowrap a normal */
            flex-wrap: wrap; /* Permitir que se envuelva */
            justify-content: center; /* Centrar en móviles */
        }

        .section-header-container {
            flex-direction: column; /* Cambiar a columna en móviles */
            align-items: center;
            text-align: center;
            gap: 0.5rem;
        }

        .quick-nav {
            justify-content: center;
        }

        .nav-pill {
            font-size: 0.85rem;
            padding: 0.625rem 1rem;
        }

        .section-header-line {
            width: 100%;
            max-width: 200px; /* Limitar el ancho de la línea */
        }
    }

    @media (max-width: 640px) {
        .actor-metadata {
            grid-template-columns: 1fr;
        }

        .metadata-item.col-span-1.md {
            grid-column: 1;
        }

        .content-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem; /* Reducir de 1rem */
            padding: 0 0.5rem; /* Añadir padding lateral pequeño */
        }

        .card-wrapper {
            min-width: 0; /* Permitir que se compriman */
            width: 100%;
        }
    }


    /* Modo oscuro mejorado */
    @media (prefers-color-scheme: dark) {
        :root {
            --coral-red: #ff6b7a;
            --coral-red-light: #ff8f9c;
            --coral-red-dark: #e8495a;
            --coral-red-alpha: rgba(255, 107, 122, 0.15);
        }

        body {
            background-color: #F3F4F6;
            color: #e2e8f0;
        }

        .actor-profile-bg {
            background: linear-gradient(180deg,
            rgba(255, 107, 122, 0.08) 0%,
            rgba(255, 107, 122, 0.04) 40%,
            rgba(255, 107, 122, 0) 100%);
        }

        .actor-profile {
            background: rgba(26, 32, 44, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .profile-image-placeholder {
            background: linear-gradient(135deg, #2d3748 0%, #4a5568 100%);
            color: #a0aec0;
        }

        .stat-box {
            background: linear-gradient(135deg, rgba(255, 107, 122, 0.08) 0%, rgba(255, 107, 122, 0.04) 100%);
            border: 1px solid rgba(255, 107, 122, 0.2);
        }

        .stat-box:hover {
            background: linear-gradient(135deg, rgba(255, 107, 122, 0.15) 0%, rgba(255, 107, 122, 0.08) 100%);
        }

        .stat-label {
            color: #a0aec0;
        }

        .nav-pill {
            background: var(--coral-red-alpha);
            color: var(--coral-red);
        }

        .section-subtitle {
            color: var(--coral-red);
        }

        .bio-text {
            color: #cbd5e0;
        }

        /* Asegura contraste correcto dentro de tarjetas claras */
        .bio-card .bio-text {
            color: #0f172a;
        }

        .metadata-item {
            background: rgba(45, 55, 72, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .metadata-item:hover {
            background: rgba(45, 55, 72, 0.9);
        }

        .metadata-label {
            color: #e2e8f0;
        }

        .metadata-value {
            color: #cbd5e0;
        }

        .genre-badge {
            background: linear-gradient(135deg, rgba(255, 107, 122, 0.15) 0%, rgba(255, 107, 122, 0.08) 100%);
            border: 1px solid rgba(255, 107, 122, 0.3);
        }

        .card-wrapper > * {
            background: rgba(26, 32, 44, 0.95);
            color: #e2e8f0;
