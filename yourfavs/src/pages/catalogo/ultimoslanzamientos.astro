---
import Layout from "../../layouts/Layout.astro";
import CatalogHeader from "../../components/CatalogHeader.astro";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import {getLatestMovies} from "../../services/API/Movies/tmdbMovies";
import {getLatestSeries} from "../../services/API/Series/tmdbSeries";
import {discoverContent, parseAdvancedFilters, hasActiveFilters, sortByFor} from "../../services/API/shared/tmdbDiscoverService";
import {getGenreName} from "../../utils/constants/genres";
import {posterUrl} from "../../services/API/shared/tmdbClient";
import FilterBar from "../../components/FilterBar.astro";
import AdvancedFilters from "../../components/AdvancedFilters.astro";
import Pagination from "../../components/Pagination.astro";
import EmptyState from "../../components/EmptyState.astro";
import HoverPreview from "../../components/HoverPreview.astro";
import type {Movie} from "../../types/ApiMovie";
import type {Serie} from "../../types/ApiSerie";
import '../../styles/pages/catalogo/shared.css';
import '../../styles/pages/catalogo/card-animations.css';

const urlParams = new URL(Astro.request.url).searchParams;
const page = Number(urlParams.get('page') || 1);
const pageStr = page.toString();
const type = urlParams.get('type') || 'all';

const filters = parseAdvancedFilters(urlParams);
const filtersActive = hasActiveFilters(filters);
// "Solo en mis plataformas" (3.2b).
const mine = urlParams.get('mine') === '1';
const myProviders = (mine && Astro.locals.user?.platforms?.length) ? Astro.locals.user.platforms.join('|') : '';
const myRegion = Astro.locals.user?.region || 'ES';
const useDiscover = filtersActive || !!filters.sort || !!myProviders;

// Con filtros/orden/plataformas: /discover (default fecha desc = identidad "últimos").
// Sin nada: endpoints estándar /movie/now_playing + /tv/on_the_air.
const latestMovies = useDiscover
    ? await discoverContent<Movie>('movie', filters, { sort_by: sortByFor(filters.sort, 'movie') || 'primary_release_date.desc', page: pageStr, providers: myProviders, region: myRegion })
    : await getLatestMovies({page: pageStr});

const latestSeries = useDiscover
    ? await discoverContent<Serie>('tv', filters, { sort_by: sortByFor(filters.sort, 'tv') || 'first_air_date.desc', page: pageStr, providers: myProviders, region: myRegion })
    : await getLatestSeries({page: pageStr});

const totalPages = 150;

// Contexto para el contador en vivo del sheet (2.3b): mismo vote_count.gte que discoverContent.
const countCtx = [
    ...((type === 'all' || type === 'movies') ? [{ type: 'movie' as const, base: { 'vote_count.gte': '100' } }] : []),
    ...((type === 'all' || type === 'series') ? [{ type: 'tv' as const, base: { 'vote_count.gte': '100' } }] : []),
];

function buildFilterUrl(changes: Record<string, string | null>) {
    const p = new URLSearchParams(urlParams);
    for (const [k, v] of Object.entries(changes)) {
        if (v === null || v === '') p.delete(k);
        else p.set(k, v);
    }
    p.set('page', '1');
    return `?${p.toString()}`;
}

function buildTypeUrl(t: string) {
    const changes: Record<string, string | null> = { type: t };
    if (t !== 'series') changes.status = null;
    if (t !== 'movies') changes.runtime = null;
    return buildFilterUrl(changes);
}
---
<Layout title="Últimos Lanzamientos">
    <section class="px-1 sm:py-8">
        <CatalogHeader
            title="Últimos Lanzamientos"
            subtitle="Las películas y series más recientes del momento"
            color="green"
            icon="sparkles"
        />

        <FilterBar currentType={type} buildUrl={buildTypeUrl} />

        <AdvancedFilters filters={filters} buildUrl={buildFilterUrl} showRuntime={type === 'movies'} showStatus={type === 'series'}
                         showCert={type === 'movies'} order="Recientes" countCtx={countCtx}
                         mine={mine} myPlatforms={Astro.locals.user?.platforms ?? []} region={myRegion}
                         sortOptions={[{ value: 'popular', label: 'Popularidad' }, { value: 'rating', label: 'Mejor valoradas' }]} />

        <div class="flex items-center justify-between mb-6 text-sm text-gray-500">
            <span>Página <strong class="text-gray-900">{page}</strong> de {totalPages}</span>
            <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 bg-green-400 rounded-full"></span>
                Actualizado hoy
            </div>
        </div>

        {(type === 'all' || type === 'movies') && (
                <div class="mb-12" id="peliculas">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                        <span class="w-1 h-6 bg-red-500 rounded-full"></span>
                        Películas
                    </h2>

                    {latestMovies.length === 0 ? (
                        <EmptyState
                            variant="filter"
                            size="sm"
                            title="Sin películas con esos filtros"
                            description="Prueba con otra década o relaja la nota mínima."
                        >
                            <a slot="cta" href="/catalogo/ultimoslanzamientos?type=movie" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800 transition-all">Limpiar filtros</a>
                        </EmptyState>
                    ) : (
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
                            {latestMovies.map((item) => (
                                <div class="card-wrapper group">
                                    <HoverPreview tmdbId={item.id} tmdbType="movie" title={item.title} backdropPath={item.backdrop_path} href={`/movie/${item.id}`} year={item.release_date?.slice(0,4)} rating={item.vote_average}><CardMovie
                                            id={item.id.toString()}
                                            img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                            title={item.title}
                                            vote_average={item.vote_average}
                                            overview={item.overview}
                                            release_date={item.release_date}
                                            genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                    /></HoverPreview>
                                </div>
                            ))}
                        </div>
                    )}
                </div>
        )}

        {(type === 'all' || type === 'series') && (
                <div class="mb-12" id="series">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                        <span class="w-1 h-6 bg-blue-500 rounded-full"></span>
                        Series
                    </h2>
                    {latestSeries.length === 0 ? (
                        <EmptyState
                            variant="filter"
                            size="sm"
                            title="Sin series con esos filtros"
                            description="Prueba con otra década o relaja la nota mínima."
                        >
                            <a slot="cta" href="/catalogo/ultimoslanzamientos?type=tv" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800 transition-all">Limpiar filtros</a>
                        </EmptyState>
                    ) : (
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
                            {latestSeries.map((item) => (
                                <div class="card-wrapper group">
                                    <HoverPreview tmdbId={item.id} tmdbType="tv" title={item.name} backdropPath={item.backdrop_path} href={`/serie/${item.id}`} year={item.first_air_date?.slice(0,4)} rating={item.vote_average}><CardSerie
                                            id={item.id.toString()}
                                            img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                            name={item.name}
                                            vote_average={item.vote_average}
                                            overview={item.overview}
                                            first_air_date={item.first_air_date}
                                            seasons={item.seasons}
                                            last_episode_to_air={item.last_episode_to_air}
                                            next_episode_to_air={item.next_episode_to_air}
                                            genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                    /></HoverPreview>
                                </div>
                            ))}
                        </div>
                    )}
                </div>
        )}

        <Pagination page={page} totalPages={totalPages} buildUrl={(p) => {
            const q = new URLSearchParams(urlParams);
            q.set('page', String(p));
            return `?${q.toString()}`;
        }} />
    </section>
</Layout>
