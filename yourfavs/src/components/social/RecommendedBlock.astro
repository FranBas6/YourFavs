---
/**
 * «Te la recomendó Ana» en la ficha (F4; handoff docs/design_handoff_social_f4 §5.8).
 *
 * Va DENTRO de la tarjeta de tu nota (`StarRating`), encima, separado por una línea: no es una caja
 * nueva. Si la ficha no pinta esa tarjeta (el título no está en tus listas), sale suelto con
 * `alone`, con el mismo aspecto de tarjeta, para no perder la recomendación.
 *
 * Sale con cualquier recomendación recibida de este título que no hayas descartado, y se queda
 * aunque la veas. Con varias personas, avatares solapados y solo el mensaje más reciente. Sin
 * sesión, con la fase apagada o sin recomendaciones, no pinta nada.
 */
import { recommendedForTitle } from '../../services/BD/social/recommendations';
import { avatarHtml, relTime } from '../../lib/social/ui';
import { safeFetch } from '../../utils/safeFetch';
import { SOCIAL_PHASE } from '../../utils/constants/social';

interface Props {
    mediaType: 'movie' | 'tv';
    tmdbId: number | string | undefined;
    alone?: boolean;
}
const { mediaType, tmdbId, alone = false } = Astro.props;
const me = Astro.locals.user?.uid;
const id = Number(tmdbId);
const rec = SOCIAL_PHASE.recommend && me && Number.isInteger(id)
    ? await safeFetch(recommendedForTitle(me, mediaType, id), `rec/${mediaType}/${id}`, null)
    : null;
const people = rec?.people ?? [];
const avs = people.slice(0, 3).map((p) => avatarHtml(p, 32)).join('');
const names = people.map((p) => p.name);
---
{rec && people.length > 0 && (
    <div class:list={['recb', { 'is-alone': alone }]}>
        <span class="recb-avs" set:html={avs} />
        <div class="recb-tx">
            {names.length === 1 && <Fragment>Te la recomendó <b>{names[0]}</b></Fragment>}
            {names.length === 2 && <Fragment>Te la recomendaron <b>{names[0]}</b> y <b>{names[1]}</b></Fragment>}
            {names.length > 2 && <Fragment>Te la recomendaron <b>{names[0]}</b> y {names.length - 1} más</Fragment>}
            {rec.message && <q>{rec.message}</q>}
            <div class="recb-w">{relTime(rec.at)}</div>
        </div>
    </div>
)}
