---
import Layout from "../../layouts/Layout.astro"
import { getWatchedProgressBatch } from "../../services/BD/series/yourfavsSerie";
import { calculateGenrePreferences } from "../../utils/genrePreferences";
import { getPersonalRecommendations } from "../../utils/personalRecommendations";
import { getGenreName } from "../../utils/constants/genres";
import { safeFetch } from "../../utils/safeFetch";
import { withTimeout, isTimeout } from "../../utils/withTimeout";
import ListsNav from "../../components/personal/ListsNav.astro";
import ListTitle from "../../components/personal/ListTitle.astro";
import EmptyState from "../../components/EmptyState.astro";
import RecoRow, { type RecoRowItem } from "../../components/personal/RecoRow.astro";
import type { SeedInfo } from "../../utils/personalRecommendations";
import '../../styles/pages/personal/personal.css';

const debug = Astro.url.searchParams.get("debug") === "1";

let prefs: Awaited<ReturnType<typeof calculateGenrePreferences>> | null = null;
let recs: Awaited<ReturnType<typeof getPersonalRecommendations>> | null = null;
let errorMessage = "";
let isWarming = false; // true si timeout SSR → render shell con auto-reintento

// Timeout duro: Netlify Starter mata Lambdas a los 10s (max_duration solo aplica en Pro).
// Cold-start boot (Astro+Supabase+TMDB) come 2-4s antes de que corra nada del frontmatter,
// así que el timeout interno debe firar dentro de los ~6s útiles que quedan para que el
// catch alcance a renderizar el shell de warming antes del corte de Netlify.
const SSR_TIMEOUT_MS = 5500;

try {
    [prefs, recs] = await Promise.all([
        withTimeout(calculateGenrePreferences(), SSR_TIMEOUT_MS, 'recos/genrePrefs'),
        withTimeout(getPersonalRecommendations(), SSR_TIMEOUT_MS, 'recos/personalRecs'),
    ]);
} catch (error) {
    if (isTimeout(error)) {
        // Cold start: Lambda y conexiones en frío lentas. Servimos shell con auto-reintento.
        // El segundo hit pega a Lambda warm (L1/L2 cache caliente) y cabe en timeout.
        isWarming = true;
        console.warn("[recos] SSR timeout, sirviendo shell de warming:", (error as Error).message);
    } else {
        console.error("Error al cargar recomendaciones:", error);
        errorMessage = error instanceof Error ? error.message : "Error desconocido al cargar datos";
    }
}

const seriesRecomendadas = recs?.tv ?? [];
const peliculasRecomendadas = recs?.movies ?? [];
// Todas las series que pueden salir en alguna fila (la barra de progreso de CardSerie).
const allSeriesIdsForWatched = Array.from(new Set([
    ...seriesRecomendadas,
    ...(recs?.rows?.tv.seeds.flatMap((r) => r.items) ?? []),
    ...(recs?.rows?.tv.genres ?? []),
    ...(recs?.rows?.tv.trending ?? []),
].map((s: any) => String(s.id))));
const watchedMap = await safeFetch(
    getWatchedProgressBatch(allSeriesIdsForWatched),
    'personal/recomendaciones/watchedMap',
    {} as Record<string, { watched: number }>,
);

const filter = Astro.url.searchParams.get("filter") || "todos";
const showSeries = filter === "series" || filter === "todos";
const showMovies = filter === "peliculas" || filter === "todos";
const totalRecs = seriesRecomendadas.length + peliculasRecomendadas.length;
const hasLibrary = !!prefs && (prefs.libraryIds.movies.size + prefs.libraryIds.tv.size) > 0;
const hasGenres = !!prefs && (prefs.movies.topGenres.length + prefs.tv.topGenres.length) > 0;

/*
 * Filas por motivo (C, 2026-10-28), en carrusel: «Para ti hoy» (el feed mezclado), una por semilla
 * («Porque te gustó X»), «Fuera de tu zona» (las semillas de variedad), «Más de tus géneros» (el
 * discover) y «Tendencias que no tienes». Todo sale de la misma caché del motor. Un título sale solo
 * en la PRIMERA fila que lo enseña, y el filtro Todo · Series · Películas se aplica a todas.
 */
type Kind = 'movie' | 'tv';
const shownKind = (kind: Kind) => (kind === 'movie' ? showMovies : showSeries);
const tag = (kind: Kind, list: any[] = []): RecoRowItem[] => (shownKind(kind) ? list.map((item) => ({ kind, item })) : []);
/** Película, serie, película…: con el filtro en «Todo» ninguna fila es solo de un tipo. */
function interleave(a: RecoRowItem[], b: RecoRowItem[]): RecoRowItem[] {
    const out: RecoRowItem[] = [];
    for (let i = 0; i < Math.max(a.length, b.length); i++) {
        if (a[i]) out.push(a[i]);
        if (b[i]) out.push(b[i]);
    }
    return out;
}
const shown = new Set<string>();
/** Quita lo que ya salió en una fila anterior y, si la fila se queda, lo marca como enseñado. */
function claim(list: RecoRowItem[], max: number, min = 4): RecoRowItem[] {
    const fresh = list.filter(({ kind, item }) => !shown.has(`${kind}:${item.id}`)).slice(0, max);
    if (fresh.length >= min) fresh.forEach(({ kind, item }) => shown.add(`${kind}:${item.id}`));
    return fresh.length >= min ? fresh : [];
}

const rowsData = recs?.rows;
const forYouToday = claim(interleave(tag('movie', peliculasRecomendadas), tag('tv', seriesRecomendadas)), 12);

// «Porque te gustó X»: las semillas principales (sin las de variedad), alternando tipo. Con el filtro en
// «Todo», 2 de cada; con un solo tipo, 4.
const SEED_WHY: Record<string, { lead: string; chip: string }> = {
    fav: { lead: 'Porque te encantó', chip: 'en tus favoritas' },
    like: { lead: 'Porque te gustó', chip: 'en Me gusta' },
    rated: { lead: 'Por tu buena nota a', chip: 'tu nota' },
    seen: { lead: 'Porque has visto', chip: 'vista hace poco' },
    taste: { lead: 'Porque elegiste', chip: 'en tus gustos' },
};
const perKind = showMovies && showSeries ? 2 : 4;
const seedRowsOf = (kind: Kind) => (shownKind(kind) ? (kind === 'movie' ? rowsData?.movies.seeds : rowsData?.tv.seeds) ?? [] : [])
    .filter((r) => !r.seed.explore && r.seed.title);
const movieSeedRows = seedRowsOf('movie');
const tvSeedRows = seedRowsOf('tv');
const seedRows: { seed: SeedInfo; kind: Kind; items: RecoRowItem[] }[] = [];
{
    let m = 0, t = 0, mi = 0, ti = 0;
    while ((m < perKind && mi < movieSeedRows.length) || (t < perKind && ti < tvSeedRows.length)) {
        for (const kind of ['movie', 'tv'] as Kind[]) {
            const pool = kind === 'movie' ? movieSeedRows : tvSeedRows;
            while (kind === 'movie' ? (m < perKind && mi < pool.length) : (t < perKind && ti < pool.length)) {
                const r = pool[kind === 'movie' ? mi++ : ti++];
                const items = claim(tag(kind, r.items), 10);
                if (!items.length) continue;
                seedRows.push({ seed: r.seed, kind, items });
                if (kind === 'movie') m++; else t++;
                break;
            }
        }
    }
}

// «Fuera de tu zona»: lo que dieron las semillas de variedad, con su «Porque viste X» en cada card.
const exploreOf = (kind: Kind) => tag(kind, ((kind === 'movie' ? rowsData?.movies.seeds : rowsData?.tv.seeds) ?? [])
    .filter((r) => r.seed.explore)
    .flatMap((r) => r.items.slice(0, 5).map((it: any) => ({ ...it, _recSeedTitle: r.seed.title }))));
const outsideZone = claim(interleave(exploreOf('movie'), exploreOf('tv')), 12);

const moreGenres = claim(interleave(tag('movie', rowsData?.movies.genres), tag('tv', rowsData?.tv.genres)), 14);
// El chip dice qué dos géneros a la vez se han pedido (el motor usa los dos principales de cada tipo).
const pairOf = (ids: number[] = []) => ids.slice(0, 2).map((id) => getGenreName(id)).filter(Boolean).join(' + ');
const genreChip = Array.from(new Set([
    ...(showMovies ? [pairOf(prefs?.movies.topGenres)] : []),
    ...(showSeries ? [pairOf(prefs?.tv.topGenres)] : []),
].filter(Boolean))).join(' · ');
const trendingRow = claim(interleave(tag('movie', rowsData?.movies.trending), tag('tv', rowsData?.tv.trending)), 14);
const anyRow = forYouToday.length + seedRows.length + outsideZone.length + moreGenres.length + trendingRow.length > 0;
---
<Layout title="Recomendaciones">
    <ListsNav slot="aside" />
    {isWarming && (
        <Fragment slot="head">
            <meta http-equiv="refresh" content="3" />
        </Fragment>
    )}
    <section class="px-1 sm:py-8">
        {isWarming && (
            <div class="flex flex-col items-center justify-center py-20 px-4 text-center">
                <div class="relative w-16 h-16 mb-6">
                    <div class="absolute inset-0 rounded-full border-4 border-red-100"></div>
                    <div class="absolute inset-0 rounded-full border-4 border-red-500 border-t-transparent animate-spin"></div>
                </div>
                <h2 class="text-xl font-semibold text-gray-800 mb-2">Preparando tus recomendaciones…</h2>
                <p class="text-sm text-gray-500 max-w-md">
                    Estamos calentando el servidor con tu biblioteca. Esto pasa la primera vez del día y dura unos segundos. La página se recargará sola.
                </p>
            </div>
        )}
        {!isWarming && (<>
        {errorMessage && (
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm mb-6">
                {errorMessage}
            </div>
        )}

        <ListTitle title="Para ti">
            <p slot="below" class="lh-sub">{hasLibrary
                    ? 'A partir de tus favoritos, lo que te gusta, tus notas altas y lo último que has visto. Cambian cada día.'
                    : 'Añade contenido a tu biblioteca para generar recomendaciones'}</p>
        </ListTitle>


        {debug && prefs && (
            <div class="mb-8 border border-amber-300 bg-amber-50 rounded-xl p-4 text-sm">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="font-bold text-amber-900">🐛 Debug recomendaciones</h2>
                    <a href="/mislistas/recomendaciones" class="text-xs text-amber-700 underline">Salir del modo debug</a>
                </div>

                <div class="grid md:grid-cols-2 gap-4 mb-4">
                    <div class="bg-white rounded-lg p-3 border border-amber-200">
                        <h3 class="font-semibold text-gray-800 mb-2">🎬 Películas — señales (un título cuenta una vez, con la de más peso)</h3>
                        <ul class="text-xs text-gray-700 space-y-0.5 font-mono">
                            <li>Favoritos: <strong>{prefs.breakdown.movies.fav}</strong> (peso 3)</li>
                            <li>Me gusta: <strong>{prefs.breakdown.movies.like}</strong> (peso 2)</li>
                            <li>Onboarding (títulos): <strong>{prefs.breakdown.movies.taste}</strong> (peso 2)</li>
                            <li>Nota ≥ 8: <strong>{prefs.breakdown.movies.rated}</strong> (peso 2)</li>
                            <li>Vistas en 90 días: <strong>{prefs.breakdown.movies.seen}</strong> (peso 1, decayendo)</li>
                            <li class="text-gray-500">Lo reciente pesa hasta ×1.5 · cupo por señal (20 · 10 · 10 · 6 · 6) → resueltas: <strong>{prefs.seeds.movies.length}</strong></li>
                            <li class="pt-1 border-t border-gray-200 mt-1">Únicos en map: <strong>{prefs.libraryIds.movies.size}</strong></li>
                        </ul>
                    </div>
                    <div class="bg-white rounded-lg p-3 border border-amber-200">
                        <h3 class="font-semibold text-gray-800 mb-2">📺 Series — señales (un título cuenta una vez, con la de más peso)</h3>
                        <ul class="text-xs text-gray-700 space-y-0.5 font-mono">
                            <li>Favoritos: <strong>{prefs.breakdown.tv.fav}</strong> (peso 3)</li>
                            <li>Me gusta: <strong>{prefs.breakdown.tv.like}</strong> (peso 2)</li>
                            <li>Onboarding (títulos): <strong>{prefs.breakdown.tv.taste}</strong> (peso 2)</li>
                            <li>Nota ≥ 8: <strong>{prefs.breakdown.tv.rated}</strong> (peso 2)</li>
                            <li>Vistas en 90 días: <strong>{prefs.breakdown.tv.seen}</strong> (peso 1, decayendo)</li>
                            <li class="text-gray-500">Lo reciente pesa hasta ×1.5 · cupo por señal (20 · 10 · 10 · 6 · 6) → resueltas: <strong>{prefs.seeds.tv.length}</strong></li>
                            <li>Géneros del onboarding: <strong>{prefs.tasteGenres.length}</strong> (prior: 4 c/u sin biblioteca; luego ≤ 30 % de la masa)</li>
                            <li class="pt-1 border-t border-gray-200 mt-1">Únicos en map: <strong>{prefs.libraryIds.tv.size}</strong></li>
                        </ul>
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-4 mb-4">
                    <div class="bg-white rounded-lg p-3 border border-amber-200">
                        <h3 class="font-semibold text-gray-800 mb-2">🎬 Pesos completos por género</h3>
                        <ul class="text-xs text-gray-700 space-y-0.5 font-mono max-h-64 overflow-y-auto">
                            {Object.entries(prefs.movies.weighted)
                                .sort(([, a]: any, [, b]: any) => b - a)
                                .map(([gid, w]: [string, any], idx: number) => (
                                    <li class={idx < 3 ? 'text-red-700 font-bold' : ''}>
                                        {idx < 3 ? '★ ' : '  '}{getGenreName(Number(gid))}: <strong>{(w as number).toFixed(1)}</strong>
                                    </li>
                                ))}
                        </ul>
                    </div>
                    <div class="bg-white rounded-lg p-3 border border-amber-200">
                        <h3 class="font-semibold text-gray-800 mb-2">📺 Pesos completos por género</h3>
                        <ul class="text-xs text-gray-700 space-y-0.5 font-mono max-h-64 overflow-y-auto">
                            {Object.entries(prefs.tv.weighted)
                                .sort(([, a]: any, [, b]: any) => b - a)
                                .map(([gid, w]: [string, any], idx: number) => (
                                    <li class={idx < 3 ? 'text-blue-700 font-bold' : ''}>
                                        {idx < 3 ? '★ ' : '  '}{getGenreName(Number(gid))}: <strong>{(w as number).toFixed(1)}</strong>
                                    </li>
                                ))}
                        </ul>
                    </div>
                </div>

                {recs && (
                    <div class="grid md:grid-cols-2 gap-4 mb-4">
                        <div class="bg-white rounded-lg p-3 border border-amber-200">
                            <h3 class="font-semibold text-gray-800 mb-2">🎬 Semillas elegidas</h3>
                            <p class="text-xs text-amber-700 mb-1 font-mono">{recs.filterStats.movies.kept} de {recs.filterStats.movies.total} · por la cuota de variedad: {recs.filterStats.movies.diversified}</p>
                            <ul class="text-xs text-gray-700 space-y-0.5 font-mono">
                                {recs.seedsMovies.map((s: any) => (
                                    <li>
                                        · <strong>{s.title || `id ${s.id}`}</strong> <span class="text-gray-400">(peso {s.weight.toFixed(1)} · {s.why}{s.explore ? ' · variedad' : ''})</span><br/>
                                        <span class="text-gray-500 ml-3">[{(s.genres || []).map((g: number) => getGenreName(g)).join(', ')}]</span>
                                    </li>
                                ))}
                                {recs.seedsMovies.length === 0 && <li class="text-gray-400">— sin seeds</li>}
                            </ul>
                        </div>
                        <div class="bg-white rounded-lg p-3 border border-amber-200">
                            <h3 class="font-semibold text-gray-800 mb-2">📺 Semillas elegidas</h3>
                            <p class="text-xs text-amber-700 mb-1 font-mono">{recs.filterStats.tv.kept} de {recs.filterStats.tv.total} · por la cuota de variedad: {recs.filterStats.tv.diversified}</p>
                            <ul class="text-xs text-gray-700 space-y-0.5 font-mono">
                                {recs.seedsTv.map((s: any) => (
                                    <li>
                                        · <strong>{s.title || `id ${s.id}`}</strong> <span class="text-gray-400">(peso {s.weight.toFixed(1)} · {s.why}{s.explore ? ' · variedad' : ''})</span><br/>
                                        <span class="text-gray-500 ml-3">[{(s.genres || []).map((g: number) => getGenreName(g)).join(', ')}]</span>
                                    </li>
                                ))}
                                {recs.seedsTv.length === 0 && <li class="text-gray-400">— sin seeds</li>}
                            </ul>
                        </div>
                    </div>
                )}

                {recs && (
                    <div class="grid md:grid-cols-2 gap-4 mb-4">
                        <div class="bg-white rounded-lg p-3 border border-amber-200">
                            <h3 class="font-semibold text-gray-800 mb-2">🎬 Top recommendations (agregadas)</h3>
                            <ul class="text-xs text-gray-700 space-y-1 font-mono max-h-64 overflow-y-auto">
                                {recs.movies.slice(0, 10).map((m: any) => (
                                    <li>
                                        <strong>{m.title}</strong> · ⭐{m.vote_average?.toFixed(1)} · score <strong>{m._recScore?.toFixed(1)}</strong> ({m._recSources} seeds)<br/>
                                        <span class="text-gray-500">  Géneros: [{(m.genre_ids || []).map((g: number) => getGenreName(g)).join(', ')}]</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                        <div class="bg-white rounded-lg p-3 border border-amber-200">
                            <h3 class="font-semibold text-gray-800 mb-2">📺 Top recommendations (agregadas)</h3>
                            <ul class="text-xs text-gray-700 space-y-1 font-mono max-h-64 overflow-y-auto">
                                {recs.tv.slice(0, 10).map((s: any) => (
                                    <li>
                                        <strong>{s.name}</strong> · ⭐{s.vote_average?.toFixed(1)} · score <strong>{s._recScore?.toFixed(1)}</strong> ({s._recSources} seeds)<br/>
                                        <span class="text-gray-500">  Géneros: [{(s.genre_ids || []).map((g: number) => getGenreName(g)).join(', ')}]</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </div>
                )}

                <p class="text-xs text-amber-800 mt-3">
                    💡 Feed unificado: <strong>recommendations por semilla</strong> (sources ≥ 1; de las 10 mejores de cada una, 5 distintas cada día; las de variedad al 70 % y como mucho 3 títulos por semilla arriba) mezclado con <strong>discover por tus géneros</strong> (popularidad, página rotada por día) como booster suave (+0.5 score, sources = 0). El orden final lleva un desempate diario: mañana cambia.
                </p>
            </div>
        )}

        {/* Géneros detectados */}
        {hasGenres && prefs && (
            <div class="mb-6 flex flex-wrap items-center gap-2">
                <span class="text-xs font-medium text-gray-500 uppercase tracking-wide mr-1">Tus géneros</span>
                {prefs.movies.topGenres.map((id: number) => (
                    <span class="text-xs px-3 py-1 rounded-full bg-red-50 text-red-700 border border-red-200 font-medium">
                        🎬 {getGenreName(id)}
                    </span>
                ))}
                {prefs.tv.topGenres.map((id: number) => (
                    <span class="text-xs px-3 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200 font-medium">
                        📺 {getGenreName(id)}
                    </span>
                ))}
            </div>
        )}

        {/* Filtro tipo */}
        {totalRecs > 0 && (
            <nav class="lh-seg mb-6" aria-label="Tipo de título">
                <a href="?filter=todos" aria-current={filter === 'todos' ? 'page' : undefined}>Todo</a>
                <a href="?filter=peliculas" aria-current={filter === 'peliculas' ? 'page' : undefined}>Películas</a>
                <a href="?filter=series" aria-current={filter === 'series' ? 'page' : undefined}>Series</a>
            </nav>
        )}

        {!hasLibrary && (
            <EmptyState
                size="md"
                title="Tu biblioteca está vacía"
                description="Añade películas y series a tus colecciones (favoritos, siguiendo, vistos) y te calcularemos recomendaciones por géneros.">
                <a slot="cta" href="/catalogo/tendencias" class="inline-flex items-center gap-2 px-4 py-2 bg-[#E63946] text-white rounded-lg hover:bg-[#C7283A] transition-colors text-sm font-medium">Explorar tendencias</a>
            </EmptyState>
        )}

        {hasLibrary && !anyRow && (
            <EmptyState size="sm" title="Sin recomendaciones por ahora" description="Quizá ya lo tienes todo en tu biblioteca, o aún no hay datos suficientes. Marca algo en Favoritos o Me gusta y vuelve mañana." />
        )}

        {hasLibrary && anyRow && (
            <div class="rr-stack">
                <RecoRow
                    headingId="rr-hoy"
                    title="Para ti hoy"
                    subtitle="Lo mejor de todo lo de abajo. Cambia cada día."
                    icon="sparkles"
                    color="amber"
                    items={forYouToday}
                    watched={watchedMap}
                    showSeed
                />
                {seedRows.map((r, i) => (
                    <RecoRow
                        headingId={`rr-seed-${i}`}
                        title={`${SEED_WHY[r.seed.why ?? 'fav']?.lead ?? 'Porque te gustó'} ${r.seed.title}`}
                        why={SEED_WHY[r.seed.why ?? 'fav']?.chip}
                        icon={r.kind === 'movie' ? 'clapperboard' : 'tv'}
                        color={r.kind === 'movie' ? 'red' : 'blue'}
                        items={r.items}
                        watched={watchedMap}
                    />
                ))}
                <RecoRow
                    headingId="rr-fuera"
                    title="Fuera de tu zona"
                    subtitle="Sale de lo que menos se parece a lo de siempre en tus listas."
                    icon="compass"
                    color="purple"
                    items={outsideZone}
                    watched={watchedMap}
                    showSeed
                />
                <RecoRow
                    headingId="rr-generos"
                    title="Más de tus géneros"
                    subtitle="Lo más visto ahora que junta tus dos géneros más repetidos."
                    why={genreChip || undefined}
                    icon="shapes"
                    color="green"
                    items={moreGenres}
                    watched={watchedMap}
                />
                <RecoRow
                    headingId="rr-tendencias"
                    title="Tendencias que no tienes"
                    subtitle="Lo más visto esta semana que aún no está en ninguna de tus listas."
                    icon="trending-up"
                    color="pink"
                    items={trendingRow}
                    watched={watchedMap}
                />
            </div>
        )}
        </>)}
    </section>
</Layout>
