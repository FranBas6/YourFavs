---
import Layout from "../../layouts/Layout.astro"
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import { getWatchedProgressBatch } from "../../services/BD/series/yourfavsSerie";
import { tmdbFetchList } from "../../services/API/shared/tmdbClient";
import { calculateGenrePreferences } from "../../utils/genrePreferences";
import { getPersonalRecommendations } from "../../utils/personalRecommendations";
import { getGenreName } from "../../utils/constants/genres";
import { posterUrl } from "../../services/API/shared/tmdbClient";
import PersonalNav from "../../components/personal/PersonalNav.astro";
import EmptyState from "../../components/EmptyState.astro";
import HoverPreview from "../../components/HoverPreview.astro";
import '../../styles/pages/personal/personal.css';

const debug = Astro.url.searchParams.get("debug") === "1";

let prefs: Awaited<ReturnType<typeof calculateGenrePreferences>> | null = null;
let recs: Awaited<ReturnType<typeof getPersonalRecommendations>> | null = null;
let exploraMovies: any[] = [];
let exploraSeries: any[] = [];
let exploraMoviesRaw: any[] = [];
let exploraSeriesRaw: any[] = [];
let errorMessage = "";

try {
    [prefs, recs] = await Promise.all([
        calculateGenrePreferences(),
        getPersonalRecommendations(),
    ]);

    const movieGenresParam = prefs.movies.topGenres.join(',');
    const tvGenresParam = prefs.tv.topGenres.join(',');

    // Sección "Explora por géneros" — discover ENDURECIDO: vote_average.desc, vote_count alto.
    const movieParams = (page: string) => ({
        with_genres: movieGenresParam,
        sort_by: 'vote_average.desc',
        'vote_count.gte': '500',
        'vote_average.gte': '7',
        include_adult: 'false',
        page,
    });
    const tvParams = (page: string) => ({
        with_genres: tvGenresParam,
        sort_by: 'vote_average.desc',
        'vote_count.gte': '200',
        'vote_average.gte': '7',
        include_adult: 'false',
        page,
    });

    const moviePromises = movieGenresParam
        ? [tmdbFetchList<any>('/discover/movie', movieParams('1')), tmdbFetchList<any>('/discover/movie', movieParams('2'))]
        : [];
    const tvPromises = tvGenresParam
        ? [tmdbFetchList<any>('/discover/tv', tvParams('1')), tmdbFetchList<any>('/discover/tv', tvParams('2'))]
        : [];

    const [moviePages, tvPages] = await Promise.all([
        Promise.all(moviePromises),
        Promise.all(tvPromises),
    ]);
    exploraMoviesRaw = moviePages.flat();
    exploraSeriesRaw = tvPages.flat();

    // Excluye biblioteca y dedup contra recommendations principales
    const recMovieIds = new Set(recs.movies.map((m: any) => String(m.id)));
    const recTvIds = new Set(recs.tv.map((s: any) => String(s.id)));
    exploraMovies = exploraMoviesRaw
        .filter((m: any) => !prefs!.libraryIds.movies.has(String(m.id)) && !recMovieIds.has(String(m.id)))
        .slice(0, 15);
    exploraSeries = exploraSeriesRaw
        .filter((s: any) => !prefs!.libraryIds.tv.has(String(s.id)) && !recTvIds.has(String(s.id)))
        .slice(0, 15);
} catch (error) {
    console.error("Error al cargar recomendaciones:", error);
    errorMessage = error instanceof Error ? error.message : "Error desconocido al cargar datos";
}

const seriesRecomendadas = recs?.tv ?? [];
const peliculasRecomendadas = recs?.movies ?? [];
const allSeriesIdsForWatched = [...seriesRecomendadas, ...exploraSeries].map((s: any) => String(s.id));
const watchedMap = await getWatchedProgressBatch(allSeriesIdsForWatched);

const filter = Astro.url.searchParams.get("filter") || "todos";
const showSeries = filter === "series" || filter === "todos";
const showMovies = filter === "peliculas" || filter === "todos";
const totalRecs = seriesRecomendadas.length + peliculasRecomendadas.length;
const hasLibrary = !!prefs && (prefs.libraryIds.movies.size + prefs.libraryIds.tv.size) > 0;
const hasGenres = !!prefs && (prefs.movies.topGenres.length + prefs.tv.topGenres.length) > 0;
---
<Layout title="Recomendaciones">
    <section class="px-1 sm:py-8">
        {errorMessage && (
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm mb-6">
                {errorMessage}
            </div>
        )}

        <header class="mb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Recomendaciones</h1>
            <p class="text-gray-500 text-base">
                {hasLibrary
                    ? 'Calculadas a partir de los géneros que más aparecen en tu biblioteca'
                    : 'Añade contenido a tu biblioteca para generar recomendaciones'}
            </p>
        </header>

        <div class="mb-4">
            <PersonalNav currentPage="/personal/recomendaciones" />
        </div>

        {debug && prefs && (
            <div class="mb-8 border border-amber-300 bg-amber-50 rounded-xl p-4 text-sm">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="font-bold text-amber-900">🐛 Debug recomendaciones</h2>
                    <a href="/personal/recomendaciones" class="text-xs text-amber-700 underline">Salir del modo debug</a>
                </div>

                <div class="grid md:grid-cols-2 gap-4 mb-4">
                    <div class="bg-white rounded-lg p-3 border border-amber-200">
                        <h3 class="font-semibold text-gray-800 mb-2">🎬 Películas — items por colección</h3>
                        <ul class="text-xs text-gray-700 space-y-0.5 font-mono">
                            <li>Favs: <strong>{prefs.breakdown.movies.favs}</strong> (peso 2)</li>
                            <li>Like: <strong>{prefs.breakdown.movies.like}</strong> (peso 1.5)</li>
                            <li>Vistos: <strong>{prefs.breakdown.movies.vistos}</strong> (peso 1)</li>
                            <li>Pendientes: <strong>{prefs.breakdown.movies.pendientes}</strong> (peso 0.5)</li>
                            <li>VerPronto: <strong>{prefs.breakdown.movies.verpronto}</strong> (peso 0.5)</li>
                            <li class="pt-1 border-t border-gray-200 mt-1">Únicos en map: <strong>{prefs.libraryIds.movies.size}</strong></li>
                        </ul>
                    </div>
                    <div class="bg-white rounded-lg p-3 border border-amber-200">
                        <h3 class="font-semibold text-gray-800 mb-2">📺 Series — items por colección</h3>
                        <ul class="text-xs text-gray-700 space-y-0.5 font-mono">
                            <li>Favs: <strong>{prefs.breakdown.tv.favs}</strong> (peso 2)</li>
                            <li>Siguiendo: <strong>{prefs.breakdown.tv.siguiendo}</strong> (peso 1.5)</li>
                            <li>Like: <strong>{prefs.breakdown.tv.like}</strong> (peso 1.5)</li>
                            <li>Vistos: <strong>{prefs.breakdown.tv.vistos}</strong> (peso 1)</li>
                            <li>Pendientes: <strong>{prefs.breakdown.tv.pendientes}</strong> (peso 0.5)</li>
                            <li>VerPronto: <strong>{prefs.breakdown.tv.verpronto}</strong> (peso 0.5)</li>
                            <li class="pt-1 border-t border-gray-200 mt-1">Únicos en map: <strong>{prefs.libraryIds.tv.size}</strong></li>
                        </ul>
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-4 mb-4">
                    <div class="bg-white rounded-lg p-3 border border-amber-200">
                        <h3 class="font-semibold text-gray-800 mb-2">🎬 Pesos completos por género</h3>
                        <ul class="text-xs text-gray-700 space-y-0.5 font-mono max-h-64 overflow-y-auto">
                            {Object.entries(prefs.movies.weighted)
                                .sort(([, a]: any, [, b]: any) => b - a)
                                .map(([gid, w]: [string, any], idx: number) => (
                                    <li class={idx < 3 ? 'text-red-700 font-bold' : ''}>
                                        {idx < 3 ? '★ ' : '  '}{getGenreName(Number(gid))}: <strong>{(w as number).toFixed(1)}</strong>
                                    </li>
                                ))}
                        </ul>
                    </div>
                    <div class="bg-white rounded-lg p-3 border border-amber-200">
                        <h3 class="font-semibold text-gray-800 mb-2">📺 Pesos completos por género</h3>
                        <ul class="text-xs text-gray-700 space-y-0.5 font-mono max-h-64 overflow-y-auto">
                            {Object.entries(prefs.tv.weighted)
                                .sort(([, a]: any, [, b]: any) => b - a)
                                .map(([gid, w]: [string, any], idx: number) => (
                                    <li class={idx < 3 ? 'text-blue-700 font-bold' : ''}>
                                        {idx < 3 ? '★ ' : '  '}{getGenreName(Number(gid))}: <strong>{(w as number).toFixed(1)}</strong>
                                    </li>
                                ))}
                        </ul>
                    </div>
                </div>

                {recs && (
                    <div class="grid md:grid-cols-2 gap-4 mb-4">
                        <div class="bg-white rounded-lg p-3 border border-amber-200">
                            <h3 class="font-semibold text-gray-800 mb-2">🎬 Seeds (después filtro afinidad)</h3>
                            <p class="text-xs text-amber-700 mb-1 font-mono">Filtro: {recs.filterStats.movies.kept}/{recs.filterStats.movies.total} candidatos pasaron</p>
                            <ul class="text-xs text-gray-700 space-y-0.5 font-mono">
                                {recs.seedsMovies.map((s: any) => (
                                    <li>
                                        · <strong>{s.title || `id ${s.id}`}</strong> <span class="text-gray-400">(peso {s.weight.toFixed(1)})</span><br/>
                                        <span class="text-gray-500 ml-3">[{(s.genres || []).map((g: number) => getGenreName(g)).join(', ')}]</span>
                                    </li>
                                ))}
                                {recs.seedsMovies.length === 0 && <li class="text-gray-400">— sin seeds</li>}
                            </ul>
                        </div>
                        <div class="bg-white rounded-lg p-3 border border-amber-200">
                            <h3 class="font-semibold text-gray-800 mb-2">📺 Seeds (después filtro afinidad)</h3>
                            <p class="text-xs text-amber-700 mb-1 font-mono">Filtro: {recs.filterStats.tv.kept}/{recs.filterStats.tv.total} candidatos pasaron</p>
                            <ul class="text-xs text-gray-700 space-y-0.5 font-mono">
                                {recs.seedsTv.map((s: any) => (
                                    <li>
                                        · <strong>{s.title || `id ${s.id}`}</strong> <span class="text-gray-400">(peso {s.weight.toFixed(1)})</span><br/>
                                        <span class="text-gray-500 ml-3">[{(s.genres || []).map((g: number) => getGenreName(g)).join(', ')}]</span>
                                    </li>
                                ))}
                                {recs.seedsTv.length === 0 && <li class="text-gray-400">— sin seeds</li>}
                            </ul>
                        </div>
                    </div>
                )}

                {recs && (
                    <div class="grid md:grid-cols-2 gap-4 mb-4">
                        <div class="bg-white rounded-lg p-3 border border-amber-200">
                            <h3 class="font-semibold text-gray-800 mb-2">🎬 Top recommendations (agregadas)</h3>
                            <ul class="text-xs text-gray-700 space-y-1 font-mono max-h-64 overflow-y-auto">
                                {recs.movies.slice(0, 10).map((m: any) => (
                                    <li>
                                        <strong>{m.title}</strong> · ⭐{m.vote_average?.toFixed(1)} · score <strong>{m._recScore?.toFixed(1)}</strong> ({m._recSources} seeds)<br/>
                                        <span class="text-gray-500">  Géneros: [{(m.genre_ids || []).map((g: number) => getGenreName(g)).join(', ')}]</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                        <div class="bg-white rounded-lg p-3 border border-amber-200">
                            <h3 class="font-semibold text-gray-800 mb-2">📺 Top recommendations (agregadas)</h3>
                            <ul class="text-xs text-gray-700 space-y-1 font-mono max-h-64 overflow-y-auto">
                                {recs.tv.slice(0, 10).map((s: any) => (
                                    <li>
                                        <strong>{s.name}</strong> · ⭐{s.vote_average?.toFixed(1)} · score <strong>{s._recScore?.toFixed(1)}</strong> ({s._recSources} seeds)<br/>
                                        <span class="text-gray-500">  Géneros: [{(s.genre_ids || []).map((g: number) => getGenreName(g)).join(', ')}]</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </div>
                )}

                <div class="grid md:grid-cols-2 gap-4">
                    <div class="bg-white rounded-lg p-3 border border-amber-200">
                        <h3 class="font-semibold text-gray-800 mb-2">🎬 Discover endurecido (vote_avg.desc)</h3>
                        <ul class="text-xs text-gray-700 space-y-1 font-mono max-h-64 overflow-y-auto">
                            {exploraMoviesRaw.slice(0, 10).map((m: any) => (
                                <li class={prefs!.libraryIds.movies.has(String(m.id)) ? 'opacity-40 line-through' : ''}>
                                    <strong>{m.title}</strong> · ⭐{m.vote_average?.toFixed(1)} · 🔢{m.vote_count}<br/>
                                    <span class="text-gray-500">  Géneros: [{(m.genre_ids || []).map((g: number) => getGenreName(g)).join(', ')}]</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                    <div class="bg-white rounded-lg p-3 border border-amber-200">
                        <h3 class="font-semibold text-gray-800 mb-2">📺 Discover endurecido (vote_avg.desc)</h3>
                        <ul class="text-xs text-gray-700 space-y-1 font-mono max-h-64 overflow-y-auto">
                            {exploraSeriesRaw.slice(0, 10).map((s: any) => (
                                <li class={prefs!.libraryIds.tv.has(String(s.id)) ? 'opacity-40 line-through' : ''}>
                                    <strong>{s.name}</strong> · ⭐{s.vote_average?.toFixed(1)} · 🔢{s.vote_count}<br/>
                                    <span class="text-gray-500">  Géneros: [{(s.genre_ids || []).map((g: number) => getGenreName(g)).join(', ')}]</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>

                <p class="text-xs text-amber-800 mt-3">
                    💡 La sección principal "Para ti" usa <strong>recommendations por seed</strong>. La secundaria "Explora" usa discover endurecido. Score = suma de pesos de seeds que recomiendan ese item.
                </p>
            </div>
        )}

        {/* Géneros detectados */}
        {hasGenres && prefs && (
            <div class="mb-6 flex flex-wrap items-center gap-2">
                <span class="text-xs font-medium text-gray-500 uppercase tracking-wide mr-1">Tus géneros</span>
                {prefs.movies.topGenres.map((id: number) => (
                    <span class="text-xs px-3 py-1 rounded-full bg-red-50 text-red-700 border border-red-200 font-medium">
                        🎬 {getGenreName(id)}
                    </span>
                ))}
                {prefs.tv.topGenres.map((id: number) => (
                    <span class="text-xs px-3 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200 font-medium">
                        📺 {getGenreName(id)}
                    </span>
                ))}
            </div>
        )}

        {/* Filtro tipo */}
        {totalRecs > 0 && (
            <div class="flex justify-center mb-6">
                <div class="inline-flex gap-1 bg-gray-100 rounded-xl p-1">
                    <a href="?filter=todos" class={`px-4 py-2 rounded-lg text-sm font-medium transition-all ${filter === 'todos' ? 'bg-red-500 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900 hover:bg-white'}`}>Todo</a>
                    <a href="?filter=series" class={`px-4 py-2 rounded-lg text-sm font-medium transition-all ${filter === 'series' ? 'bg-red-500 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900 hover:bg-white'}`}>Series</a>
                    <a href="?filter=peliculas" class={`px-4 py-2 rounded-lg text-sm font-medium transition-all ${filter === 'peliculas' ? 'bg-red-500 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900 hover:bg-white'}`}>Películas</a>
                </div>
            </div>
        )}

        {!hasLibrary && (
            <EmptyState
                size="md"
                title="Tu biblioteca está vacía"
                description="Añade películas y series a tus colecciones (favoritos, siguiendo, vistos) y te calcularemos recomendaciones por géneros.">
                <a slot="cta" href="/catalogo/tendencias" class="inline-flex items-center gap-2 px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors text-sm font-medium">Explorar tendencias</a>
            </EmptyState>
        )}

        {hasLibrary && (
            <div class="space-y-10">
                {showSeries && (
                    <section id="series-section" class="scroll-mt-20">
                        <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                            <span class="w-1 h-6 bg-blue-500 rounded-full"></span>
                            Series para ti
                            <span class="text-xs font-normal text-blue-600 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-full">basado en tus favoritos</span>
                            <span class="text-sm font-normal text-gray-400">({seriesRecomendadas.length})</span>
                        </h2>

                        {seriesRecomendadas.length === 0 && (
                            <EmptyState size="sm" title="Sin recomendaciones de series" description="Quizá ya las tienes todas en tu biblioteca, o aún no hay datos suficientes para identificar tus géneros favoritos." />
                        )}
                        {seriesRecomendadas.length > 0 && (
                            <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                                {seriesRecomendadas.map((item: any) => (
                                    <HoverPreview tmdbId={item.id} tmdbType="tv" title={item.name} backdropPath={item.backdrop_path} href={`/serie/${item.id}`} year={item.first_air_date?.slice(0,4)} rating={item.vote_average}><CardSerie
                                        id={item.id.toString()}
                                        img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                        name={item.name}
                                        vote_average={item.vote_average}
                                        overview={item.overview}
                                        first_air_date={item.first_air_date}
                                        genres={item.genre_ids?.map((gId: number) => ({ id: gId, name: getGenreName(gId) }))}
                                        watchedEpisodes={watchedMap[String(item.id)]?.watched}
                                    /></HoverPreview>
                                ))}
                            </div>
                        )}
                    </section>
                )}

                {showMovies && (
                    <section id="movies-section" class="scroll-mt-20">
                        <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                            <span class="w-1 h-6 bg-red-500 rounded-full"></span>
                            Películas para ti
                            <span class="text-xs font-normal text-red-600 bg-red-50 border border-red-200 px-2 py-0.5 rounded-full">basado en tus favoritos</span>
                            <span class="text-sm font-normal text-gray-400">({peliculasRecomendadas.length})</span>
                        </h2>

                        {peliculasRecomendadas.length === 0 && (
                            <EmptyState size="sm" title="Sin recomendaciones de películas" description="Quizá ya las tienes todas en tu biblioteca, o aún no hay datos suficientes para identificar tus géneros favoritos." />
                        )}
                        {peliculasRecomendadas.length > 0 && (
                            <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                                {peliculasRecomendadas.map((item: any) => (
                                    <HoverPreview tmdbId={item.id} tmdbType="movie" title={item.title} backdropPath={item.backdrop_path} href={`/movie/${item.id}`} year={item.release_date?.slice(0,4)} rating={item.vote_average}><CardMovie
                                        id={item.id.toString()}
                                        img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                        title={item.title}
                                        vote_average={item.vote_average}
                                        overview={item.overview}
                                        release_date={item.release_date}
                                        genres={item.genre_ids?.map((gId: number) => ({ id: gId, name: getGenreName(gId) }))}
                                    /></HoverPreview>
                                ))}
                            </div>
                        )}
                    </section>
                )}

                {/* Explora por géneros (secundaria) */}
                {(showSeries && exploraSeries.length > 0) && (
                    <section class="scroll-mt-20 pt-6 border-t border-gray-100">
                        <h2 class="text-xl font-semibold text-gray-800 mb-1 flex items-center gap-2">
                            <span class="w-1 h-6 bg-emerald-500 rounded-full"></span>
                            Explora series mejor valoradas
                            <span class="text-xs font-normal text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full">por tus géneros</span>
                            <span class="text-sm font-normal text-gray-400">({exploraSeries.length})</span>
                        </h2>
                        <p class="text-xs text-gray-500 mb-4">Joyas con nota TMDB ≥ 7 que tocan alguno de tus géneros favoritos.</p>
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                            {exploraSeries.map((item: any) => (
                                <HoverPreview tmdbId={item.id} tmdbType="tv" title={item.name} backdropPath={item.backdrop_path} href={`/serie/${item.id}`} year={item.first_air_date?.slice(0,4)} rating={item.vote_average}><CardSerie
                                    id={item.id.toString()}
                                    img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                    name={item.name}
                                    vote_average={item.vote_average}
                                    overview={item.overview}
                                    first_air_date={item.first_air_date}
                                    genres={item.genre_ids?.map((gId: number) => ({ id: gId, name: getGenreName(gId) }))}
                                    watchedEpisodes={watchedMap[String(item.id)]?.watched}
                                /></HoverPreview>
                            ))}
                        </div>
                    </section>
                )}

                {(showMovies && exploraMovies.length > 0) && (
                    <section class="scroll-mt-20 pt-6 border-t border-gray-100">
                        <h2 class="text-xl font-semibold text-gray-800 mb-1 flex items-center gap-2">
                            <span class="w-1 h-6 bg-emerald-500 rounded-full"></span>
                            Explora pelis mejor valoradas
                            <span class="text-xs font-normal text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full">por tus géneros</span>
                            <span class="text-sm font-normal text-gray-400">({exploraMovies.length})</span>
                        </h2>
                        <p class="text-xs text-gray-500 mb-4">Joyas con nota TMDB ≥ 7 y muchos votos que tocan alguno de tus géneros favoritos.</p>
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                            {exploraMovies.map((item: any) => (
                                <HoverPreview tmdbId={item.id} tmdbType="movie" title={item.title} backdropPath={item.backdrop_path} href={`/movie/${item.id}`} year={item.release_date?.slice(0,4)} rating={item.vote_average}><CardMovie
                                    id={item.id.toString()}
                                    img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                    title={item.title}
                                    vote_average={item.vote_average}
                                    overview={item.overview}
                                    release_date={item.release_date}
                                    genres={item.genre_ids?.map((gId: number) => ({ id: gId, name: getGenreName(gId) }))}
                                /></HoverPreview>
                            ))}
                        </div>
                    </section>
                )}
            </div>
        )}
    </section>
</Layout>
