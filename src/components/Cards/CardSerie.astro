---
/**
 * CardSerie — envoltorio de TitleCard (sistema v2, Fase 3) para no tocar sus usos de golpe: recibe
 * las mismas props de siempre, calcula lo propio de las series (periodo de emisión, temporadas,
 * episodios para el progreso) y pinta la tarjeta nueva, sin caja. Ver Cards/TitleCard.astro.
 */
import TitleCard, { type CardDensity, type CardContext } from './TitleCard.astro';

interface Props {
    id: string;
    name: string;
    img: string;
    vote_average: number;
    overview: string;
    first_air_date?: string;
    seasons?: { air_date: string; episode_count: number; id: number; name: string; overview: string; poster_path: string; season_number: number; vote_average?: number }[];
    last_episode_to_air?: { air_date: string; episode_number: number; season_number: number; [key: string]: any };
    next_episode_to_air?: { air_date: string; episode_number: number; season_number: number; [key: string]: any } | null;
    genres?: { id: number; name: string }[];
    status?: string;
    character?: string;
    favoriteNumber?: number;
    watchedEpisodes?: number;
    /** Contexto de seguimiento: activa la cuenta atrás del próximo episodio. */
    followed?: boolean;
    userRating?: number;
    seedTitle?: string;
    recommendedBy?: { name: string; more: number };
    platform?: string;
    abandoned?: boolean;
    density?: CardDensity;
    context?: CardContext;
}

const p = Astro.props;

// Temporadas y episodios (sin la temporada 0 de especiales).
const regular = (p.seasons ?? []).filter((s) => s.season_number > 0);
const totalSeasons = regular.length;
const totalEpisodes = regular.reduce((sum, s) => sum + (s.episode_count || 0), 0);
const seasonsLabel = totalSeasons === 0 ? null : totalSeasons === 1 ? `${totalEpisodes} ep.` : `${totalSeasons} temp.`;

// Periodo de emisión: «2011 – 2019», «2019» o «2023 – hoy».
const startYear = p.first_air_date ? new Date(p.first_air_date).getFullYear() : null;
const ended = p.status === 'Ended' || p.status === 'Canceled';
const endYear = ended && p.last_episode_to_air?.air_date ? new Date(p.last_episode_to_air.air_date).getFullYear() : null;
const airPeriod = startYear
    ? (endYear && endYear !== startYear ? `${startYear} – ${endYear}` : endYear === startYear ? `${startYear}` : p.status ? `${startYear} – hoy` : `${startYear}`)
    : null;
---
<TitleCard
    mediaType="tv"
    id={p.id}
    title={p.name}
    img={p.img}
    vote_average={p.vote_average}
    overview={p.overview}
    date={p.first_air_date}
    genres={p.genres}
    character={p.character}
    userRating={p.userRating}
    seedTitle={p.seedTitle}
    recommendedBy={p.recommendedBy}
    platform={p.platform}
    density={p.density}
    context={p.context}
    airPeriod={airPeriod}
    seasonsLabel={seasonsLabel}
    totalEpisodes={totalEpisodes || undefined}
    watchedEpisodes={p.watchedEpisodes}
    favoriteNumber={p.favoriteNumber}
    followed={p.followed}
    next_episode_to_air={p.next_episode_to_air}
    abandoned={p.abandoned}
/>
