                            <p class="text-gray-800 dark:text-gray-600">No hay información biográfica disponible.</p>
                        )}
                    </div>
                    
                    <!-- Información Personal -->
                    <div class="personal-info-card">
                        <h3 class="info-subtitle">Información Personal</h3>
                        <div class="info-grid">
                            {actorInfo.fechaNacimiento && (
                                <div class="info-item">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                                    </svg>
                                    <div>
                                        <span class="info-label">Nacimiento</span>
                                        <span class="info-value">{actorInfo.fechaNacimiento}</span>
                                    </div>
                                </div>
                            )}
                            
                            {actorInfo.fechaFallecimiento && (
                                <div class="info-item">
