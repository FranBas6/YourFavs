---
interface Poster {
    file_path: string;
}

interface Props {
    posters: Poster[];
    prefix?: string;
    title?: string;
}

const { posters, prefix = "poster", title = "Pósters" } = Astro.props;
---
{posters && posters.length > 0 && (
    <>
        <details class="bg-white rounded-xl border border-gray-200">
            <summary class="p-5 cursor-pointer text-lg font-semibold text-gray-800 flex items-center justify-between">
                <span>{title} ({posters.length})</span>
                <svg class="w-5 h-5 text-gray-4000" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-2">
                {posters.map((poster, index) => (
                    <a href={`#${prefix}-${index}`} class="block rounded-lg overflow-hidden hover:opacity-80 transition-opacity">
                        <img src={poster.file_path} alt={`${title} ${index + 1}`} loading="lazy" class="w-full aspect-[2/3] object-cover" />
                    </a>
                ))}
            </div>
        </details>

        {posters.map((poster, index) => (
            <div id={`${prefix}-${index}`} class="lightbox fixed inset-0 items-center justify-center bg-black/80 p-4" style="z-index: 9999;">
                <a href="#_" class="absolute inset-0" aria-label="Cerrar"></a>
                <img src={poster.file_path} alt={`${title} ${index + 1}`} class="relative max-h-[90vh] max-w-[90vw] object-contain rounded-lg shadow-2xl" />
                <a href="#_" class="absolute top-4 right-4 text-white/80 hover:text-white text-3xl font-light leading-none z-10" aria-label="Cerrar">&times;</a>
                {index > 0 && (
                    <a href={`#${prefix}-${index - 1}`} class="absolute left-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10" aria-label="Anterior">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    </a>
                )}
                {index < posters.length - 1 && (
                    <a href={`#${prefix}-${index + 1}`} class="absolute right-14 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10" aria-label="Siguiente">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </a>
                )}
            </div>
        ))}
    </>
)}
