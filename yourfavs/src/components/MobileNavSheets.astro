---
/**
 * Las 3 hojas del tab bar móvil: Explorar · Mis listas · Perfil.
 * Montadas una vez en el Layout (junto al MobileTabBar). Cada tab que abre hoja
 * dispara `yf:sheet-open` con su id ('explorar' | 'listas' | 'perfil').
 *
 * Contadores de "Mis listas": LAZY — se piden a /api/lists/counts la primera vez
 * que se abre la hoja (no en SSR), respetando la cuota Firestore.
 */
import BottomSheet from './BottomSheet.astro';
import Stamp from './Stamp.astro';
import { Icon } from 'astro-icon/components';
import { EXPLORE_ITEMS, MY_LISTS_ITEMS } from '../utils/constants/myLists';
import { withMode } from '../utils/catalogUrl';
import { appDateParts } from '../utils/appTime';

const user = Astro.locals.user;
// La hoja «Explorar» es la forma de saltar entre subpáginas del catálogo en móvil, así que sus filas
// arrastran el modo activo. Con «Todo» no se escribe nada y las URLs quedan limpias.
const catalogMode = Astro.locals.catalogMode;
const displayName = user ? (user.name || user.email?.split('@')[0] || 'Tú') : '';
const email = user?.email ?? '';
function initials(name: string, mail: string): string {
    const n = name?.trim();
    if (n) { const p = n.split(/\s+/); return ((p[0]?.[0] || '') + (p[1]?.[0] || '')).toUpperCase(); }
    return (mail || '').slice(0, 2).toUpperCase() || '??';
}
const avatarInitials = user ? initials(displayName, email) : '';
const avatarUrl = user?.picture || null;

// El año que verá al entrar en "Tu cine en números" (/mislistas/year redirige al actual).
// Vía appDateParts, no `new Date().getFullYear()`: el servidor va en UTC y el 31 de
// diciembre por la noche en Madrid ya sería el año siguiente para el servidor.
const currentYear = appDateParts(Date.now()).year;

// Tema ELEGIDO, para marcar el segmentado en SSR. 'system' = seguir al SO.
const themeChoice = user?.theme ?? 'light';
const THEME_OPTIONS = [
    { value: 'light', icon: 'sun', label: 'Claro' },
    { value: 'dark', icon: 'moon', label: 'Oscuro' },
    { value: 'system', icon: 'monitor', label: 'Según el sistema' },
] as const;
---

<!-- Explorar (público) -->
<BottomSheet id="explorar" title="Explorar el catálogo">
    {EXPLORE_ITEMS.map((it) => (
        <a class="yf-sheet-row" href={withMode(it.href, catalogMode)}>
            <Stamp color={it.color} icon={it.icon} size={38} />
            <span class="yf-sheet-rowtext">
                <span class="yf-sheet-rowtitle">{it.title}</span>
                {it.desc && <span class="yf-sheet-rowsub">{it.desc}</span>}
            </span>
        </a>
    ))}
</BottomSheet>

{user && (
    <BottomSheet id="listas" title="Mis listas">
        {MY_LISTS_ITEMS.map((it) => (
            <a class="yf-sheet-row" href={it.href}>
                <Stamp color={it.color} icon={it.icon} size={38} />
                <span class="yf-sheet-rowtext">
                    <span class="yf-sheet-rowtitle">{it.title}</span>
                    {it.countKey
                        ? <span class="yf-sheet-rowsub" data-count-key={it.countKey}>&nbsp;</span>
                        : (it.desc && <span class="yf-sheet-rowsub">{it.desc}</span>)}
                </span>
            </a>
        ))}
    </BottomSheet>
)}

{user && (
    <BottomSheet id="perfil" title="Tu cuenta" hideTitle>
        {/* Identidad: quién eres (no navegable) + el enlace a tu ficha, separado, para que
            "Ver perfil" y "Ajustes" no compitan por el mismo trozo de pantalla. */}
        <div class="yf-sheet-head">
            <span class="yf-sheet-avatar" aria-hidden="true">
                {avatarUrl ? <img src={avatarUrl} alt="" /> : <span>{avatarInitials}</span>}
            </span>
            <span class="yf-sheet-headtext">
                <span class="yf-sheet-headname">{displayName}</span>
                {email && <span class="yf-sheet-headmail">{email}</span>}
            </span>
            <a class="yf-sheet-headlink" href="/perfil/perfil">
                Ver perfil
                <Icon name="lucide:chevron-right" />
            </a>
        </div>

        <a class="yf-sheet-row" href="/gustos">
            <Stamp color="purple" icon="heart" size={38} />
            <span class="yf-sheet-rowtext"><span class="yf-sheet-rowtitle">Tus gustos</span></span>
            <Icon name="lucide:chevron-right" class="yf-sheet-chev" />
        </a>
        <a class="yf-sheet-row" href="/mislistas/notificaciones">
            <Stamp color="blue" icon="bell" size={38} />
            <span class="yf-sheet-rowtext"><span class="yf-sheet-rowtitle">Notificaciones</span></span>
            <span class="yf-sheet-badge js-notif-badge" hidden aria-label="sin leer"></span>
            <Icon name="lucide:chevron-right" class="yf-sheet-chev" />
        </a>
        <a class="yf-sheet-row" href="/mislistas/actividad">
            <Stamp color="green" icon="activity" size={38} />
            <span class="yf-sheet-rowtext"><span class="yf-sheet-rowtitle">Actividad</span></span>
            <Icon name="lucide:chevron-right" class="yf-sheet-chev" />
        </a>
        <a class="yf-sheet-row" href="/mislistas/year">
            <Stamp color="red" icon="bar-chart-3" size={38} />
            <span class="yf-sheet-rowtext"><span class="yf-sheet-rowtitle">Tu cine en números</span></span>
            <span class="yf-sheet-value">{currentYear}</span>
            <Icon name="lucide:chevron-right" class="yf-sheet-chev" />
        </a>

        <div class="yf-sheet-sep"></div>

        <a class="yf-sheet-row" href="/perfil">
            <Stamp color="slate" icon="settings" size={38} />
            <span class="yf-sheet-rowtext"><span class="yf-sheet-rowtitle">Ajustes</span></span>
            <Icon name="lucide:chevron-right" class="yf-sheet-chev" />
        </a>

        <div class="yf-sheet-sep"></div>

        {/* El tema se cambia AQUÍ mismo, sin salir de la hoja: es lo único de Ajustes que se
            toca a menudo y que se ve al instante. Persiste en el perfil, así que viaja de
            dispositivo (antes esta fila era un toggle binario que además no hacía nada). */}
        <div class="yf-sheet-row is-static">
            <span class="yf-sheet-rowtext"><span class="yf-sheet-rowtitle">Tema</span></span>
            <span class="yf-sheet-seg" id="yf-theme-seg" role="group" aria-label="Tema">
                {THEME_OPTIONS.map((o) => (
                    <label class="yf-sheet-segopt">
                        <input type="radio" name="yf-theme" value={o.value} checked={themeChoice === o.value} />
                        <span aria-hidden="true"><Icon name={`lucide:${o.icon}`} /></span>
                        <span class="sr-only">{o.label}</span>
                    </label>
                ))}
            </span>
        </div>

        <div class="yf-sheet-sep"></div>

        <button type="button" class="yf-sheet-foot" data-auth-logout>
            <Icon name="lucide:log-out" />
            Cerrar sesión
        </button>
    </BottomSheet>
)}

<style is:global>
    .yf-sheet-avatar {
        width: 38px; height: 38px; border-radius: 9999px; flex-shrink: 0; overflow: hidden;
        display: inline-flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, #93c5fd, #fbbf24); color: #fff;
        font-size: 13px; font-weight: 700;
    }
    .yf-sheet-avatar img { width: 100%; height: 100%; object-fit: cover; }
    /* En la cabecera de identidad manda más que una fila cualquiera: es tu cara. */
    .yf-sheet-head .yf-sheet-avatar { width: 46px; height: 46px; font-size: 16px; }
</style>

{user && (
    <script is:inline>
        (function () {
            // Contadores lazy: se piden la 1ª vez que se abre la hoja "Mis listas".
            var loaded = false;
            document.addEventListener('yf:sheet-open', function (e) {
                if (!e.detail || e.detail.id !== 'listas' || loaded) return;
                loaded = true;
                fetch('/api/lists/counts')
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (res) {
                        if (!res || !res.ok) { loaded = false; return; }   // reintentar al reabrir
                        var c = res.counts || {};
                        document.querySelectorAll('[data-count-key]').forEach(function (el) {
                            var k = el.getAttribute('data-count-key');
                            if (c[k] != null) el.textContent = String(c[k]);
                            else el.textContent = '';
                        });
                    })
                    .catch(function () { loaded = false; });
            });

            // Tema. Aplicar va por `window.yfApplyTheme` (Layout), que es quien resuelve
            // 'system' y escribe localStorage; aquí solo se persiste en el perfil para que
            // la elección viaje entre dispositivos.
            var seg = document.getElementById('yf-theme-seg');
            if (seg) {
                seg.addEventListener('change', function (e) {
                    var el = e.target;
                    if (!el || el.name !== 'yf-theme') return;
                    if (window.yfApplyTheme) window.yfApplyTheme(el.value);
                    fetch('/api/profile/preferences', {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ theme: el.value }),
                    }).catch(function () { /* el tema ya está aplicado en local */ });
                });
                // Si el tema cambia desde otro control (Ajustes, menú de escritorio), el
                // segmentado se pone al día sin recargar.
                document.addEventListener('yf:theme', function (e) {
                    var choice = e.detail && e.detail.choice;
                    if (!choice) return;
                    var hit = seg.querySelector('input[value="' + choice + '"]');
                    if (hit) hit.checked = true;
                });
            }
        })();
    </script>
)}
