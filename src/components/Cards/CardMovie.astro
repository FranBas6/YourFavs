---
/**
 * CardMovie — envoltorio de TitleCard (sistema v2, Fase 3) para no tocar sus usos de golpe: recibe
 * las mismas props de siempre y pinta la tarjeta nueva, sin caja. Ver Cards/TitleCard.astro.
 */
import TitleCard, { type CardDensity, type CardContext } from './TitleCard.astro';

interface Props {
    id: string;
    title: string;
    img: string;
    vote_average: number;
    overview: string;
    release_date?: string;
    genres?: { id: number, name: string }[];
    character?: string;
    /** Nota personal del usuario (0,5-10). */
    userRating?: number;
    /** 4.4 · "Porque viste X". */
    seedTitle?: string;
    /** F4 social: «Recomendada por Ana». Excluyente con `seedTitle` (gana esta). */
    recommendedBy?: { name: string; more: number };
    /** E2 · «Nuevo en streaming»: la plataforma TUYA donde está («Netflix»). */
    platform?: string;
    density?: CardDensity;
    context?: CardContext;
    favoriteNumber?: number;
}

const p = Astro.props;
---
<TitleCard
    mediaType="movie"
    id={p.id}
    title={p.title}
    img={p.img}
    vote_average={p.vote_average}
    overview={p.overview}
    date={p.release_date}
    genres={p.genres}
    character={p.character}
    userRating={p.userRating}
    seedTitle={p.seedTitle}
    recommendedBy={p.recommendedBy}
    platform={p.platform}
    density={p.density}
    context={p.context}
    favoriteNumber={p.favoriteNumber}
/>
