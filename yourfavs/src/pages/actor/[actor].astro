---
import Layout from "../../layouts/Layout.astro";
import {
    getMoviesAndSeriesByActorId,
    getActorDetailsById, fetchActorImages, fetchTaggedImages
} from "../../services/API/Actors/InfoActor";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import { getGenreName, genresMap } from "../../utils/constants/genres";
import { sortBycriterion } from "../../utils/sorting";
import { calculateAge } from "../../utils/constants/helpers/actor-helpers";
import { posterUrl } from "../../services/API/shared/tmdbClient";
import '../../styles/pages/actor/actor.css';
import { handleActorFavAction } from "../../services/BD/actors/yourfavsActor";
import type { ActorsFavs } from "../../services/BD/actors/yourfavsActor";
import type { ActorImage } from "../../services/API/Actors/InfoActor";
import { db } from "../../utils/firebaseConfig";
import { doc, getDoc, collection, getDocs } from "firebase/firestore";

const { actor } = Astro.params;

if (!actor) {
    throw new Error("ID del actor no encontrado en la URL");
}

// POST: gestionar favoritos
if (Astro.request.method === 'POST') {
    try {
        const url = await handleActorFavAction(await Astro.request.formData());
        return Astro.redirect(url);
    } catch (error) {
        console.error('Error al gestionar el actor:', error);
        return Astro.redirect(`/actor/${actor}`);
    }
}

// Fetch datos en paralelo: detalles + créditos (1 llamada) + imágenes + tagged + favorito
const [actorDetails, credits, profileImages, taggedImages, actorDocSnap, actorsFavsSnapshot] = await Promise.all([
    getActorDetailsById({ id: actor }),
    getMoviesAndSeriesByActorId({ id: actor }),
    fetchActorImages(actor).catch(() => []),
    fetchTaggedImages(actor).catch(() => []),
    getDoc(doc(db, 'ActorsFavs', actor)),
    getDocs(collection(db, 'ActorsFavs')),
]);

const actorInfo = actorDetails || {
    id: null, nombre: actor, biografia: null, lugarNacimiento: null,
    fechaNacimiento: null, fechaFallecimiento: null, imagen: null,
    popularidad: null, conocidoPor: "Actuación", genero: null,
    alias: [], homepage: null,
    redes: { imdb: null, twitter: null, instagram: null, facebook: null, tiktok: null, youtube: null },
};

const { movies, series } = credits;
const totalProductions = movies.length + series.length;
const age = calculateAge(actorInfo.fechaNacimiento);
const posters: ActorImage[] = profileImages.slice(0, 25);

// Top géneros
const genreCounts: Record<number, number> = movies.flatMap(m => m.genre_ids || [])
    .reduce((acc: Record<number, number>, gId: number) => { acc[gId] = (acc[gId] || 0) + 1; return acc; }, {});
const topGenres = Object.entries(genreCounts)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5)
    .map(([gId]) => genresMap[parseInt(gId)]);

// Favoritos
const isInFavorites = actorDocSnap.exists();
const currentPosition = isInFavorites ? (actorDocSnap.data() as ActorsFavs).position : null;
const totalActorsFavorites = actorsFavsSnapshot.size;

// Ordenación
const sortBy = Astro.url.searchParams.get('sort') || 'popularity';
const moviesSorted = sortBycriterion(movies, sortBy, 'release_date');
const seriesSorted = sortBycriterion(series, sortBy, 'first_air_date');

const hasSocial = actorInfo.redes && Object.values(actorInfo.redes).some(v => v);

// Stats calculadas de la filmografía
const allProductions = [...movies, ...series];
const ratedProductions = allProductions.filter((p: any) => p.vote_average > 0);
const avgRating = ratedProductions.length > 0
    ? ratedProductions.reduce((sum: number, p: any) => sum + p.vote_average, 0) / ratedProductions.length
    : null;

const bestMovie = movies.length > 0
    ? movies.reduce((best: any, m: any) => (m.vote_average > best.vote_average ? m : best))
    : null;

const movieDates = movies.map((m: any) => m.release_date).filter(Boolean).map((d: string) => new Date(d).getFullYear());
const seriesDates = series.map((s: any) => s.first_air_date).filter(Boolean).map((d: string) => new Date(d).getFullYear());
const allYears = [...movieDates, ...seriesDates].filter(y => y > 1900);
const careerStart = allYears.length > 0 ? Math.min(...allYears) : null;
const careerEnd = allYears.length > 0 ? Math.max(...allYears) : null;
const careerYears = careerStart && careerEnd ? careerEnd - careerStart : null;
---
<Layout title={`${actorInfo.nombre}`}>
    <section class="px-1 sm:py-8">
        <!-- Header -->
        <header class="mb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-1">{actorInfo.nombre}</h1>
            <p class="text-gray-500 text-base">
                {actorInfo.conocidoPor || 'Actor/Actriz'} · {totalProductions} producciones
            </p>
        </header>

        <!-- Info card -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 mb-6">
            <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5">
                {actorInfo.imagen ? (
                    <img
                        src={posterUrl(actorInfo.imagen, 'w185')}
                        alt={actorInfo.nombre}
                        class="w-28 h-28 rounded-full object-cover border-2 border-gray-200 flex-shrink-0"
                        loading="lazy"
                    />
                ) : (
                    <div class="w-28 h-28 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0 border-2 border-gray-200">
                        <svg class="w-12 h-12 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                )}
                <div class="flex-1 text-center sm:text-left">
                    <!-- Pills de info -->
                    <div class="flex flex-wrap justify-center sm:justify-start gap-1.5 text-xs sm:text-sm mb-3">
                        {age && (
                            <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded-full">
                                {actorInfo.fechaFallecimiento ? `Falleció a los ${age} años` : `${age} años`}
                            </span>
                        )}
                        {actorInfo.lugarNacimiento && (
                            <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded-full">{actorInfo.lugarNacimiento}</span>
                        )}
                        {actorInfo.fechaNacimiento && (
                            <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded-full">
                                {new Date(actorInfo.fechaNacimiento).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
                            </span>
                        )}
                        {actorInfo.fechaFallecimiento && (
                            <span class="px-2 py-0.5 bg-gray-800 text-white rounded-full">
                                † {new Date(actorInfo.fechaFallecimiento).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
                            </span>
                        )}
                        <span class="px-2 py-0.5 bg-red-50 text-red-600 rounded-full">{movies.length} películas</span>
                        <span class="px-2 py-0.5 bg-blue-50 text-blue-600 rounded-full">{series.length} series</span>
                        {actorInfo.popularidad && (
                            <span class="px-2 py-0.5 bg-yellow-50 text-yellow-700 rounded-full">Pop. {actorInfo.popularidad.toFixed(0)}</span>
                        )}
                        {avgRating && (
                            <span class="px-2 py-0.5 bg-orange-50 text-orange-700 rounded-full">Nota media {avgRating.toFixed(1)}</span>
                        )}
                        {careerStart && careerEnd && (
                            <span class="px-2 py-0.5 bg-green-50 text-green-700 rounded-full">
                                {careerStart === careerEnd ? careerStart : `${careerStart} - ${careerEnd}`}{careerYears ? ` · ${careerYears} años` : ''}
                            </span>
                        )}
                    </div>

                    <!-- Mejor película -->
                    {bestMovie && (
                        <div class="flex items-center gap-2 mb-3">
                            <span class="text-xs sm:text-sm text-gray-400">Mejor valorada:</span>
                            <a href={`/movie/${bestMovie.id}`} class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-gray-700 bg-gray-50 border border-gray-200 rounded-lg px-2 py-1 hover:bg-gray-100 transition-colors">
                                {bestMovie.poster_path && (
                                    <img src={posterUrl(bestMovie.poster_path, 'w92')} alt="" class="w-5 h-7 rounded object-cover" />
                                )}
                                <span class="truncate max-w-[200px]">{bestMovie.title}</span>
                                <span class="text-yellow-600 font-semibold">{bestMovie.vote_average.toFixed(1)}</span>
                            </a>
                        </div>
                    )}

                    <!-- Top géneros -->
                    {topGenres.length > 0 && (
                        <div class="flex flex-wrap justify-center sm:justify-start gap-1 text-xs sm:text-sm mb-3">
                            {topGenres.map(genre => (
                                <span class="px-2 py-0.5 bg-purple-50 text-purple-600 rounded-full">{genre}</span>
                            ))}
                        </div>
                    )}

                    <!-- Redes sociales -->
                    {hasSocial && (
                        <div class="flex flex-wrap justify-center sm:justify-start gap-2 mb-3">
                            {actorInfo.redes.imdb && (
                                <a href={actorInfo.redes.imdb} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-yellow-50 text-yellow-800 rounded-lg hover:bg-yellow-100 transition-colors">IMDb</a>
                            )}
                            {actorInfo.redes.instagram && (
                                <a href={actorInfo.redes.instagram} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-pink-50 text-pink-700 rounded-lg hover:bg-pink-100 transition-colors">Instagram</a>
                            )}
                            {actorInfo.redes.twitter && (
                                <a href={actorInfo.redes.twitter} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-sky-50 text-sky-700 rounded-lg hover:bg-sky-100 transition-colors">Twitter</a>
                            )}
                            {actorInfo.redes.facebook && (
                                <a href={actorInfo.redes.facebook} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100 transition-colors">Facebook</a>
                            )}
                            {actorInfo.redes.tiktok && (
                                <a href={actorInfo.redes.tiktok} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors">TikTok</a>
                            )}
                            {actorInfo.redes.youtube && (
                                <a href={actorInfo.redes.youtube} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-red-50 text-red-700 rounded-lg hover:bg-red-100 transition-colors">YouTube</a>
                            )}
                            {actorInfo.homepage && (
                                <a href={actorInfo.homepage} target="_blank" rel="noopener noreferrer"
                                   class="px-2.5 py-1 text-xs sm:text-sm font-medium bg-green-50 text-green-700 rounded-lg hover:bg-green-100 transition-colors">Web</a>
                            )}
                        </div>
                    )}

                    <!-- Alias -->
                    {actorInfo.alias && actorInfo.alias.length > 0 && (
                        <details class="text-xs mb-3">
                            <summary class="cursor-pointer text-gray-400 hover:text-gray-600">
                                También conocido como ({actorInfo.alias.length})
                            </summary>
                            <div class="flex flex-wrap gap-1 mt-1.5">
                                {actorInfo.alias.map((a: string) => (
                                    <span class="px-2 py-0.5 bg-gray-50 text-gray-500 rounded-full">{a}</span>
                                ))}
                            </div>
                        </details>
                    )}

                    <!-- Biografía -->
                    {actorInfo.biografia && (
                        <details class="text-sm">
                            <summary class="cursor-pointer text-gray-500 hover:text-gray-700 font-medium">
                                Biografía
                            </summary>
                            <p class="mt-2 text-gray-600 leading-relaxed whitespace-pre-line">{actorInfo.biografia}</p>
                        </details>
                    )}
                </div>
            </div>
        </div>

        <!-- Favoritos -->
        <div class="bg-white rounded-xl border border-gray-200 p-4 mb-6">
            {!isInFavorites ? (
                <form method="POST" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
                    <input type="hidden" name="actor_id" value={actor} />
                    <input type="hidden" name="action" value="add" />
                    <input
                        type="number"
                        name="custom_position"
                        min="1"
                        placeholder={`Posición (1-${totalActorsFavorites + 1})`}
                        class="px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-gray-400"
                    />
                    <button type="submit"
                        class="px-4 py-2 text-sm font-medium text-white bg-gray-900 rounded-lg hover:bg-gray-800 transition-colors">
                        Añadir a favoritos
                    </button>
                </form>
            ) : (
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
                    <span class="text-sm font-medium text-gray-600">Favorito #{currentPosition}</span>
                    <form method="POST" class="flex items-center gap-2 flex-1 sm:flex-none">
                        <input type="hidden" name="actor_id" value={actor} />
                        <input type="hidden" name="action" value="update" />
                        <input
                            type="number"
                            name="custom_position"
                            min="1"
                            max={totalActorsFavorites}
                            value={currentPosition}
                            required
                            class="w-20 px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-gray-400"
                        />
                        <button type="submit"
                            class="px-4 py-2 text-sm font-medium text-white bg-gray-900 rounded-lg hover:bg-gray-800 transition-colors">
                            Mover
                        </button>
                    </form>
                    <form method="POST" class="sm:ml-auto">
                        <input type="hidden" name="actor_id" value={actor} />
                        <input type="hidden" name="action" value="remove" />
                        <button type="submit"
                            class="w-full sm:w-auto px-3 py-2 text-sm font-medium text-red-600 bg-red-50 border border-red-200 rounded-lg hover:bg-red-100 transition-colors">
                            Quitar de favoritos
                        </button>
                    </form>
                </div>
            )}
        </div>

        <!-- Galería -->
        {posters.length > 0 && (
            <details class="bg-white rounded-xl border border-gray-200 mb-6">
                <summary class="p-4 cursor-pointer text-sm font-semibold text-gray-700 hover:text-gray-900 flex items-center justify-between">
                    <span>Galería ({posters.length} imágenes)</span>
                    <svg class="w-5 h-5 text-gray-400 transition-transform [details[open]>&]:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                    </svg>
                </summary>
                <div class="px-4 pb-4 grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-2">
                    {posters.map((poster, index) => (
                        <a href={`#img-${index}`} class="block rounded-lg overflow-hidden hover:opacity-80 transition-opacity">
                            <img src={poster.file_path} alt={`${actorInfo.nombre} - Imagen ${index + 1}`} loading="lazy" class="w-full aspect-[2/3] object-cover" />
                        </a>
                    ))}
                </div>
            </details>
        )}

        <!-- Lightbox modales (CSS :target) -->
        {posters.map((poster, index) => (
            <div id={`img-${index}`} class="lightbox fixed inset-0 z-50 items-center justify-center bg-black/80 p-4">
                <a href="#_" class="absolute inset-0" aria-label="Cerrar"></a>
                <img src={poster.file_path} alt={`${actorInfo.nombre} - Imagen ${index + 1}`}
                     class="relative max-h-[90vh] max-w-[90vw] object-contain rounded-lg shadow-2xl" />
                <a href="#_" class="absolute top-4 right-4 text-white/80 hover:text-white text-3xl font-light leading-none z-10" aria-label="Cerrar">&times;</a>
                {index > 0 && (
                    <a href={`#img-${index - 1}`} class="absolute left-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10" aria-label="Anterior">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    </a>
                )}
                {index < posters.length - 1 && (
                    <a href={`#img-${index + 1}`} class="absolute right-14 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10" aria-label="Siguiente">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </a>
                )}
            </div>
        ))}

        <!-- Tagged images (fotos en películas/eventos) -->
        {taggedImages.length > 0 && (
            <details class="bg-white rounded-xl border border-gray-200 mb-6">
                <summary class="p-4 cursor-pointer text-sm font-semibold text-gray-700 hover:text-gray-900 flex items-center justify-between">
                    <span>En películas y eventos ({taggedImages.length})</span>
                    <svg class="w-5 h-5 text-gray-400 transition-transform [details[open]>&]:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                    </svg>
                </summary>
                <div class="px-4 pb-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">
                    {taggedImages.map((img, index) => (
                        <a href={`#tagged-${index}`} class="block rounded-lg overflow-hidden hover:opacity-80 transition-opacity relative group">
                            <img src={img.file_path} alt={img.media?.title || img.media?.name || `Imagen ${index + 1}`} loading="lazy" class="w-full aspect-video object-cover" />
                            {img.media && (img.media.title || img.media.name) && (
                                <span class="absolute bottom-0 left-0 right-0 px-2 py-1 text-[10px] text-white bg-black/60 truncate">
                                    {img.media.title || img.media.name}
                                </span>
                            )}
                        </a>
                    ))}
                </div>
            </details>
        )}

        <!-- Lightbox tagged images -->
        {taggedImages.map((img, index) => (
            <div id={`tagged-${index}`} class="lightbox fixed inset-0 z-50 items-center justify-center bg-black/80 p-4">
                <a href="#_" class="absolute inset-0" aria-label="Cerrar"></a>
                <img src={img.file_path} alt={img.media?.title || img.media?.name || ''}
                     class="relative max-h-[90vh] max-w-[90vw] object-contain rounded-lg shadow-2xl" />
                <a href="#_" class="absolute top-4 right-4 text-white/80 hover:text-white text-3xl font-light leading-none z-10" aria-label="Cerrar">&times;</a>
                {index > 0 && (
                    <a href={`#tagged-${index - 1}`} class="absolute left-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10" aria-label="Anterior">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    </a>
                )}
                {index < taggedImages.length - 1 && (
                    <a href={`#tagged-${index + 1}`} class="absolute right-14 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10" aria-label="Siguiente">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </a>
                )}
            </div>
        ))}

        <!-- Navegación rápida -->
        <div class="flex flex-wrap gap-2 mb-4">
            {movies.length > 0 && (
                <a href="#peliculas" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-red-600 bg-red-50 border border-red-200 rounded-lg hover:bg-red-100 transition-colors">
                    <span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span>
                    Películas ({movies.length})
                </a>
            )}
            {series.length > 0 && (
                <a href="#series" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-blue-600 bg-blue-50 border border-blue-200 rounded-lg hover:bg-blue-100 transition-colors">
                    <span class="w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
                    Series ({series.length})
                </a>
            )}
        </div>

        <!-- Ordenación -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
            <h2 class="text-lg font-semibold text-gray-800">Filmografía ({totalProductions})</h2>
            <div class="inline-flex gap-1 bg-gray-100 rounded-xl p-1">
                <a href="?sort=quality"
                   class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all ${sortBy === 'quality' ? 'bg-gray-900 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900 hover:bg-white'}`}>
                    Mejor Valoradas
                </a>
                <a href="?sort=popularity"
                   class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all ${sortBy === 'popularity' ? 'bg-gray-900 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900 hover:bg-white'}`}>
                    Más Populares
                </a>
                <a href="?sort=date"
                   class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all ${sortBy === 'date' ? 'bg-gray-900 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900 hover:bg-white'}`}>
                    Más Recientes
                </a>
            </div>
        </div>

        <div class="space-y-10">
            <!-- Películas -->
            <section id="peliculas" class="scroll-mt-20">
                <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-red-500 rounded-full"></span>
                    Películas
                    <span class="text-sm font-normal text-gray-400">({movies.length})</span>
                </h3>

                {movies.length === 0 && (
                    <div class="bg-gray-50 border border-gray-100 rounded-xl p-8 text-center">
                        <p class="text-gray-400">No se encontraron películas</p>
                    </div>
                )}
                {movies.length > 0 && (
                    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                        {moviesSorted.map((item) => (
                            <CardMovie
                                id={item.id.toString()}
                                img={item.poster_path ? posterUrl(item.poster_path) : "/placeholder.jpg"}
                                title={item.title}
                                vote_average={item.vote_average}
                                overview={item.overview}
                                release_date={item.release_date}
                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                character={item.character}
                            />
                        ))}
                    </div>
                )}
            </section>

            <!-- Series -->
            <section id="series" class="scroll-mt-20">
                <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-blue-500 rounded-full"></span>
                    Series
                    <span class="text-sm font-normal text-gray-400">({series.length})</span>
                </h3>

                {series.length === 0 && (
                    <div class="bg-gray-50 border border-gray-100 rounded-xl p-8 text-center">
                        <p class="text-gray-400">No se encontraron series</p>
                    </div>
                )}
                {series.length > 0 && (
                    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                        {seriesSorted.map((item) => (
                            <CardSerie
                                id={item.id.toString()}
                                img={item.poster_path ? posterUrl(item.poster_path) : "/placeholder.jpg"}
                                name={item.name}
                                vote_average={item.vote_average}
                                overview={item.overview}
                                first_air_date={item.first_air_date}
                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                character={item.character}
                            />
                        ))}
                    </div>
                )}
            </section>
        </div>
    </section>
</Layout>
