---
/**
 * Hoja inferior reutilizable (Tab bar móvil). Sube por ENCIMA del tab bar, que
 * queda visible y clicable debajo (el overlay no llega a tapar la barra).
 *
 * Se abre/cierra por evento global:
 *   document.dispatchEvent(new CustomEvent('yf:sheet-open', { detail: { id } }))
 *   document.dispatchEvent(new CustomEvent('yf:sheet-close'))
 * Re-emitir 'yf:sheet-open' con el mismo id la cierra (toggle del tab).
 * Cierra también con: tap en overlay, swipe abajo (asa/título), Esc.
 *
 * El contenido (filas) entra por <slot/>. El controlador es único (guardado por
 * window.__yfSheetCtrl), aunque el componente se monte varias veces.
 */
interface Props {
    id: string;
    title: string;
    /**
     * Oculta el epígrafe visible (el `aria-label` se mantiene). Para hojas cuyo contenido ya
     * dice qué son —la de perfil abre con tu nombre y tu correo—, repetirlo arriba sobra.
     * El swipe-para-cerrar no se pierde: el asa sigue siendo zona de arrastre.
     */
    hideTitle?: boolean;
}
const { id, title, hideTitle = false } = Astro.props;
---
<div class="yf-sheet-root" data-sheet={id} hidden>
    <div class="yf-sheet-overlay" data-sheet-overlay></div>
    <div class="yf-sheet" role="dialog" aria-modal="true" aria-label={title} tabindex="-1">
        <div class="yf-sheet-handle" aria-hidden="true"></div>
        {!hideTitle && <div class="yf-sheet-title">{title}</div>}
        <div class="yf-sheet-body"><slot /></div>
    </div>
</div>

<style is:global>
    .yf-sheet-root[hidden] { display: none; }
    /* Sólo móvil: en desktop nada lo abre, pero blindamos por si acaso. */
    @media (min-width: 1024px) { .yf-sheet-root { display: none !important; } }

    .yf-sheet-overlay {
        position: fixed; left: 0; right: 0; top: 0;
        bottom: calc(58px + env(safe-area-inset-bottom, 0px)); /* deja libre el tab bar */
        background: rgba(15, 23, 42, .45);
        -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px);
        opacity: 0; transition: opacity .25s ease; z-index: 1100;
    }
    .yf-sheet {
        position: fixed; left: 0; right: 0;
        bottom: calc(58px + env(safe-area-inset-bottom, 0px)); /* docked encima del tab bar */
        z-index: 1150;
        background: var(--bg-elev, #fff);
        border-radius: 18px 18px 0 0;
        box-shadow: 0 -12px 40px rgba(0, 0, 0, .22);
        max-height: 70vh; overflow-y: auto; padding-bottom: 10px;
        transform: translateY(110%);
        transition: transform .3s cubic-bezier(.16, 1, .3, 1);
        will-change: transform;
    }
    .yf-sheet-root.is-open .yf-sheet-overlay { opacity: 1; }
    .yf-sheet-root.is-open .yf-sheet { transform: translateY(0); }

    .yf-sheet-handle { width: 38px; height: 4px; border-radius: 9px; background: var(--border, #e2dccd); margin: 10px auto 4px; }
    .yf-sheet-title {
        font-family: var(--font-mono, monospace); font-size: 10px; letter-spacing: .13em;
        text-transform: uppercase; color: var(--text-3, #9a9082); padding: 6px 18px 8px;
    }
    .yf-sheet-body { padding: 0 0 4px; }

    /* Filas (las pinta el contenido del slot) */
    .yf-sheet-row {
        display: flex; align-items: center; gap: 13px; width: 100%;
        padding: 11px 18px; text-decoration: none; border: none; background: none;
        cursor: pointer; font: inherit; text-align: left; color: var(--text, #16130f);
    }
    .yf-sheet-row + .yf-sheet-row { border-top: 1px solid var(--border, #f3efe6); }
    .yf-sheet-row:hover { background: var(--bg-tint, #f6f3ec); }
    .yf-sheet-rowtext { flex: 1; min-width: 0; }
    .yf-sheet-rowtitle { font-size: 14px; font-weight: 600; line-height: 1.2; color: var(--text, #16130f); }
    .yf-sheet-rowsub { font-size: 11.5px; color: var(--text-3, #9a9082); margin-top: 1px; font-variant-numeric: tabular-nums; }
    .yf-sheet-row.is-danger .yf-sheet-rowtitle { color: #E63946; }

    /* Valor a la derecha (p.ej. el año en "Tu cine en números") + chevrón de navegación.
       Mismo idioma que las filas del índice de Ajustes (`.aj-index-row-value`). */
    .yf-sheet-value {
        font-size: 12.5px; color: var(--text-3, #9a9082); flex-shrink: 0;
        font-variant-numeric: tabular-nums;
    }
    .yf-sheet-chev { width: 16px; height: 16px; color: var(--text-4, #b8b0a4); flex-shrink: 0; }

    /* Contador de no leídas. Lo rellena el script de la campana (Header) por `.js-notif-badge`. */
    .yf-sheet-badge {
        min-width: 22px; height: 22px; padding: 0 7px; border-radius: 9999px; flex-shrink: 0;
        /* --accent-dark: blanco sobre --accent no pasa AA a este tamaño (handoff social §6.4). */
        background: var(--accent-dark); color: #fff;
        font-family: var(--font-mono, monospace); font-size: 11px; font-weight: 700;
        display: flex; align-items: center; justify-content: center;
    }
    .yf-sheet-badge[hidden] { display: none; }
    /* Fila con algo que responder (Amigos con solicitudes, F3). */
    .yf-sheet-row.has-pending { background: var(--bg-tint); }

    /* Banda separadora entre grupos de filas. Al no ser `.yf-sheet-row`, corta la cadena
       del selector hermano y aporta ella misma sus dos líneas. */
    .yf-sheet-sep {
        height: 8px; background: var(--bg-tint, #f6f3ec);
        border-top: 1px solid var(--border, #f3efe6);
        border-bottom: 1px solid var(--border, #f3efe6);
    }

    /* Cabecera de identidad (avatar + nombre/correo + enlace a la ficha de perfil). */
    .yf-sheet-head {
        display: flex; align-items: center; gap: 13px;
        padding: 6px 18px 14px;
        border-bottom: 1px solid var(--border, #f3efe6);
    }
    .yf-sheet-headtext { flex: 1; min-width: 0; }
    .yf-sheet-headname {
        display: block; font-size: 16px; font-weight: 700; line-height: 1.25;
        color: var(--text, #16130f);
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .yf-sheet-headmail {
        display: block; font-size: 12.5px; color: var(--text-3, #9a9082); margin-top: 1px;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .yf-sheet-headlink {
        display: inline-flex; align-items: center; gap: 2px; flex-shrink: 0;
        font-size: 13.5px; font-weight: 600; color: var(--accent, #E63946); text-decoration: none;
    }
    .yf-sheet-headlink svg { width: 15px; height: 15px; }

    /* Fila sin destino (solo alberga un control): ni cursor de mano ni hover. */
    .yf-sheet-row.is-static { cursor: default; }
    .yf-sheet-row.is-static:hover { background: none; }

    /* Segmentado de tema: 3 opciones sobre un raíl. Radios reales (grupo navegable con
       flechas y anunciable), con el input oculto y la pastilla pintada por `:checked`. */
    .yf-sheet-seg {
        display: inline-flex; gap: 2px; flex-shrink: 0;
        background: var(--bg-tint, #f6f3ec); border: 1px solid var(--border, #f3efe6);
        border-radius: 9999px; padding: 3px;
    }
    .yf-sheet-segopt { position: relative; display: inline-flex; cursor: pointer; }
    .yf-sheet-segopt input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
    .yf-sheet-segopt > span {
        display: grid; place-items: center; width: 42px; height: 28px;
        border-radius: 9999px; color: var(--text-3, #9a9082);
        transition: background-color .16s ease, color .16s ease;
    }
    .yf-sheet-segopt > span svg { width: 16px; height: 16px; }
    .yf-sheet-segopt input:checked + span {
        background: var(--bg-elev, #fff); color: var(--accent, #E63946);
        box-shadow: 0 1px 3px rgba(15, 23, 42, .12);
    }
    .yf-sheet-segopt input:focus-visible + span { box-shadow: 0 0 0 3px var(--accent-soft, rgba(230, 57, 70, .18)); }

    /* Cerrar sesión: centrado y separado del resto, porque no es navegación. */
    .yf-sheet-foot {
        display: flex; align-items: center; justify-content: center; gap: 8px;
        width: 100%; padding: 14px 18px; border: none; background: none;
        cursor: pointer; font: inherit; font-size: 14px; font-weight: 600;
        color: var(--accent, #E63946);
    }
    .yf-sheet-foot svg { width: 17px; height: 17px; }

    @media (prefers-reduced-motion: reduce) {
        .yf-sheet, .yf-sheet-overlay { transition: none; }
        .yf-sheet-segopt > span { transition: none; }
    }
</style>

<script is:inline>
    (function () {
        if (window.__yfSheetCtrl) return;
        window.__yfSheetCtrl = 1;

        var openId = null;
        function root(id) { return document.querySelector('.yf-sheet-root[data-sheet="' + id + '"]'); }
        function focusables(r) { return r.querySelectorAll('a[href],button:not([disabled]),[tabindex]:not([tabindex="-1"])'); }

        function open(id) {
            if (!id) return;
            if (openId === id) { close(); return; }            // re-tap del mismo tab → cerrar
            if (openId) { var p = root(openId); if (p) { p.classList.remove('is-open'); p.hidden = true; } }
            var r = root(id); if (!r) return;
            r.hidden = false; void r.offsetWidth; r.classList.add('is-open');
            openId = id; document.body.style.overflow = 'hidden';
            var sh = r.querySelector('.yf-sheet'); if (sh) sh.focus();
        }
        function close() {
            if (!openId) return;
            var r = root(openId); var id = openId; openId = null;
            document.body.style.overflow = '';
            if (!r) return;
            r.classList.remove('is-open');
            var sh = r.querySelector('.yf-sheet');
            var done = function () { if (openId !== id) r.hidden = true; if (sh) sh.removeEventListener('transitionend', done); };
            if (sh) { sh.addEventListener('transitionend', done); setTimeout(done, 360); } else { r.hidden = true; }
        }

        document.addEventListener('yf:sheet-open', function (e) { open(e.detail && e.detail.id); });
        document.addEventListener('yf:sheet-close', close);
        document.addEventListener('yf:open-palette', function () { if (openId) close(); });

        document.addEventListener('click', function (e) {
            if (openId && e.target.closest('.yf-sheet-overlay')) close();
        });
        document.addEventListener('keydown', function (e) {
            if (!openId) return;
            if (e.key === 'Escape') { close(); return; }
            if (e.key === 'Tab') {
                var r = root(openId); if (!r) return;
                var f = focusables(r); if (!f.length) return;
                var first = f[0], last = f[f.length - 1];
                if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
                else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
            }
        });

        // Swipe abajo (asa o título) para cerrar.
        var sY = 0, dY = 0, drag = false, curSheet = null;
        document.addEventListener('touchstart', function (e) {
            if (!openId || e.touches.length !== 1) return;
            var t = e.target;
            if (!t.closest('.yf-sheet-handle') && !t.closest('.yf-sheet-title')) return;
            var r = root(openId); curSheet = r && r.querySelector('.yf-sheet'); if (!curSheet) return;
            drag = true; dY = 0; sY = e.touches[0].clientY; curSheet.style.transition = 'none';
        }, { passive: true });
        document.addEventListener('touchmove', function (e) {
            if (!drag || !curSheet) return;
            dY = Math.max(0, e.touches[0].clientY - sY);
            curSheet.style.transform = 'translateY(' + dY + 'px)';
        }, { passive: true });
        function endDrag() {
            if (!drag || !curSheet) return; drag = false;
            curSheet.style.transition = ''; curSheet.style.transform = '';
            if (dY > 90) close();
            curSheet = null;
        }
        document.addEventListener('touchend', endDrag, { passive: true });
        document.addEventListener('touchcancel', endDrag, { passive: true });
    })();
</script>
