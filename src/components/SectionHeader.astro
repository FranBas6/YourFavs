---
// Cabecera de sección del sistema v2 (docs/design_handoff_rediseno, README §3.5). Una sola en toda
// la web, en dos tamaños: `size="page"` (sección de página: stamp 36 + título --fs-sec) y
// `size="sub"` (subsección: stamp 28 + --fs-sub). Título en --text (el azul queda para los enlaces),
// contador mono al lado, criterio como chip de etiqueta y «Ver más · n ›» a la derecha. Móvil: una
// línea (stamp 32/26, título --fs-body/--fs-ui), sin contador ni criterio. Sin tag «Destacado» ni
// línea inferior.
import Stamp from './Stamp.astro';

interface Props {
    title: string;
    link?: string;
    count?: number;       // nº total de títulos de la sección
    /** @deprecated El tag «Destacado» se retiró en el sistema v2; se acepta y se ignora. */
    featured?: boolean;
    /** Sección de página (por defecto) o subsección. */
    size?: 'page' | 'sub';
    color?: 'red' | 'amber' | 'blue' | 'green' | 'purple' | 'pink' | 'slate';
    icon: string;         // icono Lucide del stamp
    /** Una línea de qué promete la fila, bajo el título. */
    subtitle?: string;
    /**
     * El CRITERIO de la fila, en un chip junto al título («1 temporada», «status = Ended»,
     * «runtime ≤ 90»). No es decoración: es lo que separa una fila con criterio de "una selección
     * más", y hace que el usuario pueda comprobar por qué está viendo esto.
     */
    why?: string;
    /**
     * Tope de la fila en texto («Top 10», «Últimos 12»). Sustituye a `count`: en el perfil público
     * cada sección anuncia hasta dónde llega, porque no tiene «Ver todo».
     */
    cap?: string;
    /** Marca «Solo lo ves tú» a la derecha (vacíos del perfil público que solo ve su dueño). */
    onlyOwner?: boolean;
    /** `id` del `<h2>`, para que su `<section aria-labelledby>` lo nombre por el título. */
    headingId?: string;
    /** id de un <Row> que va debajo: pinta sus flechas (solo escritorio). */
    railId?: string;
}
const { title, link, count, size = 'page', color = 'slate', icon, subtitle, why, cap, onlyOwner = false, headingId, railId } = Astro.props;
const countLabel = cap
    ? cap
    : count != null && count > 0
        ? `${count} ${count === 1 ? 'título' : 'títulos'}`
        : null;
---
<header class:list={["yf-section-header", size === 'sub' && "is-sub"]}>
    <div class="yf-sh-left">
        <Stamp color={color} icon={icon} />
        <div class="yf-sh-titlewrap">
            <h2 class="yf-sh-title" id={headingId}>{title}{countLabel && <span class="yf-sh-count">{countLabel}</span>}</h2>
            {subtitle && <p class="yf-sh-sub">{subtitle}</p>}
        </div>
        {why && <span class="chip-tag yf-sh-why">{why}</span>}
    </div>
    {onlyOwner && (
        <span class="pf-only">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.53 13.53 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><path d="m2 2 20 20"/></svg>
            Solo lo ves tú
        </span>
    )}
    {(railId || link) && (
    <div class="yf-sh-right">
    {railId && (
        <span class="yf-sh-arrows">
            <button type="button" class="btn btn--sm btn--icon" data-rail-prev={railId} aria-controls={railId} aria-label={`Anteriores: ${title}`} disabled>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button type="button" class="btn btn--sm btn--icon" data-rail-next={railId} aria-controls={railId} aria-label={`Siguientes: ${title}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>
        </span>
    )}
    {link && (
        <a href={link} class="yf-sh-more" aria-label={`Ver más: ${title}`}>
            <span>Ver más</span>{count != null && count > 0 && <span class="yf-sh-more-n">· {count}</span>}
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
            </svg>
        </a>
    )}
    </div>
    )}
</header>

<style>
    .yf-section-header {
        display: flex; align-items: center; justify-content: space-between;
        gap: var(--s-4); flex-wrap: wrap; margin-bottom: var(--s-5);
    }
    .yf-sh-left { display: flex; align-items: center; gap: var(--s-3); flex-wrap: wrap; min-width: 0; }
    /* El tamaño del sello va por CSS (no por la prop de Stamp, que es estilo en línea y no se podría
       cambiar en móvil). */
    .yf-sh-left :global(.yf-stamp) { --st-size: 36px; }
    .is-sub .yf-sh-left :global(.yf-stamp) { --st-size: 28px; }
    .yf-sh-titlewrap { min-width: 0; }
    .yf-sh-title {
        margin: 0; font: 700 var(--fs-sec)/1.15 var(--font); letter-spacing: -0.02em; color: var(--text);
    }
    .is-sub .yf-sh-title { font-weight: 600; font-size: var(--fs-sub); letter-spacing: -0.01em; }
    .yf-sh-count {
        font: 500 var(--fs-meta) var(--font-mono); color: var(--text-3);
        letter-spacing: 0; margin-left: var(--s-2); white-space: nowrap;
    }
    .yf-sh-sub { margin: 3px 0 0; font-size: var(--fs-meta); line-height: 1.4; color: var(--text-3); }
    .yf-sh-right { display: flex; align-items: center; gap: var(--s-3); flex-shrink: 0; }
    .yf-sh-arrows { display: inline-flex; gap: var(--s-1); }
    @media (max-width: 1023.98px) { .yf-sh-arrows { display: none; } }
    .yf-sh-more {
        display: inline-flex; align-items: center; gap: 4px; flex-shrink: 0;
        min-height: 32px; font: 600 var(--fs-ui) var(--font); color: var(--primary);
        text-decoration: none; white-space: nowrap;
    }
    .yf-sh-more-n { font: 500 var(--fs-meta) var(--font-mono); color: var(--text-3); }
    .yf-sh-more svg { width: 14px; height: 14px; transition: transform .15s ease; }
    .yf-sh-more:hover { text-decoration: underline; text-underline-offset: 3px; }
    .yf-sh-more:hover svg { transform: translateX(2px); }
    .yf-sh-more:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; border-radius: var(--r-sm); }

    /* Móvil: una sola línea compacta; el contador y el criterio se caen, el subtítulo se queda. */
    @media (max-width: 640px) {
        .yf-section-header { gap: var(--s-2); flex-wrap: nowrap; margin-bottom: var(--s-4); }
        .yf-sh-left { gap: 10px; flex-wrap: nowrap; }
        .yf-sh-left :global(.yf-stamp) { --st-size: 32px; }
        .is-sub .yf-sh-left :global(.yf-stamp) { --st-size: 26px; }
        .yf-sh-title { font-size: var(--fs-body); line-height: 1.2; min-width: 0; }
        .is-sub .yf-sh-title { font-size: var(--fs-ui); }
        .yf-sh-count, .yf-sh-why, .yf-sh-more-n { display: none; }
        .yf-sh-sub { font-size: var(--fs-meta); margin-top: 2px; white-space: normal; }
        .yf-sh-more { min-height: 44px; }
    }
</style>
