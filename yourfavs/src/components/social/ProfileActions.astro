---
/**
 * Botones de la cabecera del perfil público según la relación con quien mira (handoff perfil
 * público §7 y social F2/F3 §6.1).
 *
 * Seguir y amistad son DOS botones independientes: seguir es libre y en un sentido; la amistad va
 * por solicitud. Cada botón solo se pinta si su fase está encendida en `SOCIAL_PHASE`.
 *
 * Con sesión, el marcado sale de `lib/social/ui.ts` (`profileActionsHtml`), el mismo que repinta
 * `scripts/social/relations.ts` tras cada acción con la relación que devuelve el servidor. El
 * invitado ve los botones aquí, pero le abren «Crear cuenta» (`data-auth-open`).
 *
 * `locked`: perfil «Solo amigos» visto por quien no es su amigo (D4): «Añadir amigo» pasa delante.
 * `force` enciende todas las fases: solo para la página de prueba (`/dev/perfil-acciones`).
 */
import { Icon } from 'astro-icon/components';
import { SOCIAL_PHASE } from '../../utils/constants/social';
import { profileActionsHtml } from '../../lib/social/ui';
import { NO_RELATION, type Relation } from '../../lib/social/types';

interface Props {
    viewer: 'guest' | 'owner' | 'member';
    /** Relación de quien mira con el dueño (solo `member`). */
    rel?: Relation;
    /** Dueño del perfil: id para las acciones, handle y nombre para los textos. */
    person: { id: string; handle: string; name: string };
    locked?: boolean;
    force?: boolean;
}
const { viewer, rel = NO_RELATION, person, locked = false, force = false } = Astro.props;
const phase = force ? { follow: true, friends: true, recommend: true, block: true } : SOCIAL_PHASE;
const memberHtml = viewer === 'member' ? profileActionsHtml(person, rel, { phase, locked }) : '';
---
{viewer === 'member' && (
    <div class="pf-acts" data-person={person.id} data-handle={person.handle} data-name={person.name} data-locked={locked ? '1' : undefined}>
        <div data-rel-host="profile" set:html={memberHtml} />
    </div>
)}
{viewer === 'guest' && (
    <div class="pf-acts">
        <div class="pf-acts-row">
            {locked && phase.friends && (
                <button type="button" class="pf-btn pri" data-auth-open="register"><Icon name="lucide:user-plus" />Añadir amigo</button>
            )}
            {phase.follow && (
                <button type="button" class:list={['pf-btn', { pri: !locked }]} aria-pressed="false" data-auth-open="register">
                    <Icon name="lucide:plus" />Seguir
                </button>
            )}
            {!locked && phase.friends && (
                <button type="button" class="pf-btn" data-auth-open="register"><Icon name="lucide:user-plus" />Añadir amigo</button>
            )}
            {!locked && (
                <button type="button" class="pf-btn ico" aria-label="Compartir perfil" data-action="share">
                    <Icon name="lucide:share-2" />
                </button>
            )}
        </div>
    </div>
)}
