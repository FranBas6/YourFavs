---
import Layout from "../../layouts/Layout.astro";
import {
    getMovieById,
    getMovieCast,
    getMovieDirectorsAndRoles,
    getMovieTrailer,
    fetchAllMoviePosters,
    getMovieCollectionInfo
} from "../../services/yourfavsMovie";

import {initializeApp} from "firebase/app";
import {
    getFirestore,
    doc,
    getDoc,
    setDoc,
    deleteDoc
} from "firebase/firestore";

// Configuración de Firebase
import { firebaseConfig } from '../../utils/firebaseConfig';

// Initialize Firebase
const app = initializeApp(firebaseConfig);
// Initialize Cloud Firestore
const db = getFirestore(app);

const {id} = Astro.params; // Obtén el parámetro id de la URL

if (!id) {
    throw new Error("ID de la película no encontrado en la URL");
}

// Procesar el formulario cuando se envíe un POST
if (Astro.request.method === 'POST') {
    const formData = await Astro.request.formData();
    const movieId = String(formData.get('id'));
    const action = String(formData.get('action'));
    const listType = String(formData.get('list_type'));

    // Procesar géneros en formato JSON
    let genres = [];
    try {
        genres = JSON.parse(String(formData.get('genres')) || '[]'); // Corregido: asignar a la variable genres
    } catch (error) {
        console.error("Error al parsear los géneros:", error);
    }

    // Crear un nuevo objeto con los datos de la película
    const movieData = {
        id: movieId,
        poster_path: String(formData.get('poster_path') || ''),
        title: String(formData.get('title') || 'Sin nombre'),
        vote_average: Number(formData.get('vote_average') || 0),
        overview: String(formData.get('overview') || 'Sin descripción'),
        added_at: new Date(), // Guardar la fecha y hora actual
        genres: genres, // Guardar los géneros como array
        release_date: String(formData.get('release_date') || ''),
    };

    // Determinar en qué colección de Firestore realizar la operación según el tipo de lista
    let collectionName;
    if (listType === 'favorites') {
        collectionName = 'MovieFavs';
    } else if (listType === 'pendientes') {
        collectionName = 'MoviesPendientes';
    } else if (listType === 'vistas') {
        collectionName = 'MoviesVistas';
    }

    if (collectionName) {
        // Crear referencia al documento en la colección apropiada
        const docRef = doc(db, collectionName, movieId);

        // Verificar si la película ya existe en la lista correspondiente
        const docSnap = await getDoc(docRef);
        const exists = docSnap.exists();

        if (action === 'add' && !exists) {
            // Insertar la película en Firestore
            await setDoc(docRef, movieData);
        } else if (action === 'remove' && exists) {
            // Eliminar la película de Firestore
            await deleteDoc(docRef);
        }
    }

    // Redirigir de vuelta a la página de la película
    return Astro.redirect(`/movie/${id}`);
}

// Definir la interfaz para el reparto
interface MovieCastMember {
    name: string;
    character: string;
    id: number;
}

// Obtener datos de la película
let item = null;
let cast: MovieCastMember[] = []; // Cambio aquí: de string[] a MovieCastMember[]
let directors: { name: string; job: string }[] = [];
let trailerUrl: string | null = null;
let title = "Película no encontrada";

if (id) {
    item = await getMovieById({ id });
    cast = await getMovieCast(id); // Ahora retorna MovieCastMember[]
    directors = await getMovieDirectorsAndRoles(id);
    trailerUrl = await getMovieTrailer(id);
    title = item?.title || title;
}

// Datos que se enviarán al cliente
const clientData = {
    id: String(item?.id),
    poster_path: item?.poster_path || '',
    title: item?.title || 'Sin nombre',
    vote_average: item?.vote_average ? Number(item.vote_average) : 0,
    overview: item?.overview || 'Sin descripción',
    genres: item?.genres || [], // Asegurar que siempre sea un array
    release_date: item?.release_date || '',
};

const docRefFavs = doc(db, "MovieFavs", clientData.id);
const docRefPendientes = doc(db, "MoviesPendientes", clientData.id);
const docRefVistas = doc(db, "MoviesVistas", clientData.id);

const [docSnapFavs, docSnapPendientes, docSnapVistas] = await Promise.all([
    getDoc(docRefFavs),
    getDoc(docRefPendientes),
    getDoc(docRefVistas)
]);

const existingFavs = docSnapFavs.exists();
const existingPendientes = docSnapPendientes.exists();
const existingVistas = docSnapVistas.exists();

// Verificar si la película ya está en cada una de las listas
const isInFavorites = existingFavs;
const isInPendientes = existingPendientes;
const isInVistas = existingVistas;

// Formatear la fecha para mejor visualización
const formatDate = (dateString: string) => {
    if (!dateString) return "No disponible";
    const date = new Date(dateString);
    return new Intl.DateTimeFormat('es-ES', {
        day: 'numeric',
        month: 'long',
        year: 'numeric'
    }).format(date);
};

// Lenguajes mapeados para mostrar nombres en español
const languageMap = {
    en: "Inglés",
    es: "Español",
    fr: "Francés",
    de: "Alemán",
    it: "Italiano",
    pt: "Portugués",
    ru: "Ruso",
    ja: "Japonés",
    ko: "Coreano",
    zh: "Chino",
    ar: "Árabe",
    hi: "Hindi",
    // Añade más mapeos según necesites
};

const providerLinks = {
    'Netflix': 'https://www.netflix.com/',
    'Disney Plus': 'https://www.disneyplus.com/',
    'Max': 'https://www.max.com/',
    'Amazon Prime Video': 'https://www.primevideo.com/',
    'Apple TV+': 'https://tv.apple.com/',
    'Filmin': 'https://www.filmin.es/',
    'Movistar Plus+': 'https://www.movistarplus.es/',
    'Rakuten TV': 'https://rakuten.tv/',
    'SkyShowtime': 'https://www.skyshowtime.com/',
    'MUBI': 'https://mubi.com/',
    'FlixOlé': 'https://flixole.com/',
    'Atresplayer': 'https://www.atresplayer.com/',
    'RTVE Play': 'https://www.rtve.es/play/',
    'Google Play Movies': 'https://play.google.com/store/movies',
    'YouTube': 'https://www.youtube.com/',
    'Microsoft Store': 'https://www.microsoft.com/store/movies',
    'Plex': 'https://www.plex.tv/',
    'fuboTV': 'https://www.fubo.tv/',
    'Hayu': 'https://www.hayu.com/',
    'Curiosity Stream': 'https://curiositystream.com/',
    'GuideDoc': 'https://guidedoc.tv/',
    'MagellanTV': 'https://www.magellantv.com/',
    'DOCSVILLE': 'https://www.docsville.com/',
    'WOW Presents Plus': 'https://www.wowpresentsplus.com/',
    'Mitele': 'https://www.mitele.es/',
    // Agrega más proveedores según sea necesario
};

const providerElements = item?.providers?.map((provider) => {
    const link = providerLinks[provider.provider_name];
    const hasLogo = !!provider.logo_path;
    return {
        name: provider.provider_name,
        logo: hasLogo ? `https://image.tmdb.org/t/p/w200${provider.logo_path}` : null,
        link,
    };
}) || [];

// Función para convertir rating a estrellas
const getRatingStars = (rating: number) => {
    if (!rating) return "";
    const fullStars = Math.floor(rating / 2);
    const halfStar = rating % 2 >= 1 ? 1 : 0;
    const emptyStars = 5 - fullStars - halfStar;

    return "★".repeat(fullStars) + (halfStar ? "½" : "") + "☆".repeat(emptyStars);
};

function formatTrailerUrl(url) {
    // Si ya es una URL de embed, devolverla tal cual
    if (url.includes('youtube.com/embed/')) {
        return url;
    }

    // Convertir URL normal de YouTube a URL de embed
    let videoId = '';

    // Manejar youtube.com/watch?v=ID
    if (url.includes('youtube.com/watch')) {
        const urlObj = new URL(url);
        videoId = urlObj.searchParams.get('v');
    }
    // Manejar youtu.be/ID
    else if (url.includes('youtu.be/')) {
        videoId = url.split('youtu.be/')[1].split('?')[0];
    }

    if (videoId) {
        return `https://www.youtube.com/embed/${videoId}`;
    }

    // Si no es una URL de YouTube o no se puede extraer el ID, devolver la URL original
    return url;
}

import type {PosterImage} from '../../services/yourfavsMovie'; // Asegúrate de exportar este tipo desde tu archivo api.ts

let posters: PosterImage[] = [];

if (id) {
    try {
        // Obtener todos los pósters
        const allPosters = await fetchAllMoviePosters(id);
        // Limitar a un máximo de 50 pósters
        posters = allPosters.slice(0, 40);
    } catch (error) {
        console.error('Error al obtener pósters:', error);
    }
}

// Obtener información de la colección
let collectionInfo;
if (item?.belongs_to_collection) {
    try {
        collectionInfo = await getMovieCollectionInfo(item.belongs_to_collection.id);
    } catch (error) {
        console.error('Error al obtener información de la colección:', error);
    }
}
---

<Layout title={`${title}`}>
    <article class="bg-gray-50">
        <!-- Hero Section con backdrop -->
        <div
                class="relative w-full h-96 bg-cover bg-center bg-no-repeat"
                style={`background-image: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url(https://image.tmdb.org/t/p/original${item?.backdrop_path})`}
        >
            <div class="absolute inset-0 flex items-center justify-center flex-col px-4 text-center">
                <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
                    {item?.title}
                </h1>
                <div class="flex items-center gap-4 text-white mb-4">
                    <span class="text-yellow-400 text-xl font-bold">
                        {item?.vote_average?.toFixed(1)} {getRatingStars(item?.vote_average)}
                    </span>
                    <span>{formatDate(item?.release_date)}</span>
                </div>
                {item?.genres && (
                        <div class="flex flex-wrap justify-center gap-2 mb-6">
                            {item.genres.map((genre) => (
                                    <span class="bg-gray-800 bg-opacity-80 px-3 py-1 rounded-full text-xs text-white">
                                {genre.name}
                            </span>
                            ))}
                        </div>
                )}
            </div>
        </div>

        <div class="max-w-6xl mx-auto px-4 py-8">
            <div class="flex flex-col md:flex-row gap-8">
                <!-- Columna Izquierda: Poster y Acciones -->
                <div class="md:w-1/3 flex flex-col items-center">
                    <div class="w-64 h-auto rounded-lg overflow-hidden shadow-xl mb-6">
                        <img
                                class="w-full h-auto transform hover:scale-105 transition-all duration-300"
                                src={`https://image.tmdb.org/t/p/w500${item?.poster_path}`}
                                alt={item?.title}
                        />
                    </div>

                    <div class="flex flex-col gap-4 w-full">
                        <!-- Formulario para Personal -->
                        <form method="POST" class="w-full">
                            <input type="hidden" name="id" value={item?.id}/>
                            <input type="hidden" name="poster_path" value={item?.poster_path || ''}/>
                            <input type="hidden" name="title" value={item?.title || 'Sin nombre'}/>
                            <input type="hidden" name="vote_average" value={item?.vote_average || 0}/>
                            <input type="hidden" name="overview" value={item?.overview || 'Sin descripción'}/>
                            <input type="hidden" name="genres" value={JSON.stringify(item?.genres || [])}/>
                            <input type="hidden" name="release_date" value={item?.release_date || ''}/>
                            <input type="hidden" name="action" value={isInFavorites ? 'remove' : 'add'}/>
                            <input type="hidden" name="list_type" value="favorites"/>

                            {isInFavorites ? (
                                    <button
                                            type="submit"
                                            class="w-full px-6 py-3 bg-red-600 text-white text-lg rounded-lg shadow-md hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 transition-all duration-300 flex items-center justify-center gap-2"
                                            aria-live="polite"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20"
                                             fill="currentColor">
                                            <path fill-rule="evenodd"
                                                  d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z"
                                                  clip-rule="evenodd"/>
                                        </svg>
                                        Eliminar de favoritos
                                    </button>
                            ) : (
                                    <button
                                            type="submit"
                                            class="w-full px-6 py-3 bg-blue-600 text-white text-lg rounded-lg shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-300 flex items-center justify-center gap-2"
                                            aria-live="polite"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20"
                                             fill="currentColor">
                                            <path fill-rule="evenodd"
                                                  d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z"
                                                  clip-rule="evenodd"/>
                                        </svg>
                                        Añadir a favoritos
                                    </button>
                            )}
                        </form>

                        <!-- Formulario para Películas Pendientes -->
                        <form method="POST" class="w-full">
                            <input type="hidden" name="id" value={item?.id}/>
                            <input type="hidden" name="poster_path" value={item?.poster_path || ''}/>
                            <input type="hidden" name="title" value={item?.title || 'Sin nombre'}/>
                            <input type="hidden" name="vote_average" value={item?.vote_average || 0}/>
                            <input type="hidden" name="overview" value={item?.overview || 'Sin descripción'}/>
                            <input type="hidden" name="genres" value={JSON.stringify(item?.genres || [])}/>
                            <input type="hidden" name="release_date" value={item?.release_date || ''}/>
                            <input type="hidden" name="action" value={isInPendientes ? 'remove' : 'add'}/>
                            <input type="hidden" name="list_type" value="pendientes"/>

                            {isInPendientes ? (
