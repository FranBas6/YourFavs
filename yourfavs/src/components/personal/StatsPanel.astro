---
import {formatFirebaseDate} from "../../utils/constants/helpers/media-helpers";
import '../../styles/components/personal/stats-panel.css';

interface Props {
    stats: {
        series: {
            total: number;
            enEmision: number;
            finalizadas: number;
            temporadasTotal: number;
            episodiosTotal: number;
            añoMasAntiguo: number;
            añoMasReciente: number;
            notaPromedio: number;
            latestAdded: { id: string; name: string; poster_path?: string; added_at: any }[];
        };
        movies: {
            total: number;
            añoMasAntiguo: number;
            añoMasReciente: number;
            notaPromedio: number;
            duracionPromedio: number;
            latestAdded: { id: string; title: string; poster_path?: string; added_at: any }[];
        };
        general: {
            totalContent: number;
            topGenres: { name: string; count: number }[];
            topDecades: [string, number][];
            notaPromedioGeneral: string;
        };
    };
}

const { stats } = Astro.props;
---
<!-- Checkbox oculto para controlar las estadísticas -->
<input type="checkbox" id="stats-toggle" class="stats-toggle hidden"/>

<!-- Botón de Estadísticas -->
<div class="stats-button-container flex justify-center mb-6">
    <label for="stats-toggle"
        class="stats-toggle-btn px-6 py-3 rounded-xl text-sm font-semibold tracking-wide transition-all bg-gradient-to-r from-purple-600 to-pink-600 text-white hover:from-purple-700 hover:to-pink-700 hover:scale-105 cursor-pointer flex items-center gap-3 shadow-lg">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
        <span class="stats-text">Estadísticas y Datos</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 stats-chevron transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
    </label>
</div>

<!-- Panel de Estadísticas -->
<div class="stats-panel bg-gradient-to-br from-purple-50 via-pink-50 to-white rounded-3xl shadow-2xl border border-purple-100 mb-8 overflow-hidden">
    <div class="stats-content p-3 sm:p-6 lg:p-8 space-y-6 sm:space-y-8">

        <!-- Estadísticas Generales -->
        <div class="general-stats grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="stat-card bg-white rounded-xl shadow-md p-4 text-center border border-gray-100 hover:shadow-lg transition-all">
                <div class="stat-icon text-3xl mb-2">🎬</div>
                <div class="stat-number text-2xl font-bold text-purple-700">{stats.general.totalContent}</div>
                <div class="stat-label text-sm text-gray-600">Total Contenido</div>
            </div>
            <div class="stat-card bg-white rounded-xl shadow-md p-4 text-center border border-gray-100 hover:shadow-lg transition-all">
                <div class="stat-icon text-3xl mb-2">⭐</div>
                <div class="stat-number text-2xl font-bold text-yellow-600">{stats.general.notaPromedioGeneral}</div>
                <div class="stat-label text-sm text-gray-600">Nota Promedio</div>
            </div>
            <div class="stat-card bg-white rounded-xl shadow-md p-4 text-center border border-gray-100 hover:shadow-lg transition-all">
                <div class="stat-icon text-3xl mb-2">📺</div>
                <div class="stat-number text-2xl font-bold text-blue-600">{stats.series.total}</div>
                <div class="stat-label text-sm text-gray-600">Series</div>
            </div>
            <div class="stat-card bg-white rounded-xl shadow-md p-4 text-center border border-gray-100 hover:shadow-lg transition-all">
                <div class="stat-icon text-3xl mb-2">🎥</div>
                <div class="stat-number text-2xl font-bold text-red-600">{stats.movies.total}</div>
                <div class="stat-label text-sm text-gray-600">Películas</div>
            </div>
        </div>

        <!-- Estadísticas Detalladas -->
        <div class="detailed-stats grid lg:grid-cols-2 gap-4 sm:gap-6 lg:gap-8">

            <!-- Series -->
            <div class="series-stats bg-white rounded-2xl shadow-lg p-3 sm:p-4 lg:p-6 border border-blue-100 overflow-hidden">
                <h3 class="text-base sm:text-lg font-bold text-blue-800 mb-3 sm:mb-4 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                    </svg>
                    Estadísticas de Series
                </h3>
                <div class="space-y-4">
                    <div class="flex justify-between items-center py-2 border-b border-blue-100">
                        <span class="text-gray-700">En emisión:</span>
                        <span class="font-semibold text-green-600">{stats.series.enEmision}</span>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b border-blue-100">
                        <span class="text-gray-700">Finalizadas:</span>
                        <span class="font-semibold text-red-600">{stats.series.finalizadas}</span>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b border-blue-100">
                        <span class="text-gray-700">Total temporadas:</span>
                        <span class="font-semibold text-blue-600">{stats.series.temporadasTotal}</span>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b border-blue-100">
                        <span class="text-gray-700">Total episodios:</span>
                        <span class="font-semibold text-purple-600">{stats.series.episodiosTotal}</span>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b border-blue-100">
                        <span class="text-gray-700">Nota promedio:</span>
                        <span class="font-semibold text-yellow-600">{stats.series.notaPromedio}⭐</span>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b border-blue-100 mb-4">
                        <span class="text-gray-700">Rango de años:</span>
                        <span class="font-semibold text-indigo-600">{stats.series.añoMasAntiguo} - {stats.series.añoMasReciente}</span>
                    </div>

                    <div class="mt-6 pt-4 border-t-2 border-blue-200">
                        <h4 class="text-xs sm:text-sm font-bold text-blue-700 mb-2 sm:mb-3 flex items-center gap-1 sm:gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Últimas Añadidas
                        </h4>
                        <div class="space-y-1.5 sm:space-y-2">
                            {stats.series.latestAdded.map((serie) => (
                                <a href={`/serie/${serie.id}`}
                                   class="flex items-center gap-2 sm:gap-3 p-1.5 sm:p-2 rounded-lg hover:bg-blue-50 transition-all group">
                                    <div class="flex-shrink-0 w-8 h-12 sm:w-10 sm:h-14 bg-gradient-to-br from-blue-100 to-blue-200 rounded overflow-hidden shadow-sm">
                                        {serie.poster_path ? (
                                            <img src={`https://image.tmdb.org/t/p/w92${serie.poster_path}`} alt={serie.name} class="w-full h-full object-cover"/>
                                        ) : (
                                            <div class="w-full h-full flex items-center justify-center">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-6 sm:w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                                                </svg>
                                            </div>
                                        )}
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-xs sm:text-sm font-medium text-gray-800 truncate group-hover:text-blue-600 transition-colors">{serie.name}</p>
                                        <p class="text-[10px] sm:text-xs text-gray-500 truncate">{formatFirebaseDate(serie.added_at)}</p>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Películas -->
            <div class="movies-stats bg-white rounded-2xl shadow-lg p-3 sm:p-4 lg:p-6 border border-red-100 overflow-hidden">
                <h3 class="text-base sm:text-lg font-bold text-red-800 mb-3 sm:mb-4 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                    </svg>
                    Estadísticas de Películas
                </h3>
                <div class="space-y-4">
                    <div class="flex justify-between items-center py-2 border-b border-red-100">
                        <span class="text-gray-700">Total películas:</span>
                        <span class="font-semibold text-red-600">{stats.movies.total}</span>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b border-red-100">
                        <span class="text-gray-700">Nota promedio:</span>
                        <span class="font-semibold text-yellow-600">{stats.movies.notaPromedio}⭐</span>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b border-red-100">
                        <span class="text-gray-700">Duración promedio:</span>
                        <span class="font-semibold text-blue-600">{stats.movies.duracionPromedio} min</span>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b border-red-100 mb-4">
                        <span class="text-gray-700">Rango de años:</span>
                        <span class="font-semibold text-indigo-600">{stats.movies.añoMasAntiguo} - {stats.movies.añoMasReciente}</span>
                    </div>

                    <div class="mt-6 pt-4 border-t-2 border-red-200">
                        <h4 class="text-xs sm:text-sm font-bold text-red-700 mb-2 sm:mb-3 flex items-center gap-1 sm:gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Últimas Añadidas
                        </h4>
                        <div class="space-y-1.5 sm:space-y-2">
                            {stats.movies.latestAdded.map((movie) => (
                                <a href={`/movie/${movie.id}`}
                                   class="flex items-center gap-2 sm:gap-3 p-1.5 sm:p-2 rounded-lg hover:bg-red-50 transition-all group">
                                    <div class="flex-shrink-0 w-8 h-12 sm:w-10 sm:h-14 bg-gradient-to-br from-red-100 to-red-200 rounded overflow-hidden shadow-sm">
                                        {movie.poster_path ? (
                                            <img src={`https://image.tmdb.org/t/p/w92${movie.poster_path}`} alt={movie.title} class="w-full h-full object-cover"/>
                                        ) : (
                                            <div class="w-full h-full flex items-center justify-center">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-6 sm:w-6 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                                </svg>
                                            </div>
                                        )}
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-xs sm:text-sm font-medium text-gray-800 truncate group-hover:text-red-600 transition-colors">{movie.title}</p>
                                        <p class="text-[10px] sm:text-xs text-gray-500 truncate">{formatFirebaseDate(movie.added_at)}</p>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Géneros y Décadas -->
        <div class="popularity-stats grid lg:grid-cols-2 gap-4 sm:gap-6 lg:gap-8">
            <div class="top-genres bg-white rounded-2xl shadow-lg p-3 sm:p-4 lg:p-6 border border-green-100 overflow-hidden">
                <h3 class="text-lg font-bold text-green-800 mb-4 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                    Géneros Favoritos
                </h3>
                <div class="space-y-3">
                    {stats.general.topGenres.map((genre, index) => (
                        <div class="flex items-center justify-between py-2 px-3 bg-green-50 rounded-lg">
                            <div class="flex items-center gap-3">
                                <span class="text-lg font-bold text-green-600">#{index + 1}</span>
                                <span class="text-gray-800 font-medium">{genre.name}</span>
                            </div>
                            <span class="bg-green-600 text-white text-sm px-2 py-1 rounded-full font-semibold">{genre.count}</span>
                        </div>
                    ))}
                </div>
            </div>

            <div class="top-decades bg-white rounded-2xl shadow-lg p-3 sm:p-4 lg:p-6 border border-orange-100 overflow-hidden">
                <h3 class="text-lg font-bold text-orange-800 mb-4 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Décadas Favoritas
                </h3>
                <div class="space-y-3">
                    {stats.general.topDecades.map(([decade, count], index) => (
                        <div class="flex items-center justify-between py-2 px-3 bg-orange-50 rounded-lg">
                            <div class="flex items-center gap-3">
                                <span class="text-lg font-bold text-orange-600">#{index + 1}</span>
                                <span class="text-gray-800 font-medium">{decade}</span>
                            </div>
                            <span class="bg-orange-600 text-white text-sm px-2 py-1 rounded-full font-semibold">{count}</span>
                        </div>
                    ))}
                </div>
            </div>
        </div>

        <!-- Resumen Visual -->
        <div class="visual-summary bg-gradient-to-r from-purple-100 to-pink-100 rounded-2xl p-4 sm:p-6 text-center overflow-hidden">
            <h3 class="text-xl font-bold text-purple-800 mb-3">📊 Resumen de tu Colección</h3>
            <p class="text-gray-700 text-lg">
                Tienes <span class="font-bold text-purple-600">{stats.general.totalContent}</span> títulos
                con una nota promedio de <span class="font-bold text-yellow-600">{stats.general.notaPromedioGeneral}⭐</span>
            </p>
            {stats.general.totalContent > 0 && (
                <div class="mt-4 flex justify-center gap-8 text-sm text-gray-600">
                    <div>
                        <span class="font-semibold text-blue-600">{((stats.series.total / stats.general.totalContent) * 100).toFixed(0)}%</span>
                        <span> Series</span>
                    </div>
                    <div>
                        <span class="font-semibold text-red-600">{((stats.movies.total / stats.general.totalContent) * 100).toFixed(0)}%</span>
                        <span> Películas</span>
                    </div>
                </div>
            )}
        </div>
    </div>
</div>
