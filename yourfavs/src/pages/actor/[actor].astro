                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenido principal -->
    <div class="main-content">
        <div class="container mx-auto px-4 py-8">
            
            <!-- Sección de Información Personal -->
            <section id="biografia" class="info-section">
