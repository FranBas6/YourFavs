const yearsActive = calculateYearsActive();

// Función para convertir rating a estrellas
const getRatingStars = (rating: number): string => {
    if (!rating) return "";
    const fullStars = Math.floor(rating / 2);
    const halfStar = rating % 2 >= 1 ? 1 : 0;
    const emptyStars = 5 - fullStars - halfStar;
    return "★".repeat(fullStars) + (halfStar ? "½" : "") + "☆".repeat(emptyStars);
};

// Ordenar temporadas: primero las regulares, luego las especiales
const sortedSeasons = item?.seasons?.sort((a, b) => {
    // Las temporadas especiales (0) van al final
    if (a.season_number === 0 && b.season_number !== 0) return 1;
    if (b.season_number === 0 && a.season_number !== 0) return -1;
    // Para el resto, orden numérico normal
    return a.season_number - b.season_number;
}) || [];

// Variables útiles para usar en el template
const hasSpecialSeasons = specialSeasons.length > 0;
const regularSeasonsCount = regularSeasons.length;
const specialSeasonsCount = specialSeasons.length;

function formatTrailerUrl(url) {
    // Si ya es una URL de embed, devolverla tal cual
    if (url.includes('youtube.com/embed/')) {
        return url;
    }

    // Convertir URL normal de YouTube a URL de embed
    let videoId = '';

    // Manejar youtube.com/watch?v=ID
    if (url.includes('youtube.com/watch')) {
        const urlObj = new URL(url);
        videoId = urlObj.searchParams.get('v');
    }
    // Manejar youtu.be/ID
    else if (url.includes('youtu.be/')) {
        videoId = url.split('youtu.be/')[1].split('?')[0];
    }

    if (videoId) {
        return `https://www.youtube.com/embed/${videoId}`;
    }

    // Si no es una URL de YouTube o no se puede extraer el ID, devolver la URL original
    return url;
}

