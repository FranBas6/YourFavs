---
/**
 * Episodios de una temporada en la ficha de serie: «Marcar temporada», «Ficha de la temporada» y una fila
 * desplegable por episodio (fotograma, sinopsis, dirección y guion, estrellas invitadas).
 *
 * QA 7.3 (H82): antes iban TODAS las temporadas en el HTML de la ficha aunque estuvieran plegadas
 * (Juego de Tronos, ~27.000 de sus ~31.000 nodos). Ahora la ficha deja el hueco y este componente lo
 * pinta la ruta `pages/serie/[id]/episodios/[season].astro` al abrir la temporada
 * (`scripts/series/seasonEpisodes.ts`). El marcado es el de siempre: los estilos (serie.css) y
 * `public/js/optimistic-actions.js` (formularios «Visto») no cambian.
 */
import type { GuestStar } from '../../types/Media';
import { formatDate } from '../../utils/titles/mediaHelpers';
import { formatRuntime } from '../../utils/titles/serieHelpers';
import { episodeHref, seasonHref } from '../../utils/titles/episodeView';
import { episodeMark, episodeCredits, shortAirDate, type EpisodeMarkContext } from '../../utils/titles/episodeRows';
import { posterUrl } from '../../services/tmdb/tmdbClient';

interface Props {
    /** Id de TMDB de la serie. */
    id: string | number;
    season: number;
    seasonEpisodes: any[];
    /** «T-E» de los episodios vistos («1-3»). */
    watchedSet: Set<string>;
    hideStills: boolean;
    hideSynopsis: boolean;
    seriesIsOver: boolean;
    lastRegularSeasonNumber: number;
}

const { id, season, seasonEpisodes, watchedSet, hideStills, hideSynopsis, seriesIsOver, lastRegularSeasonNumber } = Astro.props;
const seasonTotal = seasonEpisodes.length;
const seasonWatched = seasonEpisodes.filter((ep) => watchedSet.has(`${season}-${ep.episode_number}`)).length;
const isSeasonComplete = seasonTotal > 0 && seasonWatched === seasonTotal;
const markCtx: EpisodeMarkContext = { seriesIsOver, lastRegularSeasonNumber, seasonEpisodes };
---
{/* Botón marcar/desmarcar temporada y, al lado, su ficha */}
<div class="sr-acts">
{seasonTotal > 0 && (
    <form method="POST">
        <input type="hidden" name="actionType" value="watched_season" />
        <input type="hidden" name="season" value={season} />
        <input type="hidden" name="episodes" value={seasonEpisodes.map((ep) => ep.episode_number).join(',')} />
        <input type="hidden" name="action" value={isSeasonComplete ? 'unmark' : 'mark'} />
        <button type="submit" class="btn btn--sm sr-markall" data-tone="visto" aria-pressed={isSeasonComplete ? 'true' : 'false'}>
            {isSeasonComplete ? 'Desmarcar temporada completa' : <><span class="ep-dsk">{`Marcar toda la temporada como vista (${seasonTotal} episodios)`}</span><span class="ep-mob">{`Marcar temporada vista (${seasonTotal})`}</span></>}
        </button>
    </form>
)}
    <a class="btn btn--sm sr-ficha" href={seasonHref(id, season)}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/></svg>
        <span class="ep-dsk">Ficha de la temporada</span><span class="ep-mob">Ver la ficha de la temporada</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </a>
</div>
{seasonEpisodes.map((episode) => {
    const isWatched = watchedSet.has(`${season}-${episode.episode_number}`);
    const mark = episodeMark(episode, markCtx);
    const credits = episodeCredits(episode);
    return (
    <div>
        <details class="ep group">
            <summary class={`ep-row ${isWatched ? 'opacity-60' : ''}`}>
                <span class="ep-n">
                    {season === 0 ? `E${episode.episode_number}` : episode.episode_number}
                </span>
                {mark && (
                    <span class="chip-state ep-mark ep-dsk-f" title={mark.title}>{mark.label}</span>
                )}
                <div class="flex-1 min-w-0">
                    {/* En móvil, la etiqueta (FINAL, PARÓN…) va encima del título: al lado se lo comía. */}
                    {mark && <span class="chip-state ep-mark ep-mob-b" title={mark.title}>{mark.label}</span>}
                    {/* TMDB D4: el título lleva a la ficha del episodio; «Visto» sigue marcando sin salir. */}
                    {/* El título despliega como el resto de la fila (antes llevaba a la ficha y en móvil
                        se tocaba sin querer); a la ficha se va con «Ficha» o desde el desplegable. */}
                    <p class="ep-t truncate group-open:whitespace-normal group-open:overflow-visible">{episode.name}</p>
                    <p class="ep-m truncate">
                        <span class="ep-dsk">{formatDate(episode.air_date)}</span><span class="ep-mob">{shortAirDate(episode.air_date)}</span>{episode.runtime ? <><span class="ep-dsk">{`  ·  ${formatRuntime(episode.runtime)}`}</span><span class="ep-mob">{`  ·  ${episode.runtime} min`}</span></> : ''}
                        {episode.vote_average > 0 && <span class="ep-r">  ·  ★ {episode.vote_average.toFixed(1).replace('.', ',')}</span>}
                    </p>
                </div>
                <svg class="ep-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                {/* TMDB D4: a la ficha del episodio, al lado de «Visto» (solo escritorio; en móvil, desde el desplegable). */}
                <a href={episodeHref(id, season, episode.episode_number)} class="btn btn--sm btn--ghost ep-btn ep-ficha" aria-label={`Abrir la ficha de «${episode.name}»`} onclick="event.stopPropagation()">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="2.18"/><path d="M7 2v20M17 2v20M2 12h20M2 7h5M2 17h5M17 17h5M17 7h5"/></svg>
                    <span class="hidden sm:inline">Ficha</span>
                </a>
                <form method="POST" data-season={season} class="flex-shrink-0" onclick="event.stopPropagation()">
                    <input type="hidden" name="actionType" value="watched_episode" />
                    <input type="hidden" name="season" value={season} />
                    <input type="hidden" name="episode" value={episode.episode_number} />
                    <button type="submit" class="btn btn--sm ep-btn" data-tone="visto" aria-pressed={isWatched ? 'true' : 'false'} aria-label={`${episode.name}: ${isWatched ? 'visto' : 'marcar como visto'}`}>
                        <svg class="w-3.5 h-3.5 ep-off" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                        <svg class="w-3.5 h-3.5 ep-on" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20 6 9 17l-5-5"/></svg>
                        {/* «Marcar» sin ver, «Visto» visto (QA 1.6, H35): lo decide aria-pressed en CSS, también al cambiarlo sin recargar. */}
                        <span class="hidden sm:inline"><span class="ep-off">Marcar</span><span class="ep-on">Visto</span></span>
                    </button>
                </form>
            </summary>
            <div class={`ep-body ${(hideStills || hideSynopsis) && !isWatched ? 'yf-spoil' : ''}`}>
                {(hideStills || hideSynopsis) && !isWatched && (
                    <button type="button" class="yf-spoil-btn" aria-label="Mostrar contenido con posibles spoilers">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                        Mostrar (spoilers)
                    </button>
                )}
                {/* Imagen */}
                {episode.still_path && (
                    <div class={`flex justify-center mb-3 ${hideStills && !isWatched ? 'yf-blur' : ''}`}>
                        <img src={posterUrl(episode.still_path, 'w500')} alt={episode.name} loading="lazy" class="rounded-lg shadow-md w-full max-w-md" />
                    </div>
                )}

                {/* Sinopsis */}
                <p class={`text-sm text-gray-700 leading-relaxed mb-3 ${hideSynopsis && !isWatched ? 'yf-blur' : ''}`}>{episode.overview || "No hay descripción disponible."}</p>

                {/* Dirección y guion (B2a): no es spoiler, va sin difuminar */}
                {(credits.directors.length > 0 || credits.writers.length > 0) && (
                    <p class="ep-cr">
                        {credits.directors.length > 0 && (
                            <span><span class="font-semibold">Dirección:</span> {credits.directors.map((n, i) => (<>{i > 0 && ', '}<a href={`/team/${encodeURIComponent(n)}`} class="ep-a">{n}</a></>))}</span>
                        )}
                        {credits.directors.length > 0 && credits.writers.length > 0 && <span class="text-gray-400">  ·  </span>}
                        {credits.writers.length > 0 && (
                            <span><span class="font-semibold">Guion:</span> {credits.writers.map((n, i) => (<>{i > 0 && ', '}<a href={`/team/${encodeURIComponent(n)}`} class="ep-a">{n}</a></>))}</span>
                        )}
                    </p>
                )}
                {/* Estrellas invitadas — van con la sinopsis: un nombre en el reparto
                    de un episodio cuenta tanto como el texto (o más). */}
                {episode.guest_stars && episode.guest_stars.length > 0 && (
                    <div class={hideSynopsis && !isWatched ? 'yf-blur' : ''}>
                        <p class="ep-gh">Estrellas invitadas</p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 ep-gs">
                            {episode.guest_stars.map((star: GuestStar) => (
                                <a href={`/actor/${star.id}`} class="flex items-center gap-3 text-sm">
                                    {star.profile_path && <img src={posterUrl(star.profile_path, 'w185')} alt={star.name} class="w-11 h-11 rounded-full object-cover flex-shrink-0" loading="lazy" />}
                                    <div>
                                        <span class="text-gray-800 font-medium hover:text-blue-600">{star.name}</span>
                                        <span class="block text-xs text-gray-500">{star.character}</span>
                                    </div>
                                </a>
                            ))}
                        </div>
                        {episode.guest_stars.length > 6 && (
                            <button type="button" class="btn btn--sm btn--ghost ep-gs-more" onclick="this.previousElementSibling.classList.add('is-all'); this.remove()">Ver los {episode.guest_stars.length}</button>
                        )}
                    </div>
                )}
                <a href={episodeHref(id, season, episode.episode_number)} class="btn btn--sm ep-open">
                    Abrir la ficha del episodio
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </div>
        </details>
    </div>
    );
})}
{(!seasonEpisodes || seasonEpisodes.length === 0) && (
    <p class="text-gray-500 italic text-center p-4 text-sm">No hay información de episodios disponible.</p>
)}
