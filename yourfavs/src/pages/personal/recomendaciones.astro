---
import Layout from "../../layouts/Layout.astro"
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import {getRecommendedSeries} from "../../services/BD/series/yourfavsSerie";
import {getRecommendedMovies} from "../../services/BD/movies/yourfavsMovie";
import {getGenreName} from "../../utils/constants/genres";
import PersonalNav from "../../components/personal/PersonalNav.astro";
import PersonalFilter from "../../components/personal/PersonalFilter.astro";
import '../../styles/pages/personal/personal.css';

let seriesRecomendadas: any[] = [];
let peliculasRecomendadas: any[] = [];
let errorMessage = "";

try {
    seriesRecomendadas = await getRecommendedSeries();
    peliculasRecomendadas = await getRecommendedMovies();
} catch (error) {
    console.error("Error al cargar recomendaciones:", error);
    errorMessage = error instanceof Error ? error.message : "Error desconocido al cargar datos";
}

const filter = Astro.url.searchParams.get("filter") || "todos";
const showSeries = filter === "series" || filter === "todos";
const showMovies = filter === "peliculas" || filter === "todos";
const showAll = filter === "todos";

const pageUrl = Astro.url;
---
<Layout title="Recomendaciones">
    {errorMessage && (
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="bg-red-500/10 border border-red-500 text-red-500 px-4 py-3 rounded">
                <strong>Error:</strong> {errorMessage}
            </div>
        </div>
    )}
    <div class="favorites-container max-w-7xl mx-auto px-4 py-8">
        <PersonalFilter pageUrl={pageUrl} filter={filter} />

        <PersonalNav currentPage="/personal/recomendaciones" />

        <!-- Contenedor principal de contenido -->
        <div class="content-sections space-y-12">
            <!-- SECCIÓN DE RECOMENDADAS -->
            <div class="favorites-section animate-fadeIn">
                <div class="section-header flex items-center gap-4 mb-6">
                    <div class="flex-grow h-0.5 bg-gradient-to-r from-orange-300 to-orange-500"></div>
                    <h2 class="text-2xl font-bold text-gray-800 flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 mr-2 text-orange-500"
                            viewBox="0 0 20 20" fill="currentColor">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                        Contenido Recomendado
                    </h2>
                    <div class="flex-grow h-0.5 bg-gradient-to-r from-orange-500 to-orange-300"></div>
                </div>

                {/* Series Recomendadas */}
                {(showSeries || showAll) && (
                        <section class="mb-8">
                            <h3 class="text-lg font-semibold text-gray-800 mb-4 flex justify-between items-center bg-blue-50 rounded-lg px-4 py-3 border-l-4 border-blue-500">
                                <span class="flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                                    </svg>
                                Series Recomendadas
                                </span>
                            </h3>

                            {seriesRecomendadas.length === 0 ? (
                                    <div class="empty-state bg-orange-50 border border-orange-200 rounded-xl p-6 text-center">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                            class="h-12 w-12 mx-auto text-orange-400 mb-3" fill="none"
                                            viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                                        </svg>
                                        <h3 class="text-lg font-semibold text-orange-700 mb-1">No hay series
                                            recomendadas</h3>
                                        <p class="text-orange-600 text-sm">Las recomendaciones se generarán basadas en tus
                                            series favoritas y contenido que te gusta.</p>
                                    </div>
                            ) : (
                                    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                                        {seriesRecomendadas.map((item) => (
                                                <CardSerie
                                                        id={item.id.toString()}
                                                        img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                        name={item.name}
                                                        vote_average={item.vote_average}
                                                        overview={item.overview}
                                                        first_air_date={item.first_air_date}
                                                        seasons={item.seasons}
                                                        last_episode_to_air={item.last_episode_to_air}
                                                        next_episode_to_air={item.next_episode_to_air}
                                                        status={item.status}
                                                />
                                        ))}
                                    </div>
                            )}
                        </section>
                )}

                {/* Películas Recomendadas */}
                {(showMovies || showAll) && (
                        <section class="mb-8">
                            <h3 class="text-lg font-semibold text-gray-800 mb-4 flex justify-between items-center bg-red-50 rounded-lg px-4 py-3 border-l-4 border-red-500">
                                <span class="flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-600" fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                    </svg>
                                    Películas Recomendadas
                                </span>
                            </h3>

                            {peliculasRecomendadas.length === 0 ? (
                                    <div class="empty-state bg-orange-50 border border-orange-200 rounded-xl p-6 text-center">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                            class="h-12 w-12 mx-auto text-orange-400 mb-3" fill="none"
                                            viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                                        </svg>
                                        <h3 class="text-lg font-semibold text-orange-700 mb-1">No hay películas
                                            recomendadas</h3>
                                        <p class="text-orange-600 text-sm">Las recomendaciones se generarán basadas en tus
                                            películas favoritas y contenido que te gusta.</p>
                                    </div>
                            ) : (
                                    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                                        {peliculasRecomendadas.map((item) => (
                                                <CardMovie
                                                        id={item.id.toString()}
                                                        img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                        title={item.title}
                                                        vote_average={item.vote_average}
                                                        overview={item.overview}
                                                        release_date={item.release_date}
                                                />
                                        ))}
                                    </div>
                            )}
                        </section>
                )}
            </div>
        </div>
    </div>
</Layout>
