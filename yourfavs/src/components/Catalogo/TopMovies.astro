---
import CardMovie from "../Cards/CardMovie.astro";
import {getTopRatedMovies} from "../../services/API/Movies/tmdbMovies";

// Obtener el parámetro de página desde la URL
const page = Number(Astro.request.url.split('?page=')[1] || 1);

// Cargar las películas y series para la página actual
const popularMovies = await getTopRatedMovies({page: page.toString()});

// Total de páginas, puedes obtenerlo del API o mantenerlo como un valor estático
const totalPages = 500; // Suponiendo 10 páginas de resultados disponibles, ajusta según tu API

// Definir los géneros comunes
const genresMap: Record<number, string> = {
    // Géneros de películas y series
    28: "Acción",
    12: "Aventura",
    16: "Animación",
    35: "Comedia",
    80: "Crimen",
    99: "Documental",
    18: "Drama",
    10751: "Familia",
    14: "Fantasía",
    36: "Historia",
    27: "Terror",
    10402: "Música",
    9648: "Misterio",
    10749: "Romance",
    878: "Ciencia ficción",
    10770: "Película de TV",
    53: "Thriller",
    10752: "Bélica",
    37: "Western",
    // Géneros exclusivos de series
    10759: "Acción y Aventura",
    10762: "Infantil",
    10763: "Noticias",
    10764: "Reality",
    10765: "Sci-Fi y Fantasía",
    10766: "Soap",
    10767: "Talk",
    10768: "Guerra y Política"
};

// Función para obtener el nombre del género según su ID
function getGenreName(id: number): string {
    return genresMap[id] || "Otro";
}

// Calcular estadísticas de la página actual
const totalMoviesShown = page * 20; // Asumiendo 20 películas por página
const startIndex = (page - 1) * 20 + 1;
const endIndex = Math.min(page * 20, totalPages * 20);
---
<section class="px-1 sm:py-8">
    <!-- Header mejorado -->
    <header class="text-center mb-8">
        <div class="inline-flex items-center gap-3 mb-6">
            <div class="text-left mb-4">
                <h1 class="text-coral-red font-bold text-3xl md:text-4xl lg:text-5xl leading-tight mb-2">
                    TOP PELÍCULAS
                </h1>
                <div class="w-24 h-1 bg-coral-red mx-auto rounded-full mb-4"></div>
            </div>
        </div>

        <p class="text-gray-700 text-base md:text-lg max-w-2xl mx-auto leading-relaxed mb-6">
            Descubre las películas mejor valoradas por la crítica y el público mundial.
            <span class="text-coral-red font-medium">Solo lo mejor del cine</span>
        </p>

    </header>

    <!-- Información de paginación superior mejorada -->
    <div class="bg-gradient-to-r from-white to-gray-50 rounded-2xl p-4 md:p-6 mb-8 shadow-sm border border-gray-100">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <!-- Info de página -->
            <div class="flex items-center gap-3">
                <div class="flex items-center justify-center w-10 h-10 bg-coral-red/10 rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-coral-red" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                </div>
                <div>
                    <div class="text-sm font-semibold text-gray-900">
                        Página <span class="text-coral-red">{page}</span> de <span
                            class="text-coral-red">{totalPages}</span>
                    </div>
                    <div class="text-xs text-gray-500">
                        Mostrando {startIndex}-{endIndex} de {totalPages * 20} películas
                    </div>
                </div>
            </div>

            <!-- Stats adicionales -->
            <div class="flex items-center gap-4 text-sm">
                <div class="flex items-center gap-2 text-gray-600">
                    <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                    <span>Actualizado hoy</span>
                </div>
                <div class="flex items-center gap-2 text-gray-600">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                    </svg>
                    <span>Mejor valoradas</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Grid mejorado con loading states visuales -->
    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
        {
            popularMovies.map((item) => (
                    <div class="card-wrapper group">
                        <CardMovie
                                id={item.id.toString()}
                                img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                title={item.title}
                                vote_average={item.vote_average}
                                overview={item.overview}
                                release_date={item.release_date}
                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                        />
                    </div>
            ))
        }
    </div>

    <!-- Paginación completamente rediseñada -->
    <nav aria-label="Paginación de películas" class="mt-16">
        <!-- Navegación móvil mejorada -->
        <div class="flex sm:hidden flex-col gap-4">
            <!-- Info móvil -->
            <div class="text-center bg-white rounded-xl p-4 shadow-sm border border-gray-100">
                <div class="text-sm text-gray-600 mb-2">Página actual</div>
                <div class="text-2xl font-bold text-coral-red">{page}</div>
                <div class="text-xs text-gray-500">de {totalPages} páginas</div>
            </div>

            <!-- Controles móviles -->
            <div class="flex gap-3">
                <a href={`?page=${Math.max(1, page - 1)}`}
                   class={`pagination-btn-mobile flex-1 ${page === 1 ? 'disabled' : ''}`}
                   aria-disabled={page === 1}>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Anterior
                </a>

                <a href={`?page=${Math.min(totalPages, page + 1)}`}
                   class={`pagination-btn-mobile flex-1 ${page === totalPages ? 'disabled' : ''}`}
                   aria-disabled={page === totalPages}>
                    Siguiente
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>

        <!-- Paginación mejorada -->
        <nav aria-label="Paginación" class="mt-12">
            <!-- Navegación móvil -->
            <div class="flex sm:hidden items-center justify-between bg-white rounded-xl p-4 shadow-sm border border-gray-100">
                <a href={`?page=${Math.max(1, page - 1)}`}
                   class={`pagination-btn-mobile ${page === 1 ? 'disabled' : ''}`}
                   aria-disabled={page === 1}>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Anterior
                </a>

                <div class="flex items-center gap-2 px-4">
                    <span class="text-sm text-gray-600">Página</span>
                    <span class="px-3 py-1 bg-coral-red text-white rounded-lg font-semibold text-sm">{page}</span>
                    <span class="text-sm text-gray-600">de {totalPages}</span>
                </div>

                <a href={`?page=${Math.min(totalPages, page + 1)}`}
                   class={`pagination-btn-mobile ${page === totalPages ? 'disabled' : ''}`}
                   aria-disabled={page === totalPages}>
                    Siguiente
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>

            <!-- Navegación escritorio -->
            <div class="hidden sm:flex justify-center">
                <div class="inline-flex items-center bg-white rounded-xl p-2 shadow-sm border border-gray-100">
                    <!-- Botón anterior -->
                    <a href={`?page=${Math.max(1, page - 1)}`}
                       class={`pagination-btn ${page === 1 ? 'disabled' : ''}`}
                       aria-disabled={page === 1}>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                        </svg>
                        Anterior
                    </a>

                    <!-- Primera página -->
                    {page > 2 && (
                            <>
                                <a href={`?page=1`} class="pagination-number">1</a>
                                {page > 3 && <span class="px-2 text-gray-400">...</span>}
                            </>
                    )}

                    <!-- Página anterior -->
                    {page > 1 && (
                            <a href={`?page=${page - 1}`} class="pagination-number">{page - 1}</a>
                    )}

                    <!-- Página actual -->
                    <span class="pagination-number active">{page}</span>

                    <!-- Página siguiente -->
                    {page < totalPages && (
                            <a href={`?page=${page + 1}`} class="pagination-number">{page + 1}</a>
                    )}

                    <!-- Última página -->
                    {page < totalPages - 1 && (
                            <>
                                {page < totalPages - 2 && <span class="px-2 text-gray-400">...</span>}
                                <a href={`?page=${totalPages}`} class="pagination-number">{totalPages}</a>
                            </>
                    )}

                    <!-- Botón siguiente -->
                    <a href={`?page=${Math.min(totalPages, page + 1)}`}
                       class={`pagination-btn ${page === totalPages ? 'disabled' : ''}`}
                       aria-disabled={page === totalPages}>
                        Siguiente
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                </div>
            </div>
        </nav>
    </nav>
</section>

<style is:global>
    .text-coral-red {
        color: #E63946;
    }

    .bg-coral-red {
        background-color: #E63946;
    }

    .bg-coral-red-light {
        background-color: #ff8f9c;
    }

    .bg-coral-red-dark {
        background-color: #e8495a;
    }

    #toggleSidebar:checked ~ #sidebar {
        transform: translateX(0);
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes slideInScale {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .grid > div {
        animation: slideInScale 0.6s ease-out forwards;
        opacity: 0;
    }

    /* Estilos para asegurar que todas las cards tengan el mismo tamaño */
    .card-wrapper {
        height: 100%;
        display: flex;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .card-wrapper:hover {
        transform: translateY(-8px) scale(1.02);
        z-index: 10;
    }

    .card-wrapper > :global(*) {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* Si el componente CardMovie tiene su propia estructura interna */
    .card-wrapper :global(.card),
    .card-wrapper :global(article),
    .card-wrapper :global(div) {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* Aseguramos que la imagen mantenga proporciones consistentes */
    .card-wrapper :global(img) {
        aspect-ratio: 2/3;
        object-fit: cover;
        width: 100%;
        transition: transform 0.3s ease;
    }

    .card-wrapper:hover :global(img) {
        transform: scale(1.05);
    }

    /* Si hay áreas de contenido, les permitimos expandirse según necesidad */
    .card-wrapper :global(.content),
    .card-wrapper :global(.card-body) {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    /* Aseguramos que los títulos tengan altura consistente y manejen overflow */
    .card-wrapper :global(h2),
    .card-wrapper :global(h3),
    .card-wrapper :global(.title) {
        height: 2.5rem;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    /* Para descripciones u overviews, también controlamos la altura */
    .card-wrapper :global(p),
    .card-wrapper :global(.overview),
    .card-wrapper :global(.description) {
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }

    /* Paginación mejorada */
    .pagination-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 1.25rem;
        border-radius: 1rem;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        color: #374151;
        background: linear-gradient(135deg, #F9FAFB 0%, #F3F4F6 100%);
        border: 1px solid #E5E7EB;
        position: relative;
        overflow: hidden;
    }

    .pagination-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(230, 57, 70, 0.1), transparent);
        transition: left 0.5s;
    }

    .pagination-btn:hover:not(.disabled)::before {
        left: 100%;
    }

    .pagination-btn:hover:not(.disabled) {
        background: linear-gradient(135deg, #E63946 0%, #e8495a 100%);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(230, 57, 70, 0.25);
        border-color: #E63946;
    }

    .pagination-btn.disabled {
        opacity: 0.4;
        cursor: not-allowed;
        pointer-events: none;
        background: #F3F4F6;
    }

    .pagination-btn-mobile {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1rem 1.5rem;
        border-radius: 1rem;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        color: #374151;
        background: linear-gradient(135deg, #F9FAFB 0%, #F3F4F6 100%);
        border: 1px solid #E5E7EB;
        min-height: 3rem;
    }

    .pagination-btn-mobile:hover:not(.disabled) {
        background: linear-gradient(135deg, #E63946 0%, #e8495a 100%);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(230, 57, 70, 0.25);
    }

    .pagination-btn-mobile.disabled {
        opacity: 0.4;
        cursor: not-allowed;
        pointer-events: none;
    }

    .pagination-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 1rem;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        color: #6B7280;
        background-color: transparent;
        position: relative;
    }

    .pagination-number:hover:not(.active) {
        background: linear-gradient(135deg, #F3F4F6 0%, #E5E7EB 100%);
        color: #374151;
        transform: scale(1.1);
    }

    .pagination-number.active {
        background: linear-gradient(135deg, #E63946 0%, #e8495a 100%);
        color: white;
        box-shadow: 0 6px 20px rgba(230, 57, 70, 0.3);
        transform: scale(1.1);
    }

    /* Mejoras responsive */
    @media (max-width: 640px) {
        .grid {
            gap: 1rem;
        }

        .card-wrapper:hover {
            transform: translateY(-4px) scale(1.01);
        }
    }

    @media (min-width: 1280px) {
        .xl\:grid-cols-6 {
            grid-template-columns: repeat(6, minmax(0, 1fr));
        }
    }
</style>