---
import { posterUrl } from "../../services/API/shared/tmdbClient";
import type { ContinueWatchingItem } from "../../services/API/Series/continueWatching";
import Stamp from "../Stamp.astro";

interface Props {
    items: ContinueWatchingItem[];
}

const { items } = Astro.props;
---
{items.length > 0 && (
    <section class="continue-watching-section mb-8">
        <header class="flex items-center justify-between mb-4 px-1">
            <div class="flex items-center gap-2">
                <Stamp color="green" icon="play" size={32} />
                <h2 class="text-lg sm:text-xl font-bold text-gray-800 uppercase tracking-wide">Continuar viendo</h2>
            </div>
            <a href="/personal/siguiendo" class="text-sm text-blue-600 hover:text-blue-800 font-medium">Ver todo →</a>
        </header>

        <div class="continue-watching-scroll flex gap-4 overflow-x-auto pb-4 px-1 snap-x snap-mandatory">
            {items.map((item) => (
                <a
                    href={`/serie/${item.id}#season-${item.next_season}`}
                    class="continue-watching-card flex-shrink-0 w-36 sm:w-40 snap-start group"
                    aria-label={`Continuar ${item.name}, Temporada ${item.next_season} Episodio ${item.next_episode}: ${item.next_episode_name}`}
                >
                    <div class="relative rounded-xl overflow-hidden shadow-md group-hover:shadow-xl transition-shadow duration-300 aspect-[2/3] bg-gray-200">
                        <img
                            src={posterUrl(item.poster_path) || '/placeholder.jpg'}
                            alt={item.name}
                            loading="lazy"
                            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                        />
                        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/95 via-black/75 to-transparent p-2.5 pt-8">
                            <p class="text-[10px] font-bold text-blue-300 tracking-wider">
                                T{item.next_season} · E{item.next_episode}
                            </p>
                            <p class="text-xs text-white font-medium line-clamp-2 mt-0.5 leading-snug">
                                {item.next_episode_name}
                            </p>
                        </div>
                    </div>
                    <p class="mt-2 text-sm font-semibold text-gray-800 line-clamp-1">{item.name}</p>
                </a>
            ))}
        </div>
    </section>
)}

<style>
    .continue-watching-scroll {
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }
    .continue-watching-scroll::-webkit-scrollbar {
        height: 6px;
    }
    .continue-watching-scroll::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 3px;
    }
</style>
