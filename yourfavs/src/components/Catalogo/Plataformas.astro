---
import CardMovie from "../Cards/CardMovie.astro";
import CardSerie from "../Cards/CardSerie.astro";
import {
    getNetflixSeries,
    getAmazonPrimeSeries,
    getDisneyPlusSeries,
    getHBOMaxSeries,
    getAppleTVSeries,
    getMovistarPlusSeries,
    getFilminSeries
} from "../../services/API/Series/tmdbSeries";
import {
    getNetflixMovies,
    getAmazonPrimeMovies,
    getDisneyPlusMovies,
    getHBOMaxMovies,
    getAppleTVMovies,
    getMovistarPlusMovies,
    getFilminMovies
} from "../../services/API/Movies/tmdbMovies";

// Import the types from your type definition files
import type {Movie} from "../../types/ApiMovie";
import type {Serie} from "../../types/ApiSerie";

// Obtener parámetros desde la URL
const urlParams = new URL(Astro.url, Astro.request.url).searchParams;
const page = Number(urlParams.get('page')) || 1;
const pageStr = page.toString();
const platformParam = urlParams.get('platform') || 'all';
const type = urlParams.get('type') || 'all'; // 'all', 'movies', 'series'

// Definir plataformas disponibles
const platforms = [
    {id: 'netflix', name: 'NETFLIX', logo: '/logos/plataformas/netflix.svg'},
    {id: 'amazon', name: 'AMAZON PRIME', logo: '/logos/plataformas/amazon.svg'},
    {id: 'disney', name: 'DISNEY+', logo: '/logos/plataformas/disney.svg'},
    {id: 'hbo', name: 'HBO MAX', logo: '/logos/plataformas/hbo.svg'},
    {id: 'apple', name: 'APPLE TV+', logo: '/logos/plataformas/apple.svg'},
    {id: 'movistar', name: 'MOVISTAR+', logo: '/logos/plataformas/movistar.svg'},
    {id: 'filmin', name: 'FILMIN', logo: '/logos/plataformas/filmin.svg'}
];

// Cargar las películas y series para la página actual basado en la plataforma seleccionada
let movies: Movie[] = [];
let series: Serie[] = [];

// Función para eliminar duplicados en arrays de películas o series por ID
function removeDuplicates<T extends { id: number }>(items: T[]): T[] {
    return items.filter((item, index, self) =>
        index === self.findIndex((t) => t.id === item.id)
    );
}

// Cargar todo el contenido si no hay filtro o filtrar por plataforma
if (platformParam === 'all') {
    // Cargar todas las plataformas con los parámetros de ordenación
    const netflixSeries = await getNetflixSeries(pageStr);
    const netflixMovies = await getNetflixMovies(pageStr);
    const amazonPrimeSeries = await getAmazonPrimeSeries(pageStr);
    const amazonPrimeMovies = await getAmazonPrimeMovies(pageStr);
    const disneyPlusSeries = await getDisneyPlusSeries(pageStr);
    const disneyPlusMovies = await getDisneyPlusMovies(pageStr);
    const hboMaxSeries = await getHBOMaxSeries(pageStr);
    const hboMaxMovies = await getHBOMaxMovies(pageStr);
    const appleTVSeries = await getAppleTVSeries(pageStr);
    const appleTVMovies = await getAppleTVMovies(pageStr);
    const movistarPlusSeries = await getMovistarPlusSeries(pageStr);
    const movistarPlusMovies = await getMovistarPlusMovies(pageStr);
    const filminSeries = await getFilminSeries(pageStr);
    const filminMovies = await getFilminMovies(pageStr);

    // Combinar todos los resultados
    const allMovies = [
        ...netflixMovies,
        ...amazonPrimeMovies,
        ...disneyPlusMovies,
        ...hboMaxMovies,
        ...appleTVMovies,
        ...movistarPlusMovies,
        ...filminMovies
    ];

    const allSeries = [
        ...netflixSeries,
        ...amazonPrimeSeries,
        ...disneyPlusSeries,
        ...hboMaxSeries,
        ...appleTVSeries,
        ...movistarPlusSeries,
        ...filminSeries
    ];

    // Eliminar duplicados
    movies = removeDuplicates(allMovies);
    series = removeDuplicates(allSeries);

} else {
    // Filtrar por plataforma seleccionada con parámetros de ordenación
    switch (platformParam) {
        case 'netflix':
            movies = await getNetflixMovies(pageStr);
            series = await getNetflixSeries(pageStr);
            break;
        case 'amazon':
            movies = await getAmazonPrimeMovies(pageStr);
            series = await getAmazonPrimeSeries(pageStr);
            break;
        case 'disney':
            movies = await getDisneyPlusMovies(pageStr);
            series = await getDisneyPlusSeries(pageStr);
            break;
        case 'hbo':
            movies = await getHBOMaxMovies(pageStr);
            series = await getHBOMaxSeries(pageStr);
            break;
        case 'apple':
            movies = await getAppleTVMovies(pageStr);
            series = await getAppleTVSeries(pageStr);
            break;
        case 'movistar':
            movies = await getMovistarPlusMovies(pageStr);
            series = await getMovistarPlusSeries(pageStr);
            break;
        case 'filmin':
            movies = await getFilminMovies(pageStr);
            series = await getFilminSeries(pageStr);
            break;
    }
}

// Función para crear URL con parámetros actualizados
function createUrlWithParams(newParams: Record<string, string>) {
    const currentParams = new URLSearchParams(urlParams);

    // Actualizar con nuevos parámetros
    Object.entries(newParams).forEach(([key, value]) => {
        currentParams.set(key, value);
    });

    // Si cambiamos sortBy, platform o cualquier parámetro que requiera reiniciar página, volvemos a página 1
    if (newParams.sortBy || newParams.platform) {
        currentParams.set('page', '1');
    }

    return `?${currentParams.toString()}`;
}

// Función para obtener el nombre del género
function getGenreName(id: number) {
    // Implementar lógica para obtener el nombre del género
    const genres: Record<number, string> = {
        28: 'Acción',
        12: 'Aventura',
        16: 'Animación',
        35: 'Comedia',
        80: 'Crimen',
        99: 'Documental',
        18: 'Drama',
        10751: 'Familia',
        14: 'Fantasía',
        36: 'Historia',
        27: 'Terror',
        10402: 'Música',
        9648: 'Misterio',
        10749: 'Romance',
        878: 'Ciencia ficción',
        10770: 'Película de TV',
        53: 'Thriller',
        10752: 'Guerra',
        37: 'Western'
    };
    return genres[id] || 'Desconocido';
}

// Total de páginas
const totalPages = 190;
---
<section class="px-1 sm:py-8">
    <!-- Header mejorado -->
    <header class="text-center mb-6">
        <div class="inline-flex items-center gap-3 mb-4">
            <h1 class="text-coral-red font-bold text-4xl md:text-5xl lg:text-6xl text-center mb-2">
                PLATAFORMAS
            </h1>
        </div>
        <div class="w-24 h-1 bg-coral-red mx-auto rounded-full mb-4"></div>
        <p class="text-gray-600 text-lg max-w-xl mx-auto leading-relaxed">
            Explora las películas y series disponibles según tu plataforma preferida
        </p>
        <div class="w-20 h-1 bg-gradient-to-r from-coral-red to-coral-red-light mx-auto rounded-full mt-4"></div>
    </header>

    <!-- Filtro de Plataformas -->
    <section class="mb-8">
        <h3 class="text-xl font-semibold text-gray-700 mb-4">Filtrar por plataforma</h3>
        <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 xl:grid-cols-8 gap-4">
            <a href={createUrlWithParams({platform: 'all'})}
               class={`flex flex-col items-center justify-center p-4 rounded-xl border transition-all shadow-sm hover:shadow-md hover:scale-105 ${
                   platformParam === 'all'
                       ? 'bg-ice-blue text-white border-ice-blue'
                       : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50'
               }`}>
                <span class="text-sm font-medium">Todas</span>
            </a>

            {platforms.map((platform) => (
                    <a href={createUrlWithParams({platform: platform.id})}
                       class={`flex flex-col items-center justify-center p-4 rounded-xl border transition-all shadow-sm hover:shadow-md hover:scale-105 ${
                           platformParam === platform.id
                               ? 'bg-ice-blue text-white border-ice-blue'
                               : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50'
                       }`}>
                        <img src={platform.logo} alt={platform.name} class="w-10 h-10 mb-2 object-contain"/>
                        <span class="text-xs font-medium text-center">{platform.name}</span>
                    </a>
            ))}
        </div>
    </section>

    <!-- Navegación de filtros mejorada -->
    <div class="flex justify-center sticky top-5 z-40 mb-8">
        <div class="inline-flex bg-white/95 backdrop-blur-md rounded-2xl p-2 shadow-lg border border-gray-200">
            <a href={`?page=1&type=all&platform=${platformParam}`}
               class={`filter-btn ${type === 'all' ? 'active' : ''}`}>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M19 11H5m14-4H3m16 8H7m10 4H5"/>
                </svg>
                Todo
            </a>
            <a href={`?page=1&type=movies&platform=${platformParam}`}
               class={`filter-btn ${type === 'movies' ? 'active' : ''}`}>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                </svg>
                Películas
            </a>
            <a href={`?page=1&type=series&platform=${platformParam}`}
               class={`filter-btn ${type === 'series' ? 'active' : ''}`}>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                Series
            </a>
        </div>
    </div>

    <!-- Información de paginación superior mejorada y más responsive -->
    <div class="bg-gradient-to-r from-white to-gray-50 rounded-2xl p-4 md:p-6 mb-8 shadow-sm border border-gray-100">
        <div class="flex flex-col gap-6 md:gap-4 md:flex-row md:items-center md:justify-between">

            <!-- Info de página -->
            <div class="flex items-center gap-3">
                <div class="flex items-center justify-center w-10 h-10 bg-coral-red/10 rounded-xl shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-coral-red" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                </div>
                <div class="text-sm">
                    <div class="font-semibold text-gray-900">
                        Página <span class="text-coral-red">{page}</span> de <span
                            class="text-coral-red">{totalPages}</span>
                    </div>
                </div>
            </div>

            <!-- Stats adicionales -->
            <div class="flex flex-wrap justify-start md:justify-end items-center gap-x-4 gap-y-2 text-sm">
                <div class="flex items-center gap-2 text-gray-600">
                    <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                    <span>Actualizado hoy</span>
                </div>

                <div class="flex items-center gap-2 text-gray-600">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                    </svg>
                    <span>Plataformas</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Título de plataforma seleccionada y criterio de ordenación -->
    <section class="mb-6 text-center">
        <h2 class="text-2xl font-bold text-gray-800">
            <span>
        Mostrando {
                type === 'all'
                    ? ' contenido'
                    : type === 'movies'
                        ? 'películas'
                        : 'series'
            } de {
                platformParam === 'all'
                    ? 'todas las plataformas'
                    : platforms.find(p => p.id === platformParam)?.name
            }
    </span>
        </h2>
    </section>

    <!-- Sección de Películas -->
    {(type === 'all' || type === 'movies') && movies.length > 0 && (
            <div class="mb-12" id="peliculas">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 bg-gradient-to-br bg-coral-red rounded-xl flex items-center justify-center shadow-md">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                        </svg>
                    </div>
                    <h2 class="text-2xl md:text-3xl font-bold text-gray-800">Películas</h2>
                    <div class="flex-1 h-px bg-gradient-to-r from-gray-300 to-transparent"></div>
                </div>

                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
                    {
                        movies.map((item) => (
                                <div class="card-wrapper group">
                                    <CardMovie
                                            id={item.id.toString()}
                                            img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                            title={item.title}
                                            vote_average={item.vote_average}
                                            overview={item.overview}
                                            release_date={item.release_date}
                                            genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                    />
                                </div>
                        ))
                    }
                </div>
            </div>
    )}

    <!-- Sección de Series -->
    {(type === 'all' || type === 'series') && series.length > 0 && (
            <div class="mb-12" id="series">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center shadow-md">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <h2 class="text-2xl md:text-3xl font-bold text-gray-800">Series</h2>
                    <div class="flex-1 h-px bg-gradient-to-r from-gray-300 to-transparent"></div>
                </div>
                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
                    {
                        series.map((item) => (
                                <div class="card-wrapper group">
                                    <CardSerie
                                            id={item.id.toString()}
                                            img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                            name={item.name}
                                            vote_average={item.vote_average}
                                            overview={item.overview}
                                            first_air_date={item.first_air_date}
                                            seasons={item.seasons}
                                            last_episode_to_air={item.last_episode_to_air}
                                            next_episode_to_air={item.next_episode_to_air}
                                            genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                    />
                                </div>
                        ))
                    }
                </div>
            </div>
    )}

    <!-- Mensaje cuando no hay resultados -->
    {movies.length === 0 && series.length === 0 && (
            <div class="text-center py-12">
                <h3 class="text-2xl font-medium mb-2 text-gray-700">No se encontraron resultados</h3>
                <p class="text-gray-600">Intenta con otra plataforma o página</p>
            </div>
    )}

    <!-- Paginación mejorada -->
    <nav aria-label="Paginación" class="mt-12">
        <!-- Navegación móvil -->
        <div class="flex sm:hidden items-center justify-between bg-white rounded-xl p-4 shadow-sm border border-gray-100">
            <a href={`?page=${Math.max(1, page - 1)}&type=${type}&platform=${platformParam}`}
               class={`pagination-btn-mobile ${page === 1 ? 'disabled' : ''}`}
               aria-disabled={page === 1}>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                Anterior
            </a>

            <div class="flex items-center gap-2 px-4">
                <span class="text-sm text-gray-600">Página</span>
                <span class="px-3 py-1 bg-coral-red text-white rounded-lg font-semibold text-sm">{page}</span>
                <span class="text-sm text-gray-600">/{totalPages}</span>
            </div>

            <a href={`?page=${Math.min(totalPages, page + 1)}&type=${type}&platform=${platformParam}`}
               class={`pagination-btn-mobile ${page === totalPages ? 'disabled' : ''}`}
               aria-disabled={page === totalPages}>
                Siguiente
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </a>
        </div>

        <!-- Navegación escritorio -->
        <div class="hidden sm:flex justify-center">
            <div class="inline-flex items-center bg-white rounded-xl p-2 shadow-sm border border-gray-100">
                <!-- Botón anterior -->
                <a href={`?page=${Math.max(1, page - 1)}&type=${type}&platform=${platformParam}`}
                   class={`pagination-btn ${page === 1 ? 'disabled' : ''}`}
                   aria-disabled={page === 1}>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Anterior
                </a>

                <!-- Primera página -->
                {page > 2 && (
                        <>
                            <a href={`?page=1&type=${type}&platform=${platformParam}`} class="pagination-number">1</a>
                            {page > 3 && <span class="px-2 text-gray-400">...</span>}
                        </>
                )}

                <!-- Página anterior -->
                {page > 1 && (
                        <a href={`?page=${page - 1}&type=${type}&platform=${platformParam}`}
                           class="pagination-number">{page - 1}</a>
                )}

                <!-- Página actual -->
                <span class="pagination-number active">{page}</span>

                <!-- Página siguiente -->
                {page < totalPages && (
                        <a href={`?page=${page + 1}&type=${type}&platform=${platformParam}`}
                           class="pagination-number">{page + 1}</a>
                )}

                <!-- Última página -->
                {page < totalPages - 1 && (
                        <>
                            {page < totalPages - 2 && <span class="px-2 text-gray-400">...</span>}
                            <a href={`?page=${totalPages}&type=${type}&platform=${platformParam}`}
                               class="pagination-number">{totalPages}</a>
                        </>
                )}

                <!-- Botón siguiente -->
                <a href={`?page=${Math.min(totalPages, page + 1)}&type=${type}&platform=${platformParam}`}
                   class={`pagination-btn ${page === totalPages ? 'disabled' : ''}`}
                   aria-disabled={page === totalPages}>
                    Siguiente
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>
    </nav>
</section>

<style is:global>
    html {
        scroll-behavior: smooth;
    }

    .text-coral-red {
        color: #E63946;
    }

    .bg-coral-red {
        background-color: #E63946;
    }

    .border-coral-red {
        border-color: #E63946;
    }

    .underline-custom {
        text-decoration: underline;
        text-decoration-color: #E63946; /* el color coral */
    }

    #toggleSidebar:checked ~ #sidebar {
        transform: translateX(0);
    }

    .bg-ice-blue {
        background-color: #3B82F6;
    }

    .border-ice-blue {
        border-color: #3B82F6;
    }

    /* Estilos para asegurar cards del mismo tamaño */
    .card-wrapper {
        display: flex;
        height: 100%;
    }

    .card-wrapper > * {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
    }

    /* Asegurar que todas las imágenes tengan el mismo tamaño */
    .card-wrapper img {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
    }

    /* Asegurar que los títulos tengan una altura fija */
    .card-wrapper h3,
    .card-wrapper h4 {
        height: 3em;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    /* Para el contenido de la tarjeta */
    .card-wrapper > div {
        display: flex;
        flex-direction: column;
        flex: 1;
        background-color: white;
        border-radius: 0.5rem;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        height: 100%;
    }

    /* Para descripciones/overview */
    .card-wrapper p {
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        flex-grow: 1;
    }

    @media (prefers-color-scheme: dark) {
        .card-wrapper > div {
            background-color: #1E1E1E;
            color: #E5E5E5;
        }
    }

    @keyframes click-bounce {
        0% {
            transform: scale(1);
        }
        50% {
            transform: scale(0.93);
        }
        100% {
            transform: scale(1);
        }
    }

    .button-bounce:active {
        animation: click-bounce 0.25s ease-in-out;
    }

    /* Por defecto, mostrar ambas secciones */
    #peliculas, #series {
        display: block;
    }

    /* Cuando se hace clic en "Ir a Películas" (#peliculas está activo) */
    #peliculas:target ~ #series {
        display: none;
    }

    /* Cuando se hace clic en "Ir a Series" (#series está activo) */
    #series:target ~ #peliculas {
        display: none;
    }

    /* Alternativa más específica si la anterior no funciona debido a la estructura HTML */
    body:has(#peliculas:target) #series {
        display: none;
    }

    body:has(#series:target) #peliculas {
        display: none;
    }

    /* Filtros mejorados */
    .filter-btn {
        display: inline-flex;
        align-items: center;
