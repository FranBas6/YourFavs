---
interface Props {
  variant?: 'detail' | 'actor';
  class?: string;
}

const { variant = 'detail', class: className = '' } = Astro.props;
---

<div class={`relative overflow-hidden rounded-2xl bg-gray-900 animate-pulse ${className}`} aria-hidden="true">
  <div class="aspect-[16/9] md:aspect-[21/9] bg-gray-800"></div>

  <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/60 to-transparent"></div>

  <div class="absolute bottom-0 inset-x-0 p-4 sm:p-6 md:p-8 flex flex-col sm:flex-row gap-4 sm:gap-6">
    {variant === 'detail' && (
      <div class="hidden sm:block flex-shrink-0 w-32 md:w-40 lg:w-48 aspect-[2/3] bg-gray-700 rounded-xl"></div>
    )}
    {variant === 'actor' && (
      <div class="flex-shrink-0 w-24 sm:w-32 md:w-40 aspect-square bg-gray-700 rounded-full"></div>
    )}

    <div class="flex-1 space-y-3">
      <div class="h-7 sm:h-8 md:h-10 bg-gray-700 rounded w-3/4"></div>
      <div class="h-4 bg-gray-700 rounded w-1/2"></div>
      <div class="flex flex-wrap gap-2 pt-1">
        <div class="h-6 w-16 bg-gray-700 rounded-full"></div>
        <div class="h-6 w-20 bg-gray-700 rounded-full"></div>
        <div class="h-6 w-14 bg-gray-700 rounded-full"></div>
      </div>
      <div class="space-y-2 pt-2 hidden sm:block">
        <div class="h-3 bg-gray-700 rounded w-full"></div>
        <div class="h-3 bg-gray-700 rounded w-5/6"></div>
        <div class="h-3 bg-gray-700 rounded w-4/6"></div>
      </div>
    </div>
  </div>
</div>
