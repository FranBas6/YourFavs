---
import CardMovie from "../Cards/CardMovie.astro";
import CardSerie from "../Cards/CardSerie.astro";
import {
    getSeriesVerPronto,
    clearAllSeriesVerPronto
} from "../../services/BD/yourfavsSerie";
import {
    getMoviesVerPronto,
    clearAllMoviesVerPronto
} from "../../services/BD/yourfavsMovie";

// Variable para manejar acciones de borrado y mensajes
let clearedType = null;

// Manejar acciones de borrado ANTES de obtener datos
if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const clearAction = formData.get("clear");

    if (clearAction === "series") {
        await clearAllSeriesVerPronto();
        clearedType = "series";
    } else if (clearAction === "peliculas") {
        await clearAllMoviesVerPronto();
        clearedType = "peliculas";
    } else if (clearAction === "todos") {
        await clearAllSeriesVerPronto();
        await clearAllMoviesVerPronto();
        clearedType = "todos";
    }
}

const seriesVerPronto = await getSeriesVerPronto()
const peliculasVerPronto = await getMoviesVerPronto()

// Obtener parámetros de la URL
const filter = Astro.url.searchParams.get("filter") || "todos";
const searchQuery = Astro.url.searchParams.get("search") || "";
const genreFilter = Astro.url.searchParams.get("genre") || "";

// Determinar qué mostrar
const showSeries = filter === "series" || filter === "todos";
const showMovies = filter === "peliculas" || filter === "todos";
const showAll = filter === "todos";

type UrlParams = {
    filter?: string;
    search?: string;
    genre?: string;
};

// Función para construir URLs manteniendo los parámetros actuales
function buildUrl({filter, search = searchQuery, genre = genreFilter}: UrlParams): string {
    const params = new URLSearchParams();
    if (filter) params.set("filter", filter);
    if (search) params.set("search", search);
    if (genre) params.set("genre", genre);

    const queryString = params.toString();
    return `/personal/verpronto${queryString ? "?" + queryString : ""}`;
}


// Mensaje de confirmación si se borró algo
const clearedMessage = clearedType || Astro.url.searchParams.get("cleared");
---
<div class="favorites-container max-w-7xl mx-auto px-4 py-8">
    <!-- Primera barra de navegación - Filtros de contenido con botones de borrar -->
    <nav class="z-50 bg-gradient-to-r from-blue-900 to-indigo-900 backdrop-blur-lg shadow-xl rounded-2xl px-6 py-4 mb-4">
        <div class="flex flex-wrap justify-center items-center gap-4">
            <!-- Filtros de contenido -->
            <div class="flex flex-wrap justify-center gap-4">
                <a href={buildUrl({filter: 'todos'})}
                   class={`px-5 py-2 rounded-full text-sm font-semibold tracking-wide transition-all
                     ${showAll ? "bg-white text-blue-900 ring-2 ring-white shadow-lg scale-105" :
                       "bg-blue-700 text-white hover:bg-blue-600 hover:scale-105"}`}>
                    Todo el contenido
                </a>
                <a href={buildUrl({filter: 'series'})}
                   class={`px-5 py-2 rounded-full text-sm font-semibold tracking-wide transition-all
                     ${showSeries && !showAll ? "bg-white text-blue-900 ring-2 ring-white shadow-lg scale-105" :
                       "bg-blue-700 text-white hover:bg-blue-600 hover:scale-105"}`}>
                    Series
                </a>
                <a href={buildUrl({filter: 'peliculas'})}
                   class={`px-5 py-2 rounded-full text-sm font-semibold tracking-wide transition-all
                     ${showMovies && !showAll ? "bg-white text-blue-900 ring-2 ring-white shadow-lg scale-105" :
                       "bg-blue-700 text-white hover:bg-blue-600 hover:scale-105"}`}>
                    Películas
                </a>
            </div>

            <!-- Botones de borrar -->
            <div class="flex flex-wrap justify-center gap-2">
                {/* Botón borrar todo (solo si hay contenido) */}
                {(seriesVerPronto.length > 0 || peliculasVerPronto.length > 0) && showAll && (
                        <form method="POST" class="inline">
                            <input type="hidden" name="filter" value={filter}/>
                            <button
                                    type="submit"
                                    name="clear"
                                    value="todos"
                                    class="px-3 py-1.5 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors duration-200 flex items-center gap-1 text-xs font-medium">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20"
                                     fill="currentColor">
                                    <path fill-rule="evenodd"
                                          d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z"
                                          clip-rule="evenodd"/>
                                </svg>
                                Borrar todo
                            </button>
                        </form>
                )}

                {/* Botón borrar series */}
                {seriesVerPronto.length > 0 && (showSeries || showAll) && (
                        <form method="POST" class="inline">
                            <input type="hidden" name="filter" value={filter}/>
                            <button
                                    type="submit"
                                    name="clear"
                                    value="series"
                                    class="px-3 py-1.5 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors duration-200 flex items-center gap-1 text-xs font-medium">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20"
                                     fill="currentColor">
                                    <path fill-rule="evenodd"
                                          d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z"
                                          clip-rule="evenodd"/>
                                </svg>
                                Borrar series
                            </button>
                        </form>
                )}

                {/* Botón borrar películas */}
                {peliculasVerPronto.length > 0 && (showMovies || showAll) && (
                        <form method="POST" class="inline">
                            <input type="hidden" name="filter" value={filter}/>
                            <button
                                    type="submit"
                                    name="clear"
                                    value="peliculas"
                                    class="px-3 py-1.5 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors duration-200 flex items-center gap-1 text-xs font-medium">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20"
                                     fill="currentColor">
                                    <path fill-rule="evenodd"
                                          d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z"
                                          clip-rule="evenodd"/>
                                </svg>
                                Borrar películas
                            </button>
                        </form>
                )}
            </div>
        </div>
    </nav>

    <!-- Barra de navegación secundaria (Categorías) -->
    <nav class="bg-white rounded-xl shadow-sm border border-gray-200 mb-8 overflow-hidden">
        <div class="container mx-auto px-4 py-2">
            <div class="flex flex-wrap justify-center gap-3 items-center">
                <a href="/personal/favoritos"
                   class="flex-shrink-0 px-4 py-2 rounded-lg transition-all duration-300 font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 hover:scale-105">
                <span class="flex items-center whitespace-nowrap">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-yellow-500" viewBox="0 0 20 20"
                         fill="currentColor">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    Favoritos
                </span>
                </a>
                <a href="/personal/pendientes"
                   class="flex-shrink-0 px-4 py-2 rounded-lg transition-all duration-300 font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 hover:scale-105">
                <span class="flex items-center whitespace-nowrap">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-blue-500" viewBox="0 0 20 20"
                         fill="currentColor">
                        <path fill-rule="evenodd"
                              d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"
                              clip-rule="evenodd"/>
                    </svg>
                    Pendientes
                </span>
                </a>

                {/* Mostrar "Siguiendo" solo si NO está en modo de películas */}
                {!showMovies || showAll ? (
                        <a href="/personal/siguiendo"
                           class="flex-shrink-0 px-4 py-2 rounded-lg transition-all duration-300 font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 hover:scale-105">
                    <span class="flex items-center whitespace-nowrap">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-purple-500"
                                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"
                                     stroke-linejoin="round" width="24" height="24" stroke-width="2">
                                    <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
                                    <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"></path>
                                </svg>
                                Siguiendo
                            </span>
                        </a>
                ) : null}

                <a href="/personal/megusta"
                   class="flex-shrink-0 px-4 py-2 rounded-lg transition-all duration-300 font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 hover:scale-105">
                    <span class="flex items-center whitespace-nowrap">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-pink-500" viewBox="0 0 20 20"
                             fill="currentColor">
                            <path fill-rule="evenodd"
                                  d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z"
                                  clip-rule="evenodd"/>
                        </svg>
                        Me gustan
                    </span>
                </a>

                <a href="/personal/vistos"
                   class="flex-shrink-0 px-4 py-2 rounded-lg transition-all duration-300 font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 hover:scale-105">
                    <span class="flex items-center whitespace-nowrap">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-green-500"
                                 viewBox="0 0 20 20"
                                 fill="currentColor">
                                <path fill-rule="evenodd"
                                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                      clip-rule="evenodd"/>
                            </svg>
                            Vistos
                        </span>
                </a>
                <a href="/personal/verpronto"
                   class="flex-shrink-0 px-4 py-2 rounded-lg transition-all duration-300 font-medium text-white bg-gradient-to-r from-indigo-500 to-indigo-600 shadow-md transform scale-105">
                        <span class="flex items-center whitespace-nowrap">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-white" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                <line x1="8" y1="21" x2="16" y2="21"/>
                                <line x1="12" y1="17" x2="12" y2="21"/>
                                <polygon points="10,8 16,12 10,16"/>
                            </svg>
                            Ver pronto
                        </span>
                </a>
                <a href="/personal/recomendaciones"
                   class="flex-shrink-0 px-4 py-2 rounded-lg transition-all duration-300 font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 hover:scale-105">
                    <span class="flex items-center whitespace-nowrap">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-orange-500" viewBox="0 0 20 20"
                     fill="currentColor">
                    <path
                            d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                Recomendadas
            </span>
                </a>
            </div>
        </div>
    </nav>

    <!-- Mensaje de confirmación -->
    {clearedMessage && (
            <div class="mb-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
                <div class="flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                              clip-rule="evenodd"/>
                    </svg>
                    {clearedMessage === 'series' ? 'Series borradas exitosamente' :
                        clearedMessage === 'peliculas' ? 'Películas borradas exitosamente' :
                            'Todo el contenido borrado exitosamente'}
                </div>
            </div>
    )}

    <!-- Contenedor principal de contenido -->
    <div class="content-sections space-y-12">
        {/* SECCIÓN DE VER PRONTO */}
        <div class="favorites-section animate-fadeIn">
            <div class="section-header flex items-center gap-4 mb-6">
                <div class="flex-grow h-0.5 bg-gradient-to-r "></div>
                <h2 class="text-2xl font-bold text-gray-800 flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 mr-2 text-indigo-500" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                        <line x1="8" y1="21" x2="16" y2="21"/>
                        <line x1="12" y1="17" x2="12" y2="21"/>
                        <polygon points="10,8 16,12 10,16"/>
                    </svg>
                    Ver Pronto
                </h2>
                <div class="flex-grow h-0.5 bg-gradient-to-r "></div>
            </div>

            {/* Series Ver Pronto */}
            {(showSeries || showAll) && (
                    <section class="mb-8">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4 flex justify-between items-center bg-blue-50 rounded-lg px-4 py-3 border-l-4 border-blue-500">
                            <span class="flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                                </svg>
                            Series para ver Pronto
                            </span>
                            <span class="text-sm text-blue-600 bg-blue-100 rounded-full px-3 py-1 font-bold">
                                {seriesVerPronto.length}
                            </span>
                        </h3>

                        {seriesVerPronto.length === 0 ? (
                                <div class="empty-state bg-gradient-to-br from-blue-50 to-indigo-50 border-2 border-dashed border-blue-300 rounded-xl p-8 text-center">
                                    <div class="max-w-sm mx-auto">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             class="h-16 w-16 mx-auto text-blue-400 mb-4" fill="none"
                                             viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                                  d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                                        </svg>
                                        <h3 class="text-xl font-semibold text-blue-800 mb-2">
                                            Aún no tienes series para ver pronto
                                        </h3>
                                        <p class="text-blue-600">
                                            Explora el catálogo y guarda las series que quieres ver próximamente.
                                        </p>
                                    </div>
                                </div>
                        ) : (
                                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                                    {seriesVerPronto.map((item) => (
                                            <CardSerie
                                                    id={item.id.toString()}
                                                    img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                    name={item.name}
                                                    vote_average={item.vote_average}
                                                    overview={item.overview}
                                                    first_air_date={item.first_air_date}
                                                    seasons={item.seasons}
                                                    last_episode_to_air={item.last_episode_to_air}
                                                    next_episode_to_air={item.next_episode_to_air}
                                                    status={item.status}
                                            />
                                    ))}
                                </div>
                        )}
                    </section>
            )}

            {/* Películas Ver Pronto */}
            {(showMovies || showAll) && (
                    <section class="mb-8">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4 flex justify-between items-center bg-red-50 rounded-lg px-4 py-3 border-l-4 border-red-500">
                            <span class="flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-600" fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                </svg>
                                Películas para ver Pronto
                            </span>
                            <span class="text-sm text-red-600 bg-red-100 rounded-full px-3 py-1 font-bold">
                                {peliculasVerPronto.length}
                                </span>
                        </h3>

                        {peliculasVerPronto.length === 0 ? (
                                <div class="empty-state bg-gradient-to-br from-red-50 to-indigo-50 border-2 border-dashed border-red-200 rounded-xl p-8 text-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-red-400 mb-4"
                                         fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                              d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                                    </svg>
                                    <h3 class="text-xl font-semibold text-red-800 mb-2">
                                        Aún no tienes películas para ver pronto
                                    </h3>
                                    <p class="text-red-600">
                                        Explora el catálogo y guarda las películas que quieres ver próximamente.
                                    </p>
                                </div>
                        ) : (
                                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                                    {peliculasVerPronto.map((item) => (
                                            <CardMovie
                                                    id={item.id.toString()}
                                                    img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                    title={item.title}
                                                    vote_average={item.vote_average}
                                                    overview={item.overview}
                                                    release_date={item.release_date}
                                            />
                                    ))}
                                </div>
                        )}
                    </section>
            )}
        </div>
    </div>
</div>

<style>
    /* Animaciones */
    .animate-fadeIn {
        animation: fadeIn 0.5s ease-in-out;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Aumentar el tamaño de las tarjetas al pasar el mouse */
    :global(.favorites-container .grid > div) {
        transition: all 0.3s ease;
    }

    :global(.favorites-container .grid > div:hover) {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }

    /* Scroll horizontal suave para navegación */
    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }

    /* Mejora visual para filtros activos */
    .search-panel {
        border: 1px solid #e5e7eb;
    }

    /* Estados hover mejorados */
    .search-toggle-btn:hover .toggle-text {
        letter-spacing: 0.02em;
    }

    /* Transiciones más suaves */
    .content-sections > div {
        transition: all 0.3s ease-out;
    }

    /* Grid más consistente */
    .grid {
        gap: 1.25rem;
    }

    @media (min-width: 768px) {
        .grid {
            gap: 1.5rem;
        }
    }
</style>