---
// Sección "Doblajes" para la página de actor. Lista lo que el actor ha DOBLADO
// (solo tiene datos si es doblador español). Carga lazy al hacer scroll hasta
// aquí; si el actor no es doblador, la sección se queda oculta.
interface Props {
    tmdbId: number | string;
    name: string;
}
const { tmdbId, name } = Astro.props;
---
<div data-actor-dubbing data-id={String(tmdbId)} data-name={name}>
    <div data-dub-sentinel class="h-px w-full"></div>
    <section data-dub-section class="hidden mt-6">
        <details class="group bg-purple-50/40 rounded-xl border border-purple-200" open>
            <summary class="flex items-center justify-between gap-3 p-4 cursor-pointer">
                <h3 class="text-lg font-semibold text-gray-800 flex items-center gap-2">
                    <span class="w-1 h-6 bg-purple-500 rounded-full"></span>
                    Doblajes
                    <span data-dub-count class="text-sm font-normal text-gray-400"></span>
                </h3>
                <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
            </summary>
            <div class="px-4 pb-4">
                <p data-dub-loading class="flex items-center gap-2 py-2 text-sm text-gray-500">
                    <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.4 0 0 5.4 0 12h4z"/></svg>
                    Buscando doblajes en eldoblaje.com…
                </p>
                <div data-dub-list class="hidden"></div>
                <div data-dub-footer class="hidden mt-3 flex items-center justify-between gap-3">
                    <a data-dub-credit href="#" target="_blank" rel="noopener noreferrer" class="text-xs text-gray-400 hover:text-gray-600">Ficha completa en eldoblaje.com ↗</a>
                    <button type="button" data-dub-refresh class="text-xs text-gray-400 hover:text-purple-600 inline-flex items-center gap-1 flex-shrink-0">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                        Refrescar
                    </button>
                </div>
            </div>
        </details>
    </section>
</div>

<script>
    document.querySelectorAll('[data-actor-dubbing]').forEach((root) => {
        const id = (root as HTMLElement).dataset.id;
        const name = (root as HTMLElement).dataset.name || '';
        const sentinel = root.querySelector('[data-dub-sentinel]') as HTMLElement;
        const section = root.querySelector('[data-dub-section]') as HTMLElement;
        const loading = root.querySelector('[data-dub-loading]') as HTMLElement;
        const list = root.querySelector('[data-dub-list]') as HTMLElement;
        const count = root.querySelector('[data-dub-count]') as HTMLElement;
        const footer = root.querySelector('[data-dub-footer]') as HTMLElement;
        const credit = root.querySelector('[data-dub-credit]') as HTMLAnchorElement;
        const refreshBtn = root.querySelector('[data-dub-refresh]') as HTMLButtonElement;
        let loaded = false;

        const esc = (s: string) =>
            (s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c));

        async function load(refresh = false) {
            loaded = true;
            section.classList.remove('hidden'); // mostramos con spinner mientras busca
            loading.classList.remove('hidden');
            list.classList.add('hidden');
            footer.classList.add('hidden');
            try {
                const url = `/api/dubbing-actor/${id}?name=${encodeURIComponent(name)}${refresh ? '&refresh=1' : ''}`;
                const res = await fetch(url);
                const data = await res.json();
                loading.classList.add('hidden');

                if (data.source === 'eldoblaje' && data.items?.length) {
                    list.innerHTML = data.items.map(renderItem).join('');
                    list.classList.remove('hidden');
                    count.textContent = `(${data.items.length})`;
                    if (data.dubberUrl) credit.href = data.dubberUrl;
                    footer.classList.remove('hidden');
                } else if (refresh) {
                    // Refresco manual sin resultado: avisamos en vez de desaparecer.
                    list.innerHTML = '<p class="py-2 text-sm text-gray-400">No se encontraron doblajes para este actor.</p>';
                    list.classList.remove('hidden');
                    count.textContent = '';
                } else {
                    // Carga inicial sin datos → ocultar la sección entera, sin dejar rastro.
                    section.classList.add('hidden');
                }
            } catch {
                if (!refresh) section.classList.add('hidden');
                else loading.classList.add('hidden');
            }
        }

        const observer = new IntersectionObserver((entries) => {
            if (entries.some((e) => e.isIntersecting) && !loaded) {
                observer.disconnect();
                load();
            }
        }, { rootMargin: '300px' });
        observer.observe(sentinel);
        refreshBtn?.addEventListener('click', () => load(true));

        function renderItem(it: any) {
            const ext = it.internal ? '' : 'target="_blank" rel="noopener noreferrer"';
            const tag = it.mediaType === 'movie'
                ? '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-red-500 text-white flex-shrink-0">Peli</span>'
                : it.mediaType === 'tv'
                    ? '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-blue-500 text-white flex-shrink-0">Serie</span>'
                    : '';
            const sub = [esc(it.originalActor), esc(it.character)].filter(Boolean).join(' · ');
            return `
                <a href="${it.url}" ${ext} class="flex items-center gap-3 py-2 border-b border-purple-100/60 last:border-0 hover:bg-purple-50/60 -mx-2 px-2 rounded transition-colors">
                    ${tag}
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-gray-800 truncate">${esc(it.title)}</p>
                        ${sub ? `<p class="text-xs text-gray-500 truncate">${sub}</p>` : ''}
                    </div>
                    ${it.year ? `<span class="text-xs text-gray-400 flex-shrink-0">${it.year}</span>` : ''}
                </a>`;
        }
    });
</script>
