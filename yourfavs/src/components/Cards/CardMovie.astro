---
import '../../styles/components/cards.css';
import {formatCardDate, getRatingColor, isRecentRelease} from "../../utils/constants/helpers/card-helpers";
import { formatScore } from "../../utils/constants/helpers/media-helpers";

interface Props {
    id: string;
    title: string;
    img: string;
    vote_average: number;
    overview: string;
    release_date?: string;
    genres?: { id: number, name: string }[];
    character?: string;
    /** Nota personal (1-10) guardada en Firestore; pinta el badge ámbar "★ N". */
    userRating?: number;
    /** 4.4 · "Porque viste X": semilla que originó la reco (solo en recomendaciones). */
    seedTitle?: string;
}

const { id, title, img, vote_average, overview, release_date, genres, character, userRating, seedTitle } = Astro.props;

const placeholderImg = "/placeholder.jpg";
const isNew = isRecentRelease(release_date);
const isTrending = vote_average >= 8.0;

// "Guardar en…" es una acción de descubrimiento: en catálogo y en recomendaciones
// (sugerencias que aún no tienes). Dentro de "Mis listas" la card ya está guardada → oculto.
const _p = Astro.url.pathname;
// El ⊕ se muestra fuera de /mislistas y, dentro, en recomendaciones + las listas
// fijas donde el marcado reubica la card en vivo (Pendientes/Vistas/Favoritos).
const showSaveBtn = !_p.startsWith('/mislistas') || _p.startsWith('/mislistas/recomendaciones')
    || _p.startsWith('/mislistas/pendientes') || _p.startsWith('/mislistas/vistos') || _p.startsWith('/mislistas/favoritos');
---
<div class="media-card group">
    <a href={`/movie/${id}`}
       class="flex flex-col rounded-xl overflow-hidden bg-midnight-blue hover:bg-dark-blue transition-all duration-300 h-full border border-white/5 hover:border-white/15 relative">

        <!-- Badges -->
        {(isNew || isTrending) && (
            <div class="absolute top-2 left-2 z-10 flex flex-col gap-1 items-start">
                {isNew && <span class="top-badge bg-teal-500 text-white">NUEVO</span>}
                {isTrending && <span class="top-badge badge-accent">TRENDING</span>}
            </div>
        )}

        <!-- Poster -->
        <div class="relative overflow-hidden">
            <img class="w-full aspect-[2/3] object-cover transition-transform duration-500 group-hover:scale-105"
                 src={img || placeholderImg}
                 alt={`Poster de ${title}`}
                 loading="lazy"
                 onerror={`this.onerror=null; this.src='${placeholderImg}'`}/>

            <!-- Rating badge (película: icono clapeta) -->
            <div class={`rating-badge ${getRatingColor(vote_average)}`}>
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                {vote_average ? vote_average.toFixed(1) : "N/A"}
            </div>

            {userRating && <div class="user-rating-badge">★ {formatScore(userRating)}</div>}

            <div class="absolute bottom-0 inset-x-0 h-16 bg-gradient-to-t from-[#0F172A] to-transparent"></div>

            <!-- Quick-save "Guardar en…" (Fase L4): <span> (no es interactive content) → válido dentro del <a>; el JS para la navegación -->
            {showSaveBtn && (
                <span role="button" tabindex="0"
                      class="card-saveto js-saveto absolute bottom-2 right-2 z-20 w-9 h-9 rounded-full bg-black/60 hover:bg-[#E63946] backdrop-blur text-white inline-flex items-center justify-center opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity cursor-pointer"
                      data-mt="movie" data-id={id} data-title={title} data-poster={img} aria-label="Guardar en tus listas">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                </span>
            )}
        </div>

        <!-- Content -->
        <div class="p-3.5 flex flex-col flex-grow">
            {seedTitle && (
                <p class="flex items-center gap-1 text-[11px] text-white/55 mb-1.5 line-clamp-1" title={`Porque viste ${seedTitle}`}>
                    <svg class="w-3 h-3 text-amber-400 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l1.9 5.6L19.5 9l-5.6 1.9L12 16l-1.9-5.1L4.5 9l5.6-1.4L12 2z"/></svg>
                    <span class="truncate">Porque viste <span class="font-semibold text-white/90">{seedTitle}</span></span>
                </p>
            )}
            <h2 class="text-sm sm:text-base font-semibold text-white leading-snug mb-1.5 line-clamp-2">{title}</h2>

            {character && (
                <p class="text-xs text-blue-300/70 italic mb-1.5">{character}</p>
            )}

            {genres && genres.length > 0 && (
                <div class="flex flex-wrap gap-1 mb-2">
                    {genres.slice(0, 2).map(genre => (
                        <span class="genre-tag">{genre.name}</span>
                    ))}
                </div>
            )}

            <p class="text-xs text-coral-white leading-relaxed mb-2 flex-grow line-clamp-2 sm:line-clamp-3">{overview}</p>

            {release_date && (
                <div class="info-pill mb-2">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    {formatCardDate(release_date)}
                </div>
            )}
        </div>
    </a>
</div>
