---
import Layout from '../../layouts/Layout.astro';
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import {getSeriesPendientes} from "../../services/BD/series/yourfavsSerie";
import {getMoviesPendientes} from "../../services/BD/movies/yourfavsMovie";
import {getGenreName} from "../../utils/constants/genres";
import {buildUrl} from "../../utils/buildUrl";
import {fetchPersonalPageData} from "../../utils/personalPageHelper";
import ListHeader from "../../components/personal/ListHeader.astro";
import ListsNav from "../../components/personal/ListsNav.astro";
import PersonalResultsBar from "../../components/personal/PersonalResultsBar.astro";
import EmptyState from "../../components/EmptyState.astro";
import WhatToWatch from "../../components/personal/WhatToWatch.astro";
import { recommendedByMap } from "../../services/BD/social/recommendations";
import { SOCIAL_PHASE } from "../../utils/constants/social";
import { safeFetch } from "../../utils/safeFetch";
import '../../styles/pages/personal/personal.css';

const data = await fetchPersonalPageData(
    { getSeries: getSeriesPendientes, getMovies: getMoviesPendientes },
    Astro.url
);

const {
    filter, searchQuery, genreFilter, platformFilter,
    showSeries, showMovies, showAll,
    seriesPage, moviesPage, pageUrl, itemsPerPage,
    filteredSeries, filteredMovies,
    seriesPaginadas, peliculasPaginadas,
    hasMoreSeries, hasMoreMovies,
    seriesItemsToShow, moviesItemsToShow,
    availableGenres, availableTags, tagsFilter, stats, watchedMap, errorMessage,
} = data;

// F4 social: «Recomendada por Ana» en lo que añadiste desde una recomendación.
const _me = Astro.locals.user?.uid;
const recByMap = SOCIAL_PHASE.recommend && _me
    ? await safeFetch(recommendedByMap(_me), 'pendientes/recommendedBy', new Map<string, { name: string; more: number }>())
    : new Map<string, { name: string; more: number }>();
---
<Layout title="Pendientes">
    <ListsNav slot="aside" />
    <section class="px-1 sm:py-8">
        {errorMessage && (
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm mb-6">
                {errorMessage}
            </div>
        )}

        {/* Cabecera de lista (rediseño 5.2): título con total, Todo · Películas · Series, Filtros y un solo orden */}
        <ListHeader
            title="Pendientes" subtitle="Series y películas que quieres ver" total={stats?.general?.totalContent ?? (filteredSeries.length + filteredMovies.length)}
            pageUrl={pageUrl} filter={filter} searchQuery={searchQuery} genreFilter={genreFilter} platformFilter={platformFilter}
            tagsFilter={tagsFilter} availableGenres={availableGenres} availableTags={availableTags}
            myPlatforms={Astro.locals.user?.platforms ?? []} stats={stats} sorts={[{ key: '', label: 'Añadidos recientes' }]}
        >
            <WhatToWatch slot="actions" />
        </ListHeader>

        <PersonalResultsBar
            shown={seriesPaginadas.length + peliculasPaginadas.length}
            total={filteredSeries.length + filteredMovies.length}
            movies={filteredMovies.length}
            series={filteredSeries.length}
        />

        <div class="space-y-10">
            {/* Series */}
            {(showSeries || showAll) && (
                <section id="series-section" class="scroll-mt-20">
                    <div class="lg-h"><h2>Series</h2><span class="n">{filteredSeries.length}</span></div>

                    {seriesPaginadas.length === 0 && (
                        <EmptyState size="sm" title="Aún no tienes series en esta colección">
                            <a slot="cta" href="/catalogo/tendencias" class="btn btn--sm">Explorar tendencias</a>
                        </EmptyState>
                    )}
                    {seriesPaginadas.length > 0 && (
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                            {seriesPaginadas.map((item: any) => (
                                <CardSerie
                                    id={item.id.toString()}
                                    img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                    name={item.name}
                                    vote_average={item.vote_average}
                                    overview={item.overview}
                                    first_air_date={item.first_air_date}
                                    seasons={item.seasons}
                                    last_episode_to_air={item.last_episode_to_air}
                                    next_episode_to_air={item.next_episode_to_air}
                                    genres={item.genre_ids?.map((gId: number) => ({ id: gId, name: getGenreName(gId) }))}
                                    status={item.status}
                                    watchedEpisodes={watchedMap[String(item.id)]?.watched}
                                    userRating={(item as any).userRating}
                                    recommendedBy={recByMap.get(`tv:${item.id}`)}
                                />
                            ))}
                        </div>
                    )}
                    {hasMoreSeries && (
                        <div class="lg-more">
                            <span class="lg-more-n">Mostrando <b>{seriesPaginadas.length}</b> de {filteredSeries.length}</span>
                            <a class="btn" href={buildUrl(pageUrl, { seriesPage: (seriesPage + 1).toString(), moviesPage: moviesPage.toString() }) + '#series-section'}>
                                Mostrar {Math.min(itemsPerPage, filteredSeries.length - seriesItemsToShow)} más
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                            </a>
                            <a class="lg-more-all" href={buildUrl(pageUrl, { seriesPage: Math.ceil(filteredSeries.length / itemsPerPage).toString(), moviesPage: moviesPage.toString() }) + '#series-section'}>Ver todas</a>
                        </div>
                    )}
                </section>
            )}

            {/* Películas */}
            {(showMovies || showAll) && (
                <section id="movies-section" class="scroll-mt-20">
                    <div class="lg-h"><h2>Películas</h2><span class="n">{filteredMovies.length}</span></div>

                    {peliculasPaginadas.length === 0 && (
                        <EmptyState size="sm" title="Aún no tienes películas en esta colección">
                            <a slot="cta" href="/catalogo/tendencias" class="btn btn--sm">Explorar tendencias</a>
                        </EmptyState>
                    )}
                    {peliculasPaginadas.length > 0 && (
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                            {peliculasPaginadas.map((item: any) => (
                                <CardMovie
                                    id={item.id.toString()}
                                    img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                    title={item.title}
                                    vote_average={item.vote_average}
                                    overview={item.overview}
                                    release_date={item.release_date}
                                    genres={item.genre_ids?.map((gId: number) => ({ id: gId, name: getGenreName(gId) }))}
                                    userRating={(item as any).userRating}
                                    recommendedBy={recByMap.get(`movie:${item.id}`)}
                                />
                            ))}
                        </div>
                    )}
                    {hasMoreMovies && (
                        <div class="lg-more">
                            <span class="lg-more-n">Mostrando <b>{peliculasPaginadas.length}</b> de {filteredMovies.length}</span>
                            <a class="btn" href={buildUrl(pageUrl, { moviesPage: (moviesPage + 1).toString(), seriesPage: seriesPage.toString() }) + '#movies-section'}>
                                Mostrar {Math.min(itemsPerPage, filteredMovies.length - moviesItemsToShow)} más
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                            </a>
                            <a class="lg-more-all" href={buildUrl(pageUrl, { moviesPage: Math.ceil(filteredMovies.length / itemsPerPage).toString(), seriesPage: seriesPage.toString() }) + '#movies-section'}>Ver todas</a>
                        </div>
                    )}
                </section>
            )}
        </div>
    </section>
</Layout>
