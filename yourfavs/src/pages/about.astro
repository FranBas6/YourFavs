---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Sobre YourFavs">
    <div class="container mx-auto px-6 py-10 bg-light-gray min-h-screen">
        <!-- Hero con decoración SVG -->
        <div class="relative bg-gradient-to-r from-indigo-100 via-white to-indigo-50 rounded-2xl p-10 shadow-inner overflow-hidden mb-10">
            <h1 class="text-5xl font-extrabold text-center text-slate-800 drop-shadow-lg animate-fade-in">
                YourFavs: Tu Universo Cinematográfico Personal
            </h1>
            <div class="absolute bottom-0 right-0 opacity-10 w-40 h-40">
                <!-- SVG de carrete de cine -->
                <svg viewBox="0 0 64 64" fill="currentColor" class="w-full h-full text-indigo-400">
                    <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="4" fill="none"/>
                    <circle cx="32" cy="32" r="6" fill="currentColor"/>
                    <circle cx="32" cy="10" r="4" fill="currentColor"/>
                    <circle cx="32" cy="54" r="4" fill="currentColor"/>
                    <circle cx="10" cy="32" r="4" fill="currentColor"/>
                    <circle cx="54" cy="32" r="4" fill="currentColor"/>
                </svg>
            </div>
        </div>

        <hr class="border-t-2 border-indigo-200 my-12 rounded-full w-1/3 mx-auto">

        <!-- Secciones -->
        <section class="max-w-3xl mx-auto mb-10 bg-white p-8 rounded-2xl shadow-xl border-l-8 border-indigo-500 hover:shadow-2xl transition">
            <h2 class="text-2xl font-semibold text-slate-700 mb-4">¿Qué es YourFavs?</h2>
            <p class="text-lg text-slate-600 leading-relaxed">
                YourFavs es mucho más que una simple app de películas. Es tu santuario cinéfilo, donde tú decides qué guardar, cómo organizar y cuándo disfrutar.
                Aquí las historias viven para ti, con funciones pensadas para que todo esté a un clic: favoritas, pendientes, vistas, recomendaciones automáticas y mucho más.
            </p>
        </section>

        <hr class="border-t-2 border-indigo-200 my-12 rounded-full w-1/3 mx-auto">

        <!-- Funcionalidades -->
        <section class="grid md:grid-cols-3 gap-6 mb-10">
            <!-- Explora -->
            <div class="bg-white rounded-2xl p-6 shadow-lg border-b-4 border-blue-400 hover:shadow-2xl hover:-translate-y-1 transition">
                <h3 class="text-xl font-semibold text-slate-700 mb-3">🎥 Explora</h3>
                <ul class="space-y-2 text-slate-600 text-sm">
                    <li>🌟 Películas y series populares del momento</li>
                    <li>🆕 Últimos lanzamientos en cine y TV</li>
                    <li>🏆 Rankings de lo más valorado por la comunidad</li>
                    <li>🔍 Búsqueda avanzada y detallada por título</li>
                    <li>📺 Filtros por plataformas como Netflix, HBO Max, Disney+ y más</li>
                </ul>
            </div>

            <!-- Organiza -->
            <div class="bg-white rounded-2xl p-6 shadow-lg border-b-4 border-green-400 hover:shadow-2xl hover:-translate-y-1 transition">
                <h3 class="text-xl font-semibold text-slate-700 mb-3">🗂️ Organiza</h3>
                <ul class="space-y-2 text-slate-600 text-sm">
                    <li>❤️ Guarda tus favoritos</li>
                    <li>👁️‍🗨️ Marca lo que ya has visto</li>
                    <li>⏳ Crea listas personalizadas (pendientes, siguiendo...)</li>
                    <li>📊 Consulta tus estadísticas personales</li>
                    <li>🗑️ Elimina lo que ya no quieras ver</li>
                </ul>
            </div>

            <!-- Descubre -->
            <div class="bg-white rounded-2xl p-6 shadow-lg border-b-4 border-purple-400 hover:shadow-2xl hover:-translate-y-1 transition">
                <h3 class="text-xl font-semibold text-slate-700 mb-3">🧠 Descubre</h3>
                <ul class="space-y-2 text-slate-600 text-sm">
                    <li>✨ Recomendaciones basadas en tus gustos</li>
                    <li>🎭 Información de reparto y directores</li>
                    <li>🔗 Visualiza sagas y conexiones entre películas</li>
                    <li>🎞️ Mira trailers de YouTube directamente</li>
                    <li>📚 Explora por géneros como acción, comedia o misterio</li>
                </ul>
            </div>
        </section>

        <hr class="border-t-2 border-indigo-200 my-12 rounded-full w-1/3 mx-auto">

        <!-- Tecnologías -->
        <section class="bg-white p-8 rounded-2xl shadow-xl border-l-8 border-rose-400 hover:shadow-2xl transition mb-10">
            <h2 class="text-2xl font-semibold mb-4 text-slate-700">Tecnologías que lo hacen posible</h2>
            <div class="flex flex-wrap justify-center gap-4">
                <span class="tech-badge bg-blue-100 text-blue-800">🚀 Astro</span>
                <span class="tech-badge bg-cyan-100 text-cyan-800">🎨 Tailwind CSS</span>
                <span class="tech-badge bg-yellow-100 text-yellow-800">🔐 Firebase</span>
                <span class="tech-badge bg-red-100 text-red-800">🎬 TMDB API</span>
                <span class="tech-badge bg-purple-100 text-purple-800">📊 TypeScript</span>
            </div>
        </section>

        <hr class="border-t-2 border-indigo-200 my-12 rounded-full w-1/3 mx-auto">

        <!-- Footer -->
        <footer class="text-center text-sm text-slate-500 mt-16 italic tracking-wide">
            Hecho con <span class="text-red-500">❤️</span> por ti, para ti.<br />
            Tu pasión merece su propio universo.
        </footer>

        <!-- Botón CTA centrado -->
        <div class="flex justify-center mt-7">
            <a href="/" class="inline-block bg-indigo-600 text-white px-6 py-3 rounded-full shadow hover:bg-indigo-700 transition">
                Explora tus favoritos
            </a>
        </div>
    </div>

    <style>
        .tech-badge {
            @apply px-4 py-2 rounded-full text-sm font-medium shadow hover:scale-105 transition transform hover:shadow-md;
        }

        .bg-light-gray {
            background-color: #F3F4F6;
        }

        @media (max-width: 640px) {
            h1 {
                font-size: 2rem;
                line-height: 2.5rem;
            }
        }
    </style>
</Layout>