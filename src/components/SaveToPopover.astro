---
/**
 * Popover "Guardar en…" (Fase L4) — singleton montado una vez en el Layout.
 *
 * Cualquier disparador con `.js-saveto` + data-mt/data-id/data-title/data-poster
 * lo abre (cards y fichas). Carga la pertenencia (GET /api/lists?media_type&tmdb_id)
 * y permite togglear listas fijas (POST /api/lists/fixed) y colecciones propias
 * (POST /api/lists/items), además de crear una colección nueva en el sitio.
 *
 * Invitado (sin cookie has_session) → abre el modal de registro (gating), sin fetch.
 *
 * Recomendar (F4 social): con sesión, una fila final «Recomendar a un amigo…» (películas y series).
 * Al pulsarla, ESTE MISMO popover crece y pinta el selector de amigos (`window.yfRec.mountIn`, de
 * scripts/social/recommend.ts), con «‹ Volver a Guardar en…»; no se abre otra capa. Esc vuelve
 * primero a «Guardar en…» y la segunda vez cierra.
 */
---
<div class="saveto-backdrop" id="saveto-backdrop" hidden></div>
<div class="saveto-pop" id="saveto-pop" role="dialog" aria-label="Guardar en tus listas" hidden>
    <div class="saveto-arrow" aria-hidden="true"></div>
    <div class="saveto-sheet-handle" aria-hidden="true"></div>
    <div class="saveto-inner" id="saveto-inner">
        <p class="saveto-loading">Cargando…</p>
    </div>
</div>

<style is:global>
    .saveto-pop {
        position: fixed; z-index: 1300; width: 270px; max-width: calc(100vw - 24px);
        background: var(--bg-elev, #fff); color: var(--text, #16130f);
        border: 1px solid var(--border, #e5e7eb); border-radius: 14px;
        box-shadow: 0 20px 50px rgba(0,0,0,.25);
        padding: 10px 0; max-height: 70vh; overflow-y: auto;
    }
    .saveto-pop[hidden] { display: none; }
    .saveto-loading { font-size: 13px; color: var(--text-3, #9ca3af); padding: 8px 16px; margin: 0; }
    .saveto-kicker {
        font-family: var(--font-mono, monospace); font-size: 9.5px; letter-spacing: .13em;
        color: var(--text-3, #9ca3af); padding: 4px 16px 6px; text-transform: uppercase;
    }
    .saveto-sep { height: 1px; background: var(--border, #efeae0); margin: 8px 14px; }
    .saveto-row {
        display: flex; align-items: center; gap: 11px; width: 100%;
        padding: 9px 16px; background: none; border: none; cursor: pointer;
        font-family: inherit; font-size: 14px; color: var(--text, #16130f); text-align: left;
    }
    .saveto-row:hover { background: var(--bg-tint, #f6f3ec); }
    .saveto-row[disabled] { opacity: .6; cursor: default; }
    .saveto-emoji { font-size: 16px; width: 20px; text-align: center; flex-shrink: 0; }
    .saveto-name { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .saveto-check {
        width: 18px; height: 18px; border-radius: 5px; flex-shrink: 0;
        border: 1.5px solid var(--border, #d4ccb9);
        display: flex; align-items: center; justify-content: center; color: #fff;
    }
    .saveto-row.is-on .saveto-name { font-weight: 600; }
    .saveto-row.is-on .saveto-check { background: var(--accent-dark); border-color: var(--accent-dark); }
    .saveto-row .saveto-check svg { display: none; width: 13px; height: 13px; }
    .saveto-row.is-on .saveto-check svg { display: block; }
    .saveto-create { color: var(--accent-dark); font-weight: 600; font-size: 13.5px; }
    .saveto-create .saveto-emoji { color: var(--accent-dark); }
    [data-theme="dark"] .saveto-create, [data-theme="dark"] .saveto-create .saveto-emoji { color: var(--stamp-red-ink); }
    .saveto-newform { padding: 8px 16px; display: flex; gap: 7px; }
    .saveto-newform input {
        flex: 1; min-width: 0; border: 1.5px solid var(--border, #e2dccd); border-radius: 8px;
        padding: 7px 10px; font-size: 13px; font-family: inherit; background: var(--bg, #fff); color: var(--text, #16130f);
    }
    .saveto-newform input:focus { outline: none; border-color: var(--accent); }
    .saveto-newform button {
        flex-shrink: 0; border: none; background: var(--accent-dark); color: #fff; border-radius: 8px;
        padding: 0 12px; font-size: 13px; font-weight: 700; cursor: pointer;
    }

    /* Nota opcional al "Vuelto a ver" (§6 detalles con alma) — reusa el shell del popover. */
    .saveto-note { padding: 6px 16px 12px; }
    .saveto-note textarea {
        width: 100%; box-sizing: border-box; resize: vertical; min-height: 54px;
        border: 1.5px solid var(--border, #e2dccd); border-radius: 8px; padding: 8px 10px;
        font-size: 13px; font-family: inherit; line-height: 1.4;
        background: var(--bg, #fff); color: var(--text, #16130f);
    }
    .saveto-note textarea:focus { outline: none; border-color: var(--accent); }
    .saveto-note button {
        margin-top: 8px; width: 100%; border: none; background: var(--accent-dark); color: #fff;
        border-radius: 8px; padding: 9px 12px; font-size: 13.5px; font-weight: 700; cursor: pointer;
    }
    .saveto-note button:disabled { opacity: .6; cursor: default; }

    /* ── 2.2 · Hoja inferior (long-press): el mismo popover, presentado como sheet en móvil ── */
    .saveto-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 1290; }
    .saveto-backdrop[hidden] { display: none; }
    .saveto-sheet-handle { display: none; }
    .saveto-sheet-head { display: flex; align-items: center; gap: 11px; padding: 4px 16px 12px; }
    .saveto-sheet-poster {
        width: 38px; height: 57px; border-radius: 6px; object-fit: cover;
        flex-shrink: 0; background: var(--bg-tint, #eee);
    }
    .saveto-sheet-title { font-size: 14px; font-weight: 700; color: var(--text, #16130f); line-height: 1.25; }

    @media (max-width: 1023px) {
        .saveto-pop.saveto-sheet {
            left: 0 !important; right: 0; top: auto !important; bottom: 0;
            width: 100%; max-width: 100%;
            border-radius: 18px 18px 0 0;
            max-height: 82vh;
            padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
            animation: saveto-up .22s ease;
        }
        .saveto-pop.saveto-sheet .saveto-arrow { display: none; }
        .saveto-pop.saveto-sheet .saveto-sheet-handle {
            display: block; width: 36px; height: 4px; border-radius: 9px;
            background: var(--border, #e2dccd); margin: 8px auto 4px;
        }
        /* Targets táctiles más grandes en la hoja */
        .saveto-pop.saveto-sheet .saveto-row { padding-top: 12px; padding-bottom: 12px; }
        /* Evita el callout/popup de iOS al mantener pulsada la card */
        .media-card { -webkit-touch-callout: none; }
    }
    @keyframes saveto-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
</style>

<script is:inline>
(function () {
    var pop = document.getElementById('saveto-pop');
    var inner = document.getElementById('saveto-inner');
    if (!pop || !inner) return;

    // "Vuelto a ver" (ficha de pelis/series): abre un mini-popover con una nota
    // OPCIONAL ("¿con quién? ¿qué te pareció?") y registra el re-visionado en el
    // diario (WatchLog, append sin dedupe → rewatch=true). Recarga para refrescar
    // el "N veces". Guardar sin texto = un visionado sin nota, como antes.
    document.addEventListener('click', function (e) {
        var rb = e.target.closest && e.target.closest('.js-rewatch');
        if (!rb || rb.dataset.busy) return;
        e.preventDefault();
        if (!loggedIn()) { document.dispatchEvent(new CustomEvent('yf:require-auth')); return; }
        openNotePopover(rb);
    });

    var CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>';
    var FIXED = [
        { key: 'favorites', emoji: '❤️', label: 'Favoritos' },
        { key: 'pendientes', emoji: '🔖', label: 'Pendientes' },
        { key: 'vistas', emoji: '👁️', label: 'Vistas' },
    ];

    var cur = null; // { mt, id, title, poster }
    var busy = false;
    var lastData = null; // lo último pintado, para volver desde «Recomendar a un amigo…»
    var SEND_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>';
    var CHEV_ICON = '<svg class="saveto-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>';

    function loggedIn() {
        return document.cookie.split('; ').some(function (c) { return c.indexOf('has_session=') === 0; });
    }
    function normPoster(p) {
        if (!p) return null;
        var m = p.match(/\/t\/p\/w\d+(\/.+)$/);
        if (m) return m[1];
        if (p.charAt(0) === '/' && p.indexOf('.') > 0 && p.indexOf('placeholder') === -1) return p;
        return null;
    }
    function esc(s) { return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    var backdrop = document.getElementById('saveto-backdrop');
    function lockScroll() { document.body.style.overflow = 'hidden'; }
    function unlockScroll() { document.body.style.overflow = ''; }
    function close() {
        pop.hidden = true; cur = null;
        pop.classList.remove('saveto-sheet');
        pop.classList.remove('saveto-wide');
        if (window.yfRec) window.yfRec.forget();
        if (backdrop) backdrop.hidden = true;
        unlockScroll();
    }
    function isOpen() { return !pop.hidden; }

    function position(trigger) {
        pop.hidden = false; // medir con el real
        var r = trigger.getBoundingClientRect();
        var w = pop.offsetWidth, h = pop.offsetHeight;
        var left = Math.min(Math.max(8, r.right - w), window.innerWidth - w - 8);
        var top = r.bottom + 8;
        if (top + h > window.innerHeight - 8) top = Math.max(8, r.top - h - 8);
        pop.style.left = left + 'px';
        pop.style.top = top + 'px';
    }

    function render(data) {
        lastData = data;
        var memberIds = data.memberIds || [];
        var fixed = data.fixed || {};
        if (cur) cur.fixed = fixed; // estado previo (para un Deshacer fiel al reubicar)
        var lists = data.lists || [];
        var html = '';
        // En modo hoja (long-press) mostramos qué título estamos guardando.
        if (cur && cur.sheet) {
            html += '<div class="saveto-sheet-head">' +
                (cur.poster ? '<img class="saveto-sheet-poster" src="https://image.tmdb.org/t/p/w92' + cur.poster + '" alt="" />' : '') +
                '<div class="saveto-sheet-title">' + esc(cur.title) + '</div></div>';
        }
        // En las fichas, las listas fijas ya tienen sus botones → el popover solo
        // muestra colecciones (data-collections-only). En cards, muestra ambas.
        if (!cur.collectionsOnly) {
            html += '<div class="saveto-kicker">Listas</div>';
            FIXED.forEach(function (f) {
                var on = !!fixed[f.key];
                html += '<button type="button" class="saveto-row js-fixed' + (on ? ' is-on' : '') + '" data-list="' + f.key + '">' +
                    '<span class="saveto-emoji">' + f.emoji + '</span><span class="saveto-name">' + f.label + '</span>' +
                    '<span class="saveto-check">' + CHECK + '</span></button>';
            });
            html += '<div class="saveto-sep"></div>';
        }
        html += '<div class="saveto-kicker">Mis colecciones</div>';
        if (!lists.length) {
            html += '<p class="saveto-loading">Aún no tienes colecciones.</p>';
        } else {
            lists.forEach(function (l) {
                var on = memberIds.indexOf(l.id) >= 0;
                html += '<button type="button" class="saveto-row js-coll' + (on ? ' is-on' : '') + '" data-id="' + esc(l.id) + '">' +
                    '<span class="saveto-emoji">' + esc(l.icon || '🎬') + '</span><span class="saveto-name">' + esc(l.name) + '</span>' +
                    '<span class="saveto-check">' + CHECK + '</span></button>';
            });
        }
        html += '<div class="saveto-sep"></div>' +
            '<button type="button" class="saveto-row saveto-create js-create"><span class="saveto-emoji">+</span><span class="saveto-name">Crear nueva colección</span></button>';
        // F4 social: recomendar este título a un amigo, en este mismo popover.
        if (window.yfRec && cur && (cur.mt === 'movie' || cur.mt === 'tv')) {
            html += '<div class="saveto-sep"></div>' +
                '<button type="button" class="saveto-row saveto-rec js-rec" role="menuitem"><span class="saveto-emoji">' + SEND_ICON + '</span><span class="saveto-name">Recomendar a un amigo…</span>' + CHEV_ICON + '</button>';
        }
        inner.innerHTML = html;
    }

    function open(trigger) {
        cur = {
            mt: trigger.getAttribute('data-mt'),
            id: Number(trigger.getAttribute('data-id')),
            title: trigger.getAttribute('data-title') || '',
            poster: normPoster(trigger.getAttribute('data-poster')),
            collectionsOnly: !!trigger.getAttribute('data-collections-only'),
            trigger: trigger,
        };
        inner.innerHTML = '<p class="saveto-loading">Cargando…</p>';
        position(trigger);
        fetch('/api/lists?media_type=' + cur.mt + '&tmdb_id=' + cur.id)
            .then(function (r) {
                if (r.status === 401) { close(); document.dispatchEvent(new CustomEvent('yf:require-auth')); throw new Error('auth'); }
                return r.json();
            })
            .then(function (data) { if (cur) { render(data); position(trigger); } })
            .catch(function () {});
    }

    // Mismo popover, presentado como HOJA INFERIOR (long-press en cards, 2.2).
    function openSheet(trigger) {
        if (!trigger) return;
        cur = {
            mt: trigger.getAttribute('data-mt'),
            id: Number(trigger.getAttribute('data-id')),
            title: trigger.getAttribute('data-title') || '',
            poster: normPoster(trigger.getAttribute('data-poster')),
            collectionsOnly: false,
            sheet: true,
        };
        pop.classList.add('saveto-sheet');
        pop.style.left = ''; pop.style.top = '';   // limpiar posicionamiento de popover
        if (backdrop) backdrop.hidden = false;
        lockScroll();
        pop.hidden = false;
        inner.innerHTML = '<p class="saveto-loading">Cargando…</p>';
        fetch('/api/lists?media_type=' + cur.mt + '&tmdb_id=' + cur.id)
            .then(function (r) {
                if (r.status === 401) { close(); document.dispatchEvent(new CustomEvent('yf:require-auth')); throw new Error('auth'); }
                return r.json();
            })
            .then(function (data) { if (cur) render(data); })
            .catch(function () {});
    }

    // Mini-popover de NOTA para "Vuelto a ver" (reusa el shell: posición, cierre por
    // click-fuera/Escape). Nota opcional → POST /api/watchlog con `note`.
    function openNotePopover(trigger) {
        cur = {
            mt: trigger.getAttribute('data-mt'),
            id: Number(trigger.getAttribute('data-id')),
            note: true,
        };
        pop.classList.remove('saveto-sheet');
        pop.style.left = ''; pop.style.top = '';
        inner.innerHTML =
            '<div class="saveto-kicker">Vuelto a ver</div>' +
            '<div class="saveto-note">' +
                '<textarea maxlength="500" rows="2" placeholder="Nota (opcional): ¿con quién? ¿qué te pareció?"></textarea>' +
                '<button type="button">Guardar visionado</button>' +
            '</div>';
        pop.hidden = false;
        position(trigger);
        var ta = inner.querySelector('.saveto-note textarea');
        var sv = inner.querySelector('.saveto-note button');
        if (ta) { try { ta.focus(); } catch (_) {} }
        function submit() {
            if (!cur || sv.disabled) return;
            sv.disabled = true;
            fetch('/api/watchlog', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    op: 'append', media_type: cur.mt, tmdb_id: cur.id,
                    note: (ta && ta.value.trim()) || undefined,
                }),
            })
                .then(function (r) { if (r.status === 401) { document.dispatchEvent(new CustomEvent('yf:require-auth')); throw new Error('auth'); } return r.json(); })
                .then(function (res) { if (!res.ok) throw new Error(); location.reload(); })
                .catch(function () { sv.disabled = false; });
        }
        if (sv) sv.addEventListener('click', submit);
        if (ta) ta.addEventListener('keydown', function (e) {
            if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') { e.preventDefault(); submit(); }
        });
    }

    // ---- long-press en cards de descubrimiento → hoja inferior ----
    var lpTimer = null, lpTrig = null, lpX = 0, lpY = 0, lpFired = false;
    function lpFind(target) {
        var card = target.closest && target.closest('.media-card');
        return card ? card.querySelector('.js-saveto') : null;
    }
    document.addEventListener('touchstart', function (e) {
        if (e.touches.length !== 1) return;
        if (e.target.closest('.js-saveto')) return;   // el ⊕ ya tiene su propio tap
        var trig = lpFind(e.target);
        if (!trig) return;
        lpTrig = trig; lpFired = false;
        lpX = e.touches[0].clientX; lpY = e.touches[0].clientY;
        lpTimer = setTimeout(function () {
            lpTimer = null; lpFired = true;
            if (!loggedIn()) { document.dispatchEvent(new CustomEvent('yf:require-auth')); return; }
            if (navigator.vibrate) { try { navigator.vibrate(15); } catch (_) {} }
            openSheet(lpTrig);
        }, 480);
    }, { passive: true });
    document.addEventListener('touchmove', function (e) {
        if (!lpTimer) return;
        var t = e.touches[0];
        if (Math.abs(t.clientX - lpX) > 12 || Math.abs(t.clientY - lpY) > 12) { clearTimeout(lpTimer); lpTimer = null; }
    }, { passive: true });
    document.addEventListener('touchend', function (e) {
        if (lpTimer) { clearTimeout(lpTimer); lpTimer = null; }
        if (lpFired) { e.preventDefault(); lpFired = false; }   // corta la navegación del <a>
    }, { passive: false });
    document.addEventListener('touchcancel', function () { if (lpTimer) { clearTimeout(lpTimer); lpTimer = null; } }, { passive: true });
    document.addEventListener('contextmenu', function (e) { if (lpFind(e.target)) e.preventDefault(); });

    // ---- arrastrar hacia abajo (asa/cabecera) para cerrar la hoja ----
    (function () {
        var startY = 0, dy = 0, dragging = false;
        function isSheet() { return pop.classList.contains('saveto-sheet'); }
        pop.addEventListener('touchstart', function (e) {
            if (!isSheet() || e.touches.length !== 1) return;
            if (!e.target.closest('.saveto-sheet-handle, .saveto-sheet-head')) return;
            dragging = true; dy = 0; startY = e.touches[0].clientY;
            pop.style.transition = 'none';
        }, { passive: true });
        pop.addEventListener('touchmove', function (e) {
            if (!dragging) return;
            dy = Math.max(0, e.touches[0].clientY - startY);
            pop.style.transform = 'translateY(' + dy + 'px)';
            if (dy > 0) e.preventDefault();
        }, { passive: false });
        function end() {
            if (!dragging) return; dragging = false;
            if (dy > 110) { pop.style.transition = ''; pop.style.transform = ''; close(); }
            else { pop.style.transition = 'transform .2s ease'; pop.style.transform = '';
                   setTimeout(function () { pop.style.transition = ''; }, 220); }
        }
        pop.addEventListener('touchend', end, { passive: true });
        pop.addEventListener('touchcancel', end, { passive: true });
    })();

    // ---- disparadores (delegado, captura para adelantarnos a la navegación del <a>) ----
    document.addEventListener('click', function (e) {
        var trigger = e.target.closest && e.target.closest('.js-saveto');
        if (trigger) {
            e.preventDefault(); e.stopPropagation();
            if (!loggedIn()) { document.dispatchEvent(new CustomEvent('yf:require-auth')); return; }
            if (isOpen() && cur && cur.id === Number(trigger.getAttribute('data-id')) && cur.mt === trigger.getAttribute('data-mt')) { close(); return; }
            open(trigger);
            return;
        }
        // click fuera → cerrar
        if (isOpen() && !pop.contains(e.target)) close();
    }, true);

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && isOpen()) { close(); return; }
        // span role="button": activar con Enter/Espacio
        if ((e.key === 'Enter' || e.key === ' ') && e.target && e.target.classList && e.target.classList.contains('js-saveto')) {
            e.preventDefault();
            e.target.click();
        }
    });
    // Con el selector de recomendar dentro, el teclado del móvil cambia el tamaño: no se cierra.
    window.addEventListener('resize', function () { if (isOpen() && !pop.classList.contains('saveto-wide')) close(); });
    // Desplazar DENTRO del popover (la lista de amigos) no lo cierra; desplazar la página, sí.
    window.addEventListener('scroll', function (e) {
        if (e.target && e.target.nodeType === 1 && pop.contains(e.target)) return;
        if (isOpen() && !pop.classList.contains('saveto-sheet')) close();
    }, true);

    // ---- toggles dentro del popover ----
    inner.addEventListener('click', function (e) {
        if (busy || !cur) return;
        // F4 social: «Recomendar a un amigo…» → el selector de amigos en este mismo popover.
        if (e.target.closest('.js-rec') && window.yfRec) {
            var trig = cur.trigger;
            pop.classList.add('saveto-wide');
            window.yfRec.mountIn(inner, { type: cur.mt, id: cur.id, title: cur.title, image: cur.poster }, function () {
                pop.classList.remove('saveto-wide');
                if (cur && lastData) { render(lastData); if (trig && !cur.sheet) position(trig); }
                var row = inner.querySelector('.js-rec'); if (row) row.focus();
            }, !!cur.sheet);
            if (trig && !cur.sheet) position(trig);
            return;
        }
        var fixedBtn = e.target.closest('.js-fixed');
        var collBtn = e.target.closest('.js-coll');
        var createBtn = e.target.closest('.js-create');

        if (fixedBtn) {
            var on = fixedBtn.classList.contains('is-on');
            var snap = snapshot();
            var list = fixedBtn.getAttribute('data-list');
            // Reubicación en vivo: si estamos en una página de lista fija y el marcado
            // saca la card de ella (p.ej. marcar Vista en Pendientes), la card se
            // desvanece. Capturamos la card en el momento del toggle (el popover se cierra).
            var reloc = currentListKey();
            var cardEl = reloc ? cardOf(cur && cur.trigger) : null;
            var priorFixed = (reloc && cur && cur.fixed)
                ? { favorites: !!cur.fixed.favorites, pendientes: !!cur.fixed.pendientes, vistas: !!cur.fixed.vistas }
                : null;
            toggle(fixedBtn, function () { return postFixed(snap, list, on ? 'remove' : 'add'); }, {
                label: fixedLabel(list), countKey: 'count',
                // El "#N" (posición) solo tiene sentido en SERIES → Favoritos (las únicas
                // que se ordenan por ese número). En el resto el número no aporta.
                showCount: list === 'favorites' && snap.mt === 'tv',
                undo: function () { return postFixed(snap, list, on ? 'add' : 'remove'); },
                reloc: reloc, cardEl: cardEl, snap: snap, priorFixed: priorFixed,
            });
            return;
        }
        if (collBtn) {
            var onC = collBtn.classList.contains('is-on');
            var snapC = snapshot();
            var collId = collBtn.getAttribute('data-id');
            var nameEl = collBtn.querySelector('.saveto-name');
            var collName = nameEl ? nameEl.textContent : 'la colección';
            toggle(collBtn, function () { return postColl(snapC, collId, onC ? 'remove' : 'add'); }, {
                label: collName, countKey: 'itemCount',
                undo: function () { return postColl(snapC, collId, onC ? 'add' : 'remove'); },
            });
            return;
        }
        if (createBtn) {
            showCreateForm();
        }
    });

    function toggle(btn, doFetch, meta) {
        busy = true;
        var wasOn = btn.classList.contains('is-on');
        btn.classList.toggle('is-on'); // optimista
        doFetch()
            .then(function (r) {
                if (r.status === 401) { document.dispatchEvent(new CustomEvent('yf:require-auth')); throw new Error('auth'); }
                return r.json();
            })
            .then(function (res) {
                if (!res.ok) throw new Error();
                if (meta) afterToggle(btn, meta, wasOn, res);
            })
            .catch(function () { btn.classList.toggle('is-on', wasOn); }) // rollback
            .finally(function () { busy = false; });
    }

    // El undo puede dispararse cuando el popover ya se cerró (cur = null), así que
    // capturamos lo que necesita el fetch inverso en el momento del toggle.
    function snapshot() { return cur ? { mt: cur.mt, id: cur.id, title: cur.title, poster: cur.poster } : null; }
    function fixedLabel(list) { for (var i = 0; i < FIXED.length; i++) if (FIXED[i].key === list) return FIXED[i].label; return 'la lista'; }

    function postFixed(snap, list, action) {
        return fetch('/api/lists/fixed', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ media_type: snap.mt, tmdb_id: snap.id, list: list, action: action }),
        });
    }
    function postColl(snap, collId, op) {
        var body = op === 'add'
            ? { op: 'add', listId: collId, item: { media_type: snap.mt, tmdb_id: snap.id, title: snap.title, poster_path: snap.poster } }
            : { op: 'remove', listId: collId, itemId: snap.mt + '_' + snap.id };
        return fetch('/api/lists/items', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
        });
    }

    // Página de lista fija en la que estamos (para reubicar la card en vivo). null fuera de ellas.
    function currentListKey() {
        var p = location.pathname;
        if (p.indexOf('/mislistas/pendientes') === 0) return { key: 'pendientes', label: 'Pendientes' };
        if (p.indexOf('/mislistas/vistos') === 0) return { key: 'vistas', label: 'Vistas' };
        if (p.indexOf('/mislistas/favoritos') === 0) return { key: 'favorites', label: 'Favoritos' };
        return null;
    }
    // La card a desvanecer = el item de la rejilla (host de HoverPreview) o la propia card.
    function cardOf(trigger) {
        if (!trigger) return null;
        return trigger.closest('.media-card');
    }
    // ¿El título ya NO pertenece a la lista de esta página tras el marcado?
    function leftCurrentList(snap, key) {
        return fetch('/api/lists?media_type=' + snap.mt + '&tmdb_id=' + snap.id)
            .then(function (r) { return r.json(); })
            .then(function (data) { return !((data && data.fixed) || {})[key]; });
    }

    // Tras un toggle OK: "Añadida a X · #N · Deshacer" (o "Quitada de X · Deshacer").
    function afterToggle(btn, meta, wasOn, res) {
        var added = !wasOn; // antes off → ahora añadida
        // Microfeedback: al AÑADIR, el icono "late" (corazón en Favoritos, pop en el resto).
        if (added && btn) {
            var ico = btn.querySelector('.saveto-emoji');
            if (ico) {
                var cls = meta.label === 'Favoritos' ? 'yf-heart' : 'yf-pop';
                ico.classList.remove('yf-heart', 'yf-pop'); void ico.offsetWidth; ico.classList.add(cls);
            }
        }
        // Reubicación en páginas de lista: si el marcado sacó la card de la lista actual,
        // se desvanece con "Deshacer". Si no, toast normal.
        if (meta.reloc && meta.cardEl) {
            leftCurrentList(meta.snap, meta.reloc.key)
                .then(function (left) {
                    if (left) relocateOut(meta);
                    else normalToast(btn, added, meta, res);
                })
                .catch(function () { normalToast(btn, added, meta, res); });
            return;
        }
        normalToast(btn, added, meta, res);
    }

    function normalToast(btn, added, meta, res) {
        var count = (added && meta.showCount) ? res[meta.countKey] : null;
        pushToast(added ? 'Añadida a' : 'Quitada de', meta.label, count, function () {
            meta.undo()
                .then(function (r) { return r.json(); })
                .then(function (res2) {
                    if (!res2.ok) throw new Error();
                    if (btn && btn.isConnected) btn.classList.toggle('is-on', !added); // refleja el deshacer
                    pushToast('Deshecho', '', null, null);
                })
                .catch(function () { pushToast('No se pudo deshacer', '', null, null); });
        });
    }

    // La card salió de la lista actual: desvanecer + "Fuera de X · Deshacer". El modelo no
    // auto-restaura, así que el Deshacer restablece EXACTAMENTE el estado previo de las 3
    // listas fijas (p.ej. marcar Vista quitó Pendiente y añadió Vista → deshacer vuelve a
    // Pendiente y quita Vista). No revierte Ver pronto/Me gusta previos (caso marginal).
    function relocateOut(meta) {
        var cardEl = meta.cardEl;
        close();
        cardEl.style.transition = 'opacity .28s ease, transform .28s ease';
        cardEl.style.opacity = '0';
        cardEl.style.transform = 'scale(.94)';
        var prevDisplay = null;
        var hideTimer = setTimeout(function () { prevDisplay = cardEl.style.display; cardEl.style.display = 'none'; }, 300);

        pushToast('Fuera de', meta.reloc.label, null, function () {
            clearTimeout(hideTimer);
            restorePrior(meta.snap, meta.priorFixed, meta.reloc.key)
                .then(function () {
                    cardEl.style.display = prevDisplay || '';
                    requestAnimationFrame(function () { cardEl.style.opacity = '1'; cardEl.style.transform = ''; });
                    pushToast('Restaurada', '', null, null);
                })
                .catch(function () { pushToast('No se pudo deshacer', '', null, null); });
        });
    }

    // Restablece las 3 listas fijas a su estado previo. Si no lo capturamos (priorFixed
    // nulo), al menos re-añade la lista de la página para devolver la card.
    function restorePrior(snap, prior, key) {
        var ops;
        if (prior) {
            ops = ['favorites', 'pendientes', 'vistas'].map(function (k) {
                return postFixed(snap, k, prior[k] ? 'add' : 'remove');
            });
        } else {
            ops = [postFixed(snap, key, 'add')];
        }
        return Promise.all(ops)
            .then(function (rs) { return Promise.all(rs.map(function (r) { return r.json(); })); })
            .then(function (arr) { if (arr.some(function (x) { return !x || !x.ok; })) throw new Error(); });
    }

    // Toast autónomo: este popover es global, pero showToast (optimistic-actions.js)
    // solo se carga en las fichas. Reutiliza las clases .toast / .toast-success.
    function pushToast(verb, label, count, onUndo) {
        var container = document.getElementById('toast-container');
        if (!container) return;
        var ICON_CHECK = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>';
        var ICON_UNDO = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14L4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg>';

        var toast = document.createElement('div');
        toast.className = 'toast toast-save';

        if (label) {
            var icon = document.createElement('span');
            icon.className = 'toast-icon';
            icon.innerHTML = ICON_CHECK;
            toast.appendChild(icon);
        }

        var msg = document.createElement('span');
        msg.className = 'toast-msg';
        if (label) {
            msg.appendChild(document.createTextNode(verb + ' '));
            var strong = document.createElement('strong');
            strong.textContent = label;
            msg.appendChild(strong);
            if (count != null && !isNaN(count)) {
                msg.appendChild(document.createTextNode(' · '));
                var c = document.createElement('span');
                c.className = 'toast-count';
                c.textContent = '#' + count;
                msg.appendChild(c);
            }
        } else {
            msg.textContent = verb;
        }
        toast.appendChild(msg);

        var timer;
        function dismiss() {
            clearTimeout(timer);
            toast.style.animation = 'toastOut 0.3s ease forwards';
            setTimeout(function () { toast.remove(); }, 300);
        }
        if (onUndo) {
            var ub = document.createElement('button');
            ub.type = 'button';
            ub.className = 'toast-action';
            ub.innerHTML = ICON_UNDO + '<span>Deshacer</span>';
            ub.addEventListener('click', function () { dismiss(); onUndo(); });
            toast.appendChild(ub);
        }
        container.appendChild(toast);
        timer = setTimeout(dismiss, onUndo ? 5000 : 2500);
    }

    function showCreateForm() {
        var create = inner.querySelector('.js-create');
        if (!create || inner.querySelector('.saveto-newform')) return;
        var form = document.createElement('div');
        form.className = 'saveto-newform';
        form.innerHTML = '<input type="text" maxlength="60" placeholder="Nombre de la colección" /><button type="button">Crear</button>';
        create.parentNode.insertBefore(form, create.nextSibling);
        var input = form.querySelector('input');
        var btn = form.querySelector('button');
        input.focus();
        function submit() {
            var name = input.value.trim();
            if (!name || busy) return;
            busy = true; btn.disabled = true;
            fetch('/api/lists', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ op: 'create', name: name }),
            })
                .then(function (r) { if (r.status === 401) { document.dispatchEvent(new CustomEvent('yf:require-auth')); throw new Error('auth'); } return r.json(); })
                .then(function (res) {
                    if (!res.ok || !res.listId) throw new Error();
                    // añade el item actual a la nueva colección
                    return fetch('/api/lists/items', {
                        method: 'POST', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ op: 'add', listId: res.listId, item: { media_type: cur.mt, tmdb_id: cur.id, title: cur.title, poster_path: cur.poster } }),
                    });
                })
                .then(function (r) { return r.json(); })
                .then(function () { reloadMembership(); })
                .catch(function () { btn.disabled = false; })
                .finally(function () { busy = false; });
        }
        btn.addEventListener('click', submit);
        input.addEventListener('keydown', function (e) { if (e.key === 'Enter') submit(); });
    }

    function reloadMembership() {
        if (!cur) return;
        fetch('/api/lists?media_type=' + cur.mt + '&tmdb_id=' + cur.id)
            .then(function (r) { return r.json(); })
            .then(function (data) { if (cur) render(data); })
            .catch(function () {});
    }
})();
</script>
