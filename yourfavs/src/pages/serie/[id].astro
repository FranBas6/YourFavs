                                            <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg shadow">Guardar opinión</button>
                                        </div>
                                    </form>
                                )}
                            </div>
                        )}

                        <!-- Redes de Transmisión -->
                        {additionalInfo.networks && additionalInfo.networks.length > 0 && (
                            <div class="bg-white p-4 rounded-lg shadow-md">
                                <h3 class="text-lg font-bold text-blue-600 mb-3">Redes de Transmisión</h3>
