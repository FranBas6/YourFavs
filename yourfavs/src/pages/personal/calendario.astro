---
import Layout from "../../layouts/Layout.astro";
import { getCalendarData } from "../../services/API/Calendar/calendarService";
import type { CalendarEvent } from "../../services/API/Calendar/calendarService";
import EmptyState from "../../components/EmptyState.astro";

const now = new Date();
const year = parseInt(Astro.url.searchParams.get("year") || String(now.getFullYear()));
const month = parseInt(Astro.url.searchParams.get("month") || String(now.getMonth() + 1));
const view = Astro.url.searchParams.get("view") === 'list' ? 'list' : 'grid';
const buildViewUrl = (v: 'grid' | 'list') => `/personal/calendario?year=${year}&month=${month}&view=${v}`;

let calendarData;
let errorMessage = "";

try {
    calendarData = await getCalendarData(year, month);
} catch (error) {
    console.error("Error al cargar calendario:", error);
    errorMessage = error instanceof Error ? error.message : "Error al cargar el calendario";
}

const today = calendarData?.today || new Date().toISOString().slice(0, 10);
const daysInMonth = new Date(year, month, 0).getDate();
const firstDayOfWeek = (new Date(year, month - 1, 1).getDay() + 6) % 7; // Lunes=0

// Crear grid del calendario
const calendarCells: { day: number | null; date: string; events: CalendarEvent[] }[] = [];

// Celdas vacías antes del primer día
for (let i = 0; i < firstDayOfWeek; i++) {
    calendarCells.push({ day: null, date: '', events: [] });
}

// Días del mes
const eventsMap = new Map<string, CalendarEvent[]>();
if (calendarData?.days) {
    for (const d of calendarData.days) {
        eventsMap.set(d.date, d.events);
    }
}

for (let d = 1; d <= daysInMonth; d++) {
    const dateStr = `${year}-${String(month).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
    calendarCells.push({
        day: d,
        date: dateStr,
        events: eventsMap.get(dateStr) || [],
    });
}

// Navegación meses
const prevMonth = month === 1 ? 12 : month - 1;
const prevYear = month === 1 ? year - 1 : year;
const nextMonth = month === 12 ? 1 : month + 1;
const nextYear = month === 12 ? year + 1 : year;

const monthNames = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
const dayNames = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];

// Solo eventos suscritos (notificaciones del usuario)
const subscribedEvents = calendarData?.days?.flatMap(d =>
    d.events.filter(e => e.is_subscribed).map(e => ({ ...e, date: d.date }))
) || [];

// Agrupar por título y ordenar cada grupo por fecha ascendente.
// Ordenar los grupos por fecha del próximo (primer) evento.
type SubEvent = typeof subscribedEvents[number];
const groupsMap = new Map<string, SubEvent[]>();
for (const ev of subscribedEvents) {
    const key = `${ev.media_type}:${ev.tmdb_id}:${ev.title}`;
    if (!groupsMap.has(key)) groupsMap.set(key, []);
    groupsMap.get(key)!.push(ev);
}
const todayStr = new Date().toISOString().slice(0, 10);
const notificationGroups = Array.from(groupsMap.entries())
    .map(([key, events]) => {
        const sorted = events.slice().sort((a, b) => a.date.localeCompare(b.date));
        const upcoming = sorted.filter(e => e.date >= todayStr);
        const nextDate = upcoming.length ? upcoming[0].date : sorted[sorted.length - 1].date;
        return { key, events: sorted, nextDate, hasUpcoming: upcoming.length > 0, head: sorted[0] };
    })
    .sort((a, b) => a.nextDate.localeCompare(b.nextDate));
---
<Layout title="Calendario de Estrenos">
    <section class="px-1 sm:py-8">
        {errorMessage && (
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm mb-6">
                {errorMessage}
            </div>
        )}

        <header class="mb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Calendario</h1>
            <p class="text-gray-500 text-base">Estrenos de películas y episodios de tus series</p>
        </header>

        <!-- Toggle vista + Suscripción ICS -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
            <div class="inline-flex gap-1 bg-gray-100 rounded-xl p-1 self-start">
                <a href={buildViewUrl('grid')}
                   class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all flex items-center gap-1.5 ${view === 'grid' ? 'bg-gray-900 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900 hover:bg-white'}`}>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                    Cuadrícula
                </a>
                <a href={buildViewUrl('list')}
                   class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all flex items-center gap-1.5 ${view === 'list' ? 'bg-gray-900 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900 hover:bg-white'}`}>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
                    Lista
                </a>
            </div>
            <button id="ics-subscribe-btn"
                    class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-sm font-medium text-amber-700 bg-amber-50 border border-amber-200 hover:bg-amber-100 hover:border-amber-300 transition self-start">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                Suscribir en Google/Apple Calendar
            </button>
        </div>

        <!-- Calendario (vista grid) -->
        {view === 'grid' && (
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-8">
            <!-- Header del mes -->
            <div class="flex items-center justify-between px-4 sm:px-6 py-4 border-b border-gray-100">
                <a href={`/personal/calendario?year=${prevYear}&month=${prevMonth}`}
                   class="p-2 rounded-lg hover:bg-gray-100 transition-colors text-gray-500 hover:text-gray-700">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                    </svg>
                </a>
                <h2 class="text-lg sm:text-xl font-semibold text-gray-800">
                    {monthNames[month - 1]} {year}
                </h2>
                <a href={`/personal/calendario?year=${nextYear}&month=${nextMonth}`}
                   class="p-2 rounded-lg hover:bg-gray-100 transition-colors text-gray-500 hover:text-gray-700">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>

            <!-- Días de la semana -->
            <div class="grid grid-cols-7 border-b border-gray-100">
                {dayNames.map(day => (
                    <div class="py-2 text-center text-xs font-medium text-gray-4000 uppercase tracking-wider">
                        {day}
                    </div>
                ))}
            </div>

            <!-- Grid del calendario -->
            <div class="grid grid-cols-7">
                {calendarCells.map((cell) => {
                    const isToday = cell.date === today;
                    const hasEvents = cell.events.length > 0;
                    const hasMovies = cell.events.some(e => e.media_type === 'movie');
                    const hasSeries = cell.events.some(e => e.media_type === 'tv');
                    const hasSeasonPremiere = cell.events.some(e => e.event_type === 'season_premiere');

                    return (
                        <div class={`calendar-cell min-h-[3rem] sm:min-h-[5rem] lg:min-h-[6rem] border-b border-r border-gray-50 p-1 sm:p-2 relative
                            ${!cell.day ? 'bg-gray-50/50' : ''}
                            ${isToday ? 'bg-blue-50/50 ring-2 ring-inset ring-blue-400' : ''}
                            ${hasEvents && cell.day ? 'cursor-pointer hover:bg-gray-50 transition-colors' : ''}`}
                            data-date={cell.date}
                            data-events={hasEvents ? JSON.stringify(cell.events) : undefined}>
                            {cell.day && (
                                <>
                                    <span class={`text-xs sm:text-sm font-medium ${isToday ? 'text-blue-600 font-bold' : 'text-gray-700'}`}>
                                        {cell.day}
                                    </span>

                                    {/* Dots indicadores */}
                                    {hasEvents && (
                                        <div class="flex gap-0.5 mt-0.5 sm:mt-1 flex-wrap">
                                            {hasMovies && <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-red-500" title="Película"></span>}
                                            {hasSeries && !hasSeasonPremiere && <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-blue-500" title="Episodio"></span>}
                                            {hasSeasonPremiere && <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-purple-500" title="Temporada completa"></span>}
                                        </div>
                                    )}

                                    {/* Títulos en desktop */}
                                    <div class="hidden lg:block mt-1 space-y-0.5 overflow-hidden">
                                        {cell.events.slice(0, 2).map(event => (
                                            <div class={`text-[10px] leading-tight truncate px-1 py-0.5 rounded
                                                ${event.media_type === 'movie' ? 'bg-red-50 text-red-700' : ''}
                                                ${event.event_type === 'season_premiere' ? 'bg-purple-50 text-purple-700' : ''}
                                                ${event.event_type === 'episode' ? 'bg-blue-50 text-blue-700' : ''}`}>
                                                {event.title}
                                            </div>
                                        ))}
                                        {cell.events.length > 2 && (
                                            <span class="text-[10px] text-gray-4000">+{cell.events.length - 2} más</span>
                                        )}
                                    </div>
                                </>
                            )}
                        </div>
                    );
                })}
            </div>

            <!-- Leyenda -->
            <div class="flex items-center justify-center gap-4 px-4 py-3 border-t border-gray-100 text-xs text-gray-500">
                <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-red-500"></span> Películas
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-blue-500"></span> Episodios
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-purple-500"></span> Temporada completa
                </span>
            </div>
        </div>
        )}

        <!-- Calendario (vista lista) -->
        {view === 'list' && (
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-8">
                <div class="flex items-center justify-between px-4 sm:px-6 py-4 border-b border-gray-100">
                    <a href={`/personal/calendario?year=${prevYear}&month=${prevMonth}&view=list`}
                       class="p-2 rounded-lg hover:bg-gray-100 transition-colors text-gray-500 hover:text-gray-700">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                        </svg>
                    </a>
                    <h2 class="text-lg sm:text-xl font-semibold text-gray-800">{monthNames[month - 1]} {year}</h2>
                    <a href={`/personal/calendario?year=${nextYear}&month=${nextMonth}&view=list`}
                       class="p-2 rounded-lg hover:bg-gray-100 transition-colors text-gray-500 hover:text-gray-700">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                </div>
                {calendarData?.days?.length === 0 && (
                    <div class="px-4 py-8">
                        <EmptyState size="sm" title="Sin estrenos este mes" description="No hay estrenos ni episodios programados." />
                    </div>
                )}
                {calendarData?.days && calendarData.days.length > 0 && (
                    <div class="divide-y divide-gray-100">
                        {calendarData.days.map(day => {
                            const isToday = day.date === today;
                            const dt = new Date(day.date + 'T12:00:00');
                            const weekday = dt.toLocaleDateString('es-ES', { weekday: 'long' });
                            const datePretty = dt.toLocaleDateString('es-ES', { day: 'numeric', month: 'long' });
                            return (
                                <div class={`px-4 sm:px-6 py-4 ${isToday ? 'bg-blue-50/40' : ''}`}>
                                    <div class="flex items-baseline gap-2 mb-3">
                                        <span class={`text-sm font-bold uppercase tracking-wide ${isToday ? 'text-blue-600' : 'text-gray-700'}`}>
                                            {isToday ? 'Hoy' : weekday}
                                        </span>
                                        <span class="text-xs text-gray-500">{datePretty}</span>
                                        <span class="text-xs text-gray-400">· {day.events.length} {day.events.length === 1 ? 'evento' : 'eventos'}</span>
                                    </div>
                                    <div class="space-y-2">
                                        {day.events.map(ev => {
                                            const link = ev.media_type === 'movie' ? `/movie/${ev.tmdb_id}` : `/serie/${ev.tmdb_id}`;
                                            const colorClass = ev.media_type === 'movie' ? 'text-red-600' : (ev.event_type === 'season_premiere' ? 'text-purple-600' : 'text-blue-600');
                                            const bgClass = ev.media_type === 'movie' ? 'bg-red-50 border-red-100' : (ev.event_type === 'season_premiere' ? 'bg-purple-50 border-purple-100' : 'bg-blue-50 border-blue-100');
                                            return (
                                                <a href={link} class={`flex items-center gap-3 p-2.5 rounded-xl border ${bgClass} hover:shadow-md transition`}>
                                                    {ev.poster_path ? (
                                                        <img src={ev.poster_path} alt={ev.title} class="w-10 h-14 object-cover rounded-lg flex-shrink-0" loading="lazy"/>
                                                    ) : (
                                                        <div class="w-10 h-14 bg-gray-200 rounded-lg flex-shrink-0 flex items-center justify-center text-gray-400 text-xs">?</div>
                                                    )}
                                                    <div class="min-w-0 flex-1">
                                                        <p class="text-sm font-semibold text-gray-800 truncate">{ev.title}</p>
                                                        <span class={`text-xs ${colorClass}`}>{ev.label}</span>
                                                    </div>
                                                    {ev.is_subscribed && (
                                                        <span class="text-amber-500 flex-shrink-0" title="Suscrito">
                                                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/></svg>
                                                        </span>
                                                    )}
                                                </a>
                                            );
                                        })}
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                )}
            </div>
        )}

        <!-- Detalle del día seleccionado -->
        <div id="day-detail-panel" class="mb-6" style="display:none;">
            <div class="flex items-center justify-between mb-3">
                <h2 id="day-detail-title" class="text-lg font-semibold text-gray-800"></h2>
                <button id="day-detail-close" class="text-gray-4000 hover:text-red-500 transition-colors text-xl leading-none">&times;</button>
            </div>
            <div id="day-detail-list" class="space-y-2"></div>
        </div>

        <!-- Tus notificaciones -->
        <div>
            <h2 class="text-xl font-semibold text-gray-800 flex items-center gap-2 mb-4">
                <span class="w-1 h-6 bg-amber-500 rounded-full"></span>
                Tus notificaciones
                <span class="text-sm font-normal text-gray-4000">({subscribedEvents.length})</span>
            </h2>

            {subscribedEvents.length === 0 && (
                <EmptyState
                    size="sm"
                    title="No tienes notificaciones activas"
                    description="Activa la campana en películas o series para recibir avisos de estrenos."
                />
            )}

            <div class="space-y-2">
                {notificationGroups.map(group => {
                    const detailLink = `/${group.head.media_type === 'movie' ? 'movie' : 'serie'}/${group.head.tmdb_id}`;
                    const isGrouped = group.events.length > 1;
                    const startOpen = !isGrouped || group.events.length <= 3;
                    return (
                        <details class="notification-group bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden" open={startOpen}>
                            <summary class={`flex items-center gap-3 p-3 list-none ${isGrouped ? 'cursor-pointer hover:bg-gray-50 transition-colors' : ''}`}>
                                {group.head.poster_path ? (
                                    <img src={group.head.poster_path} alt={group.head.title} class="w-12 h-16 object-cover rounded-lg flex-shrink-0" loading="lazy"/>
                                ) : (
                                    <div class="w-12 h-16 bg-gray-200 rounded-lg flex-shrink-0 flex items-center justify-center text-gray-4000 text-xs">?</div>
                                )}
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center justify-between gap-2">
                                        <p class="text-sm font-semibold text-gray-800 truncate">{group.head.title}</p>
                                        {isGrouped ? (
                                            <span class="text-xs font-medium text-amber-600 whitespace-nowrap bg-amber-50 px-2 py-0.5 rounded-full">
                                                {group.events.length} episodios
                                            </span>
                                        ) : (
                                            <span class="text-xs text-gray-4000 whitespace-nowrap">
                                                {new Date(group.head.date + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}
                                            </span>
                                        )}
                                    </div>
                                    <span class="text-xs text-gray-500 mt-0.5 block">
                                        {isGrouped
                                            ? `${group.hasUpcoming ? 'Próximo' : 'Último'}: ${new Date(group.nextDate + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}`
                                            : group.head.label}
                                    </span>
                                </div>
                                {isGrouped && (
                                    <svg class="chevron w-4 h-4 text-gray-4000 flex-shrink-0 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                                    </svg>
                                )}
                            </summary>
                            {isGrouped && (
                                <ul class="border-t border-gray-100 divide-y divide-gray-50">
                                    {group.events.map(ev => (
                                        <li>
                                            <a href={detailLink} class="flex items-center justify-between gap-3 px-3 py-2 hover:bg-gray-50 transition-colors min-w-0">
                                                <span class={`text-xs font-medium truncate min-w-0 flex-1
                                                    ${ev.media_type === 'movie' ? 'text-red-500' : ''}
                                                    ${ev.event_type === 'season_premiere' ? 'text-purple-500' : ''}
                                                    ${ev.event_type === 'episode' ? 'text-blue-500' : ''}`}>
                                                    {ev.label}
                                                </span>
                                                <span class="text-xs text-gray-4000 whitespace-nowrap flex-shrink-0">
                                                    {new Date(ev.date + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}
                                                </span>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            )}
                            {!isGrouped && (
                                <a href={detailLink} class="block px-3 pb-3 -mt-1 text-xs text-blue-600 hover:underline">Ver detalle →</a>
                            )}
                        </details>
                    );
                })}
            </div>
        </div>
    </section>
</Layout>

<script is:inline>
(function () {
    var panel = document.getElementById('day-detail-panel');
    var title = document.getElementById('day-detail-title');
    var list = document.getElementById('day-detail-list');
    var closeBtn = document.getElementById('day-detail-close');
    if (!panel || !title || !list || !closeBtn) return;

    var selectedCell = null;

    closeBtn.addEventListener('click', function () {
        panel.style.display = 'none';
        if (selectedCell) { selectedCell.removeAttribute('data-selected'); selectedCell = null; }
    });
    document.querySelectorAll('[data-events]').forEach(function (cell) {
        cell.addEventListener('click', function () {
            var date = cell.getAttribute('data-date');
            var events = JSON.parse(cell.getAttribute('data-events') || '[]');
            if (!events.length) return;

            if (selectedCell && selectedCell !== cell) {
                selectedCell.removeAttribute('data-selected');
            }
            cell.setAttribute('data-selected', 'true');
            selectedCell = cell;

            var d = new Date(date + 'T12:00:00');
            title.textContent = d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });

            var html = '';
            events.forEach(function (ev) {
                var link = ev.media_type === 'movie' ? '/movie/' + ev.tmdb_id : '/serie/' + ev.tmdb_id;
                var colorClass = ev.media_type === 'movie' ? 'text-red-500' : (ev.event_type === 'season_premiere' ? 'text-purple-500' : 'text-blue-500');
                var borderClass = ev.media_type === 'movie' ? 'border-red-100' : (ev.event_type === 'season_premiere' ? 'border-purple-100' : 'border-blue-100');
                html += '<a href="' + link + '" class="flex items-center gap-3 p-3 bg-white rounded-xl border ' + borderClass + ' shadow-sm hover:shadow-md transition-all">';
                if (ev.poster_path) {
                    html += '<img src="' + ev.poster_path + '" alt="" class="w-12 h-16 object-cover rounded-lg flex-shrink-0" loading="lazy"/>';
                } else {
                    html += '<div class="w-12 h-16 bg-gray-200 rounded-lg flex-shrink-0 flex items-center justify-center text-gray-4000 text-xs">?</div>';
                }
                html += '<div class="min-w-0 flex-1">';
                html += '<p class="text-sm font-semibold text-gray-800">' + ev.title + '</p>';
                html += '<span class="text-xs ' + colorClass + '">' + ev.label + '</span>';
                html += '</div></a>';
            });
            list.innerHTML = html;
            panel.style.display = 'block';
            panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
    });
})();
</script>

<script is:inline>
(function () {
    var btn = document.getElementById('ics-subscribe-btn');
    if (!btn) return;
    btn.addEventListener('click', function () {
        var origin = window.location.origin;
        var httpUrl = origin + '/api/calendar/subscribe.ics';
        var webcalUrl = httpUrl.replace(/^https?:\/\//, 'webcal://');
        var copy = function () {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(httpUrl).then(function () {
                    alert('URL copiada al portapapeles:\n\n' + httpUrl + '\n\nPégala en Google Calendar → "Otros calendarios" → "Desde URL", o en Apple Calendar → "Archivo" → "Nueva suscripción a calendario".');
                });
            } else {
                window.prompt('Copia esta URL y suscríbela en tu calendario:', httpUrl);
            }
        };
        // Intenta abrir webcal:// (Apple Calendar lo registra). Si falla, copia URL.
        try {
            window.location.href = webcalUrl;
            setTimeout(copy, 800);
        } catch (e) {
            copy();
        }
    });
})();
</script>

