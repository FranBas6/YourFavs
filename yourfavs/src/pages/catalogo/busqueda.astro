---
import Layout from "../../layouts/Layout.astro";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import CardActor from "../../components/Cards/CardActor.astro";
import CategoriasButton from "../../components/CategoriasButton.astro";
import {getMoviesByTitle} from "../../services/API/Movies/tmdbMovies";
import {getSeriesByTitle} from "../../services/API/Series/tmdbSeries";
import {getActorsByName} from "../../services/API/Actors/tmdbActor";
import {getGenreName} from "../../utils/constants/genres";
import {loadAllPages} from "../../utils/loadAllPages";
import '../../styles/pages/catalogo/shared.css';
import '../../styles/pages/catalogo/busqueda.css';

const queryParams = new URLSearchParams(Astro.request.url.split('?')[1]);
const title = queryParams.get('query') || '';

// Las 3 búsquedas en paralelo (antes eran secuenciales)
const [allMovies, allSeries, allActors] = await Promise.all([
    loadAllPages(
        ({title, page}) => getMoviesByTitle({title, page}),
        title,
        "title"
    ),
    loadAllPages(
        ({title, page}) => getSeriesByTitle({title, page}),
        title,
        "title"
    ),
    loadAllPages(
        ({name, page}) => getActorsByName({name, page}),
        title,
        "name"
    ),
]);

// Limitar a 65 elementos por categoría
const limitedMovies = allMovies.slice(0, 65);
const limitedSeries = allSeries.slice(0, 65);
const limitedActors = allActors.slice(0, 30);

// Contadores para mostrar
const totalResults = limitedMovies.length + limitedSeries.length + limitedActors.length;
---
<Layout title="Resultados">
    <div class="search-results-container max-w-7xl mx-auto px-4 py-8">
    <!-- Cabecera mejorada con mejor jerarquía visual -->
    <header class="results-header mb-12 text-center">
        <div class="header-content">
            <h1 class="main-title text-coral-red font-bold text-3xl sm:text-4xl md:text-5xl mb-6">
                Resultados para: <span class="search-term text-navy-blue">{title}</span>
            </h1>
            <div class="results-summary">
                <p class="text-slate-700 text-lg leading-relaxed">
                    {totalResults > 0 ? (
                            <div class="results-summary mt-4 flex flex-col items-center justify-center gap-2 sm:flex-row sm:gap-4 text-gray-700">
                                <div class="summary-main text-base sm:text-lg">
                                    Encontramos <span class="font-semibold text-coral-red">{totalResults}</span>
                                    coincidencias
                                </div>
                                <div class="summary-breakdown flex flex-wrap justify-center items-center gap-2 text-sm sm:text-base">
                                    {limitedMovies.length > 0 && (
                                            <span class="inline-flex items-center gap-1 px-3 py-1 bg-coral-red/10 text-coral-red rounded-full font-medium">
                🎬 {limitedMovies.length} Películas
            </span>
                                    )}
                                    {limitedSeries.length > 0 && (
                                            <span class="inline-flex items-center gap-1 px-3 py-1 bg-teal-500/10 text-teal-600 rounded-full font-medium">
                📺 {limitedSeries.length} Series
            </span>
                                    )}
                                    {limitedActors.length > 0 && (
                                            <span class="inline-flex items-center gap-1 px-3 py-1 bg-purple-500/10 text-purple-600 rounded-full font-medium">
                👤 {limitedActors.length} Actores
            </span>
                                    )}
                                </div>
                            </div>

                    ) : (
                            <span class="no-results-text">No se encontraron resultados para tu búsqueda</span>
                    )}
                </p>
            </div>
        </div>
    </header>

    <!-- Navegación sticky mejorada -->
    <nav class="sticky-nav sticky top-4 z-50 mb-12">
        <div class="nav-container bg-white/95 backdrop-blur-md border border-slate-200 rounded-2xl shadow-xl">
            <div class="nav-wrapper px-3 py-2">
                <div class="nav-buttons flex flex-wrap justify-center items-center gap-3">

                    {limitedMovies.length > 0 && (
                            <CategoriasButton
                                    href="#peliculas"
                                    class="nav-button nav-button--movies">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20"
                                     fill="currentColor">
                                    <path fill-rule="evenodd"
                                          d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm3 2h6v4H7V5zm8 8v2h1v-2h-1zm-2-6h1V5h-1v2zm-2 0h1V5h-1v2zM9 5v2h1V5H9zM5 5v2h1V5H5zm0 8v2h1v-2H5zm0-2v2h1v-2H5zm2 2v2h1v-2H7zm2 0v2h1v-2H9zm2 0v2h1v-2h-1zm2 0v2h1v-2h-1zm-8-2v2h1v-2H5zm2 0v2h1v-2H7zm2 0v2h1v-2H9z"
                                          clip-rule="evenodd"/>
                                </svg>
                                <span>Películas</span>
                            </CategoriasButton>
                    )}

                    {limitedSeries.length > 0 && (
                            <CategoriasButton
                                    href="#series"
                                    class="nav-button nav-button--series">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20"
                                     fill="currentColor">
                                    <path fill-rule="evenodd"
                                          d="M3 5a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2h-2.22l.123.489.804.804A1 1 0 0113 18H7a1 1 0 01-.707-1.707l.804-.804L7.22 15H5a2 2 0 01-2-2V5zm5.771 7H5V5h10v7H8.771z"
                                          clip-rule="evenodd"/>
                                </svg>
                                <span>Series</span>
                            </CategoriasButton>
                    )}

                    {limitedActors.length > 0 && (
                            <CategoriasButton
                                    href="#actores"
                                    class="nav-button nav-button--actors">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20"
                                     fill="currentColor">
                                    <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"/>
                                </svg>
                                <span>Actores</span>
                            </CategoriasButton>
                    )}
                </div>
            </div>
        </div>
    </nav>

    {totalResults === 0 ? (
        <!-- Estado sin resultados mejorado -->
            <div class="no-results-container">
                <div class="no-results-card bg-white border border-slate-200 rounded-2xl p-12 text-center shadow-lg">
                    <div class="no-results-icon mb-6">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20 mx-auto text-slate-300" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <h2 class="no-results-title text-2xl font-bold text-coral-red mb-3">
                        No encontramos resultados para "{title}"
                    </h2>
                    <p class="no-results-description text-white mb-8 max-w-lg mx-auto leading-relaxed">
                        Intenta con otro término de búsqueda o revisa la ortografía. También puedes explorar nuestras
                        categorías principales.
                    </p>
                    <a href="/"
                       class="back-button inline-flex items-center gap-2 px-6 py-3 bg-navy-blue text-white rounded-xl hover:bg-blue-800 transition-all duration-300 font-medium shadow-lg hover:shadow-xl hover:-translate-y-0.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd"
                                  d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
                                  clip-rule="evenodd"/>
                        </svg>
                        <span>Volver al inicio</span>
                    </a>
                </div>
            </div>
    ) : (
        <!-- Contenido principal mejorado -->
            <main class="content-sections space-y-16">
                {/* Sección de películas */}
                {limitedMovies.length > 0 && (
                        <section id="peliculas" class="content-section scroll-mt-28">
                            <div class="section-header mb-8">
                                <div class="flex items-center gap-3 mb-6">
                                    <div class="w-10 h-10 bg-gradient-to-br bg-coral-red rounded-xl flex items-center justify-center shadow-md">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none"
                                             viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                                        </svg>
                                    </div>
                                    <h2 class="text-2xl md:text-3xl font-bold text-gray-800">Películas</h2>
                                    <div class="flex-1 h-px bg-gradient-to-r from-gray-300 to-transparent"></div>
                                    <div class="section-count ml-4 px-3 py-1 bg-coral-red/10 text-coral-red text-sm font-medium rounded-full">
                                        {limitedMovies.length} resultados
                                    </div>
                                </div>
                            </div>

                            <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
                                {limitedMovies.map((item) => (
                                        <div class="movie-card card-wrapper transform hover:scale-105 transition-transform duration-200">
                                            <CardMovie
                                                    id={item.id.toString()}
                                                    img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                    title={item.title}
                                                    vote_average={item.vote_average}
                                                    overview={item.overview}
                                                    release_date={item.release_date}
                                                    genres={item.genre_ids?.map((id: number) => ({
                                                        id,
                                                        name: getGenreName(id)
                                                    }))}
                                            />
                                        </div>
                                ))}
                            </div>
                        </section>
                )}

                {/* Sección de series */}
                {limitedSeries.length > 0 && (
                        <section id="series" class="content-section scroll-mt-28">
                            <div class="section-header mb-8">
                                <div class="flex items-center gap-3 mb-6">
                                    <div class="w-10 h-10 bg-gradient-to-br bg-blue-500 rounded-xl flex items-center justify-center shadow-md">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none"
                                             viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                        </svg>
                                    </div>
                                    <h2 class="text-2xl md:text-3xl font-bold text-gray-800">Series</h2>
                                    <div class="flex-1 h-px bg-gradient-to-r from-gray-300 to-transparent"></div>
                                    <div class="section-count ml-4 px-3 py-1 bg-teal-500/10 text-teal-600 text-sm font-medium rounded-full">
                                        {limitedSeries.length} resultados
                                    </div>
                                </div>
                            </div>

                            <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
                                {limitedSeries.map((item) => (
                                        <div class="series-card card-wrapper transform hover:scale-105 transition-transform duration-200">
                                            <CardSerie
                                                    id={item.id.toString()}
                                                    img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                    name={item.name}
                                                    vote_average={item.vote_average}
                                                    overview={item.overview}
                                                    first_air_date={item.first_air_date}
                                                    genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                                    last_episode_to_air={item.last_episode_to_air}
                                                    next_episode_to_air={item.next_episode_to_air}
                                            />
                                        </div>
                                ))}
                            </div>
                        </section>
                )}

                {/* Sección de actores */}
                {limitedActors.length > 0 && (
                        <section id="actores" class="content-section scroll-mt-28">
                            <div class="section-header mb-8">
                                <div class="section-title-wrapper flex items-center">
                                    <h2 class="section-title text-purple-600 font-bold text-2xl md:text-3xl mr-4">
                                        ACTORES
                                    </h2>
                                    <div class="section-divider flex-1 h-0.5 bg-gradient-to-r from-purple-500 to-transparent rounded-full opacity-60"></div>
                                    <div class="section-count ml-4 px-3 py-1 bg-purple-500/10 text-purple-600 text-sm font-medium rounded-full">
                                        {limitedActors.length} resultados
                                    </div>
                                </div>
                            </div>

                            <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
                                {limitedActors.map((item, index) => (
                                        <div class="actor-card card-wrapper transform hover:scale-105 transition-transform duration-200">
                                            <CardActor
                                                    id={item.id.toString()}
                                                    imagen={item.imagen ? `https://image.tmdb.org/t/p/w500${item.imagen}` : "/placeholder-actor.jpg"}
                                                    nombre={item.nombre}
                                                    popularidad={item.popularidad}
                                                    lugarNacimiento={item.lugarNacimiento || undefined}
                                                    fechaNacimiento={item.fechaNacimiento || undefined}
                                            />
                                        </div>
                                ))}
                            </div>
                        </section>
                )}
            </main>
    )}
    </div>
</Layout>
