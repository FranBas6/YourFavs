---
const {href, active, class: className = ''} = Astro.props;
---
<a
        href={href}
        class={`
        group relative flex items-center justify-center gap-2 
        px-3 py-2 lg:px-4 lg:py-2.5 
        text-white font-medium text-sm lg:text-base
        rounded-lg
        transition-all duration-300 ease-out
        hover:bg-white/15 hover:backdrop-blur-sm
        hover:shadow-lg hover:scale-[1.02]
        focus:outline-none focus:ring-2 focus:ring-white/40 focus:ring-offset-2 focus:ring-offset-transparent
        active:scale-[0.98]
        ${active ? 'bg-white/20 shadow-md border border-white/30' : 'hover:bg-white/10 border border-transparent hover:border-white/20'}
        ${className}
    `}
        role="menuitem"
        tabindex="0"
>
    <!-- Indicador visual para el estado activo -->
    {active && (
            <span class="absolute inset-x-0 bottom-0 h-0.5 bg-white rounded-full"></span>
    )}

    <!-- Efecto de brillo en hover (solo CSS) -->
    <span class="absolute inset-0 rounded-lg bg-gradient-to-r from-transparent via-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>

    <!-- Contenido del botón -->
    <span class="relative z-10 flex items-center gap-2">
        <slot name="before"/>
        <slot/>
        <slot name="after"/>
    </span>

    <!-- Efecto de onda en hover/focus (solo CSS) -->
    <span class="absolute inset-0 rounded-lg overflow-hidden">
        <span class="absolute inset-0 bg-white/20 rounded-full scale-0 group-hover:scale-100 group-focus:scale-100 transition-transform duration-500 ease-out opacity-0 group-hover:opacity-100 group-focus:opacity-100"></span>
    </span>
</a>
