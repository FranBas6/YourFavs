---
import Layout from "../../layouts/Layout.astro";
import CatalogHeader from "../../components/CatalogHeader.astro";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import {getMostPopularMovies} from "../../services/API/Movies/tmdbMovies";
import {getMostPopularSeries} from "../../services/API/Series/tmdbSeries";
import {discoverContent, parseAdvancedFilters, hasActiveFilters, sortByFor} from "../../services/API/shared/tmdbDiscoverService";
import {getGenreName} from "../../utils/constants/genres";
import {posterUrl} from "../../services/API/shared/tmdbClient";
import CatalogModes from "../../components/CatalogModes.astro";
import AdvancedFilters from "../../components/AdvancedFilters.astro";
import Pagination from "../../components/Pagination.astro";
import EmptyState from "../../components/EmptyState.astro";
import type {Movie} from "../../types/ApiMovie";
import type {Serie} from "../../types/ApiSerie";
import '../../styles/pages/catalogo/shared.css';
import '../../styles/pages/catalogo/card-animations.css';
import { resolveMineFilter } from "../../utils/platformFilter";
import { catalogUrls, resolveCatalogMode } from "../../utils/catalogUrl";

const urlParams = new URL(Astro.request.url).searchParams;
const page = Number(urlParams.get('page') || 1);
// El modo sale de la URL o, si no la trae, del último recordado (cookie, vía middleware).
const type = resolveCatalogMode(urlParams, Astro.locals.catalogMode);
const pageStr = page.toString();

const filters = parseAdvancedFilters(urlParams);
const filtersActive = hasActiveFilters(filters);
// "Solo en mis plataformas" (3.2b): with_watch_providers desde el perfil.
// Filtro por plataformas: la URL manda (`mine=0|1`); sin parámetro decide el perfil
// («Filtrar siempre por mis plataformas»). Ver utils/platformFilter.ts.
const { mine, mineDefault } = resolveMineFilter(urlParams, Astro.locals.user);
const myProviders = (mine && Astro.locals.user?.platforms?.length) ? Astro.locals.user.platforms.join('|') : '';
const myRegion = Astro.locals.user?.region || 'ES';
// Si hay filtros, orden o "mis plataformas", vamos por discover (que respeta esos params).
const useDiscover = filtersActive || !!filters.sort || !!myProviders;

const popularMovies = useDiscover
    ? await discoverContent<Movie>('movie', filters, { sort_by: sortByFor(filters.sort, 'movie') || 'popularity.desc', page: pageStr, providers: myProviders, region: myRegion })
    : await getMostPopularMovies({page: pageStr});

const popularSeries = useDiscover
    ? await discoverContent<Serie>('tv', filters, { sort_by: sortByFor(filters.sort, 'tv') || 'popularity.desc', page: pageStr, providers: myProviders, region: myRegion })
    : await getMostPopularSeries({page: pageStr});

const totalPages = 250;

// Contexto para el contador en vivo del sheet (2.3b): mismo vote_count.gte que discoverContent.
// (El filtro "mis plataformas" lo inyecta el cliente en el contador según el pending.)
const countCtx = [
    ...((type === 'all' || type === 'movies') ? [{ type: 'movie' as const, base: { 'vote_count.gte': '100' } }] : []),
    ...((type === 'all' || type === 'series') ? [{ type: 'tv' as const, base: { 'vote_count.gte': '100' } }] : []),
];

// Los dos constructores de URL son compartidos (`utils/catalogUrl.ts`): había seis copias de esto
// repartidas por las páginas de catálogo, y la de cambiar de modo se olvidaba de limpiar `cert`.
const { buildFilterUrl, buildTypeUrl } = catalogUrls(urlParams);
---
<Layout title="Más Populares">
    <div class="px-1 sm:py-8">
        <CatalogHeader
            title="Más Populares"
            subtitle="Las películas y series más populares del momento"
            color="pink"
            icon="flame"
        >
            <CatalogModes slot="nav" current={type} buildUrl={buildTypeUrl} />
        </CatalogHeader>

        <AdvancedFilters filters={filters} buildUrl={buildFilterUrl} showRuntime={type === 'movies'} showStatus={type === 'series'}
                         showCert={type === 'movies'} order="Popularidad" countCtx={countCtx}
                         mine={mine} mineDefault={mineDefault} myPlatforms={Astro.locals.user?.platforms ?? []} region={myRegion}
                         sortOptions={[{ value: 'rating', label: 'Mejor valoradas' }, { value: 'recent', label: 'Más recientes' }]} />

        <div class="flex items-center justify-between mb-6 text-sm text-gray-500">
            <span>Página <strong class="text-gray-900">{page}</strong> de {totalPages}</span>
            <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 bg-green-400 rounded-full"></span>
                Actualizado hoy
            </div>
        </div>

        <!-- Sección de Películas -->
        {(type === 'all' || type === 'movies') && (
                <div class="mb-12" id="peliculas">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                        <span class="w-1 h-6 bg-red-500 rounded-full"></span>
                        Películas
                    </h2>

                    {popularMovies.length === 0 ? (
                        <EmptyState
                            variant="filter"
                            size="sm"
                            title="Sin películas con esos filtros"
                            description="Prueba a relajar la nota mínima, la década o el idioma."
                        >
                            <a slot="cta" href="/catalogo/maspopulares?type=movies" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800 transition-all">Limpiar filtros</a>
                        </EmptyState>
                    ) : (
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
                            {popularMovies.map((item) => (
                                <div class="card-wrapper group">
                                    
                                        <CardMovie
                                                id={item.id.toString()}
                                                img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                                title={item.title}
                                                vote_average={item.vote_average}
                                                overview={item.overview}
                                                release_date={item.release_date}
                                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                        />
                                    
                                </div>
                            ))}
                        </div>
                    )}
                </div>
        )}

        <!-- Sección de Series -->
        {(type === 'all' || type === 'series') && (
                <div class="mb-12" id="series">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                        <span class="w-1 h-6 bg-blue-500 rounded-full"></span>
                        Series
                    </h2>
                    {popularSeries.length === 0 ? (
                        <EmptyState
                            variant="filter"
                            size="sm"
                            title="Sin series con esos filtros"
                            description="Prueba a relajar la nota mínima, la década o el idioma."
                        >
                            <a slot="cta" href="/catalogo/maspopulares?type=series" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800 transition-all">Limpiar filtros</a>
                        </EmptyState>
                    ) : (
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
                            {popularSeries.map((item) => (
                                <div class="card-wrapper group">
                                    
                                        <CardSerie
                                                id={item.id.toString()}
                                                img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                                name={item.name}
                                                vote_average={item.vote_average}
                                                overview={item.overview}
                                                first_air_date={item.first_air_date}
                                                seasons={item.seasons}
                                                last_episode_to_air={item.last_episode_to_air}
                                                next_episode_to_air={item.next_episode_to_air}
                                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                        />
                                    
                                </div>
                            ))}
                        </div>
                    )}
                </div>
        )}

        <Pagination page={page} totalPages={totalPages} buildUrl={(p) => {
            const q = new URLSearchParams(urlParams);
            q.set('page', String(p));
            return `?${q.toString()}`;
        }} />
    </div>
</Layout>
