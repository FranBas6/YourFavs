---
import Layout from "../../layouts/Layout.astro";
import { getMoviesAndSeriesByCompanyName } from "../../services/API/Productora/InfoProductora";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";

const { name } = Astro.params;
const { searchParams } = Astro.url;
const sortBy = searchParams.get('sort') || 'quality'; // 'quality', 'popularity', 'date'

if (!name) {
    throw new Error("Nombre de la productora no encontrado en la URL");
}

// Obtener datos de la productora y sus trabajos
const { 
    success, 
    companyInfo, 
    movies, 
    series, 
    error 
} = await getMoviesAndSeriesByCompanyName(name, sortBy);

if (!success) {
    throw new Error(error || "Error al obtener información de la productora");
}

const totalWorks = movies.length + series.length;

// Definir los géneros comunes
const genresMap: Record<number, string> = {
    // Géneros de películas y series
    28: "Acción",
    12: "Aventura",
    16: "Animación",
    35: "Comedia",
    80: "Crimen",
    99: "Documental",
    18: "Drama",
    10751: "Familia",
    14: "Fantasía",
    36: "Historia",
    27: "Terror",
    10402: "Música",
    9648: "Misterio",
    10749: "Romance",
    878: "Ciencia ficción",
    10770: "Película de TV",
    53: "Thriller",
    10752: "Bélica",
    37: "Western",
    // Géneros exclusivos de series
    10759: "Acción y Aventura",
    10762: "Infantil",
    10763: "Noticias",
    10764: "Reality",
    10765: "Sci-Fi y Fantasía",
    10766: "Soap",
    10767: "Talk",
    10768: "Guerra y Política"
};

// Función para obtener el nombre del género según su ID
function getGenreName(id: number): string {
    return genresMap[id] || "Otro";
}

// Función para formatear la fecha de fundación
function formatFoundationDate(date: string): string {
    if (!date) return "";
    return new Date(date).toLocaleDateString('es-ES', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });
}
---
<Layout title={`${name}`}>
    <div class="container mx-auto px-4 py-8">
        <nav class="floating-nav">
            <!-- Botón flecha para móviles -->
            <input type="checkbox" id="nav-toggle2" class="nav-toggle2" />
            <label for="nav-toggle2" class="nav-arrow-btn">
                <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path class="arrow-path" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                <span class="nav-count total-count">{totalWorks}</span>
            </label>
            
            <!-- Menú desplegable horizontal -->
            <div class="nav-menu">
                <a href="#peliculas" class="nav-btn nav-btn-movies">
                    <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                    </svg>
                    <span class="nav-text">Películas</span>
                    <span class="nav-count">{movies.length}</span>
                </a>
                <a href="#series" class="nav-btn nav-btn-series">
                    <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    <span class="nav-text">Series</span>
                    <span class="nav-count">{series.length}</span>
                </a>
            </div>
        </nav>

        <!-- Header de la productora -->
        <div class="bg-gradient-to-r from-indigo-900 to-purple-900 rounded-xl p-8 mb-10 text-white shadow-lg">
            <div class="flex flex-col md:flex-row items-center gap-6">
                {companyInfo?.logo_path && (
                <div class="w-36 h-36 bg-white flex items-center justify-center p-4 rounded-lg shadow">
                    <img 
                        src={`https://image.tmdb.org/t/p/w300${companyInfo.logo_path}`} 
                        alt={name}
                        class="max-w-full max-h-full object-contain"
                    />
                </div>

                )}
                <div class="text-center md:text-left">
                    <h1 class="text-4xl md:text-5xl font-extrabold bg-clip-text text-transparent bg-gradient-to-r from-yellow-300 to-pink-400 mb-3">
                        {name}
                    </h1>
                    <p class="text-lg md:text-xl font-medium text-indigo-200">Productora Cinematográfica</p>
                    
                    <div class="mt-4 space-y-2 text-indigo-100 text-sm md:text-base">
                        {companyInfo?.headquarters && (
                            <p>
                                <span class="font-semibold">Sede:</span> {companyInfo.headquarters}
                            </p>
                        )}
                        {companyInfo?.origin_country && (
                            <p>
                                <span class="font-semibold">País:</span> {companyInfo.origin_country}
                            </p>
                        )}
                        <p>
                            <span class="font-semibold">Producciones encontradas:</span> {totalWorks}
                            ({movies.length} películas, {series.length} series)
                        </p>
                    </div>
                </div>
            </div>

            {companyInfo?.description && (
                <div class="mt-8 bg-white/10 backdrop-blur-sm p-4 rounded-lg">
                    <h3 class="text-lg font-semibold mb-2">Acerca de la Productora</h3>

                    <input type="checkbox" id="toggleDescription" class="peer hidden" />

                    <p class="text-indigo-50 leading-relaxed line-clamp-5 peer-checked:line-clamp-none transition-all">
                        {companyInfo.description}
                    </p>

                    <label 
                        for="toggleDescription" 
                        class="mt-3 inline-block text-sm font-medium text-indigo-300 hover:text-indigo-200 cursor-pointer"
                    >
                        Mostrar
                    </label>
                </div>
            )}
        </div>

        <!-- Controles de ordenación -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
            <!-- Título -->
            <h2 class="text-xl sm:text-2xl font-bold text-gray-800 text-center sm:text-left">
                PRODUCCIONES ({totalWorks})
            </h2>

            <!-- Botones -->
            <div class="flex flex-wrap justify-center sm:justify-end gap-3">
                <a 
                    href="?sort=quality"
                    class={`px-4 py-2 rounded-full font-medium transition-all ${
                        sortBy === 'quality'
                            ? 'bg-indigo-600 text-white shadow-md'
                            : 'bg-gray-200 text-gray-700 hover:bg-gray-300'
                    }`}
                >
                    Mejor Valoradas
                </a>
                <a 
                    href="?sort=popularity"
                    class={`px-4 py-2 rounded-full font-medium transition-all ${
                        sortBy === 'popularity'
                            ? 'bg-indigo-600 text-white shadow-md'
                            : 'bg-gray-200 text-gray-700 hover:bg-gray-300'
                    }`}
                >
                    Más Populares
                </a>
                <a 
                    href="?sort=date"
                    class={`px-4 py-2 rounded-full font-medium transition-all ${
                        sortBy === 'date'
                            ? 'bg-indigo-600 text-white shadow-md'
                            : 'bg-gray-200 text-gray-700 hover:bg-gray-300'
                    }`}
                >
                    Más Recientes
                </a>
            </div>
        </div>

        <!-- Sección de Películas -->
        <section id="peliculas" class="mb-16 content-section scroll-mt-24">
            <div class="flex items-center gap-3 mb-6">
                <div class="p-3 rounded-full bg-indigo-100 text-indigo-600">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-gray-800">
                    PELÍCULAS <span class="text-gray-500">({movies.length})</span>
                </h2>
                <div class="flex-grow h-0.5 bg-gradient-to-r from-indigo-500/80 to-transparent"></div>
            </div>

            {movies.length === 0 ? (
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                                  d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                        </svg>
                    </div>
                    <h3 class="empty-state-title">No se encontraron películas</h3>
                    <p class="empty-state-description">{name} no tiene películas registradas en nuestra base de datos.</p>
                </div>
            ) : (
                <div class="content-grid">
                    {
                        movies.map((item) => (
                            <div class="card-wrapper">
                                <CardMovie
                                    id={item.id.toString()}
                                    img={item.poster_path || "/placeholder.jpg"}
                                    title={item.title}
                                    vote_average={item.vote_average}
                                    overview={item.overview}
                                    release_date={item.release_date}
                                    genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                />
                            </div>
                        ))
                    }
                </div>
            )}
        </section>

        <!-- Sección de Series -->
        <section id="series" class="mb-16 content-section scroll-mt-24">
            <div class="flex items-center gap-3 mb-6">
                <div class="p-3 rounded-full bg-indigo-100 text-indigo-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-gray-800">
                    SERIES <span class="text-gray-500">({series.length})</span>
                </h2>
                <div class="flex-grow h-0.5 bg-gradient-to-r from-indigo-500/80 to-transparent"></div>
            </div>

            {series.length === 0 ? (
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <h3 class="empty-state-title">No se encontraron series</h3>
                    <p class="empty-state-description">{name} no tiene series registradas en nuestra base de datos.</p>
                </div>
            ) : (
                <div class="content-grid">
                    {
                        series.map((item) => (
                            <div class="card-wrapper">
                                <CardSerie
                                    id={item.id.toString()}
                                    img={item.poster_path || "/placeholder.jpg"}
                                    name={item.name}
                                    vote_average={item.vote_average}
                                    overview={item.overview}
                                    first_air_date={item.first_air_date}
                                    genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                />
                            </div>
                        ))
                    }
                </div>
            )}
        </section>
    </div>
</Layout>

<style is:global>
    /* Variables y colores base */
    :root {
        --indigo-primary: #4F46E5;
        --indigo-light: #818CF8;
        --indigo-dark: #3730A3;
        --indigo-alpha: rgba(79, 70, 229, 0.1);
        --shadow-light: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        --shadow-medium: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        --shadow-large: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --border-radius: 12px;
    }

    /* Scroll suave */
    html {
        scroll-behavior: smooth;
    }

    /* Estilos generales */
    body {
        background-color: #F3F4F6;
        transition: background 0.3s ease;
    }

    .text-indigo-primary {
        color: var(--indigo-primary);
    }

    .bg-indigo-primary {
        background-color: var(--indigo-primary);
    }

    .line-clamp-5 {
        display: -webkit-box;
        -webkit-line-clamp: 5;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Secciones de contenido mejoradas */
    .content-section {
        animation: fadeInUp 0.8s ease-out;
        scroll-margin-top: 6rem;
    }

    .section-header-container {
        display: flex;
        align-items: center;
        margin-bottom: 2rem;
        gap: 1rem;
    }

    .section-title {
        display: flex;
        align-items: center;
        color: var(--indigo-primary);
        font-weight: 800;
        font-size: 2rem;
        letter-spacing: -0.025em;
        white-space: nowrap;
        gap: 0.75rem;
    }

    .section-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        background: var(--indigo-alpha);
        border-radius: 12px;
        color: var(--indigo-primary);
    }

    .section-count {
        font-size: 1.25rem;
        font-weight: 600;
        color: #6c757d;
        margin-left: 0.5rem;
    }

    .section-header-line {
        flex-grow: 1;
        height: 3px;
        background: linear-gradient(90deg, var(--indigo-primary) 0%, rgba(79, 70, 229, 0.3) 50%, rgba(79, 70, 229, 0) 100%);
        border-radius: 2px;
    }

    /* Cuadrícula de contenido */
    .content-grid {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: repeat(1, minmax(0, 1fr));
    }

    @media (min-width: 480px) {
        .content-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 640px) {
        .content-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @media (min-width: 768px) {
        .content-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @media (min-width: 1024px) {
        .content-grid {
            grid-template-columns: repeat(5, minmax(0, 1fr));
        }
    }

    /* Tarjetas mejoradas */
    .card-wrapper {
        transform: translateY(0);
        transition: var(--transition-smooth);
        height: 100%;
        position: relative;
    }

    .card-wrapper:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: var(--shadow-large);
        z-index: 10;
    }

    .card-wrapper > * {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        border-radius: var(--border-radius);
        overflow: hidden;
        box-shadow: var(--shadow-medium);
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(5px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: var(--transition-smooth);
    }

    .card-wrapper img {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .card-wrapper:hover img {
        transform: scale(1.05);
    }

    .card-wrapper h3,
    .card-wrapper h4 {
        height: auto;
        min-height: 3em;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        font-weight: 600;
        padding: 1rem 1rem 0.5rem;
        margin: 0;
        font-size: 1rem;
        line-height: 1.4;
    }

    .card-wrapper p {
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        flex-grow: 1;
        line-height: 1.5;
        padding: 0.5rem 1rem 1rem;
        margin: 0;
        font-size: 0.9rem;
        color: #6c757d;
    }

    /* Estado vacío mejorado */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: linear-gradient(135deg, rgba(79, 70, 229, 0.03) 0%, rgba(79, 70, 229, 0.01) 100%);
        border-radius: var(--border-radius);
        border: 2px dashed rgba(79, 70, 229, 0.2);
        margin: 2rem 0;
    }

    .empty-state-icon {
        display: flex;
        justify-content: center;
        margin-bottom: 1.5rem;
        color: rgba(79, 70, 229, 0.4);
    }

    .empty-state-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--indigo-primary);
        margin-bottom: 0.75rem;
    }

    .empty-state-description {
        color: #6c757d;
        font-size: 1rem;
        line-height: 1.6;
        max-width: 400px;
        margin: 0 auto;
    }

    /* Animaciones */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Mejoras responsivas */
    @media (max-width: 768px) {
        .section-title {
            font-size: 1.5rem;
            white-space: normal;
            flex-wrap: wrap;
            justify-content: center;
        }

        .section-header-container {
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 0.5rem;
        }

        .section-header-line {
            width: 100%;
            max-width: 200px;
        }
    }

    @media (max-width: 640px) {
        .content-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem;
            padding: 0 0.5rem;
        }

        .card-wrapper {
            min-width: 0;
            width: 100%;
        }
    }

    /* Modo oscuro mejorado */
    @media (prefers-color-scheme: dark) {
        :root {
            --indigo-primary: #818CF8;
            --indigo-light: #A5B4FC;
            --indigo-dark: #6366F1;
            --indigo-alpha: rgba(129, 140, 248, 0.15);
        }

        body {
            background-color: #1a202c;
            color: #e2e8f0;
        }

        .card-wrapper > * {
            background: rgba(26, 32, 44, 0.95);
            color: #e2e8f0;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .card-wrapper p {
            color: #a0aec0;
        }

        .card-wrapper:hover {
            box-shadow: 0 20px 40px -10px rgba(129, 140, 248, 0.2);
        }

        .empty-state {
            background: linear-gradient(135deg, rgba(129, 140, 248, 0.05) 0%, rgba(129, 140, 248, 0.02) 100%);
            border: 2px dashed rgba(129, 140, 248, 0.3);
        }

        .empty-state-icon {
            color: rgba(129, 140, 248, 0.5);
        }

        .empty-state-description {
            color: #a0aec0;
        }
    }

    /* Accesibilidad mejorada */
    .nav-pill:focus-visible,
    .read-more-btn:focus-visible {
        outline: 2px solid var(--indigo-primary);
        outline-offset: 2px;
    }

    /* Reducir movimiento para usuarios que lo prefieran */
    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
        }

        html {
            scroll-behavior: auto;
        }
    }

    /* Cambiar el texto dinámicamente */
    #toggleDescription:checked + p + label::after {
        content: " menos";
    }
    #toggleDescription:not(:checked) + p + label::after {
        content: " más";
    }

    /* ===== NAVEGACIÓN FLOTANTE CON FLECHA LATERAL ===== */
    .floating-nav {
        position: fixed;
        right: 1.5rem;
        top: 50%;
        transform: translateY(-50%);
        z-index: 50;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        animation: slideInFromRight 0.6s ease-out 1s forwards;
    }

    /* Ocultar el checkbox */
    .nav-toggle2 {
        display: none;
    }

    /* Ocultar el botón flecha en desktop */
    .nav-arrow-btn {
        display: none;
    }

    /* Menú desktop (vertical) */
    .nav-menu {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    /* Botones desktop */
    .nav-btn {
        display: flex;
        align-items: center;
        padding: 0.75rem 1rem;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(230, 57, 70, 0.2);
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        color: #374151;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.875rem;
        gap: 0.5rem;
        min-width: 140px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        transform: translateX(0);
    }

    .nav-btn:hover {
        background: var(--coral-red);
        color: white;
        border-color: var(--coral-red);
        box-shadow: 0 8px 25px rgba(230, 57, 70, 0.3);
        transform: translateX(-5px) scale(1.05);
    }

    .nav-icon {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
    }

    .nav-text {
        flex-grow: 1;
        text-align: left;
    }

    .nav-count {
        background: rgba(230, 57, 70, 0.1);
        color: var(--coral-red);
        padding: 0.25rem 0.5rem;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 700;
        min-width: 28px;
        text-align: center;
        transition: all 0.3s ease;
    }

    .nav-btn:hover .nav-count {
        background: rgba(255, 255, 255, 0.2);
        color: white;
    }

    /* Efectos especiales para cada botón */
    .nav-btn-movies {
        border-left: 4px solid #3B82F6;
    }

    .nav-btn-series {
        border-left: 4px solid #10B981;
    }

    .nav-btn-movies:hover {
        background: linear-gradient(135deg, var(--coral-red), #3B82F6);
    }

    .nav-btn-series:hover {
        background: linear-gradient(135deg, var(--coral-red), #10B981);
    }

