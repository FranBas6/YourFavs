---
import { posterUrl } from "../../services/API/shared/tmdbClient";

interface CastMember {
    id: number;
    name: string;
    character?: string;
    profile_path?: string | null;
}

interface Props {
    cast: CastMember[];
    title?: string;
    /** actor id → nº de títulos tuyos con esa persona (3.4). Solo si la caché está caliente. */
    seenWith?: Map<number, number>;
}

const { cast, title = "Reparto Principal", seenWith } = Astro.props;
---
{cast.length > 0 && (
    <section>
        <h2 class="text-xl font-semibold text-gray-800 mb-4">{title}</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            {cast.map((actor) => (
                <a href={`/actor/${actor.id}`} class="flex items-center gap-3 p-4 bg-white rounded-xl border border-gray-200 hover:border-gray-300 transition-colors">
                    {actor.profile_path ? (
                        <img src={posterUrl(actor.profile_path, 'w185')} alt={actor.name} class="w-14 h-14 rounded-full object-cover flex-shrink-0" loading="lazy" />
                    ) : (
                        <div class="w-14 h-14 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0">
                            <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/></svg>
                        </div>
                    )}
                    <div class="min-w-0">
                        <p class="text-sm sm:text-base font-medium text-gray-800 truncate">{actor.name}</p>
                        {actor.character && <p class="text-xs sm:text-sm text-gray-500 truncate">{actor.character}</p>}
                        {seenWith && seenWith.get(actor.id) ? (
                            <span class="mt-1 inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-[11px] font-medium"
                                  title={`Has visto ${seenWith.get(actor.id)} ${seenWith.get(actor.id) === 1 ? 'título' : 'títulos'} con ${actor.name}`}>
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20 6L9 17l-5-5"/></svg>
                                {seenWith.get(actor.id)} en tu biblioteca
                            </span>
                        ) : null}
                    </div>
                </a>
            ))}
        </div>
    </section>
)}
