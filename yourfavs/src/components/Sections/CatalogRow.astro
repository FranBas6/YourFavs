---
/**
 * Fila de catálogo de la Home (tendencias, populares, top…), extraída de index.astro
 * para poder renderizarla dentro del bucle ordenable de "Home a tu medida" (§4).
 */
import SectionHeader from "../SectionHeader.astro";
import HoverPreview from "../HoverPreview.astro";
import CardMovie from "../Cards/CardMovie.astro";
import CardSerie from "../Cards/CardSerie.astro";
import { posterUrl } from "../../services/API/shared/tmdbClient";
import { getGenreName } from "../../utils/constants/genres";

interface Props { section: any; }
const { section } = Astro.props;
---
<article class={`yf-row ${section.priority === 'high' ? 'featured-section' : ''}`}>
    <SectionHeader
        title={section.title}
        link={section.link}
        color={section.color as any}
        icon={section.lucide}
        count={section.movies.length + section.series.length}
        featured={section.priority === 'high'}
        subtitle={section.subtitle}
        why={section.why}
    />

    <div class="section-content">
        {section.movies.length > 0 && (
                <div class="content-category">
                    {/* Sin icono: los dos carriles llevaban el MISMO monitor (el de «Películas» era
                        literalmente un monitor de ordenador con peana, y el de «Series» el mismo más dos
                        puntitos), así que no distinguían nada. Un rótulo de dos palabras no lo necesita. */}
                    <h3 class="category-title">
                        <span>Películas</span>
                        <span class="item-count">({section.movies.length})</span>
                    </h3>
                    <div class="cards-grid">
                        {section.movies.slice(0, 10).map((item: any) => (
                                <div class="card-container">
                                    <HoverPreview tmdbId={item.id} tmdbType="movie" title={item.title} backdropPath={item.backdrop_path} href={`/movie/${item.id}`} year={item.release_date?.slice(0,4)} rating={item.vote_average}><CardMovie
                                            id={item.id.toString()}
                                            img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                            title={item.title}
                                            platform={item._platform}
                                            vote_average={item.vote_average}
                                            overview={item.overview}
                                            release_date={item.release_date}
                                            genres={item.genre_ids?.map((id: number) => ({
                                                id,
                                                name: getGenreName(id)
                                            }))}
                                    /></HoverPreview>
                                </div>
                        ))}
                    </div>
                </div>
        )}

        {section.series.length > 0 && (
                <div class="content-category">
                    <h3 class="category-title">
                        <span>Series</span>
                        <span class="item-count">({section.series.length})</span>
                    </h3>
                    <div class="cards-grid">
                        {section.series.slice(0, 10).map((item: any) => (
                                <div class="card-container">
                                    <HoverPreview tmdbId={item.id} tmdbType="tv" title={item.name} backdropPath={item.backdrop_path} href={`/serie/${item.id}`} year={item.first_air_date?.slice(0,4)} rating={item.vote_average}><CardSerie
                                            id={item.id.toString()}
                                            img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                            name={item.name}
                                            platform={item._platform}
                                            vote_average={item.vote_average}
                                            overview={item.overview}
                                            first_air_date={item.first_air_date}
                                            seasons={item.seasons}
                                            last_episode_to_air={item.last_episode_to_air}
                                            next_episode_to_air={item.next_episode_to_air}
                                            genres={item.genre_ids?.map((id: number) => ({
                                                id,
                                                name: getGenreName(id)
                                            }))}
                                    /></HoverPreview>
                                </div>
                        ))}
                    </div>
                </div>
        )}
    </div>
</article>
