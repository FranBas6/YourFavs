/**
 * HoverPreview — RETIRADO en el rediseño (paso 3.7): la vista previa por hover se sustituye por la
 * «vista rápida» (QuickView.astro), que se abre con el ▶ del póster de la tarjeta. El componente se
 * queda como envoltorio transparente para no tocar de golpe sus usos (las rejillas del catálogo y
 * de Mis listas): acepta las mismas props y solo pinta su contenido. Se puede ir quitando de cada
 * página cuando se pase por ella.
 */
interface Props {
    tmdbId?: number | string;
    tmdbType?: 'movie' | 'tv';
    title?: string;
    backdropPath?: string | null;
    href?: string;
    year?: string | number | null;
    rating?: number | null;
}
