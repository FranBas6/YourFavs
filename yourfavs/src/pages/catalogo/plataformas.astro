---
import Layout from "../../layouts/Layout.astro";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import type {Movie} from "../../types/ApiMovie";
import type {Serie} from "../../types/ApiSerie";
import {getGenreName} from "../../utils/constants/genres";
import {posterUrl} from "../../services/API/shared/tmdbClient";
import {tmdbFetchList} from "../../services/API/shared/tmdbClient";
import {PROVIDERS, parseAdvancedFilters, hasActiveFilters, buildDiscoverFilterParams} from "../../services/API/shared/tmdbDiscoverService";
import {platformList, fetchAllPlatforms, fetchPlatformBySlug} from "../../utils/constants/platforms";
import FilterBar from "../../components/FilterBar.astro";
import AdvancedFilters from "../../components/AdvancedFilters.astro";
import Pagination from "../../components/Pagination.astro";
import EmptyState from "../../components/EmptyState.astro";
import HoverPreview from "../../components/HoverPreview.astro";
import {safeFetch} from "../../utils/safeFetch";
import '../../styles/pages/catalogo/shared.css';

const urlParams = new URL(Astro.url, Astro.request.url).searchParams;
const page = Number(urlParams.get('page')) || 1;
const pageStr = page.toString();
const platformParam = urlParams.get('platform') || 'all';
const type = urlParams.get('type') || 'all';

const filters = parseAdvancedFilters(urlParams);
const filtersActive = hasActiveFilters(filters);

// Slug local → provider_id de TMDB
const SLUG_TO_PROVIDER_ID: Record<string, number> = {
    netflix: PROVIDERS.NETFLIX,
    amazon: PROVIDERS.AMAZON,
    disney: PROVIDERS.DISNEY,
    hbo: PROVIDERS.HBO,
    apple: PROVIDERS.APPLE,
    movistar: PROVIDERS.MOVISTAR,
    filmin: PROVIDERS.FILMIN,
};

let movies: Movie[] = [];
let series: Serie[] = [];

if (filtersActive) {
    // Con filtros: discover directo combinando with_watch_providers + watch_region + filtros.
    // Si platform === 'all', combinamos TODOS los providers con OR (pipe).
    const providerIds = platformParam === 'all'
        ? Object.values(SLUG_TO_PROVIDER_ID).join('|')
        : String(SLUG_TO_PROVIDER_ID[platformParam] || '');

    const buildParams = (mt: 'movie' | 'tv') => ({
        page: pageStr,
        sort_by: 'popularity.desc',
        watch_region: 'ES',
        with_watch_providers: providerIds,
        ...buildDiscoverFilterParams(filters, mt),
    });

    [movies, series] = await Promise.all([
        safeFetch(tmdbFetchList<Movie>('/discover/movie', buildParams('movie')), 'plataformas/moviesFiltered', [] as Movie[]),
        safeFetch(tmdbFetchList<Serie>('/discover/tv', buildParams('tv')), 'plataformas/seriesFiltered', [] as Serie[]),
    ]);
} else if (platformParam === 'all') {
    const allPlatforms = await safeFetch(fetchAllPlatforms(pageStr), 'plataformas/all', [] as { movies: Movie[]; series: Serie[] }[]);
    const allMovies = allPlatforms.flatMap(p => p.movies);
    const allSeries = allPlatforms.flatMap(p => p.series);
    movies = allMovies.filter((item, i, self) => i === self.findIndex(t => t.id === item.id));
    series = allSeries.filter((item, i, self) => i === self.findIndex(t => t.id === item.id));
} else {
    const result = await safeFetch(
        fetchPlatformBySlug(platformParam, pageStr),
        `plataformas/${platformParam}`,
        { movies: [] as Movie[], series: [] as Serie[] }
    );
    movies = result.movies;
    series = result.series;
}

const totalPages = 190;
const activePlatform = platformParam === 'all' ? 'Todas' : platformList.find(p => p.slug === platformParam)?.name || platformParam;

function buildFilterUrl(changes: Record<string, string | null>) {
    const p = new URLSearchParams(urlParams);
    for (const [k, v] of Object.entries(changes)) {
        if (v === null || v === '') p.delete(k);
        else p.set(k, v);
    }
    p.set('page', '1');
    return `?${p.toString()}`;
}

function buildTypeUrl(t: string) {
    const changes: Record<string, string | null> = { type: t };
    if (t !== 'series') changes.status = null;
    if (t !== 'movies') changes.runtime = null;
    return buildFilterUrl(changes);
}

function buildPlatformUrl(slug: string) {
    const p = new URLSearchParams(urlParams);
    p.set('platform', slug);
    p.set('page', '1');
    return `?${p.toString()}`;
}
---
<Layout title="Plataformas">
    <section class="px-1 sm:py-8">
        <header class="mb-6">
            <p class="text-sm text-gray-4000 mb-1">Plataforma</p>
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900">{activePlatform}</h1>
        </header>

        <!-- Plataformas: desplegable en móvil, pills en desktop -->
        <details class="mb-6 sm:hidden group">
            <summary class="flex items-center justify-between px-4 py-3 bg-white rounded-xl border border-gray-200 shadow-sm cursor-pointer text-sm font-medium text-gray-700">
                Cambiar plataforma
                <svg class="w-4 h-4 text-gray-4000 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
            </summary>
            <div class="flex flex-wrap gap-2 mt-2 p-3 bg-white rounded-xl border border-gray-100 shadow-sm">
                <a href={buildPlatformUrl('all')}
                   class={`px-3 py-1.5 rounded-full text-sm font-medium transition-all border
                       ${platformParam === 'all'
                           ? 'bg-blue-600 text-white border-blue-600'
                           : 'bg-gray-50 text-gray-600 border-gray-200 hover:border-blue-300 hover:text-blue-600'}`}>
                    Todas
                </a>
                {platformList.map((platform) => (
                    <a href={buildPlatformUrl(platform.slug)}
                       class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium transition-all border
                           ${platformParam === platform.slug
                               ? 'bg-blue-600 text-white border-blue-600'
                               : 'bg-gray-50 text-gray-600 border-gray-200 hover:border-blue-300 hover:text-blue-600'}`}>
                        <img src={platform.logo} alt="" class="w-4 h-4 object-contain rounded" aria-hidden="true"/>
                        {platform.name}
                    </a>
                ))}
            </div>
        </details>
        <div class="hidden sm:flex flex-wrap gap-2 mb-6">
            <a href={buildPlatformUrl('all')}
               class={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full text-sm font-medium transition-all border
                   ${platformParam === 'all'
                       ? 'bg-blue-600 text-white border-blue-600 shadow-sm'
                       : 'bg-white text-gray-600 border-gray-200 hover:border-blue-300 hover:text-blue-600 hover:shadow-sm'}`}>
                Todas
            </a>
            {platformList.map((platform) => (
                <a href={buildPlatformUrl(platform.slug)}
                   class={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full text-sm font-medium transition-all border
                       ${platformParam === platform.slug
                           ? 'bg-blue-600 text-white border-blue-600 shadow-sm'
                           : 'bg-white text-gray-600 border-gray-200 hover:border-blue-300 hover:text-blue-600 hover:shadow-sm'}`}>
                    <img src={platform.logo} alt="" class="w-5 h-5 object-contain rounded" aria-hidden="true"/>
                    {platform.name}
                </a>
            ))}
        </div>

        <FilterBar currentType={type} buildUrl={buildTypeUrl} />

        <AdvancedFilters filters={filters} buildUrl={buildFilterUrl} showRuntime={type === 'movies'} showStatus={type === 'series'} />

        <div class="flex items-center justify-between mb-6 text-sm text-gray-500">
            <span>Página <strong class="text-gray-900">{page}</strong> de {totalPages} · <strong class="text-gray-700">{activePlatform}</strong></span>
            <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 bg-green-400 rounded-full"></span>
                Actualizado hoy
            </div>
        </div>

        <!-- Películas -->
        {(type === 'all' || type === 'movies') && movies.length > 0 && (
            <div class="mb-12" id="peliculas">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-red-500 rounded-full"></span>
                    Películas
                </h2>
                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                    {movies.map((item) => (
                        <div class="card-wrapper group">
                            <HoverPreview tmdbId={item.id} tmdbType="movie" title={item.title} backdropPath={item.backdrop_path} href={`/movie/${item.id}`} year={item.release_date?.slice(0,4)} rating={item.vote_average}><CardMovie
                                id={item.id.toString()}
                                img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                title={item.title}
                                vote_average={item.vote_average}
                                overview={item.overview}
                                release_date={item.release_date}
                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                            /></HoverPreview>
                        </div>
                    ))}
                </div>
            </div>
        )}

        <!-- Series -->
        {(type === 'all' || type === 'series') && series.length > 0 && (
            <div class="mb-12" id="series">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-blue-500 rounded-full"></span>
                    Series
                </h2>
                <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                    {series.map((item) => (
                        <div class="card-wrapper group">
                            <HoverPreview tmdbId={item.id} tmdbType="tv" title={item.name} backdropPath={item.backdrop_path} href={`/serie/${item.id}`} year={item.first_air_date?.slice(0,4)} rating={item.vote_average}><CardSerie
                                id={item.id.toString()}
                                img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                name={item.name}
                                vote_average={item.vote_average}
                                overview={item.overview}
                                first_air_date={item.first_air_date}
                                seasons={item.seasons}
                                last_episode_to_air={item.last_episode_to_air}
                                next_episode_to_air={item.next_episode_to_air}
                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                            /></HoverPreview>
                        </div>
                    ))}
                </div>
            </div>
        )}

        {movies.length === 0 && series.length === 0 && (
            <EmptyState
                variant="filter"
                title="No se encontraron resultados"
                description="Intenta con otra plataforma o ajusta los filtros."
            />
        )}

        <Pagination page={page} totalPages={totalPages} buildUrl={(p) => {
            const q = new URLSearchParams(urlParams);
            q.set('page', String(p));
            return `?${q.toString()}`;
        }} />
    </section>
</Layout>
