---
import CardMovie from "../Cards/CardMovie.astro";
import {getNowPlayingMoviesInSpain} from "../../services/API/Movies/tmdbMovies";

// Obtener el parámetro de página desde la URL
const urlParams = new URL(Astro.request.url).searchParams;
const page = Number(urlParams.get('page') || 1);

// Cargar las películas y series para la página actual
const onAirMovies = await getNowPlayingMoviesInSpain({page: page.toString()});

// Total de páginas, puedes obtenerlo del API o mantenerlo como un valor estático
const totalPages = 3;

// Definir los géneros comunes
const genresMap: Record<number, string> = {
    28: "Acción",
    12: "Aventura",
    16: "Animación",
    35: "Comedia",
    80: "Crimen",
    99: "Documental",
    18: "Drama",
    10751: "Familia",
    14: "Fantasía",
    36: "Historia",
    27: "Terror",
    10402: "Música",
    9648: "Misterio",
    10749: "Romance",
    878: "Ciencia ficción",
    10770: "Película de TV",
    53: "Thriller",
    10752: "Bélica",
    37: "Western",
    10759: "Acción y Aventura",
    10762: "Infantil",
    10763: "Noticias",
    10764: "Reality",
    10765: "Sci-Fi y Fantasía",
    10766: "Soap",
    10767: "Talk",
    10768: "Guerra y Política"
};

function getGenreName(id: number): string {
    return genresMap[id] || "Otro";
}
---
<section class="px-1 sm:py-8">
    <!-- Hero Section con mejor jerarquía visual -->
    <div class="relative container mx-auto px-4 text-center">
        <div class="inline-flex items-center gap-2 bg-coral-red/10 text-coral-red px-4 py-2 rounded-full text-sm font-medium mb-6">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            Actualizado diariamente
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight">
            <span class="text-coral-red">🎬 CARTELERA</span>
            <br class="sm:hidden">
            <span class="relative">
                    EN ESPAÑA
                    <div class="absolute -bottom-2 left-0 right-0 h-1 bg-gradient-to-r from-coral-red to-coral-red/60 rounded-full"></div>
                </span>
        </h1>

        <p class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto mb-8 leading-relaxed">
            Descubre las películas que están actualmente en los cines de España.
            <span class="text-coral-red font-medium">¡No te pierdas los últimos estrenos!</span>
        </p>

        <!-- Indicador de resultados -->
        <div class="inline-flex items-center gap-2 bg-white/80 backdrop-blur-sm border border-gray-200 px-4 py-2 rounded-full text-sm text-gray-600">
            <svg class="w-4 h-4 text-coral-red" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd"
                      d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
                      clip-rule="evenodd"/>
            </svg>
            {onAirMovies.length} películas disponibles en esta página
        </div>
    </div>

    <div class="container mx-auto px-4 py-8">
        <!-- Información de paginación superior mejorada y más responsive -->
        <div class="bg-gradient-to-r from-white to-gray-50 rounded-2xl p-4 md:p-6 mb-8 shadow-sm border border-gray-100">
            <div class="flex flex-col gap-6 md:gap-4 md:flex-row md:items-center md:justify-between">

                <!-- Info de página -->
                <div class="flex items-center gap-3">
                    <div class="flex items-center justify-center w-10 h-10 bg-coral-red/10 rounded-xl shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-coral-red" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                    </div>
                    <div class="text-sm">
                        <div class="font-semibold text-gray-900">
                            Página <span class="text-coral-red">{page}</span> de <span
                                class="text-coral-red">{totalPages}</span>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2 text-sm text-gray-500">
                            <span>Mostrando contenido de la cartelera</span>
                        </div>
                    </div>
                </div>

                <!-- Stats adicionales -->
                <div class="flex flex-wrap justify-start md:justify-end items-center gap-x-4 gap-y-2 text-sm">
                    <div class="flex items-center gap-2 text-gray-600">
                        <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                        <span>Actualizado hoy</span>
                    </div>

                    <div class="flex items-center gap-2 text-gray-600">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                        </svg>
                        <span>Cartelera</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Grid de películas con mejor spacing y loading states -->
        <section class="mb-12">
            <div class="flex items-center gap-3 mb-6">
                <div class="flex items-center gap-2">
                    <div class="w-1 h-8 bg-coral-red rounded-full"></div>
                    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">
                        Películas en Cartelera
                    </h2>
                </div>
                <div class="hidden sm:block flex-1 h-px bg-gradient-to-r from-gray-200 to-transparent"></div>
            </div>

            {onAirMovies.length > 0 ? (
                    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
                        {onAirMovies.map((item) => (
                                <div class="movie-card group" }>
                                    <CardMovie
                                            id={item.id.toString()}
                                            img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                            title={item.title}
                                            vote_average={item.vote_average}
                                            overview={item.overview}
                                            release_date={item.release_date}
                                            genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                    />
                                </div>
                        ))}
                    </div>
            ) : (
                    <div class="text-center py-12">
                        <div class="w-24 h-24 mx-auto mb-4 bg-gray-100 rounded-full flex items-center justify-center">
                            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2h4a1 1 0 110 2h-1v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6H3a1 1 0 110-2h4zM9 6v10a1 1 0 002 0V6h2v10a1 1 0 002 0V6h-6z"/>
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold text-gray-900 mb-2">No hay películas disponibles</h3>
                        <p class="text-gray-600">Intenta con otra página o vuelve más tarde.</p>
                    </div>
            )}
        </section>

        <!-- Paginación mejorada -->
        <nav aria-label="Paginación" class="mt-12">
            <!-- Navegación móvil -->
            <div class="flex sm:hidden items-center justify-between bg-white rounded-xl p-4 shadow-sm border border-gray-100">
                <a href={`?page=${Math.max(1, page - 1)}`}
                   class={`pagination-btn-mobile ${page === 1 ? 'disabled' : ''}`}
                   aria-disabled={page === 1}>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Anterior
                </a>

                <div class="flex items-center gap-2 px-4">
                    <span class="text-sm text-gray-600">Página</span>
                    <span class="px-3 py-1 bg-coral-red text-white rounded-lg font-semibold text-sm">{page}</span>
                    <span class="text-sm text-gray-600">de {totalPages}</span>
                </div>

                <a href={`?page=${Math.min(totalPages, page + 1)}`}
                   class={`pagination-btn-mobile ${page === totalPages ? 'disabled' : ''}`}
                   aria-disabled={page === totalPages}>
                    Siguiente
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>

            <!-- Navegación escritorio -->
            <div class="hidden sm:flex justify-center">
                <div class="inline-flex items-center bg-white rounded-xl p-2 shadow-sm border border-gray-100">
                    <!-- Botón anterior -->
                    <a href={`?page=${Math.max(1, page - 1)}`}
                       class={`pagination-btn ${page === 1 ? 'disabled' : ''}`}
                       aria-disabled={page === 1}>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                        </svg>
                        Anterior
                    </a>

                    <!-- Primera página -->
                    {page > 2 && (
                            <>
                                <a href={`?page=1`} class="pagination-number">1</a>
                                {page > 3 && <span class="px-2 text-gray-400">...</span>}
                            </>
                    )}

                    <!-- Página anterior -->
                    {page > 1 && (
                            <a href={`?page=${page - 1}`} class="pagination-number">{page - 1}</a>
                    )}

                    <!-- Página actual -->
                    <span class="pagination-number active">{page}</span>

                    <!-- Página siguiente -->
                    {page < totalPages && (
                            <a href={`?page=${page + 1}`} class="pagination-number">{page + 1}</a>
                    )}

                    <!-- Última página -->
                    {page < totalPages - 1 && (
                            <>
                                {page < totalPages - 2 && <span class="px-2 text-gray-400">...</span>}
                                <a href={`?page=${totalPages}`} class="pagination-number">{totalPages}</a>
                            </>
                    )}

                    <!-- Botón siguiente -->
                    <a href={`?page=${Math.min(totalPages, page + 1)}`}
                       class={`pagination-btn ${page === totalPages ? 'disabled' : ''}`}
                       aria-disabled={page === totalPages}>
                        Siguiente
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                </div>
            </div>
        </nav>
</section>

<style is:global>
    .text-coral-red {
        color: #E63946;
    }

    .bg-coral-red {
        background-color: #E63946;
    }

    .bg-coral-red\/10 {
        background-color: rgba(233, 57, 70, 0.1);
    }

    .bg-coral-red\/90 {
        background-color: rgba(233, 57, 70, 0.9);
    }

    /* Animaciones mejoradas para las cards */
    .movie-card {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeInUp 0.6s ease-out forwards;
        height: 100%;
    }

    .movie-card:hover {
        transform: translateY(-8px);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .movie-card:hover::after {
        content: '';
        position: absolute;
        inset: 0;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
        border-radius: inherit;
        z-index: -1;
        opacity: 0;
    }

    /* Asegurar consistencia en las cards */
    .movie-card > * {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .movie-card img {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
        border-radius: 0.75rem 0.75rem 0 0;
    }

    .movie-card h3,
    .movie-card h4 {
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.6em;
    }

    /* Mejor responsive */
    @media (max-width: 640px) {
        .movie-card {
            animation-delay: 0ms !important;
        }
    }


    /* Smooth scroll mejorado */
    html {
        scroll-behavior: smooth;
    }

    @media (prefers-reduced-motion: reduce) {
        .movie-card {
            animation: none;
            opacity: 1;
            transform: none;
        }

        html {
            scroll-behavior: auto;
        }
    }

    /* Paginación mejorada */
    .pagination-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
        color: #374151;
        background-color: #F9FAFB;
        border: 1px solid #E5E7EB;
    }

    .pagination-btn:hover:not(.disabled) {
        background-color: #E63946;
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(230, 57, 70, 0.3);
    }

    .pagination-btn.disabled {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
    }

    .pagination-btn-mobile {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
        color: #374151;
        background-color: #F9FAFB;
        border: 1px solid #E5E7EB;
        min-width: 100px;
        justify-content: center;
    }

    .pagination-btn-mobile:hover:not(.disabled) {
        background-color: #E63946;
        color: white;
        transform: translateY(-1px);
    }

    .pagination-btn-mobile.disabled {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
    }

    .pagination-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
        color: #6B7280;
        background-color: transparent;
    }

    .pagination-number:hover {
        background-color: #F3F4F6;
        color: #374151;
    }

    .pagination-number.active {
        background-color: #E63946;
        color: white;
        box-shadow: 0 2px 8px rgba(230, 57, 70, 0.3);
    }
</style>