                                                                <!-- Imagen de la serie -->
                                                                <div class="relative aspect-[2/3] overflow-hidden">
                                                                    <img
                                                                            src={serie.poster_path}
                                                                            alt={serie.name}
                                                                            loading="lazy"
                                                                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                                                                    />

                                                                    <!-- Overlay con gradiente -->
                                                                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

                                                                    <!-- Rating badge -->
                                                                    <div class="absolute top-2 right-2 bg-black/70 text-white text-xs px-2 py-1 rounded-full backdrop-blur-sm">
                                                                        ⭐ {serie.vote_average.toFixed(1)}
                                                                    </div>

                                                                    <!-- Botón de play overlay -->
                                                                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                                                        <div class="bg-white/90 rounded-full p-3 shadow-lg transform scale-0 group-hover:scale-100 transition-transform duration-300">
                                                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                                                 class="h-6 w-6 text-blue-600"
                                                                                 fill="currentColor"
                                                                                 viewBox="0 0 24 24">
                                                                                <path d="M8 5v14l11-7z"/>
                                                                            </svg>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <!-- Información de la película -->
                                                                <div class="p-4 bg-white h-32 flex flex-col justify-between">
                                                                    <div>
                                                                        <h3 class="font-semibold text-gray-800 text-sm line-clamp-2 group-hover:text-blue-600 transition-colors duration-300">
                                                                            {serie.name}
                                                                        </h3>
                                                                    </div>

                                                                    <div class="mt-auto">
                                                                        <div class="flex items-center justify-between">
                                                                            <span class="text-xs text-gray-500">
                                                                                {serie.first_air_date ? new Date(serie.first_air_date).getFullYear() : 'Próximamente'}
                                                                                </span>
                                                                            <div class="flex items-center gap-1">
                                                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                                                     class="h-3 w-3 text-yellow-400"
                                                                                     fill="currentColor"
                                                                                     viewBox="0 0 20 20">
                                                                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                                                                </svg>
                                                                                <span class="text-xs text-gray-600 font-medium">
                                                                                    {serie.vote_average.toFixed(1)}
                                                                                </span>
                                                                            </div>
                                                                        </div>

                                                                        <!-- Sinopsis corta - ahora siempre visible pero con altura fija -->
                                                                        <div class="mt-2 h-9 overflow-hidden">
                                                                            {serie.overview && (
                                                                                    <p class="text-xs text-gray-600 line-clamp-3 opacity-70 group-hover:opacity-100 transition-opacity duration-300">
                                                                                        {serie.overview.slice(0, 100)}...
                                                                                    </p>
                                                                            )}
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </a>
                                                    </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                        )}
                    </div>
                </div>
            </div>
        </div>
    </article>
</Layout>

<style>
    /* Estilos básicos */
    .transition-all {
        transition: all 0.3s ease-in-out;
    }

    .text-yellow-400 {
        color: #fbbf24;
    }

    /* Efecto hover para imágenes */
    img.hover\:scale-105:hover {
        transform: scale(1.05);
    }

    /* Gradiente para el texto sobre imágenes oscuras */
    .text-shadow {
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
    }

    /* Mejorar legibilidad para estrellas de rating */
    .rating-stars {
        letter-spacing: 1px;
    }

    /* Estilos para la animación del acordeón */
    .transform {
        transition-property: transform;
    }

    .transition-transform {
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 300ms;
    }

    .rotate-180 {
        transform: rotate(180deg);
    }

    /* Añade estos estilos a tu sección de <style> */
    details > summary {
        list-style: none;
    }

    details > summary::-webkit-details-marker {
        display: none;
    }

    details[open] > summary svg {
        transform: rotate(180deg);
    }

    /* Estilos mejorados para el overview de temporadas */
    .season-overview {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: all 0.3s ease-in-out;
    }

    /* Cuando el details está abierto, muestra el texto completo */
    details[open] .season-overview {
        display: block;
        -webkit-line-clamp: unset;
        overflow: visible;
    }

    /* Additional styles for enhanced episode view */
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.85);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .modal:target {
        display: flex;
    }

    .modal img {
        max-width: 90%;
        max-height: 90%;
        border-radius: 0.5rem;
    }

    .modal-close {
        position: absolute;
        top: 2rem;
        right: 2rem;
        color: white;
        font-size: 2rem;
        text-decoration: none;
        font-weight: bold;
    }

    /* Estilos CSS para el componente */
    .recommendations-carousel {
        position: relative;
    }

    /* Gradientes laterales para indicar scroll */
    .recommendations-carousel::before,
    .recommendations-carousel::after {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        width: 30px;
        z-index: 5;
        pointer-events: none;
    }

    /* Animación de aparición de las cards */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in-up {
        animation: fadeInUp 0.5s ease forwards;
        opacity: 0;
    }

    /* Clases para truncar texto */
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Hover effects mejorados */
    .recommendation-card {
        transition: transform 0.3s ease;
    }

    .recommendation-card:hover {
        transform: translateY(-8px);
    }

    /* Responsive design */
    @media (max-width: 768px) {
        .recommendation-card {
            width: 140px;
        }

        .recommendations-carousel::before,
        .recommendations-carousel::after {
            width: 20px;
        }

