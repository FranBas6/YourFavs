---
import Layout from "../../layouts/Layout.astro";
import {
    getMoviesAndSeriesByActorId,
    getActorDetailsById, fetchActorImages, fetchTaggedImages,
    getActorCrewCredits
} from "../../services/API/Actors/InfoActor";
import type { CrewCredit } from "../../services/API/Actors/InfoActor";
import { getGenreName, genresMap } from "../../utils/constants/genres";
import { calculateAge, getCareerRange } from "../../utils/constants/helpers/actor-helpers";
import { posterUrl } from "../../services/API/shared/tmdbClient";
import EmptyState from "../../components/EmptyState.astro";
import ActorDubbingSection from "../../components/detail/ActorDubbingSection.astro";
import '../../styles/shared/detail-common.css';
import '../../styles/pages/actor/actor.css';
import { handleActorFavAction, getActorsFav } from "../../services/BD/actors/yourfavsActor";
import type { ActorsFavs } from "../../services/BD/actors/yourfavsActor";
import { getFollowedPerson, handlePersonFollowAction } from "../../services/BD/people/yourfavsPeople";
import { invalidateUpcomingPeopleCache } from "../../services/API/People/upcomingReleases";
import FollowPersonButton from "../../components/personal/FollowPersonButton.astro";
import { SOCIAL_PHASE } from "../../utils/constants/social";
import type { ActorImage, TaggedImage } from "../../services/API/Actors/InfoActor";
import { safeFetch } from "../../utils/safeFetch";
import { getLibrarySnapshot } from "../../services/BD/shared/librarySnapshot";
import { departmentEs } from "../../utils/constants/helpers/team-helpers";

const { actor } = Astro.params;

if (!actor) {
    throw new Error("ID del actor no encontrado en la URL");
}

// POST: gestionar favoritos o seguimiento de la persona
if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        if (String(formData.get('actionType')) === 'follow_person') {
            await handlePersonFollowAction(formData);
            invalidateUpcomingPeopleCache(); // el calendario debe reflejarlo ya
            return Astro.redirect(`/actor/${actor}`);
        }
        const url = await handleActorFavAction(formData);
        return Astro.redirect(url);
    } catch (error) {
        console.error('Error al gestionar el actor:', error);
        return Astro.redirect(`/actor/${actor}`);
    }
}

// Fetch datos en paralelo: detalles + créditos (1 llamada) + crew + imágenes + tagged + favorito
const [actorDetails, credits, crewCredits, profileImages, taggedImages, actorsFavs, followedPerson] = await Promise.all([
    safeFetch(getActorDetailsById({ id: actor }), `actor/${actor}/details`, null as any),
    safeFetch(getMoviesAndSeriesByActorId({ id: actor }), `actor/${actor}/credits`, { movies: [], series: [] } as any),
    safeFetch(getActorCrewCredits({ id: actor }), `actor/${actor}/crew`, [] as CrewCredit[]),
    safeFetch(fetchActorImages(actor), `actor/${actor}/images`, [] as ActorImage[]),
    safeFetch(fetchTaggedImages(actor), `actor/${actor}/tagged`, [] as TaggedImage[]),
    safeFetch(getActorsFav(), `actor/favs`, [] as ActorsFavs[]),
    safeFetch(getFollowedPerson(actor), `actor/${actor}/followed`, null),
]);
const isFollowingPerson = !!followedPerson;

// Próximos estrenos de ESTA persona: derivados de los créditos ya cargados
// (cast movies/series + crew), sin fetch extra. Dedup por título.
const todayStr = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/Madrid' });
const upcomingSeen = new Set<string>();
const personUpcoming = [
    ...(credits.movies || []).map((c: any) => ({ id: String(c.id), media_type: 'movie' as const, title: c.title, poster_path: c.poster_path || null, date: c.release_date || '', kind: 'Película' })),
    ...(credits.series || []).map((c: any) => ({ id: String(c.id), media_type: 'tv' as const, title: c.name, poster_path: c.poster_path || null, date: c.first_air_date || '', kind: 'Serie' })),
    ...crewCredits.map((c) => ({ id: String(c.id), media_type: c.media_type, title: c.title, poster_path: c.poster_path, date: c.date || (c.year ? `${c.year}-01-01` : ''), kind: c.media_type === 'movie' ? 'Película' : 'Serie' })),
]
    .filter((c) => c.title && c.date && c.date > todayStr)
    .filter((c) => {
        const key = `${c.media_type}_${c.id}`;
        if (upcomingSeen.has(key)) return false;
        upcomingSeen.add(key);
        return true;
    })
    .sort((a, b) => a.date.localeCompare(b.date))
    .slice(0, 6);

// Nombres de los trabajos de equipo en la filmografía (6.3)
const JOB_LABELS: Record<string, string> = {
    Director: 'Dirección', Creator: 'Creación', Writer: 'Guion',
    Screenplay: 'Guion', 'Executive Producer': 'Producción ejecutiva', Producer: 'Producción',
};

const actorInfo = actorDetails || {
    id: null, nombre: actor, biografia: null, lugarNacimiento: null,
    fechaNacimiento: null, fechaFallecimiento: null, imagen: null,
    popularidad: null, conocidoPor: "Acting", genero: null,
    alias: [], homepage: null,
    redes: { imdb: null, wikidata: null, wikipedia: null, twitter: null, instagram: null, facebook: null, tiktok: null, youtube: null },
};

const { movies, series } = credits;
const totalProductions = movies.length + series.length;
const age = calculateAge(actorInfo.fechaNacimiento);
const posters: ActorImage[] = profileImages.slice(0, 25);

// Top géneros
const genreCounts: Record<number, number> = movies.flatMap(m => m.genre_ids || [])
    .reduce((acc: Record<number, number>, gId: number) => { acc[gId] = (acc[gId] || 0) + 1; return acc; }, {});
const topGenres = Object.entries(genreCounts)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5)
    .map(([gId]) => genresMap[parseInt(gId)]);

// Favoritos
const favEntry = actorsFavs.find((a) => a.id === actor);
const isInFavorites = !!favEntry;
const currentPosition = favEntry?.position ?? null;
const totalActorsFavorites = actorsFavs.length;

// Cameos: un solo episodio o «como él mismo» (programas, galas, entrevistas). Van al final y fuera de «Conocido por».
const SELF_ROLE = /\b(self|himself|herself|themselves|narrator|host|presenter)\b/i;
const isCameo = (s: any) => Number(s.episode_count) <= 1 || SELF_ROLE.test(s.character || '');

const hasSocial = actorInfo.redes && Object.values(actorInfo.redes).some(v => v);

// 6.1 · «Conocido por»: sus 4 títulos más populares (sin cameos ni apariciones como sí mismo).
const knownFor = [
    ...movies.map((m: any) => ({ id: String(m.id), mt: 'movie' as const, title: m.title, poster: m.poster_path, year: (m.release_date || '').slice(0, 4), pop: m.popularity || 0, cameo: SELF_ROLE.test(m.character || '') })),
    ...series.map((t: any) => ({ id: String(t.id), mt: 'tv' as const, title: t.name, poster: t.poster_path, year: (t.first_air_date || '').slice(0, 4), pop: t.popularity || 0, cameo: isCameo(t) })),
].filter((x) => x.poster && !x.cameo).sort((a, b) => b.pop - a.pop).slice(0, 4);
// 6.3 · Filmografía como lista: una fila por título (reparto y equipo fundidos), con filtros por tipo
// (película/serie) y por papel (actor/voz/producción), y orden por peso, fecha o nota.
type FRow = { key: string; id: string; mt: 'movie' | 'tv'; title: string; poster: string | null; year: string;
    date: string; roles: string[]; kinds: Set<string>; vote: number; votes: number; pop: number; eps: number; cameo: boolean };
const VOICE = /\(voice\)|\(voz\)/i;
const fRows = new Map<string, FRow>();
const addRow = (mt: 'movie' | 'tv', c: any, role: string, kind: string, extra: Partial<FRow> = {}) => {
    const key = `${mt}_${c.id}`;
    const r: FRow = fRows.get(key) ?? { key, id: String(c.id), mt, title: c.title || c.name || '', poster: c.poster_path || null,
        year: String(c.release_date || c.first_air_date || c.year || '').slice(0, 4), date: c.release_date || c.first_air_date || c.date || '',
        roles: [], kinds: new Set<string>(), vote: Number(c.vote_average) || 0, votes: Number(c.vote_count) || 0, pop: Number(c.popularity) || 0, eps: 0, cameo: false };
    if (role && !r.roles.includes(role)) r.roles.push(role);
    r.kinds.add(kind);
    Object.assign(r, extra);
    fRows.set(key, r);
};
// «Captain Gutt (voz)»: la marca de doblaje va junto a su personaje, no al final de la línea.
const roleOf = (ch: string) => { const c = String(ch || '').replace(VOICE, '').trim(); return VOICE.test(ch || '') ? (c ? `${c} (voz)` : 'Voz') : c; };
for (const m of movies as any[]) addRow('movie', m, roleOf(m.character), VOICE.test(m.character || '') ? 'voz' : 'actor', { cameo: SELF_ROLE.test(m.character || '') });
for (const t of series as any[]) {
    const n = Number(t.episode_count) || 0;
    addRow('tv', t, roleOf(t.character), VOICE.test(t.character || '') ? 'voz' : 'actor', { eps: n, cameo: isCameo(t) });
}
for (const c of crewCredits) addRow(c.media_type, c, JOB_LABELS[c.job] || c.job, 'prod');
const filmSort = Astro.url.searchParams.get('sort') || 'peso';
// Peso: lo conocido que es el título (votos en TMDB, más estable que la popularidad del día, que
// dispara los estrenos), multiplicado por los episodios en series y hundido si es un cameo.
const weight = (r: FRow) => (r.votes + 5 * r.pop) * (r.mt === 'tv' ? 1 + Math.min(r.eps, 120) / 12 : 1) * (r.cameo ? 0.05 : 1);
const filmRows = [...fRows.values()].sort((a, b) =>
    filmSort === 'fecha' ? (b.date || '').localeCompare(a.date || '')
    : filmSort === 'nota' ? b.vote - a.vote
    : weight(b) - weight(a));
const fCount = {
    todo: filmRows.length,
    peliculas: filmRows.filter((r) => r.mt === 'movie').length,
    series: filmRows.filter((r) => r.mt === 'tv').length,
    actor: filmRows.filter((r) => r.kinds.has('actor')).length,
    voz: filmRows.filter((r) => r.kinds.has('voz')).length,
    prod: filmRows.filter((r) => r.kinds.has('prod')).length,
};
const FILM_SHOWN = 30;
const FILM_SORTS = [{ key: 'peso', label: 'Por peso' }, { key: 'fecha', label: 'Más recientes' }, { key: 'nota', label: 'Mejor valoradas' }];
const curFilmSort = FILM_SORTS.find((o) => o.key === filmSort) ?? FILM_SORTS[0];
const fmtDate = (d: string) => new Date(d).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' });
const SOCIAL_LINKS: [string, string | null | undefined][] = [
    ['IMDb', actorInfo.redes?.imdb], ['Wikipedia', actorInfo.redes?.wikipedia], ['Wikidata', actorInfo.redes?.wikidata],
    ['Instagram', actorInfo.redes?.instagram], ['X (Twitter)', actorInfo.redes?.twitter], ['Facebook', actorInfo.redes?.facebook],
    ['TikTok', actorInfo.redes?.tiktok], ['YouTube', actorInfo.redes?.youtube], ['Web', actorInfo.homepage],
];

// Stats calculadas de la filmografía
const allProductions = [...movies, ...series];
const ratedProductions = allProductions.filter((p: any) => p.vote_average > 0);
const avgRating = ratedProductions.length > 0
    ? ratedProductions.reduce((sum: number, p: any) => sum + p.vote_average, 0) / ratedProductions.length
    : null;

const bestMovie = movies.length > 0
    ? movies.reduce((best: any, m: any) => (m.vote_average > best.vote_average ? m : best))
    : null;

// Rango de años en activo (ver getCareerRange): antes era un Math.min/Math.max crudo sobre
// TODOS los créditos, y salía "1952 - 2028 · 76 años" en una actriz de 41 — se leía como su
// edad. El saneado vive en el helper porque la basura de TMDB es sutil (apariciones como sí
// mismo, metraje de archivo, y el año de la SERIE en vez del episodio).
const career = getCareerRange([...movies, ...series], actorInfo.fechaNacimiento, actorInfo.fechaFallecimiento);

// Tu historia con esta persona (§6 detalles con alma): cruza su filmografía (ya cargada)
// con tu biblioteca vista (snapshot cacheado, cero coste TMDB). "Vista" = Vistas ∪
// Favoritos ∪ Me gusta, igual que en el resto de la app.
let seenWithActor: { id: string; media_type: 'movie' | 'tv'; title: string; poster_path: string | null }[] = [];
if (Astro.locals.user) {
    try {
        const snap = await getLibrarySnapshot();
        const watchedMovieIds = new Set<string>([...snap.movVistos, ...snap.movFavs, ...snap.movLike].map((m: any) => String(m.id)));
        const watchedTvIds = new Set<string>([...snap.tvVistos, ...snap.tvFavs, ...snap.tvLike].map((s: any) => String(s.id)));
        for (const m of movies) if (watchedMovieIds.has(String(m.id))) seenWithActor.push({ id: String(m.id), media_type: 'movie', title: m.title, poster_path: m.poster_path || null });
        for (const s of series) if (watchedTvIds.has(String(s.id))) seenWithActor.push({ id: String(s.id), media_type: 'tv', title: s.name, poster_path: s.poster_path || null });
    } catch { /* sin biblioteca → sin caja */ }
}
const seenWithActorCount = seenWithActor.length;
const seenKeys = new Set(seenWithActor.map((t) => `${t.media_type}_${t.id}`));
const actorFirstName = String(actorInfo.nombre || '').split(' ')[0];

// JSON-LD structured data (schema.org Person)
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": actorInfo.nombre,
    "jobTitle": departmentEs(actorInfo.conocidoPor) || "Interpretación",
    ...(actorInfo.imagen && { image: actorInfo.imagen }),
    ...(actorInfo.fechaNacimiento && { birthDate: actorInfo.fechaNacimiento }),
    ...(actorInfo.fechaFallecimiento && { deathDate: actorInfo.fechaFallecimiento }),
    ...(actorInfo.lugarNacimiento && { birthPlace: actorInfo.lugarNacimiento }),
    ...(actorInfo.biografia && { description: String(actorInfo.biografia).slice(0, 500) }),
};
---
<Layout
    title={`${actorInfo.nombre}`}
    description={actorInfo.biografia ? String(actorInfo.biografia).slice(0, 200) : undefined}
    ogImage={actorInfo.imagen || undefined}
    ogType="profile"
>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <section class="px-1 sm:py-8">
        {/* 6.1 · Cabecera tipo ficha (README del handoff, P7): foto, nombre, línea de datos, acciones y «Conocido por». */}
        <header class="ahd">
            <div class="ahd-ph">
                {actorInfo.imagen
                    ? <img src={posterUrl(actorInfo.imagen, 'w342')} alt={actorInfo.nombre} />
                    : <span aria-hidden="true">{String(actorInfo.nombre || '?').split(' ').map((w: string) => w[0]).slice(0, 2).join('')}</span>}
            </div>
            <div class="ahd-tx">
                <h1>{actorInfo.nombre}</h1>
                <p class="ahd-m">
                    {departmentEs(actorInfo.conocidoPor) || 'Interpretación'}
                    {age && <> · {actorInfo.fechaFallecimiento ? `falleció a los ${age} años` : `${age} años`}</>}
                    {actorInfo.lugarNacimiento && <> · {actorInfo.lugarNacimiento}</>}
                </p>
                <div class="ahd-acts">
                    <FollowPersonButton personId={actor} name={actorInfo.nombre} profilePath={actorInfo.imagen} isFollowing={isFollowingPerson} />
                    {/* Favoritos (Mis listas → Actores, posición 1–8): el botón despliega la posición */}
                    <details class="ahd-fav">
                        <summary class="btn" data-tone="fav" aria-pressed={isInFavorites ? 'true' : 'false'}>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.56 3.27a.5.5 0 0 1 .88 0l2.95 5.6a1 1 0 0 0 1.52.3l4.27-3.67a.5.5 0 0 1 .8.52l-2.83 10.25a1 1 0 0 1-.96.73H5.81a1 1 0 0 1-.96-.73L2.02 6.02a.5.5 0 0 1 .8-.52l4.27 3.67a1 1 0 0 0 1.52-.3z"/><path d="M5 21h14"/></svg>
                            {isInFavorites ? `Favorito n.º ${currentPosition}` : 'Añadir a favoritos'}
                        </summary>
                        <div class="ahd-favp">
                            {!isInFavorites ? (
                                <form method="POST">
                                    <input type="hidden" name="actor_id" value={actor} />
                                    <input type="hidden" name="action" value="add" />
                                    <label>Posición <small>(opcional, 1–{totalActorsFavorites + 1})</small>
                                        <input type="number" name="custom_position" min="1" max={totalActorsFavorites + 1} placeholder={String(totalActorsFavorites + 1)} />
                                    </label>
                                    <button type="submit" class="btn btn--sm">Añadir</button>
                                </form>
                            ) : (
                                <>
                                    <form method="POST">
                                        <input type="hidden" name="actor_id" value={actor} />
                                        <input type="hidden" name="action" value="update" />
                                        <label>Posición <small>(1–{totalActorsFavorites})</small>
                                            <input type="number" name="custom_position" min="1" max={totalActorsFavorites} value={currentPosition} required />
                                        </label>
                                        <button type="submit" class="btn btn--sm">Mover</button>
                                    </form>
                                    <form method="POST">
                                        <input type="hidden" name="actor_id" value={actor} />
                                        <input type="hidden" name="action" value="remove" />
                                        <button type="submit" class="btn btn--sm btn--dgr">Quitar de favoritos</button>
                                    </form>
                                </>
                            )}
                        </div>
                    </details>
                    {SOCIAL_PHASE.recommend && Astro.locals.user && (
                        <button type="button" class="btn btn--ghost" data-recommend data-target-type="person" data-target-id={actor} data-title={actorInfo.nombre} data-image={actorInfo.imagen} aria-haspopup="dialog" aria-expanded="false">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                            Recomendar
                        </button>
                    )}
                </div>
                <p class="ahd-note">{isFollowingPerson ? 'Sus próximos estrenos aparecen en tu calendario.' : `Con los avisos, los estrenos de ${actorFirstName} aparecen en tu calendario.`}</p>
            </div>
            {knownFor.length > 0 && (
                <div class="ahd-kn">
                    <p class="ahd-k">Conocido por</p>
                    <div class="ahd-kng">
                        {knownFor.map((k) => (
                            <a href={k.mt === 'movie' ? `/movie/${k.id}` : `/serie/${k.id}`} class="ahd-kc" title={k.title}>
                                <img src={posterUrl(k.poster, 'w185')} alt="" loading="lazy" />
                                <b>{k.title}</b>
                                {k.year && <span>{k.year}</span>}
                            </a>
                        ))}
                    </div>
                </div>
            )}
        </header>

        <div class="acols">
            <div class="acols-main">
                {/* Próximos estrenos (con avisos activados) */}
                {isFollowingPerson && (
                    <div class="fcard">
            {isFollowingPerson && personUpcoming.length > 0 && (
                <div>
                    <p class="font-mono text-[10px] tracking-[.12em] text-gray-400 font-semibold mb-1">TE AVISAREMOS DE · PRÓXIMOS ESTRENOS</p>
                    {personUpcoming.map((u, i) => (
                        <a href={u.media_type === 'movie' ? `/movie/${u.id}` : `/serie/${u.id}`}
                           class={`flex items-center gap-3 py-2.5 px-1 rounded-lg hover:bg-gray-50 transition ${i < personUpcoming.length - 1 ? 'border-b border-gray-100' : ''}`}>
                            {u.poster_path ? (
                                <img src={posterUrl(u.poster_path) || ''} alt="" loading="lazy" class="w-[34px] h-[48px] object-cover rounded flex-shrink-0 bg-gray-200"/>
                            ) : (
                                <div class="w-[34px] h-[48px] rounded flex-shrink-0 bg-gray-200"></div>
                            )}
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-semibold text-gray-800 truncate">{u.title}</p>
                                <p class="font-mono text-[11px] text-gray-500">{u.kind}</p>
                            </div>
                            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 whitespace-nowrap flex-shrink-0">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
                                {new Date(u.date + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
                            </span>
                        </a>
                    ))}
                    <p class="mt-2 text-xs text-gray-500 flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                        Se añaden a tu calendario automáticamente.
                    </p>
                </div>
            )}

            {isFollowingPerson && personUpcoming.length === 0 && (
                <p class="mt-3 text-xs text-gray-500">Ahora mismo no tiene estrenos anunciados — aparecerán aquí y en el calendario cuando los haya.</p>
            )}
                    </div>
                )}

                {/* Tu historia con esta persona (§6 detalles con alma) */}
                {seenWithActorCount > 0 && (
                    <section>
                        <div class="fsec-h"><h2>Tu historia con {actorFirstName}</h2><span class="n">{seenWithActorCount} {seenWithActorCount === 1 ? 'visto' : 'vistos'}</span></div>
                        <div class="ahist">
                            {seenWithActor.slice(0, 12).map((t) => (
                                <a href={t.media_type === 'movie' ? `/movie/${t.id}` : `/serie/${t.id}`} title={t.title}>
                                    {t.poster_path
                                        ? <img src={posterUrl(t.poster_path, 'w154')} alt="" loading="lazy" />
                                        : <span class="ahist-ph">Sin póster</span>}
                                    <b>{t.title}</b>
                                </a>
                            ))}
                        </div>
                    </section>
                )}

                {/* Biografía, plegable */}
                {actorInfo.biografia && (
                    <section>
                        <div class="fsec-h"><h2>Biografía</h2></div>
                        <details class="abio">
                            <summary><p>{actorInfo.biografia}</p><span class="abio-more">Leer más</span></summary>
                        </details>
                    </section>
                )}

        {/* 6.3 · Filmografía: una lista (antes, dos rejillas de pósters y el equipo aparte) */}
        <section id="filmografia" class="afl" data-afl>
            <div class="fsec-h"><h2>Filmografía</h2><span class="n">{fCount.todo} títulos</span></div>
            <div class="afl-ctl">
                <div class="afl-f" role="group" aria-label="Filtrar la filmografía">
                    {[['todo', 'Todo'], ['peliculas', 'Películas'], ['series', 'Series'], ['actor', 'Actor'], ['voz', 'Voz'], ['prod', 'Producción']]
                        .filter(([k]) => k === 'todo' || (fCount as any)[k] > 0)
                        .map(([k, l]) => (
                            <button type="button" class="chip-filter" data-afl-f={k} aria-pressed={k === 'todo' ? 'true' : 'false'}>{l}<span class="chip-n">{(fCount as any)[k]}</span></button>
                        ))}
                </div>
                <details class="afl-sort" data-lh-sort>
                    <summary class="btn btn--sm" aria-label={`Orden: ${curFilmSort.label}`}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 16 4 4 4-4M7 20V4M21 8l-4-4-4 4M17 4v16"/></svg>
                        {curFilmSort.label}
                    </summary>
                    <div class="afl-menu" role="menu">
                        {FILM_SORTS.map((o) => (
                            <a role="menuitemradio" aria-checked={o.key === curFilmSort.key ? 'true' : 'false'} href={`?sort=${o.key}#filmografia`}>{o.label}</a>
                        ))}
                    </div>
                </details>
            </div>
            {filmRows.length === 0 && <EmptyState size="sm" title="No hay títulos en su filmografía" />}
            <ol class:list={['afl-list', { 'is-bydate': filmSort === 'fecha' }]}>
                {filmRows.map((r, i) => {
                    const prevYear = i > 0 ? filmRows[i - 1].year : null;
                    const href = r.mt === 'movie' ? `/movie/${r.id}` : `/serie/${r.id}`;
                    const role = [r.roles.join(' · '), r.eps > 0 ? `${r.eps} ${r.eps === 1 ? 'episodio' : 'episodios'}` : ''].filter(Boolean).join(' · ');
                    return (
                        <li class="afl-r" data-mt={r.mt} data-k={[...r.kinds].join(' ')} data-new-year={filmSort === 'fecha' && r.year !== prevYear ? '1' : undefined}>
                            <span class="afl-y">{r.year || '—'}</span>
                            <a href={href} class="afl-po" tabindex="-1" aria-hidden="true">{r.poster ? <img src={posterUrl(r.poster, 'w154')} alt="" loading="lazy" /> : null}</a>
                            <span class="afl-t"><a href={href}>{r.title}</a>{role && <span class="afl-role">{role}</span>}</span>
                            <span class="afl-ty">{r.mt === 'movie' ? 'Película' : 'Serie'}</span>
                            <span class="afl-nt">{r.vote > 0 ? `★ ${r.vote.toFixed(1).replace('.', ',')}` : ''}</span>
                            <span class="afl-st">{seenKeys.has(r.key) && <span class="afl-seen"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Vista</span>}</span>
                        </li>
                    );
                })}
            </ol>
            {filmRows.length > FILM_SHOWN && (
                <div class="afl-more"><button type="button" class="btn" data-afl-more>Ver los <span data-afl-n>{filmRows.length}</span></button></div>
            )}
        </section>

        <script is:inline>
            (function () {
                var root = document.querySelector('[data-afl]');
                if (!root) return;
                var SHOWN = 30, all = false, cur = 'todo';
                var rows = Array.prototype.slice.call(root.querySelectorAll('.afl-r'));
                var more = root.querySelector('[data-afl-more]');
                function match(r) {
                    if (cur === 'todo') return true;
                    if (cur === 'peliculas') return r.dataset.mt === 'movie';
                    if (cur === 'series') return r.dataset.mt === 'tv';
                    return (' ' + r.dataset.k + ' ').indexOf(' ' + cur + ' ') >= 0;
                }
                function paint() {
                    var n = 0, total = 0;
                    rows.forEach(function (r) {
                        var ok = match(r); if (ok) total++;
                        var show = ok && (all || n < SHOWN); if (show) n++;
                        r.hidden = !show;
                    });
                    if (more) { more.parentNode.hidden = all || total <= SHOWN; more.querySelector('[data-afl-n]').textContent = total; }
                }
                root.querySelectorAll('[data-afl-f]').forEach(function (b) {
                    b.addEventListener('click', function () {
                        cur = b.getAttribute('data-afl-f');
                        root.querySelectorAll('[data-afl-f]').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
                        paint();
                    });
                });
                if (more) more.addEventListener('click', function () { all = true; paint(); });
                document.addEventListener('click', function (e) {
                    root.querySelectorAll('[data-lh-sort][open]').forEach(function (d) { if (!d.contains(e.target)) d.open = false; });
                });
                paint();
            })();
        </script>

        <div class="space-y-10">
            <!-- Doblajes (lazy, eldoblaje.com — solo si el actor es doblador) -->
            <ActorDubbingSection tmdbId={actor} name={actorInfo.nombre} />
        </div>
            </div>

            {/* Columna lateral: datos, fotos y «En películas y eventos» */}
            <aside class="acols-side">
                <div class="fcard">
                    <h3 class="fcard-h"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>Datos</h3>
                    <dl class="fdl">
                        {actorInfo.fechaNacimiento && (<><dt>Nacimiento</dt><dd>{fmtDate(actorInfo.fechaNacimiento)}{age && !actorInfo.fechaFallecimiento && <small> · {age} años</small>}</dd></>)}
                        {actorInfo.fechaFallecimiento && (<><dt>Fallecimiento</dt><dd>{fmtDate(actorInfo.fechaFallecimiento)}{age && <small> · a los {age} años</small>}</dd></>)}
                        {actorInfo.lugarNacimiento && (<><dt>Lugar</dt><dd>{actorInfo.lugarNacimiento}</dd></>)}
                        <dt>Trabajos</dt><dd>{movies.length} {movies.length === 1 ? 'película' : 'películas'} · {series.length} {series.length === 1 ? 'serie' : 'series'}</dd>
                        {avgRating && (<><dt>Nota media</dt><dd>{avgRating.toFixed(1).replace('.', ',')}</dd></>)}
                        {career && (<><dt>En activo</dt><dd>{career.start === career.end ? career.start : `${career.start}–${career.end}`}</dd></>)}
                        {bestMovie && (<><dt>Mejor valorada</dt><dd><a href={`/movie/${bestMovie.id}`}>{bestMovie.title}</a> <small>· ★ {bestMovie.vote_average.toFixed(1).replace('.', ',')}</small></dd></>)}
                        {topGenres.length > 0 && (<><dt>Géneros</dt><dd>{topGenres.join(', ')}</dd></>)}
                        {actorInfo.popularidad && (<><dt>Popularidad</dt><dd>{actorInfo.popularidad.toFixed(0)}</dd></>)}
                        {actorInfo.alias && actorInfo.alias.length > 0 && (<><dt>También como</dt><dd>{actorInfo.alias.join(' · ')}</dd></>)}
                    </dl>
                    {SOCIAL_LINKS.some(([, u]) => u) && (
                        <div class="clinks">
                            {SOCIAL_LINKS.filter(([, u]) => u).map(([label, u]) => (
                                <a href={u!} target="_blank" rel="noopener noreferrer" class="btn btn--sm">{label}</a>
                            ))}
                        </div>
                    )}
                </div>

                {posters.length > 0 && (
                    <details class="cdet">
                        <summary>Fotos<span class="n">{posters.length}</span><svg class="cdet-car" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
                        <div class="cdet-b agal">
                            {posters.map((poster, index) => (
                                <a href={`#img-${index}`}><img src={poster.file_path} alt={`${actorInfo.nombre} - Imagen ${index + 1}`} loading="lazy" /></a>
                            ))}
                        </div>
                    </details>
                )}
                {taggedImages.length > 0 && (
                    <details class="cdet">
                        <summary>En películas y eventos<span class="n">{taggedImages.length}</span><svg class="cdet-car" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
                        <div class="cdet-b agal agal--wide">
                            {taggedImages.map((img, index) => (
                                <a href={`#tagged-${index}`} title={img.media?.title || img.media?.name || ''}>
                                    <img src={img.file_path} alt={img.media?.title || img.media?.name || `Imagen ${index + 1}`} loading="lazy" />
                                </a>
                            ))}
                        </div>
                    </details>
                )}
            </aside>
        </div>

        <!-- Lightbox modales (CSS :target) -->
        {posters.map((poster, index) => (
            <div id={`img-${index}`} class="lightbox fixed inset-0 items-center justify-center bg-black/80 p-4" style="z-index: 9999;">
                <a href="#_" class="absolute inset-0" aria-label="Cerrar"></a>
                <img src={poster.file_path} alt={`${actorInfo.nombre} - Imagen ${index + 1}`}
                     class="relative max-h-[90vh] max-w-[90vw] object-contain rounded-lg shadow-2xl" />
                <a href="#_" class="absolute top-4 right-4 text-white/80 hover:text-white text-3xl font-light leading-none z-10" aria-label="Cerrar">&times;</a>
                {index > 0 && (
                    <a href={`#img-${index - 1}`} class="absolute left-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10" aria-label="Anterior">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    </a>
                )}
                {index < posters.length - 1 && (
                    <a href={`#img-${index + 1}`} class="absolute right-14 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10" aria-label="Siguiente">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </a>
                )}
            </div>
        ))}

        <!-- Lightbox tagged images -->
        {taggedImages.map((img, index) => (
            <div id={`tagged-${index}`} class="lightbox fixed inset-0 items-center justify-center bg-black/80 p-4" style="z-index: 9999;">
                <a href="#_" class="absolute inset-0" aria-label="Cerrar"></a>
                <img src={img.file_path} alt={img.media?.title || img.media?.name || ''}
                     class="relative max-h-[90vh] max-w-[90vw] object-contain rounded-lg shadow-2xl" />
                <a href="#_" class="absolute top-4 right-4 text-white/80 hover:text-white text-3xl font-light leading-none z-10" aria-label="Cerrar">&times;</a>
                {index > 0 && (
                    <a href={`#tagged-${index - 1}`} class="absolute left-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10" aria-label="Anterior">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    </a>
                )}
                {index < taggedImages.length - 1 && (
                    <a href={`#tagged-${index + 1}`} class="absolute right-14 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10" aria-label="Siguiente">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </a>
                )}
            </div>
        ))}
    </section>
</Layout>
