---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404: Página no encontrada">
    <section class="flex flex-col items-center justify-center text-center py-16 px-4 min-h-[60vh]">
        <!-- Kicker mono -->
        <p class="mb-3" style="font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent);">
            Error 404 · Escena cortada
        </p>

        <!-- Número 404 con gradiente -->
        <div class="relative mb-6">
            <h1 class="text-[10rem] sm:text-[12rem] font-black leading-none tracking-tighter"
                style="background: linear-gradient(135deg, #3b82f6, #8b5cf6, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                404
            </h1>
            <div class="absolute inset-0 blur-3xl opacity-20"
                 style="background: linear-gradient(135deg, #3b82f6, #8b5cf6, #ec4899);"></div>
        </div>

        <h2 class="text-2xl sm:text-3xl font-bold text-gray-800 mb-3">
            Esta página no existe
        </h2>

        <p class="text-gray-500 text-lg max-w-md mb-8 leading-relaxed">
            Parece que esta ruta no lleva a ninguna película ni serie. Pero tranquilo, hay mucho más por descubrir.
        </p>

        <div class="w-[280px] sm:w-[360px] rounded-2xl overflow-hidden shadow-xl border border-gray-100 mb-10">
            <img
                src="https://midu.dev/images/this-is-fine-404.gif"
                alt="This is fine meme"
                loading="lazy"
                class="w-full h-auto object-contain"
            />
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
            <a href="/"
               class="px-6 py-3 rounded-full text-white font-semibold bg-[#E63946] hover:bg-[#C7283A] transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5">
                Volver al inicio
            </a>
            <a href="/catalogo/tendencias"
               class="px-6 py-3 rounded-full font-semibold border border-gray-200 text-gray-700 hover:border-gray-400 hover:text-gray-900 transition-all">
                Ver tendencias
            </a>
        </div>
    </section>
</Layout>
