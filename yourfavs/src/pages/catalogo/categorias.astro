---
import Layout from "../../layouts/Layout.astro";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import {getMoviesByCategory} from "../../services/API/Movies/tmdbMovies";
import {getSeriesByCategory} from "../../services/API/Series/tmdbSeries";
import {getGenreName} from "../../utils/constants/genres";
import {allCategories} from "../../utils/constants/categories";
import FilterBar from "../../components/FilterBar.astro";
import Pagination from "../../components/Pagination.astro";
import '../../styles/pages/catalogo/shared.css';
import '../../styles/pages/catalogo/card-animations.css';
import '../../styles/pages/catalogo/categorias.css';

const url = new URL(Astro.request.url);
const page = Number(url.searchParams.get('page') || 1);
const category = url.searchParams.get('categoria') || 'proximamente';
const type = url.searchParams.get('type') || 'all';

const latestMovies = await getMoviesByCategory(category, page.toString());
const latestSeries = await getSeriesByCategory(category, page.toString());

const totalPages = 190;
const formattedCategory = category.replace(/_/g, ' ');
---
<Layout title="Categorias">
    <section class="px-1 sm:py-8">
        <!-- Checkbox to control the visibility of the menu on mobile -->
        <input type="checkbox" id="nav-togglee" class="hidden">

        <!-- Label that acts as a button to toggle the menu -->
        <label for="nav-togglee"
            class="cursor-pointer md:hidden block text-white bg-dark-blue rounded-lg px-4 py-2 mt-2 mx-4 focus:outline-none focus:ring-2 focus:ring-blue-400 text-center shadow-lg transition-all duration-300 hover:bg-blue-800 active:scale-95 text-sm font-medium">
        </label>

        <!-- Navegación de categorías -->
        <nav class="flex flex-col items-center justify-center w-full rounded-b-xl text-center md:flex-row md:flex-wrap sticky-navi hidden md:flex shadow-lg border-b-4 border-coral-red"
            id="nav-menuu">
            <!-- Grid compacto para móviles -->
            <div class="grid grid-cols-3 gap-1 w-full p-2 md:hidden">
                {allCategories.map((cat) => (
                    <a href={`?categoria=${cat.slug}&page=1&type=all`}
                       class={`px-6 py-3 flex items-center gap-2 text-white rounded-full transition-all duration-300
                        ${category === cat.slug
                            ? 'bg-gradient-to-r from-red-500 to-orange-500 shadow-lg scale-105 font-semibold'
                            : 'bg-dark-blue hover:bg-blue-700 hover:scale-105 shadow-sm'}`}>
                        {cat.label}
                    </a>
                ))}
            </div>

            <!-- Navegación normal para desktop -->
            <div class="hidden md:flex md:flex-wrap md:justify-center md:items-center md:gap-2 md:p-4">
                {allCategories.map((cat) => (
                    <a href={`?categoria=${cat.slug}&page=1&type=all`}
                       class={`px-6 py-3 flex items-center gap-2 text-white rounded-full transition-all duration-300
                        ${category === cat.slug
                            ? 'bg-gradient-to-r from-red-500 to-orange-500 shadow-lg scale-105 font-semibold'
                            : 'bg-dark-blue hover:bg-blue-700 hover:scale-105 shadow-sm'}`}>
                        {cat.label}
                    </a>
                ))}
            </div>
        </nav>

        <!-- Título principal con mejor diseño -->
        <div class="relative isolate overflow-hidden bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl mx-4 my-6 shadow-xl border border-white/10">
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-white/10 via-transparent to-transparent"></div>
            <h1 class="relative z-10 text-coral-red text-center py-8 px-6 font-extrabold tracking-wide text-3xl sm:text-4xl md:text-5xl lg:text-6xl drop-shadow-lg uppercase">
                {formattedCategory.toUpperCase()}
            </h1>
            <div class="absolute bottom-0 left-1/2 transform -translate-x-1/2 w-24 h-1 bg-coral-red rounded-full"></div>
        </div>

        <FilterBar currentType={type} buildUrl={(t) => `?categoria=${category}&page=1&type=${t}`} />

        <!-- Información de paginación superior mejorada y más responsive -->
        <div class="bg-gradient-to-r from-white to-gray-50 rounded-2xl p-4 md:p-6 mb-8 shadow-sm border border-gray-100">
            <div class="flex flex-col gap-6 md:gap-4 md:flex-row md:items-center md:justify-between">

                <!-- Info de página -->
                <div class="flex items-center gap-3">
                    <div class="flex items-center justify-center w-10 h-10 bg-coral-red/10 rounded-xl shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-coral-red" fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                    </div>
                    <div class="text-sm">
                        <div class="font-semibold text-gray-900">
                            Página <span class="text-coral-red">{page}</span> de <span
                                class="text-coral-red">{totalPages}</span>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2 text-sm text-gray-500">
                        <span>Mostrando contenido {type === 'all' ? 'completo' : type === 'movies' ? 'de películas' : 'de series'}
                            de {category}</span>
                        </div>
                    </div>
                </div>

                <!-- Stats adicionales -->
                <div class="flex flex-wrap justify-start md:justify-end items-center gap-x-4 gap-y-2 text-sm">
                    <div class="flex items-center gap-2 text-gray-600">
                        <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                        <span>Actualizado hoy</span>
                    </div>

                    <div class="flex items-center gap-2 text-gray-600">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                        </svg>
                        <span>Categorías</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sección de Películas con mejor diseño -->
        {(type === 'all' || type === 'movies') && (
                <div class="mb-12" id="peliculas">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-10 h-10 bg-gradient-to-br bg-coral-red rounded-xl flex items-center justify-center shadow-md">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                            </svg>
                        </div>
                        <h2 class="text-2xl md:text-3xl font-bold text-gray-800">Películas</h2>
                        <div class="flex-1 h-px bg-gradient-to-r from-gray-300 to-transparent"></div>
                    </div>

                    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
                        {
                            latestMovies.map((item) => (
                                    <div class="card-wrapper group">
                                        <CardMovie
                                                id={item.id.toString()}
                                                img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                title={item.title}
                                                vote_average={item.vote_average}
                                                overview={item.overview}
                                                release_date={item.release_date}
                                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                        />
                                    </div>
                            ))
                        }
                    </div>
                </div>
        )}

        {(type === 'all' || type === 'series') && (
            <!-- Sección de Series con mejor diseño -->
                <div class="mb-12" id="series">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center shadow-md">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <h2 class="text-2xl md:text-3xl font-bold text-gray-800">Series</h2>
                        <div class="flex-1 h-px bg-gradient-to-r from-gray-300 to-transparent"></div>
                    </div>
                    <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full transition-all duration-300">
                        {
                            latestSeries.map((item) => (
                                    <div class="card-wrapper group">
                                        <CardSerie
                                                id={item.id.toString()}
                                                img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                name={item.name}
                                                vote_average={item.vote_average}
                                                overview={item.overview}
                                                first_air_date={item.first_air_date}
                                                seasons={item.seasons}
                                                last_episode_to_air={item.last_episode_to_air}
                                                next_episode_to_air={item.next_episode_to_air}
                                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                        />
                                    </div>
                            ))
                        }
                    </div>
                </div>
        )}

        <Pagination page={page} totalPages={totalPages} buildUrl={(p) => `?categoria=${category}&page=${p}&type=${type}`} />
    </section>
</Layout>
