---
/**
 * Panel de mensajes (handoff de mensajes §3): en escritorio, 3 columnas bajo PersonalNav —
 * «Amigos» + la lista de conversaciones | lo de la página (slot `main`) | su columna derecha (slot
 * `info`). En móvil la lista solo se ve en la página de Mensajes (`on="list"`).
 *
 * Con `SOCIAL_PHASE.messages` apagado pinta la rejilla de siempre del centro «Amigos» (`.am-grid`),
 * para que todo quede como en F6.
 *
 * La lista la pinta el servidor con `utils/social/chatView.ts` y la refresca cada 30 s
 * `scripts/social/messages/rail.ts` con el mismo marcado.
 *
 * Grupos (M2, `SOCIAL_PHASE.groups`): «＋ Nuevo grupo» en el rótulo «MENSAJES» (oculto sin amigos) y
 * el selector de grupo (`#ms-gp`, sobre el `.rk` de F4), que también abre «Añadir personas».
 */
import { Icon } from 'astro-icon/components';
import { railListHtml } from '../../../utils/social/chatView';
import { SOCIAL_PHASE } from '../../../utils/social/social';
import type { ConvSummary } from '../../../utils/social/types';
import '../../../styles/pages/social/mensajes.css';

interface Props {
    on: 'home' | 'list' | 'chat';
    convs: ConvSummary[];
    /** La conversación abierta (resaltada en la lista). */
    active?: number | null;
    /** Sin columna derecha (vacíos y errores). */
    noInfo?: boolean;
    /** Página de Mensajes vacía: en móvil se ve el vacío en vez de la lista. */
    empty?: boolean;
    /** Tiene amigos: sin ellos no hay «Nuevo grupo». */
    canGroup?: boolean;
}
const { on, convs, active = null, noInfo = false, empty = false, canGroup = false } = Astro.props;
const enabled = SOCIAL_PHASE.messages;
const groups = enabled && SOCIAL_PHASE.groups;
---
{enabled ? (
    <div class:list={['ms-shell', { noinfo: noInfo, norail: on === 'home' }]} data-ms-shell data-on={on} data-active={active ?? ''} data-empty={empty ? '' : undefined}>
        {/* QA 8.4 (H48): Amigos y Mensajes llevan el lateral de Mis listas (con «Mensajes» en Social), así que
            aquí sobran el enlace «Amigos» y, en la página de Amigos, la columna de conversaciones: con las dos
            columnas laterales no cabía el contenido. */}
        {on !== 'home' && <aside class="ms-rail" aria-label="Conversaciones">
            <div class="ms-sec"><span id="ms-sec-l">Mensajes</span>
                <span class="ms-sec-acts">
                    {groups && canGroup && (
                        <button type="button" class="pf-btn sm" data-ms-newgroup aria-haspopup="dialog" aria-label="Nuevo grupo"><Icon name="lucide:plus" /><span class="ms-ng-t">Nuevo grupo</span></button>
                    )}
                    {/* Plegar la columna a solo los avatares (petición de Fran, 2026-11-24): más sitio para el chat. */}
                    <button type="button" class="pf-btn ico sm ms-rail-tg" data-ms-rail-toggle aria-pressed="false" aria-label="Plegar la lista de conversaciones" title="Plegar la lista"><Icon name="lucide:panel-left-close" class="ms-rail-tg-c" /><Icon name="lucide:panel-left-open" class="ms-rail-tg-o" /></button>
                </span>
            </div>
            <ul class="ms-l" aria-labelledby="ms-sec-l" data-ms-list set:html={railListHtml(convs, { active })}></ul>
        </aside>}
        <slot name="main" />
        <slot name="info" />
    </div>
) : (
    <div class="am-grid">
        <slot name="main" />
        <slot name="info" />
    </div>
)}

{/* La columna de conversaciones plegada (solo avatares) si la dejaste así: antes de pintar, sin salto. */}
{enabled && on !== 'home' && (
    <script is:inline>
        try { if (localStorage.getItem('yf:chat-rail') === 'mini') document.querySelector('[data-ms-shell]')?.classList.add('rail-mini'); } catch (e) {}
    </script>
)}

{/* La columna de información, antes de pintar y sin salto: plegada salvo que la dejaras abierta con ⓘ
    (yf:chat-info = '1'). QA 8.4: con el lateral de Mis listas, abierta dejaba el chat en ~400 px. */}
{enabled && on === 'chat' && (
    <script is:inline>
        try { if (localStorage.getItem('yf:chat-info') !== '1') document.querySelector('[data-ms-shell]')?.classList.add('noinfo'); } catch (e) { document.querySelector('[data-ms-shell]')?.classList.add('noinfo'); }
    </script>
)}

{groups && (
    <>
        <div id="ms-gp-bd" class="rk-backdrop" hidden></div>
        <div id="ms-gp" class="rk ms-gp" role="dialog" aria-modal="true" aria-label="Nuevo grupo" hidden></div>
    </>
)}

{enabled && (
    <script>
        import '../../../scripts/social/messages/rail';
        import { SOCIAL_PHASE } from '../../../utils/social/social';
        if (SOCIAL_PHASE.groups) import('../../../scripts/social/messages/groupPicker');
    </script>
)}
