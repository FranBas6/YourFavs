---
import Layout from "../../layouts/Layout.astro";
import {getSeriesByActorId, getMoviesByActorId, getActorDetailsById} from "../../services/yourfavsActor";
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";

const {actor} = Astro.params;

if (!actor) {
    throw new Error("ID de la película no encontrado en la URL");
}

const series = await getSeriesByActorId({id: actor});
const movies = await getMoviesByActorId({id: actor});

// Obtener detalles del actor
const actorDetails = await getActorDetailsById({id: actor});

// Si no se pueden obtener los detalles, usar un placeholder
const actorInfo = actorDetails || {
    id: null,
    nombre: actor,
    biografia: "Información biográfica del actor no disponible.",
    lugarNacimiento: null,
    fechaNacimiento: null,
    imagen: "/placeholder-actor.jpg", // Asegúrate de tener una imagen predeterminada
    popularidad: null,
    conocidoPor: "Actuación"
};

// Definir los géneros comunes
const genresMap = {
    // Géneros de películas y series
    28: "Acción",
    12: "Aventura",
    16: "Animación",
    35: "Comedia",
    80: "Crimen",
    99: "Documental",
    18: "Drama",
    10751: "Familia",
    14: "Fantasía",
    36: "Historia",
    27: "Terror",
    10402: "Música",
    9648: "Misterio",
    10749: "Romance",
    878: "Ciencia ficción",
    10770: "Película de TV",
    53: "Thriller",
    10752: "Bélica",
    37: "Western",
    // Géneros exclusivos de series
    10759: "Acción y Aventura",
    10762: "Infantil",
    10763: "Noticias",
    10764: "Reality",
    10765: "Sci-Fi y Fantasía",
    10766: "Soap",
    10767: "Talk",
    10768: "Guerra y Política"
};

// Función para obtener el nombre del género según su ID
function getGenreName(id: number): string {
    return genresMap[id] || "Otro";
}

// Calcular estadísticas del actor
const totalMovies = movies.length;
const totalSeries = series.length;
const totalProductions = totalMovies + totalSeries;
const movieGenres = movies.flatMap(m => m.genre_ids || [])
    .reduce((acc, genreId) => {
        acc[genreId] = (acc[genreId] || 0) + 1;
        return acc;
    }, {});

// Encontrar los géneros más frecuentes
const topGenres = Object.entries(movieGenres)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 3)
    .map(([genreId, count]) => genresMap[genreId]);
---
<Layout title={`${actorInfo.nombre}`}>
    <div class="actor-profile-bg"></div>
    <section class="container mx-auto px-4 py-8 relative">
        <!-- Perfil del Actor -->
        <div class="actor-profile mb-16">
            <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
                <div class="profile-image-container">
                    {actorInfo.imagen ? (
                            <img
                                    src={`https://image.tmdb.org/t/p/w500${actorInfo.imagen}`}
                                    alt={`Foto de ${actorInfo.nombre}`}
                                    class="profile-image"
                            />
                    ) : (
                            <div class="profile-image-placeholder">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24" viewBox="0 0 20 20"
                                     fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"
                                          clip-rule="evenodd"/>
                                </svg>
                            </div>
                    )}

                    {actorInfo.popularidad && (
                            <div class="popularity-badge">
                                <div class="popularity-inner">
                                    <span class="popularity-value">{actorInfo.popularidad.toFixed(1)}</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.8-2.034c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                    </svg>
                                </div>
                            </div>
                    )}
                </div>

                <div class="flex-1">
                    <h1 class="text-coral-red font-extrabold text-4xl md:text-5xl lg:text-6xl mb-4">
                        {actorInfo.nombre}
                    </h1>
                    <div class="w-24 h-1 bg-coral-red rounded-full mb-6"></div>

                    <div class="actor-stats flex flex-wrap gap-4 mb-4">
                        <a href="#peliculas" class="stat-box" style="text-decoration: none;">
                            <span class="stat-value">{totalProductions}</span>
                            <span class="stat-label">Producciones</span>
                        </a>
                        <a href="#peliculas" class="stat-box" style="text-decoration: none;">
                            <span class="stat-value">{totalMovies}</span>
                            <span class="stat-label">Películas</span>
                        </a>
                        <a href="#series" class="stat-box" style="text-decoration: none;">
                            <span class="stat-value">{totalSeries}</span>
                            <span class="stat-label">Series</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="mt-8">
                {actorInfo.biografia && (
                        <div class="actor-bio mb-6">
                            <h2 class="section-subtitle">Biografía</h2>
                            <input type="checkbox" id="read-more-toggle" class="bio-toggle hidden"/>
                            <p class="text-gray-600 dark:text-gray-300 bio-text">
                                {actorInfo.biografia || "Información biográfica no disponible."}
                            </p>
                            <label for="read-more-toggle" class="read-more-btn"></label>
                        </div>
                )}

                <div class="actor-metadata grid grid-cols-1 md:grid-cols-2 gap-4">
                    {actorInfo.fechaNacimiento && (
                            <div class="metadata-item">
                                <div class="metadata-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                </div>
                                <div>
                                    <span class="metadata-label">Fecha de nacimiento</span>
                                    <span class="metadata-value">{actorInfo.fechaNacimiento}</span>
                                </div>
                            </div>
                    )}
                    {actorInfo.lugarNacimiento && (
                            <div class="metadata-item">
                                <div class="metadata-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </div>
                                <div>
                                    <span class="metadata-label">Lugar de nacimiento</span>
                                    <span class="metadata-value">{actorInfo.lugarNacimiento}</span>
                                </div>
                            </div>
                    )}
                    {actorInfo.conocidoPor && (
                            <div class="metadata-item">
                                <div class="metadata-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                                    </svg>
                                </div>
                                <div>
                                    <span class="metadata-label">Conocido por</span>
                                    <span class="metadata-value">{actorInfo.conocidoPor}</span>
                                </div>
                            </div>
                    )}
                    {topGenres.length > 0 && (
                            <div class="metadata-item col-span-1 md:col-span-2">
                                <div class="metadata-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                                    </svg>
                                </div>
                                <div class="w-full">
                                    <span class="metadata-label block mb-2">Géneros más frecuentes</span>
                                    <div class="flex flex-wrap gap-2">
                                        {topGenres.map(genre => (
                                                <span class="genre-badge">{genre}</span>
                                        ))}
                                    </div>
                                </div>
                            </div>
                    )}
                </div>
            </div>
        </div>

        <!-- Sección de Películas -->
        <section id="peliculas" class="mb-16 content-section scroll-mt-24">
            <div class="section-header-container">
                <h2 class="section-title">
                    <span class="section-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                        </svg>
                    </span>
                    PELÍCULAS
                    <span class="section-count">({movies.length})</span>
                </h2>
                <div class="section-header-line"></div>
            </div>

            {movies.length === 0 ? (
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                            </svg>
                        </div>
                        <h3 class="empty-state-title">No se encontraron películas</h3>
                        <p class="empty-state-description">Este actor no tiene películas registradas en nuestra base de datos.</p>
                    </div>
            ) : (
                    <div class="content-grid">
                        {
                            movies.map((item) => (
                                    <div class="card-wrapper">
                                        <CardMovie
                                                id={item.id.toString()}
                                                img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                title={item.title}
                                                vote_average={item.vote_average}
                                                overview={item.overview}
                                                release_date={item.release_date}
                                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                                providers={item.providers}
                                        />
                                    </div>
                            ))
                        }
                    </div>
            )}
        </section>

        <!-- Sección de Series -->
        <section id="series" class="mb-16 content-section scroll-mt-24">
            <div class="section-header-container">
                <h2 class="section-title">
                    <span class="section-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </span>
                    SERIES
                    <span class="section-count">({series.length})</span>
                </h2>
                <div class="section-header-line"></div>
            </div>

            {series.length === 0 ? (
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <h3 class="empty-state-title">No se encontraron series</h3>
                        <p class="empty-state-description">Este actor no tiene series registradas en nuestra base de datos.</p>
                    </div>
            ) : (
                    <div class="content-grid">
                        {
                            series.map((item) => (
                                    <div class="card-wrapper">
                                        <CardSerie
                                                id={item.id.toString()}
                                                img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                                name={item.name}
                                                vote_average={item.vote_average}
                                                overview={item.overview}
                                                first_air_date={item.first_air_date}
                                                seasons={item.seasons}
                                                last_episode_to_air={item.last_episode_to_air}
                                                next_episode_to_air={item.next_episode_to_air}
                                                genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                                status={item.status}
                                        />
                                    </div>
                            ))
                        }
                    </div>
            )}
        </section>

    </section>
</Layout>

<style is:global>
    /* Variables y colores base */
    :root {
        --coral-red: #E63946;
        --coral-red-light: #f8656f;
        --coral-red-dark: #c41e2b;
        --coral-red-alpha: rgba(230, 57, 70, 0.1);
        --shadow-light: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        --shadow-medium: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        --shadow-large: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --border-radius: 12px;
    }

    /* Scroll suave */
    html {
        scroll-behavior: smooth;
    }

    /* Estilos generales */
    body {
        background-color: #F3F4F6;
        transition: background 0.3s ease;
    }

    .text-coral-red {
        color: var(--coral-red);
    }

    .bg-coral-red {
        background-color: var(--coral-red);
    }

    /* Background con gradiente mejorado */
    .actor-profile-bg {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 500px;
        background: linear-gradient(180deg,
        rgba(230, 57, 70, 0.12) 0%,
        rgba(230, 57, 70, 0.06) 40%,
        rgba(230, 57, 70, 0) 100%);
        z-index: -1;
    }

    /* Perfil del actor mejorado */
    .actor-profile {
        animation: fadeInUp 0.8s ease-out;
        padding: 2.5rem;
        border-radius: var(--border-radius);
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        box-shadow: var(--shadow-large);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    /* Navegación rápida */
    .quick-nav {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .nav-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.25rem;
        background: var(--coral-red-alpha);
        color: var(--coral-red);
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        transition: var(--transition-smooth);
        border: 2px solid transparent;
    }

    .nav-pill:hover {
        background: var(--coral-red);
        color: white;
        transform: translateY(-2px);
        box-shadow: var(--shadow-medium);
    }

    .nav-pill:focus {
        outline: none;
        ring: 2px solid var(--coral-red);
        ring-offset: 2px;
    }

    /* Contenedor de imagen mejorado */
    .profile-image-container {
        position: relative;
        width: 220px;
        height: 330px;
        border-radius: var(--border-radius);
        overflow: hidden;
        box-shadow: var(--shadow-large);
        transition: var(--transition-smooth);
    }

    .profile-image-container:hover {
        transform: scale(1.02);
        box-shadow: 0 25px 35px -5px rgba(0, 0, 0, 0.2);
    }

    .profile-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: var(--transition-smooth);
    }

    .profile-image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f1f3f4 0%, #e8eaed 100%);
        color: #9aa0a6;
    }

    /* Badge de popularidad mejorado */
    .popularity-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #FCD34D 0%, #F59E0B 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--shadow-medium);
        z-index: 2;
        animation: pulse 2s infinite;
    }

    @keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }

    .popularity-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #7C2D12;
        font-weight: 700;
    }

    .popularity-value {
        font-size: 1.1rem;
        line-height: 1;
        margin-bottom: 2px;
    }

    /* Estadísticas mejoradas */
    .stat-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1rem 1.5rem;
        background: linear-gradient(135deg, rgba(230, 57, 70, 0.05) 0%, rgba(230, 57, 70, 0.02) 100%);
        border-radius: var(--border-radius);
        min-width: 120px;
        transition: var(--transition-smooth);
        box-shadow: var(--shadow-light);
        border: 1px solid rgba(230, 57, 70, 0.1);
    }

    .stat-box:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-medium);
        background: linear-gradient(135deg, rgba(230, 57, 70, 0.08) 0%, rgba(230, 57, 70, 0.04) 100%);
    }

    .stat-value {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--coral-red);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.875rem;
        color: #6c757d;
        margin-top: 0.5rem;
        font-weight: 500;
    }

    /* Biografía mejorada */
    .section-subtitle {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--coral-red);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .section-subtitle::before {
        content: '';
        width: 4px;
        height: 24px;
        background: var(--coral-red);
        border-radius: 2px;
    }

    .bio-text {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: var(--transition-smooth);
        line-height: 1.7;
        color: #4a5568;
    }

    .bio-toggle:checked + .bio-text {
        -webkit-line-clamp: unset;
        display: block;
    }

    .read-more-btn {
        display: inline-block;
        color: var(--coral-red);
        font-weight: 600;
        cursor: pointer;
        margin-top: 0.75rem;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        transition: var(--transition-smooth);
        border: 1px solid var(--coral-red-alpha);
    }

    .read-more-btn:hover {
        background: var(--coral-red-alpha);
        transform: translateY(-1px);
    }

    .bio-toggle:checked ~ .read-more-btn::after {
        content: "Leer menos";
    }

    .bio-toggle ~ .read-more-btn::after {
        content: "Leer más";
    }

    /* Metadata mejorada */
    .actor-metadata {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }

    @media (min-width: 768px) {
        .actor-metadata {
            grid-template-columns: 1fr 1fr;
        }
    }

    .metadata-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1.25rem;
        background: rgba(255, 255, 255, 0.7);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-light);
        transition: var(--transition-smooth);
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .metadata-item:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-medium);
        background: rgba(255, 255, 255, 0.9);
    }

    .metadata-icon {
        flex-shrink: 0;
        width: 40px;
        height: 40px;
        background: var(--coral-red-alpha);
        color: var(--coral-red);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .metadata-label {
        display: block;
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 0.25rem;
        font-size: 0.9rem;
    }

    .metadata-value {
        color: #4a5568;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    /* Badges de género mejorados */
    .genre-badge {
        display: inline-block;
        padding: 0.375rem 0.875rem;
        background: linear-gradient(135deg, rgba(230, 57, 70, 0.1) 0%, rgba(230, 57, 70, 0.05) 100%);
        color: var(--coral-red);
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        margin: 0.25rem 0.25rem 0.25rem 0;
        transition: var(--transition-smooth);
        border: 1px solid rgba(230, 57, 70, 0.2);
    }

    .genre-badge:hover {
        background: var(--coral-red);
