---
import CardMovie from "../Cards/CardMovie.astro";
import CardSerie from "../Cards/CardSerie.astro";
import {
    getNetflixSeries,
    getAmazonPrimeSeries,
    getDisneyPlusSeries,
    getHBOMaxSeries,
    getAppleTVSeries,
    getMovistarPlusSeries,
    getFilminSeries
} from "../../services/API/Series/tmdbSeries";
import {
    getNetflixMovies,
    getAmazonPrimeMovies,
    getDisneyPlusMovies,
    getHBOMaxMovies,
    getAppleTVMovies,
    getMovistarPlusMovies,
    getFilminMovies
} from "../../services/API/Movies/tmdbMovies";

// Import the types from your type definition files
import type {Movie} from "../../types/ApiMovie";
import type {Serie} from "../../types/ApiSerie";

// Define type for sort options
type SortOptionS = 'popularity' | 'vote_average' | 'first_air_date' | 'name';
type SortOptionM = 'popularity' | 'vote_average' | 'release_date' | 'title';
type SortOrder = 'desc';

// Obtener parámetros desde la URL
const urlParams = new URL(Astro.url, Astro.request.url).searchParams;
const page = Number(urlParams.get('page')) || 1;
const pageStr = page.toString();
const platformParam = urlParams.get('platform') || 'all';

// Nuevos parámetros para ordenación
const sortBy = urlParams.get('sortBy') || 'popularity';
const sortByS = sortBy as SortOptionS;
const sortByM = sortBy as SortOptionM;
const sortOrder: SortOrder = 'desc';

// Definir plataformas disponibles
const platforms = [
    {id: 'netflix', name: 'Netflix', logo: '/logos/plataformas/netflix.svg'},
    {id: 'amazon', name: 'Amazon Prime', logo: '/logos/plataformas/amazon.svg'},
    {id: 'disney', name: 'Disney+', logo: '/logos/plataformas/disney.svg'},
    {id: 'hbo', name: 'HBO Max', logo: '/logos/plataformas/hbo.svg'},
    {id: 'apple', name: 'Apple TV+', logo: '/logos/plataformas/apple.svg'},
    {id: 'movistar', name: 'Movistar+', logo: '/logos/plataformas/movistar.svg'},
    {id: 'filmin', name: 'Filmin', logo: '/logos/plataformas/filmin.svg'}
];

// Opciones de ordenación
const sortOptions = [
    {id: 'popularity' as const, name: 'Popularidad'},
    {id: 'vote_average' as const, name: 'Puntuación'},
    {id: 'first_air_date' as const, name: 'Fecha de estreno'}
];

// Cargar las películas y series para la página actual basado en la plataforma seleccionada
let movies: Movie[] = [];
let series: Serie[] = [];

// Función para eliminar duplicados en arrays de películas o series por ID
function removeDuplicates<T extends { id: number }>(items: T[]): T[] {
    return items.filter((item, index, self) =>
        index === self.findIndex((t) => t.id === item.id)
    );
}

// Cargar todo el contenido si no hay filtro o filtrar por plataforma
if (platformParam === 'all') {
    // Cargar todas las plataformas con los parámetros de ordenación
    const netflixSeries = await getNetflixSeries(pageStr, sortByS, sortOrder);
    const netflixMovies = await getNetflixMovies(pageStr, sortByM, sortOrder);
    const amazonPrimeSeries = await getAmazonPrimeSeries(pageStr, sortByS, sortOrder);
    const amazonPrimeMovies = await getAmazonPrimeMovies(pageStr, sortByM, sortOrder);
    const disneyPlusSeries = await getDisneyPlusSeries(pageStr, sortByS, sortOrder);
    const disneyPlusMovies = await getDisneyPlusMovies(pageStr, sortByM, sortOrder);
    const hboMaxSeries = await getHBOMaxSeries(pageStr, sortByS, sortOrder);
    const hboMaxMovies = await getHBOMaxMovies(pageStr, sortByM, sortOrder);
    const appleTVSeries = await getAppleTVSeries(pageStr, sortByS, sortOrder);
    const appleTVMovies = await getAppleTVMovies(pageStr, sortByM, sortOrder);
    const movistarPlusSeries = await getMovistarPlusSeries(pageStr, sortByS, sortOrder);
    const movistarPlusMovies = await getMovistarPlusMovies(pageStr, sortByM, sortOrder);
    const filminSeries = await getFilminSeries(pageStr, sortByS, sortOrder);
    const filminMovies = await getFilminMovies(pageStr, sortByM, sortOrder);

    // Combinar todos los resultados
    const allMovies = [
        ...netflixMovies,
        ...amazonPrimeMovies,
        ...disneyPlusMovies,
        ...hboMaxMovies,
        ...appleTVMovies,
        ...movistarPlusMovies,
        ...filminMovies
    ];

    const allSeries = [
        ...netflixSeries,
        ...amazonPrimeSeries,
        ...disneyPlusSeries,
        ...hboMaxSeries,
        ...appleTVSeries,
        ...movistarPlusSeries,
        ...filminSeries
    ];

    // Eliminar duplicados
    movies = removeDuplicates(allMovies);
    series = removeDuplicates(allSeries);

    // Re-ordenar después de eliminar duplicados
    if (sortByM === 'popularity') {
        movies.sort((a, b) => b.popularity - a.popularity);
    } else if (sortByM === 'vote_average') {
        movies.sort((a, b) => b.vote_average - a.vote_average);
    } else if (sortByM === 'release_date') {
        movies.sort((a, b) => new Date(b.release_date).getTime() - new Date(a.release_date).getTime());
    } else if (sortByM === 'title') {
        movies.sort((a, b) => a.title.localeCompare(b.title));
    }

    if (sortByS === 'popularity') {
        series.sort((a, b) => b.popularity - a.popularity);
    } else if (sortByS === 'vote_average') {
        series.sort((a, b) => b.vote_average - a.vote_average);
    } else if (sortByS === 'first_air_date') {
        series.sort((a, b) => new Date(b.first_air_date).getTime() - new Date(a.first_air_date).getTime());
    } else if (sortByS === 'name') {
        series.sort((a, b) => a.name.localeCompare(b.name));
    }

} else {
    // Filtrar por plataforma seleccionada con parámetros de ordenación
    switch (platformParam) {
        case 'netflix':
            movies = await getNetflixMovies(pageStr, sortByM, sortOrder);
            series = await getNetflixSeries(pageStr, sortByS, sortOrder);
            break;
        case 'amazon':
            movies = await getAmazonPrimeMovies(pageStr, sortByM, sortOrder);
            series = await getAmazonPrimeSeries(pageStr, sortByS, sortOrder);
            break;
        case 'disney':
            movies = await getDisneyPlusMovies(pageStr, sortByM, sortOrder);
            series = await getDisneyPlusSeries(pageStr, sortByS, sortOrder);
            break;
        case 'hbo':
            movies = await getHBOMaxMovies(pageStr, sortByM, sortOrder);
            series = await getHBOMaxSeries(pageStr, sortByS, sortOrder);
            break;
        case 'apple':
            movies = await getAppleTVMovies(pageStr, sortByM, sortOrder);
            series = await getAppleTVSeries(pageStr, sortByS, sortOrder);
            break;
        case 'movistar':
            movies = await getMovistarPlusMovies(pageStr, sortByM, sortOrder);
            series = await getMovistarPlusSeries(pageStr, sortByS, sortOrder);
            break;
        case 'filmin':
            movies = await getFilminMovies(pageStr, sortByM, sortOrder);
            series = await getFilminSeries(pageStr, sortByS, sortOrder);
            break;
    }
}

// Función para crear URL con parámetros actualizados
function createUrlWithParams(newParams: Record<string, string>) {
    const currentParams = new URLSearchParams(urlParams);

    // Actualizar con nuevos parámetros
    Object.entries(newParams).forEach(([key, value]) => {
        currentParams.set(key, value);
    });

    // Si cambiamos sortBy, platform o cualquier parámetro que requiera reiniciar página, volvemos a página 1
    if (newParams.sortBy || newParams.platform) {
        currentParams.set('page', '1');
    }

    return `?${currentParams.toString()}`;
}

// Función para obtener el nombre del género
function getGenreName(id: number) {
    // Implementar lógica para obtener el nombre del género
    const genres: Record<number, string> = {
        28: 'Acción',
        12: 'Aventura',
        16: 'Animación',
        35: 'Comedia',
        80: 'Crimen',
        99: 'Documental',
        18: 'Drama',
        10751: 'Familia',
        14: 'Fantasía',
        36: 'Historia',
        27: 'Terror',
        10402: 'Música',
        9648: 'Misterio',
        10749: 'Romance',
        878: 'Ciencia ficción',
        10770: 'Película de TV',
        53: 'Thriller',
        10752: 'Guerra',
        37: 'Western'
    };
    return genres[id] || 'Desconocido';
}

// Total de páginas
const totalPages = 190;
---
<section class="container mx-auto px-4 py-4">
    <header class="mb-10 text-center">
        <h1 class="text-5xl md:text-6xl font-extrabold text-coral-red tracking-tight drop-shadow-lg">
            Plataformas
        </h1>
        <div class="w-24 h-1 bg-coral-red mx-auto mt-3 rounded-full"></div>
        <p class="mt-4 text-gray-600 text-lg max-w-2xl mx-auto">
            Explora las películas y series disponibles según tu plataforma preferida
        </p>
    </header>

    <!-- Filtro de Plataformas -->
    <section class="mb-8">
        <h3 class="text-xl font-semibold text-gray-700 mb-4">Filtrar por plataforma</h3>
        <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 xl:grid-cols-8 gap-4">
            <a href={createUrlWithParams({platform: 'all'})}
               class={`flex flex-col items-center justify-center p-4 rounded-xl border transition-all shadow-sm hover:shadow-md hover:scale-105 ${
                   platformParam === 'all'
                       ? 'bg-ice-blue text-white border-ice-blue'
                       : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50'
               }`}>
                <span class="text-sm font-medium">Todas</span>
            </a>

            {platforms.map((platform) => (
                    <a href={createUrlWithParams({platform: platform.id})}
                       class={`flex flex-col items-center justify-center p-4 rounded-xl border transition-all shadow-sm hover:shadow-md hover:scale-105 ${
                           platformParam === platform.id
                               ? 'bg-ice-blue text-white border-ice-blue'
                               : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50'
                       }`}>
                        <img src={platform.logo} alt={platform.name} class="w-10 h-10 mb-2 object-contain"/>
                        <span class="text-xs font-medium text-center">{platform.name}</span>
                    </a>
            ))}
        </div>
    </section>

    <!-- Opciones de ordenación con botones -->
    <section class="mb-10">
        <div class="bg-white p-6 rounded-2xl shadow-lg">
            <h3 class="text-lg font-semibold text-gray-800 mb-3">Ordenar contenido</h3>
            <div class="flex flex-wrap gap-3">
                {sortOptions.map((option) => (
                        <a href={createUrlWithParams({sortBy: option.id})}
                           class={`px-4 py-2 rounded-full text-sm font-medium transition-all ${
                               sortBy === option.id
                                   ? 'bg-coral-red text-white shadow-md'
                                   : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
                           }`}>
                            {option.name}
                        </a>
                ))}
            </div>
        </div>
    </section>

    <div class="flex justify-center gap-4 mt-6 mb-6 sticky top-5 z-40 bg-white/10 backdrop-blur-md rounded-full px-4 py-2 shadow-lg">
        <a href="#peliculas"
           class="button-bounce px-5 py-2 bg-coral-red text-white rounded-full shadow-lg hover:bg-red-600 transition-all duration-300 text-sm font-semibold tracking-wide">
            Ir a Películas
        </a>
        <a href="#series"
           class="button-bounce px-5 py-2 bg-blue-500 text-white rounded-full shadow-lg hover:bg-blue-600 transition-all duration-300 text-sm font-semibold tracking-wide">
            Ir a Series
        </a>
    </div>

    <!-- Paginación Mejorada para Móviles -->
    <nav aria-label="Paginación" class="flex items-center justify-center mb-8">
        <!-- En pantallas pequeñas (móviles) - Diseño vertical compacto -->
        <div class="flex flex-col w-full max-w-xs gap-2 p-2 bg-white rounded-lg shadow-md sm:hidden">
            <div class="flex justify-center items-center px-2 py-1">
                <span class="font-medium text-gray-700 text-sm">Página</span>
                <span class="mx-2 px-3 py-1 bg-coral-red text-white rounded-md font-bold text-sm">{page}</span>
                <span class="font-medium text-gray-700 text-sm">de {totalPages}</span>
            </div>

            <div class="grid grid-cols-2 gap-2">
                <a href={createUrlWithParams({page: Math.max(1, page - 1).toString()})}
                   class={`px-3 py-2 rounded-lg transition-all duration-300 flex items-center justify-center text-sm ${page === 1 ? 'bg-gray-200 text-gray-500 cursor-not-allowed' : 'bg-blue-500 text-white hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500'}`}
                   aria-disabled={page === 1}>
                    <span class="mr-1">←</span> Anterior
                </a>

                <a href={createUrlWithParams({page: Math.min(totalPages, page + 1).toString()})}
                   class={`px-3 py-2 rounded-lg transition-all duration-300 flex items-center justify-center text-sm ${page === totalPages ? 'bg-gray-200 text-gray-500 cursor-not-allowed' : 'bg-blue-500 text-white hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500'}`}
                   aria-disabled={page === totalPages}>
                    Siguiente <span class="ml-1">→</span>
                </a>
            </div>
        </div>

        <!-- En pantallas medianas y grandes - Diseño horizontal -->
        <div class="hidden sm:flex items-center space-x-2 bg-white p-2 rounded-lg shadow-md">
            <a href={createUrlWithParams({page: Math.max(1, page - 1).toString()})}
               class={`px-4 py-2 rounded-lg transition-all duration-300 flex items-center ${page === 1 ? 'bg-gray-200 text-gray-500 cursor-not-allowed' : 'bg-blue-500 text-white hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500'}`}
               aria-disabled={page === 1}>
                <span class="mr-1">←</span> Anterior
            </a>

            <div class="flex items-center px-4">
                <span class="font-medium text-gray-700">Página</span>
                <span class="mx-2 px-3 py-1 bg-coral-red text-white rounded-md font-bold">{page}</span>
                <span class="font-medium text-gray-700">de {totalPages}</span>
            </div>

            <a href={createUrlWithParams({page: Math.min(totalPages, page + 1).toString()})}
               class={`px-4 py-2 rounded-lg transition-all duration-300 flex items-center ${page === totalPages ? 'bg-gray-200 text-gray-500 cursor-not-allowed' : 'bg-blue-500 text-white hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500'}`}
               aria-disabled={page === totalPages}>
                Siguiente <span class="ml-1">→</span>
            </a>
        </div>
    </nav>

    <!-- Título de plataforma seleccionada y criterio de ordenación -->
    <section class="mb-6 text-center">
        <h2 class="text-2xl font-bold text-gray-800">
            {platformParam === 'all' ? 'Contenido de todas las plataformas' : `Contenido de ${platforms.find(p => p.id === platformParam)?.name || ''}`}
        </h2>
        <p class="text-gray-600">
            Ordenado por <span
                class="font-semibold">{sortOptions.find(o => o.id === sortBy)?.name || 'Popularidad'}</span> en orden
            descendente
        </p>
        {platformParam === 'all' && (
                <p class="text-gray-500 text-sm mt-1">Evita duplicados mostrando una sola vez cada título</p>
        )}
    </section>

    <!-- Sección de Películas -->
    {movies.length > 0 && (
            <section id="peliculas" class="mb-14">
                <h2 class="text-coral-red text-3xl font-bold mb-5 flex items-center">
                    <span class="w-8 h-8 mr-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M7 4v16M17 4v16M3 8h18M3 16h18"/>
                        </svg>
                    </span>
                    PELÍCULAS
                </h2>
                <div class="grid gap-6 grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 transition-all duration-300">
                    {
                        movies.map((item) => (
                                <div class="card-wrapper transform hover:scale-105 transition-transform duration-200">
                                    <CardMovie
                                            id={item.id.toString()}
                                            img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                            title={item.title}
                                            vote_average={item.vote_average}
                                            overview={item.overview}
                                            release_date={item.release_date}
                                            genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                            providers={item.providers}
                                    />
                                </div>
                        ))
                    }
                </div>
            </section>
    )}

    <!-- Sección de Series -->
    {series.length > 0 && (
            <section id="series" class="mb-14">
                <h2 class="text-coral-red text-3xl font-bold mb-5 flex items-center">
                    <span class="w-8 h-8 mr-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </span>
                    SERIES
                </h2>
                <div class="grid gap-6 grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 transition-all duration-300">
                    {
                        series.map((item) => (
                                <div class="card-wrapper transform hover:scale-105 transition-transform duration-200">
                                    <CardSerie
                                            id={item.id.toString()}
                                            img={item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : "/placeholder.jpg"}
                                            name={item.name}
                                            vote_average={item.vote_average}
                                            overview={item.overview}
                                            first_air_date={item.first_air_date}
                                            seasons={item.seasons}
                                            last_episode_to_air={item.last_episode_to_air}
                                            next_episode_to_air={item.next_episode_to_air}
                                            genres={item.genre_ids?.map(id => ({id, name: getGenreName(id)}))}
                                    />
                                </div>
                        ))
                    }
                </div>
            </section>
    )}

    <!-- Mensaje cuando no hay resultados -->
    {movies.length === 0 && series.length === 0 && (
            <div class="text-center py-12">
                <h3 class="text-2xl font-medium mb-2 text-gray-700">No se encontraron resultados</h3>
                <p class="text-gray-600">Intenta con otra plataforma o página</p>
            </div>
    )}

    <!-- Paginación inferior -->
    <div class="mt-12 flex justify-center">
        <div class="inline-flex rounded-md shadow-sm">
            {page > 2 && (
                    <a href={createUrlWithParams({page: '1'})}
                       class="px-3 py-2 bg-white text-gray-700 hover:bg-gray-50 border border-gray-300 rounded-l-lg">
                        1
                    </a>
            )}

            {page > 3 && (
                    <span class="px-3 py-2 bg-white text-gray-700 border-t border-b border-gray-300">
                            ...
                        </span>
            )}

            {page > 1 && (
                    <a href={createUrlWithParams({page: (page - 1).toString()})}
                       class="px-3 py-2 bg-white text-gray-700 hover:bg-gray-50 border border-gray-300">
                        {page - 1}
                    </a>
            )}

            <a href={createUrlWithParams({page: page.toString()})}
               class="px-3 py-2 bg-coral-red text-white border border-coral-red">
                {page}
            </a>

            {page < totalPages && (
                    <a href={createUrlWithParams({page: (page + 1).toString()})}
                       class="px-3 py-2 bg-white text-gray-700 hover:bg-gray-50 border border-gray-300">
                        {page + 1}
                    </a>
            )}

            {page < totalPages - 2 && (
                    <span class="px-3 py-2 bg-white text-gray-700 border-t border-b border-gray-300">
                            ...
                        </span>
            )}

            {page < totalPages - 1 && (
                    <a href={createUrlWithParams({page: totalPages.toString()})}
                       class="px-3 py-2 bg-white text-gray-700 hover:bg-gray-50 border border-gray-300 rounded-r-lg">
                        {totalPages}
                    </a>
            )}
        </div>
    </div>
</section>

<style is:global>
    html {
        scroll-behavior: smooth;
    }

    .text-coral-red {
        color: #E63946;
    }

    .bg-coral-red {
        background-color: #E63946;
    }

    .border-coral-red {
        border-color: #E63946;
    }

    #toggleSidebar:checked ~ #sidebar {
        transform: translateX(0);
    }

    .bg-ice-blue {
        background-color: #3B82F6;
    }

    .border-ice-blue {
        border-color: #3B82F6;
    }

    /* Estilos para asegurar cards del mismo tamaño */
    .card-wrapper {
        display: flex;
        height: 100%;
    }

    .card-wrapper > * {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
    }

    /* Asegurar que todas las imágenes tengan el mismo tamaño */
    .card-wrapper img {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
    }

    /* Asegurar que los títulos tengan una altura fija */
    .card-wrapper h3,
    .card-wrapper h4 {
        height: 3em;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    /* Para el contenido de la tarjeta */
    .card-wrapper > div {
        display: flex;
        flex-direction: column;
        flex: 1;
        background-color: white;
        border-radius: 0.5rem;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        height: 100%;
    }

    /* Para descripciones/overview */
    .card-wrapper p {
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        flex-grow: 1;
    }

    @media (prefers-color-scheme: dark) {
        .card-wrapper > div {
            background-color: #1E1E1E;
            color: #E5E5E5;
        }
    }

    @keyframes click-bounce {
        0% {
            transform: scale(1);
        }
        50% {
            transform: scale(0.93);
        }
        100% {
            transform: scale(1);
        }
    }

    .button-bounce:active {
        animation: click-bounce 0.25s ease-in-out;
    }

</style>