---
import Layout from "../../layouts/Layout.astro"
import CardMovie from "../../components/Cards/CardMovie.astro";
import CardSerie from "../../components/Cards/CardSerie.astro";
import {getSeriesVerPronto, getWatchedProgressBatch} from "../../services/BD/series/yourfavsSerie";
import {getMoviesVerPronto} from "../../services/BD/movies/yourfavsMovie";
import {handleVerProntoAction} from "../../services/BD/actions/handleVerProntoAction";
import {fetchMovieDetails} from "../../services/API/Movies/tmdbMovies";
import {fetchSerieDetails} from "../../services/API/Series/tmdbSeries";
import {getGenreName} from "../../utils/constants/genres";
import {processBatch} from "../../utils/processBatch";
import {posterUrl} from "../../services/API/shared/tmdbClient";
import PersonalNav from "../../components/personal/PersonalNav.astro";
import '../../styles/pages/personal/personal.css';

let clearedType = null;
let errorMessage = "";

if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();
        clearedType = await handleVerProntoAction(formData);
    } catch (error) {
        console.error("Error al procesar acciones:", error);
        errorMessage = error instanceof Error ? error.message : "Error desconocido al procesar la acción";
    }
}

let seriesVerPronto: any[] = [];
let peliculasVerPronto: any[] = [];
let seriesData: any[] = [];
let moviesData: any[] = [];

try {
    [seriesData, moviesData] = await Promise.all([
        getSeriesVerPronto(),
        getMoviesVerPronto()
    ]);

    const [seriesResults, moviesResults] = await Promise.all([
        processBatch(seriesData.map(s => s.id), (id) => fetchSerieDetails(id), 10),
        processBatch(moviesData.map(p => p.id), (id) => fetchMovieDetails(id), 10)
    ]);

    seriesVerPronto = seriesResults.filter(s => s !== null);
    peliculasVerPronto = moviesResults.filter(m => m !== null);
} catch (error) {
    console.error("Error al cargar contenido para ver pronto:", error);
    errorMessage = error instanceof Error ? error.message : "Error desconocido al cargar datos";
}

const watchedMap = await getWatchedProgressBatch(seriesVerPronto.map((s: any) => String(s.id)));

const filter = Astro.url.searchParams.get("filter") || "todos";
const showSeries = filter === "series" || filter === "todos";
const showMovies = filter === "peliculas" || filter === "todos";
const showAll = filter === "todos";
const clearedMessage = clearedType || Astro.url.searchParams.get("cleared");
const hasSeries = seriesVerPronto.length > 0;
const hasMovies = peliculasVerPronto.length > 0;
const hasContent = hasSeries || hasMovies;
---
<Layout title="Ver Pronto">
    <section class="px-1 sm:py-8">
        {errorMessage && (
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm mb-6">
                {errorMessage}
            </div>
        )}

        {clearedMessage && (
            <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl text-sm mb-6 flex items-center gap-2">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                {clearedMessage === 'series' ? 'Series borradas' : clearedMessage === 'peliculas' ? 'Películas borradas' : clearedMessage === 'todos' ? 'Todo borrado' : 'Elemento eliminado'}
            </div>
        )}

        <header class="mb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Ver Pronto</h1>
            <p class="text-gray-500 text-base">Contenido que quieres ver próximamente</p>
        </header>

        <div class="mb-4">
            <PersonalNav currentPage="/personal/verpronto" />
        </div>

        <!-- Botones de borrado masivo -->
        {hasContent && (
            <div class="flex flex-wrap gap-2 mb-6">
                {hasSeries && hasMovies && showAll && (
                    <form method="POST">
                        <button type="submit" name="clear" value="todos"
                            class="px-3 py-2 text-xs font-medium text-red-600 bg-red-50 border border-red-200 rounded-lg hover:bg-red-100 transition-all">
                            Borrar todo
                        </button>
                    </form>
                )}
                {hasSeries && (showSeries || showAll) && (
                    <form method="POST">
                        <button type="submit" name="clear" value="series"
                            class="px-3 py-2 text-xs font-medium text-blue-600 bg-blue-50 border border-blue-200 rounded-lg hover:bg-blue-100 transition-all">
                            Borrar series
                        </button>
                    </form>
                )}
                {hasMovies && (showMovies || showAll) && (
                    <form method="POST">
                        <button type="submit" name="clear" value="peliculas"
                            class="px-3 py-2 text-xs font-medium text-red-600 bg-red-50 border border-red-200 rounded-lg hover:bg-red-100 transition-all">
                            Borrar películas
                        </button>
                    </form>
                )}
            </div>
        )}

        <div class="space-y-10">
            {/* Series */}
            {(showSeries || showAll) && (
                <section id="series-section" class="scroll-mt-20">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                        <span class="w-1 h-6 bg-blue-500 rounded-full"></span>
                        Series
                        <span class="text-sm font-normal text-gray-4000">({seriesVerPronto.length})</span>
                    </h2>

                    {seriesVerPronto.length === 0 && (
                        <div class="text-center py-10 text-gray-4000">
                            <p>No tienes series para ver pronto</p>
                            <a href="/catalogo/tendencias" class="inline-block mt-4 px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors text-sm font-medium">Explorar tendencias</a>
                        </div>
                    )}
                    {seriesVerPronto.length > 0 && (
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                            {seriesVerPronto.map((item) => (
                                <div class="flex flex-col h-full">
                                    <CardSerie
                                        id={item.id.toString()}
                                        img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                        name={item.name}
                                        vote_average={item.vote_average}
                                        overview={item.overview}
                                        first_air_date={item.first_air_date}
                                        seasons={item.seasons}
                                        last_episode_to_air={item.last_episode_to_air}
                                        next_episode_to_air={item.next_episode_to_air}
                                        genres={item.genre_ids?.map((gId: number) => ({ id: gId, name: getGenreName(gId) }))}
                                        status={item.status}
                                        watchedEpisodes={watchedMap[String(item.id)]?.watched}
                                    />
                                    <form method="POST" class="mt-1.5">
                                        <input type="hidden" name="deleteId" value={item.id}/>
                                        <input type="hidden" name="deleteType" value="serie"/>
                                        <button type="submit"
                                            class="w-full py-1.5 text-xs font-medium text-red-500 hover:text-white hover:bg-red-500 border border-red-200 rounded-lg transition-all"
                                            aria-label="Eliminar serie">
                                            Eliminar
                                        </button>
                                    </form>
                                </div>
                            ))}
                        </div>
                    )}
                </section>
            )}

            {/* Películas */}
            {(showMovies || showAll) && (
                <section id="movies-section" class="scroll-mt-20">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                        <span class="w-1 h-6 bg-red-500 rounded-full"></span>
                        Películas
                        <span class="text-sm font-normal text-gray-4000">({peliculasVerPronto.length})</span>
                    </h2>

                    {peliculasVerPronto.length === 0 && (
                        <div class="text-center py-10 text-gray-4000">
                            <p>No tienes películas para ver pronto</p>
                            <a href="/catalogo/tendencias" class="inline-block mt-4 px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors text-sm font-medium">Explorar tendencias</a>
                        </div>
                    )}
                    {peliculasVerPronto.length > 0 && (
                        <div class="grid gap-6 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 w-full">
                            {peliculasVerPronto.map((item) => (
                                <div class="flex flex-col h-full">
                                    <CardMovie
                                        id={item.id.toString()}
                                        img={posterUrl(item.poster_path) || "/placeholder.jpg"}
                                        title={item.title}
                                        vote_average={item.vote_average}
                                        overview={item.overview}
                                        release_date={item.release_date}
                                        genres={item.genre_ids?.map((gId: number) => ({ id: gId, name: getGenreName(gId) }))}
                                    />
                                    <form method="POST" class="mt-1.5">
                                        <input type="hidden" name="deleteId" value={item.id}/>
                                        <input type="hidden" name="deleteType" value="pelicula"/>
                                        <button type="submit"
                                            class="w-full py-1.5 text-xs font-medium text-red-500 hover:text-white hover:bg-red-500 border border-red-200 rounded-lg transition-all"
                                            aria-label="Eliminar película">
                                            Eliminar
                                        </button>
                                    </form>
                                </div>
                            ))}
                        </div>
                    )}
                </section>
            )}
        </div>
    </section>
</Layout>
