                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Géneros y Décadas más populares -->
                    <div class="popularity-stats grid lg:grid-cols-2 gap-8">

                        <!-- Top Géneros -->
                        <div class="top-genres bg-white rounded-2xl shadow-lg p-6 border border-green-100">
