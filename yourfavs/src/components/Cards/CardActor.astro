---
import '../../styles/components/cards.css';
import {getPopularityColor} from "../../utils/constants/helpers/card-helpers";
import {calculateAge} from "../../utils/constants/helpers/actor-helpers";

interface Props {
    id: string;
    nombre: string;
    imagen: string;
    popularidad: number;
    lugarNacimiento?: string;
    fechaNacimiento?: string;
}

const { id, nombre, imagen, popularidad, lugarNacimiento, fechaNacimiento } = Astro.props;

const placeholderImg = "/placeholder-actor.jpg";
const isPopular = popularidad >= 15;
const age = calculateAge(fechaNacimiento);
---
<div class="media-card group">
    <a href={`/actor/${id}`}
       class="flex flex-col rounded-xl overflow-hidden bg-midnight-blue hover:bg-dark-blue transition-all duration-300 h-full border border-white/5 hover:border-white/15 relative">

        <!-- Badge -->
        {isPopular && (
            <div class="absolute top-2 left-2 z-10">
                <span class="top-badge bg-red-500 text-white">POPULAR</span>
            </div>
        )}

        <!-- Photo -->
        <div class="relative overflow-hidden">
            <img class="w-full aspect-[2/3] object-cover transition-transform duration-500 group-hover:scale-105"
                 src={imagen || placeholderImg}
                 alt={`Foto de ${nombre}`}
                 loading="lazy"
                 onerror={`this.onerror=null; this.src='${placeholderImg}'`}/>

            <!-- Rating badge (actor: icono persona) -->
            <div class={`rating-badge ${getPopularityColor(popularidad)}`}>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                {popularidad ? popularidad.toFixed(1) : "N/A"}
            </div>

            <div class="absolute bottom-0 inset-x-0 h-16 bg-gradient-to-t from-[#0F172A] to-transparent"></div>
        </div>

        <!-- Content -->
        <div class="p-3.5 flex flex-col flex-grow">
            <h2 class="text-sm sm:text-base font-semibold text-white leading-snug mb-1.5 line-clamp-2">{nombre || "Actor desconocido"}</h2>

            <!-- Metadata -->
            <div class="space-y-1 mb-2">
                {fechaNacimiento && (
                    <div class="info-pill">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        {new Date(fechaNacimiento).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
                        {age && <span class="text-slate-400">({age} años)</span>}
                    </div>
                )}
                {lugarNacimiento && (
                    <div class="info-pill">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        <span class="line-clamp-1">{lugarNacimiento}</span>
                    </div>
                )}
            </div>

            <div class="mt-auto pt-1">
                <span class="view-details-btn">
                    Ver detalles
                    <svg class="w-3.5 h-3.5 ml-1 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                    </svg>
                </span>
            </div>
        </div>
    </a>
</div>
