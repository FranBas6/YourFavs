---
/**
 * «Amigos que la han visto» en la ficha (F5 de la capa social, docs/PLAN_SOCIAL.md).
 *
 * Va en la columna derecha, entre «Dónde ver» y tu nota. Hasta 6 amigos que la vieron (o la están
 * viendo) con su nota, y una línea con cuántos más y cuántos la tienen pendiente. Solo AMIGOS: a
 * quien solo sigues no sale aquí. Sin sesión, sin amigos o sin datos no pinta nada.
 */
import { friendsSeen } from '../../services/BD/social/inCommon';
import { avatarHtml } from '../../lib/social/ui';
import { formatScore } from '../../utils/constants/helpers/media-helpers';
import { safeFetch } from '../../utils/safeFetch';
import { SOCIAL_PHASE } from '../../utils/constants/social';
import '../../styles/components/friends-seen.css';

interface Props {
    mediaType: 'movie' | 'tv';
    tmdbId: number | string | undefined;
    /** Etiqueta pequeña junto al título (la ficha de episodio pone «de la serie»: no es por episodio). */
    note?: string;
}
const { mediaType, tmdbId, note } = Astro.props;
const me = Astro.locals.user?.uid;
const id = Number(tmdbId);
const view = SOCIAL_PHASE.friends && me && Number.isInteger(id)
    ? await safeFetch(friendsSeen(me, mediaType, id), `friendsSeen/${mediaType}/${id}`, null)
    : null;

const MAX = 6;
const shown = view?.seen.slice(0, MAX) ?? [];
const rest = (view?.seen.length ?? 0) - shown.length;
const pending = view?.pending ?? 0;
const firstName = (name: string) => name.split(/\s+/)[0] || name;
const footer = [
    rest > 0 ? `y ${rest} más` : '',
    pending > 0 ? (pending === 1 ? '1 amigo la tiene pendiente' : `${pending} amigos la tienen pendiente`) : '',
].filter(Boolean).join(' · ');
---
{view && (shown.length > 0 || pending > 0) && (
    <section class="bg-white rounded-xl border border-gray-200 p-4 fsn" aria-labelledby="fsn-t">
        <h3 id="fsn-t" class="text-base font-semibold text-gray-800 mb-3">
            {shown.length ? 'Amigos que la han visto' : 'Tus amigos'}
            {note && <small class="fsn-note">{note}</small>}
        </h3>
        {shown.length > 0 && (
            <ul class="fsn-list">
                {shown.map((f) => {
                    const name = firstName(f.person.name);
                    const label = f.state === 'watching'
                        ? `${f.person.name}: la está viendo`
                        : f.score != null ? `Nota de ${f.person.name}: ${formatScore(f.score)}` : `${f.person.name}: la ha visto`;
                    const Tag = f.person.handle ? 'a' : 'div';
                    return (
                        <li>
                            <Tag class="fsn-p" href={f.person.handle ? `/u/${f.person.handle}` : undefined} title={label} aria-label={label}>
                                <Fragment set:html={avatarHtml(f.person, 40)} />
                                <span class="fsn-n">{name}</span>
                                {f.state === 'watching'
                                    ? <span class="fsn-s is-w">Viéndola</span>
                                    : f.score != null
                                        ? <span class="fsn-s"><svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{formatScore(f.score)}</span>
                                        : <span class="fsn-s is-n">Vista</span>}
                            </Tag>
                        </li>
                    );
                })}
            </ul>
        )}
        {footer && <p class:list={['fsn-f', { 'is-solo': !shown.length }]}>{shown.length ? footer : `${footer.charAt(0).toUpperCase()}${footer.slice(1)}.`}</p>}
    </section>
)}
