---
import Layout from "../layouts/Layout.astro";
import { getUserProfile, setUserProfile, type UserProfile } from "../services/BD/profile/userProfile";
import { getUserTaste, clearUserTaste } from "../services/BD/profile/userTaste";
import { SUPPORTED_COUNTRIES } from "../services/API/shared/tmdbInfoService";
import { STREAMING_PLATFORMS, STREAMING_PLATFORM_IDS } from "../utils/constants/streamingPlatforms";
import { genresMap } from "../utils/constants/genres";
import { posterUrl } from "../services/API/shared/tmdbClient";

// Protegida por el middleware (/mislistas/* sin sesión → redirige). Aquí ya hay user.
const user = Astro.locals.user!;

// Idiomas de contenido soportados (subconjunto razonable de TMDB).
const LANGUAGES = [
    { code: 'es-ES', label: 'Español' },
    { code: 'en-US', label: 'English' },
    { code: 'fr-FR', label: 'Français' },
    { code: 'de-DE', label: 'Deutsch' },
    { code: 'it-IT', label: 'Italiano' },
    { code: 'pt-BR', label: 'Português (BR)' },
    { code: 'ja-JP', label: '日本語' },
];

// POST: guardar preferencias
if (Astro.request.method === 'POST') {
    const fd = await Astro.request.formData();
    const postAction = String(fd.get('action'));
    if (postAction === 'save_avatar') {
        const avatarUrl = String(fd.get('avatar_url') || '').trim();
        await setUserProfile({ avatar_url: avatarUrl || null });
        return Astro.redirect('/perfil?saved=1');
    }
    if (postAction === 'save_profile') {
        const patch: Partial<UserProfile> = {
            display_name: String(fd.get('display_name') || '').trim().slice(0, 60) || undefined,
            region: String(fd.get('region') || '') || undefined,
            language: String(fd.get('language') || '') || undefined,
            theme: (String(fd.get('theme') || '') as UserProfile['theme']) || undefined,
        };
        // "Mis plataformas" (3.2): multi-checkbox; [] válido (= ninguna) → siempre se escribe.
        patch.platforms = fd.getAll('platforms').map((v) => Number(v)).filter((n) => STREAMING_PLATFORM_IDS.has(n));
        await setUserProfile(patch);
        return Astro.redirect('/perfil?saved=1');
    }
    if (postAction === 'reset_taste') {
        await clearUserTaste();
        // Los gustos alimentan el motor → invalidar cachés (de este uid).
        try {
            const [{ invalidateGenrePreferencesCache }, { invalidatePersonalRecsCache }] = await Promise.all([
                import('../utils/genrePreferences'),
                import('../utils/personalRecommendations'),
            ]);
            invalidateGenrePreferencesCache();
            invalidatePersonalRecsCache();
        } catch { /* la caché caduca sola igualmente */ }
        return Astro.redirect('/perfil?saved=1');
    }
}

const profile = (await getUserProfile()) ?? {};
const saved = Astro.url.searchParams.get('saved') === '1';

// Gustos (Fase F · Acceso B): resumen para la sección "Tus gustos".
const taste = await getUserTaste();
// Géneros por nombre (F.7: movieGenres; retrocompat con `genres` pre-F.7).
const tasteGenres = ((taste?.movieGenres ?? taste?.genres) ?? []).map((id) => genresMap[id]).filter(Boolean);
const tasteTitles = taste?.titles ?? [];
const tasteMovies = tasteTitles.filter((t) => t.media_type === 'movie');
const tasteSeries = tasteTitles.filter((t) => t.media_type === 'tv');
const tastePeople = taste?.people ?? [];
const hasTaste = tasteGenres.length > 0 || tasteTitles.length > 0 || tastePeople.length > 0;

const displayName = profile.display_name || user.name || (user.email ? user.email.split('@')[0] : 'Tú');
const region = profile.region || 'ES';
const language = profile.language || 'es-ES';
const theme = profile.theme || 'system';
const selectedPlatforms = profile.platforms ?? [];

// Iniciales para el fallback del avatar
const initials = (() => {
    const base = (profile.display_name || user.name || user.email || '?').trim();
    const parts = base.split(/\s+/);
    if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
    return base.slice(0, 2).toUpperCase();
})();

const icsUrl = `${Astro.url.origin}/api/calendar/subscribe.ics`;
---
<Layout title="Tu perfil — YourFavs">
    <div class="perfil-wrap">
        <h1 class="perfil-title">Tu perfil</h1>

        {saved && <div class="perfil-saved">✓ Cambios guardados</div>}

        <form method="POST" class="perfil-card">
            <input type="hidden" name="action" value="save_profile" />

            <!-- Identidad -->
            <section class="perfil-section">
                <h2 class="perfil-h2">Identidad</h2>
                <div class="perfil-identity">
                    <div class="perfil-avatar">
                        {user.picture
                            ? <img src={user.picture} alt="" referrerpolicy="no-referrer" />
                            : <span>{initials}</span>}
                    </div>
                    <div class="perfil-identity-fields">
                        <label class="perfil-field">
                            <span>Nombre visible</span>
                            <input type="text" name="display_name" value={displayName} maxlength="60" placeholder="Tu nombre" />
                        </label>
                        <label class="perfil-field">
                            <span>Email</span>
                            <input type="email" value={user.email ?? ''} disabled />
                            <small>El email no se puede cambiar.</small>
                        </label>
                        <button type="button" class="perfil-avatar-btn" id="avatar-open">
                            Cambiar avatar
                        </button>
                    </div>
                </div>
            </section>

            <!-- Preferencias -->
            <section class="perfil-section">
                <h2 class="perfil-h2">Preferencias</h2>
                <div class="perfil-grid">
                    <label class="perfil-field">
                        <span>Región de streaming</span>
                        <select name="region">
                            {SUPPORTED_COUNTRIES.map((c) => (
                                <option value={c.code} selected={c.code === region}>{c.label}</option>
                            ))}
                        </select>
                        <small>Plataformas que se muestran por defecto.</small>
                    </label>
                    <label class="perfil-field">
                        <span>Idioma de contenido</span>
                        <select name="language">
                            {LANGUAGES.map((l) => (
                                <option value={l.code} selected={l.code === language}>{l.label}</option>
                            ))}
                        </select>
                        <small>Sinopsis y títulos de TMDB.</small>
                    </label>
                    <label class="perfil-field">
                        <span>Tema</span>
                        <select name="theme" id="perfil-theme">
                            <option value="system" selected={theme === 'system'}>Según el sistema</option>
                            <option value="light" selected={theme === 'light'}>Claro</option>
                            <option value="dark" selected={theme === 'dark'}>Oscuro</option>
                        </select>
                    </label>
                    <div class="perfil-field perfil-field-wide">
                        <span>Mis plataformas</span>
                        <div class="plat-chips">
                            {STREAMING_PLATFORMS.map((p) => (
                                <label class="plat-chip">
                                    <input type="checkbox" name="platforms" value={p.id} checked={selectedPlatforms.includes(p.id)} />
                                    <span>{p.label}</span>
                                </label>
                            ))}
                        </div>
                        <small>Para el filtro «Solo en mis plataformas» del catálogo y la ruleta.</small>
                    </div>
                </div>
            </section>

            <div class="perfil-actions">
                <button type="submit" class="perfil-save">Guardar cambios</button>
            </div>
        </form>

        <!-- Tus gustos (Fase F · Acceso B) -->
        <section class="perfil-card">
            <div class="perfil-taste-head">
                <div>
                    <h2 class="perfil-h2">Tus gustos</h2>
                    <p class="perfil-muted">Lo que usamos para personalizar tus recomendaciones «Para ti».</p>
                </div>
                <a href="/gustos" class="perfil-avatar-btn">{hasTaste ? 'Editar' : 'Configurar'}</a>
            </div>

            {hasTaste ? (
                <div class="perfil-taste-grid">
                    {tasteGenres.length > 0 && (
                        <div class="perfil-taste-cell">
                            <div class="perfil-taste-cell-h">Géneros <span>{tasteGenres.length}</span></div>
                            <div class="perfil-taste-chips">
                                {tasteGenres.map((g) => <span class="perfil-taste-chip">{g}</span>)}
                            </div>
                        </div>
                    )}
                    {tasteMovies.length > 0 && (
                        <div class="perfil-taste-cell">
                            <div class="perfil-taste-cell-h">Películas <span>{tasteMovies.length}</span></div>
                            <div class="perfil-taste-posters">
                                {tasteMovies.map((t) => (
                                    t.poster_path
                                        ? <img src={posterUrl(t.poster_path, 'w92')} alt={t.title} title={t.title} loading="lazy" />
                                        : <span class="perfil-taste-noimg" title={t.title}>{t.title.slice(0, 2)}</span>
                                ))}
                            </div>
                        </div>
                    )}
                    {tasteSeries.length > 0 && (
                        <div class="perfil-taste-cell">
                            <div class="perfil-taste-cell-h">Series <span>{tasteSeries.length}</span></div>
                            <div class="perfil-taste-posters">
                                {tasteSeries.map((t) => (
                                    t.poster_path
                                        ? <img src={posterUrl(t.poster_path, 'w92')} alt={t.title} title={t.title} loading="lazy" />
                                        : <span class="perfil-taste-noimg" title={t.title}>{t.title.slice(0, 2)}</span>
                                ))}
                            </div>
                        </div>
                    )}
                    {tastePeople.length > 0 && (
                        <div class="perfil-taste-cell">
                            <div class="perfil-taste-cell-h">Actores <span>{tastePeople.length}</span></div>
                            <div class="perfil-taste-people">
                                {tastePeople.map((p) => (
                                    p.profile_path
                                        ? <img src={posterUrl(p.profile_path, 'w92')} alt={p.name} title={p.name} loading="lazy" />
                                        : <span class="perfil-taste-noimg round" title={p.name}>{p.name.slice(0, 1)}</span>
                                ))}
                            </div>
                        </div>
                    )}
                    <div class="perfil-taste-foot">
                        <span>«Editar» reabre el mismo flujo, ya prerrellenado.</span>
                        <button type="button" class="perfil-taste-reset" id="taste-reset">Reiniciar gustos</button>
                    </div>
                </div>
            ) : (
                <p class="perfil-muted">Aún no nos has contado tus gustos. <a href="/gustos" class="perfil-taste-link">Cuéntanoslos →</a> y «Para ti» arrancará personalizado.</p>
            )}
        </section>
        <form method="POST" id="taste-reset-form" hidden>
            <input type="hidden" name="action" value="reset_taste" />
        </form>
        <script>
            document.getElementById('taste-reset')?.addEventListener('click', () => {
                if (confirm('¿Reiniciar tus gustos? Se borrarán los géneros, títulos y actores elegidos. Podrás volver a configurarlos.')) {
                    (document.getElementById('taste-reset-form') as HTMLFormElement)?.submit();
                }
            });
        </script>

        <!-- Calendario ICS -->
        <section class="perfil-card">
            <h2 class="perfil-h2">Suscripción al calendario</h2>
            <p class="perfil-muted">Copia este enlace en tu app de calendario (Google, Apple, Outlook) para ver tus estrenos.</p>
            <div class="perfil-ics">
                <input type="text" id="ics-url" value={icsUrl} readonly />
                <button type="button" id="ics-copy" class="perfil-ics-btn">Copiar</button>
            </div>
        </section>

        <!-- Cuenta -->
        <section class="perfil-card">
            <h2 class="perfil-h2">Cuenta</h2>
            <p class="perfil-muted">Tus listas se conservan al cerrar sesión.</p>
            <div class="perfil-account-actions">
                <button type="button" class="perfil-logout" data-auth-logout>Cerrar sesión</button>
                <button type="button" class="perfil-delete" id="account-delete">Eliminar cuenta</button>
            </div>
        </section>
    </div>

    <!-- Modal de avatar (E.3 + subida desde dispositivo) -->
    <div class="av-overlay" id="avatar-modal" role="dialog" aria-modal="true" aria-label="Elegir avatar" hidden>
        <div class="av-card">
            <div class="av-head">
                <h3>Elige tu avatar</h3>
                <button type="button" class="av-close" id="avatar-close" aria-label="Cerrar">✕</button>
            </div>

            <div class="av-tabs" role="tablist">
                <button type="button" class="av-tab is-active" data-av-tab="gallery" role="tab" aria-selected="true">De tus pelis y series</button>
                <button type="button" class="av-tab" data-av-tab="upload" role="tab" aria-selected="false">Subir foto</button>
            </div>

            <!-- Pestaña: galería TMDB (actores + pósters) -->
            <div class="av-panel" data-av-panel="gallery">
                <div class="av-grid" id="avatar-grid"><p class="av-state">Cargando…</p></div>
            </div>

            <!-- Pestaña: subir foto propia -->
            <div class="av-panel" data-av-panel="upload" hidden>
                <div id="av-upload-start">
                    <label class="av-drop">
                        <input type="file" id="av-file" accept="image/*" hidden />
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        <span>Toca para elegir una foto</span>
                        <small>Cámara o galería · se recorta en cuadrado</small>
                    </label>
                </div>
                <div id="av-upload-edit" hidden>
                    <div class="av-crop" id="av-crop">
                        <canvas id="av-canvas" width="240" height="240"></canvas>
                    </div>
                    <label class="av-zoom">
                        <span>Zoom</span>
                        <input type="range" id="av-zoom" min="1" max="3" step="0.01" value="1" />
                    </label>
                    <p class="av-msg" id="av-upload-msg" hidden></p>
                    <div class="av-upload-actions">
                        <button type="button" class="av-remove" id="av-cancel">Cambiar foto</button>
                        <button type="button" class="av-save" id="av-upload-save">Guardar foto</button>
                    </div>
                </div>
            </div>

            <div class="av-foot">
                <button type="button" class="av-remove" id="avatar-remove">Quitar foto</button>
            </div>
        </div>
    </div>
    <form method="POST" id="avatar-form" hidden>
        <input type="hidden" name="action" value="save_avatar" />
        <input type="hidden" name="avatar_url" id="avatar-url-input" />
    </form>
</Layout>

<style>
    .perfil-wrap { max-width: 720px; margin: 0 auto; }
    .perfil-title { font-size: 26px; font-weight: 800; color: var(--text); margin: 0 0 18px; }
    .perfil-saved {
        background: rgba(16, 185, 129, .14); color: #10b981;
        padding: 10px 14px; border-radius: 10px; font-size: 14px; font-weight: 600; margin-bottom: 16px;
    }
    .perfil-card {
        background: var(--bg-elev); border: 1px solid var(--border);
        border-radius: 14px; padding: 22px; margin-bottom: 18px;
    }
    .perfil-section + .perfil-section { margin-top: 22px; padding-top: 22px; border-top: 1px solid var(--border); }
    .perfil-h2 { font-size: 15px; font-weight: 700; color: var(--text); margin: 0 0 14px; }
    .perfil-muted { font-size: 13px; color: var(--text-3); margin: 0 0 12px; }

    .perfil-identity { display: flex; gap: 18px; align-items: flex-start; flex-wrap: wrap; }
    .perfil-avatar {
        width: 76px; height: 76px; border-radius: 999px; flex-shrink: 0;
        background: #3b82f6; color: #fff; display: flex; align-items: center; justify-content: center;
        font-size: 26px; font-weight: 700; overflow: hidden;
    }
    .perfil-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .perfil-identity-fields { flex: 1; min-width: 240px; display: flex; flex-direction: column; gap: 12px; }

    .perfil-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    @media (max-width: 560px) { .perfil-grid { grid-template-columns: 1fr; } }

    .perfil-field { display: flex; flex-direction: column; gap: 5px; }
    .perfil-field > span { font-size: 12px; font-weight: 600; color: var(--text-2); }
    .perfil-field small { font-size: 11.5px; color: var(--text-4); }
    .perfil-field input, .perfil-field select {
        width: 100%; padding: 10px 12px; border-radius: 9px;
        border: 1px solid var(--border); background: var(--bg); color: var(--text);
        font-size: 14px; font-family: inherit;
    }
    .perfil-field input:focus, .perfil-field select:focus {
        outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft);
    }
    .perfil-field input:disabled { opacity: .6; cursor: not-allowed; }

    /* "Mis plataformas" (3.2): chips toggle a ancho completo del grid */
    .perfil-field-wide { grid-column: 1 / -1; }
    .plat-chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .plat-chip { position: relative; }
    .plat-chip input { position: absolute; opacity: 0; width: 0; height: 0; margin: 0; padding: 0; }
    .plat-chip span {
        display: inline-flex; align-items: center; padding: 7px 13px; border-radius: 999px;
        border: 1px solid var(--border); background: var(--bg-tint); color: var(--text-2);
        font-size: 13px; font-weight: 600; cursor: pointer; user-select: none; transition: all .15s ease;
    }
    .plat-chip:hover span { border-color: var(--border-strong); color: var(--text); }
    .plat-chip input:checked + span { background: var(--accent); color: #fff; border-color: var(--accent); }
    .plat-chip input:focus-visible + span { box-shadow: 0 0 0 3px var(--accent-soft); }

    .perfil-avatar-btn {
        align-self: flex-start; padding: 7px 13px; border-radius: 8px;
        border: 1px solid var(--border); background: var(--bg-tint); color: var(--text-2);
        font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit;
    }
    .perfil-avatar-btn:hover { border-color: var(--border-strong); color: var(--text); }

    /* Tus gustos (Fase F) */
    .perfil-taste-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
    .perfil-taste-head .perfil-h2 { margin-bottom: 4px; }
    .perfil-taste-head .perfil-muted { margin: 0; }
    .perfil-taste-head .perfil-avatar-btn { align-self: center; text-decoration: none; white-space: nowrap; }
    .perfil-taste-grid { display: flex; flex-direction: column; gap: 16px; }
    .perfil-taste-cell-h { font-size: 12px; font-weight: 700; color: var(--text-2); margin-bottom: 9px; display: flex; align-items: center; gap: 7px; }
    .perfil-taste-cell-h span { font-family: var(--font-mono); font-size: 11px; font-weight: 500; color: var(--accent); }
    .perfil-taste-chips { display: flex; flex-wrap: wrap; gap: 7px; }
    .perfil-taste-chip { padding: 5px 11px; border-radius: var(--r-full); background: var(--bg-tint); border: 1px solid var(--border); font-size: 12.5px; color: var(--text-2); }
    .perfil-taste-posters, .perfil-taste-people { display: flex; flex-wrap: wrap; gap: 8px; }
    .perfil-taste-posters img { width: 46px; height: 69px; object-fit: cover; border-radius: var(--r-sm); border: 1px solid var(--border); display: block; }
    .perfil-taste-people img { width: 48px; height: 48px; object-fit: cover; border-radius: var(--r-full); border: 1px solid var(--border); display: block; }
    .perfil-taste-noimg {
        width: 46px; height: 69px; display: inline-flex; align-items: center; justify-content: center;
        background: var(--bg-tint); border: 1px solid var(--border); border-radius: var(--r-sm);
        font-size: 13px; font-weight: 700; color: var(--text-3);
    }
    .perfil-taste-noimg.round { width: 48px; height: 48px; border-radius: var(--r-full); }
    .perfil-taste-foot {
        display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
        padding-top: 14px; border-top: 1px solid var(--border); font-size: 12.5px; color: var(--text-3);
    }
    .perfil-taste-reset {
        background: none; border: 1px solid var(--border); color: var(--text-3);
        padding: 7px 12px; border-radius: 8px; font-size: 12.5px; font-weight: 600; cursor: pointer; font-family: inherit;
    }
    .perfil-taste-reset:hover { color: #ef4444; border-color: rgba(239, 68, 68, .3); }
    .perfil-taste-link { color: var(--accent); font-weight: 600; text-decoration: none; }
    .perfil-taste-link:hover { text-decoration: underline; }

    /* Modal de avatar */
    .av-overlay {
        position: fixed; inset: 0; z-index: 10002;
        background: rgba(15, 23, 42, .55); backdrop-filter: blur(3px);
        display: none; align-items: flex-start; justify-content: center; padding: 8vh 16px 16px;
    }
    .av-overlay.is-open { display: flex; }
    .av-card {
        width: 460px; max-width: 100%; background: var(--bg-elev);
        border: 1px solid var(--border); border-radius: 14px; padding: 20px;
        box-shadow: 0 30px 80px rgba(0,0,0,.5); max-height: 80vh; overflow-y: auto;
    }
    .av-head { display: flex; align-items: center; justify-content: space-between; }
    .av-head h3 { margin: 0; font-size: 17px; font-weight: 700; color: var(--text); }
    .av-close {
        width: 30px; height: 30px; border-radius: 999px; border: 1px solid var(--border);
        background: var(--bg-tint); color: var(--text-3); cursor: pointer; font-size: 14px;
    }
    .av-sub { margin: 4px 0 14px; font-size: 13px; color: var(--text-3); }

    /* Pestañas */
    .av-tabs { display: flex; gap: 6px; margin: 14px 0 16px; border-bottom: 1px solid var(--border); }
    .av-tab {
        flex: 1; padding: 9px 8px; border: none; background: none; cursor: pointer; font-family: inherit;
        font-size: 13px; font-weight: 600; color: var(--text-3); border-bottom: 2px solid transparent; margin-bottom: -1px;
    }
    .av-tab:hover { color: var(--text-2); }
    .av-tab.is-active { color: var(--accent); border-bottom-color: var(--accent); }

    .av-grid { display: flex; flex-direction: column; gap: 4px; }
    .av-group { margin: 8px 0 2px; font-size: 11.5px; font-weight: 600; color: var(--text-3); text-transform: uppercase; letter-spacing: .03em; }
    .av-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(72px, 1fr)); gap: 10px; }
    .av-state { text-align: center; color: var(--text-3); font-size: 13px; padding: 20px 0; }
    .av-pick {
        padding: 0; border: 2px solid transparent; border-radius: 999px; cursor: pointer;
        background: var(--bg-tint); aspect-ratio: 1; overflow: hidden;
    }
    .av-pick:hover { border-color: var(--accent); }
    .av-pick img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .av-foot { margin-top: 16px; display: flex; justify-content: flex-end; border-top: 1px solid var(--border); padding-top: 14px; }
    .av-remove {
        padding: 8px 14px; border-radius: 8px; border: 1px solid var(--border);
        background: none; color: var(--text-3); font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit;
    }
    .av-remove:hover { color: #ef4444; border-color: rgba(239,68,68,.3); }

    /* Pestaña subir foto */
    .av-drop {
        display: flex; flex-direction: column; align-items: center; gap: 6px;
        padding: 30px 16px; border: 1.5px dashed var(--border-strong, var(--border)); border-radius: 12px;
        color: var(--text-3); cursor: pointer; text-align: center;
    }
    .av-drop:hover { border-color: var(--accent); color: var(--text-2); }
    .av-drop span { font-size: 14px; font-weight: 600; color: var(--text-2); }
    .av-drop small { font-size: 12px; color: var(--text-4); }
    .av-crop {
        width: 240px; max-width: 100%; height: 240px; margin: 4px auto 0; border-radius: 999px; overflow: hidden;
        background: var(--bg-tint); touch-action: none; cursor: grab; border: 1px solid var(--border);
    }
    .av-crop:active { cursor: grabbing; }
    .av-crop canvas { display: block; width: 100%; height: 100%; }
    .av-zoom { display: flex; align-items: center; gap: 10px; margin: 14px 0 6px; font-size: 12px; font-weight: 600; color: var(--text-2); }
    .av-zoom input[type="range"] { flex: 1; accent-color: var(--accent); }
    .av-upload-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px; }
    .av-save {
        padding: 9px 16px; border-radius: 8px; border: none; background: var(--accent); color: #fff;
        font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit;
    }
    .av-save:hover { background: var(--accent-dark, var(--accent)); }
    .av-save:disabled { opacity: .6; cursor: progress; }
    .av-msg { margin: 8px 0 0; font-size: 12.5px; padding: 8px 11px; border-radius: 8px; background: rgba(239,68,68,.12); color: #ef4444; }

    .perfil-actions { margin-top: 20px; display: flex; justify-content: flex-end; }
    .perfil-save {
        padding: 11px 22px; border-radius: var(--r-full, 999px); border: none;
        background: var(--accent); color: #fff; font-size: 14px; font-weight: 600; cursor: pointer; font-family: inherit;
    }
    .perfil-save:hover { background: var(--accent-dark, var(--accent)); }

    .perfil-ics { display: flex; gap: 8px; }
    .perfil-ics input {
        flex: 1; padding: 10px 12px; border-radius: 9px; border: 1px solid var(--border);
        background: var(--bg); color: var(--text-3); font-size: 13px; font-family: var(--font-mono, monospace);
    }
    .perfil-ics-btn, .perfil-logout, .perfil-delete {
        padding: 10px 16px; border-radius: 9px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit;
        border: 1px solid var(--border); background: var(--bg-tint); color: var(--text-2); white-space: nowrap;
    }
    .perfil-ics-btn:hover { border-color: var(--border-strong); color: var(--text); }
    .perfil-account-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .perfil-delete { color: #ef4444; border-color: rgba(239,68,68,.3); cursor: pointer; }
    .perfil-delete:hover { background: rgba(239,68,68,.1); }
    .perfil-delete:disabled { opacity: .55; cursor: progress; }
</style>

<!-- La galería de avatares la inyecta el JS (#avatar-grid) → estos estilos van
     GLOBALES porque el CSS scoped de Astro no alcanza al HTML inyectado. -->
<style is:global>
    #avatar-grid .av-group { margin: 8px 0 2px; font-size: 11.5px; font-weight: 600; color: var(--text-3); text-transform: uppercase; letter-spacing: .03em; }
    #avatar-grid .av-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(60px, 1fr)); gap: 10px; }
    #avatar-grid .av-state { text-align: center; color: var(--text-3); font-size: 13px; padding: 20px 0; }
    #avatar-grid .av-pick { padding: 0; border: 2px solid transparent; border-radius: 999px; cursor: pointer; background: var(--bg-tint); aspect-ratio: 1; overflow: hidden; }
    #avatar-grid .av-pick:hover { border-color: var(--accent); }
    #avatar-grid .av-pick img { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>

<script>
    // Tema: aplica al instante (data-theme + localStorage) al cambiar el select,
    // además de guardarse en el perfil al enviar el form (sync entre dispositivos).
    const themeSel = document.getElementById('perfil-theme') as HTMLSelectElement | null;
    themeSel?.addEventListener('change', () => {
        const v = themeSel.value;
        const effective = v === 'system' ? 'light' : v; // 'system' → claro por defecto (igual que el Layout)
        document.documentElement.setAttribute('data-theme', effective);
        try { localStorage.setItem('theme', effective); } catch { /* noop */ }
    });

    // Copiar enlace ICS
    const icsBtn = document.getElementById('ics-copy');
    const icsInput = document.getElementById('ics-url') as HTMLInputElement | null;
    icsBtn?.addEventListener('click', async () => {
        if (!icsInput) return;
        try {
            await navigator.clipboard.writeText(icsInput.value);
            icsBtn.textContent = '¡Copiado!';
        } catch {
            icsInput.select();
            document.execCommand('copy');
            icsBtn.textContent = '¡Copiado!';
        }
        setTimeout(() => { icsBtn.textContent = 'Copiar'; }, 1800);
    });

    // Modal de avatar (E.3)
    const avOpen = document.getElementById('avatar-open');
    const avModal = document.getElementById('avatar-modal');
    const avClose = document.getElementById('avatar-close');
    const avGrid = document.getElementById('avatar-grid');
    const avRemove = document.getElementById('avatar-remove');
    const avForm = document.getElementById('avatar-form') as HTMLFormElement | null;
    const avInput = document.getElementById('avatar-url-input') as HTMLInputElement | null;
    let avLoaded = false;

    function avCloseModal() {
        avModal?.classList.remove('is-open');
        if (avModal) avModal.hidden = true;
        document.body.style.overflow = '';
    }
    const picBtn = (u: string) => `<button type="button" class="av-pick" data-url="${u}"><img src="${u}" alt="" loading="lazy" /></button>`;
    async function avLoad() {
        if (!avGrid) return;
        try {
            const res = await fetch('/api/profile/avatar-options');
            const data = await res.json();
            const actors: string[] = data.actors || [];
            const posters: string[] = data.posters || [];
            avLoaded = true;
            if (!actors.length && !posters.length) {
                avGrid.innerHTML = '<p class="av-state">Guarda actores, pelis o series para elegir un avatar… o sube una foto.</p>';
                return;
            }
            let html = '';
            if (actors.length) html += `<p class="av-group">Actores favoritos</p><div class="av-row">${actors.map(picBtn).join('')}</div>`;
            if (posters.length) html += `<p class="av-group">De tus listas</p><div class="av-row">${posters.map(picBtn).join('')}</div>`;
            avGrid.innerHTML = html;
        } catch {
            avGrid.innerHTML = '<p class="av-state">No se pudieron cargar las imágenes.</p>';
        }
    }
    function avPick(url: string) {
        if (!avForm || !avInput) return;
        avInput.value = url;
        avForm.submit(); // submit() nativo → POST limpio (no pasa por el interceptor)
    }
    avOpen?.addEventListener('click', () => {
        if (!avModal) return;
        avModal.hidden = false;
        avModal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        if (!avLoaded) avLoad();
    });
    avClose?.addEventListener('click', avCloseModal);
    avModal?.addEventListener('mousedown', (e) => { if (e.target === avModal) avCloseModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && avModal?.classList.contains('is-open')) avCloseModal(); });
    avGrid?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.av-pick') as HTMLElement | null;
        if (btn) avPick(btn.getAttribute('data-url') || '');
    });
    avRemove?.addEventListener('click', () => avPick('')); // '' → quita avatar (vuelve a Google/iniciales)

    // ---- Pestañas del modal de avatar ----
    const avTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.av-tab'));
    const avPanels = Array.from(document.querySelectorAll<HTMLElement>('.av-panel'));
    function avSelectTab(name: string) {
        avTabs.forEach((t) => {
            const on = t.dataset.avTab === name;
            t.classList.toggle('is-active', on);
            t.setAttribute('aria-selected', String(on));
        });
        avPanels.forEach((p) => { p.hidden = p.dataset.avPanel !== name; });
    }
    avTabs.forEach((t) => t.addEventListener('click', () => avSelectTab(t.dataset.avTab || 'gallery')));

    // ---- Subir foto: selección → recorte cuadrado (canvas) → POST ----
    const avFile = document.getElementById('av-file') as HTMLInputElement | null;
    const avStart = document.getElementById('av-upload-start');
    const avEdit = document.getElementById('av-upload-edit');
    const avCanvas = document.getElementById('av-canvas') as HTMLCanvasElement | null;
    const avZoom = document.getElementById('av-zoom') as HTMLInputElement | null;
    const avUploadSave = document.getElementById('av-upload-save') as HTMLButtonElement | null;
    const avCancel = document.getElementById('av-cancel');
    const avUploadMsg = document.getElementById('av-upload-msg');

    const V = 240; // lado del visor (px); la salida final es 256×256
    let avImg: HTMLImageElement | null = null;
    let baseScale = 1, zoom = 1, ox = 0, oy = 0; // offset del lienzo respecto al visor
    let dragging = false, lastX = 0, lastY = 0;

    function avClampOffset() {
        if (!avImg) return;
        const w = avImg.width * baseScale * zoom;
        const h = avImg.height * baseScale * zoom;
        ox = Math.min(0, Math.max(V - w, ox));
        oy = Math.min(0, Math.max(V - h, oy));
    }
    function avDraw() {
        if (!avCanvas || !avImg) return;
        const ctx = avCanvas.getContext('2d');
        if (!ctx) return;
        const w = avImg.width * baseScale * zoom;
        const h = avImg.height * baseScale * zoom;
        ctx.clearRect(0, 0, V, V);
        ctx.drawImage(avImg, ox, oy, w, h);
    }
    function avShowUploadMsg(text: string) {
        if (!avUploadMsg) return;
        avUploadMsg.textContent = text;
        avUploadMsg.hidden = false;
    }
    avFile?.addEventListener('change', () => {
        const f = avFile.files && avFile.files[0];
        if (!f) return;
        if (!f.type.startsWith('image/')) { avSelectTab('upload'); avShowUploadMsg('Elige un archivo de imagen.'); return; }
        if (avUploadMsg) avUploadMsg.hidden = true;
        const img = new Image();
        img.onload = () => {
            avImg = img;
            baseScale = Math.max(V / img.width, V / img.height); // "cover" del visor
            zoom = 1;
            if (avZoom) avZoom.value = '1';
            // Centrar
            ox = (V - img.width * baseScale) / 2;
            oy = (V - img.height * baseScale) / 2;
            avClampOffset();
            avDraw();
            if (avStart) avStart.hidden = true;
            if (avEdit) avEdit.hidden = false;
        };
        img.onerror = () => avShowUploadMsg('No se pudo leer la imagen.');
        img.src = URL.createObjectURL(f);
    });
    avZoom?.addEventListener('input', () => {
        if (!avImg) return;
        // Mantener el centro del visor al hacer zoom
        const cx = (V / 2 - ox), cy = (V / 2 - oy);
        const prev = baseScale * zoom;
        zoom = Number(avZoom.value);
        const next = baseScale * zoom;
        ox = V / 2 - cx * (next / prev);
        oy = V / 2 - cy * (next / prev);
        avClampOffset();
        avDraw();
    });
    // Arrastrar para reposicionar (ratón + táctil con Pointer Events)
    const avCrop = document.getElementById('av-crop');
    avCrop?.addEventListener('pointerdown', (e) => {
        if (!avImg) return;
        dragging = true; lastX = e.clientX; lastY = e.clientY;
        (e.target as HTMLElement).setPointerCapture?.(e.pointerId);
    });
    avCrop?.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        ox += e.clientX - lastX; oy += e.clientY - lastY;
        lastX = e.clientX; lastY = e.clientY;
        avClampOffset(); avDraw();
    });
    const stopDrag = () => { dragging = false; };
    avCrop?.addEventListener('pointerup', stopDrag);
    avCrop?.addEventListener('pointercancel', stopDrag);
    avCancel?.addEventListener('click', () => {
        if (avFile) avFile.value = '';
        avImg = null;
        if (avEdit) avEdit.hidden = true;
        if (avStart) avStart.hidden = false;
        if (avUploadMsg) avUploadMsg.hidden = true;
    });
    avUploadSave?.addEventListener('click', () => {
        if (!avImg) return;
        // Render a 256×256 con el mismo encuadre del visor.
        const O = 256, k = O / V;
        const out = document.createElement('canvas');
        out.width = O; out.height = O;
        const octx = out.getContext('2d');
        if (!octx) return;
        const w = avImg.width * baseScale * zoom * k;
        const h = avImg.height * baseScale * zoom * k;
        octx.drawImage(avImg, ox * k, oy * k, w, h);
        out.toBlob(async (blob) => {
            if (!blob) { avShowUploadMsg('No se pudo procesar la imagen.'); return; }
            avUploadSave.disabled = true;
            avUploadSave.textContent = 'Subiendo…';
            try {
                const fd = new FormData();
                fd.append('avatar', blob, 'avatar.jpg');
                const res = await fetch('/api/profile/avatar-upload', { method: 'POST', body: fd });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data.ok) throw new Error(data.error || 'fallo');
                location.href = '/perfil?saved=1';
            } catch (err) {
                avUploadSave.disabled = false;
                avUploadSave.textContent = 'Guardar foto';
                avShowUploadMsg((err as Error).message || 'No se pudo subir la foto.');
            }
        }, 'image/jpeg', 0.85);
    });

    // Eliminar cuenta (E.5)
    const delBtn = document.getElementById('account-delete') as HTMLButtonElement | null;
    delBtn?.addEventListener('click', async () => {
        const ok = confirm('¿Eliminar tu cuenta? Se borrarán TODAS tus listas y tu perfil. Esta acción NO se puede deshacer.');
        if (!ok) return;
        delBtn.disabled = true;
        delBtn.textContent = 'Eliminando…';
        try {
            const res = await fetch('/api/auth/delete-account', { method: 'POST' });
            if (!res.ok) throw new Error();
            try {
                const { clientAuth } = await import('../utils/firebaseAuthClient');
                const { signOut } = await import('firebase/auth');
                await signOut(clientAuth);
            } catch { /* la cuenta ya no existe; da igual */ }
            location.href = '/';
        } catch {
            delBtn.disabled = false;
            delBtn.textContent = 'Eliminar cuenta';
            alert('No se pudo eliminar la cuenta. Inténtalo de nuevo.');
        }
    });
</script>
