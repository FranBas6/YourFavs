---
import Layout from "../../layouts/Layout.astro"
import { getActorsFav } from "../../services/BD/yourfavsActor";
import { getActorDetailsById, getMoviesByActorId, getSeriesByActorId } from "../../services/API/Actors/InfoActor";

// Función auxiliar para calcular edad
function calculateAge(birthday: string | null | undefined): number | null {
    if (!birthday) return null;
    const birthDate = new Date(birthday);
    const today = new Date();
    let age = today.getFullYear() - birthDate.getFullYear();
    const monthDiff = today.getMonth() - birthDate.getMonth();
    if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
        age--;
    }
    return age;
}

// 🔹 Obtener IDs y posiciones desde Firebase
const actorsFav = await getActorsFav();

// 🔹 Obtener detalles actualizados desde TMDB para cada actor
const actorsWithDetails = await Promise.all(
    actorsFav.map(async (fav) => {
        // Obtener datos actualizados del actor desde TMDB
        const actorDetails = await getActorDetailsById({ id: fav.id });
        if (!actorDetails) return null;

        // Obtener películas y series del actor desde TMDB
        const movies = await getMoviesByActorId({ id: fav.id });
        const series = await getSeriesByActorId({ id: fav.id });

        // Filtrar y ordenar las últimas 6 películas por fecha
        const recentMovies = movies
            .filter((m: any) => m.release_date)
            .sort((a: any, b: any) => new Date(b.release_date).getTime() - new Date(a.release_date).getTime())
            .slice(0, 9);

        // Filtrar y ordenar las últimas 6 series por fecha
        const recentSeries = series
            .filter((s: any) => s.first_air_date)
            .sort((a: any, b: any) => new Date(b.first_air_date).getTime() - new Date(a.first_air_date).getTime())
            .slice(0, 9);

        return {
            id: fav.id,
            position: fav.position,
            details: actorDetails,
            age: calculateAge(actorDetails.fechaNacimiento),
            totalMovies: movies.length,
            totalSeries: series.length,
            recentMovies,
            recentSeries
        };
    })
);

// Filtrar nulos (actores no encontrados en TMDB)
const actors = actorsWithDetails.filter(actor => actor !== null);
---
<Layout title="Actores Favoritos">
    <div class="favorites-container max-w-7xl mx-auto px-4 py-6 space-y-6">

        <!-- Barra de navegación secundaria (Categorías) -->
