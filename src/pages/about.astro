---
/**
 * Acerca de (rediseño, Fase 7 · 7.2; handoff P9). Texto nuevo desde el README: qué es y 8 bloques con lo
 * que hay hoy. Fuera «Construido con» y las «7 plataformas» (eran de otra época). Al pie, de dónde salen
 * los datos (atribución obligatoria de TMDB, con su logo, y de JustWatch) y qué pasa con los tuyos.
 */
import Layout from "../layouts/Layout.astro";
import Stamp from "../components/Stamp.astro";
import '../styles/pages/about.css';

type Color = 'red' | 'amber' | 'blue' | 'green' | 'purple' | 'pink' | 'slate';
const BLOCKS: [Color, string, string, string][] = [
    ['green', 'tv', 'Episodio a episodio', 'Marca episodios desde la serie, desde cada episodio o desde «Estás viendo», que siempre enseña el siguiente. Finales y parones señalados, y un modo sin spoilers que oculta lo que aún no has visto.'],
    ['amber', 'crown', 'Listas que significan algo', 'Favoritos con tu propio ranking, Me gusta, Vistos, Pendientes, Ver pronto y Siguiendo, que nunca se contradicen. Colecciones propias, notas del 0,5 al 10 y un diario con cada vez que vuelves a ver algo.'],
    ['purple', 'sparkles', 'Qué ver', '«Para ti» a partir de tus notas, tus listas y tus géneros; filas con criterio («Nuevo en streaming», «Hecho en España», joyas escondidas) y una ruleta para las noches de duda.'],
    ['slate', 'play', 'Dónde verlo', 'Disponibilidad por país y por temporada, con tus plataformas primero, y la fecha de estreno en tu país junto a la mundial.'],
    ['blue', 'calendar-days', 'Calendario', 'Estrenos y episodios de lo que sigues, por mes o en lista, y una dirección privada para suscribirte desde Google Calendar o el iPhone.'],
    ['pink', 'users', 'Con amigos', 'Amigos y seguidos, perfil público, recomendaciones, chats de dos y de grupo con tarjetas de títulos, «¿Qué vemos?» y planes con fecha. Los avisos se quedan dentro de la web.'],
    ['green', 'download', 'Trae tu biblioteca', 'Importa desde IMDb, Letterboxd o una cuenta de TMDB, revisa las coincidencias dudosas y deshazlo con un clic.'],
    ['red', 'chart-column', 'Tu año', 'Películas, series, episodios y horas de cada año, mes a mes, tu día con más visionados y una vista de siempre.'],
];
const user = Astro.locals.user;
---
<Layout title="Acerca de YourFavs" description="YourFavs es donde llevas todo lo que ves: episodio a episodio, listas, qué ver, dónde verlo, calendario y amigos.">
    <div class="ab">
        <header class="ab-h">
            <span class="ab-k">Acerca de</span>
            <h1>YourFavs es donde llevas todo lo que ves</h1>
            <p>
                Empezó como una lista de películas favoritas y creció hasta guardar lo que has visto, lo que
                tienes a medias, lo que quieres ver y lo que te recomiendan tus amigos. Sabe qué episodio toca
                en cada serie, dónde se puede ver cada título en tu país y qué se estrena este mes. Se instala
                en el móvil como una app.
            </p>
        </header>

        <section class="ab-g" aria-label="Qué puedes hacer">
            {BLOCKS.map(([c, i, h, p]) => (
                <article>
                    <Stamp color={c} icon={i} size={36} />
                    <h2>{h}</h2>
                    <p>{p}</p>
                </article>
            ))}
        </section>

        <section class="ab-x">
            <div>
                <h2>De dónde salen los datos</h2>
                <a class="ab-tmdb" href="https://www.themoviedb.org/" target="_blank" rel="noopener" aria-label="The Movie Database (TMDB)">
                    <img src="/logos/tmdb.svg" alt="TMDB" width="150" height="20" loading="lazy" />
                </a>
                <p>
                    Fichas, imágenes, reparto y equipo vienen de <a href="https://www.themoviedb.org/" target="_blank" rel="noopener">The Movie Database (TMDB)</a>.
                    Este producto usa la API de TMDB pero no está avalado ni certificado por TMDB.
                </p>
                <p>
                    Dónde ver cada título lo aporta <a href="https://www.justwatch.com/" target="_blank" rel="noopener">JustWatch</a>, a través de TMDB.
                </p>
            </div>
            <div>
                <h2>Tus datos</h2>
                <p>
                    Tus listas, notas y mensajes son tuyos. Nada se ve fuera de tu cuenta si no activas tu
                    {user ? <a href="/perfil/publico"> perfil público</a> : ' perfil público'}, y puedes borrar la cuenta con todo lo que
                    contiene desde {user ? <a href="/perfil/cuenta">Ajustes</a> : 'Ajustes'}.
                </p>
            </div>
        </section>
    </div>
</Layout>
