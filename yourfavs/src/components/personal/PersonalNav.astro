---
interface Props {
    currentPage: string;
}

const { currentPage } = Astro.props;

const links = [
    { href: '/personal/favoritos', label: 'Favoritos', icon: 'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z', color: 'text-yellow-500', activeGradient: 'from-yellow-500 to-orange-500' },
    { href: '/personal/pendientes', label: 'Pendientes', icon: 'M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z', color: 'text-blue-500', activeGradient: 'from-blue-500 to-cyan-500' },
    { href: '/personal/siguiendo', label: 'Siguiendo', color: 'text-purple-500', activeGradient: 'from-purple-500 to-violet-500', customIcon: true },
    { href: '/personal/megusta', label: 'Me gustan', icon: 'M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z', color: 'text-pink-500', activeGradient: 'from-pink-500 to-rose-500' },
    { href: '/personal/vistos', label: 'Vistos', icon: 'M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z', color: 'text-green-500', activeGradient: 'from-green-500 to-emerald-500' },
    { href: '/personal/verpronto', label: 'Pronto', color: 'text-indigo-500', activeGradient: 'from-indigo-500 to-blue-500', customIcon: 'pronto' },
    { href: '/personal/recomendaciones', label: 'Recomendadas', icon: 'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z', color: 'text-orange-500', activeGradient: 'from-orange-500 to-amber-500' },
    { href: '/personal/actores', label: 'Actores', icon: 'M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z', color: 'text-red-500', activeGradient: 'from-red-500 to-rose-500' },
];
---
<nav class="bg-white rounded-xl shadow-sm border border-gray-200 mb-8 overflow-hidden">
    <div class="container mx-auto px-4 py-2">
        <div class="flex flex-wrap justify-center gap-3 items-center">
            {links.map((link) => {
                const isActive = currentPage === link.href;
                return (
                    <a href={link.href}
                       class={`flex-shrink-0 px-4 py-2 rounded-lg transition-all duration-300 font-medium ${
                           isActive
                               ? `text-white bg-gradient-to-r ${link.activeGradient} shadow-md transform scale-105`
                               : 'text-gray-700 bg-gray-100 hover:bg-gray-200 hover:scale-105'
                       }`}>
                        <span class="flex items-center whitespace-nowrap">
                            {link.customIcon === true ? (
                                <svg xmlns="http://www.w3.org/2000/svg" class={`h-4 w-4 mr-1 ${isActive ? 'text-white' : link.color}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" stroke-width="2">
                                    <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
                                    <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"></path>
                                </svg>
                            ) : link.customIcon === 'pronto' ? (
                                <svg xmlns="http://www.w3.org/2000/svg" class={`h-4 w-4 mr-1 ${isActive ? 'text-white' : link.color}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                    <line x1="8" y1="21" x2="16" y2="21"/>
                                    <line x1="12" y1="17" x2="12" y2="21"/>
                                    <polygon points="10,8 16,12 10,16"/>
                                </svg>
                            ) : (
                                <svg xmlns="http://www.w3.org/2000/svg" class={`h-4 w-4 mr-1 ${isActive ? 'text-white' : link.color}`} viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d={link.icon} clip-rule="evenodd"/>
                                </svg>
                            )}
                            {link.label}
                        </span>
                    </a>
                );
            })}
        </div>
    </div>
</nav>
