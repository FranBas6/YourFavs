---
/**
 * Stats "De siempre" — el acumulado de por vida (handoff v2 §⑤).
 * Página hermana de [year].astro: mismo lenguaje visual, ámbito 'all'.
 * No hay comparativa con año anterior ni timeline mensual (no aplican);
 * a cambio: racha máxima histórica y década favorita como KPIs.
 */
import Layout from "../../../layouts/Layout.astro";
import { Icon } from 'astro-icon/components';
import PersonalNav from "../../../components/personal/PersonalNav.astro";
import EmptyState from "../../../components/EmptyState.astro";
import { calculateLifetimeStats, type ItemShowcase } from "../../../utils/yearStats";
import { getMaxWatchStreak } from "../../../services/BD/series/yourfavsSerie";
import { deriveArchetype } from "../../../utils/cinemaIdentity";
import { getGenreName } from "../../../utils/constants/genres";
import { getLanguageDisplayName } from "../../../utils/constants/helpers/media-helpers";
import { posterUrl } from "../../../services/API/shared/tmdbClient";
import { refreshArchetypeIfStale } from "../../../services/BD/social/publicSettings";
import { invalidatePublicProfileCache } from "../../../services/BD/social/publicProfile";
import '../../../styles/pages/personal/personal.css';

const currentYear = new Date().getFullYear();

const [stats, streak] = await Promise.all([
    calculateLifetimeStats(),
    getMaxWatchStreak(),
]);

const totalTitles = stats.moviesAdded + stats.seriesAdded;

// Década favorita: la de más items (excluyendo desconocidas)
const favDecade = [...stats.byDecade]
    .filter(d => d.decade !== 'Desconocido')
    .sort((a, b) => b.count - a.count)[0] || null;

const maxDecade = Math.max(1, ...stats.byDecade.map(d => d.count));
const maxCollection = Math.max(1, ...stats.byCollection.map(c => c.count));
const maxLanguage = Math.max(1, ...stats.byLanguage.map(l => l.count));

// 4.1 · Veredicto "tú vs TMDB": ¿más generoso, más exigente o en sintonía?
const rc = stats.ratingCompare;
const ratingDiff = rc ? Math.round((rc.userAvg - rc.tmdbAvg) * 10) / 10 : 0;
const ratingVerdict = !rc ? '' :
    ratingDiff >= 0.5 ? 'Eres más generoso que la media' :
    ratingDiff <= -0.5 ? 'Eres más exigente que la media' :
    'Coincides bastante con la media';
const topDirector = stats.topDirectors[0] || null;

// ④ Identidad cinéfila: arquetipo (reglas) + ADN por género (barras), sin fetches nuevos.
const archetype = deriveArchetype(stats, streak.max);
// F5 social: si el arquetipo de tu perfil público tiene más de una semana, se guarda este. Un fallo
// aquí no puede romper la página.
if (Astro.locals.user) {
    try {
        const handle = await refreshArchetypeIfStale({ name: archetype.name, icon: archetype.icon, description: archetype.description });
        if (handle) invalidatePublicProfileCache(handle);
    } catch (err) {
        console.error('[year/siempre] archetype', (err as Error).message);
    }
}
const dnaGenres = stats.topGenres.slice(0, 6);
const maxGenre = Math.max(1, ...dnaGenres.map(g => g.count));
const DNA_COLORS = ['#E63946', '#6d4aa0', '#2f6fb0', '#9a6a12', '#2f7d52', '#b8417a'];

function showcaseHref(s: ItemShowcase): string {
    return s.kind === 'movie' ? `/movie/${s.id}` : `/serie/${s.id}`;
}
---
<Layout title="De siempre">
    <section class="px-1 sm:py-8">
        <header class="mb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">De siempre</h1>
            <p class="text-gray-500 text-base">Tu perfil cinematográfico: el acumulado de toda tu colección</p>
        </header>

        <div class="mb-6">
            <PersonalNav currentPage="/mislistas/year" />
        </div>

        {/* Toggle ámbito: año actual ↔ de siempre */}
        <div class="flex justify-center mb-8">
            <div class="inline-flex bg-gray-100 rounded-full p-1 gap-0.5">
                <a href={`/mislistas/year/${currentYear}`} class="px-4 py-1.5 rounded-full text-sm font-semibold text-gray-500 hover:text-gray-800 transition">{currentYear}</a>
                <span class="px-4 py-1.5 rounded-full text-sm font-bold bg-[#E63946] text-white">De siempre</span>
            </div>
        </div>

        {!stats.hasData && (
            <EmptyState
                size="md"
                title="Aún no hay nada que contar"
                description="Añade títulos o marca episodios y aquí aparecerá tu acumulado."
            />
        )}

        {stats.hasData && (
            <div class="space-y-10">
                {/* ④ Arquetipo cinéfilo */}
                <section class="rounded-2xl p-6 md:p-7 text-white relative overflow-hidden" style="background: linear-gradient(135deg, #3a2545, #1e3a8a);">
                    <div class="flex items-center gap-5">
                        <span class="w-16 h-16 rounded-2xl bg-white/15 flex items-center justify-center text-amber-200 flex-shrink-0">
                            <Icon name={`lucide:${archetype.icon}`} class="w-8 h-8" />
                        </span>
                        <div class="min-w-0">
                            <div class="text-[11px] uppercase tracking-[0.14em] text-white/60 mb-1.5" style="font-family:'JetBrains Mono',monospace;">Tu arquetipo cinéfilo</div>
                            <div class="text-2xl md:text-3xl font-bold mb-1.5" style="font-family:'Fraunces','Poppins',serif; font-style:italic;">{archetype.name}</div>
                            <p class="text-sm text-white/80 leading-relaxed">{archetype.description}</p>
                        </div>
                    </div>
                </section>

                {/* KPIs de por vida */}
                <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
                    <div class="rounded-xl bg-gradient-to-br from-red-50 to-red-100 border border-red-200 p-4">
                        <Icon name="lucide:clock" class="w-8 h-8 text-red-600" />
                        <div class="mt-2 text-3xl font-bold text-red-700">{stats.totalHours}h</div>
                        <div class="text-xs text-red-600 font-medium uppercase tracking-wide mt-1">Horas vistas</div>
                        <div class="text-[11px] text-red-500 mt-1">~{Math.round(stats.totalHours / 24)} días de tu vida</div>
                    </div>
                    <div class="rounded-xl bg-gradient-to-br from-blue-50 to-blue-100 border border-blue-200 p-4">
                        <Icon name="lucide:library" class="w-8 h-8 text-blue-600" />
                        <div class="mt-2 text-3xl font-bold text-blue-700">{totalTitles}</div>
                        <div class="text-xs text-blue-600 font-medium uppercase tracking-wide mt-1">Títulos</div>
                        <div class="text-[11px] text-blue-500 mt-1">{stats.moviesAdded} pelis · {stats.seriesAdded} series</div>
                    </div>
                    <div class="rounded-xl bg-gradient-to-br from-emerald-50 to-emerald-100 border border-emerald-200 p-4">
                        <Icon name="lucide:play" class="w-8 h-8 text-emerald-600" />
                        <div class="mt-2 text-3xl font-bold text-emerald-700">{stats.episodesWatched}</div>
                        <div class="text-xs text-emerald-600 font-medium uppercase tracking-wide mt-1">Episodios</div>
                    </div>
                    <div class="rounded-xl bg-gradient-to-br from-amber-50 to-amber-100 border border-amber-200 p-4">
                        <Icon name="lucide:flame" class="w-8 h-8 text-amber-600" />
                        <div class="mt-2 text-3xl font-bold text-amber-700">{streak.max}</div>
                        <div class="text-xs text-amber-600 font-medium uppercase tracking-wide mt-1">Racha máx (días)</div>
                        {streak.current > 0 && <div class="text-[11px] text-amber-500 mt-1">actual: {streak.current} día{streak.current !== 1 ? 's' : ''}</div>}
                    </div>
                    <div class="rounded-xl bg-gradient-to-br from-purple-50 to-purple-100 border border-purple-200 p-4 col-span-2 md:col-span-1">
                        <Icon name="lucide:sparkles" class="w-8 h-8 text-purple-600" />
                        <div class="mt-2 text-3xl font-bold text-purple-700">{favDecade ? favDecade.decade : '—'}</div>
                        <div class="text-xs text-purple-600 font-medium uppercase tracking-wide mt-1">Década favorita</div>
                        {favDecade && <div class="text-[11px] text-purple-500 mt-1">{favDecade.count} títulos</div>}
                    </div>
                    {stats.rewatches > 0 && (
                        <div class="rounded-xl bg-gradient-to-br from-rose-50 to-rose-100 border border-rose-200 p-4 col-span-2 md:col-span-1">
                            <svg class="w-8 h-8 text-rose-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 2l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14M7 22l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                            <div class="mt-2 text-3xl font-bold text-rose-700">{stats.rewatches}</div>
                            <div class="text-xs text-rose-600 font-medium uppercase tracking-wide mt-1">Re-visionados</div>
                        </div>
                    )}
                </div>

                {/* 4.1 · Tu cine en números: nota tú vs TMDB + director más visto */}
                {(rc || topDirector) && (
                    <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {rc && (
                            <div class="rounded-xl border border-indigo-200 bg-gradient-to-br from-indigo-50 to-violet-50 p-5">
                                <h3 class="text-sm font-semibold text-indigo-900 uppercase tracking-wide mb-4 flex items-center gap-2">
                                    <Icon name="lucide:scale" class="w-4 h-4 text-indigo-600" /> Tu nota media vs TMDB
                                </h3>
                                <div class="flex items-end justify-around gap-4">
                                    <div class="text-center">
                                        <div class="text-4xl font-bold text-indigo-700">{rc.userAvg}</div>
                                        <div class="text-[11px] font-semibold text-indigo-500 uppercase tracking-wide mt-1">Tu nota</div>
                                    </div>
                                    <div class="text-2xl text-gray-300 font-light pb-2">vs</div>
                                    <div class="text-center">
                                        <div class="text-4xl font-bold text-gray-500">{rc.tmdbAvg}</div>
                                        <div class="text-[11px] font-semibold text-gray-400 uppercase tracking-wide mt-1">TMDB</div>
                                    </div>
                                </div>
                                <p class="mt-4 text-center text-sm font-medium text-indigo-800">
                                    {ratingVerdict}
                                    <span class="text-indigo-500 font-normal"> ({ratingDiff > 0 ? '+' : ''}{ratingDiff})</span>
                                </p>
                                <p class="mt-1 text-center text-[11px] text-indigo-400">Sobre {rc.count} título{rc.count !== 1 ? 's' : ''} que has puntuado</p>
                            </div>
                        )}

                        {topDirector && (
                            <div class="rounded-xl border border-sky-200 bg-gradient-to-br from-sky-50 to-cyan-50 p-5">
                                <h3 class="text-sm font-semibold text-sky-900 uppercase tracking-wide mb-4 flex items-center gap-2">
                                    <Icon name="lucide:clapperboard" class="w-4 h-4 text-sky-600" /> Director más visto
                                </h3>
                                <a href={`/team/${encodeURIComponent(topDirector.name)}`} class="flex items-center gap-4 group">
                                    <div class="w-16 h-16 rounded-full overflow-hidden bg-sky-100 flex-shrink-0 border-2 border-white shadow">
                                        {topDirector.profile_path ? (
                                            <img src={posterUrl(topDirector.profile_path, 'w185') || ''} alt={topDirector.name} loading="lazy" class="w-full h-full object-cover" />
                                        ) : (
                                            <div class="w-full h-full flex items-center justify-center text-sky-400"><Icon name="lucide:user" class="w-7 h-7" /></div>
                                        )}
                                    </div>
                                    <div class="min-w-0">
                                        <div class="text-base font-bold text-sky-900 group-hover:underline line-clamp-1">{topDirector.name}</div>
                                        <div class="text-sm text-sky-600 font-medium">{topDirector.count} títulos en tu biblioteca</div>
                                    </div>
                                </a>
                                {stats.topDirectors.length > 1 && (
                                    <div class="mt-4 pt-3 border-t border-sky-100 flex flex-wrap gap-x-4 gap-y-1">
                                        {stats.topDirectors.slice(1).map((d) => (
                                            <a href={`/team/${encodeURIComponent(d.name)}`} class="text-xs text-sky-700 hover:underline">{d.name} <span class="text-sky-400">×{d.count}</span></a>
                                        ))}
                                    </div>
                                )}
                            </div>
                        )}
                    </section>
                )}

                {/* ④ Tu ADN por género + tarjeta retrato compartible */}
                {dnaGenres.length > 0 && (
                    <section class="grid grid-cols-1 md:grid-cols-5 gap-4">
                        <div class="md:col-span-3 bg-white rounded-xl border border-gray-200 p-5">
                            <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wide mb-4 flex items-center gap-2">
                                <Icon name="lucide:fingerprint" class="w-4 h-4 text-rose-600" /> Tu ADN por género
                            </h3>
                            <div class="space-y-3">
                                {dnaGenres.map((g, i) => (
                                    <div>
                                        <div class="flex items-center justify-between text-sm mb-1">
                                            <span class="font-semibold text-gray-800">{getGenreName(g.id)}</span>
                                            <span class="text-xs text-gray-400">×{g.count}</span>
                                        </div>
                                        <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                                            <div class="h-full rounded-full" style={`width:${(g.count / maxGenre) * 100}%; background:${DNA_COLORS[i % DNA_COLORS.length]};`}></div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>

                        <div class="md:col-span-2 rounded-xl p-5 text-white flex flex-col" style="background: linear-gradient(135deg,#16130f,#2a2118);">
                            <div class="text-[11px] uppercase tracking-[0.12em] text-white/55 mb-2" style="font-family:'JetBrains Mono',monospace;">Tu retrato · compartible</div>
                            <div class="text-2xl font-bold leading-tight mb-3" style="font-family:'Fraunces','Poppins',serif; font-style:italic; color:#e0a86b;">{archetype.name}</div>
                            <ul class="text-sm text-gray-300 space-y-1.5 leading-relaxed">
                                <li>{totalTitles} títulos · {stats.totalHours} h vistas</li>
                                <li>Racha máxima: {streak.max} día{streak.max !== 1 ? 's' : ''}</li>
                                {dnaGenres[0] && <li>Género estrella: {getGenreName(dnaGenres[0].id)}</li>}
                                {topDirector && <li>Tu director: {topDirector.name}</li>}
                                {rc && <li>{ratingDiff > 0 ? '+' : ''}{ratingDiff} vs TMDB</li>}
                            </ul>
                            <button type="button" id="yf-share-card"
                                data-name={archetype.name}
                                data-desc={archetype.description}
                                data-titles={String(totalTitles)}
                                data-hours={String(stats.totalHours)}
                                data-streak={String(streak.max)}
                                data-genre={dnaGenres[0] ? getGenreName(dnaGenres[0].id) : ''}
                                data-director={topDirector?.name || ''}
                                data-ratingdiff={rc ? `${ratingDiff > 0 ? '+' : ''}${ratingDiff}` : ''}
                                class="mt-4 inline-flex items-center gap-2 rounded-lg border border-white/25 px-3 py-2 text-xs font-semibold text-white/90 hover:bg-white/10 transition-colors self-start"
                                style="font-family:'JetBrains Mono',monospace;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
                                Descargar imagen
                            </button>
                        </div>
                    </section>
                )}

                {/* Export PNG del arquetipo (§6 detalles con alma): tarjeta compartible
                    dibujada en canvas, sin dependencias. Los datos llegan por data-* del botón. */}
                <script is:inline>
                    (function () {
                        var btn = document.getElementById('yf-share-card');
                        if (!btn) return;

                        function wrap(ctx, text, x, y, maxW, lh) {
                            var words = String(text || '').split(' '), line = '', yy = y;
                            for (var n = 0; n < words.length; n++) {
                                var test = line ? line + ' ' + words[n] : words[n];
                                if (ctx.measureText(test).width > maxW && line) { ctx.fillText(line, x, yy); line = words[n]; yy += lh; }
                                else line = test;
                            }
                            if (line) { ctx.fillText(line, x, yy); yy += lh; }
                            return yy;
                        }

                        function draw() {
                            var d = btn.dataset;
                            var W = 1080, H = 1350, PAD = 96;
                            var c = document.createElement('canvas');
                            c.width = W; c.height = H;
                            var ctx = c.getContext('2d');
                            if (!ctx) return;

                            var g = ctx.createLinearGradient(0, 0, W, H);
                            g.addColorStop(0, '#16130f'); g.addColorStop(1, '#2a2118');
                            ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
                            ctx.strokeStyle = 'rgba(224,168,107,.35)'; ctx.lineWidth = 3;
                            ctx.strokeRect(40, 40, W - 80, H - 80);
                            ctx.textBaseline = 'top';

                            ctx.fillStyle = 'rgba(255,255,255,.55)';
                            ctx.font = '500 26px "JetBrains Mono", monospace';
                            ctx.fillText('YOURFAVS · TU CINE EN NÚMEROS', PAD, 120);

                            ctx.fillStyle = 'rgba(255,255,255,.6)';
                            ctx.font = '600 30px Poppins, sans-serif';
                            ctx.fillText('Tu arquetipo cinéfilo', PAD, 300);

                            ctx.fillStyle = '#e0a86b';
                            ctx.font = '700 84px Poppins, serif';
                            var yName = wrap(ctx, d.name || 'Cinéfilo', PAD, 348, W - PAD * 2, 92);

                            ctx.fillStyle = 'rgba(255,255,255,.8)';
                            ctx.font = '400 34px Poppins, sans-serif';
                            var yDesc = wrap(ctx, d.desc || '', PAD, yName + 24, W - PAD * 2, 46);

                            var yDiv = Math.max(yDesc + 56, 800);
                            ctx.strokeStyle = 'rgba(255,255,255,.15)'; ctx.lineWidth = 2;
                            ctx.beginPath(); ctx.moveTo(PAD, yDiv); ctx.lineTo(W - PAD, yDiv); ctx.stroke();

                            var lines = [];
                            lines.push((d.titles || '0') + ' títulos · ' + (d.hours || '0') + ' h vistas');
                            lines.push('Racha máxima: ' + (d.streak || '0') + ' día' + (d.streak === '1' ? '' : 's'));
                            if (d.genre) lines.push('Género estrella: ' + d.genre);
                            if (d.director) lines.push('Tu director: ' + d.director);
                            if (d.ratingdiff) lines.push(d.ratingdiff + ' vs TMDB');
                            ctx.fillStyle = 'rgba(255,255,255,.85)';
                            ctx.font = '400 36px Poppins, sans-serif';
                            var y = yDiv + 40;
                            for (var i = 0; i < lines.length; i++) { ctx.fillText('·  ' + lines[i], PAD, y); y += 58; }

                            ctx.fillStyle = '#e0a86b';
                            ctx.font = '700 42px Poppins, sans-serif';
                            ctx.fillText('YourFavs', PAD, H - 150);

                            c.toBlob(function (blob) {
                                if (!blob) return;
                                var url = URL.createObjectURL(blob);
                                var a = document.createElement('a');
                                a.href = url; a.download = 'yourfavs-arquetipo.png';
                                document.body.appendChild(a); a.click(); a.remove();
                                setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
                            }, 'image/png');
                        }

                        btn.addEventListener('click', function () {
                            btn.disabled = true;
                            var done = function () { btn.disabled = false; };
                            // Esperar a que las fuentes estén listas para que el texto no salga con fallback.
                            if (document.fonts && document.fonts.ready) {
                                document.fonts.ready.then(function () { try { draw(); } catch (e) {} done(); });
                            } else { try { draw(); } catch (e) {} done(); }
                        });
                    })();
                </script>

                {/* Destacados de siempre */}
                {(stats.showcase.bestUserRated || stats.showcase.bestTmdb || stats.showcase.firstOfYear) && (
                    <section>
                        <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                            <span class="w-1 h-6 bg-rose-500 rounded-full"></span>
                            Destacados de siempre
                        </h2>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                            {[
                                { item: stats.showcase.bestUserRated, icon: 'star', label: 'Tu mejor nota', sub: (s: ItemShowcase) => s.user_rating ? `${s.user_rating}/10` : '' },
                                { item: stats.showcase.bestTmdb, icon: 'trophy', label: 'Mejor TMDB', sub: (s: ItemShowcase) => `${s.tmdb_rating.toFixed(1)}` },
                                { item: stats.showcase.firstOfYear, icon: 'target', label: 'El primero de todos', sub: (s: ItemShowcase) => new Date(s.addedAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }) },
                                { item: stats.showcase.lastOfYear, icon: 'flame', label: 'El más reciente', sub: (s: ItemShowcase) => new Date(s.addedAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }) },
                            ].filter(x => x.item).map(({ item, icon, label, sub }) => (
                                <a href={showcaseHref(item!)} class="group block">
                                    <div class="relative aspect-[2/3] rounded-xl overflow-hidden shadow-md group-hover:shadow-xl transition bg-gray-200">
                                        {item!.poster_path ? (
                                            <img src={posterUrl(item!.poster_path) || ''} alt={item!.title} loading="lazy" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"/>
                                        ) : (
                                            <div class="w-full h-full flex items-center justify-center text-gray-400"><Icon name="lucide:film" class="w-10 h-10" /></div>
                                        )}
                                        <span class={`absolute top-2 left-2 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${item!.kind === 'movie' ? 'bg-red-500 text-white' : 'bg-blue-500 text-white'}`}>
                                            {item!.kind === 'movie' ? 'Película' : 'Serie'}
                                        </span>
                                    </div>
                                    <div class="mt-2 text-[10px] font-bold text-rose-600 uppercase tracking-wider flex items-center gap-1"><Icon name={`lucide:${icon}`} class="w-3 h-3" />{label}</div>
                                    <div class="text-sm font-semibold text-gray-800 line-clamp-1">{item!.title}</div>
                                    <div class="text-xs text-gray-500">{sub(item!)}</div>
                                </a>
                            ))}
                        </div>
                    </section>
                )}

                {/* Top series de todos los tiempos */}
                {stats.showcase.topSeries.length > 0 && (
                    <section>
                        <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                            <span class="w-1 h-6 bg-emerald-500 rounded-full"></span>
                            Series con más episodios vistos
                        </h2>
                        <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-3 sm:gap-4">
                            {stats.showcase.topSeries.map((s, idx) => (
                                <a href={`/serie/${s.id}`} class="group block">
                                    <div class="relative aspect-[2/3] rounded-xl overflow-hidden shadow-md group-hover:shadow-xl transition bg-gray-200">
                                        {s.poster_path ? (
                                            <img src={posterUrl(s.poster_path) || ''} alt={s.title} loading="lazy" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"/>
                                        ) : (
                                            <div class="w-full h-full flex items-center justify-center text-gray-400"><Icon name="lucide:tv" class="w-10 h-10" /></div>
                                        )}
                                        <span class="absolute top-2 left-2 w-7 h-7 flex items-center justify-center text-sm font-bold rounded-full bg-emerald-500 text-white shadow-lg">{idx + 1}</span>
                                        <span class="absolute bottom-2 right-2 text-[10px] font-bold px-2 py-0.5 rounded-full bg-black/70 text-emerald-300">▶ {s.episodesWatched}</span>
                                    </div>
                                    <div class="mt-2 text-sm font-semibold text-gray-800 line-clamp-1">{s.title}</div>
                                </a>
                            ))}
                        </div>
                    </section>
                )}

                {/* Distribuciones de por vida */}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {stats.byDecade.length > 0 && (
                        <section class="bg-white rounded-xl border border-gray-200 p-4">
                            <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wide mb-3 flex items-center gap-2">
                                <Icon name="lucide:calendar-days" class="w-4 h-4 text-cyan-600" /> Por década de estreno
                            </h3>
                            <div class="space-y-2">
                                {stats.byDecade.map((d) => (
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-medium text-gray-600 w-16">{d.decade}</span>
                                        <div class="flex-1 h-5 bg-gray-100 rounded overflow-hidden">
                                            <div class="h-full bg-cyan-500 rounded" style={`width: ${(d.count / maxDecade) * 100}%`}></div>
                                        </div>
                                        <span class="text-xs font-semibold text-gray-700 w-8 text-right">{d.count}</span>
                                    </div>
                                ))}
                            </div>
                        </section>
                    )}

                    {stats.byCollection.length > 0 && (
                        <section class="bg-white rounded-xl border border-gray-200 p-4">
                            <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wide mb-3 flex items-center gap-2">
                                <Icon name="lucide:folders" class="w-4 h-4 text-fuchsia-600" /> Por colección
                            </h3>
                            <div class="space-y-2">
                                {stats.byCollection.map((c) => (
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-medium text-gray-600 w-20 truncate">{c.label}</span>
                                        <div class="flex-1 h-5 bg-gray-100 rounded overflow-hidden">
                                            <div class="h-full bg-fuchsia-500 rounded" style={`width: ${(c.count / maxCollection) * 100}%`}></div>
                                        </div>
                                        <span class="text-xs font-semibold text-gray-700 w-8 text-right">{c.count}</span>
                                    </div>
                                ))}
                            </div>
                        </section>
                    )}

                    {stats.byLanguage.length > 0 && (
                        <section class="bg-white rounded-xl border border-gray-200 p-4">
                            <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wide mb-3 flex items-center gap-2">
                                <Icon name="lucide:globe" class="w-4 h-4 text-teal-600" /> Por idioma original
                            </h3>
                            <div class="space-y-2">
                                {stats.byLanguage.map((l) => (
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-medium text-gray-600 w-24 truncate">{getLanguageDisplayName(l.code)}</span>
                                        <div class="flex-1 h-5 bg-gray-100 rounded overflow-hidden">
                                            <div class="h-full bg-teal-500 rounded" style={`width: ${(l.count / maxLanguage) * 100}%`}></div>
                                        </div>
                                        <span class="text-xs font-semibold text-gray-700 w-8 text-right">{l.count}</span>
                                    </div>
                                ))}
                            </div>
                        </section>
                    )}

                </div>

                {/* Volver a un año concreto */}
                {stats.availableYears.length > 0 && (
                    <section>
                        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Ver un año concreto</h2>
                        <div class="flex flex-wrap gap-2">
                            {stats.availableYears.map((y) => (
                                <a href={`/mislistas/year/${y}`} class="text-sm px-3 py-1.5 rounded-lg border font-medium transition bg-white text-gray-700 border-gray-200 hover:border-red-300 hover:text-red-600">
                                    {y}
                                </a>
                            ))}
                        </div>
                    </section>
                )}
            </div>
        )}
    </section>
</Layout>
